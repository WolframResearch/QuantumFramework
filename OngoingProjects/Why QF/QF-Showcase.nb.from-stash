      StyleBox["]", "NonInterpretableSummary"]}]},
   "CopyTag",
   DisplayFunction->(#& ),
   InterpretationFunction->(
    "                                         p  p  p\n\
QECNoiseModel[<|Probabilities -> {1 - p, -, -, -}, Name -> Depolarizing, \
Parameters -> {p}, Level -> CodeCapacity, MeasurementError -> 0|>]\n          \
                               3  3  3"& )],
  False,
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellChangeTimes->{4.000943640343749*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"58d38253-2f66-4d5d-ae50-1c30b6d304ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rate", " ", "=", " ", 
  RowBox[{"QECLogicalErrorRate", "[", 
   RowBox[{"code", ",", " ", 
    RowBox[{"QECNoiseModel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1465513701,ExpressionUUID->"7b6a50da-eb07-3910-296a-49878eb3887a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["2", "27"]}], " ", 
  SuperscriptBox["p", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "135"}], "+", 
    RowBox[{"300", " ", "p"}], "-", 
    RowBox[{"240", " ", 
     SuperscriptBox["p", "2"]}], "+", 
    RowBox[{"64", " ", 
     SuperscriptBox["p", "3"]}]}], ")"}]}]], "Output",
 CellChangeTimes->{4.000943634018886*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"40317685-ef87-457e-866c-e0716525d581"]
}, Open  ]],

Cell[TextData[{
 "The result is an exact rational function of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23591dbb-79d4-ec10-5166-94e57866b77a"],
 ", quadratic at leading order (",
 Cell[BoxData[
  RowBox[{"10", "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114fd905-c79d-9420-4774-d16ef229ff0a"],
 "): the distance-",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0047a90f-9cb0-808d-307c-4169154ad2d7"],
 " code turns a physical error rate ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e32fd7-26e6-6b71-7290-c6915293365b"],
 " into a logical rate of order ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["p", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a2652ed-88d4-efb2-7bde-4bb72966b598"],
 ". No noise realization was drawn; this is the closed form a Monte Carlo \
simulation estimates."
}], "Text",
 CellID->1779278278,ExpressionUUID->"0962d9db-7466-8598-3f11-d0857d10efe2"],

Cell["\<\
Because the rate is a formula, the pseudothreshold is a formula too, not a \
point read off a sampled curve. It is the physical rate at which encoding \
stops helping, where the logical rate first equals the physical one:\
\>", "Text",
 CellID->332869652,ExpressionUUID->"5b3d557b-19e1-b503-0ac3-4d259f951c69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p", " ", "/.", " ", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"rate", " ", "==", " ", "p"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", 
      RowBox[{"1", "/", "2"}]}]}], ",", " ", "p"}], "]"}]}]], "Input",
 CellLabel->"In[12]:=",
 CellID->870462011,ExpressionUUID->"529c5c95-0588-d8f1-02a4-55dfac22aadb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "4"], " ", 
   RowBox[{"(", 
    RowBox[{"3", "-", 
     SqrtBox["6"]}], ")"}]}], "}"}]], "Output",
 CellChangeTimes->{4.00094365376495*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"6d86ae63-92de-47c4-8388-5697a8adecdd"]
}, Open  ]],

Cell[TextData[{
 "The crossover returns as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", "-", 
    SqrtBox["6"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4", "\[TildeTilde]", "0.138"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18bedc4a-f6ca-97e0-4845-d617837cfdca"],
 ": below it the encoded qubit is more reliable than a bare one, above it the \
encoding costs more than it saves, and the boundary is an exact algebraic \
number. The same ",
 Cell[BoxData["QECLogicalErrorRate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f18273e-5cf5-00f5-0527-bf78548052df"],
 " call accepts circuit-level noise, ",
 Cell[BoxData[
  RowBox[{"QECNoiseModel", "[", 
   RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1890d11b-851d-d227-48af-c9452ca9a10d"],
 ", which charges every gate, reset, and readout in the syndrome-extraction \
circuit and returns an exact expression as long as the detector enumeration \
stays in range: for the five-qubit code that means a single round, ",
 Cell[BoxData[
  RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b8be800-baff-aedd-0988-026a3e8bf427"],
 ", since its distance-many default rounds push the enumeration past the \
exact-sum limit. Past that range ",
 Cell[BoxData[
  RowBox[{"QECStim", "[", 
   RowBox[{"code", ",", " ", "noise"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "224fae0e-4768-b263-5274-406872020149"],
 " emits the experiment as Stim source instead, so the large-scale regime \
hands off to the sampling simulators and matching decoders built around that \
format. The exact polynomial and the external sampler are two ends of one \
object: QF returns the closed form where a code is small enough to enumerate, \
and exports the circuit where it is not."
}], "Text",
 CellID->770594293,ExpressionUUID->"3d32ba1d-71ed-60b8-64c1-3c4707983282"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Claim 5: A quantum object is an ordinary Wolfram Language expression\
\>", "Section",
 CellID->416617480,ExpressionUUID->"3ccd4f42-4869-4b08-64f3-672c691c1652"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " this is what underlies everything above, the reason Claim 1's algebra is \
symbolic and Claim 4's three engines share one model: a QF object is a \
symbolic expression like any other in the language, so the kernel's own \
functions operate on the object and return another object. ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf63df4-f608-7ba6-348d-b4b183bd498c"],
 " exponentiates a generator into a propagator, ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60948258-d69f-7f2c-10ab-2405e32a4276"],
 " differentiates a parametrized gate into another operator, ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf5c13c-8c81-f0bf-098a-d9662535c285"],
 " and ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27ebc314-3813-af61-4de8-db5eb9a7f24b"],
 " build a Hamiltonian from named Paulis, and the closed-form scalars these \
objects yield pass into solvers like ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cd495b-92f8-de82-0ff3-61052772a4e8"],
 " and ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1597811c-d04f-58d0-43ac-1959e1fa2a3a"],
 ". Nothing is converted, extracted, or exported first: the same ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"],
 ", ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e10fbdd-fcac-b923-462f-f286f55e0809"],
 ", ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c26b95-e958-d351-18f1-82de88d2a1bb"],
 " one would call on a number-matrix act unchanged on a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b7d10b-4c3b-5ee0-7e4c-c95565ce24ca"],
 " and return a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ed67f4-ffa0-5cce-7093-7eb1fa552614"],
 ". The overload set is real but finite, ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dc0df98-8a2c-0889-7bff-d6c22fd95ad3"],
 " (and ",
 Cell[BoxData["MatrixExp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2226f602-e60c-c55a-53dd-e86f93beafa0"],
 "), ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ed808ee-885a-0ea1-76e7-a1c829ef548b"],
 ", ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1627cdbb-2852-50d0-3fdc-e4e549e7223a"],
 ", ",
 Cell[BoxData["Times"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801141d-c5dc-e96b-183e-8e46ec6ebbb1"],
 ", ",
 Cell[BoxData["Power"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fb5e010-3b47-28f4-554a-fa5abef27ade"],
 ", ",
 Cell[BoxData["Tr"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69461d9a-9714-a717-1f7d-94c422a60a7d"],
 ", ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"],
 " and the analytic functions act on operators; for ",
 Cell[BoxData["Eigenvalues"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17254721-59fc-dba5-3edb-5e8b5f8ea98f"],
 " or ",
 Cell[BoxData["Det"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],
 " one still reaches through ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<Matrix\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133f88c9-4e43-c7a8-42c4-21936bf7adf2"],
 "."
}], "Text",
 CellID->468951994,ExpressionUUID->"525bf512-066b-f79b-0278-ed5cb31fdde1"],

Cell[CellGroupData[{

Cell["Superposition by native arithmetic", "Subsection",
 CellID->1802328397,ExpressionUUID->"7020b0a8-e1ec-de26-21df-29f5979ea50c"],

Cell["\<\
Write a state as a sum of kets scaled by amplitudes, and check it against the \
named one:\
\>", "Text",
 CellID->328865975,ExpressionUUID->"6f4e56ea-c348-0e14-1576-4fb7f6fd557e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], " ", "+", " ", 
     RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], ")"}], "/", 
   RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "==", " ", 
  RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}]], "Input",
 CellLabel->"In[137]:= ",
 CellID->1270006433,ExpressionUUID->"2c7820da-3afe-8c15-5407-b984be88d77f"],

Cell[TextData[{
 "The comparison returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "491026a6-dd30-329c-7f2f-bf03d4ca80e6"],
 ": ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"],
 " and the scalar division act on the state objects, assembling ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], "+", 
     TemplateBox[{"1"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "295a1104-8f0a-9295-5f79-896e2abce0ff"],
 " as a genuine ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e49fcf-314b-942d-5c9b-16a940ffff77"],
 ", and QF's overloaded ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28081ee1-9923-6846-5837-97cb18d63aac"],
 " confirms it is ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35d104ab-d16d-b332-63ee-9df4e0191e18"],
 ". No amplitudes were extracted by hand, and the same arithmetic extends to \
the more substantial overloads below."
}], "Text",
 CellID->34003199,ExpressionUUID->"4f8fdcfc-c987-8804-75b4-d5b9e833db6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The exponential map: a generator becomes a propagator", "Subsection",
 CellID->1596250240,ExpressionUUID->"4bb02784-750c-cc73-794f-beee7cbe9759"],

Cell[TextData[{
 "The propagator of a Hamiltonian ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6368bf1a-89ab-f709-1117-3744285fda53"],
 " is the matrix exponential ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["H", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18aa8291-c565-6e81-48a9-1bdaec1034eb"],
 ". Write it directly, with the kernel's ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fb37437-3ad9-e813-3541-6e71bf6dbb79"],
 " acting on the generator object:"
}], "Text",
 CellID->1572158672,ExpressionUUID->"29c235d7-86a4-1a63-5ff1-ac9133516949"],

Cell[BoxData[
 RowBox[{"uexp", " ", "=", " ", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "t"}], ")"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[138]:= ",
 CellID->1137775047,ExpressionUUID->"7c4bd199-468e-1df0-2448-c8c3733b67da"],

Cell["Read its label and its matrix (trig-simplified):", "Text",
 CellID->573363004,ExpressionUUID->"5faac466-18c1-c293-05a9-de40997590f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"uexp", "[", "\"\<Label\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"MatrixForm", "@", 
    RowBox[{"FullSimplify", " ", "@", " ", 
     RowBox[{"ExpToTrig", " ", "@", " ", 
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{"uexp", "[", "\"\<Matrix\>\"", "]"}]}]}]}]}]}], "}"}]], "Input",\

 CellLabel->"In[139]:= ",
 CellID->1565937439,ExpressionUUID->"0b2a52a2-44e1-aebb-392a-4b0c6c95f481"],

Cell[TextData[{
 "The result is a new ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146756d1-ea39-ec02-3c1d-4f9a8fcdb768"],
 " whose label reads ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a7ee52b-d767-0389-4a05-fd74e21251d3"],
 " and whose matrix is the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419fd7e1-c297-cbe2-77a4-cecaf72399c8"],
 "-rotation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"], "\[ThinSpace]", 
   StyleBox["I", "TI"], "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"], "\[ThinSpace]", 
   StyleBox["X", "TI"], "=", 
   StyleBox["(",
    FontSize->1.2 Inherited], GridBox[{
     {
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}]},
     {
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}], 
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}]}
    }], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a33ac2f-4fb5-380e-2bc0-45896a418b54"],
 ". ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b56b9eb-04f6-5b17-696d-30b5ac83267d"],
 " performed a genuine matrix exponential on the operator, mixing the two \
levels through the off-diagonal ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],
 " rather than exponentiating entries one by one, and the generator was never \
reduced to a number-matrix first. (",
 Cell[BoxData[
  RowBox[{"MatrixExp", "[", "...", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db41629-8d3d-b9f9-2b4b-887324c90bc3"],
 " returns the identical operator.)"
}], "Text",
 CellID->1825661031,ExpressionUUID->"3f51d24b-32fb-3155-656e-d415468f83bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Operator algebra in one line", "Subsection",
 CellID->1952919625,ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell[TextData[{
 "Ordinary ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aa19f46-928a-afd4-3a5e-1720273cf53e"],
 " and scalar multiplication assemble a Hamiltonian on the object, and the \
Pauli decomposition reads the coefficients back out:"
}], "Text",
 CellID->162062935,ExpressionUUID->"31860dcc-84f8-941b-67bd-a4962d72ff61"],

Cell[BoxData[
 RowBox[{"hab", " ", "=", " ", 
  RowBox[{
   RowBox[{"a", " ", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], " ", "+", " ", 
   RowBox[{"b", " ", 
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}]}]], "Input",
 CellLabel->"In[140]:= ",
 CellID->1483832353,ExpressionUUID->"08371d00-4cf7-24ac-39cc-956a64838ef6"],

Cell["Read its label and its Pauli decomposition:", "Text",
 CellID->421271511,ExpressionUUID->"6e555e8f-0ad0-492d-166b-57e9af651877"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"hab", "[", "\"\<Label\>\"", "]"}], ",", " ", 
   RowBox[{"hab", "[", "\"\<PauliDecompose\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->"In[141]:= ",
 CellID->971430162,ExpressionUUID->"348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],

Cell[TextData[{
 "The operator carries the label ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "\[ThinSpace]", 
   StyleBox["X", "TI"], "+", 
   StyleBox["b", "TI"], "\[ThinSpace]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c065349-950a-8738-043e-4b131cbcea02"],
 ", and ",
 Cell[BoxData[
  RowBox[{"hab", "[", "\"\<PauliDecompose\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff276a9-5e86-52e3-7582-6ff35b3320c9"],
 " returns ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"X", " ", "->", " ", "a"}], ",", " ", 
    RowBox[{"Z", " ", "->", " ", "b"}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b6e2ad-c501-b7fc-4c4d-fbf6ecb51dc6"],
 ": a round-trip through the algebra, coefficients in by arithmetic and back \
out by decomposition, on a symbolic operator rather than a numeric lookup \
table. The algebra goes beyond arithmetic. The kernel's ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230cad6b-7900-e120-5133-453578bab00a"],
 " gives the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], 
   StyleBox["u", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "086f7f71-a7b7-bd3e-3815-773ad2430404"],
 " relation as an operator identity:"
}], "Text",
 CellID->411794565,ExpressionUUID->"0cdf8892-1d3f-31f6-34e4-21dc94cb83dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Commutator", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
    RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "]"}], " ", "==", 
  " ", 
  RowBox[{"2", " ", "I", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[142]:= ",
 CellID->211393631,ExpressionUUID->"7e0217c2-6a7a-d359-2631-8eac0f0ca1a3"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4104c6da-03d7-a765-773b-df84b6630a4f"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], ",", 
    StyleBox["Y", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "2", 
   StyleBox["i", "TI"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "731f4b84-5335-8b87-2125-62ee66c1d9ed"],
 ", computed on the operators and verified against ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["i", "TI"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315717aa-70ab-e706-676c-8ef4015fca6c"],
 "."
}], "Text",
 CellID->485898233,ExpressionUUID->"7c1b1617-f81f-7a45-2438-8850f9aa48af"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Operator calculus: recover ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70b05f1a-470c-9c9d-2040-574472bee6e7"],
 " from a target ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a8c5b06-7c6a-07f5-7ab4-5360751f6ddf"]
}], "Subsection",
 CellID->300459616,ExpressionUUID->"4fa3f928-0446-c8dd-7550-f172adf09a27"],

Cell[TextData[{
 "Claim 1 solved Hamiltonians forward into their propagators; the inverse is \
pure operator calculus. Choose a unitary trajectory ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3727240c-f62b-7b8f-5edc-be6983de49d5"],
 ", and the Hamiltonian that drives it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50637aef-2122-41f7-0011-73c950d713dd"],
 ", the basis of counterdiabatic driving and shortcuts to adiabaticity. \
Compose the target ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63773809-2d44-01f7-110c-b25344f153dd"],
 " from named gates:"
}], "Text",
 CellID->1400905077,ExpressionUUID->"7ede8b7e-b317-5b7c-26e5-233bc6a22646"],

Cell[BoxData[
 RowBox[{"utgt", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RZ\>\"", "[", 
     RowBox[{"t", "^", "2"}], "]"}], "]"}], " ", "@", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RX\>\"", "[", "t", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[143]:= ",
 CellID->900992407,ExpressionUUID->"75c8f24b-f46e-7672-23f7-f414fd1b5d58"],

Cell[TextData[{
 "Differentiate it as an operator with the kernel's ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d149507-d3df-875e-5b2b-0d60e66beda4"],
 " and close it with the operator's own ",
 Cell[BoxData["Dagger"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "772d62ae-4bf9-dab0-1ed3-7b086d8da89a"],
 ", forming ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a8c9a4d-0caa-515e-2ab3-1c17a55f23a4"],
 ":"
}], "Text",
 CellID->1909490419,ExpressionUUID->"6a4c6a75-6554-e0e6-1a73-8c3f0ce6b2cc"],

Cell[BoxData[
 RowBox[{"hdrive", " ", "=", " ", 
  RowBox[{"I", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"utgt", ",", " ", "t"}], "]"}], " ", "@", " ", 
    RowBox[{"utgt", "[", "\"\<Dagger\>\"", "]"}]}]}]}]], "Input",
 CellLabel->"In[144]:= ",
 CellID->809304935,ExpressionUUID->"29c3108e-8c9d-f317-5ff0-89e82529de7d"],

Cell["Read the control field off each axis:", "Text",
 CellID->1060035609,ExpressionUUID->"5b90d741-2df1-4c37-09af-cf2b4b84171d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
  " ", 
  RowBox[{"hdrive", "[", "\"\<PauliDecompose\>\"", "]"}]}]], "Input",
 CellLabel->"In[145]:= ",
 CellID->960351252,ExpressionUUID->"5a353f88-1ea4-a3d5-0bca-b6d29b56f13f"],

Cell[TextData[{
 "The controls return axis by axis as the drive ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["t", "TI"], "\[ThinSpace]", 
   StyleBox["Z", "TI"], "+", 
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], "\[ThinSpace]", 
   StyleBox["X", "TI"], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], "\[ThinSpace]", 
   StyleBox["Y", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c3a5085-d835-7232-65da-49eed9c04118"],
 ", with a vanishing identity component, traceless as a control should be. ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f71b61d-3801-a1b0-550e-2847b9b5f39a"],
 " operated on the ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c7c9f19-7bfc-9bea-6403-17437d8ee930"],
 " and returned a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bcd3c0f-0044-41be-79f2-b669b1f11384"],
 " (not a bare matrix), and composition ",
 Cell[BoxData["@"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250574e2-7568-dee6-533b-6dcc7c02a4cc"],
 ", ",
 Cell[BoxData["Dagger"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "570dea5b-028b-2dc3-7d32-0c05b73e7729"],
 ", and the Pauli decomposition all act on the same object; the defining \
identity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", 
   StyleBox["H", "TI"], "\[ThinSpace]", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559114f0-95cd-3728-03ae-8dba1c799a72"],
 " holds identically. The textbook inverse-design formula runs on the \
operator itself, with no differential solver involved."
}], "Text",
 CellID->1269096941,ExpressionUUID->"499d2cc9-9173-f7c8-7fa2-c5932007dd12"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Calculus on states too", "Subsection",
 CellID->2008479665,ExpressionUUID->"1b3687b6-15a3-de20-4acd-1ef09c57a50a"],

Cell["\<\
The derivative overload is not operator-only. Take a state whose amplitudes \
are functions of time. Build it:\
\>", "Text",
 CellID->29625565,ExpressionUUID->"073f26db-34e5-c8c2-2ec4-bf85bc919a28"],

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[146]:= ",
 CellID->9883570,ExpressionUUID->"27056d96-6b3e-545a-4d3a-84d00ecb3ea0"],

Cell["Differentiate it twice in place and add it back:", "Text",
 CellID->940978275,ExpressionUUID->"031df9cf-6b45-d275-3122-f0a90ef1a15f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"psi", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "2"}], "}"}]}], "]"}], 
     "[", "\"\<StateVector\>\"", "]"}], " ", "+", " ", 
    RowBox[{"psi", "[", "\"\<StateVector\>\"", "]"}]}], "]"}], " ", "//", " ",
   "Normal"}]], "Input",
 CellLabel->"In[147]:= ",
 CellID->173258875,ExpressionUUID->"79902eb9-9fc4-d4aa-2faf-c7e31a76bef0"],

Cell[TextData[{
 "The sum collapses to the zero vector: the object satisfies the harmonic \
identity ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox[
      StyleBox["\[Psi]", "TI"], "\[DoublePrime]"]},
    "Ket"], "=", 
   RowBox[{"-", 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e90dac8-e749-9c1a-16af-d39592fde760"],
 " through WL's own calculus, the second derivative taken on the ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f026f1c-d8c2-1814-5531-8759d9776b7e"],
 " directly."
}], "Text",
 CellID->792860948,ExpressionUUID->"5c65fa9b-46f3-ebf0-041a-f3c57287b9da"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The scalars flow into solvers", "Subsection",
 CellID->124530881,ExpressionUUID->"583cd303-9cb1-03ae-09c3-cb6d154451f4"],

Cell[TextData[{
 "When a QF object yields a symbolic scalar, the language's solvers take \
over. The expectation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "+", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18f1bad1-a8d9-f26a-488e-339ac96dc0b0"],
 " in the trial state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Y", "TI"]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd8e50a-7117-62ea-14e7-fd5400a23030"],
 " is a closed form. Build the trial state:"
}], "Text",
 CellID->1312473818,ExpressionUUID->"7b9c4f1f-9707-8ca1-29a4-675922b3d68b"],

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<RY\>\"", "[", "\[Theta]", "]"}], "]"}], "[", 
   RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "]"}]}]], "Input",
 CellLabel->"In[148]:= ",
 CellID->1627779716,ExpressionUUID->"0839f778-d15e-09ff-39c6-ef25e0eb5bc5"],

Cell[TextData[{
 "Form the energy ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["X", "TI"], "+", 
     StyleBox["Z", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7962e333-0c57-77b8-2f11-fb7da5e25d82"],
 ":"
}], "Text",
 CellID->294107029,ExpressionUUID->"0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"energy", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"psi", "[", "\"\<StateVector\>\"", "]"}], "]"}], " ", ".", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], " ", "+", " ", 
           
           RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ")"}], "[", 
         "psi", "]"}], ")"}], "[", "\"\<StateVector\>\"", "]"}]}], ",", " ", 
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[149]:= ",
 CellID->736271930,ExpressionUUID->"7517e465-645e-477c-232c-fe4f0deb2a46"],

Cell[TextData[{
 "Pass it to ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560e68d9-da1a-2272-7e35-8182dfaf7158"],
 ":"
}], "Text",
 CellID->406066173,ExpressionUUID->"46aa8ea3-37c3-4040-6ea9-270d427612aa"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
   RowBox[{
    RowBox[{"Maximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"energy", ",", " ", 
        RowBox[{"0", " ", "<=", " ", "\[Theta]", " ", "<=", " ", 
         RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", " ", "\[Theta]"}], "]"}], 
    " ", "//", " ", "FullSimplify"}]}], "]"}]], "Input",
 CellLabel->"In[150]:= ",
 CellID->783505316,ExpressionUUID->"6acb7fb5-f6da-6094-1ac9-76fe836f32fe"],

Cell[TextData[{
 "The energy is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5ec95d-e220-f105-2a65-e10697dac06f"],
 ", and ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05590d03-2064-1772-3366-a56d51117a58"],
 " returns ",
 Cell[BoxData[
  SqrtBox["2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef0eca9-2ea7-fc5e-268f-05f34b53c6a4"],
 ": the exact extremal value, recognizable as the operator norm of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "+", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b0040e-15e9-970f-014f-9e68a39dfa55"],
 ", a complete variational eigenvalue calculation done by composing objects \
with native arithmetic and optimization. The same approach certifies a \
physical threshold. The Werner state's realignment criterion, a quantity \
positive exactly when it witnesses entanglement, is a symbolic function of \
the mixing ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c5479d-c9fe-ab26-7ffb-5ec6ef88f60c"],
 ":"
}], "Text",
 CellID->1838581182,ExpressionUUID->"73b5640c-4acf-57ea-214b-7e566f7a3d30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"crit", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"QuantumEntanglementMonotone", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"\"\<Werner\>\"", "[", 
         RowBox[{"p", ",", " ", "2"}], "]"}], "]"}], ",", 
       " ", "\"\<Realignment\>\""}], "]"}], ",", " ", 
     RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[151]:= ",
 CellID->1015299810,ExpressionUUID->"12e31b8a-6cd9-3185-4290-92d4056d83ef"],

Cell["Turn the criterion into the exact entanglement threshold:", "Text",
 CellID->320909480,ExpressionUUID->"1c8dfb5f-95aa-8549-44b2-f3191c5cef93"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"crit", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], ",", " ", "p"}], 
  "]"}]], "Input",
 CellLabel->"In[152]:= ",
 CellID->1950243504,ExpressionUUID->"77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],

Cell[TextData[{
 "The criterion is ",
 Cell[BoxData[
  FractionBox[
   RowBox[{GridBox[{
      {
       RowBox[{"3", "-", "4", 
        StyleBox["p", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "-", "1"}], "2"]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122b6086-f39f-774a-4229-79e3862a5d90"],
 ", and ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],
 " turns it into the exact threshold: the Werner state is entangled precisely \
for ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["p", "TI"], "<", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a176158-c8f1-b5ca-1a2d-7905e8851f10"],
 ", a physical fact certified by passing a QF-derived expression to a native \
solver."
}], "Text",
 CellID->1158471628,ExpressionUUID->"59294b9d-2c6b-0af3-08d7-62c7451e58d9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Claim 6: Every object draws itself", "Section",
 CellID->600867794,ExpressionUUID->"4c93342e-976f-2690-74a0-ad88221b8cfa"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " Claim 5 let the kernel's functions read an object; here the object draws \
itself. Visualization is property dispatch, not a separate plotting library: \
each object provides plot properties that render through the Wolfram Language \
graphics system and forward its options, so a publication figure is one call \
on the object it depicts. The set of views is wide. States draw as Bloch \
vectors, amplitude and probability charts, and qudit pie and sector wheels; \
measurements as outcome histograms; stabilizer states as their binary \
symplectic tableau; circuits as gate diagrams, tensor-network graphs, and \
multiway and causal views. Adiabatic evolutions add spectrum, gap, and \
coupling plots (in the ",
 Cell[BoxData["QuantumOptimization"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],
 " sub-package), the underlying ",
 Cell[BoxData["TensorNetwork"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "386c40c3-2c7c-2bd7-6814-59ad4509793d"],
 " renders as a hypergraph through the TensorNetworks paclet, and the \
phase-space objects of Claim 2 plot as Wigner surfaces. Below, one example \
per object kind."
}], "Text",
 CellID->570648126,ExpressionUUID->"38a5d185-6c33-4099-685a-c8ef05c612e3"],

Cell[CellGroupData[{

Cell["A state on the Bloch sphere", "Subsection",
 CellID->1943045306,ExpressionUUID->"705b2160-d6f6-9bc7-2078-b94de280e92d"],

Cell["A single qubit draws its own Bloch vector:", "Text",
 CellID->1695469705,ExpressionUUID->"3ad5a48d-d13d-ee7b-6aea-3dd6e0c9b541"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", "/", "5"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", "/", "5"}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"Pi", "/", "3"}]}], "]"}]}]}], "}"}], "]"}], 
  "[", "\"\<BlochPlot\>\"", "]"}]], "Input",
 CellLabel->"In[153]:= ",
 CellID->808446663,ExpressionUUID->"3e286ad4-f19d-13f8-67d7-8391802861c2"],

Cell[TextData[{
 "The output is a ",
 Cell[BoxData["Graphics3D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ae3c14-0aab-252d-7055-b65eaf5f8c77"],
 " of the sphere with the state's arrow at polar angle ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", "/", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3710829e-7f3a-eae8-5d2f-1bd87accb832"],
 " and azimuth ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514f46f4-7214-5441-0775-5fbe07a13eab"],
 ": the geometry of the state, drawn by the state."
}], "Text",
 CellID->843355028,ExpressionUUID->"5a8341fe-fd5d-b2cd-0ab1-58bbf4e90017"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Amplitudes that keep their phases", "Subsection",
 CellID->2123001010,ExpressionUUID->"4cf942e0-12f7-a17b-7487-5bcaa683f041"],

Cell[TextData[{
 "A bar chart of probabilities discards the phases; ",
 Cell[BoxData["AmplitudesChart"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db09b50-0334-b760-7b4f-131ab6c61a4a"],
 " draws the complex amplitudes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["x", "TI"]], "=", 
   TemplateBox[{
     StyleBox["x", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cb56032-9c81-172f-244b-7a7c15347a75"],
 " themselves, heights for the magnitudes ",
 Cell[BoxData[GridBox[{
    {
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["x", "TI"]]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f15dca-bfed-9606-038f-54943999fd6c"],
 " and colors for the phases ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arg",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5589ad74-704a-26e9-03b6-453e01fc8c33"],
 ". Apply a quantum Fourier transform to the two-term superposition ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox["2"]], 
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"000"},
      "Ket"], "+", 
     TemplateBox[{"101"},
      "Ket"]}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37fda5d4-10fa-7e26-5d82-3c9ea08f450c"],
 ", which the transform spreads into a phase-rich pattern across all eight \
basis states:"
}], "Text",
 CellID->1415208481,ExpressionUUID->"6cc64ef1-7b65-373d-14fe-67bb7e119a07"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "]"}], "[", "\n", "  ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"Normalize", "[", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", 
       " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}], "]"}], "]"}], "[", 
  RowBox[{"\"\<AmplitudesChart\>\"", ",", " ", "\n", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", " ", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[154]:= ",
 CellID->80082845,ExpressionUUID->"542582fc-1c6f-cfd5-7dda-1ba6951b953f"],

Cell[TextData[{
 "The eight bars return with magnitudes tracing an interference comb, a clean \
null at ",
 Cell[BoxData[
  TemplateBox[{"100"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ad84463-32de-d6a2-2af8-5e4d4768bc88"],
 ", and the surviving bars tinted by a wheel of distinct phase colors keyed \
by the legend: the QFT's phase ramp made visible alongside the magnitudes, \
the full complex state in one figure."
}], "Text",
 CellID->730828669,ExpressionUUID->"3261459d-f728-27c9-621f-5cc682c28d13"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A measurement draws its statistics", "Subsection",
 CellID->20229285,ExpressionUUID->"331c7f17-1677-2611-6124-7751a3038d7b"],

Cell[TextData[{
 "A ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cbe893-f079-1a7f-3cc8-01dc810c6945"],
 " object charts its own outcome distribution, the Born probabilities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["x", "TI"], 
         StyleBox["\[Psi]", "TI"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],
 ". Run the Bernstein-Vazirani circuit for a hidden string ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "1011"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "355f53e5-dafb-cebc-6365-4acede8f9486"],
 ", a single oracle query that encodes ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492c649c-8337-646c-78d4-7dc636c24eb6"],
 " in the interference pattern, and let it draw the statistics of its own \
final measurement:"
}], "Text",
 CellID->865532999,ExpressionUUID->"1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", "\n", "   ", 
    RowBox[{"\"\<BernsteinVazirani\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}], 
     "]"}], "]"}], "[", "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", " ", "\n", " ", 
   RowBox[{"\"\<LabelsAngle\>\"", " ", "->", " ", 
    RowBox[{"90", " ", "Degree"}]}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}]}], "]"}]], "Input",
 CellLabel->"In[155]:= ",
 CellID->1719354248,ExpressionUUID->"5c54ceec-a669-4ede-046b-e7c9d31c1424"],

Cell[TextData[{
 "The histogram collapses to a single bar of height ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336f4c4f-cb14-5955-6115-6628eea12bbf"],
 " at ",
 Cell[BoxData["1011"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],
 ", every other outcome exactly zero: one query has extracted the entire \
hidden string from the Born statistics, the deterministic signature of the \
algorithm. The hardware result in Claim 7 is the same kind of object, which \
is why simulated and measured statistics compare so directly there."
}], "Text",
 CellID->803807756,ExpressionUUID->"2580083d-358c-3435-53bf-a267bc3e9f1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A stabilizer state shows its tableau", "Subsection",
 CellID->601042471,ExpressionUUID->"477fde83-a5ae-c17e-6d04-d7eccc589044"],

Cell[TextData[{
 "The stabilizer states of Claim 4 have a native picture of their own: the \
binary symplectic tableau, the actual data structure the formalism computes \
on. Feed the five-cycle graph ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], "5"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0782fdeb-454d-5eca-2db1-f4b56cf82410"],
 " straight into ",
 Cell[BoxData["PauliStabilizer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a01936-08b2-60cf-1f5f-9170a9473215"],
 " to build its ring cluster state, and draw the tableau:"
}], "Text",
 CellID->2038927162,ExpressionUUID->"553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PauliStabilizer", "[", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<Graph\>\"", "[", 
     RowBox[{"CycleGraph", "[", "5", "]"}], "]"}], "]"}], "]"}], 
  "[", "\"\<TableauForm\>\"", "]"}]], "Input",
 CellLabel->"In[156]:= ",
 CellID->1188205371,ExpressionUUID->"6c0b44c7-b7b3-5c45-1409-5da0c24626af"],

Cell[TextData[{
 "The display is the sign column beside a ten-by-ten binary grid, dividers \
separating the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dba914e-52ed-e087-7b59-09286699b2ed"],
 " bits from the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497e5609-e734-e246-7f06-485292c6b0ac"],
 " bits and the destabilizer rows from the stabilizer rows; the stabilizer \
rows are the five ring generators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], 
    StyleBox["v", "TI"]], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["v", "TI"]], 
   UnderscriptBox["\[Product]", 
    RowBox[{
     StyleBox["w", "TI"], "\[Tilde]", 
     StyleBox["v", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["w", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c79fc2-e932-c645-38fc-16af88c4acaf"],
 ", so the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2184153d-b162-7859-57bb-8d66c0174aa3"],
 " block is literally the adjacency matrix of the cycle while the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],
 " block is the identity. This view is the algebra itself: the entanglement \
geometry of the ring is drawn in the binary pattern, and a Clifford gate acts \
by rewriting a few columns of this grid."
}], "Text",
 CellID->1003860385,ExpressionUUID->"554ef748-00c8-cf17-0375-ef12b162927d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The circuit, and the network behind it", "Subsection",
 CellID->952137231,ExpressionUUID->"40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],

Cell["\<\
A circuit draws itself as a gate diagram. Take quantum phase estimation, the \
subroutine inside Shor's factoring and the HHL linear solver, on three \
counting qubits:\
\>", "Text",
 CellID->1052272830,ExpressionUUID->"7ee2421b-c68a-4a96-2692-6444f33f18fc"],

Cell[BoxData[
 RowBox[{"qpe", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<PhaseEstimation\>\"", "[", "3", "]"}], "]"}]}]], "Input",
 CellLabel->"In[157]:= ",
 CellID->775731387,ExpressionUUID->"79971006-243c-6fe2-2fac-8a604dc935c8"],

Cell["Draw it as a gate diagram:", "Text",
 CellID->975612517,ExpressionUUID->"61109047-93e0-1377-172f-0a2125957e5d"],

Cell[BoxData[
 RowBox[{"qpe", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[158]:= ",
 CellID->105335494,ExpressionUUID->"341c784b-10c0-0bab-5c24-7215a17559f1"],

Cell["\<\
The wire-and-gate picture lays out the algorithm: Hadamards on the counting \
register, the controlled powers of the unitary, and the inverse Fourier \
transform that reads the phase back. The same object also draws its internal \
structure, the tensor network that the engine contracts:\
\>", "Text",
 CellID->1276006902,ExpressionUUID->"4125a490-d89a-105a-70da-3dddd92f62a0"],

Cell[BoxData[
 RowBox[{"qpe", "[", "\"\<TensorNetworkGraph\>\"", "]"}]], "Input",
 CellLabel->"In[159]:= ",
 CellID->429330924,ExpressionUUID->"0b67f461-4283-7871-391c-ee4b77364b5b"],

Cell[TextData[{
 "A ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79999c45-ea42-0b46-2fa6-162e8ff759ac"],
 " whose vertices are the gate and state tensors and whose edges are the \
contracted indices: the diagram shows the physics, the network shows the \
computation, and Claim 4 steered the order in which such a network is \
contracted."
}], "Text",
 CellID->699653744,ExpressionUUID->"5fae9c0a-8a55-fd6e-0555-16542fe1c7b4"],

Cell["\<\
The same network renders in the dual picture too, as a hypergraph in which \
the roles swap, every index a vertex and every tensor one hyperedge spanning \
its indices:\
\>", "Text",
 CellID->2118070064,ExpressionUUID->"1ae1fb24-4e58-6c4d-4a9e-f28e6bed3697"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qpe", "[", "\"\<TensorNetwork\>\"", "]"}], 
  "[", "\"\<Hypergraph\>\"", "]"}]], "Input",
 CellLabel->"In[160]:= ",
 CellID->1744932242,ExpressionUUID->"0a4afb14-05e6-4298-3a49-f35eb39310e2"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData["Hypergraph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a681de3-120d-8f0a-4a17-94cda7b9d250"],
 " with one hyperedge per tensor of the phase-estimation circuit, drawn over \
the network's indices: the tensor-contraction picture of the algorithm, in \
which contracting two tensors is the merging of two hyperedges."
}], "Text",
 CellID->551334296,ExpressionUUID->"7fe8910c-2477-6bad-2597-09564d0239f7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Claim 7: An interoperability hub, down to real hardware", "Section",ExpressionUUID->"3e004eff-b96d-473b-acbc-00cd9fafa205"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " the objects so far stayed inside QF; this claim sends them out. A QF \
object can leave QF for the rest of the quantum ecosystem, and foreign \
circuits can enter it; ",
 Cell[BoxData["QuantumQASM"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25e54c9f-94b3-4a19-8e98-7426abbb38ce"],
 " is the single OpenQASM interface, and it runs in pure Wolfram Language \
with no external account. Each step below extends the interface: text export, \
foreign import, device-aware transpilation, and finally a physical quantum \
processor."
}], "Text",ExpressionUUID->"aa1c0170-db6d-41df-b45c-5c6ea2b68ff1"],

Cell[TextData[{
 StyleBox["Closest competitor.",
  FontWeight->"Bold"],
 " Posting OpenQASM to a hardware provider is not itself unusual, MATLAB has \
submitted circuits to IBM Python-free since R2023b; the defensible part here \
is that device-native ISA transpilation runs in Wolfram Language and the same \
symbolic objects leave and re-enter the framework unchanged."
}], "Text",ExpressionUUID->"61d3965b-261b-4754-98f0-94ea17266687"],

Cell[CellGroupData[{

Cell["Export to OpenQASM 3.0 (native, no Python)", "Subsection",ExpressionUUID->"d1e58280-7408-486b-87de-b1a58be2de1b"],

Cell[TextData[{
 Cell[BoxData["QuantumQASM"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b1690b-150a-41c7-b30b-fa682b8a5b4f"],
 " turns a circuit into the standard text format read by Qiskit, Cirq, and \
most hardware stacks."
}], "Text",ExpressionUUID->"3f5f0399-8f84-48b8-b631-a23af5c49492"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumQASM", "[", 
  RowBox[{"QuantumCircuitOperator", "[", "\"\<Toffoli\>\"", "]"}], 
  "]"}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"67a2298b-27e4-4b79-a0bf-da7bac7a3695"],

Cell[BoxData["\<\"OPENQASM 3.0;\\nqubit[3] q;\\nbit[0] \
c;\\nU(1.5707963267948966, 0., 3.141592653589793) q[2];\\nctrl(1) @ \
negctrl(0) @ U(3.141592653589793, 0., 3.141592653589793) q[1] q[2];\\nU(0., \
0., 5.497787143782138) q[2];\\nctrl(1) @ negctrl(0) @ U(3.141592653589793, \
0., 3.141592653589793) q[0] q[2];\\nU(0., 0., 0.7853981633974483) \
q[2];\\nctrl(1) @ negctrl(0) @ U(3.141592653589793, 0., 3.141592653589793) \
q[1] q[2];\\nU(0., 0., 5.497787143782138) q[2];\\nctrl(1) @ negctrl(0) @ \
U(3.141592653589793, 0., 3.141592653589793) q[0] q[2];\\nU(0., 0., \
0.7853981633974483) q[1];\\nU(0., 0., 0.7853981633974483) \
q[2];\\nU(1.5707963267948966, 0., 3.141592653589793) q[2];\\nctrl(1) @ \
negctrl(0) @ U(3.141592653589793, 0., 3.141592653589793) q[0] q[1];\\nU(0., \
0., 0.7853981633974483) q[0];\\nU(0., 0., 5.497787143782138) q[1];\\nctrl(1) \
@ negctrl(0) @ U(3.141592653589793, 0., 3.141592653589793) q[0] q[1];\"\>"], \
"Output",
 CellChangeTimes->{3.9979912565320253`*^9, 3.9979918342637873`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"bd482676-6950-40af-8b53-96beda207821"]
}, Open  ]],

Cell[TextData[{
 "The output is a complete OpenQASM 3.0 program for the three-qubit Toffoli \
gate: rather than a single ",
 Cell[BoxData["ccx"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00de988b-9f7b-4250-a870-b5730b65bcb7"],
 " instruction, the emitter writes the standard Clifford+",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0b95e63-0175-4d62-b546-3ebba4b3040a"],
 " decomposition, six CNOTs (each a ",
 Cell[BoxData[
  RowBox[{"ctrl", " ", "@", " ", "U"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "86426e6f-ebda-4cab-a3e0-13042460564c"],
 ") interleaved with the non-Clifford ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7a7cda0-aa7f-4dcb-8ccc-86429dfc0f4d"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["T", "TI"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b99bce9e-5015-4798-bfda-a0704b4f1ec8"],
 " phases and a pair of Hadamards bracketing the target, every gate a \
concrete ",
 Cell[BoxData["U"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6dc6d00-c7f1-4614-b4e8-2a0e500d2bd6"],
 " rotation. The native emitter writes OpenQASM 3.0, and the importer below \
reads OpenQASM 2.0 or 3.0 alike. A 2.0 export is available through the qiskit \
path, ",
 Cell[BoxData[
  RowBox[{"QuantumQASM", "[", 
   RowBox[{"circuit", ",", " ", 
    RowBox[{"\"\<Version\>\"", " ", "->", " ", "2"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63cf8094-e78c-41ff-a6d2-268f7126836a"],
 " (that route needs Python; the 3.0 export and all imports do not). Export \
needs concrete angles: a circuit with a symbolic parameter returns a ",
 Cell[BoxData["Failure"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19520fb5-e964-4e0e-b6fe-a9fa677d8027"],
 " rather than a QASM string, so resolve parameters to numbers at this \
boundary while keeping them symbolic everywhere else in QF (Claims 1 and 5)."
}], "Text",ExpressionUUID->"5cbb814c-85c8-402c-8670-d5b3ca3bd24d"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Import foreign OpenQASM and compute with it (native, no Python)\
\>", "Subsection",ExpressionUUID->"8f6054a8-4063-406c-9b79-530f279d8b13"],

Cell[TextData[{
 "The same interface runs the other way: give ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6382ccf-2e3d-41a4-b516-fb4d2cb41234"],
 " an OpenQASM string authored anywhere and get back a QF circuit, parsed in \
pure WL, including ",
 Cell[BoxData["reset"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11c319bf-5a7b-4fc1-b613-ad0c6463ee78"],
 ", controlled gates, and mid-circuit ",
 Cell[BoxData["measure"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac57aa62-496c-4175-b517-98fb251cd344"],
 ". The importer reads each gate's angle as a Wolfram Language expression, so \
the angles can stay symbolic: write ",
 Cell["Pi/2", "InlineCode",ExpressionUUID->
  "6309fe26-55dc-4962-ada3-bbf1f5913b6e"],
 " and ",
 Cell[BoxData["Pi"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e81bdea-8070-426b-9fbf-750dda2fbc2e"],
 ", the exact constant, in place of their decimal expansions, and the \
imported circuit is exact rather than a floating-point copy. Import a \
four-qubit circuit that runs the optimal quantum strategy for the CHSH game:"
}], "Text",ExpressionUUID->"7c10000d-2c5d-42d7-920e-de90a678bb3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"chsh", " ", "=", " ", 
  RowBox[{
  "QuantumCircuitOperator", 
   "[", "\"\<OPENQASM 3.0;\nqubit[4] q;\nbit[4] c;\nreset q[0];\nreset q[3];\n\
U(Pi/2, 0, Pi) q[3];\nU(Pi/2, 0, Pi) q[0];\nswap q[0] q[3];\nctrl(0) @ \
negctrl(1) @ U(Pi/2, Pi, Pi) q[0] q[3];\nctrl(1) @ negctrl(0) @ U(Pi/2, 0, 0) \
q[0] q[3];\nreset q[1];\nU(Pi/2, 0, Pi) q[1];\nreset q[2];\nU(Pi/2, 0, Pi) \
q[2];\nU(0, 0, 0) q[0];\nctrl(1) @ negctrl(0) @ U(Pi/2, 0, Pi) q[1] q[0];\n\
U(Pi/4, 0, 0) q[3];\nctrl(0) @ negctrl(1) @ U(Pi/2, 0, Pi) q[2] q[3];\nc[0] = \
measure q[0];\nc[1] = measure q[1];\nc[2] = measure q[2];\nc[3] = measure \
q[3];\>\"", "]"}]}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"987ae993-39c0-4566-b96c-c5c773aff062"],

