Cell[TextData[{
 "Quench the product state ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 " under it, that is, compute ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["t", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["H", "TI"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{"01"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 ":"
}], "Text",
 CellID->2099805207,ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

