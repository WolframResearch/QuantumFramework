Cell[TextData[{
 "The diagram lays out the whole code on five wires: the labeled ",
 Cell[BoxData["Encode"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55951090-ef25-ccfd-03aa-89dd8ad196c7"],
 " block spreading the data qubit across the three code qubits, the ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a2ca13-da2c-324e-0151-ec5cdfde8094"],
 " error on qubit ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5930221d-821b-4026-08cf-c44737ae130c"],
 ", the two parity measurements placing their syndromes on record wires ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ba63e9-5df8-c241-1e5a-7ab3547290ab"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "319e51f9-a9ce-1d21-67a6-48a2c87b640b"],
 ", and the three corrections acting from those records, each an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4962c-805e-a216-4e8b-087631e8f17c"],
 " controlled on one record and anti-controlled on the other. Run it on a \
fully symbolic data qubit:"
}], "Text",
 CellID->565659401,ExpressionUUID->"313d5a7b-7caf-7acc-60c3-5c25755a4816"],

Cell[CellGroupData[{

