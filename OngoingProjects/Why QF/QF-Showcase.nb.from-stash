}, Open  ]],

Cell[TextData[{
 "Every amplitude of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}], "-", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 " returns identically zero in the symbolic ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 " (the truncation-edge amplitude excluded): the defining equation, verified \
for the whole family of coherent states at once."
}], "Text",
 CellID->861714746,ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],

Cell[TextData[{
 "The property that earns these states the name \"most classical states of \
light\" is dynamical: under the oscillator Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 " a coherent state remains a coherent state, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["H", "TI"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox["t", "TI"], "/", "2"}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Alpha]", "TI"], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
           StyleBox["i", "TI"], 
           StyleBox["\[Omega]", "TI"], 
           StyleBox["t", "TI"]}]]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 ", its label ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 " rotating about the origin of phase space at frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 ", like a classical oscillator amplitude, up to the overall phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 ". Compute the oscillator propagator with ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34baef30-7963-b757-5c59-077a78171dbd"],
 ", symbolically:"
}], "Text",
 CellID->1192942815,ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"uosc", " ", "=", " ", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{
    RowBox[{"\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"aOp", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "aOp"}], 
       " ", "+", " ", 
       RowBox[{"1", "/", "2"}]}], ")"}]}], ",", " ", "None", ",", " ", "t"}], 
   "]"}]}]], "Input",
 CellLabel->"In[62]:=",
 CellID->556077107,ExpressionUUID->"38a9ac88-4644-6c0e-6856-45d273f13754"],

