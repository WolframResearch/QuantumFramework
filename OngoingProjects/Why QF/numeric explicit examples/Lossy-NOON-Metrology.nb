 CellID->705466992],
Cell[7742, 221, 339, 8, 70, "Section",ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66",
 CellID->1350516518],
Cell[8084, 231, 1269, 33, 70, "Text",ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105",
 CellID->907546795],
