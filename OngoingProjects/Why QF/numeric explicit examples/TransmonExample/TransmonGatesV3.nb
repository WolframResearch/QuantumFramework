Cell["\<\
Single-qubit gates on current devices last about 35 ns. The same pulse at \
that length:\
\>", "Text",
 CellID->1593449978,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"model", "[", 
      RowBox[{
      "anharmonicity", ",", " ", "1", ",", " ", "0", ",", " ", "0", ",", " ", 
       "35"}], "]"}], ",", " ", 
