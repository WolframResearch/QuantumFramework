       RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", "\n", 
   "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<|0\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<|1\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<|2\[RightAngleBracket]\>\"", ",", 
      " ", "\"\<pulse shape (scaled)\>\""}], "}"}]}], ",", "\n", "  ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<population change during a \[Pi] pulse\>\""}], ",", "\n", "  ", 
   
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t (ns)\>\"", ",", " ", "\"\<population\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->2141499446,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[TextData[{
 "Population passes through ",
