The populations of the three lowest levels during the pulse, together with \
the shape of the pulse scaled to a peak of 1:\
\>", "Text",
 CellID->1606118752,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"psi", "[", "t", "]"}], "[", "\"\<ProbabilitiesList\>\"", 
        "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", " ", "3"}], "]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"envelope", "/", 
        RowBox[{"(", 
         RowBox[{"envelope", " ", "/.", " ", 
          RowBox[{"t", " ", "->", " ", "4"}]}], ")"}]}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"A", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\[Tau]", " ", "->", " ", "8"}]}], "}"}]}]}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "8"}], "}"}], ",", "\n", "  ", 
