    "]"}], "[", "\"\<Probabilities\>\"", "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1742646261,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell["\<\
Leakage is now small, but the flip is still incomplete, because the drive \
shifts the qubit transition.\
\>", "Text",
 CellID->29467524,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell["What DRAG Does", "Section",
 CellID->1939141443,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[TextData[{
 "Define the final populations of a transmon truncated to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 " levels, without decay and dephasing. With strict precision goals the \
default integration method can stop partway through some pulses, so an \
explicit Runge-Kutta method is used:"
}], "Text",
 CellID->5047578,ExpressionUUID->"7c239bd0-3ff5-3b18-25d0-129ab9818662"],

Cell[BoxData[
 RowBox[{
  RowBox[{"finalPopulations", "[", 
   RowBox[{"n_", ",", " ", 
    RowBox[{"{", 
     RowBox[{
     "amplitude_", ",", " ", "drag_", ",", " ", "detuning_", ",", " ", 
      "length_"}], "}"}]}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumEvolve", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{"hamiltonian", "[", 
          RowBox[{"AnnihilationOperator", "[", "n", "]"}], "]"}], ",", " ", 
         RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
           "\[Alpha]", ",", " ", "A", ",", " ", "\[Lambda]", ",", " ", 
            "\[Delta]", ",", " ", "\[Tau]"}], "}"}]}]}], "]"}], "[", "\n", 
       "    ", 
       RowBox[{
       "anharmonicity", ",", " ", "amplitude", ",", " ", "drag", ",", " ", 
        "detuning", ",", " ", "length"}], "]"}], ",", "\n", "   ", 
      RowBox[{"FockState", "[", 
       RowBox[{"0", ",", " ", "n"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "length"}], "}"}], ",", " ", 
      RowBox[{"Method", " ", "->", " ", "\"\<ExplicitRungeKutta\>\""}], ",", 
      " ", 
      RowBox[{"PrecisionGoal", " ", "->", " ", "12"}], ",", " ", 
      RowBox[{"AccuracyGoal", " ", "->", " ", "14"}]}], "]"}], "[", "length", 
    "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}]}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->15008895,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[TextData[{
 "At 8 ns, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 " and no detuning, vary ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 " and compare the leakage, the final population of ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 ", with the transfer error, the population missing from ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 ":"
}], "Text",
 CellID->1892712309,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"finalPopulations", "[", 
           RowBox[{"5", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "drag", ",", " ", "0", ",", " ", "8"}], 
             "}"}]}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"drag", ",", " ", 
            RowBox[{"p", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"drag", ",", " ", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "}"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"drag", ",", " ", "0", ",", " ", "2", ",", " ", "0.1"}], 
       "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<leakage\>\"", ",", " ", "\"\<transfer error\>\""}], "}"}]}],
    ",", "\n", "  ", 
   RowBox[{"PlotLabel", " ", "->", " ", "\"\<8 ns \[Pi] pulse\>\""}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "\"\<population\>\""}], "}"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->787969749,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[TextData[{
 "Leakage is smallest just above the weak-drive value ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323a4b1c-b138-a791-63da-6359c0b20dfb"],
 ", but the transfer error is smallest at a much smaller ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 ": DRAG alone does not complete the flip. The amplitude and detuning are \
therefore calibrated together with ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 "."
}], "Text",
 CellID->525088789,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell["The Best Pulse Length", "Section",
 CellID->357930410,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell["\<\
The best length balances leakage against decay and dephasing. We therefore \
include both processes and, as on a real device, calibrate the pulse controls \
with them present.\
\>", "Text",
 CellID->1802489801,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[TextData[{
 "We describe the state by a density matrix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 " in our truncated five-level model. Keeping the same Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 ", we include energy decay and pure dephasing through the Lindblad master \
equation:"
}], "Text",
 CellID->115301326,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     StyleBox[
      RowBox[{"d", "\[Rho]"}], "TI"], 
     StyleBox[
      RowBox[{"d", "t"}], "TI"]], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["H", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      RowBox[{
       StyleBox["\[Mu]", "TI"], "\[Element]", "{", "1"}], ",", 
      RowBox[{
       StyleBox["\[Phi]", "TI"], "}"}]}],
     LimitsPositioning->False], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["\[Mu]", "TI"]], 
     StyleBox["\[Rho]", "TI"], 
     SubsuperscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["\[Mu]", "TI"], "\[Dagger]"], "-", 
     FractionBox["1", "2"], 
     SubsuperscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["\[Mu]", "TI"], "\[Dagger]"], 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["\[Mu]", "TI"]], 
     StyleBox["\[Rho]", "TI"], "-", 
     FractionBox["1", "2"], 
     StyleBox["\[Rho]", "TI"], 
     SubsuperscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["\[Mu]", "TI"], "\[Dagger]"], 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["\[Mu]", "TI"]]}], ")"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1651187567,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell["The two Lindblad operators, with their rates included, are", "Text",
 CellID->941376513,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["L", "TI"], "1"], "=", 
    FractionBox[
     StyleBox["b", "TI"], 
     SqrtBox[
      SubscriptBox[
       StyleBox["T", "TI"], "1"]]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["\[Phi]", "TI"]], "=", 
    RowBox[{
     SqrtBox[
      FractionBox["2", 
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["\[Phi]", "TI"]]]], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["b", "TI"], "\[Dagger]"], 
     RowBox[{
      StyleBox["b", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2120243592,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[TextData[{
 "The first describes energy decay from ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["n", "TI"], "-", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78287f93-0f12-7c52-2828-76ddaaa746b8"],
 ". The second describes pure dephasing: on its own, it damps the \
off-diagonal entries of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
 " while leaving the populations unchanged. The pure dephasing time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 " is related to the qubit\[CloseCurlyQuote]s energy decay time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 " and coherence time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 " by"
}], "Text",
 CellID->1047559317,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox["1", 
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["\[Phi]", "TI"]]], "=", 
    FractionBox["1", 
     SubscriptBox[
      StyleBox["T", "TI"], "2"]], "-", 
    FractionBox["1", 
     RowBox[{"2", 
      SubscriptBox[
       StyleBox["T", "TI"], "1"]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1820947576,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell[TextData[{
 "For this example, take ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "100", "\[ThinSpace]", 
   StyleBox["\[Mu]", "TI"], 
   StyleBox["s",
    FontSlant->"Plain"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 ". Express both times in nanoseconds:"
}], "Text",
 CellID->670734585,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell[BoxData[
 RowBox[{"T1", " ", "=", " ", 
  RowBox[{"T2", " ", "=", " ", "100000"}]}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->58232708,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[TextData[{
 "Compute the corresponding pure dephasing time ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 ", also in nanoseconds:"
}], "Text",
 CellID->393464600,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[BoxData[
 RowBox[{"dephasingTime", " ", "=", " ", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"1", "/", "T2"}], " ", "-", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "T1"}], ")"}]}]}], ")"}]}]}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->1484396876,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[TextData[{
 "Calibration simulates the pulse for many trial settings, so construct the \
Lindblad equation once, with the controls and the length as parameters. Set \
",
 Cell[BoxData[
  RowBox[{"\"\<ReturnEquations\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 " to obtain the equation and initial condition for a transmon starting in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " without solving them. Here ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " takes the operators ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["b", "TI"], "\[Dagger]"], 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " with their rates ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " supplied separately. The upper limit ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 " in ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 " is a placeholder, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Most"]], "paclet:ref/Most"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 " drops the time range, the last of the three results:"
}], "Text",
 CellID->1149283354,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"openEquations", ",", " ", "openState"}], "}"}], " ", "=", " ", 
   RowBox[{"Most", " ", "@", " ", 
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{
      RowBox[{"model", "[", 
       RowBox[{
       "anharmonicity", ",", " ", "A", ",", " ", "\[Lambda]", ",", " ", 
        "\[Delta]", ",", " ", "\[Tau]"}], "]"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{
          RowBox[{"b", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "b"}]}], 
        "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "T1"}], ",", " ", 
         RowBox[{"2", "/", "dephasingTime"}]}], "}"}]}], ",", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{"0", ",", " ", "5"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"\"\<ReturnEquations\>\"", " ", "->", " ", "True"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->1092188694,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[TextData[{
 "Represent each entry of the ",
 Cell[BoxData[
  RowBox[{"5", "\[Times]", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 " density matrix by a function of time. Substituting this matrix into the \
Lindblad equation gives the coupled equations for its 25 entries. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Normal"]], "paclet:ref/Normal"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " converts the sparse arrays in the equations to ordinary lists:"
}], "Text",
 CellID->559599970,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"densityEntries", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"\[Rho]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"densityEquations", " ", "=", " ", 
   RowBox[{
    RowBox[{"Normal", "[", "openEquations", "]"}], " ", "/.", " ", 
    RowBox[{"openState", " ", "->", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"s", ",", " ", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "s", "]"}], " ", "&"}], ",", " ", 
          "densityEntries", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[16]:= ",
 CellID->1710123944,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[TextData[{
 "Define ",
 Cell[BoxData["openSolution"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 ", which solves these equations with ",
 Cell[BoxData["NDSolveValue"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 " for numerical controls and length and returns the ",
 Cell[BoxData[
  RowBox[{"5", "\[Times]", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 " density matrix as functions of time. The precision and accuracy goals are \
raised because the errors computed below are small:"
}], "Text",
 CellID->934597701,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"openSolution", "[", 
    RowBox[{
     RowBox[{"amplitude_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"drag_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"detuning_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"length_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"densityEquations", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", " ", "->", " ", "amplitude"}], ",", " ", 
        RowBox[{"\[Lambda]", " ", "->", " ", "drag"}], ",", " ", 
        RowBox[{"\[Delta]", " ", "->", " ", "detuning"}], ",", " ", 
        RowBox[{"\[Tau]", " ", "->", " ", "length"}]}], "}"}]}], ",", "\n", 
     "  ", "densityEntries", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "length"}], "}"}], ",", " ", 
     RowBox[{"PrecisionGoal", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"AccuracyGoal", " ", "->", " ", "12"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->284780108,ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell["\<\
With the density matrix, the transfer error is one minus the second diagonal \
entry at the end of the pulse:\
\>", "Text",
 CellID->643798763,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"openError", "[", 
   RowBox[{
    RowBox[{"amplitude_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"drag_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"detuning_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"length_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
  RowBox[{"1", " ", "-", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"openSolution", "[", 
       RowBox[{
       "amplitude", ",", " ", "drag", ",", " ", "detuning", ",", " ", 
        "length"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "[", "length", "]"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->268959046,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[TextData[{
 "Calibrate a pulse by minimizing its transfer error with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NMinimize"]], "paclet:ref/NMinimize"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 ": over ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 " without DRAG, and also over ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
 " with DRAG. Both searches use the same bounds: ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["A", "TI"], "<", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 " keeps the pulse near area ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 ", ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["\[Lambda]", "TI"], "\[LessEqual]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 " is about twice the largest first-order leakage-cancelling value in the \
detuning range searched, and ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[Delta]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "0.5"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 " rad/ns. The variables, with the ranges the search starts from, and the \
bounds:"
}], "Text",
 CellID->403125484,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"controls", "[", "True", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amplitude", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"drag", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"detuning", ",", " ", 
       RowBox[{"-", "0.5"}], ",", " ", "0.5"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"controls", "[", "False", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amplitude", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"detuning", ",", " ", 
       RowBox[{"-", "0.5"}], ",", " ", "0.5"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bounds", " ", "=", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "amplitude", " ", "<", " ", "2"}], " ", "&&", 
    " ", 
    RowBox[{"0", " ", "<=", " ", "drag", " ", "<=", " ", "3"}], " ", "&&", 
    " ", 
    RowBox[{
     RowBox[{"-", "0.5"}], " ", "<=", " ", "detuning", " ", "<=", " ", 
     "0.5"}]}]}], ";"}]}], "Input",
 CellLabel->"In[19]:= ",
 CellID->931950651,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[TextData[{
 "Define ",
 Cell[BoxData["calibrate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6ad260-8ee1-565a-1569-d44a2a943ca0"],
 ". The search uses differential evolution with 10 trial pulses, starting \
from a given random seed:"
}], "Text",
 CellID->412518898,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"calibrate", "[", 
   RowBox[{"withDRAG_", ",", " ", "length_", ",", " ", "seed_"}], "]"}], " ", 
  ":=", " ", 
  RowBox[{"NMinimize", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"openError", "[", 
        RowBox[{
        "amplitude", ",", " ", "drag", ",", " ", "detuning", ",", " ", 
         "length"}], "]"}], ",", " ", "bounds"}], "}"}], " ", "/.", " ", 
     RowBox[{"If", "[", 
      RowBox[{"withDRAG", ",", " ", 
       RowBox[{"{", "}"}], ",", " ", 
       RowBox[{"drag", " ", "->", " ", "0"}]}], "]"}]}], ",", " ", 
    RowBox[{"controls", "[", "withDRAG", "]"}], ",", "\n", "  ", 
    RowBox[{"Method", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<DifferentialEvolution\>\"", ",", " ", 
       RowBox[{"\"\<SearchPoints\>\"", " ", "->", " ", "10"}], ",", " ", 
       RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "seed"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->622967176,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[TextData[{
 "Calibrate pulses from 6 to 40 ns, with and without DRAG. Each calibration \
runs with two random seeds and keeps the better result, so that a search \
stopping early does not show up as a false spike. The lengths are calibrated \
in parallel with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ParallelMap"]], "paclet:ref/ParallelMap"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],
 ". This is the longest computation in the tutorial:"
}], "Text",
 CellID->1358080856,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lengths", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"6", ",", " ", "24"}], "]"}], ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"26", ",", " ", "40", ",", " ", "2"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"scan", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"withDRAG", ",", " ", 
       RowBox[{"ParallelMap", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"length", ",", " ", 
           RowBox[{"First", "[", 
            RowBox[{"MinimalBy", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"calibrate", "[", 
                 RowBox[{"withDRAG", ",", " ", "length", ",", " ", "#"}], 
                 "]"}], " ", "&"}], " ", "/@", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", "First"}], 
             "]"}], "]"}]}], "]"}], ",", " ", "lengths", ",", "\n", "     ", 
         RowBox[{"Method", " ", "->", " ", "\"\<FinestGrained\>\""}]}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"True", ",", " ", "False"}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[21]:= ",
 CellID->320615307,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell["The transfer error of the calibrated pulse at each length:", "Text",
 CellID->1594238871,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"lengths", ",", " ", 
        RowBox[{"First", " ", "/@", " ", "#"}]}], "}"}], "]"}], " ", "&"}], 
    " ", "/@", " ", 
    RowBox[{"Values", "[", "scan", "]"}]}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<with DRAG\>\"", ",", " ", "\"\<without DRAG\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", 
    " ", "\"\<transfer error of the calibrated pulse\>\""}], ",", "\n", "  ", 
   
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<pulse length (ns)\>\"", ",", 
      " ", "\"\<transfer error\>\""}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->2002505366,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell["\<\
Leakage dominates at short lengths, and decay and dephasing at long ones, \
where both curves rise together. DRAG removes most of the leakage, so its \
curve turns up at a much shorter length and reaches a lower minimum. Near 10 \
ns the DRAG curve also has a dip narrower than the 1 ns spacing of the scan; \
a finer search finds its bottom below the lowest scanned point, as Da Costa \
Jesus et al. found for this pulse shape.\
\>", "Text",
 CellID->2121396920,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell["The lowest point of each curve:", "Text",
 CellID->993357154,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bestWithDRAG", ",", " ", "bestWithoutDRAG"}], "}"}], " ", "=", 
   " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"withDRAG", ",", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"Ordering", "[", 
            RowBox[{
             RowBox[{"First", " ", "/@", " ", 
              RowBox[{"scan", "[", "withDRAG", "]"}]}], ",", " ", "1"}], 
            "]"}], "]"}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"scan", "[", "withDRAG", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"scan", "[", "withDRAG", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
            RowBox[{"length", " ", "->", " ", 
             RowBox[{"lengths", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}]}], "}"}]}], "]"}]}], 
     "]"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"True", ",", " ", "False"}], "}"}]}]}], ";"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->50259360,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

Cell["\<\
The two best pulses: their lengths, errors with and without decay and \
dephasing, and controls:\
\>", "Text",
 CellID->680111415,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"summary", "[", 
    RowBox[{"{", 
     RowBox[{"error_", ",", " ", "rules_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pulse", " ", "=", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "amplitude", ",", " ", "drag", ",", " ", "detuning", ",", " ", 
          "length"}], "}"}], " ", "/.", " ", 
        RowBox[{"Append", "[", 
         RowBox[{"rules", ",", " ", 
          RowBox[{"drag", " ", "->", " ", "0"}]}], "]"}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<length (ns)\>\"", ",", " ", "\"\<error\>\"", ",", 
         " ", "\"\<error without decay and dephasing\>\"", ",", 
         " ", "\"\<amplitude\>\"", ",", " ", "\"\<DRAG coefficient\>\"", ",", 
         " ", "\"\<detuning (MHz)\>\""}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pulse", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", " ", "error", ",", " ", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"finalPopulations", "[", 
            RowBox[{"5", ",", " ", "pulse"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
         RowBox[{"pulse", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"pulse", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
         RowBox[{"1000", " ", 
          RowBox[{
           RowBox[{"pulse", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "Pi"}], ")"}]}]}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<with DRAG\>\"", " ", "->", " ", 
     RowBox[{"summary", "[", "bestWithDRAG", "]"}]}], ",", " ", 
    RowBox[{"\"\<without DRAG\>\"", " ", "->", " ", 
     RowBox[{"summary", "[", "bestWithoutDRAG", "]"}]}]}], "|>"}], 
  "]"}]}], "Input",
 CellLabel->"In[24]:= ",
 CellID->1912025938,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell["\<\
Without decay and dephasing both pulses are far better, so decay and \
dephasing set their errors. The DRAG pulse wins by being shorter.\
\>", "Text",
 CellID->1678275947,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell["Checks", "Section",
 CellID->1570109414,ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell[TextData[{
 "The transfer error follows only ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 ". The gate error averages, over the six input states ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], "\[PlusMinus]", 
     TemplateBox[{"1"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], "\[PlusMinus]", 
     RowBox[{
      StyleBox["i", "TI"], 
      TemplateBox[{"1"},
       "Ket"]}]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 ", one minus the overlap of the final density matrix with the X image of the \
input. The Hamiltonian at time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "-", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 " is the transpose of the Hamiltonian at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af863a9-1098-c609-1a98-7af3a112ad53"],
 ", so without decay and dephasing the pulse flips ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 " exactly as it flips ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 ". With them, the two errors agree closely, and calibrating on the gate \
error instead finds the same pulses."
}], "Text",
 CellID->746824257,ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"],

Cell[TextData[{
 "Define the final density matrix of a pulse for any initial density matrix \
",
 Cell[BoxData["rho0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 ". The first part of ",
 Cell[BoxData["densityEquations"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " is the Lindblad equation without its initial condition:"
}], "Text",
 CellID->966663717,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"finalDensityMatrix", "[", 
    RowBox[{"rho0_", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "amplitude_", ",", " ", "drag_", ",", " ", "detuning_", ",", " ", 
       "length_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "length", "]"}], " ", "&"}], ",", "\n", "  ", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"densityEquations", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "0", "]"}], " ", "&"}], ",", " ", 
             "densityEntries", ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], " ", "==", " ", "rho0"}]}], 
         "}"}], " ", "/.", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"A", " ", "->", " ", "amplitude"}], ",", " ", 
          RowBox[{"\[Lambda]", " ", "->", " ", "drag"}], ",", " ", 
          RowBox[{"\[Delta]", " ", "->", " ", "detuning"}], ",", " ", 
          RowBox[{"\[Tau]", " ", "->", " ", "length"}]}], "}"}]}], ",", "\n", 
       "   ", "densityEntries", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "length"}], "}"}], ",", " ", 
       RowBox[{"PrecisionGoal", " ", "->", " ", "10"}], ",", " ", 
       RowBox[{"AccuracyGoal", " ", "->", " ", "12"}]}], "]"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->634665076,ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell["Define the gate error:", "Text",
 CellID->1607396713,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gateError", "[", 
    RowBox[{
     RowBox[{"amplitude_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"drag_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"detuning_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"length_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{"Mean", "[", 
     RowBox[{"Map", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"in", " ", "=", " ", 
             RowBox[{"PadRight", "[", 
              RowBox[{"#", ",", " ", "5"}], "]"}]}], ",", " ", 
            RowBox[{"out", " ", "=", " ", 
             RowBox[{"PadRight", "[", 
              RowBox[{
               RowBox[{"Reverse", "[", "#", "]"}], ",", " ", "5"}], "]"}]}]}],
            "}"}], ",", "\n", "      ", 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "out", "]"}], " ", ".", " ", 
            RowBox[{"finalDensityMatrix", "[", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"in", ",", " ", 
                RowBox[{"Conjugate", "[", "in", "]"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
               "amplitude", ",", " ", "drag", ",", " ", "detuning", ",", " ", 
                "length"}], "}"}]}], "]"}], " ", ".", " ", "out"}], "]"}]}], 
         "]"}], " ", "&"}], ",", "\n", "    ", 
       RowBox[{"Normalize", " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "I"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "I"}]}], "}"}]}], "}"}]}]}], "]"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->171231949,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["The gate errors of the two best pulses:", "Text",
 CellID->820919957,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{
    RowBox[{"\"\<with DRAG\>\"", " ", "->", " ", 
     RowBox[{"gateError", "[", 
      RowBox[{
      "amplitude", ",", " ", "drag", ",", " ", "detuning", ",", " ", 
       "length"}], "]"}]}], " ", "/.", " ", 
    RowBox[{"Last", "[", "bestWithDRAG", "]"}]}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"\"\<without DRAG\>\"", " ", "->", " ", 
     RowBox[{"gateError", "[", 
      RowBox[{
      "amplitude", ",", " ", "0", ",", " ", "detuning", ",", " ", "length"}], 
      "]"}]}], " ", "/.", " ", 
    RowBox[{"Last", "[", "bestWithoutDRAG", "]"}]}]}], "|>"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1006830744,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["\<\
The leakage of the uncalibrated 8 ns pulse for a transmon truncated to three \
to six levels:\
\>", "Text",
 CellID->1175763064,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", " ", 
     RowBox[{
      RowBox[{"finalPopulations", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "8"}], "}"}]}], 
       "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "3", ",", " ", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1074416020,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell["\<\
Three levels underestimate the leakage, and five and six agree, so five \
levels are enough.\
\>", "Text",
 CellID->2143439988,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

