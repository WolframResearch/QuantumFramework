Cell[TextData[{
 "Expose the bosonic (second-quantization) context, which carries ",
 Cell[BoxData["AnnihilationOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
