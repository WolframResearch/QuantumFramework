 StyleBox[ButtonBox["Wolfram Quantum Framework",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/"], None}], "TI"],
 ", Wolfram Paclet Repository."
}], "Text",
 CellID->-1934598401,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[TextData[{
 "[2] E. Farhi, J. Goldstone, and S. Gutmann, ",
 StyleBox[ButtonBox["A Quantum Approximate Optimization Algorithm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1411.4028"], None}], "TI"],
 ", 2014."
}], "Text",
 CellID->1939100292,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

