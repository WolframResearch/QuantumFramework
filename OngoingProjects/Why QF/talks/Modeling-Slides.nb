Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "15"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "589ec23b-a0bc-19e8-06a3-5a122767a528"],
 " every distribution is ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d1bad4f-c801-0b21-6449-294ce5c3f9d8"],
 " equal peaks at the multiples of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "536f0bb0-4b35-3d7c-7fea-ee4880d516b6"],
 "; for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "21"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13281830-aeb7-2ca5-1f08-e61d294a0c73"],
 " a peak at a ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fe84368-3741-9db5-39fa-2bb8e578afce"],
 " that falls between grid points spreads over neighboring ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6802193f-d3ed-25db-566f-3589b3b93892"],
 ", and the continued fractions of the outcomes above the cutoff still return \
the order. The factors follow whenever ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47657152-7957-c475-6c91-33522799fec0"],
 " is even and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], 
    RowBox[{
     StyleBox["r", "TI"], "/", "2"}]], "\[NotCongruent]", "-", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31a384ae-0b91-00ef-2ae7-977b88eadea0"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "14", "\[Congruent]", "-", "1", "(", 
   StyleBox["mod",
    FontSlant->"Plain"], " ", "15", ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "015491dc-ab1a-7db7-20ef-8ad574081ab3"],
 " gives only trivial divisors and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e21768a-a2fe-7bba-0e0e-df1933f98f51"],
 " has odd order mod 21, so in both cases the algorithm restarts with another \
",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066e0dc1-7d47-063e-4d5b-86f2e1157523"],
 "."
}], "Text",
 CellID->970833466,ExpressionUUID->"30473352-8102-2228-7732-5d4323a4fce3"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1378995657,ExpressionUUID->"37484245-2e39-e3b1-7ba5-0737717a1739"],

Cell["One oracle query: Deutsch-Jozsa and Bernstein-Vazirani", "Subsection",
 CellID->580140783,ExpressionUUID->"57173002-3367-d10a-2abf-4391c66994dc"],

Cell[TextData[{
 "An oracle evaluates a Boolean function ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25268be6-c543-ad1c-62a7-9ecce82b46af"],
 " of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12da5972-226a-d55a-7225-63944819950b"],
 " bits. Deutsch-Jozsa is promised that ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "225a422b-4b34-9451-2f5d-4374c7c1c364"],
 " is constant or balanced (zero on exactly half of the inputs) and must say \
which; Bernstein-Vazirani is promised ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["s", "TI"], "\[CenterDot]", 
   StyleBox["x", "TI"], 
   StyleBox["mod",
    FontSlant->"Plain"], "\[ThinSpace]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a0743b-a842-fb6a-61af-df57e5c15ca0"],
 " and must find the string ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bbadd0c-8844-af03-35a1-b4890e4f14ba"],
 ". Does a single query settle each problem?"
}], "Text",
 CellID->307583575,ExpressionUUID->"5fcfa335-cbce-7c03-15c2-ca7be3b7f66b"],

Cell[TextData[{
 "Both algorithms query the phase oracle ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["O", "TI"], 
     StyleBox["f", "TI"]], 
    TemplateBox[{
      StyleBox["x", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"-", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{
      StyleBox["f", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["x", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]], 
    TemplateBox[{
      StyleBox["x", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a9baedc-9bc8-e091-272e-65358f2918c6"],
 " once on ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4bf17a-1fe7-3ca2-1e2b-c662992b841e"],
 " and measure each qubit in the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59a9102b-c2c7-f336-4a62-482961f7fe8d"],
 " basis, which is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["H", "TI"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "006796e4-3503-6a20-3f91-7c6a13fc3ba5"],
 " followed by a computational-basis measurement. The Bernstein-Vazirani \
circuit here realizes the oracle with CNOTs onto an extra qubit in ",
 Cell[BoxData[
  TemplateBox[{"-"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d5bc48e-510b-1cfa-67d1-6df74e6f1e26"],
 ". The outcome ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20cda8ee-ddee-6b11-105b-e62c42eb4ec7"],
 " appears with probability"
}], "Text",
 CellID->1011282052,ExpressionUUID->"137df103-408b-fb66-35c5-fe29b172bd32"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["z", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         FractionBox["1", 
          SuperscriptBox["2", 
           StyleBox["n", "TI"]]], 
         UnderscriptBox["\[Sum]", 
          StyleBox["x", "TI"],
          LimitsPositioning->False], 
         SuperscriptBox[
          RowBox[{
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{"-", "1"}], 
           StyleBox[")",
            SpanMaxSize->1]}], 
          RowBox[{
           StyleBox["f", "TI"], 
           StyleBox["(",
            SpanMaxSize->1], 
           StyleBox["x", "TI"], 
           StyleBox[")",
            SpanMaxSize->1], "+", 
           StyleBox["z", "TI"], "\[CenterDot]", 
           StyleBox["x", "TI"]}]]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["P", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{"2", 
         StyleBox["w", "TI"]}], 
        SuperscriptBox["2", 
         StyleBox["n", "TI"]]]}], ")"}], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->385854727,ExpressionUUID->"162660ef-7966-3392-59fd-a6a310a14bc0"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03f17653-9da6-22fa-5b53-df835b041596"],
 " is the number of inputs ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e816c76-73fe-85b2-327a-f463a72e276f"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43062592-360b-c038-25b1-1d9f099999ab"],
 ", and for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["s", "TI"], "\[CenterDot]", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51f2f51e-f881-f9e0-4d7e-d50b58f853dc"],
 " the sum is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], 
   SubscriptBox[
    StyleBox["\[Delta]", "TI"], 
    RowBox[{
     StyleBox["z", "TI"], ",", 
     StyleBox["s", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e2dcb9c-1641-09d9-60d8-57b25bdb7caf"],
 "."
}], "Text",
 CellID->95678922,ExpressionUUID->"7445986b-31e3-bb84-4b0a-080bebdb8277"],

Cell[TextData[{
 "Deutsch-Jozsa runs on up to four random three-bit functions of each weight ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "145392aa-5914-f3ef-4343-d4dd962ee6ad"],
 " (points, offset sideways; the dashed curve is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647d25f7-722d-6061-1792-202b9f0bfe07"],
 " above), and Bernstein-Vazirani on all sixteen four-bit secrets:"
}], "Text",
 CellID->1226694590,ExpressionUUID->"49b76a34-1a4b-ff3c-6164-d00f3a7d80fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"djN", " ", "=", " ", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"djZeroProb", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{"\"\<DeutschJozsaPhase\>\"", "[", 
        RowBox[{"BooleanFunction", "[", 
         RowBox[{"k", ",", " ", "djN"}], "]"}], "]"}], "]"}], "[", "]"}], 
     "[", "\"\<ProbabilitiesList\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"djPoints", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
     RowBox[{"Catenate", "[", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"w", ",", " ", "ks"}], "}"}], ",", " ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sample", " ", "=", " ", 
              RowBox[{"RandomSample", "[", 
               RowBox[{"ks", ",", " ", 
                RowBox[{"UpTo", "[", "4", "]"}]}], "]"}]}], "}"}], ",", "\n", 
            "       ", 
            RowBox[{"MapIndexed", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"w", " ", "+", " ", 
                  RowBox[{"0.12", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Length", "[", "sample", "]"}], " ", "+", " ", 
                    "1"}], ")"}], "/", "2"}]}], ")"}]}]}], ",", " ", 
                 RowBox[{"djZeroProb", "[", "#1", "]"}]}], "}"}], " ", "&"}], 
              ",", " ", "sample"}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
        "     ", 
        RowBox[{"KeySort", "[", 
         RowBox[{"GroupBy", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{
              RowBox[{"2", "^", 
               RowBox[{"2", "^", "djN"}]}], " ", "-", " ", "1"}]}], "]"}], ",",
            " ", 
           RowBox[{
            RowBox[{"DigitCount", "[", 
             RowBox[{"#", ",", " ", "2", ",", " ", "1"}], "]"}], " ", "&"}]}],
           "]"}], "]"}]}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bvTable", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumCircuitOperator", "[", 
        RowBox[{"\"\<BernsteinVazirani\>\"", "[", 
         RowBox[{"IntegerString", "[", 
          RowBox[{"s", ",", " ", "2", ",", " ", "4"}], "]"}], "]"}], "]"}], "[",
        "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "0", ",", " ", "15"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Labeled", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"QuantumCircuitOperator", "[", 
              RowBox[{"\"\<DeutschJozsaPhase\>\"", "[", 
               RowBox[{"BooleanFunction", "[", 
                RowBox[{"15", ",", " ", "djN"}], "]"}], "]"}], "]"}], "[", 
             RowBox[{"\"\<Diagram\>\"", ",", " ", 
              RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}], ",", " ", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Deutsch-Jozsa, one balanced f\>\"", ",", " ", "13", 
              ",", " ", 
              RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
             "]"}], ",", " ", "Top"}], "]"}], ",", "\n", "    ", 
          RowBox[{"Labeled", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"QuantumCircuitOperator", "[", 
              RowBox[{"\"\<BernsteinVazirani\>\"", "[", "\"\<1011\>\"", "]"}],
               "]"}], "[", 
             RowBox[{"\"\<Diagram\>\"", ",", " ", 
              RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}], ",", " ", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<Bernstein-Vazirani, s = 1011\>\"", ",", " ", "13", ",",
               " ", 
              RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
             "]"}], ",", " ", "Top"}], "]"}]}], "}"}], "}"}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", "4"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Show", "[", 
           RowBox[{
            RowBox[{"ListPlot", "[", 
             RowBox[{"djPoints", ",", " ", 
              RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}], ",",
             " ", 
            RowBox[{"Plot", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", 
                 RowBox[{"2", " ", 
                  RowBox[{"w", "/", 
                   RowBox[{"2", "^", "djN"}]}]}]}], ")"}], "^", "2"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"w", ",", " ", "0", ",", " ", 
                RowBox[{"2", "^", "djN"}]}], "}"}], ",", " ", 
              RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", 
            " ", 
            RowBox[{"PlotRange", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "0.3"}], ",", " ", 
                 RowBox[{
                  RowBox[{"2", "^", "djN"}], " ", "+", " ", "0.3"}]}], "}"}], 
               ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "0.05"}], ",", " ", "1.05"}], "}"}]}], "}"}]}], 
            ",", "\n", "    ", 
            RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
            RowBox[{"FrameTicks", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"2", "^", "djN"}]}], "]"}], ",", " ", "None"}], 
                "}"}]}], "}"}]}], ",", " ", 
            RowBox[{"FrameLabel", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<weight w\>\"", ",", " ", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<P(z = \>\"", ",", " ", 
                  RowBox[{"StringRepeat", "[", 
                   RowBox[{"\"\<0\>\"", ",", " ", "djN"}], "]"}], ",", 
                  " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}], ",", " ", 
            RowBox[{"PlotLabel", " ", "->", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<Deutsch-Jozsa, n = \>\"", ",", " ", "djN"}], 
               "}"}], "]"}]}], ",", " ", 
            RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}], ",", "\n", 
          "   ", 
          RowBox[{"ArrayPlot", "[", 
           RowBox[{"bvTable", ",", " ", 
            RowBox[{"Mesh", " ", "->", " ", "All"}], ",", " ", 
            RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
            RowBox[{"FrameLabel", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<secret s\>\"", ",", " ", "\"\<outcome z\>\""}], 
              "}"}]}], ",", "\n", "    ", 
            RowBox[{"FrameTicks", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Thread", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"1", ",", " ", "16", ",", " ", "3"}], "]"}], ",", 
                    " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"0", ",", " ", "15", ",", " ", "3"}], "]"}]}], 
                   "}"}], "]"}], ",", " ", "None"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Thread", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Range", "[", 
                    RowBox[{"1", ",", " ", "16", ",", " ", "3"}], "]"}], ",", 
                    " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"0", ",", " ", "15", ",", " ", "3"}], "]"}]}], 
                   "}"}], "]"}], ",", " ", "None"}], "}"}]}], "}"}]}], ",", 
            "\n", "    ", 
            RowBox[{
            "PlotLabel", " ", "->", 
             " ", "\"\<Bernstein-Vazirani, n = 4: P(z | s), black = 1, white \
= 0\>\""}], ",", " ", 
            RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}]}], "}"}], 
        "}"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], "}"}], ",",
    " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[85]:= ",
 CellID->1375162702,ExpressionUUID->"149f216c-a29c-f04d-3887-b167ae4390ee"],

Cell[TextData[{
 "The constant functions return all zeros with certainty and the balanced \
ones never do, so under the promise one query decides. Every other function \
lands on the curve in between, where one query cannot decide. For every \
secret, the Bernstein-Vazirani outcome is ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6715e9ff-b7c0-fe23-192f-4896fae03636"],
 " itself with probability 1."
}], "Text",
 CellID->1085948026,ExpressionUUID->"2ddd7e05-f03d-6399-0141-e4b593ecf85e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
