  FontSize->0.9 Inherited,ExpressionUUID->
  "015575fd-fe06-8afd-535e-deee210cc918"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f4e01d-575b-fdac-6bec-1f48c5ad3b12"],
 "."
}], "Text",
 CellID->406898107,ExpressionUUID->"6bd9cdde-7c4e-dbc3-3417-ff98cbfd0be8"],

Cell[TextData[{
 "On resonance the whole ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56ecab17-e02f-9671-2c70-c74baccea0b8"],
 " propagator is solved exactly for general parameters; off resonance it is \
solved numerically. Each panel plots ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "1", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a82d8ff-a621-f833-214a-7952051258c1"],
 " from ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e5825ab-0cc2-4791-66f3-1d8b5bfdbda7"],
 " together with the pulse ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c9f31d4-8193-057b-6e95-9a8fb37a0243"],
 ", for pulses at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], "0"], "=", "4", 
   StyleBox["\[Tau]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "483bef91-f18d-6c8d-12dd-9d2ca0cc1a84"],
 " of total area ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SqrtBox[
    RowBox[{"2", "\[Pi]"}]], "\[ThinSpace]", 
   SubscriptBox["\[CapitalOmega]", "0"], 
   StyleBox["\[Tau]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ef141b-ce30-99c4-1043-ca4446b63db8"],
 "; every ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33511e25-bdb4-f347-5202-2db0464041b6"],
 " is drawn in units of the ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bc724e3-f9cc-ac87-1334-f9ba8aa9ae7b"],
 " pulse's peak, and time is in units of ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bd3bd98-76f1-cdc7-511e-5333a0b224b8"],
 ":"
}], "Text",
 CellID->407861122,ExpressionUUID->"5c799d08-5577-9311-1fe7-4633087deb10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pulseEq", "[", 
    RowBox[{"d_", ",", " ", "w_"}], "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"upul", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"d", "/", "2"}], " ", 
           RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"w", "/", "2"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"t", " ", "-", " ", "t0"}], ")"}], "^", "2"}]}], "/", 
             
             RowBox[{"(", 
              RowBox[{"2", " ", 
               RowBox[{"\[Tau]", "^", "2"}]}], ")"}]}], "]"}], " ", 
           RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ")"}], " ", ".", " ", 
        RowBox[{"upul", "[", "t", "]"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"upul", "[", "0", "]"}], " ", "==", " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"upulse", " ", "=", " ", 
   RowBox[{"DSolveValue", "[", 
    RowBox[{
     RowBox[{"pulseEq", "[", 
      RowBox[{"0", ",", " ", "\[CapitalOmega]0"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"upul", "[", "t", "]"}], " ", "\[Element]", " ", 
      RowBox[{"Matrices", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]}], ",", " ", "t"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pulseNum", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalOmega]0", " ", "->", " ", 
      RowBox[{"a", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", "Pi"}], "]"}]}]}], ",", " ", 
     RowBox[{"\[Tau]", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"t0", " ", "->", " ", "4"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pulseP1", "[", 
    RowBox[{"0", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"upulse", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}], "^", "2"}], " ", "/.",
     " ", 
    RowBox[{"pulseNum", "[", "a", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pulseP1", "[", 
    RowBox[{"d_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pulseEq", "[", 
       RowBox[{"d", ",", " ", "\[CapitalOmega]0"}], "]"}], " ", "/.", " ", 
      RowBox[{"pulseNum", "[", "a", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Indexed", "[", 
        RowBox[{
         RowBox[{"upul", "[", "t", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}], "]"}], "^", "2"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pulseDetunings", ",", " ", "pulseAreas"}], "}"}], " ", "=", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
