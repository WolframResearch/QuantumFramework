  FontSize->0.9 Inherited,ExpressionUUID->
  "648cc925-a282-f302-62fd-8049ce8102e6"],
 " under the propagator for general ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48f9899b-fa34-4049-1bda-5062daa5836a"],
 ", ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31bc31c6-a596-f7ce-40a3-abdf0cba08b2"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54c65a2b-2af3-9298-326c-bfc1ce6e9cc6"],
 "; the figure plots ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0036b6e8-cebc-712d-112f-532fc4654271"],
 " from ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["v", "TI"]], "\[ThinSpace]", 
   StyleBox["t", "TI"], "=", "-", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e49268-cbb0-9c22-249a-cbfb18a96235"],
 ", with the Landau-Zener value dashed:"
}], "Text",
 CellID->574174116,ExpressionUUID->"7118db98-e386-dbec-149e-4c85c5b45ad6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lzU", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", " ", 
         RowBox[{"t", "/", "2"}], " ", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
        
        RowBox[{
         RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
         RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", 
       "None", ",", " ", "t"}], "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lzStay", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"First", "[", 
         RowBox[{"lzU", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"v", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"\[CapitalDelta]", " ", "->", " ", 
             RowBox[{"Sqrt", "[", "r", "]"}]}]}], "}"}]}], "]"}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"u", " ", ".", " ", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"u", " ", "/.", " ", 
          RowBox[{"t", " ", "->", " ", 
           RowBox[{"-", "20"}]}]}], "]"}]}], "]"}], "^", "2"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lzRatios", ",", " ", "lzTimes"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.1", ",", " ", "0.6", ",", " ", "1.6"}], "}"}], ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "10"}], ",", " ", "10", ",", " ", "0.05"}], "]"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"lzTimes", ",", " ", 
          RowBox[{
           RowBox[{"lzStay", "[", "r", "]"}], " ", "/.", " ", 
           RowBox[{"t", " ", "->", " ", "lzTimes"}]}]}], "}"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "lzRatios"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[CapitalDelta]\.b2/v = \>\"", ",", " ", "#"}], "}"}],
           "]"}], " ", "&"}], " ", "/@", " ", "lzRatios"}], ")"}]}]}], "]"}], 
   ",", "\n", "  ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "Pi"}], " ", 
        RowBox[{"lzRatios", "/", "2"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\"\<v\>\"", "]"}], ",", " ", "\"\< t\>\""}], 
        "}"}], "]"}], ",", " ", "\"\<P(0)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[54]:= ",
 CellID->1686078773,ExpressionUUID->"11203f7a-0313-007b-6683-b1ae47f3e504"],

Cell[TextData[{
 "The qubit drops through the crossing at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf1f9ee-2a53-5fc0-074f-f370bdad3279"],
 " and then settles toward the Landau-Zener value through oscillations that \
fade as the levels separate; the asymptotic formula does not contain them. A \
slower sweep, larger ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]", "2"], "/", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67ea54ca-e17c-6718-2b9f-2eae3e8215a2"],
 ", leaves less population in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013ea8df-8b2e-0c75-3c3c-2834061b117a"],
 "."
}], "Text",
 CellID->1753397031,ExpressionUUID->"6529158d-e76a-72f7-4d20-119ce8dd6e59"],

