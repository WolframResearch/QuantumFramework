    StyleBox[
     RowBox[{"Bob", "\[NonBreakingSpace]", "applies", "\[NonBreakingSpace]"}],
     
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["Z", "TI"], 
     SubscriptBox[
      StyleBox["m", "TI"], "1"]], 
    RowBox[{
     SuperscriptBox[
