Cell["A particle bound by its own gravity", "Subsection",
 CellID->431106926,ExpressionUUID->"608b8ba1-715e-3617-10f8-f2e285da882a"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "142b2409-8a59-702c-2845-03b32e708f4d"],
 " moves in the Newtonian potential ",
 Cell[BoxData["\[CapitalPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a351d33-e016-73e6-0035-1ba94ea41c5b"],
 " sourced by its own mass density ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a31d787-5ac9-682b-648d-4783e6958dc1"],
 ": quantum spreading pushes the wave out, self-gravity pulls it in. What is \
the energy of its stationary bound state once the finite computational box of \
radius ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dbeb2c-01ad-aacb-2211-8056ed581dd6"],
 " is removed?"
}], "Text",
 CellID->1041745098,ExpressionUUID->"615ed9af-be0f-5c1a-0827-b67ac29a2051"],

Cell["The Schr\[ODoubleDot]dinger-Newton equations are", "Text",
 CellID->1031545896,ExpressionUUID->"4bc27973-6e3d-d9d1-6d11-75d5ce943628"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["i", "TI"], "\[HBar]", "\[ThinSpace]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["t", "TI"]], 
    StyleBox["\[Psi]", "TI"], "=", "-", 
    FractionBox[
     SuperscriptBox["\[HBar]", "2"], 
     RowBox[{"2", 
      StyleBox["m", "TI"]}]], 
    SuperscriptBox["\[Del]", "2"], 
    StyleBox["\[Psi]", "TI"], "+", 
    StyleBox["m", "TI"], "\[CapitalPhi]", "\[ThinSpace]", 
    StyleBox["\[Psi]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Del]", "2"], "\[CapitalPhi]"}], "=", 
    RowBox[{"4", "\[Pi]", 
     StyleBox["G", "TI"], 
     StyleBox["m", "TI"], "\[ThinSpace]", 
     RowBox[{
      SuperscriptBox[GridBox[{
         {
          StyleBox["\[Psi]", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1906315557,ExpressionUUID->"6ec99ac2-ccda-c0b8-6ea2-9c370e430716"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", 
   StyleBox["G", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27598694-12b3-6f6a-3d30-62ed01d3ac4c"],
 ", lengths in units of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[HBar]", "2"], "/", 
   StyleBox["G", "TI"], 
   SuperscriptBox[
    StyleBox["m", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75ada930-46b8-da05-097e-737e155b4a92"],
 ", a spherically symmetric stationary state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["E", "TI"], 
     StyleBox["t", "TI"]}]], "\[ThinSpace]", 
   StyleBox["u", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SqrtBox[
     RowBox[{"4", "\[Pi]"}]], "\[ThinSpace]", 
    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49bff435-9d9d-f04c-13b3-00644f3e7ef5"],
 " obeys"
}], "Text",
 CellID->919550063,ExpressionUUID->"7c514532-b558-755a-6fc0-8452727060f7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[CapitalPhi]", "\[DoublePrime]"], "+", 
    FractionBox["2", 
     StyleBox["r", "TI"]], 
    SuperscriptBox["\[CapitalPhi]", "\[Prime]"], "=", 
    FractionBox[
     SuperscriptBox[
      StyleBox["u", "TI"], "2"], 
     SuperscriptBox[
      StyleBox["r", "TI"], "2"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SuperscriptBox[
       StyleBox["u", "TI"], "\[DoublePrime]"]}], "+", 
     RowBox[{"\[CapitalPhi]", "\[ThinSpace]", 
      StyleBox["u", "TI"]}]}], "=", 
    RowBox[{
     StyleBox["E", "TI"], "\[ThinSpace]", 
     StyleBox["u", "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["u", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["u", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["R", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "=", 
     RowBox[{
      RowBox[{"\[CapitalPhi]", 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["R", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}], "=", "0"}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", 
      StyleBox["R", "TI"]], 
     RowBox[{
      SuperscriptBox[
       StyleBox["u", "TI"], "2"], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["r", "TI"]}]}], "=", 
    RowBox[{"1", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->838459264,ExpressionUUID->"1bd668a2-a10a-0e55-67c6-ff4c819d1929"],

Cell[TextData[{
 "Far from the particle ",
 Cell[BoxData[
  RowBox[{"\[CapitalPhi]", "\[TildeTilde]", "-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ce30e21-9be7-05e0-2ac7-317d0c6e224b"],
 ", so setting ",
 Cell[BoxData[
  RowBox[{"\[CapitalPhi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["R", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bef02d4-3c89-2908-5d34-a3570e54f482"],
 " raises the energy by about ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10596ff3-6237-5e90-4008-2aced6058f3f"],
 ". Without a box, the ground state found by Moroz, Penrose and Tod (1998) \
follows by shooting: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   StyleBox["u", "TI"], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "189a24ba-8585-e35d-374e-4f1fffd22024"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", "\[CapitalPhi]", "-", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138b6f7e-64bb-b66c-541e-5667ecad3878"],
 " obey ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["S", "TI"], "\[DoublePrime]"], "+", "2", 
   SuperscriptBox[
    StyleBox["S", "TI"], "\[Prime]"], "/", 
   StyleBox["r", "TI"], "=", "2", 
   StyleBox["W", "TI"], 
   StyleBox["S", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42bd84d5-e72d-80d4-12ce-87297ff90c76"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["W", "TI"], "\[DoublePrime]"], "+", "2", 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"], "/", 
   StyleBox["r", "TI"], "=", 
   SuperscriptBox[
    StyleBox["S", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "084c7d5a-c12f-be91-5539-ccbe576d1710"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17c2a412-cac1-7fe3-375b-ce862105dc30"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ba9fddd-d215-3353-543d-ae226e983cb1"],
 " is bisected until ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1623aaf9-85b5-2b2c-515b-55776419e004"],
 " decays without a node, outside the particle ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", 
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[Infinity]", 
   StyleBox[")",
    SpanMaxSize->1], "-", "\|01d4a9", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "744dcdf6-45d4-3a03-7ea2-ed5a9f565ed7"],
 " with ",
 Cell[BoxData[
  RowBox[{"\|01d4a9", "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   SuperscriptBox[
    StyleBox["S", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], 
   StyleBox["d", "TI"], 
   StyleBox["r", "TI"], "=", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55cb5f7e-b2d4-eb5c-5fc1-69490a041d24"],
 " (Gauss's law), so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[Infinity]", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["W", "TI"], "+", 
   StyleBox["r", "TI"], 
   SuperscriptBox[
    StyleBox["W", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "147e42bc-f80e-c2a1-2fd8-6e51c5308c03"],
 ", and rescaling to unit norm gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "-", 
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[Infinity]", 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SuperscriptBox["\|01d4a9", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1be3c356-99dd-06ce-069b-c89fa59da566"],
 "."
}], "Text",
 CellID->1302605519,ExpressionUUID->"566685d7-c443-6372-3404-c8a951ab9b70"],

Cell[TextData[{
 "Finite elements on a mesh of 1000 elements graded toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61eb8e15-769b-f40b-59b7-b0d6d358fd4b"],
 " solve Newton's equation for ",
 Cell[BoxData["\[CapitalPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "764d95a1-33e1-86e0-4a8b-a53a18515e3d"],
 " given ",
 Cell[BoxData[
  StyleBox["u", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7f0e4f-03b0-4ea8-255c-f1b1d009b18c"],
 ", then the lowest eigenpair given ",
 Cell[BoxData["\[CapitalPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20822b36-a172-eecd-3314-0ff9ddfc9fa2"],
 ", repeated from a normalized Gaussian until ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da46e74-a211-05a6-515f-8846023178fb"],
 " changes by less than ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "7"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3327bc26-c334-0e33-0445-67bc53b41b48"],
 ", in four boxes; the shooting energy is the reference:"
}], "Text",
 CellID->638973994,ExpressionUUID->"5b3a83ff-dbde-1641-20d2-7f47c3e8d828"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"selfPotential", "[", 
    RowBox[{"uR_", ",", " ", "mesh_"}], "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Laplacian", "[", 
         RowBox[{
          RowBox[{"snPhi", "[", "snR", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"snR", ",", " ", "\[Theta]", ",", " ", "\[CurlyPhi]"}], 
           "}"}], ",", " ", "\"\<Spherical\>\""}], "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"uR", "^", "2"}], "/", 
         RowBox[{"snR", "^", "2"}]}]}], ",", "\n", "    ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"snPhi", "[", "snR", "]"}], " ", "==", " ", "0"}], ",", " ", 
         RowBox[{"snR", " ", "==", " ", 
          RowBox[{
           RowBox[{"mesh", "[", "\"\<Bounds\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "]"}]}], "}"}], ",",
      " ", "snPhi", ",", " ", 
     RowBox[{
      RowBox[{"{", "snR", "}"}], " ", "\[Element]", " ", "mesh"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solitonGroundState", "[", 
    RowBox[{"\[Phi]_", ",", " ", "mesh_"}], "]"}], " ", ":=", " ", 
   RowBox[{"First", " ", "/@", " ", 
    RowBox[{"NDEigensystem", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"SchrodingerPDEComponent", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"snU", "[", "snR", "]"}], ",", " ", 
            RowBox[{"{", "snR", "}"}]}], "}"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<ReducedPlanckConstant\>\"", " ", "->", " ", "1"}], ",",
             " ", 
            RowBox[{"\"\<SchrodingerPotential\>\"", " ", "->", " ", 
             RowBox[{"\[Phi]", "[", "snR", "]"}]}]}], "|>"}]}], "]"}], ",", 
        "\n", "     ", 
        RowBox[{"DirichletCondition", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"snU", "[", "snR", "]"}], " ", "==", " ", "0"}], ",", " ", 
          "True"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"snU", "[", "snR", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", "snR", "}"}], " ", "\[Element]", " ", "mesh"}], ",", " ", 
      "1", ",", " ", 
      RowBox[{"Method", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Eigensystem\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Arnoldi\>\"", ",", " ", 
           RowBox[{"\"\<Shift\>\"", " ", "->", " ", 
            RowBox[{"-", "1"}]}]}], "}"}]}], "}"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solitonEnergy", "[", "boxR_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mesh", " ", "=", " ", 
       RowBox[{"ToGradedMesh", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", " ", 
             RowBox[{"{", "boxR", "}"}]}], "}"}], "]"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Alignment\>\"", " ", "->", " ", "\"\<Left\>\""}], ",",
             " ", 
            RowBox[{"\"\<ElementCount\>\"", " ", "->", " ", "1000"}]}], 
           "|>"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Re", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"NestWhile", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"solitonGroundState", "[", 
           RowBox[{
            RowBox[{"selfPotential", "[", 
             RowBox[{
              RowBox[{"Last", "[", "#", "]"}], ",", " ", "mesh"}], "]"}], ",",
             " ", "mesh"}], "]"}], " ", "&"}], ",", "\n", "      ", 
         RowBox[{"solitonGroundState", "[", 
          RowBox[{
           RowBox[{"selfPotential", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"snU0", " ", "=", " ", 
                 RowBox[{"snR", " ", 
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", 
                    RowBox[{"snR", "^", "2"}]}], "/", "9"}], "]"}]}]}], "}"}],
                ",", " ", 
               RowBox[{"snU0", "/", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{"Integrate", "[", 
                  RowBox[{
                   RowBox[{"snU0", "^", "2"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"snR", ",", " ", "0", ",", " ", "Infinity"}], 
                    "}"}]}], "]"}], "]"}]}]}], "]"}], ",", " ", "mesh"}], 
            "]"}], ",", " ", "mesh"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"First", "[", "#1", "]"}], " ", "-", " ", 
             RowBox[{"First", "[", "#2", "]"}]}], "]"}], " ", ">", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "7"}]}]}], " ", "&"}], ",", " ", "2", ",", " ", 
         "60"}], "]"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"boxEnergies", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", " ", 
       RowBox[{"solitonEnergy", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{"20", ",", " ", "40", ",", " ", "80", ",", " ", "160"}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"snEquations", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"snS", "''"}], "[", "snR", "]"}], " ", "+", " ", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"snS", "'"}], "[", "snR", "]"}], "/", "snR"}]}]}], " ", "==",
       " ", 
      RowBox[{"2", " ", 
       RowBox[{"snW", "[", "snR", "]"}], " ", 
       RowBox[{"snS", "[", "snR", "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"snW", "''"}], "[", "snR", "]"}], " ", "+", " ", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"snW", "'"}], "[", "snR", "]"}], "/", "snR"}]}]}], " ", "==",
       " ", 
      RowBox[{
       RowBox[{"snS", "[", "snR", "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{
      RowBox[{"snS", "[", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], "]"}], " ", "==", " ", "1"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"snS", "'"}], "[", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], "]"}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"snW", "[", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], "]"}], " ", "==", " ", "w"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"snW", "'"}], "[", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], "]"}], " ", "==", " ", "0"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"snNodeQ", "[", 
    RowBox[{"w_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Reap", "[", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"snEquations", "[", "w", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"snS", "[", "snR", "]"}], " ", "<", " ", "0"}], ",", 
             " ", 
             RowBox[{
              RowBox[{"Sow", "[", "True", "]"}], ";", 
              " ", "\"\<StopIntegration\>\""}]}], "]"}], ",", " ", 
           RowBox[{"WhenEvent", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"snS", "'"}], "[", "snR", "]"}], " ", ">", " ", "0"}], 
             ",", " ", 
             RowBox[{
              RowBox[{"Sow", "[", "False", "]"}], ";", 
              " ", "\"\<StopIntegration\>\""}]}], "]"}]}], "}"}]}], "]"}], ",",
        "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"snS", ",", " ", "snW"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"snR", ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}], ",", " ", "60"}], "}"}], ",", " ", 
       RowBox[{"WorkingPrecision", " ", "->", " ", "30"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"snW0", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"Nest", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"mid", " ", "=", " ", 
           RowBox[{"Mean", "[", "#", "]"}]}], "}"}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"snNodeQ", "[", "mid", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"mid", ",", " ", 
             RowBox[{"Last", "[", "#", "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], ",", " ", "mid"}], "}"}]}], 
          "]"}]}], "]"}], " ", "&"}], ",", " ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", " ", "0"}], "}"}], ",", " ", "30"}], "]"}],
       ",", " ", "45"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"snShooting", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sol", " ", "=", " ", 
       RowBox[{"First", "[", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"snEquations", "[", "snW0", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"snS", ",", " ", "snW"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"snR", ",", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}], ",", " ", "12"}], "}"}], ",", " ", 
          RowBox[{"WorkingPrecision", " ", "->", " ", "30"}]}], "]"}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"snW", "[", "12", "]"}], " ", "+", " ", 
          RowBox[{"12", " ", 
           RowBox[{
            RowBox[{"snW", "'"}], "[", "12", "]"}]}]}], ")"}]}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"144", " ", 
          RowBox[{
           RowBox[{"snW", "'"}], "[", "12", "]"}]}], ")"}], "^", "2"}]}], " ",
       "/.", " ", "sol"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"boxEnergies", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#1", ",", " ", 
         RowBox[{"#2", " ", "-", " ", 
          RowBox[{"1", "/", "#1"}]}]}], "}"}], " ", "&"}], " ", "@@@", " ", 
      "boxEnergies"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "snShooting"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"170", ",", " ", "snShooting"}], "}"}]}], "}"}]}], "}"}], ",",
    " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic", ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Dotted"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "12"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "12"}], "}"}], ",", " ", "None"}], 
     "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<E(R)\>\"", ",", " ", "\"\<E(R) \[Minus] 1/R\>\"", ",", 
      " ", "\"\<free space, by shooting\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "170"}], "}"}], ",", " ", "All"}], "}"}]}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", "\n", "  ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<box radius R (\>\"", ",", " ", 
         RowBox[{"Superscript", "[", 
          RowBox[{"\"\<\[HBar]\>\"", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\</G\>\"", ",", " ", 
         RowBox[{"Superscript", "[", 
          RowBox[{"\"\<m\>\"", ",", " ", "3"}], "]"}], ",", 
         " ", "\"\<)\>\""}], "}"}], "]"}], ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<energy E (\>\"", ",", " ", 
         RowBox[{"Superscript", "[", 
          RowBox[{"\"\<G\>\"", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"Superscript", "[", 
          RowBox[{"\"\<m\>\"", ",", " ", "5"}], "]"}], ",", " ", "\"\</\>\"", 
         ",", " ", 
         RowBox[{"Superscript", "[", 
          RowBox[{"\"\<\[HBar]\>\"", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[144]:= ",
 CellID->940436512,ExpressionUUID->"0e78b2fe-db03-5151-0d74-dab1c8dc0521"],

Cell[TextData[{
 "A bound state exists in every box, and its energy falls toward the \
free-space value as the box grows. Subtracting ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b04cbed-6af9-4fd8-45db-8b5926307acd"],
 " puts every box on the shooting energy (dotted): the box shifts the energy \
by the cut-off ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1698b664-d392-30f9-44b9-d768a5cfe8db"],
 " tail, and what remains is below the resolution of the plot."
}], "Text",
 CellID->842788521,ExpressionUUID->"2db32979-24c3-bff9-47f1-a706de3a2076"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1129092684,ExpressionUUID->"34a19f11-18ff-7f24-2f5f-e3ea4fbb4d84"],

Cell["Stored numbers, declared bases and composition", "Subsection",
 CellID->665091945,ExpressionUUID->"622e2690-5946-a48a-60ec-1e6d0d23b285"],

Cell[TextData[{
 "An operator can be specified by the numbers it takes in a chosen basis: \
store the numbers ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05b94861-dcf5-8400-18fd-361455580864"],
 " together with that basis as the operator ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24166708-88fe-3e15-1f9f-f8a8046eabce"],
 ". What does applying ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "085bd23e-e9e9-0c77-3d8d-633fea5be42d"],
 " after ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0092e316-f071-422a-0ed2-76df8491fbe7"],
 " give?"
}], "Text",
 CellID->713968488,ExpressionUUID->"62ccc399-39db-df71-77c4-e96c07c6d309"],

Cell[TextData[{
 "If the columns of ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "355d622a-6115-70ac-3a8d-6aee5c6a27f4"],
 " are the declared basis vectors, the stored matrix ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ba67af9-ce84-8885-1dba-459a688ff185"],
 " represents the map ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   StyleBox["F", "TI"], "\[ThinSpace]", 
   StyleBox["C", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["F", "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a0f724f-4084-301e-45c7-fa99df4fa44f"],
 " in the computational basis; ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d475b5d-05e1-aadb-7739-93f5b34a4838"],
 " only needs to be invertible. For an orthonormal basis ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "105c5344-3889-d2d2-4af9-9145623cac64"],
 " is the observable with outcomes ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "562f3597-512d-2717-4b18-5df5e39bd43b"],
 " in that basis; for a basis that is not orthonormal, such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], ",", 
    TemplateBox[{"+"},
     "Ket"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a4fe46-a876-305e-096a-234675753b26"],
 ", ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73c7c94f-49f9-ea88-39af-2dccceca1652"],
 " is not Hermitian, a linear map rather than an observable. Composition \
contracts the shared wire after both operators are written in one basis, so \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "\[SmallCircle]", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "463f0a56-4e67-0b65-24d9-78dbd0fdb0a6"],
 " is the product ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "A"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "613aecbc-5d70-f44e-096d-cfc51161d205"],
 ". Contracting the stored numbers as they sit would give ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "C"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50cedbd3-3746-abad-2e9f-49b5d7eb8cb4"],
 " instead."
}], "Text",
 CellID->819990049,ExpressionUUID->"57e1c1f3-eefe-6557-0419-ab5d6f5d7180"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c3e4e6-7da8-606c-1f32-774d923eea2f"],
 " in four declared bases, the table lists the map ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b668a4c-3f9b-7844-394c-c6b38c075528"],
 " it represents, the composite ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "\[SmallCircle]", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3555fa7c-2302-37e7-4955-adfcd0b9f766"],
 ", and whether that composite equals ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "A"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5fa0c6-4fbd-ded0-5e8b-afa2a460eb14"],
 ", after ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6def8958-c272-d266-7934-2350e4b25ab9"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "C"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63e5ce7d-8fc5-e7bc-6b5c-aede759f07b3"],
 ":"
}], "Text",
 CellID->1972350083,ExpressionUUID->"4834c241-d265-3b35-47be-6bf47b6b3fc4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"semNames", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<{|0\:27e9, |1\:27e9}\>\"", ",", 
     " ", "\"\<{|+\:27e9, |\[Minus]\:27e9}\>\"", ",", 
     " ", "\"\<{|+i\:27e9, |\[Minus]i\:27e9}\>\"", ",", 
     " ", "\"\<{|0\:27e9, |+\:27e9}\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"semBases", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Computational\>\"", ",", " ", "\"\<PauliX\>\"", ",", 
     " ", "\"\<PauliY\>\"", ",", " ", 
     RowBox[{"QuditBasis", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"semC", " ", "=", " ", 
   RowBox[{"PauliMatrix", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"semRow", "[", "b_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"semC", ",", " ", "b"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"am", " ", "=", " ", 
          RowBox[{"Simplify", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"r", "[", "\"\<MatrixRepresentation\>\"", "]"}], "]"}], 
           "]"}]}], ",", " ", 
         RowBox[{"zam", " ", "=", " ", 
          RowBox[{"Simplify", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "[", "r", 
              "]"}], "[", "\"\<MatrixRepresentation\>\"", "]"}], "]"}], 
           "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"MatrixForm", "[", "am", "]"}], "]"}], ",", " ", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"MatrixForm", "[", "zam", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"zam", " ", "-", " ", 
            RowBox[{"semC", " ", ".", " ", "am"}]}], "]"}], " ", "===", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Style", "[", 
  RowBox[{
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"semRow", "[", "#1", "]"}], ",", " ", "#2"}], "]"}], 
            " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"semBases", ",", " ", "semNames"}], "}"}]}], "]"}], ",", 
         "\n", "    ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<declared basis\>\"", ",", " ", "\"\<represented A\>\"",
            ",", " ", "\"\<Z after R in QF\>\"", ",", " ", "\"\<= Z A\>\""}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1"}], "}"}]}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<C = \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"MatrixForm", "[", "semC", "]"}], "]"}], ",", 
        " ", "\"\<,   Z C = \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"MatrixForm", "[", 
          RowBox[{"semC", " ", ".", " ", "semC"}], "]"}], "]"}], ",", 
        " ", "\"\< in every basis\>\""}], "}"}], "]"}], ",", " ", "Top"}], 
    "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[145]:= ",
 CellID->420884732,ExpressionUUID->"4330a366-0299-9714-1674-2dfd892f9235"],

Cell[TextData[{
 "The same numbers ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "017249ca-c5c4-7226-63c2-1c91b89d02f4"],
 " represent ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c9d60c2-ce23-3935-79d2-b8cdafe80d57"],
 ", ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a9df8ea-2f48-767d-4d88-23c493de5f80"],
 ", ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "044d7b68-2eff-94ca-1b6e-73ea8289aef6"],
 ", or, in the non-orthogonal basis, a map that is not Hermitian, and the \
composite is ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f911d1-2ec0-8cb3-1083-09d8d5517103"],
 " times that map in every row. Multiplying the stored numbers gives the \
identity whatever the basis, which is the right answer only when the declared \
basis is the computational one."
}], "Text",
 CellID->1219929494,ExpressionUUID->"4730bfc7-3de2-5244-4dc3-40cda49aaa97"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1964327872,ExpressionUUID->"4f62596b-a49a-3160-202b-118b49d007e5"],

Cell["Adding two momenta on a noncommuting spacetime", "Subsection",
 CellID->1692280694,ExpressionUUID->"422185a7-18d4-2f16-085e-11e5786fb888"],

Cell[TextData[{
 "A plane wave ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["\[Mu]", "TI"]], 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Mu]", "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b83ca41-c0ca-aa61-6218-3cded8d87b05"],
 " carries momentum ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["\[Mu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604d92dc-3967-e912-4c9f-e90a32b2b8f1"],
 ", and when the coordinates ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], 
   StyleBox["\[Mu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ce511a-92cb-5981-0711-d60df9cb3f85"],
 " do not commute, the product of two plane waves defines a deformed sum ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10221c4f-7bb6-f543-0e07-0ea559e623e4"],
 ". Snyder's spacetime has a fundamental length ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d2fb82-04bc-6147-36c0-4af118f8cc37"],
 ", and ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52659396-7ca7-d71a-63e0-ff605626685e"],
 "-Minkowski spacetime has a mass scale ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a276bd-8fb7-c6cd-0cd8-1ee575b28216"],
 ". Does the deformed sum depend on which momentum comes first?"
}], "Text",
 CellID->1033980191,ExpressionUUID->"02676312-3a51-6a34-750d-4992f616f320"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60033ce9-cb9b-23ff-0492-5d845d5bffd1"],
 " and Lorentz generators ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["M", "TI"], 
   StyleBox[
    RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a933e66-2c6d-107f-4feb-2edf420d8f7c"],
 ", the two algebras are"
}], "Text",
 CellID->92419128,ExpressionUUID->"63050523-1fb3-0e15-53a7-0114f2b83777"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox[
     RowBox[{"Snyder", ":"}],
     FontSlant->"Plain"], " ", " ", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["\[Mu]", "TI"]], ",", 
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["\[Nu]", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], "=", 
    StyleBox["i", "TI"], 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox[
         RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], ",", 
       SuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["\[Rho]", "TI"]]}], 
      StyleBox["]",
       SpanMaxSize->1]}], "=", 
     RowBox[{
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["\[Eta]", "TI"], 
         StyleBox[
          RowBox[{"\[Nu]", "\[Rho]"}], "TI"]], 
        SuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["\[Mu]", "TI"]], "-", 
        SuperscriptBox[
         StyleBox["\[Eta]", "TI"], 
         StyleBox[
          RowBox[{"\[Mu]", "\[Rho]"}], "TI"]], 
        SuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["\[Nu]", "TI"]]}], ")"}]}]}], ";", 
    "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
    RowBox[{
     RowBox[{
      StyleBox["\[Kappa]", "TI"], 
      RowBox[{
       StyleBox[
        RowBox[{"-", 
         RowBox[{"Minkowski", ":"}]}],
        FontSlant->"Plain"], " ", " ", 
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        SuperscriptBox[
         StyleBox["x", "TI"], "0"], ",", 
        SuperscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["j", "TI"]]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "=", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], 
       StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["k", "TI"]]}], 
     StyleBox["]",
      SpanMaxSize->1]}], "=", "0"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->442064693,ExpressionUUID->"416f1dc7-aaf0-2a50-14f1-b3af44028fbd"],

Cell[TextData[{
 "with the Lorentz algebra for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], ",", 
    StyleBox["M", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3de548b4-9e35-2f3b-1527-f61ad335a896"],
 ". Writing ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["Y", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["Z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1975181e-117a-7b84-1d2a-f920b72d9d9e"],
 ", the Baker-Campbell-Hausdorff series to fourth order is"
}], "Text",
 CellID->1085479623,ExpressionUUID->"220299e9-9104-d45c-0acc-51ca0bf72514"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["Z", "TI"], "=", 
    StyleBox["X", "TI"], "+", 
    StyleBox["Y", "TI"], "+", 
    FractionBox["1", "2"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     StyleBox["Y", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    FractionBox["1", "12"], "(", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      RowBox[{
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["X", "TI"], ",", 
        StyleBox["Y", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], 
     StyleBox["]",
      SpanMaxSize->1], "+", 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["Y", "TI"], ",", 
      RowBox[{
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["Y", "TI"], ",", 
        StyleBox["X", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], 
     StyleBox["]",
      SpanMaxSize->1]}], ")", "-", 
    FractionBox["1", "24"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["Y", "TI"], ",", 
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       RowBox[{
        StyleBox["[",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["X", "TI"], ",", 
         StyleBox["Y", "TI"]}], 
        StyleBox["]",
         SpanMaxSize->1]}]}], 
      StyleBox["]",
       SpanMaxSize->1]}]}], 
    StyleBox["]",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["X", "TI"], "=", 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["\[Mu]", "TI"]], 
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["\[Mu]", "TI"]]}]}], ",", " ", 
   RowBox[{
    StyleBox["Y", "TI"], "=", 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["\[Beta]", "TI"], 
      StyleBox["\[Mu]", "TI"]], 
     RowBox[{
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["\[Mu]", "TI"]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1957600491,ExpressionUUID->"2412e20b-5be9-c30c-0902-273a60bb9ffa"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40005657-0ab0-5083-22c4-675e49c24b2e"],
 "-Minkowski spacetime ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4af5f0c5-58a9-4376-52e3-f600e6451a3b"],
 " is a combination of the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], 
   StyleBox["\[Mu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e429b71-67ee-4f54-2558-6fc48ea656e2"],
 " alone, and ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
     StyleBox["\[Beta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[Mu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "281413d7-018d-24f2-7627-659ff4b53c99"],
 " is the coefficient of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Mu]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e50b9ef-2272-f715-6c44-f361500f46da"],
 " in ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "372d46fe-c40c-d377-6000-e4d650f16415"],
 ", the momentum of the symmetrically ordered plane wave. The matrices ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "0"], "=", 
   FractionBox[
    StyleBox["i", "TI"], 
    StyleBox["\[Kappa]", "TI"]], 
   SubscriptBox[
    StyleBox["E", "TI"], "11"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348256a5-eb37-5058-36fb-f94b3d504505"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], "12"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4eadbc58-2bf7-142a-7aff-1c7cbf40ce97"],
 " obey the relations, so ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["Y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f94d91f-88d4-fe59-2116-ce6a883869e9"],
 " can be multiplied and its logarithm taken in closed form. Writing the same \
plane wave with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec614be-8406-ec92-722a-33774ce40016"],
 " to the right, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["j", "TI"]], 
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["j", "TI"]]}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["k", "TI"], "0"], 
     SuperscriptBox[
      StyleBox["x", "TI"], "0"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf707c9-3221-5757-280b-38a287024ae8"],
 ", relabels the momentum as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], "0"], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f2ccc91-786c-287a-4913-2fb58dafb3ab"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["j", "TI"]], "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["j", "TI"]], "\[ThinSpace]", 
   StyleBox["\[Kappa]", "TI"], "(", 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], "0"], "/", 
      StyleBox["\[Kappa]", "TI"]}]]}], ")", "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aae9932-f662-1c97-3ad7-96eb3307662b"],
 ", and turns the sum into the bicrossproduct law ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["k", "TI"], "\[CirclePlus]", 
    StyleBox["q", "TI"]}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["k", "TI"], "0"], "+", 
      SubscriptBox[
       StyleBox["q", "TI"], "0"]}], ",", " ", 
     RowBox[{
      SubscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["j", "TI"]], "+", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         SubscriptBox[
          StyleBox["k", "TI"], "0"], "/", 
         StyleBox["\[Kappa]", "TI"]}]], 
       SubscriptBox[
        StyleBox["q", "TI"], 
        StyleBox["j", "TI"]]}]}]}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71b4f6fa-7678-f15c-52b6-5899216530f4"],
 ". Back in the symmetric labels the exact sum is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
      StyleBox["\[Beta]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["j", "TI"]], "=", "(", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["j", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Beta]", "TI"], "0"], "/", 
      StyleBox["\[Kappa]", "TI"]}]], "\[CurlyPhi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "0"], "/", 
     StyleBox["\[Kappa]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    SubscriptBox[
     StyleBox["\[Beta]", "TI"], 
     StyleBox["j", "TI"]], "\[CurlyPhi]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Beta]", "TI"], "0"], "/", 
     StyleBox["\[Kappa]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")", "/", "\[CurlyPhi]", "(", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], "0"], "+", 
     SubscriptBox[
      StyleBox["\[Beta]", "TI"], "0"]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", 
    StyleBox["\[Kappa]", "TI"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb444c3-1212-aa75-09ad-a7a40f22c5d1"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["x", "TI"]], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "028a4bbf-da6b-1221-7cb0-b77e3df03d32"],
 ": each spatial momentum is weighted by a factor that depends only on the \
energies."
}], "Text",
 CellID->1888888079,ExpressionUUID->"08785264-e366-aa18-71cc-4e4a055880df"],

Cell[TextData[{
 "In Snyder's algebra ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72d58e46-a24e-93f2-2e4f-9f2bd1555c09"],
 " also carries Lorentz generators, starting with ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], ",", 
    StyleBox["Y", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Beta]", "TI"], 
    StyleBox["\[Nu]", "TI"]], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c6e5b04-64a0-149c-5058-0c90ef9c30e1"],
 ", and they cannot be dropped: ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["M", "TI"], 
   StyleBox[
    RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "602200ba-c88c-2e76-1e46-1c99199d2ba7"],
 " does not commute with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], 
   StyleBox["\[Rho]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32a85d54-c0f9-efb3-444a-4ce3b63fc64f"],
 ", so ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]], 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Mu]", "TI"]], "+", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], 
    SuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f92e870-49a6-9421-7a92-c95de6ad51c1"],
 " is not a plane wave of momentum ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dad1693-359b-bbdc-3d77-5c279da6eba1"],
 ". Instead the product is split as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["Y", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
        StyleBox["\[Beta]", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["\[Mu]", "TI"]], 
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["\[Mu]", "TI"]]}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox[
       RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], 
     SuperscriptBox[
      StyleBox["M", "TI"], 
      StyleBox[
       RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42f1fe3f-96e9-1042-489d-51064c4a1b20"],
 "; the Lorentz factor leaves the Lorentz-invariant vacuum unchanged, so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c3ba753-797f-4efd-5fd6-f06e342a156e"],
 " is the momentum of the product. Comparing the two Baker-Campbell-Hausdorff \
series, ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
     StyleBox["\[Beta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[Mu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5442a649-61db-7673-092f-5e1f0e21de48"],
 " is the coefficient of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Mu]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "595a674b-44e8-7cad-5788-2b04310996e0"],
 " in"
}], "Text",
 CellID->394303451,ExpressionUUID->"09bfa677-a1a9-8240-506d-2a27e4d4a2cb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["X", "TI"], "+", 
    StyleBox["Y", "TI"], "-", 
    FractionBox["1", "6"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["X", "TI"], ",", 
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["X", "TI"], ",", 
       StyleBox["Y", "TI"]}], 
      StyleBox["]",
       SpanMaxSize->1]}]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    FractionBox["1", "3"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["Y", "TI"], ",", 
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["Y", "TI"], ",", 
       StyleBox["X", "TI"]}], 
      StyleBox["]",
       SpanMaxSize->1]}]}], 
    StyleBox["]",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1860632923,ExpressionUUID->"4cc60700-6207-0671-21d9-77edaf5edab9"],

Cell[TextData[{
 "and since Snyder's relations are unchanged under ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Rule]", "-", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4257f1f3-be7b-c9a9-20e6-2a3b1c1bb2a1"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "\[Rule]", 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26bfe886-a6ac-1631-75e8-d01dea3c0ce3"],
 ", the next correction is fifth order. The ",
 Cell[BoxData[
  RowBox[{"5", "\[Times]", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09351e89-6887-a3f5-07f3-00596b5003c4"],
 " matrices of the de Sitter algebra, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   StyleBox["a", "TI"], 
   SuperscriptBox[
    StyleBox["L", "TI"], 
    RowBox[{
     StyleBox["\[Mu]", "TI"], "4"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0de67a6a-116b-7623-49c6-b843c23d9433"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["L", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b28c15d-b2a8-6826-573a-6039ec970a96"],
 " with metric ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "145e784f-46c2-d5ee-064c-a8556e3dd7f5"],
 ", obey Snyder's relations and give the exact sum: ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["X", "TI"]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["Y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "695f007e-7def-8c1a-330b-9e044d73150c"],
 " carries the point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ed881be-43fb-5d34-0f5e-8455d445e8f1"],
 " of de Sitter space to a new point, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d888042-25a5-302e-3be7-e7346f8cbc74"],
 " is the ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2db6538b-0c5a-0745-4171-ecba1a01bdb2"],
 " for which ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]], 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Mu]", "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420544a7-9bb8-31b7-646a-e94441e0c1ad"],
 " carries it to the same place. Each spatial ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b0f58a1-f08e-2b3f-1125-9c028b0716e6"],
 " rotates that point in a compact plane, so these coordinates label points \
uniquely only while ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   SqrtBox[
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], "\[CenterDot]", 
     StyleBox["\[Gamma]", "TI"]}]], "<", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18c7e07e-df70-ad4e-466b-6ed7d8da361d"],
 "; beyond that, different ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d701a5-bf75-9b2b-5387-c37b6e1c2813"],
 " carry ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640b4fbd-50b6-c5ae-058e-7bd6f6ba9cc1"],
 " to the same point. The momenta below stay well inside that range."
}], "Text",
 CellID->476729670,ExpressionUUID->"08fa0a38-2591-6df4-3441-73e8b8bed907"],

Cell[TextData[{
 "Each set of relations reduces the series for general ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a34b9b2-c319-b78e-110e-e6cb1cd34f09"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f67f5f0-d45b-83c3-0b10-e40e3bdb38d6"],
 "; the figure shows two momenta in the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "0"], ",", 
    SubscriptBox[
     StyleBox["p", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0623c46e-bf5d-031b-1646-6eb001bed108"],
 " plane, in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "577201a7-1706-b620-173f-c3e72313da01"],
 " for Snyder and of ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07d90fe8-1169-ebfd-5369-a99e046a63c5"],
 " for ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1706b767-81b5-422a-296f-a352c31b6832"],
 "-Minkowski, for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["s", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    FractionBox["1", "2"], ",", 
    RowBox[{"0", ",", "0"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01487b2c-2f23-606b-1380-54c063492ce7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", 
   StyleBox["s", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["3", "5"], ",", 
    RowBox[{"-", 
     FractionBox["4", "5"]}], ",", 
    RowBox[{"0", ",", "0"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f46a1fc-4f6d-8c64-2935-ef8f840b7c31"],
 " at three scales ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f52fefb-cf26-57db-16d1-8184b297e393"],
 ", with the exact sums from the ",
 Cell[BoxData[
  RowBox[{"5", "\[Times]", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "784653de-63b6-672d-5ce3-960424f7bcf0"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26e8d958-9705-d033-27db-4742343e24bd"],
 " matrices:"
}], "Text",
 CellID->1610953138,ExpressionUUID->"346ad2fe-eb73-f792-00ff-a636e9e434bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"composeEta", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", 
      RowBox[{"-", "1"}], ",", " ", 
      RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";", " ", 
  RowBox[{"composeG", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", 
      RowBox[{"-", "1"}], ",", " ", 
      RowBox[{"-", "1"}], ",", " ", 
      RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"composeL", "[", 
    RowBox[{"A_", ",", " ", "A_"}], "]"}], " ", "=", " ", "0"}], ";", " ", 
  RowBox[{
   RowBox[{"composeL", "[", 
    RowBox[{"A_", ",", " ", "B_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"A", " ", "<", " ", "B"}], ",", " ", 
     RowBox[{"composeJ", "[", 
      RowBox[{"A", ",", " ", "B"}], "]"}], ",", " ", 
     RowBox[{"-", 
      RowBox[{"composeJ", "[", 
       RowBox[{"B", ",", " ", "A"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"composePairs", " ", "=", " ", 
   RowBox[{"Subsets", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"composeAl", ",", " ", "composeBe"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"compose\[Alpha]", " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{"compose\[Beta]", " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "3"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"composeRelations", "[", "\"\<Snyder\>\"", "]"}], " ", "=", " ", 
   RowBox[{"Replace", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{"composePairs", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A_", ",", " ", "B_"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"C_", ",", " ", "D_"}], "}"}]}], "}"}], " ", ":>", " ", 
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"composeJ", "[", 
          RowBox[{"C", ",", " ", "D"}], "]"}], ",", " ", 
         RowBox[{"composeJ", "[", 
          RowBox[{"A", ",", " ", "B"}], "]"}]}], "]"}], " ", "+", "\n", 
       "     ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"composeG", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"B", " ", "+", " ", "1"}], ",", " ", 
              RowBox[{"C", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
           RowBox[{"composeL", "[", 
            RowBox[{"A", ",", " ", "D"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"composeG", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"B", " ", "+", " ", "1"}], ",", " ", 
              RowBox[{"D", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
           RowBox[{"composeL", "[", 
            RowBox[{"A", ",", " ", "C"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"composeG", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"A", " ", "+", " ", "1"}], ",", " ", 
              RowBox[{"C", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
           RowBox[{"composeL", "[", 
            RowBox[{"B", ",", " ", "D"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"composeG", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"A", " ", "+", " ", "1"}], ",", " ", 
              RowBox[{"D", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
           RowBox[{"composeL", "[", 
            RowBox[{"B", ",", " ", "C"}], "]"}]}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"composeRelations", "[", "\"\<\[Kappa]-Minkowski\>\"", "]"}], " ", 
   "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Commutator", "[", 
         RowBox[{
          RowBox[{"composeT", "[", "#", "]"}], ",", " ", 
          RowBox[{"composeT", "[", "0", "]"}]}], "]"}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{
          RowBox[{"composeT", "[", "#", "]"}], "/", "composeK"}]}]}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"composeT", "[", "#2", "]"}], ",", " ", 
         RowBox[{"composeT", "[", "#1", "]"}]}], "]"}], " ", "&"}], " ", "@@@",
       " ", 
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"composeAlgebra", "[", "\"\<Snyder\>\"", "]"}], " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"composeJ", " ", "@@@", " ", "composePairs"}], "}"}]}], ",", 
      " ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "composeA", "}"}], ",", " ", "composeAl", ",", " ", 
         "composeBe"}], "]"}]}], ",", " ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"composeRelations", "[", "\"\<Snyder\>\"", "]"}]}]}], "|>"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"composeAlgebra", "[", "\"\<\[Kappa]-Minkowski\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"composeT", " ", "/@", " ", 
         RowBox[{"Range", "[", 
