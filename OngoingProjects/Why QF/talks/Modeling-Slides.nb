 CellID->1011996026,ExpressionUUID->"1af61027-aacc-a6a0-7374-6c646a80b508"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1da76e0f-bc49-9823-4de7-8119f0326b05"],
 " the channel output and ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "792f45b7-5237-5084-1d2a-c6c8d0c566de"],
 " the von Neumann entropy. The channel commutes with phase rotations about \
",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b147190-a537-5f4e-0f4e-cc9c020c8346"],
 ", and for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "\[LessEqual]", "1", "/", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fbea28d-5385-983a-2d20-d85e36e679f3"],
 " it is degradable, so ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0569305f-0d0b-2377-3f0b-5e91546f717b"],
 " is concave in the input and a diagonal input is optimal: maximizing over \
",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc05e30-428e-cf29-7ded-0df08437c01b"],
 " maximizes over every input."
}], "Text",
 CellID->1493649449,ExpressionUUID->"0fb5a51d-6544-2d43-37a3-9dabfb1dc3a8"],

Cell[TextData[{
 Cell[BoxData[
