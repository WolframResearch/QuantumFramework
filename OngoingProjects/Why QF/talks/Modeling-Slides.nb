Cell["Entanglement sudden death", "Subsection",
 CellID->1245419701,ExpressionUUID->"766382b8-c8c0-c739-4efc-ab62c7207699"],

Cell[TextData[{
 "Two qubits A and B start in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    StyleBox["\[Theta]", "TI"], 
    TemplateBox[{
      RowBox[{
        StyleBox["g", "TI"], 
        StyleBox["g", "TI"]}]},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], 
    StyleBox["\[Theta]", "TI"], 
    TemplateBox[{
      RowBox[{
        StyleBox["e", "TI"], 
        StyleBox["e", "TI"]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f033ec3-9a32-909c-7083-40bd441fab38"],
 ", and each decays on its own, A at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["A", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c2e91a3-1004-1d59-32b8-0e95b9cbf3c2"],
 " and B at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "413685d9-cca4-06f3-4f3d-d07f8d6f13d0"],
 ". Each qubit's excitation decays exponentially; does the entanglement also \
fade only gradually?"
}], "Text",
 CellID->365704094,ExpressionUUID->"3c4bc79e-9a49-fd7c-615d-0438c5ff52c7"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7172b8f9-1645-2a83-65bb-3e5a2ff869bc"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c04ef03-8d8d-7f96-54d7-8e253b60fb66"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a820d1-5e34-b13b-3a5d-e506777c57f2"],
 " and qubit frequencies ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["A", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32eb19c8-7f54-8555-1b3c-d2d57a5045e1"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7237ffa2-e5c6-34f2-5768-e88253bbb929"],
 ", the Lindblad equation is"
}], "Text",
 CellID->1750990038,ExpressionUUID->"68f1c271-bb45-23e6-4bc4-30cadad953d2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["A", "TI"]], "2"], 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"], 
       StyleBox["A", "TI"]], "+", 
      FractionBox[
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["B", "TI"]], "2"], 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"], 
       StyleBox["B", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["A", "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-", 
     StyleBox["A", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["B", "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-", 
     StyleBox["B", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->84727264,ExpressionUUID->"609a486f-563c-a7d4-0bbb-6ff914b5d74b"],

Cell["\<\
and in the frame rotating with each qubit the Hamiltonian drops out while the \
two dissipators stay as they are.\
\>", "Text",
 CellID->728999986,ExpressionUUID->"384bc1c8-7cd3-e104-73ac-be13856d296d"],

Cell[TextData[{
 "The concurrence of the evolving state, computed for general ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d09eda0-2225-eefc-0523-4e6e47ecc51e"],
