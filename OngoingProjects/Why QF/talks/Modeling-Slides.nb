 CellID->626084867,ExpressionUUID->"4749fe7f-a260-117d-2196-d5b88299cc67"],

Cell[TextData[{
 "A qubit with splitting ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5307d822-fe4a-a175-73b7-c46bd4a0c313"],
 " is driven by a field of strength ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a1ab285-24f6-03c9-4a55-16278d688d0e"],
 " rotating at frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aaa17f2-5a11-69ce-1d34-e8cf248f8a00"],
 ", detuned by ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"], "-", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7844e725-923c-3e2b-33d4-d7b484d4f237"],
 ". How much population does the drive move out of ",
 Cell[BoxData[
