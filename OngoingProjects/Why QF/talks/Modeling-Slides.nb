                RowBox[{
                 RowBox[{"varX", "[", "\[CurlyPhi]", "]"}], " ", "+", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Alpha]", "^", "2"}], " ", "+", " ", 
                    RowBox[{
                    RowBox[{"Sinh", "[", "r", "]"}], "^", "2"}]}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"4", " ", 
                    RowBox[{"\[Beta]", "^", "2"}]}], ")"}]}]}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"\[Beta]", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0.5", ",", " ", "1", ",", " ", "3"}], "}"}]}], 
                 "}"}]}], "]"}], ",", " ", 
              RowBox[{"varX", "[", "\[CurlyPhi]", "]"}]}], "]"}], "]"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",",
            " ", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
             "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", 
              " ", "Dashed"}], "}"}]}], ",", "\n", "      ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<|\[Beta]| = 0.5\>\"", ",", 
              " ", "\"\<|\[Beta]| = 1\>\"", ",", " ", "\"\<|\[Beta]| = 3\>\"",
               ",", " ", "\"\<Var X(\[CurlyPhi])\>\""}], "}"}]}]}], "]"}], ",",
          "\n", "     ", 
         RowBox[{"ListLogPlot", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"\[CurlyPhi]s", ",", " ", 
                RowBox[{
                 RowBox[{"hdNoise", "[", 
                  RowBox[{"sig", ",", " ", "\[Beta]"}], "]"}], " ", "/@", " ",
                  "\[CurlyPhi]s"}]}], "}"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\[Beta]", ",", " ", 
               RowBox[{"{", 
                RowBox[{"0.5", ",", " ", "1.", ",", " ", "3."}], "}"}]}], 
              "}"}]}], "]"}], ",", " ", 
           RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}], ",",
          "\n", "    ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "Pi"}], "}"}], ",", " ", 
            RowBox[{"Log", "[", 
             RowBox[{"{", 
              RowBox[{"0.04", ",", " ", "6"}], "}"}], "]"}]}], "}"}]}], ",", 
         " ", 
         RowBox[{"GridLines", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", 
             RowBox[{"Log", "[", 
              RowBox[{"1", "/", "4"}], "]"}], "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "    ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameTicks", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Log", "[", "#", "]"}], ",", " ", "#"}], "}"}], " ",
                 "&"}], " ", "/@", " ", 
               RowBox[{"{", 
                RowBox[{
                "0.05", ",", " ", "0.1", ",", " ", "0.25", ",", " ", "0.5", ",",
                  " ", "1", ",", " ", "2", ",", " ", "5"}], "}"}]}], ",", " ",
               "None"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", " ", "Pi", ",", " ", 
                RowBox[{"Pi", "/", "4"}]}], "]"}], ",", " ", "None"}], 
             "}"}]}], "}"}]}], ",", "\n", "    ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[CurlyPhi]\>\"", ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<Var(\>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<N\>\"", ",", " ", "\"\<c\>\""}], "]"}], ",", 
               " ", "\"\< - \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<N\>\"", ",", " ", "\"\<d\>\""}], "]"}], ",", 
               " ", "\"\<) / 4|\[Beta]|\.b2\>\""}], "}"}], "]"}]}], "}"}]}], ",",
          "\n", "    ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Alpha] = \>\"", ",", " ", "\[Alpha]", ",", 
             " ", "\"\<,   r = \>\"", ",", " ", "r"}], "}"}], "]"}]}], ",", 
         " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hdPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"hdPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.4", ",", " ", "0.8"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"Map", "[", 
       RowBox[{"First", ",", " ", "hdPanels", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"hdPanels", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<normal-ordered  \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<(\>\"", ",", " ", 
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<a\>\"", ",", " ", "\"\<\[Dagger]\>\""}], "]"}], ",",
              " ", "\"\<b + \>\"", ",", " ", 
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<b\>\"", ",", " ", "\"\<\[Dagger]\>\""}], "]"}], ",",
              " ", "\"\<a)\>\""}], "}"}], "]"}], ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<  =  \>\"", ",", "\n", "     ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"BosonicNormalOrder", "[", 
             RowBox[{
              RowBox[{"hdCount", " ", "**", " ", "hdCount"}], ",", " ", 
              "hdVars"}], "]"}], " ", "/.", " ", 
            RowBox[{
             RowBox[{"GeneralizedPower", "[", 
              RowBox[{
              "NonCommutativeMultiply", ",", " ", "o_", ",", " ", "k_"}], 
              "]"}], " ", ":>", " ", 
             RowBox[{"Superscript", "[", 
              RowBox[{"o", ",", " ", "k"}], "]"}]}]}], " ", "/.", " ", 
           RowBox[{"NonCommutativeMultiply", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", "##", "}"}], "]"}], " ", "&"}], ")"}]}]}], " ", "/.",
           "\n", "       ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"SuperDagger", "[", "\[FormalA]", "]"}], " ", "->", " ", 
             
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<a\>\"", ",", " ", "\"\<\[Dagger]\>\""}], "]"}]}], ",",
             " ", 
            RowBox[{
             RowBox[{"SuperDagger", "[", "\[FormalB]", "]"}], " ", "->", " ", 
             
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<b\>\"", ",", " ", "\"\<\[Dagger]\>\""}], "]"}]}], ",",
             " ", 
            RowBox[{"\[FormalA]", " ", "->", " ", "\"\<a\>\""}], ",", " ", 
            RowBox[{"\[FormalB]", " ", "->", " ", "\"\<b\>\""}]}], "}"}]}], 
         "]"}]}], "}"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[109]:= ",
 CellID->430394997,ExpressionUUID->"6435164a-0a7c-d748-4948-02bdd4afebfe"],

Cell[TextData[{
 "The markers lie on the closed form and above the dashed curve, so a weak \
oscillator buries the quadrature noise under the signal's own photons, the \
more so for the brighter, more displaced signal. The strongest oscillator \
dips below the coherent state's flat ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d0e9153-5aff-6e5c-0d27-e56a83fd22a0"],
 " (grid line) near ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63cd474b-08a8-96ae-4007-a7935be23b15"],
 " and ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06668609-6e2e-3302-3167-a909c20f3314"],
 " in every squeezed panel, and ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[Beta]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2cae8e-67fe-76b1-0471-9ccc3a3a8685"],
 " does so only for the dimmer, less squeezed signal. Even then the markers \
stay above ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], 
   OverscriptBox[
    StyleBox["X", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyPhi]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122f4faa-8912-8311-0000-f4e600313824"],
 ", because the signal's photons must be small next to ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["\[Beta]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bd2a822-3c25-6445-11d8-c99595d9f288"],
 " times the squeezed variance, not merely next to ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["\[Beta]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3906b977-e9b3-8154-29b9-1164d30b8e48"],
 "."
}], "Text",
 CellID->180487943,ExpressionUUID->"06b69e23-35a3-2ecd-7b19-6fd3300a3429"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
