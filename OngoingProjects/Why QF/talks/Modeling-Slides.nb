Cell[TextData[{
 "A readout cavity of linewidth ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ace16c6-150c-af56-09a3-2dfb5014361a"],
 ", coupled to a transmon, has its frequency pulled by ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62447338-e7c1-416c-39f4-e1f444b65c4b"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a820b6-6ce1-fd97-3834-3aaf4206bdf9"],
 " depending on the qubit state, and is driven by a readout pulse ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Epsilon]", 
    StyleBox["r", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2559bbb1-2bda-ad0e-5aac-d96321358354"],
 " of peak amplitude ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[CurlyEpsilon]", "TI"], 
   StyleBox["max",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6973b341-7438-a4e3-16d1-4db4e5a050f3"],
 ". How does the cavity field separate for the two qubit states as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "2", GridBox[{
     {
      StyleBox["\[Chi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9476f8-b4a2-1629-09fe-abc7ec7382da"],
 " changes?"
}], "Text",
 CellID->1249895290,ExpressionUUID->"02d5ea61-9d29-a98e-446c-40d009541b0f"],

