Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bayesStep", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]_", ",", " ", "_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"A_", ",", " ", "d_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"\[Rho]", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", "A"}], 
            ")"}]}], "/", "2"}], "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mk", " ", "=", " ", 
         RowBox[{"krausGauss", "[", 
          RowBox[{
           RowBox[{"RandomVariate", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{
              RowBox[{"RandomChoice", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"p", ",", " ", 
                  RowBox[{"1", " ", "-", " ", "p"}]}], "}"}], " ", "->", " ", 
                
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", 
                  RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", " ", 
              RowBox[{"Sqrt", "[", "d", "]"}]}], "]"}], "]"}], ",", " ", "A", 
           ",", " ", "d"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"w", " ", "=", " ", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"mk", " ", ".", " ", "\[Rho]", " ", ".", " ", "mk"}], 
             "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"mk", " ", ".", " ", "\[Rho]", " ", ".", " ", "mk"}], "/",
             "w"}], ",", " ", "w"}], "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bayesMixedness", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{"4", " ", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesRho0", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{"0.3", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
      RowBox[{"0.4", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bayesRun", "[", 
    RowBox[{"d_", ",", " ", "\[CurlyTheta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bayesStep", "[", 
       RowBox[{"#1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"#2", ",", " ", "d"}], "}"}]}], "]"}], " ", "&"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"bayesRho0", ",", " ", "1."}], "}"}], ",", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Cos", "[", "\[CurlyTheta]", "]"}], " ", 
             RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Sin", "[", "\[CurlyTheta]", "]"}], " ", 
             RowBox[{"PauliMatrix", "[", "1", "]"}]}]}]}], "}"}], ",", " ", 
         "10"}], "]"}], ",", " ", "1"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bayesSteps", "[", "run_", "]"}], " ", ":=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{
          RowBox[{"Last", "[", "#2", "]"}], "^", "2"}]}], ",", " ", 
        RowBox[{
         RowBox[{"bayesMixedness", "[", 
          RowBox[{"First", "[", "#2", "]"}], "]"}], "/", 
         RowBox[{"bayesMixedness", "[", 
          RowBox[{"First", "[", "#1", "]"}], "]"}]}]}], "}"}], " ", "&"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Most", "[", "run", "]"}], ",", " ", 
       RowBox[{"Rest", "[", "run", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesThetas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", 
     RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesLawPanel", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pts", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "6", "]"}], ";", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Catenate", "[", 
            RowBox[{"Catenate", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"bayesSteps", "[", 
                RowBox[{"bayesRun", "[", 
                 RowBox[{"d", ",", " ", "\[CurlyTheta]"}], "]"}], "]"}], ",", 
               " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", " ", "8"}], "}"}]}], "}"}], ",", " ", 
               RowBox[{"{", "10", "}"}]}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[CurlyTheta]", ",", " ", "bayesThetas"}], "}"}]}], 
          "]"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Show", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"ListLogLogPlot", "[", 
          RowBox[{"pts", ",", " ", 
           RowBox[{"PlotMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "8"}], "}"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "9"}], "}"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Times]\>\"", ",", " ", "9"}], "}"}]}], "}"}]}], 
           ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "3", "]"}]}]}]}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"LogLogPlot", "[", 
          RowBox[{"x", ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "0.05", ",", " ", "50"}], "}"}], ",", " ", 
           
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<1/\>\"", ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{"\"\<w\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}], ",",
             " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<det \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[Rho]\>\"", ",", " ", "\"\<after\>\""}], "]"}], 
               ",", " ", "\"\< / det \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[Rho]\>\"", ",", " ", "\"\<before\>\""}], 
                "]"}]}], "}"}], "]"}]}], "}"}]}], ",", "\n", "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", "\"\<every reading\>\""}], ",", 
         " ", 
         RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
         RowBox[{"GridLinesStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], 
           "]"}]}], ",", " ", 
         RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"PointLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<\[CurlyTheta] = \>\"", ",", " ", "#"}], "}"}], 
              "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", " ", "\"\<\[Pi]/4\>\"", ",", " ", "\"\<\[Pi]/2\>\""}], 
             "}"}]}], ",", " ", 
           RowBox[{"LegendMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "8"}], "}"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "9"}], "}"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Times]\>\"", ",", " ", "9"}], "}"}]}], "}"}]}], 
           ",", " ", 
           RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
          " ", "Below"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesNoisePanel", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"runs", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"bayesMixedness", "[", 
              RowBox[{"First", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"bayesRun", "[", 
             RowBox[{"d", ",", " ", 
              RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "8"}], "}"}]}], "}"}], ",", " ", 
           RowBox[{"{", "5", "}"}]}], "]"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Show", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ListLogPlot", "[", 
             RowBox[{"#1", ",", " ", 
              RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
              RowBox[{"DataRange", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", " ", 
              RowBox[{"PlotStyle", " ", "->", " ", 
               RowBox[{"Directive", "[", 
                RowBox[{"#2", ",", " ", 
                 RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}]}], 
             "]"}], " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"runs", ",", " ", 
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
              RowBox[{"{", 
               RowBox[{"4", ",", " ", "5"}], "}"}]}]}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<reading number\>\"", ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<1 \[Minus] \>\"", ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{"\"\<r\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}]}],
            "}"}]}], ",", " ", 
         RowBox[{
         "PlotLabel", " ", "->", 
          " ", "\"\<five runs each, \[CurlyTheta] = \[Pi]/4\>\""}], ",", " ", 
         
         RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
         RowBox[{"GridLinesStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], 
           "]"}]}], ",", " ", 
         RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "5"}], "}"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<D = 2\>\"", ",", " ", "\"\<D = 8\>\""}], "}"}], ",", 
           " ", 
           RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
          " ", "Below"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"bayesLawPanel", ",", " ", "bayesNoisePanel"}], "}"}], "}"}], ",",
    " ", 
   RowBox[{"Alignment", " ", "->", " ", "Top"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "3"}]}], "]"}]}], "Input",
 CellLabel->"In[34]:= ",
 CellID->1249815441,ExpressionUUID->"04f04ce7-cf22-c8f4-089a-38663f1c5725"],

Cell[TextData[{
 "Every Kraus operator has unit determinant, for every reading and every ",
 Cell[BoxData["\[CurlyTheta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07bc5387-76d1-29a5-31ef-e8b98e67dad2"],
 ", so each update multiplies ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58771a96-0bfa-6141-4fed-ced0258d20b8"],
 ", and with it the mixedness, by ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["w", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10ce4e32-4c43-a5b8-57aa-7672fa44be4a"],
 ": every reading lands on the diagonal, the unlikely ones that raise the \
mixedness (above 1) as well as the likely ones that lower it. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6103e403-c0bb-024c-3878-70fba6ad77ba"],
 " the mixedness falls by orders of magnitude along every run. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "369bf00e-4d9b-3c80-2b02-21cd01a7ceec"],
 " one reading carries little information, and twenty readings purify the \
state only partly."
}], "Text",
 CellID->955812305,ExpressionUUID->"20639416-bc88-cdde-68f8-0bed798d39db"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->6560469,ExpressionUUID->"2bf87c62-7f48-d549-4fc2-e912efd21730"],

Cell[TextData[{
 "Born's rule as a martingale: runs collapse to the poles with probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70dfd45c-569d-e092-24a1-3c15bbaabe87"]
}], "Subsection",
 CellID->739238270,ExpressionUUID->"74cc98e0-58ab-6044-4faf-388dda27f1df"],

Cell[TextData[{
 "A qubit, Rabi-driven at frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7162565c-2abe-294b-27fb-fc22a34b231d"],
 ", starts in the pure state with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d29efd7-924a-d3d4-182f-3bcdf47a51cd"],
 ", and a perfect detector measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2df76f-a389-63f0-4441-5df497906237"],
 " continuously at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57f26246-c6f2-d453-00ec-15d33e4ffba4"],
 ". Without a drive, each run ends at a pole; with what probability does it \
end at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "183aa62a-957b-d424-60c4-ae9e799dd4c3"],
 "?"
}], "Text",
 CellID->1650059156,ExpressionUUID->"330fe351-428f-b48a-6ee7-57c4225f5775"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a5214c1-780a-ca03-4e0a-d8a7fa81b6b5"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalOmega]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d0e1ecf-ccc0-555e-0db6-ee56e16bd102"],
 ", the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39fef672-e6f6-5681-5fcc-b5d8db6f3c5e"],
 " component of the conditioned state obeys the It\[OHat] equation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["z", "TI"], "=", "\[CapitalOmega]", 
   StyleBox["y", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f91dffc-1708-42ef-7bfc-d6aa4f92aa97"],
 ", and the detector records ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["Y", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["z", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11e48dab-c834-e917-15f5-9fb637980c81"],
 ". In each step the record multiplies the amplitudes of ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5332c256-2354-cc19-293c-e259d529a501"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fb870ab-a26b-0f92-2206-12512825a293"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[PlusMinus]", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["Y", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644c34ef-e446-8b0f-3abc-8714ea1c4ba4"],
 " and the drive rotates them."
}], "Text",
 CellID->1925022605,ExpressionUUID->"0a8b57b2-1698-eb76-0498-8aa1d0e2985b"],

Cell[TextData[{
 "The record is sampled as 400 runs for each start. The left panel takes \
seven starting values ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7271831b-7799-0f92-5675-04801263cfbb"],
 " without a drive and plots the fraction of runs that end above ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73affd2f-8c7d-53bb-2e0e-c1d62b3deb96"],
 ", with its standard error, against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1098f6be-76a1-6a9a-15c2-9ff5d3133743"],
 "; the right panel follows four runs and the mean of all 400 for the chosen \
start and drive. Time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f12c924-a78b-3173-3d5b-896fe6b82f63"],
 ":"
}], "Text",
 CellID->192781458,ExpressionUUID->"24b4ad4c-486f-7528-6bb4-ffe86d644861"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bornRunsZ", "[", 
    RowBox[{"\[CapitalOmega]_", ",", " ", "z0_", ",", " ", 
     RowBox[{"dt_", " ", ":", " ", "0.005"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[CapitalOmega]", " ", 
         RowBox[{"dt", "/", "2"}], " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], " ", ".", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], ")"}], " ", "&"}], " ", "/@", " ", 
       
       RowBox[{"FoldList", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"amp", ",", " ", "dw"}], "}"}], ",", " ", 
           RowBox[{"Normalize", " ", "/@", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"amp", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{"Outer", "[", 
                  RowBox[{"Times", ",", " ", 
                   RowBox[{
                    RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "amp", "]"}], "^", "2"}], " ", ".", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], ")"}], " ", "dt"}], " ", "+",
                     " ", "dw"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ")"}], " ",
               ".", " ", "u"}], ")"}]}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", " ", "+", " ", "z0"}], ",", " ", 
                RowBox[{"1", " ", "-", " ", "z0"}]}], "}"}], "/", "2"}], 
             "]"}], "]"}], ",", " ", "400"}], "]"}], ",", " ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"800", ",", " ", "400"}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornStarts", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.5"}], ",", " ", "0.2", ",", " ", "0.8"}], "}"}]}], ";", 
  " ", 
  RowBox[{"bornDrives", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornFractions", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"z0", ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f", " ", "=", " ", 
            RowBox[{"Mean", "[", 
             RowBox[{"UnitStep", "[", 
              RowBox[{
               RowBox[{"bornRunsZ", "[", 
                RowBox[{"0", ",", " ", "z0"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", 
                 RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}]}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"z0", ",", " ", 
            RowBox[{"Around", "[", 
             RowBox[{"f", ",", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"f", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "f"}], ")"}], "/", "400"}]}], 
               "]"}]}], "]"}]}], "}"}]}], "]"}]}], "]"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.8"}], ",", " ", 
        RowBox[{"-", "0.5"}], ",", " ", 
        RowBox[{"-", "0.2"}], ",", " ", "0", ",", " ", "0.2", ",", " ", "0.5",
         ",", " ", "0.8"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bornLawPanel", "[", "z0_", "]"}], " ", ":=", " ", 
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", "s"}], ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", " ", 
            RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}]}]}], "]"}], 
       ",", "\n", "     ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"bornFractions", ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "8"}], "}"}]}], ",", 
         " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}]}]}], "]"}], 
       ",", "\n", "     ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "z0", "}"}], ",", " ", "None"}], "}"}]}], ",", " ", 
       RowBox[{"GridLinesStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "     ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<z\>\"", ",", " ", "0"}], "]"}], ",", 
          " ", "\"\<fraction ending at +1\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", "\"\<no drive\>\""}], ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"Column", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], "}"}], ",",
             " ", 
            RowBox[{"{", "\"\<fraction of 400 runs\>\"", "}"}], ",", " ", 
            RowBox[{"LegendMarkers", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "8"}], "}"}]}]}], 
           "]"}], ",", "\n", "       ", 
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Directive", "[", 
              RowBox[{"Red", ",", " ", 
               RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], "}"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<(1 + \>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<z\>\"", ",", " ", "0"}], "]"}], ",", 
                " ", "\"\<)/2\>\""}], "}"}], "]"}], "}"}]}], "]"}]}], "}"}], 
        "]"}], ",", " ", "Below"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornRunStyle", " ", "=", " ", 
   RowBox[{"Directive", "[", 
    RowBox[{
     RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", " ", 
     RowBox[{"Opacity", "[", "0.7", "]"}], ",", " ", 
     RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bornRunsPanel", "[", 
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]_", ",", " ", "z0_"}], "}"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zs", " ", "=", " ", 
       RowBox[{"bornRunsZ", "[", 
        RowBox[{"\[CapitalOmega]", ",", " ", "z0"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Show", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Take", "[", 
            RowBox[{"zs", ",", " ", "4"}], "]"}], ",", " ", 
           RowBox[{"DataRange", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", "bornRunStyle"}]}], "]"}], ",",
          "\n", "     ", 
         RowBox[{"ListPlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mean", "[", "zs", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", ";;", " ", "20"}], "]"}], "]"}], ",", " ", 
           RowBox[{"DataRange", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{"PlotMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "6"}], "}"}]}], ",",
            " ", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}]}]}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
         RowBox[{"GridLines", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", "z0", "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"GridLinesStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "     ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<k t\>\"", ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<z\>\""}], "]"}], ",",
                " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}]}], 
           "}"}]}], ",", " ", 
         RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{
              RowBox[{"{", "bornRunStyle", "}"}], ",", " ", 
              RowBox[{"{", "\"\<single runs\>\"", "}"}]}], "]"}], ",", " ", 
            RowBox[{"PointLegend", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], "}"}],
               ",", " ", 
              RowBox[{"{", "\"\<mean of 400 runs\>\"", "}"}], ",", " ", 
              RowBox[{"LegendMarkers", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "6"}], "}"}]}]}],
              "]"}], ",", "\n", "       ", 
            RowBox[{"LineLegend", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Directive", "[", 
                RowBox[{"Red", ",", " ", "Dashed"}], "]"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<z\>\"", ",", " ", "0"}], "]"}], "}"}]}], "]"}]}],
            "}"}], "]"}], ",", " ", "Below"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"bornRuns", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "8", "]"}], ";", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"bornRunsPanel", ",", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{"bornDrives", ",", " ", "bornStarts"}], "}"}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornLaw", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"bornLawPanel", ",", " ", "bornStarts"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bornLaw", "[", "bornZ0", "]"}], ",", " ", 
        RowBox[{"bornRuns", "[", 
         RowBox[{"{", 
          RowBox[{"bornOmega", ",", " ", "bornZ0"}], "}"}], "]"}]}], "}"}], 
      "}"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Top"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "3"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bornZ0", ",", " ", "0.2", ",", " ", 
       RowBox[{"Subscript", "[", 
        RowBox[{"\"\<z\>\"", ",", " ", "0"}], "]"}]}], "}"}], ",", " ", 
     "bornStarts", ",", " ", "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "bornOmega", ",", " ", "0", ",", " ", "\"\<\[CapitalOmega]/k\>\""}], 
      "}"}], ",", " ", "bornDrives", ",", " ", "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[35]:= ",
 CellID->366821624,ExpressionUUID->"76fb1ad1-5da9-1fdf-3496-617128d3730f"],

Cell[TextData[{
 "Without a drive the drift of ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d5ee66f-a14f-9264-7856-6a724819fcb4"],
 " is zero: every run heads for a pole while the mean stays on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50e291b4-dfe2-7683-7930-3dbe3ad45ad6"],
 ". A bounded process with constant mean that ends at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287f926d-a713-6461-720e-4f08be993f27"],
 " must end at ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5895fcce-6688-5d2b-51e0-43c82ebf403a"],
 " with probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1685aa7c-3a61-61b8-21b0-7f6ea942d2fd"],
 ", and the fraction of runs ending above zero matches it within its standard \
error. A drive adds the drift ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31cdaefa-4244-d7d6-4984-d83cfb263494"],
 ": the mean leaves ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e6e1ef1-4d6b-8290-43a3-9bd3be6dedfd"],
 " and the runs keep jumping instead of settling."
}], "Text",
 CellID->976188230,ExpressionUUID->"5e00b995-f1dd-0c1f-5733-b0950f81887c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->930350491,ExpressionUUID->"5f02131f-0827-5894-78c9-8f43f24205b0"],

Cell["\<\
A trapped particle watched continuously: squeezing below the zero-point\
\>", "Subsection",
 CellID->1438815762,ExpressionUUID->"4c1cd19f-9226-0b3e-6e2c-bcb395687165"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7289f096-dee1-f5ae-6fe4-e23de59ed445"],
 " in a harmonic trap of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ad3d0cb-d78d-85a3-7415-b87676a88310"],
 " has its position measured continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "379724b6-37c2-f614-6249-e8f0dc9f09ab"],
 " by a detector that catches a fraction ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dbc822d-70be-1070-18d3-df884c27c9ac"],
 " of the signal. Can watching make it narrower in position than its ground \
state?"
}], "Text",
 CellID->188722974,ExpressionUUID->"23f5e89b-7fdc-84df-450c-d2a57cfaf816"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox[
    SuperscriptBox[
     OverscriptBox[
      StyleBox["p", "TI"], "^"], "2"], 
    RowBox[{"2", 
     StyleBox["m", "TI"]}]], "+", 
   FractionBox[
    RowBox[{
     StyleBox["m", "TI"], 
     SuperscriptBox[
      StyleBox["\[Omega]", "TI"], "2"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["x", "TI"], "^"], "2"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0138542a-2cfe-4b27-192c-9edbd84e9421"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "^"], "2"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a4cf5f-873f-3a36-153f-1174112ec580"],
 ", the state conditioned on the record obeys"
}], "Text",
 CellID->1366133719,ExpressionUUID->"4b63be42-09de-589d-53bc-96ef8cbe37ce"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    FractionBox[
     StyleBox["i", "TI"], "\[HBar]"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["\[Lambda]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox[
      RowBox[{"\[Eta]", "\[Lambda]"}], "TI"]], "(", 
    RowBox[{
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], ")", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1883140676,ExpressionUUID->"3fba9e56-6d46-4677-709d-7bb8b8d7ae2d"],

Cell[TextData[{
 "A Gaussian state stays Gaussian, and its covariances ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d87cc0-6b69-cb5f-6a60-fd46a318fdcc"],
 ", ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0550d925-2c71-38ca-6bc5-efdf3e83b38e"],
 ", ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "284e42bf-e15c-e423-5317-913ab883a20a"],
 " obey a Riccati equation with no noise in it:"
}], "Text",
 CellID->585028959,ExpressionUUID->"4569f83a-1186-2205-189f-92eea9ba63c5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["x", "TI"]], "=", 
    FractionBox[
     RowBox[{"2", 
      StyleBox["C", "TI"]}], 
     StyleBox["m", "TI"]], "-", "4", 
    StyleBox["\[Eta]", "TI"], 
    StyleBox["\[Lambda]", "TI"], 
    SubsuperscriptBox["\[CapitalSigma]", 
     StyleBox["x", "TI"], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     StyleBox["C", "TI"], "."], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["p", "TI"]], 
      StyleBox["m", "TI"]], "-", 
     RowBox[{
      StyleBox["m", "TI"], 
      SuperscriptBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]]}], "-", 
     RowBox[{"4", 
      StyleBox["\[Eta]", "TI"], 
      StyleBox["\[Lambda]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]], 
      StyleBox["C", "TI"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["p", "TI"]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      StyleBox["m", "TI"], 
      SuperscriptBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      StyleBox["C", "TI"]}], "+", 
     RowBox[{
      StyleBox["\[Lambda]", "TI"], 
      SuperscriptBox["\[HBar]", "2"]}], "-", 
     RowBox[{"4", 
      StyleBox["\[Eta]", "TI"], 
      StyleBox["\[Lambda]", "TI"], 
      RowBox[{
       SuperscriptBox[
        StyleBox["C", "TI"], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1143153712,ExpressionUUID->"09a5b59a-553c-528b-3f0f-15fb88afec65"],

Cell[TextData[{
 "The steady state is in closed form, keeping the root proved positive, and \
so is the squeezing condition; the curves integrate the flow from the ground \
state, dashed lines are the closed form, ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57c4656d-8d24-6607-4147-c22cf206f9ed"],
 " is in units of the zero-point variance ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["m", "TI"], 
    StyleBox["\[Omega]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b78fe60-d7ec-ddba-4579-f59956c4e950"],
 ", the strength is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], 
    SuperscriptBox[
     StyleBox["\[Omega]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7442b7c4-b37e-241d-082d-d57adb5cba9b"],
 " and time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d5d9001-a8e4-bb68-4d5d-c26cdf86997b"],
 ":"
}], "Text",
 CellID->1913298502,ExpressionUUID->"71f0407e-3a2f-122a-6e0e-42262b1abb34"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"trapRiccati", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"cxp", "/", "m"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", 
       RowBox[{"vx", "^", "2"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"vp", "/", "m"}], " ", "-", " ", 
      RowBox[{"m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "vx"}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", "vx", " ", "cxp"}]}],
      ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "cxp"}], " ", "+", " ", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"\[HBar]", "^", "2"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", 
       RowBox[{"cxp", "^", "2"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapDomain", " ", "=", " ", 
   RowBox[{
    RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapSteady", " ", "=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"trapRiccati", " ", "==", " ", "0"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"vx", ",", " ", "cxp", ",", " ", "vp"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"Resolve", "[", 
       RowBox[{
        RowBox[{"ForAll", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "m", ",", " ", "\[Lambda]", ",", " ", "\[Omega]", ",", " ", 
            "\[HBar]", ",", " ", "\[Eta]"}], "}"}], ",", " ", "trapDomain", ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "|", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], ")"}], " ", "\[Element]", 
            " ", "Reals"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], " ", ">", " ", "0"}]}]}], "]"}], 
        ",", " ", "Reals"}], "]"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapRatio", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"trapSteady", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"\[HBar]", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m", " ", "\[Omega]"}], ")"}]}], ")"}]}], " ", "/.",
       " ", 
      RowBox[{"\[Lambda]", " ", "->", " ", 
       RowBox[{"\[Mu]", " ", "m", " ", 
        RowBox[{
         RowBox[{"\[Omega]", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "\[HBar]"}], ")"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Mu]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trapFlow", "[", 
    RowBox[{"\[Eta]0_", ",", " ", "\[Mu]0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"vxT", "'"}], "[", "t", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"cT", "'"}], "[", "t", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"vpT", "'"}], "[", "t", "]"}]}], "}"}], " ", "==", " ", 
         RowBox[{"(", 
          RowBox[{"trapRiccati", " ", "/.", "\n", "       ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"vx", " ", "->", " ", 
              RowBox[{"vxT", "[", "t", "]"}]}], ",", " ", 
             RowBox[{"cxp", " ", "->", " ", 
              RowBox[{"cT", "[", "t", "]"}]}], ",", " ", 
             RowBox[{"vp", " ", "->", " ", 
              RowBox[{"vpT", "[", "t", "]"}]}], ",", " ", 
             RowBox[{"m", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Omega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[HBar]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Lambda]", " ", "->", " ", 
              RowBox[{"\[Mu]0", "/", "2"}]}], ",", " ", 
             RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}]}], "}"}]}], 
          ")"}]}], "]"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"vxT", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"1", "/", "2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"cT", "[", "0", "]"}], " ", "==", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"vpT", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"1", "/", "2"}]}]}], "}"}], ",", " ", "vxT", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trapPanel", "[", "\[Eta]0_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"trapFlow", "[", 
             RowBox[{"\[Eta]0", ",", " ", "#"}], "]"}], "[", "t", "]"}]}], 
          " ", "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "5", ",", " ", "50"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Mu] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", " ", "5", ",", " ", "50"}], "}"}]}],
          ")"}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"trapRatio", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}], ",", " ", 
             RowBox[{"\[Mu]", " ", "->", " ", "#"}]}], "}"}]}], " ", "&"}], 
         " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "5", ",", " ", "50"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "2.5"}], "}"}]}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Omega] t\>\"", ",", 
        " ", "\"\<\[CapitalSigma]x / zero-point variance\>\""}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]0", ",", 
         " ", "\"\<,   squeezed for \>\"", ",", " ", 
         RowBox[{"Reduce", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"trapRatio", " ", "<", " ", "1"}], " ", "&&", " ", 
             RowBox[{"\[Mu]", " ", ">", " ", "0"}]}], " ", "/.", " ", 
            RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}]}], ",", " ", 
           "\[Mu]", ",", " ", "Reals"}], "]"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapPanels", " ", "=", " ", 
   RowBox[{"trapPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", 
      RowBox[{"1", "/", "2"}], ",", " ", 
      RowBox[{"1", "/", "5"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "trapPanels"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "trapPanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[36]:= ",
 CellID->1057991137,ExpressionUUID->"015ce1c7-2ba7-ec7a-5427-c697406436b1"],

Cell[TextData[{
 "A perfect detector squeezes the position below the zero-point at every \
strength. An imperfect one squeezes only above a threshold strength that \
grows as ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f367edb-2290-aa03-2535-7c65837ec968"],
 " falls; below it, watching leaves the particle wider than its ground \
state."
}], "Text",
 CellID->610348239,ExpressionUUID->"661daeec-2b8c-cb90-6025-5c3762b667c5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1907071850,ExpressionUUID->"496623b9-cdc0-f4d3-087f-5c0b2c28a518"],

Cell["\<\
The quantum Kalman filter: five numbers against a wavefunction\
\>", "Subsection",
 CellID->665556308,ExpressionUUID->"607d5466-dba0-61f8-56f2-9148d14d747f"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d0e207f-d182-f9d8-6b8a-1481c08fa267"],
 " sits in the potential ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   StyleBox["\[CurlyEpsilon]", "TI"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ebf8b25-c238-53a7-4c63-cf99061f5651"],
 ", and a perfect detector reads its position continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b49df6d-5f91-aa0d-4eaa-e2a980764943"],
 ". Can five numbers, updated from the readings alone, follow the mean \
position that the full conditional wavefunction carries?"
}], "Text",
 CellID->1841553427,ExpressionUUID->"7314233e-7ed4-8208-2113-5eff33df69ca"],

Cell[TextData[{
 "In a step ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c3b594-5470-49f1-41be-0fe37767e78a"],
 " the detector returns a reading ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc02602-4f3a-9eda-0c7d-fdaf70ed60db"],
 ", distributed as ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10a1dd96-8bff-a431-0875-e13b3573550f"],
 " blurred by a Gaussian of variance ",
 Cell[BoxData[
  FractionBox["1", 
   RowBox[{"4", 
    StyleBox["\[Lambda]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aaf49c2-74c7-a09c-16d1-add630b02a74"],
 ". Bayes' rule updates the wavefunction, and the Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"], "/", "2", 
   StyleBox["m", "TI"], "+", 
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c7061f8-cbdd-0018-5f69-260936b2348c"],
 " moves it (",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f746bf9-2f58-198b-1518-b13532bf5fd3"],
 "):"
}], "Text",
 CellID->1677045356,ExpressionUUID->"1f0df780-3577-a749-42d9-275b18409006"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Psi]", "TI"], "\[ThickSpace]", "\[Rule]", "\[ThickSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      OverscriptBox[
       StyleBox["H", "TI"], "^"], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}]], "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["\[Lambda]", "TI"], 
        StyleBox["d", "TI"], 
        StyleBox["t", "TI"], "\[ThinSpace]", 
        SuperscriptBox[
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{
           OverscriptBox[
            StyleBox["x", "TI"], "^"], "-", 
           OverscriptBox[
            StyleBox["x", "TI"], "_"]}], 
          StyleBox[")",
           SpanMaxSize->1]}], "2"]}]], 
      StyleBox["\[Psi]", "TI"]}], GridBox[{
       {GridBox[{
          {
           RowBox[{
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{"-", 
              StyleBox["\[Lambda]", "TI"], 
              StyleBox["d", "TI"], 
              StyleBox["t", "TI"], "\[ThinSpace]", 
              SuperscriptBox[
               RowBox[{
                StyleBox["(",
                 SpanMaxSize->1], 
                RowBox[{
                 OverscriptBox[
                  StyleBox["x", "TI"], "^"], "-", 
                 OverscriptBox[
                  StyleBox["x", "TI"], "_"]}], 
                StyleBox[")",
                 SpanMaxSize->1]}], "2"]}]], 
            StyleBox["\[Psi]", "TI"]}]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.22}}}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->276547391,ExpressionUUID->"3be4babc-390c-4326-3cfe-27bce4cfe72c"],

Cell[TextData[{
 "The Kalman filter assumes a Gaussian state in the harmonic trap, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[CurlyEpsilon]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325619ca-6d2d-90bc-398b-609861b71f50"],
 ", and carries only its means and covariances, corrected by the innovation \
",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "_"], "-", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52cfb2d3-1221-6c01-4355-9e53e155ae62"],
 ", the reading minus the predicted mean:"
}], "Text",
 CellID->1758126758,ExpressionUUID->"321e87ac-28dd-b642-21c0-20f35781a593"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["m", "TI"]], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "4", 
    StyleBox["\[Lambda]", "TI"], 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["x", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["x", "TI"], "_"], "-", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["x", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["m", "TI"]}], 
      SuperscriptBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["x", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"4", 
      StyleBox["\[Lambda]", "TI"], 
      StyleBox["C", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["x", "TI"], "_"], "-", 
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        OverscriptBox[
         StyleBox["x", "TI"], "^"], 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1695054173,ExpressionUUID->"6d294109-7b6f-8642-7875-216c3eefe4f4"],

Cell[TextData[{
 "and its covariances ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a37262c-c709-7150-48c6-247f2df9c211"],
 ", ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "587d4a39-1f73-2098-2572-19f824d8055f"],
 ", ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db8bd9b-47cf-cede-7ac2-2042749d3057"],
 " obey the Riccati equations of the trapped-particle slide at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f34f403-9c6c-3955-669f-4a6c66f6801c"],
 ", with ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c79ff21-4b00-c855-4c8f-21d2098e8514"],
 "."
}], "Text",
 CellID->571578257,ExpressionUUID->"34c648b8-de23-1729-41c1-649746de7f7f"],

Cell[TextData[{
 "The wavefunction runs on 256 grid points with a split-operator step, from a \
coherent state displaced to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "358dc2ea-aeb6-6df4-555b-a8888f0dfdfa"],
 ", and the filter receives the same readings. Lengths are in units of ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"\[HBar]", "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox[
     RowBox[{"m", "\[Omega]"}], "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e58d7ab-1098-de83-1cbc-25d0efcc36b8"],
 ", time in ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56f56984-d725-2bdf-6f09-7042f93e97d6"],
 ", the strength is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], 
    SuperscriptBox[
     StyleBox["\[Omega]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f01c4e3-346f-946d-3314-06ea48268143"],
 " and ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a4e84b9-2238-8070-4e6e-f034175574ca"],
 " is in units of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["m", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "3"], "/", "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e12e82-058c-baf2-4d53-516f4924f29e"],
 ":"
}], "Text",
 CellID->947853736,ExpressionUUID->"4876154f-ea5d-7256-229f-9340e59f21fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalmanX", " ", "=", " ", 
   RowBox[{"24.", " ", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "128"}], ",", " ", "127"}], "]"}], "/", "256"}]}]}], ";", 
  " ", 
  RowBox[{"kalmanP", " ", "=", " ", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{
     RowBox[{"RotateLeft", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "128"}], ",", " ", "127"}], "]"}], ",", " ", "128"}], 
      "]"}], "/", "24."}]}]}], ";", " ", 
  RowBox[{"kalmanDt", " ", "=", " ", "0.002"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kalmanGrid", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[CurlyEpsilon]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]0", " ", "=", " ", 
        RowBox[{"\[Mu]", "/", "2"}]}], ",", " ", 
       RowBox[{"half", " ", "=", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"kalmanX", "^", "2"}], "/", "2"}], " ", "+", " ", 
            RowBox[{"\[CurlyEpsilon]", " ", 
             RowBox[{"kalmanX", "^", "4"}]}]}], ")"}], " ", 
          RowBox[{"kalmanDt", "/", "2"}]}], "]"}]}], ",", " ", 
       RowBox[{"kin", " ", "=", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"kalmanP", "^", "2"}], " ", 
          RowBox[{"kalmanDt", "/", "2"}]}], "]"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Reap", "[", 
      RowBox[{"NestList", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xb", " ", "=", " ", 
             RowBox[{
              RowBox[{"RandomChoice", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], " ", "->", " ", 
                "kalmanX"}], "]"}], " ", "+", " ", 
              RowBox[{"RandomVariate", "[", 
               RowBox[{"NormalDistribution", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"1", "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"4", " ", "\[Lambda]0", " ", "kalmanDt"}], 
                   "]"}]}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", "       ", 
           RowBox[{"half", " ", 
            RowBox[{"InverseFourier", "[", 
             RowBox[{"kin", " ", 
              RowBox[{"Fourier", "[", 
               RowBox[{"half", " ", 
                RowBox[{"Normalize", "[", 
                 RowBox[{
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "\[Lambda]0"}], " ", "kalmanDt", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"kalmanX", " ", "-", " ", 
                    RowBox[{"Sow", "[", "xb", "]"}]}], ")"}], "^", "2"}]}], 
                   "]"}], " ", "#"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], " ",
          "&"}], ",", " ", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"kalmanX", " ", "-", " ", "3"}], ")"}], "^", "2"}]}], "/",
            "2"}], "]"}], "]"}], ",", " ", "5000"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kalmanFilter", "[", 
    RowBox[{"\[Mu]_", ",", " ", "readings_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Lambda]0", " ", "=", " ", 
       RowBox[{"\[Mu]", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"FoldList", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "xb"}], "}"}], ",", " ", 
          RowBox[{"v", " ", "/.", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "mx_", ",", " ", "mp_", ",", " ", "vx_", ",", " ", "c_", ",", 
              " ", "vp_"}], "}"}], " ", ":>", " ", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"g", " ", "=", " ", 
                RowBox[{"4", " ", "\[Lambda]0", " ", 
                 RowBox[{"(", 
                  RowBox[{"xb", " ", "-", " ", "mx"}], ")"}], " ", 
                 "kalmanDt"}]}], "}"}], ",", "\n", "       ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "mx", ",", " ", "mp", ",", " ", "vx", ",", " ", "c", ",", " ",
                  "vp"}], "}"}], " ", "+", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"mp", " ", "kalmanDt"}], " ", "+", " ", 
                  RowBox[{"g", " ", "vx"}]}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "mx"}], " ", "kalmanDt"}], " ", "+", " ", 
                  RowBox[{"g", " ", "c"}]}], ",", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"2", " ", "c"}], " ", "-", " ", 
                    RowBox[{"4", " ", "\[Lambda]0", " ", 
                    RowBox[{"vx", "^", "2"}]}]}], ")"}], " ", "kalmanDt"}], ",",
                  " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"vp", " ", "-", " ", "vx", " ", "-", " ", 
                    RowBox[{"4", " ", "\[Lambda]0", " ", "vx", " ", "c"}]}], 
                   ")"}], " ", "kalmanDt"}], ",", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], " ", "c"}], " ", "+", " ", 
                    "\[Lambda]0", " ", "-", " ", 
                    RowBox[{"4", " ", "\[Lambda]0", " ", 
                    RowBox[{"c", "^", "2"}]}]}], ")"}], " ", "kalmanDt"}]}], 
                "}"}]}]}], "]"}]}]}]}], "]"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
         "3.", ",", " ", "0.", ",", " ", "0.5", ",", " ", "0.", ",", " ", 
          "0.5"}], "}"}], ",", " ", "readings"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kalmanPanel", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[CurlyEpsilon]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
         RowBox[{"kalmanGrid", "[", 
          RowBox[{"\[Mu]", ",", " ", "\[CurlyEpsilon]"}], "]"}]}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], " ", ".", " ", 
            "kalmanX"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"First", "[", "run", "]"}]}], ",", " ", 
         RowBox[{"kalmanFilter", "[", 
          RowBox[{"\[Mu]", ",", " ", 
           RowBox[{"run", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",",
        " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "10"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", 
       "     ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Omega] t\>\"", ",", " ", "\"\<\:27e8x\:27e9\>\""}], 
         "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[Mu] = \>\"", ",", " ", "\[Mu]", ",", 
           " ", "\"\<,   \[CurlyEpsilon] = \>\"", ",", " ", 
           "\[CurlyEpsilon]"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", "\n", "     ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<wavefunction, 256 amplitudes\>\"", ",", 
          " ", "\"\<Kalman filter, 5 numbers\>\""}], "}"}]}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kalmanPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"kalmanPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "10"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.01", ",", " ", "0.05"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "kalmanPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"kalmanPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[37]:= ",
 CellID->1564521590,ExpressionUUID->"052404f0-582c-5523-056d-396ec850a581"],

Cell[TextData[{
 "In the harmonic trap the filter lies on the wavefunction's mean at both \
strengths: the conditional state stays Gaussian, so the 256 amplitudes carry \
nothing the five numbers miss. A quartic term makes the state non-Gaussian \
and the filter's harmonic model wrong. It drifts away under gentle watching. \
Under strong watching each reading pulls it back, and it falls visibly behind \
the faster true oscillation only at the larger ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f02d83b-a81e-c285-38be-726b69673cab"],
 "."
}], "Text",
 CellID->1182552059,ExpressionUUID->"72307f36-0618-2f94-72b8-bb6a1fb6e98d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1182135500,ExpressionUUID->"6a87f872-25f8-a318-3730-121bd2387360"],

Cell["A watched Gaussian: the center wanders, the widths do not", "Subsection",
 CellID->624435969,ExpressionUUID->"0c2f134f-c70e-09ae-1f25-eaf2b04a3002"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "437ad988-ba4d-cb9c-3532-ed91cedf64c5"],
 " in a harmonic trap of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70caaa5e-08b3-19f7-2edf-bcf33990296c"],
 " is watched in position at rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d45f75-e387-bdd7-125c-6702f3695d4d"],
 " by a detector of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b21f9e-29c4-0d03-565f-1aa7851107ce"],
 ", and its conditional state is a Gaussian with means ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["p", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0780ea01-45ed-6a59-3eb6-c53ca88535da"],
 ", variances ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f83d881-6d3d-cf5c-2f15-b3ff18eb268d"],
 " and covariance ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b8afac0-aad2-7aae-4d9c-50ec0c950224"],
 ". Every run moves the packet's center at random. Do the widths of a watched \
Gaussian wander too?"
}], "Text",
 CellID->636600166,ExpressionUUID->"422a7902-2f81-dbe9-5139-8b97a2b035a3"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox[
    SuperscriptBox[
     OverscriptBox[
      StyleBox["p", "TI"], "^"], "2"], 
    RowBox[{"2", 
     StyleBox["m", "TI"]}]], "+", 
   FractionBox[
    RowBox[{
     StyleBox["m", "TI"], 
     SuperscriptBox[
      StyleBox["\[Omega]", "TI"], "2"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["x", "TI"], "^"], "2"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cc4243c-eb2b-3740-7f98-dc55dead78b4"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bdc800-3569-76b5-7bd0-a22ac04f13c1"],
 ", the conditional mean of any observable ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["O", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "435a94eb-31e3-91ea-30e1-7cf4485f6551"],
 " obeys"
}], "Text",
 CellID->482975697,ExpressionUUID->"0161a6a9-51f9-e111-7ac9-b9755a0d5220"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["O", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "=", "\[LeftAngleBracket]", 
    RowBox[{
     FractionBox[
      StyleBox["i", "TI"], "\[HBar]"], 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["H", "TI"], "^"], ",", 
      OverscriptBox[
       StyleBox["O", "TI"], "^"]}], 
     StyleBox["]",
      SpanMaxSize->1], "-", 
     FractionBox[
      StyleBox["\[Lambda]", "TI"], "2"], "[", 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      RowBox[{
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["x", "TI"], "^"], ",", 
        OverscriptBox[
         StyleBox["O", "TI"], "^"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "]"}], "\[RightAngleBracket]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox[
      RowBox[{"\[Eta]", "\[Lambda]"}], "TI"]], "\[ThinSpace]", "\[LeftAngleBracket]", 
    RowBox[{
     RowBox[{"{", 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], "-", 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], ",", 
     RowBox[{
      OverscriptBox[
       StyleBox["O", "TI"], "^"], "}"}]}], "\[RightAngleBracket]", "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->218740597,ExpressionUUID->"1f0aa60a-1f48-65ab-1f15-f6462b2b3396"],

Cell[TextData[{
 "and the second moments pick up the It\[OHat] correction, e.g. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]], "=", 
   StyleBox["d", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", "2", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "728b58f5-f249-48ef-4ea8-33aec9abf8a3"],
 ". The Gaussian has the ordered generating function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["\[Alpha]", "TI"], 
      OverscriptBox[
       StyleBox["x", "TI"], "^"]}]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["\[Beta]", "TI"], 
      OverscriptBox[
       StyleBox["p", "TI"], "^"]}]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "(", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["p", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "+", 
    FractionBox["1", "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "2"], 
     SubscriptBox["\[CapitalSigma]", 
      StyleBox["x", "TI"]], "+", "2", 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["C", "TI"], "+", 
     SuperscriptBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     SubscriptBox["\[CapitalSigma]", 
      StyleBox["p", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    FractionBox[
     RowBox[{
      StyleBox["i", "TI"], "\[HBar]"}], "2"], 
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["\[Beta]", "TI"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0090af8b-555d-8b6f-240a-b564d85f8203"],
 ", and its purity is ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     RowBox[{
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["p", "TI"]], "-", 
      SuperscriptBox[
       StyleBox["C", "TI"], "2"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e72d11-88fe-6663-7f83-d2b00df5c970"],
 "."
}], "Text",
 CellID->1888719079,ExpressionUUID->"42edf563-242e-e598-24c7-e1371a514787"],

Cell[TextData[{
 "Ordering every product with ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c103a9-965f-d23f-056c-45d3f8cce229"],
 " to the left of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621e6b8c-1a03-08e4-58af-e3756eb1f075"],
 " and reading each ordered monomial off the generating function gives the \
drift and noise of the five numbers for general parameters, and the purity of \
every steady state of the drift:"
}], "Text",
 CellID->577319652,ExpressionUUID->"5907e604-b01b-c753-0436-40e7cda130cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xpAlgebra", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"xo", ",", " ", "po"}], "}"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"po", " ", "**", " ", "xo"}], " ", "-", " ", 
         RowBox[{"xo", " ", "**", " ", "po"}], " ", "+", " ", 
         RowBox[{"I", " ", "\[HBar]"}]}], "}"}]}]}], "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussMean", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mgf", " ", "=", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"\[Alpha]", " ", "mx"}], " ", "+", " ", 
            RowBox[{"\[Beta]", " ", "mp"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Alpha]", "^", "2"}], " ", "\[CapitalSigma]x"}], 
               " ", "+", " ", 
               RowBox[{"2", " ", "\[Alpha]", " ", "\[Beta]", " ", "Cxp"}], 
               " ", "+", " ", 
               RowBox[{
                RowBox[{"\[Beta]", "^", "2"}], " ", "\[CapitalSigma]p"}]}], 
              ")"}], "/", "2"}], " ", "+", " ", 
            RowBox[{"I", " ", "\[HBar]", " ", "\[Alpha]", " ", 
             RowBox[{"\[Beta]", "/", "2"}]}]}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"q", " ", "=", " ", 
          RowBox[{
           RowBox[{"NonCommutativeExpand", "[", 
            RowBox[{"o", ",", " ", "xpAlgebra"}], "]"}], " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"GeneralizedPower", "[", 
               RowBox[{
               "NonCommutativeMultiply", ",", " ", "g_", ",", " ", "k_"}], 
               "]"}], " ", ":>", " ", 
              RowBox[{"g", "^", "k"}]}], ",", " ", 
             RowBox[{"NonCommutativeMultiply", " ", "->", " ", "Times"}]}], 
            "}"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#2", " ", 
             RowBox[{"D", "[", 
              RowBox[{"mgf", ",", " ", 
               RowBox[{"{", 
                RowBox[{"\[Alpha]", ",", " ", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"\[Beta]", ",", " ", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], " ", "/.",
             " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Alpha]", " ", "->", " ", "0"}], ",", " ", 
              RowBox[{"\[Beta]", " ", "->", " ", "0"}]}], "}"}]}], ")"}], " ",
           "&"}], " ", "@@@", " ", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"q", ",", " ", 
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "po"}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussDrift", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{"gaussMean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "/", "\[HBar]"}], " ", 
      RowBox[{"Commutator", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"po", " ", "**", " ", "po"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "m"}], ")"}]}], " ", "+", " ", 
         RowBox[{"m", " ", 
          RowBox[{"\[Omega]", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"xo", " ", "**", " ", "xo"}], "/", "2"}]}]}], ",", " ", 
        "o"}], "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"\[Lambda]", "/", "2"}], " ", 
      RowBox[{"Commutator", "[", 
       RowBox[{"xo", ",", " ", 
        RowBox[{"Commutator", "[", 
         RowBox[{"xo", ",", " ", "o"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussNoise", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Eta]", " ", "\[Lambda]"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"gaussMean", "[", 
       RowBox[{"Anticommutator", "[", 
        RowBox[{"xo", ",", " ", "o"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{"2", " ", "mx", " ", 
       RowBox[{"gaussMean", "[", "o", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussCov", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", " ", "ma_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b_", ",", " ", "mb_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ab", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", " ", "**", " ", "b"}], " ", "+", " ", 
          RowBox[{"b", " ", "**", " ", "a"}]}], ")"}], "/", "2"}]}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"gaussDrift", "[", "ab", "]"}], " ", "-", " ", 
        RowBox[{"ma", " ", 
         RowBox[{"gaussDrift", "[", "b", "]"}]}], " ", "-", " ", 
        RowBox[{"mb", " ", 
         RowBox[{"gaussDrift", "[", "a", "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"gaussNoise", "[", "a", "]"}], " ", 
         RowBox[{"gaussNoise", "[", "b", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"gaussNoise", "[", "ab", "]"}], " ", "-", " ", 
        RowBox[{"ma", " ", 
         RowBox[{"gaussNoise", "[", "b", "]"}]}], " ", "-", " ", 
        RowBox[{"mb", " ", 
         RowBox[{"gaussNoise", "[", "a", "]"}]}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gaussEqs", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"gaussDrift", "[", "#", "]"}], ",", " ", 
          RowBox[{"gaussNoise", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"{", 
        RowBox[{"xo", ",", " ", "po"}], "}"}]}], ",", " ", 
      RowBox[{"gaussCov", " ", "@@@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "mx"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "mx"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "mx"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"po", ",", " ", "mp"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"po", ",", " ", "mp"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"po", ",", " ", "mp"}], "}"}]}], "}"}]}], "}"}]}]}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gaussShow", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mx", " ", "->", " ", 
      RowBox[{"AngleBracket", "[", "\"\<x\>\"", "]"}]}], ",", " ", 
     RowBox[{"mp", " ", "->", " ", 
      RowBox[{"AngleBracket", "[", "\"\<p\>\"", "]"}]}], ",", " ", 
     RowBox[{"\[CapitalSigma]x", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[CapitalSigma]\>\"", ",", " ", "\"\<x\>\""}], "]"}]}], ",",
      " ", 
     RowBox[{"\[CapitalSigma]p", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[CapitalSigma]\>\"", ",", " ", "\"\<p\>\""}], "]"}]}], ",",
      " ", 
     RowBox[{"Cxp", " ", "->", " ", "\"\<C\>\""}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gaussSteadyPurity", " ", "=", " ", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[HBar]", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"\[CapitalSigma]x", " ", "\[CapitalSigma]p"}], " ", "-",
               " ", 
              RowBox[{"Cxp", "^", "2"}]}], "]"}]}], ")"}]}], " ", "/.", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "\[CapitalSigma]x", ",", " ", "Cxp", ",", " ", 
             "\[CapitalSigma]p"}], "}"}], " ", "->", " ", "#"}], "]"}]}], ",",
         " ", 
        RowBox[{
         RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], 
       "]"}], " ", "&"}], " ", "/@", "\n", "    ", 
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"gaussEqs", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"3", " ", ";;"}], ",", " ", "1"}], "]"}], "]"}], " ", "==",
          " ", "0"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "\[CapitalSigma]x", ",", " ", "Cxp", ",", " ", "\[CapitalSigma]p"}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Style", "[", 
  RowBox[{
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TraditionalForm", "[", "#1", "]"}], ",", " ", 
