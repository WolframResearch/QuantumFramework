Cell["\<\
A Hamiltonian with white noise: Stratonovich to It\[OHat] gives the dephasing\
\
\>", "Subsection",
 CellID->963406321,ExpressionUUID->"4e27d1ff-348b-1e2b-6cc8-c46205f32f1e"],

Cell[TextData[{
 "A qubit with Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "562e3ac2-2349-b607-2855-782b47097ef2"],
 " also feels a white-noise field along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321c57a4-49f2-a507-6703-5fbb6d1262e1"],
 " with power ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bdfc00f-12f1-1a17-53bb-a67a6c406a8a"],
 ": ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], "+", 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
   StyleBox["\[Xi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f5e6187-051c-fd02-23c5-98c62cff64cd"],
 ", with ",
 Cell[BoxData[
  StyleBox["\[Xi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b8caf96-5852-0baf-6122-98876dbc4176"],
 " white noise. Every run is a unitary rotation; what does the average over \
runs do?"
}], "Text",
 CellID->229076040,ExpressionUUID->"2256bde4-9ca1-4ffb-6fdf-078b5c81a49f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cd9b79-3603-9071-3398-e1328b3a03a7"],
 ", white noise as the limit of smooth noise makes the equation of motion a \
Stratonovich equation,"
}], "Text",
 CellID->1689850186,ExpressionUUID->"2f3bc248-63e7-7869-6ddb-ba4c7135b179"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "-", 
    StyleBox["i", "TI"], 
    SqrtBox[
     StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "\[SmallCircle]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1233406724,ExpressionUUID->"1c2e466b-3c5f-a339-6321-3f0e1fe1009b"],

Cell[TextData[{
 "and only its It\[OHat] form, whose drift gains ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "\[CenterDot]", "\[Del]"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4796bd3d-d05b-9caf-00ed-ba7a2ceeeee5"],
 " from the noise ",
 Cell[BoxData[
  RowBox[{
   StyleBox["b", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", 
     StyleBox["y", "TI"]}], ",", 
    StyleBox["x", "TI"], ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ed3a8a7-2ad8-e1c7-5cd5-9d3fd29c4cfa"],
 " of the Bloch vector, gives the average. The It\[OHat] drift of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "495120be-cd5d-0cff-776f-d40e5d3dca95"],
 " is:"
}], "Text",
 CellID->2074470509,ExpressionUUID->"6225af4e-3cd3-65f2-2780-95ea6f0724da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"noisyBlochOf", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"m", " ", ".", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"noisyH", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]v", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], ",", " ", 
             RowBox[{"y", "[", "t", "]"}], ",", " ", 
             RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", ".", " ", 
           RowBox[{"PauliMatrix", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
         ")"}], "/", "2"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"StratonovichProcess", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"noisyBlochOf", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"\[Omega]", "/", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"PauliMatrix", "[", "1", "]"}], " ", ".", " ", 
              "\[Rho]v"}], " ", "-", " ", 
             RowBox[{"\[Rho]v", " ", ".", " ", 
              RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ")"}]}], "]"}], ",",
          "\n", "     ", 
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"noisyBlochOf", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
               "\[Rho]v"}], " ", "-", " ", 
              RowBox[{"\[Rho]v", " ", ".", " ", 
               RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}]}], "]"}]}]}],
         "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], ",", 
       " ", "t"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TraditionalForm", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ItoProcess", "[", "noisyH", "]"}], "[", "\"\<Drift\>\"", "]"}], 
   " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], " ", "->", " ", "x"}], ",", " ", 
     RowBox[{
      RowBox[{"y", "[", "t", "]"}], " ", "->", " ", "y"}], ",", " ", 
     RowBox[{
      RowBox[{"z", "[", "t", "]"}], " ", "->", " ", "z"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[27]:= ",
 CellID->984271817,ExpressionUUID->"7c32c281-1018-d78f-3e25-a28f8d0491b8"],

Cell[TextData[{
 "200 runs start from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e453d4-cab6-c228-7a22-ebdf4098d978"],
 " as alternating rotations, a random angle about ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e95cb89-41f4-02f2-432d-ea0b22a674eb"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bad8ccc-2052-e56d-6238-1c8a88714952"],
 " about ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1e93f4-3d29-e104-2cc1-91a2863a0ab8"],
 ". Each panel draws three single runs (gray), the average of all 200 (dots) \
and the prediction of the Lindblad equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     FractionBox[
      StyleBox["\[Omega]", "TI"], "2"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["x", "TI"]]}], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "395787be-e5b8-d5c9-5adb-a9944370f9a1"],
 " (red); time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ba2f635-2c1a-89a1-6c94-5cc673e533ff"],
 ":"
}], "Text",
 CellID->878845687,ExpressionUUID->"257f7010-b1ad-f918-7a0e-cf881c6f39de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"noisyRunsZ", "[", "\[Gamma]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dt", " ", "=", " ", "0.01"}], "}"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"FoldList", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"v", ",", " ", "a"}], "}"}], ",", " ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"xr", " ", "=", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", 
                  RowBox[{"Cos", "[", "a", "]"}]}], " ", "-", " ", 
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], " ", 
                  RowBox[{"Sin", "[", "a", "]"}]}]}]}], ",", " ", 
               RowBox[{"yr", " ", "=", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", 
                  RowBox[{"Sin", "[", "a", "]"}]}], " ", "+", " ", 
                 RowBox[{
                  RowBox[{"v", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], " ", 
                  RowBox[{"Cos", "[", "a", "]"}]}]}]}]}], "}"}], ",", "\n", 
             "       ", 
             RowBox[{"{", 
              RowBox[{"xr", ",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Cos", "[", "dt", "]"}], " ", "yr"}], " ", "-", " ", 
                
                RowBox[{
                 RowBox[{"Sin", "[", "dt", "]"}], " ", 
                 RowBox[{"v", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}]}], ",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"Sin", "[", "dt", "]"}], " ", "yr"}], " ", "+", " ", 
                
                RowBox[{
                 RowBox[{"Cos", "[", "dt", "]"}], " ", 
                 RowBox[{"v", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}]}]}], "}"}]}], "]"}]}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", " ", "200"}], "]"}], ",", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", " ", "200"}], "]"}], ",", " ", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1.", ",", " ", "200"}], "]"}]}], "}"}], ",", "\n", 
         "     ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"\[Gamma]", " ", "dt"}], "]"}]}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2000", ",", " ", "200"}], "}"}]}], "]"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lindbladNoisyH", "[", "\[Gamma]_", "]"}], " ", ":=", " ", 
   RowBox[{"Re", " ", "@", " ", 
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumEvolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "/", "2"}], ",",
           " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "}"}], " ", "->",
            " ", 
           RowBox[{"{", "\[Gamma]", "}"}]}], ",", " ", 
          RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}]}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"noisyRunStyle", " ", "=", " ", 
   RowBox[{"Directive", "[", 
    RowBox[{
     RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", " ", 
     RowBox[{"Opacity", "[", "0.6", "]"}], ",", " ", 
     RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelNoisyH", "[", "\[Gamma]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zs", " ", "=", " ", 
       RowBox[{"noisyRunsZ", "[", "\[Gamma]", "]"}]}], "}"}], ",", " ", 
     RowBox[{"Show", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"zs", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "noisyRunStyle"}]}], "]"}], ",",
        "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"lindbladNoisyH", "[", "\[Gamma]", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", " ", 
            RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}]}]}], "]"}], 
       ",", "\n", "    ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "[", "zs", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", " ", ";;", " ", "40"}], "]"}], "]"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "7"}], "}"}]}], ",", 
         " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}]}]}], "]"}], 
       ",", "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Omega] t\>\"", ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<z\>\""}], "]"}], ",",
              " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}]}], "}"}]}], 
       ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Gamma]/\[Omega] = \>\"", ",", " ", "\[Gamma]"}], 
          "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"panelNoisyH", " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"0.1", ",", " ", "0.5", ",", " ", "2"}], "}"}]}], "}"}], ",",
        " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", "noisyRunStyle", "}"}], ",", " ", 
         RowBox[{"{", "\"\<single runs\>\"", "}"}]}], "]"}], ",", " ", 
       RowBox[{"PointLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], "}"}], ",",
          " ", 
         RowBox[{"{", "\"\<average of 200 runs\>\"", "}"}], ",", " ", 
         RowBox[{"LegendMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "7"}], "}"}]}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", " ", 
            RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], "}"}], ",",
          " ", 
         RowBox[{"{", "\"\<Lindblad\>\"", "}"}]}], "]"}]}], "}"}], "]"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[28]:= ",
 CellID->566075619,ExpressionUUID->"32a4a233-5385-b1b5-5bf2-30b030902afc"],

Cell[TextData[{
 "The conversion adds ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "637af8d1-d52d-a5b2-76b6-9ff59ab84032"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f2a4670-f135-efeb-22c2-86bd2ca55797"],
 " to the drift: dephasing at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3644ec11-8f2f-745f-4ab5-2e2d6f5fe4ab"],
 " about the noise axis. The average over runs follows the Lindblad curve, \
which relaxes toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7534ea84-530d-48de-62dd-a9139b1f226e"],
 ". The decay is fastest near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "099157d9-cca9-3e9b-0c0b-191abeb2e7a1"],
 "; stronger noise slows it again, because the fast phase noise freezes the \
rotation."
}], "Text",
 CellID->687348431,ExpressionUUID->"19d29e0b-dc29-8bf0-04fa-56fcb9f4cfe1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->549535179,ExpressionUUID->"405d5a90-fa36-a616-29a0-455856fccdb2"],

Cell["\<\
A laser with a diffusing phase: the exact mean field and a non-stationary \
correlation\
\>", "Subsection",
 CellID->1968964190,ExpressionUUID->"3fb3e4ec-bb6e-1839-072c-6827c4214c30"],

Cell[TextData[{
 "A laser field of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "432f4118-c049-d1f6-63ea-8f51cf0ce1b6"],
 " has a phase that diffuses at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d7085a3-3ed0-3f2d-668d-d2f543eb0f8a"],
 ", starting from zero. What are the mean field and the two-time correlation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["t", "TI"], "+", 
     StyleBox["\[Tau]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c008cc4-6154-8139-0345-244fee0561cd"],
 "?"
}], "Text",
 CellID->157436911,ExpressionUUID->"2cb2e790-ae0c-1b03-6340-5b116d7f3797"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "(", 
    RowBox[{
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"], "+", 
     SubscriptBox[
      StyleBox["\[Phi]", "TI"], 
      StyleBox["t", "TI"]]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{"d", "\[Phi]"}], "TI"], "=", 
    RowBox[{
     SqrtBox[
      RowBox[{"2", 
       StyleBox["\[Kappa]", "TI"]}]], "\[ThinSpace]", 
     StyleBox["d", "TI"], 
     StyleBox["W", "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Phi]", "TI"], "0"], "=", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->158497134,ExpressionUUID->"325517e2-eb30-811d-5786-dd06c8a568a5"],

Cell[TextData[{
 "Both moments of ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8743d4-6064-9b25-0cbb-9799288255c0"],
 ", a transformation of a Wiener process, are exact for general ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f4af381-e1cc-a09e-4b32-6c38d8a7ce69"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd9615b-9ba5-3169-7a91-9c8c70bf3a1f"],
 ", ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50f511ac-8847-c3a7-7ee2-eca330ece980"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c332f67-8088-5c81-703c-cf4638a33fec"],
 ":"
}], "Text",
 CellID->273736603,ExpressionUUID->"1e543fa6-c367-5ae1-12f1-42914d99609e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"laserField", " ", "=", " ", 
   RowBox[{"TransformedProcess", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"\[Omega]", " ", "t"}], " ", "+", " ", 
       RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], ",", " ", 
     RowBox[{"\[Phi]", " ", "\[Distributed]", " ", 
      RowBox[{"WienerProcess", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "\[Kappa]"}], "]"}]}], "]"}]}], ",", " ", "t"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"laserMeanField", " ", "=", " ", 
   RowBox[{"Mean", "[", 
    RowBox[{"laserField", "[", "t", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"laserCorrelation", " ", "=", " ", 
   RowBox[{"Simplify", " ", "/@", " ", 
    RowBox[{"Expand", "[", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"AbsoluteCorrelationFunction", "[", 
         RowBox[{"laserField", ",", " ", "t", ",", " ", 
          RowBox[{"t", " ", "+", " ", "\[Tau]"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"t", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"\[Tau]", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}]}]}], "]"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"MapThread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"#1", ",", " ", "\"\< = \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"#2", " ", "/.", " ", 
          RowBox[{
           RowBox[{"Power", "[", 
            RowBox[{"E", ",", " ", "p_"}], "]"}], " ", ":>", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<e\>\"", ",", " ", "Italic"}], "]"}], ",", " ", 
             "p"}], "]"}]}]}], "]"}]}], "}"}], "]"}], " ", "&"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\:27e8E(t)\:27e9\>\"", ",", 
        " ", "\"\<\:27e8E(t) E(t+\[Tau])\:27e9\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"laserMeanField", ",", " ", "laserCorrelation"}], "}"}]}], 
     "}"}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[29]:= ",
 CellID->1934379342,ExpressionUUID->"29be55b0-aebe-3f27-2ef0-3ea6d8482a44"],

Cell[TextData[{
 "For each diffusion rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10acf157-22af-7505-63ce-ba82324314bc"],
 ", the left panel shows three runs against the exact mean field and the \
right panel the correlation at three times ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503fd831-5831-81a2-35cb-7002274763f3"],
 "; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "702cc7dc-a676-ecad-407c-864d86ea3dc4"],
 ":"
}], "Text",
 CellID->429948480,ExpressionUUID->"76a79f38-441e-dc0f-36d8-8a1a141e80ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"laserRunColors", " ", "=", " ", 
   RowBox[{
    RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "3", "]"}]}]}], ";", " ", 
  RowBox[{"laserTimeColors", " ", "=", " ", 
   RowBox[{
    RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "3", ",", " ", "5"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"laserTracesPanel", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomFunction", "[", 
           RowBox[{
            RowBox[{"laserField", " ", "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[Omega]", " ", "->", " ", "1"}], ",", " ", 
               RowBox[{"\[Kappa]", " ", "->", " ", "k"}]}], "}"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.", ",", " ", "30.", ",", " ", "0.02"}], "}"}], ",", 
            " ", "3"}], "]"}], "[", "\"\<Paths\>\"", "]"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}], " ", 
             "&"}], " ", "/@", " ", "laserRunColors"}], ")"}]}]}], "]"}], ",",
        "\n", "     ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"laserMeanField", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Omega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Kappa]", " ", "->", " ", "k"}]}], "}"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "30"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", " ", 
            RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}]}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Omega] t\>\"", ",", " ", "\"\<E(t)\>\""}], "}"}]}], ",",
        " ", 
       RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"laserRunColors", ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{"Red", ",", " ", 
             RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}]}], "]"}],
          ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<run 1\>\"", ",", " ", "\"\<run 2\>\"", ",", 
           " ", "\"\<run 3\>\"", ",", " ", "\"\<exact \:27e8E(t)\:27e9\>\""}],
           "}"}], ",", " ", 
         RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
        " ", "Below"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"laserCorrelationPanel", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"laserCorrelation", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Omega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Kappa]", " ", "->", " ", "k"}], ",", " ", 
             RowBox[{"t", " ", "->", " ", 
              RowBox[{"#", "/", "k"}]}]}], "}"}]}], " ", "&"}], " ", "/@", 
         " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0.25", ",", " ", "2"}], "}"}]}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", " ", "0", ",", " ", "20"}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "laserTimeColors"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Omega] \[Tau]\>\"", ",", 
          " ", "\"\<\:27e8E(t) E(t+\[Tau])\:27e9\>\""}], "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{"laserTimeColors", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Kappa] t = \>\"", ",", " ", "#"}], "}"}], "]"}], 
           " ", "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0.25", ",", " ", "2"}], "}"}]}], ",", " ", 
         
         RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
        " ", "Below"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"laserPanels", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "4", "]"}], ";", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"laserTracesPanel", "[", "#", "]"}], ",", " ", 
          RowBox[{"laserCorrelationPanel", "[", "#", "]"}]}], "}"}], " ", 
        "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.02", ",", " ", "0.1", ",", " ", "0.5"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"laserPanels", "[", "laserK", "]"}], "}"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Top"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "3"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "laserK", ",", " ", "0.1", ",", " ", "\"\<\[Kappa]/\[Omega]\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"Keys", "[", "laserPanels", "]"}], ",", " ", "SetterBar"}], 
    "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[30]:= ",
 CellID->955427842,ExpressionUUID->"75b5f335-6bf1-1026-28f2-6b9d5c7f1bcf"],

Cell[TextData[{
 "The mean field oscillates at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69c71814-c88a-0db7-5221-6ec924770bde"],
 " and decays as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Kappa]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1da6dd52-6ffd-9589-184a-79fed0615aee"],
 ", although no trace loses amplitude: the decay is the spread of phases \
among runs. The correlation has a part that depends only on the lag ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b940fa3-310b-70cc-315c-6d82b09ce014"],
 " and a part that depends on ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71b7a516-c8d7-3d64-6827-4f0170879438"],
 " itself, because every run starts from the same phase. That second part \
dies on the time scale ",
 Cell[BoxData[
  RowBox[{"1", "/", "4", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "245c9ca0-15b4-dfa9-2e24-a3a87d38b71a"],
 ", and by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], 
   StyleBox["t", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3174c1bd-9440-44f1-1ec4-6cb02f878105"],
 " only the stationary ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], 
     StyleBox["\[Tau]", "TI"]}]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["\[Tau]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08ddd2c0-9455-b82c-4745-5fe5408c49b7"],
 " is left."
}], "Text",
 CellID->1923688675,ExpressionUUID->"4f3e7b29-9b23-a7cc-1803-aa5d7739d922"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->803646002,ExpressionUUID->"53ca4e59-6971-cbf8-5a69-c8fd719a4a1c"],

Cell["When the readout record fixes the population", "Subsection",
 CellID->851713092,ExpressionUUID->"5a26e262-e50f-4290-0a3f-ba9132a50aa3"],

Cell[TextData[{
 "A qubit, Rabi-driven at frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75ec83bc-3ef2-0738-36c3-9b843f13c9ce"],
 " and relaxing toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e6c9ea6-6148-fd71-3229-523568356f28"],
 " at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6feefdb0-bf50-68ec-0b06-e38646a29e35"],
 ", is read out along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6208d1-5f14-a71e-1fff-e929883c7ea9"],
 "; the detector dephases it at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28ed1164-4d01-66c8-0fca-88aa1bc0b911"],
 ", its noise moves ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52b6f718-fa58-c736-576e-6bc41f4a0bc2"],
 " at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46bc5e5a-cdac-2dbf-2ec3-45d0c780f745"],
 " and the phase at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "623b7baa-a6c8-9cd2-52b7-de8603c26340"],
 ", and ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03846a07-774b-d66f-7bfe-0fdabc31ff7a"],
 " is the integrated readout. Is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", "(", 
   RowBox[{
    StyleBox["arctanh",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["z", "TI"], "0"], "+", 
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
    StyleBox["Q", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fe54be4-6024-ba9d-407b-79440fbced0b"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", 
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fcb353e-2c94-6b21-76b2-de46c1850397"],
 ", on every run?"
}], "Text",
 CellID->1123629898,ExpressionUUID->"4336865d-3f75-979d-3152-c90195de083e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073a0b85-d735-d0a5-08a9-714775347953"],
 ", the population and the readout obey the It\[OHat] equations, driven by \
one Wiener noise ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "430848f2-c47e-ef58-61af-7941fa041ca5"],
 ","
}], "Text",
 CellID->1292170366,ExpressionUUID->"1c9a4b0a-f6a0-69f4-312d-8f06db839705"],

Cell[BoxData[
 PaneBox[GridBox[{
    {
     StyleBox[
      RowBox[{"d", "z"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], "1"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         StyleBox["z", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1], "+", "\[CapitalOmega]", 
        StyleBox["y", "TI"]}], "]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "+", 
       SqrtBox[
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["z", "TI"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]},
    {
     StyleBox[
      RowBox[{"d", "Q"}], "TI"], 
     RowBox[{"=", 
      RowBox[{
       SqrtBox[
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
       StyleBox["z", "TI"], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "+", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]}
   },
   GridBoxAlignment->{"Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->731300649,ExpressionUUID->"10b345c9-63fe-b5ec-1467-ada6ba19e73f"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54be2797-2fac-dc1f-532e-139a3e8ca6e6"],
 ", ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "074fd599-1b18-69c6-6429-b80672ece9a7"],
 " follow the Bloch equations. The It\[OHat] derivative of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctanh",
    FontSlant->"Plain"], 
   StyleBox["z", "TI"], "-", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3950aacd-1890-45a1-05b5-38079f3c22d6"],
 ", for general rates, is:"
}], "Text",
 CellID->2046071762,ExpressionUUID->"0e862605-ab14-138a-2404-f7a3552bd844"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"readoutV0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.8", ",", " ", "0", ",", " ", 
     RowBox[{"-", "0.6"}], ",", " ", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readoutIto", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
             "\[CapitalGamma]d"}], ")"}]}], " ", 
          RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
              "\[CapitalGamma]d"}], ")"}]}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"z", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
          RowBox[{"z", "[", "t", "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"x", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"y", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"y", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"x", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], ")"}]}], "}"}], ",",
          " ", 
         RowBox[{"{", "1", "}"}]}], "}"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}], ",",
        " ", "readoutV0"}], "}"}], ",", " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readoutStrat", " ", "=", " ", 
   RowBox[{"StratonovichProcess", "[", "readoutIto", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readoutGap", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"readoutIto", "[", 
      RowBox[{"\"\<Derivative\>\"", ",", " ", 
       RowBox[{
        RowBox[{"ArcTanh", "[", 
         RowBox[{"z", "[", "t", "]"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
         RowBox[{"q", "[", "t", "]"}]}]}]}], "]"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], " ", "->", " ", "x"}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "t", "]"}], " ", "->", " ", "y"}], ",", " ", 
       RowBox[{
        RowBox[{"z", "[", "t", "]"}], " ", "->", " ", "z"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<d(arctanh z \[Minus] \>\"", ",", " ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<CI\>\""}], "]"}], 
      "]"}], "]"}], ",", " ", "\"\< Q) = (\>\"", ",", "\n", "   ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"readoutGap", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]1", ",", " ", "\[CapitalOmega]"}], "}"}], ",", " ", 
        "Simplify"}], "]"}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Gamma]1", " ", "->", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}]}], ",", " ", 
        RowBox[{"\[CapitalGamma]d", " ", "->", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
          "]"}]}]}], "}"}]}], "]"}], ",", " ", "\"\<) dt + \>\"", ",", "\n", 
    "   ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"readoutGap", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", 
    " ", "\"\< dW\>\""}], "}"}], "]"}]}], "Input",
 CellLabel->"In[31]:= ",
 CellID->1072860934,ExpressionUUID->"2c75dc21-8783-6abc-5e80-8589c186f031"],

Cell[TextData[{
 "Integration along a smooth path converges to the Stratonovich solution, so \
all four equations are put in Stratonovich form and integrated on one cubic \
interpolant of a sampled Wiener path, the same in every panel, from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.8", ",", "0", ",", 
    RowBox[{"-", "0.6"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae66ee5-b28f-06b9-0e3c-0ce1193ee975"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "=", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5557727d-83d7-b215-5d6b-395cd1b43a39"],
 ". Each panel compares ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211f0adf-bc81-6620-503b-d4342c697a69"],
 " with the formula built from the record; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e6d8b0c-fb37-6a6b-2d3c-cc0b547dcf6e"],
 ":"
}], "Text",
 CellID->534244854,ExpressionUUID->"1bc12475-8e7f-229e-282a-a80c728ee2c5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"smoothWiener", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subdivide", "[", 
           RowBox[{"0.", ",", " ", "4.", ",", " ", "400"}], "]"}], ",", "\n", 
          "      ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Accumulate", "[", 
             RowBox[{"RandomVariate", "[", 
              RowBox[{
               RowBox[{"NormalDistribution", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"Sqrt", "[", "0.01", "]"}]}], "]"}], ",", " ", 
               "400"}], "]"}], "]"}], ",", " ", "0."}], "]"}]}], "}"}], "]"}],
        ",", " ", 
       RowBox[{"InterpolationOrder", " ", "->", " ", "3"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelTanh", "[", 
    RowBox[{"\[CapitalOmega]v_", ",", " ", "g1_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rates", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalGamma]d", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\[CapitalGamma]CI", " ", "->", " ", "0.5"}], ",", " ", 
         RowBox[{"\[CapitalGamma]BA", " ", "->", " ", "0.5"}], ",", " ", 
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "\[CapitalOmega]v"}], ",",
          " ", 
         RowBox[{"\[Gamma]1", " ", "->", " ", "g1"}]}], "}"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", " ", "=", " ", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", "[", "t", "]"}], ",", " ", 
                   RowBox[{"y", "[", "t", "]"}], ",", " ", 
                   RowBox[{"z", "[", "t", "]"}], ",", " ", 
                   RowBox[{"q", "[", "t", "]"}]}], "}"}], ",", " ", "t"}], 
                "]"}], " ", "==", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"readoutStrat", "[", "\"\<Drift\>\"", "]"}], " ", "+",
                   " ", 
                  RowBox[{
                   RowBox[{"Flatten", "[", 
                    RowBox[{"readoutStrat", "[", "\"\<Diffusion\>\"", "]"}], 
                    "]"}], " ", 
                   RowBox[{
                    RowBox[{"smoothWiener", "'"}], "[", "t", "]"}]}]}], " ", "/.",
                  " ", "rates"}], ")"}]}], "]"}], ",", "\n", "        ", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", "[", "0", "]"}], ",", " ", 
                 RowBox[{"y", "[", "0", "]"}], ",", " ", 
                 RowBox[{"z", "[", "0", "]"}], ",", " ", 
                 RowBox[{"q", "[", "0", "]"}]}], "}"}], " ", "==", " ", 
               "readoutV0"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"z", ",", " ", "q"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
           RowBox[{"MaxStepSize", " ", "->", " ", "0.0025"}]}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"sol", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", "s", "]"}], ",", " ", 
             RowBox[{"Tanh", "[", 
              RowBox[{
               RowBox[{"ArcTanh", "[", 
                RowBox[{"readoutV0", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
                RowBox[{
                 RowBox[{"sol", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", "s", "]"}]}]}], 
              "]"}]}], "}"}], " ", "/.", " ", "rates"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", "\n", "     ", 
         
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
                "]"}], ",", " ", "\"\< t\>\""}], "}"}], "]"}], ",", 
            " ", "\"\<z\>\""}], "}"}]}], ",", "\n", "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[CapitalOmega]/\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
              "]"}], ",", " ", "\"\< = \>\"", ",", " ", "\[CapitalOmega]v", ",",
              " ", "\"\<,   \>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}], ",", 
             " ", "\"\</\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
              "]"}], ",", " ", "\"\< = \>\"", ",", " ", "g1"}], "}"}], 
           "]"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Outer", "[", 
      RowBox[{"panelTanh", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.5"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "500"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"LineLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", " ", 
           "Dashed"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"\"\<z(t)\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<tanh(arctanh \>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<z\>\"", ",", " ", "\"\<0\>\""}], "]"}], ",", 
            " ", "\"\< + \>\"", ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<CI\>\""}], 
              "]"}], "]"}], ",", " ", "\"\< Q(t))\>\""}], "}"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"LegendLayout", " ", "->", " ", "\"\<Column\>\""}]}], "]"}], ",",
      " ", "Right"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[32]:= ",
 CellID->1532461231,ExpressionUUID->"4e6d54ed-7a28-0108-1dbf-519f241a9828"],

Cell[TextData[{
 "The noise term is zero for every rate, and the drift vanishes when ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2137381f-226b-5630-115d-bc9989515be8"],
 ": then the record alone fixes ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "512cf7dc-6450-aefd-5839-760486faac0e"],
 " on every run, and the two curves coincide. A drive or relaxation moves ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5767b5a5-32cb-eb5f-0c92-09d067598a54"],
 " without writing it into the record, and the curves part."
}], "Text",
 CellID->1120240858,ExpressionUUID->"2d442c41-7845-b1b3-0c42-a970bad99861"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->429364482,ExpressionUUID->"40d09b50-4285-7002-15ba-d663926833f5"],

Cell[TextData[{
 "Quantum Bayesian update: each reading divides the mixedness by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["w", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c11a40c-0a88-137b-213f-8376a62c2ad6"]
}], "Subsection",
 CellID->1458976185,ExpressionUUID->"004af0ec-8a8c-8d93-623c-d00cc65b387e"],

Cell[TextData[{
 "A detector reads a Pauli observable ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["A", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647b8cf6-4038-cd76-342b-c9c3a174082d"],
 " of a qubit over a short window and returns a noisy reading ",
 Cell[BoxData[
  StyleBox["I", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf535e1-e485-5951-729a-17d1094ded41"],
 ". Two detectors take turns, one reading ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e1b2e0e-270d-556e-67b1-26de8d6269c4"],
 " and one reading ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "\[CurlyTheta]"], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyTheta]", "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyTheta]", "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58431410-235f-2e7c-1398-aa00a0dfcf0e"],
 ". How does the mixedness ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02e3c9b0-f3b8-0005-2ff3-f3b196b3a10e"],
 " of the state change with each reading?"
}], "Text",
 CellID->878774297,ExpressionUUID->"3c6bc264-4e84-373f-3264-d02b2e21634f"],

Cell["\<\
Each reading updates the state by Bayes' rule, written as a Kraus operator \
(Korotkov):\
\>", "Text",
 CellID->1418402956,ExpressionUUID->"5c99831d-0fd9-265b-3904-bc42a4c4a1c0"],

