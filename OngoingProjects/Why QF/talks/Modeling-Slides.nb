Cell["Mollow triplet and squeezed resonance fluorescence", "Subsection",
 CellID->540230488,ExpressionUUID->"19f00f60-745c-592c-2e93-3831e9bb34f7"],

Cell[TextData[{
 "A two-level atom, frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28eaa47d-6e68-975b-3048-86a975e28f0d"],
 ", decays at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a56ee2a-5732-bd53-0496-e88775cd6eac"],
 " and is driven by a laser at frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75f2c7eb-c400-c9c8-254c-1f990ab26b89"],
 " with Rabi frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c5260f9-4bf4-48fb-26ff-eeb2d7706f9d"],
 ". Does the scattered light carry only the Mollow triplet a spectrometer \
sees, or is one of its quadratures squeezed below shot noise?"
}], "Text",
 CellID->2106617707,ExpressionUUID->"518d00c9-a009-47c9-1646-3f9163636b95"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f487097-51d4-5cbb-5b99-0f957d7c13c1"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75f1ff15-bfa3-6e4c-3b7d-9f7b27b378fa"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1758d342-9662-37ee-2b98-3f5c5313663a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22ffd434-118a-af1a-4acb-69b4f38fa947"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["a", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["L", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15f80b96-7ed7-8643-65d3-a42a3b4ab316"],
 ", the Hamiltonian in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "437e6475-3e3e-a866-5d64-0b126ba79604"],
 " (rotating-wave approximation) is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39a9f652-79b4-ba93-5948-04ccb7905204"],
 ", and"
}], "Text",
 CellID->1620417510,ExpressionUUID->"1f48d68b-527c-64d8-00cf-172e36605814"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->724417869,ExpressionUUID->"51ad84e8-c192-e61b-2e8a-8920fc408ca3"],

Cell[TextData[{
 "By the quantum regression theorem, two-time correlations evolve with the \
same ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f577d8e-9969-8d1d-4959-51e3b361ad02"],
 " from the steady state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"s", "s"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d07e210-61d0-aa2d-2ace-e14bc26c4381"],
 ", so at frequency ",
 Cell[BoxData[
  StyleBox["\[Nu]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "496a0896-4910-8cf0-2894-7c64cfff9ac9"],
 " from the laser the incoherent fluorescence spectrum and the homodyne \
spectrum of the quadrature ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "+", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f7bfbbc-6bf5-9234-13ec-8004e4d3bdcc"],
 " of the emitted field ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "^"], "=", "-", 
   StyleBox["i", "TI"], 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ddf2f94-bdc0-b503-75d0-42df4cc31a36"],
 " (out of phase with the drive), normalized to shot noise, are"
}], "Text",
 CellID->1160720061,ExpressionUUID->"4e081f22-97ce-6f06-13c7-60d06891485a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["S", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Nu]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", "2", "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["Tr",
     FontSlant->"Plain"], "\[NegativeThinSpace]", "[", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "+"], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["\[Nu]", "TI"], "-", "\[ScriptCapitalL]"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{"-", "1"}]], 
     StyleBox["\[Delta]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "-"], 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"s", "s"}], "TI"]]}], "]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["x", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Nu]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"1", "+", 
     RowBox[{"2", "\[ThinSpace]", 
      StyleBox["Re",
       FontSlant->"Plain"], "\[ThinSpace]", 
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], "\[NegativeThinSpace]", "[", 
       RowBox[{
        OverscriptBox[
         StyleBox["x", "TI"], "^"], "\[ThinSpace]", 
        SuperscriptBox[
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["\[Nu]", "TI"], "-", "\[ScriptCapitalL]"}], 
          StyleBox[")",
           SpanMaxSize->1]}], 
         RowBox[{"-", "1"}]], "(", 
        RowBox[{
         OverscriptBox[
          StyleBox["c", "TI"], "^"], 
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          StyleBox[
           RowBox[{"s", "s"}], "TI"]], "+", 
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          StyleBox[
           RowBox[{"s", "s"}], "TI"]], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["c", "TI"], "^"], "\[Dagger]"], "-", 
         StyleBox["\[LeftAngleBracket]",
          SpanMaxSize->1], 
         OverscriptBox[
          StyleBox["x", "TI"], "^"], 
         StyleBox["\[RightAngleBracket]",
          SpanMaxSize->1], 
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], 
          StyleBox[
           RowBox[{"s", "s"}], "TI"]]}], ")"}], "]"}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1120081650,ExpressionUUID->"0284121f-1f42-be10-5514-0deef4817ef3"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], "-", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee7c61f-7bfc-c570-78e5-877c66016723"],
 "."
}], "Text",
 CellID->434933389,ExpressionUUID->"141e9c46-8205-73db-7cd7-ef5d449ba8a8"],

Cell[TextData[{
 "The null vector of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c51f242-6454-8036-04df-f3c0b9087725"],
 ", for general ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70ba62d3-2be1-25e0-5b15-f6fb466822b9"],
 " and ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26047790-6a10-b024-4f98-c93deca91194"],
 ", gives ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"s", "s"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "656dbe62-248b-1243-4d50-46ff6ddd14f7"],
 ", and inverting ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   StyleBox["\[Nu]", "TI"], "-", "\[ScriptCapitalL]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61367e13-ad99-4610-0b2e-daee97f24e75"],
 " in closed form gives both spectra; each fluorescence spectrum is scaled to \
its own maximum, and rates are in units of ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff378d7-ebe8-6834-65ea-b4a3521b448b"],
 ":"
}], "Text",
 CellID->1366089870,ExpressionUUID->"3aa409f8-afdd-03f6-43ca-40ca02b1d367"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"liouA6", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Liouvillian\>\"", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], "}"}], ",", " ", 
        
        RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"smA6", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], "[", "\"\<Matrix\>\"",
      "]"}], "]"}]}], ";", " ", 
  RowBox[{"cA6", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", "smA6"}]}], ";", " ", 
  RowBox[{"xA6", " ", "=", " ", 
   RowBox[{"cA6", " ", "+", " ", 
    RowBox[{"ConjugateTranspose", "[", "cA6", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ssA6", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "/", 
      RowBox[{"Tr", "[", "#", "]"}]}], " ", "&"}], "[", 
    RowBox[{"ArrayReshape", "[", 
     RowBox[{
      RowBox[{"First", "[", 
       RowBox[{"NullSpace", "[", "liouA6", "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spectrumA6", "[", 
    RowBox[{"seed_", ",", " ", "readout_"}], "]"}], " ", ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Re", " ", "@", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{"readout", " ", ".", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"LinearSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"I", " ", "\[Nu]", " ", 
             RowBox[{"IdentityMatrix", "[", "4", "]"}]}], " ", "-", " ", 
            "liouA6"}], ",", " ", 
           RowBox[{"Flatten", "[", "seed", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fluorA6", " ", "=", " ", 
   RowBox[{"spectrumA6", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"smA6", " ", "-", " ", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"smA6", " ", ".", " ", "ssA6"}], "]"}], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ")"}], " ", ".", " ", 
      "ssA6"}], ",", " ", 
     RowBox[{"ConjugateTranspose", "[", "smA6", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quadA6", " ", "=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{"spectrumA6", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cA6", " ", ".", " ", "ssA6"}], " ", "+", " ", 
       RowBox[{"ssA6", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "cA6", "]"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"xA6", " ", ".", " ", "ssA6"}], "]"}], " ", "ssA6"}]}], ",", 
      " ", "xA6"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalOmega]sA6", ",", " ", "\[CapitalDelta]sA6"}], "}"}], 
   " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.3", ",", " ", "1", ",", " ", "5"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"curveA6", "[", 
    RowBox[{
    "1", ",", " ", "\[CapitalOmega]v_", ",", " ", "\[CapitalDelta]v_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"fluorA6", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", " ", "->", " ", "\[CapitalOmega]v"}], ",",
           " ", 
          RowBox[{"\[CapitalDelta]", " ", "->", " ", "\[CapitalDelta]v"}]}], 
         "}"}]}]}], "}"}], ",", " ", 
     RowBox[{"f", "/", 
      RowBox[{"Max", "[", 
       RowBox[{"Table", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Nu]", ",", " ", 
           RowBox[{"-", "8."}], ",", " ", "8.", ",", " ", "0.02"}], "}"}]}], 
        "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"curveA6", "[", 
    RowBox[{
    "2", ",", " ", "\[CapitalOmega]v_", ",", " ", "\[CapitalDelta]v_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"quadA6", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", " ", "->", " ", "\[CapitalOmega]v"}], ",", 
      " ", 
      RowBox[{"\[CapitalDelta]", " ", "->", " ", "\[CapitalDelta]v"}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelA6", "[", 
    RowBox[{"row_", ",", " ", "\[CapitalOmega]v_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"curveA6", "[", 
         RowBox[{"row", ",", " ", "\[CapitalOmega]v", ",", " ", "#"}], "]"}], 
        " ", "&"}], " ", "/@", " ", "\[CapitalDelta]sA6"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Nu]", ",", " ", 
       RowBox[{"-", "8"}], ",", " ", "8"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[CapitalDelta]/\[Gamma] = \>\"", ",", " ", "#"}], 
           "}"}], "]"}], " ", "&"}], " ", "/@", " ", "\[CapitalDelta]sA6"}], 
       ")"}]}], ",", "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"row", " ", "==", " ", "2"}], ",", " ", 
          RowBox[{"{", "1", "}"}], ",", " ", "None"}], "]"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Nu]/\[Gamma]\>\"", ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<S(\[Nu])/max\>\"", ",", " ", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<S\>\"", ",", " ", "\"\<x\>\""}], "]"}], ",", 
              " ", "\"\<(\[Nu])\>\""}], "}"}], "]"}]}], "}"}], "[", 
         RowBox[{"[", "row", "]"}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsA6", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"\[CapitalOmega]v", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"panelA6", "[", 
          RowBox[{"#", ",", " ", "\[CapitalOmega]v"}], "]"}], " ", "&"}], " ",
         "/@", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "]"}], ",", " ", 
     "\[CapitalOmega]sA6"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{"First", " ", "/@", " ", 
        RowBox[{"panelsA6", "[", "w", "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", 
        RowBox[{"panelsA6", "[", "w", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "w", ",", " ", "0.3", ",", " ", "\"\<\[CapitalOmega]/\[Gamma]\>\""}], 
      "}"}], ",", " ", "\[CapitalOmega]sA6", ",", " ", "SetterBar"}], "}"}], ",",
    " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[9]:= ",
 CellID->746866756,ExpressionUUID->"4f96e29f-be41-62ec-62ba-894ec4dbaeae"],

Cell[TextData[{
 "At weak resonant driving the incoherent light is a single line at the laser \
frequency; at ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "/", 
   StyleBox["\[Gamma]", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01cde54c-ff7b-b7a4-3986-d56bc7088464"],
 " it splits into the Mollow triplet, whose sidebands detuning pushes further \
out, and with detuning even weak driving moves the light into sidebands near ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12963c46-8dd7-d009-5ad0-950f7d83d7bf"],
 ". At weak resonant driving the out-of-phase quadrature dips below shot \
noise around ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Nu]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6ca0c2-e870-8b29-54bb-6ab5d4d67817"],
 ": a single atom emits squeezed light. Stronger driving or detuning lifts it \
back above shot noise there."
}], "Text",
 CellID->1224287971,ExpressionUUID->"5de37e8e-5b1a-4a28-2413-8901d2664888"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->601390417,ExpressionUUID->"2cb7979e-0888-9d54-5095-4dab1459da2c"],

Cell["\<\
A qutrit Wigner function under dephasing: does the negativity die at an exact \
time?\
\>", "Subsection",
 CellID->809048352,ExpressionUUID->"5f1d34c2-b251-a750-5ef8-862d95de6ed8"],

Cell[TextData[{
 "A qutrit state can be written as a discrete Wigner function, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["q", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "3"], 
   StyleBox["Tr",
    FontSlant->"Plain"], "[", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["A", "TI"], "^"], 
     RowBox[{
      StyleBox["q", "TI"], ",", 
      StyleBox["p", "TI"]}]]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fcca72b-df26-8664-528c-6d6bf9e331c6"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["A", "TI"], "^"], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["p", "TI"]}]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["D", "TI"], "^"], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["p", "TI"]}]], 
   OverscriptBox[
    StyleBox["P", "TI"], "^"], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["D", "TI"], "^"], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["p", "TI"]}], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c56d238-b0cc-2596-3f5a-519a1fe990c9"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["D", "TI"], "^"], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["p", "TI"]}]], "=", 
   SuperscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["q", "TI"]], 
   SuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c826ec-96e7-6112-21f5-7e6f4f671de4"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["P", "TI"], "^"], 
    TemplateBox[{
      StyleBox["j", "TI"]},
     "Ket"]}], "=", 
   TemplateBox[{
     RowBox[{"-", 
       StyleBox["j", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fb9b61-c0dc-bc9e-2987-0efe1f5153d1"],
 ": nine real numbers on a ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3222a5a0-f44b-82b2-4f71-3048b20e6207"],
 " phase-space grid that sum to one, whose negative entries make it a \
quasi-probability rather than a probability. A qutrit with degenerate levels, \
so no Hamiltonian, is dephased at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3de05b27-fe84-b21d-2c28-e1832fa873d4"],
 ". Does every negative entry reach zero at a finite time?"
}], "Text",
 CellID->1424578159,ExpressionUUID->"2f685399-ce3a-5099-7459-2e49e1835e0c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["X", "TI"], 
    TemplateBox[{
      StyleBox["j", "TI"]},
     "Ket"]}], "=", 
   TemplateBox[{
     RowBox[{
       StyleBox["j", "TI"], "+", "1"}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f52524d-2521-b420-3c6e-13f3f3d22636"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Z", "TI"], 
    TemplateBox[{
      StyleBox["j", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", "2", "\[Pi]", 
      StyleBox["i", "TI"], 
      StyleBox["j", "TI"], "/", "3"}]], 
    TemplateBox[{
      StyleBox["j", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e3f236f-f0eb-6066-59cd-9b1e86fbfc3e"],
 " (indices mod 3), the dephasing has jump operators ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eaf81e2-cbea-bf9f-5223-c4be38c50738"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["Z", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b8e9e1f-d9f2-a8bf-51db-0c193db45825"],
 ","
}], "Text",
 CellID->1939109630,ExpressionUUID->"2a372683-304d-edf6-6fd9-951bcbf84a45"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", 
    FractionBox[
     StyleBox["\[Gamma]", "TI"], "3"], "(", 
    RowBox[{"\|01d49f", 
     StyleBox["[",
      SpanMaxSize->1], 
     StyleBox["Z", "TI"], 
     StyleBox["]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"], "+", "\|01d49f", 
     StyleBox["[",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["Z", "TI"], "2"], 
     StyleBox["]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2057835071,ExpressionUUID->"3a70221c-142f-b720-025a-5b9981e65bf4"],

Cell[TextData[{
 "which keeps the populations ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"j", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "222c30f1-4d93-dee6-7e1d-ccdeb0c37821"],
 " and damps every coherence ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"j", "k"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb6e1fe-5693-f6ab-5936-9bd806b33585"],
 " as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d7a007e-11ba-e2cb-5c39-a2a85b5bd14c"],
 ", so each entry of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c4e45e8-1279-8b68-50b0-e1d2d6dae397"],
 " relaxes along one exponential toward ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], "\[Infinity]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30de7724-b0ac-db78-7d13-9c1ca5d18161"],
 ", the Wigner function of the populations alone:"
}], "Text",
 CellID->1757108918,ExpressionUUID->"5d882081-235b-2a01-2e3b-47438ecaf04d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["t", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Infinity]"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["q", "TI"], ",", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
