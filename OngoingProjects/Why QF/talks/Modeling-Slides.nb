Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"measuredQubitSME", "[", 
    RowBox[{"k_", ",", " ", "\[Eta]_", ",", " ", "\[CapitalDelta]_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "k", " ", 
           RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"\[CapitalDelta]", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[CapitalDelta]", " ", 
           RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"2", " ", "k", " ", 
           RowBox[{"y", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"z", "[", "t", "]"}]}], ",", " ", 
         RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[Eta]", " ", "k"}], "]"}], " ", 
           RowBox[{"x", "[", "t", "]"}], " ", 
           RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[Eta]", " ", "k"}], "]"}], " ", 
           RowBox[{"y", "[", "t", "]"}], " ", 
           RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[Eta]", " ", "k"}], "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], ")"}]}], "}"}]}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"measuredQubitAverage", "[", 
    RowBox[{"k_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Re", " ", "@", " ", 
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumEvolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
            RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", 
           " ", 
           RowBox[{
            RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "/", "2"}]}], 
          ",", "\n", "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "}"}], " ", "->",
            " ", 
           RowBox[{"{", "k", "}"}]}], ",", " ", 
          RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "30"}], "}"}]}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", ".", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"measuredQubitPanel", "[", 
    RowBox[{"k_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Eta]_", ",", " ", "\[CapitalDelta]_"}], "}"}]}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{";;", " ", ";;", " ", 
            RowBox[{"Round", "[", 
             RowBox[{"0.01", "/", 
              RowBox[{"Min", "[", 
               RowBox[{"0.01", ",", " ", 
                RowBox[{"0.005", "/", "k"}]}], "]"}]}], "]"}]}], "]"}], "]"}],
          " ", "&"}], " ", "/@", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomFunction", "[", 
           RowBox[{
            RowBox[{"measuredQubitSME", "[", 
             RowBox[{"k", ",", " ", "\[Eta]", ",", " ", "\[CapitalDelta]"}], 
             "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.", ",", " ", "30.", ",", " ", 
              RowBox[{"Min", "[", 
               RowBox[{"0.01", ",", " ", 
                RowBox[{"0.005", "/", "k"}]}], "]"}]}], "}"}], ",", " ", "3", 
            ",", " ", 
            RowBox[{
            "Method", " ", "->", 
             " ", "\"\<StochasticRungeKuttaScalarNoise\>\""}]}], "]"}], "[", 
          RowBox[{"\"\<PathComponent\>\"", ",", " ", "3"}], "]"}], 
         "[", "\"\<Paths\>\"", "]"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"measuredQubitAverage", "[", 
         RowBox[{"k", ",", " ", "\[CapitalDelta]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "30"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalOmega] t\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<z\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}]}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"Inset", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]"}], "}"}], "]"}], ",",
         " ", 
        RowBox[{"Scaled", "[", 
         RowBox[{"{", 
          RowBox[{"0.96", ",", " ", "0.96"}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"measuredQubitPanels", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"kd", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"measuredQubitPanel", "[", 
            RowBox[{
             RowBox[{"First", "[", "kd", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"#", ",", " ", 
               RowBox[{"Last", "[", "kd", "]"}]}], "}"}]}], "]"}], " ", "&"}],
           " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"0.3", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "0.1", ",", " ", "0.5", ",", " ", "1", ",", " ", "5", ",", " ", 
            "10"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0.5", ",", " ", "1", ",", " ", "2"}], 
           "}"}]}], "}"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"measuredQubitLesson", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
     "0.1", " ", "->", 
      " ", "\"\<Runs oscillate; the average decays only because they fall out \
of phase.\>\""}], ",", "\n", "   ", 
     RowBox[{
     "0.5", " ", "->", 
      " ", "\"\<Runs still oscillate, kicked irregularly by the \
record.\>\""}], ",", "\n", "   ", 
     RowBox[{
     "1", " ", "->", 
      " ", "\"\<Crossover: oscillation stops and runs linger near the \
poles.\>\""}], ",", "\n", "   ", 
     RowBox[{
     "5", " ", "->", 
      " ", "\"\<Zeno: runs stick at a pole and jump; the average only decays.\
\>\""}], ",", "\n", "   ", 
     RowBox[{
     "10", " ", "->", " ", "\"\<Stronger watching, rarer jumps.\>\""}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"measuredQubitPanels", "[", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "d"}], "}"}], "]"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<run 1\>\"", ",", " ", "\"\<run 2\>\"", ",", 
           " ", "\"\<run 3\>\"", ",", " ", "\"\<Lindblad average\>\""}], 
          "}"}], ",", " ", 
         RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
        " ", "Below"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Control", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "k", ",", " ", "0.1", ",", 
              " ", "\"\<measurement strength k/\[CapitalOmega]\>\""}], "}"}], 
            ",", " ", 
            RowBox[{"{", 
             RowBox[{
             "0.1", ",", " ", "0.5", ",", " ", "1", ",", " ", "5", ",", " ", 
              "10"}], "}"}], ",", " ", "SetterBar"}], "}"}], "]"}], ",", " ", 
         
         RowBox[{"Control", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "d", ",", " ", "0", ",", 
              " ", "\"\<detuning \[CapitalDelta]/\[CapitalOmega]\>\""}], 
             "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0.5", ",", " ", "1", ",", " ", "2"}], 
             "}"}], ",", " ", "SetterBar"}], "}"}], "]"}]}], "}"}], "]"}], ",",
       "\n", "    ", 
      RowBox[{"Spacer", "[", "20", "]"}], ",", " ", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<k/\[CapitalOmega] = \>\"", ",", " ", "k"}], 
                 "}"}], "]"}], ",", " ", "Bold", ",", " ", "12"}], "]"}], ",",
              " ", 
             RowBox[{"measuredQubitLesson", "[", "k", "]"}]}], "}"}], ",", 
           "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<\[Eta] < 1\>\"", ",", " ", "Bold", ",", " ", 
               "12"}], "]"}], ",", 
             " ", "\"\<Runs stay mixed and miss the poles.\>\""}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<\[CapitalDelta] \[NotEqual] 0\>\"", ",", " ", 
               "Bold", ",", " ", "12"}], "]"}], ",", 
             " ", "\"\<Weak watching only: smaller swing, slow drift between \
poles.\>\""}], "}"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"Alignment", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Left", ",", " ", "Top"}], "}"}]}], ",", " ", 
         RowBox[{"ItemSize", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "44"}], "}"}], "}"}]}], ",", " ", 
         RowBox[{"Spacings", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0.6"}], "}"}]}], ",", " ", 
         RowBox[{"BaseStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"12", ",", " ", 
            RowBox[{"LineIndent", " ", "->", " ", "0"}]}], "}"}]}]}], "]"}], 
       "]"}]}], "}"}], "]"}], ",", "\n", "  ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[22]:= ",
 CellID->691814770,ExpressionUUID->"7bbfb202-9a1b-2e3a-7530-16bcd38dbec2"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", "\[CapitalOmega]", "=", "0.1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "632df605-83b2-7a66-5db3-ab2404fe4e6c"],
 " the runs keep Rabi-oscillating. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", "\[CapitalOmega]", "=", "10"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6dd747-ec7b-42b0-5e59-884f9a4f7b8e"],
 " they stay pinned near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "117890ac-7e81-f8e0-6cac-5029b0f1500a"],
 ", with brief spikes that fall back and now and then a full jump to the \
other pole: that is the quantum Zeno effect, which the average shows only as \
a slow decay. A detector that catches less of the signal leaves each run \
mixed, so under weak measurement its oscillation no longer reaches the poles. \
Detuning shrinks the Rabi swing to a fast wiggle near the starting pole, and \
under weak watching the record then carries the runs slowly from pole to \
pole; once the measurement is much stronger than the detuning, the runs look \
as they do on resonance."
}], "Text",
 CellID->663911044,ExpressionUUID->"2aff0923-c543-e283-2574-5caeb24477bd"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2105419012,ExpressionUUID->"634666b5-aa35-0e93-35c8-b90137820dab"],

Cell["\<\
Measurement purifies a qubit: It\[OHat]'s lemma in spherical coordinates\
\>", "Subsection",
 CellID->1004868130,ExpressionUUID->"7017cea2-c71c-f10e-68e3-5efd2bf1740e"],

Cell[TextData[{
 "A qubit with Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb59c55-035b-3757-45bb-0d163617b790"],
 " is measured continuously along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dc5fe25-1d56-5c1f-2f4f-5a1900521586"],
 " at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4653a4ac-89b2-602c-0807-010af3cc2b58"],
 " by a detector of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "032f891d-a790-40c5-5d93-c59b7336eb78"],
 ". Along one run, does watching it purify its state, as measured by the \
length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ef9efaa-7ef4-b94c-461f-53f1616811ae"],
 " of its Bloch vector, and what does an imperfect detector take away?"
}], "Text",
 CellID->610416584,ExpressionUUID->"5c57258c-881e-e5b9-68f1-d927e9dfb00f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d054926-a139-baf6-33e5-622c16ec21c2"],
 ", the state conditioned on the record follows the It\[OHat] stochastic \
master equation of a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32540718-4dac-7cd0-27ee-f90460d4c283"],
 " measurement: ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "296c36b6-4aac-c5eb-64da-79d5c62dff37"],
 " rotates it, the term ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13fc65eb-1790-e38f-6d42-fbfc70719bc9"],
 " dephases it, and the record kicks it through ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox[
     RowBox[{"\[Eta]", "k"}], "TI"]], "(", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "-", "2", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ")", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7150f1ec-b389-80ba-2370-e0dc4eaf3d1f"],
 "."
}], "Text",
 CellID->2115927446,ExpressionUUID->"3381a6e8-7ace-acad-2236-9cb2ab5687e3"],

Cell[TextData[{
 "As an It\[OHat] process for the Bloch vector, It\[OHat]'s lemma for ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b24102b-0537-9a55-7a1b-54edec928b8d"],
 " in spherical coordinates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], ",", 
    StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4818e6fe-2e23-4d88-5d94-1c5060bfd9be"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   StyleBox["r", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e632397-d319-bb96-0bed-a55e00c143e1"],
 ", gives the stochastic equation for ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03415fb7-7402-1bef-3ac2-b044f6ad9d47"],
 ":"
}], "Text",
 CellID->753099453,ExpressionUUID->"422466c1-afcd-ea82-0237-1989e310e038"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"blochOfPurify", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"m", " ", ".", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"blochSME", "[", 
    RowBox[{
    "\[CapitalDelta]_", ",", " ", "\[CapitalOmega]_", ",", " ", "k_", ",", 
     " ", "\[Eta]_", ",", " ", "v0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]v", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], ",", " ", 
              RowBox[{"y", "[", "t", "]"}], ",", " ", 
              RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", ".", " ", 
            RowBox[{"PauliMatrix", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
          ")"}], "/", "2"}]}], ",", " ", 
       RowBox[{"hv", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
          RowBox[{"PauliMatrix", "[", "1", "]"}]}]}]}], ",", " ", 
       RowBox[{"sz", " ", "=", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ItoProcess", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"blochOfPurify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"hv", " ", ".", " ", "\[Rho]v"}], " ", "-", " ", 
              RowBox[{"\[Rho]v", " ", ".", " ", "hv"}]}], ")"}]}], " ", "+", 
           " ", 
           RowBox[{"k", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sz", " ", ".", " ", "\[Rho]v", " ", ".", " ", "sz"}], 
              " ", "-", " ", "\[Rho]v"}], ")"}]}]}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"blochOfPurify", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"\[Eta]", " ", "k"}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sz", " ", ".", " ", "\[Rho]v"}], " ", "+", " ", 
              RowBox[{"\[Rho]v", " ", ".", " ", "sz"}], " ", "-", " ", 
              RowBox[{"2", " ", 
               RowBox[{"z", "[", "t", "]"}], " ", "\[Rho]v"}]}], ")"}]}], 
           "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
         "v0"}], "}"}], ",", " ", "t"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"drSph", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"blochSME", "[", 
        RowBox[{
        "\[CapitalDelta]", ",", " ", "\[CapitalOmega]", ",", " ", "k", ",", 
         " ", "\[Eta]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "]"}], "[", 
       RowBox[{"\"\<Derivative\>\"", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], "]"}]}], "]"}], " ", "/.",
       "\n", "    ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", " ", 
          RowBox[{"y", "[", "t", "]"}], ",", " ", 
          RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", "->", " ", 
        RowBox[{"r", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], "]"}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "\[Pi]"}], " ", "&&",
       " ", 
      RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<=", " ", "\[Eta]", " ", "<=", " ", "1"}], " ", "&&",
       " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", " ", "\[CapitalOmega]"}], "}"}], " ", 
       "\[Element]", " ", "Reals"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<dr = \>\"", ",", " ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"drSph", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", 
    " ", "\"\< dt + \>\"", ",", " ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{
      RowBox[{"drSph", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], " ", "/.", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], " ", "+", " ", 
        RowBox[{"r", "^", "2"}]}], " ", "->", " ", 
       RowBox[{"-", 
        RowBox[{"HoldForm", "[", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"r", "^", "2"}]}], "]"}]}]}]}], "]"}], ",", 
    " ", "\"\< dW\>\""}], "}"}], "]"}]}], "Input",
 CellLabel->"In[23]:= ",
 CellID->1406782960,ExpressionUUID->"5c9369f8-6dc9-ea69-12cf-75d56093558b"],

Cell[TextData[{
 "For each detector efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c7717b9-284c-6ff6-1160-e7c84969f237"],
 ", three runs start from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.3", ",", "0", ",", "0.4"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fa11c8b-8970-8bb1-6afc-9370cfcd90ae"],
 " under a resonant drive of strength ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "/", 
   StyleBox["k", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f1fc9d8-458f-4d66-7fc7-aec81331d041"],
 ", ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fe79430-8325-5f5e-2f32-0f02959bbbeb"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "318d5170-623a-6d8f-6ef3-b383fc7903a9"],
 "; the dashed line marks ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d6ee5a4-13ea-a715-32c2-e41a1df2abeb"],
 ", where the drift changes sign, and time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b92d99d-1a87-3a62-52c9-20d7d8c4e4f3"],
 ":"
}], "Text",
 CellID->453656417,ExpressionUUID->"31552350-506c-ac81-258c-f306ef3ad12b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"panelPurify", "[", 
    RowBox[{"\[Eta]v_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[CapitalOmega]v_", ",", " ", "\[CapitalDelta]v_"}], "}"}], ",",
      " ", "label_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
       "\n", "     ", 
       RowBox[{
        RowBox[{"RandomFunction", "[", 
         RowBox[{
          RowBox[{"blochSME", "[", 
           RowBox[{
           "\[CapitalDelta]v", ",", " ", "\[CapitalOmega]v", ",", " ", "1", ",",
             " ", "\[Eta]v", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.3", ",", " ", "0", ",", " ", "0.4"}], "}"}]}], "]"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "4.", ",", " ", "0.001"}], "}"}], ",", " ",
           "3", ",", " ", 
          RowBox[{
          "Method", " ", "->", 
           " ", "\"\<StochasticRungeKuttaScalarNoise\>\""}]}], "]"}], 
        "[", "\"\<Paths\>\"", "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", " ", "Dashed"}], 
             "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"y", ",", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{
                RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", " ", "Dashed"}],
                "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"y", ",", " ", "0.2", ",", " ", "1", ",", " ", "0.2"}], 
             "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Eta]v", "]"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed", ",", " ", 
              RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], 
           "}"}]}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k t\>\"", ",", " ", "\"\<r\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "label"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"purifyDrives", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", 
       " ", "\"\<\[CapitalOmega]/k = 0\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", 
       " ", "\"\<\[CapitalOmega]/k = 1\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "0"}], "}"}], ",", 
       " ", "\"\<\[CapitalOmega]/k = 5\>\""}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"purifyPanels", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"\[Eta]v", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"panelPurify", "[", 
            RowBox[{"\[Eta]v", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@",
           " ", "purifyDrives"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", " ", "0.8", ",", " ", "1"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"purifyPanels", "[", "purifyEta", "]"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<run 1\>\"", ",", " ", "\"\<run 2\>\"", ",", 
           " ", "\"\<run 3\>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"HoldForm", "[", 
             RowBox[{"r", " ", "==", " ", 
              RowBox[{"Sqrt", "[", "\[Eta]", "]"}]}], "]"}], "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
        " ", "Below"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"purifyEta", ",", " ", "1", ",", " ", "\"\<\[Eta]\>\""}], "}"}],
      ",", " ", 
     RowBox[{"Keys", "[", "purifyPanels", "]"}], ",", " ", "SetterBar"}], 
    "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[24]:= ",
 CellID->1687401897,ExpressionUUID->"200757f3-6c13-e437-19d3-024b40462ea4"],

Cell[TextData[{
 "Neither term contains ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "363b2254-66e6-5e23-650a-c778373d94cf"],
 " or ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37a88eb5-540a-b162-4f50-f11cd357782a"],
 ": the Hamiltonian only rotates the Bloch vector. The drift is positive \
inside ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2775121b-11b7-12b3-65b1-65a00bd6a1c0"],
 " and the noise vanishes at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63509f22-1ff7-ca97-3093-8b55fe38f5be"],
 ", so at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7215b488-90c1-1338-7b85-69dede955dad"],
 " every run climbs to the surface and stays there: a mixed state purifies \
and a pure state stays pure. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dc4d986-16a1-5b8e-0f56-bcedc61ca4c0"],
 " the drift at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50747d81-a3b8-6c99-3a85-232397b840ec"],
 " is negative except at the poles, so without a drive the runs purify by \
reaching a pole, a drive comparable to ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b490309-110b-24b3-24b0-d81ef84b07bf"],
 " lets them reach the poles only part of the time, and a strong drive keeps \
them off the poles and below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a8cfc5-930d-96ee-1cc4-85feadf83794"],
 "."
}], "Text",
 CellID->696969587,ExpressionUUID->"368911d9-298e-e2ad-563b-9730379f1d02"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1101432359,ExpressionUUID->"2c7308c7-9465-c145-2172-3ad509bb9b12"],

Cell["\<\
A monitored qubit stays in the Bloch ball: It\[OHat]'s lemma on the sphere\
\>", "Subsection",
 CellID->1967428890,ExpressionUUID->"4d52bcf6-330c-30ad-171d-6dd56cea1768"],

Cell[TextData[{
 "A qubit is Rabi-driven at frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d852681-ad88-c9c3-197a-0c4efd10fcbf"],
 ", relaxes toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04a3aef5-bbad-9a6a-263d-0f392cc3bfb9"],
 " at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70c54c86-fdc8-681a-48f5-eda73eee4eac"],
 ", dephases at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e3725c4-c70a-5174-3548-501346cc457b"],
 ", and is read out along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ebed798-bb7b-bb0d-366e-5aaf52198032"],
 " by a detector that dephases it at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61af2025-70f5-86f6-1d7c-59bd30d39e67"],
 " and whose noise enters ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12e82d68-44fe-316a-1ab7-056e5ae70eb3"],
 " at the informational rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72b88d47-f055-c9a0-3c6c-573294a22a05"],
 " and rotates the phase at the back-action rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "400e2202-b524-af6a-267a-7774d3216726"],
 "; its efficiency is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]], "+", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2198fd74-e618-7417-5de0-85b334b67886"],
 ". Does every run stay a density matrix, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "422f4041-b768-a2b2-381c-16ac31012796"],
 ", for every choice of rates?"
}], "Text",
 CellID->2092495381,ExpressionUUID->"35a166a5-03a7-96eb-3eb1-0ec71b7f3673"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fc26db3-f4fd-05c4-6439-d6d933b7c2e8"],
 " and one Wiener noise ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "205f33ea-876f-b72d-7678-ba3b9baf56e1"],
 ", the Bloch vector obeys the It\[OHat] equations"
}], "Text",
 CellID->1697359523,ExpressionUUID->"24c57c25-2dd7-184f-19a0-13c00ea8facc"],

Cell[BoxData[
 PaneBox[GridBox[{
    {
     StyleBox[
      RowBox[{"d", "x"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"-", "(", 
       RowBox[{
        FractionBox[
         SubscriptBox[
          StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", 
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], 
         StyleBox["\[Phi]", "TI"]], "+", 
        SubscriptBox["\[CapitalGamma]", 
         StyleBox["d", "TI"]]}], ")", 
       StyleBox["x", "TI"], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "-", "(", 
       RowBox[{
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["x", "TI"], 
        StyleBox["z", "TI"], "+", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"B", "A"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["y", "TI"]}], ")", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]},
    {
     StyleBox[
      RowBox[{"d", "y"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"[", 
       RowBox[{"-", "(", 
        RowBox[{
         FractionBox[
          SubscriptBox[
           StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", 
         SubscriptBox[
          StyleBox["\[Gamma]", "TI"], 
          StyleBox["\[Phi]", "TI"]], "+", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["d", "TI"]]}], ")", 
        StyleBox["y", "TI"], "-", "\[CapitalOmega]", 
        StyleBox["z", "TI"]}], "]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "-", "(", 
       RowBox[{
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["y", "TI"], 
        StyleBox["z", "TI"], "-", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"B", "A"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["x", "TI"]}], ")", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]},
    {
     StyleBox[
      RowBox[{"d", "z"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], "1"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         StyleBox["z", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1], "+", "\[CapitalOmega]", 
        StyleBox["y", "TI"]}], "]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "+", 
       SqrtBox[
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["z", "TI"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], "."}]}
   },
   GridBoxAlignment->{"Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->659063245,ExpressionUUID->"3ee53b69-3d1c-7a1e-4e27-1901779eab44"],

Cell[TextData[{
 "It\[OHat]'s lemma for ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4808804d-8390-3a1d-426a-2819268d9faf"],
 " on the sphere ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e0824ff-00ff-61f5-1089-d96941559062"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["z", "TI"], "2"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7670a620-f860-2c46-3484-1d6a2cfdbc33"],
 ", gives the noise of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74db2183-9fe5-519f-4fa9-a01d2996cf1f"],
 " there and the efficiencies for which its drift points outward somewhere:"
}], "Text",
 CellID->834119391,ExpressionUUID->"535e423a-bf65-8a8e-1bb7-d1c96426148f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"monitoredQubit", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
             "\[Gamma]\[CurlyPhi]", " ", "+", " ", "\[CapitalGamma]d"}], 
            ")"}]}], " ", 
          RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
              "\[Gamma]\[CurlyPhi]", " ", "+", " ", "\[CapitalGamma]d"}], 
             ")"}]}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"z", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"x", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"y", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"y", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"x", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], ")"}]}], "}"}]}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "}"}], ",", 
     " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r2Drift", ",", " ", "r2Noise"}], "}"}], " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"monitoredQubit", "[", 
        RowBox[{"\"\<Derivative\>\"", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"z", "[", "t", "]"}], "^", "2"}]}]}], "]"}], "]"}], " ", "/.",
       "\n", "     ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"z", "^", "2"}]}], "]"}], " ", 
          RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"z", "^", "2"}]}], "]"}], " ", 
          RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"z", "[", "t", "]"}], " ", "->", " ", "z"}], ",", " ", 
        RowBox[{"\[CapitalGamma]BA", " ", "->", " ", 
         RowBox[{
          RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]d"}], " ", "-", 
          " ", "\[CapitalGamma]CI"}]}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ballOutwardCondition", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Reduce", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exists", "[", 
         RowBox[{"z", ",", " ", 
          RowBox[{
           RowBox[{"-", "1"}], " ", "<", " ", "z", " ", "<", " ", "1"}], ",", 
          " ", 
          RowBox[{"r2Drift", " ", ">", " ", "0"}]}], "]"}], " ", "&&", " ", 
        RowBox[{"\[CapitalGamma]d", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
        
        RowBox[{"\[Gamma]1", " ", ">=", " ", "0"}]}], ",", " ", "\[Eta]", ",",
        " ", "Reals"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalGamma]d", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Gamma]1", " ", ">=", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TraditionalForm", "[", 
  RowBox[{
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<noise of r\.b2 on the sphere\>\"", " ", "->", " ", 
      "r2Noise"}], ",", " ", 
     RowBox[{"\"\<drift outward somewhere\>\"", " ", "->", " ", 
      "ballOutwardCondition"}]}], "|>"}], " ", "/.", "\n", "   ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalGamma]d", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[CapitalGamma]", ",", " ", "\"\<d\>\""}], "]"}]}], ",", " ", 
     
     RowBox[{"\[Gamma]\[CurlyPhi]", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Gamma]", ",", " ", "\"\<\[CurlyPhi]\>\""}], "]"}]}], ",", 
     " ", 
     RowBox[{"\[Gamma]1", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Gamma]", ",", " ", "1"}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[25]:= ",
 CellID->1077979373,ExpressionUUID->"65c2e78b-e55b-17fa-05c9-b22755d439b0"],

Cell[TextData[{
 "Three runs start from the mixed state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.3", ",", "0", ",", "0.3"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e313046-66d0-463f-58e6-c188701ef619"],
 ", with ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "299d2313-16eb-9ffb-3e7e-6f331006747a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "0.2", "\[ThinSpace]", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02bcec05-f7a8-4a98-653d-97a72e36255f"],
 ", no extra dephasing, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1adc20b1-6268-f817-1dee-45b2a9bdbc3d"],
 ", and the detector noise split equally, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "=", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", 
   StyleBox["\[Eta]", "TI"], 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a108219-5896-6ccc-0990-ac9e7557a8c6"],
 ". Each panel plots the Bloch vector length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ed0895-1564-2be4-330f-e8dccd262d06"],
 " for one efficiency, with the region ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], ">", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03cc6f8d-0242-b59b-6136-196021385915"],
 ", where ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae715f0-08dc-e624-7a7b-3d279682ed8a"],
 " is not a density matrix, shaded; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0defd049-9ce6-124a-71a2-4af6476845ef"],
 ":"
}], "Text",
 CellID->1737910798,ExpressionUUID->"09b3b1eb-76aa-0997-7d13-f68c61dcf3dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ballEtas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", " ", "1", ",", " ", "3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ballRun", "[", "\[Eta]v_", "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
       "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomFunction", "[", 
          RowBox[{
           RowBox[{"monitoredQubit", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Gamma]1", " ", "->", " ", "0.2"}], ",", " ", 
              RowBox[{"\[Gamma]\[CurlyPhi]", " ", "->", " ", "0"}], ",", " ", 
              
              RowBox[{"\[CapitalGamma]d", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"\[CapitalOmega]", " ", "->", " ", "2"}], ",", " ", 
              RowBox[{"\[CapitalGamma]CI", " ", "->", " ", "\[Eta]v"}], ",", 
              " ", 
              RowBox[{"\[CapitalGamma]BA", " ", "->", " ", "\[Eta]v"}], ",", 
              " ", 
              RowBox[{"x0", " ", "->", " ", "0.3"}], ",", " ", 
              RowBox[{"y0", " ", "->", " ", "0"}], ",", " ", 
              RowBox[{"z0", " ", "->", " ", "0.3"}]}], "}"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.", ",", " ", "5.", ",", " ", "0.001"}], "}"}], ",", 
           " ", "3", ",", "\n", "       ", 
           RowBox[{
           "Method", " ", "->", 
            " ", "\"\<StochasticRungeKuttaScalarNoise\>\""}]}], "]"}], 
         "[", "\"\<Paths\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{";;", " ", ";;", " ", "5"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.6"}], "}"}]}], ",", " ", 
     RowBox[{"Prolog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.88", "]"}], ",", " ", 
        RowBox[{"Rectangle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "1.6"}], "}"}]}], "]"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<not a density matrix\>\"", ",", " ", "Gray", ",", " ",
             "11"}], "]"}], ",", " ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.95"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]v"}], "}"}], "]"}], 
          ",", " ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.06"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Bottom"}], "}"}]}], "]"}]}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], "]"}],
            ",", " ", "\"\< t\>\""}], "}"}], "]"}], ",", 
        " ", "\"\<Bloch vector length r\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ballRun", " ", "/@", " ", "ballEtas"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[26]:= ",
 CellID->2092243869,ExpressionUUID->"63c6b76e-670e-6200-4d15-b46c7d8f2c2d"],

Cell[TextData[{
 "The measurement does two things to the Bloch vector: it dephases the qubit \
at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3229956a-47a5-2313-4ede-c3650d3ac297"],
 ", which pulls the state inward, and each update from the record pushes it \
toward purity, at a rate set by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39e3f711-c6d7-58fb-41bf-e4cfe7006478"],
 ". On the sphere the kicks only slide the state along it, so the drift \
decides, and it points outward somewhere exactly when the information outruns \
the disturbance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ">", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3301a2d8-9d64-d68e-1f4b-774155e76d49"],
 ", whatever the drive and the relaxation. A real detector has ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bae4690-9ad4-c0ef-057f-7395ee60a99c"],
 ", so the runs at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a0d4335-df51-69d2-0188-2a8cb3d78a64"],
 " and ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28214a29-62f0-1c2e-5951-f16cdf78c447"],
 " stay in the ball, while ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b98f7c4-c835-2281-557b-05ab589909e5"],
 ", a detector that would learn more than it disturbs, drives them out. Extra \
dephasing ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7355702a-1d56-1003-17d0-63908767dcb4"],
 " disturbs without informing, so it only widens the margin."
}], "Text",
 CellID->1053572545,ExpressionUUID->"0074d9f9-a386-d0d1-10a5-c4414b39d55d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
