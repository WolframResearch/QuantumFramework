Cell[TextData[{
 "The probability sits on a lattice of isolated peaks whose arrangement \
changes with ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ee9a540-ff34-b9a8-5baa-e8d7df1acef3"],
 ", and the shots land on those peaks. In every panel at least one of the 20 \
shots gives a candidate that passes ",
 Cell[BoxData[
  RowBox[{"\[ScriptL]", 
   StyleBox["G", "TI"], "=", 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f8138f1-fe6a-7bb4-612a-e665c40968af"],
 ": the peak positions supply ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf55f19-e658-b425-5afe-91514e08385f"],
 ", and the check only discards wrong candidates."
}], "Text",
 CellID->945481289,ExpressionUUID->"50511207-83a9-257a-4260-d095e7a59f9e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
