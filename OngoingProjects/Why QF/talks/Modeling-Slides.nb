Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"8", "\[Times]", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7393419f-bef2-96ce-7149-e91cd8916035"],
 " equation is integrated from ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"000"},
      "Ket"], "+", 
     RowBox[{
      StyleBox["i", "TI"], 
      TemplateBox[{"100"},
       "Ket"]}]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3806733d-d9e9-b8c4-639c-a7727a5d8d3c"],
 ", a superposition of two sectors, with the positivity-preserving step of \
Rouchon and Ralph, at two time steps on the same noise, and the filter runs \
on each record and is compared with the sector populations ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["s", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "380bd30d-0067-b085-65ce-76e8b5a68414"],
 " of the full state through their largest gap; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5086bba2-683e-0aa2-4a0a-804d1f9e9eef"],
 ":"
}], "Text",
 CellID->1355056369,ExpressionUUID->"544accbc-c2fd-2efa-7e66-1d691652c5a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qecOp", "[", 
    RowBox[{"o_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "3"}], "]"}], ",",
       " ", 
      RowBox[{"k", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecStabs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "1"}], "]"}], " ", ".",
       " ", 
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "2"}], "]"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "2"}], "]"}], " ", ".",
       " ", 
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecFlips", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"qecOp", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "#"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecSigns", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecProj", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", 
          RowBox[{"qecStabs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"qecStabs", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "4"}], " ", 
     "&"}], " ", "/@", " ", "qecSigns"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qecStep", "[", 
     RowBox[{"\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_"}], "]"}], "[", 
    
    RowBox[{"\[Rho]_", ",", " ", "dJ_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Sigma]", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", 
        RowBox[{"dJ", " ", ".", " ", "qecStabs"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"M", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"2", " ", "+", " ", 
                RowBox[{"3", " ", "\[Gamma]"}]}], ")"}], " ", 
              RowBox[{"dt", "/", "2"}]}], " ", "-", " ", 
             RowBox[{"\[Eta]", " ", "dt"}]}], ")"}], " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
          "\[Sigma]", " ", "+", " ", 
          RowBox[{
           RowBox[{"\[Sigma]", " ", ".", " ", "\[Sigma]"}], "/", "2"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "/", 
          RowBox[{"Tr", "[", "#", "]"}]}], " ", "&"}], "[", 
        RowBox[{
         RowBox[{"M", " ", ".", " ", "\[Rho]", " ", ".", " ", "M"}], " ", "+",
          " ", 
         RowBox[{"\[Gamma]", " ", "dt", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", ".", " ", "\[Rho]", " ", ".", " ", "#"}], " ", 
             "&"}], " ", "/@", " ", "qecFlips"}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "\[Eta]"}], ")"}], " ", "dt", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", ".", " ", "\[Rho]", " ", ".", " ", "#"}], " ", 
             "&"}], " ", "/@", " ", "qecStabs"}], "]"}]}]}], "]"}]}], "]"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecRun", "[", 
    RowBox[{
    "\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_", ",", " ", "kicks_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Rest", " ", "@", " ", 
    RowBox[{"FoldList", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"state", ",", " ", "kick"}], "}"}], ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dJ", " ", "=", " ", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", 
              RowBox[{"Re", "[", 
               RowBox[{"Tr", " ", "/@", " ", 
                RowBox[{"(", 
                 RowBox[{"qecStabs", " ", ".", " ", 
                  RowBox[{"First", "[", "state", "]"}]}], ")"}]}], "]"}], " ",
               "dt"}], " ", "+", " ", "kick"}]}], "}"}], ",", "\n", "      ", 
          
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"qecStep", "[", 
              RowBox[{"\[Gamma]", ",", " ", "\[Eta]", ",", " ", "dt"}], "]"}],
              "[", 
             RowBox[{
              RowBox[{"First", "[", "state", "]"}], ",", " ", "dJ"}], "]"}], ",",
             " ", "dJ"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", " ", "#", ",", " ", 
            RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], " ", "&"}], "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{"8", ",", " ", "1"}], "]"}], " ", "+", " ", 
            RowBox[{"I", " ", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"8", ",", " ", "5"}], "]"}]}]}], ")"}], "/", 
          RowBox[{"Sqrt", "[", "2.", "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.", ",", " ", "0."}], "}"}]}], "}"}], ",", " ", "kicks"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecFilter", "[", 
    RowBox[{
    "\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_", ",", " ", "record_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "/", 
         RowBox[{"Total", "[", "#", "]"}]}], " ", "&"}], "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", "4"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "4"}], " ", "\[Gamma]", " ", "dt"}], "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"#1", " ", "-", " ", 
             RowBox[{"1", "/", "4"}]}], ")"}]}]}], ")"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", 
          RowBox[{"qecSigns", " ", ".", " ", "#2"}]}], "]"}]}], "]"}], " ", 
      "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.5", ",", " ", "0.", ",", " ", "0."}], "}"}],
      ",", " ", "record"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecTrack", "[", 
    RowBox[{
    "\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_", ",", " ", "kicks_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"qecRun", "[", 
        RowBox[{
        "\[Gamma]", ",", " ", "\[Eta]", ",", " ", "dt", ",", " ", "kicks"}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"filter", " ", "=", " ", 
         RowBox[{"qecFilter", "[", 
          RowBox[{"\[Gamma]", ",", " ", "\[Eta]", ",", " ", "dt", ",", " ", 
           RowBox[{"run", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"filter", ",", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Rest", "[", "filter", "]"}], " ", "-", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", 
                RowBox[{"Tr", " ", "/@", " ", 
                 RowBox[{"(", 
                  RowBox[{"qecProj", " ", ".", " ", 
                   RowBox[{"First", "[", "#", "]"}]}], ")"}]}], "]"}], " ", 
               "&"}], " ", "/@", " ", "run"}], ")"}]}], "]"}], "]"}]}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecPanel", "[", 
    RowBox[{"\[Eta]_", ",", " ", "\[Gamma]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kicks", " ", "=", " ", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Sqrt", "[", "0.005", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"8000", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", "\n",
      "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fine", " ", "=", " ", 
          RowBox[{"qecTrack", "[", 
           RowBox[{
           "\[Gamma]", ",", " ", "\[Eta]", ",", " ", "0.005", ",", " ", 
            "kicks"}], "]"}]}], ",", " ", 
         RowBox[{"coarse", " ", "=", " ", 
          RowBox[{"qecTrack", "[", 
           RowBox[{"\[Gamma]", ",", " ", "\[Eta]", ",", " ", "0.01", ",", " ", 
            RowBox[{"Total", " ", "/@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{"kicks", ",", " ", "2"}], "]"}]}]}], "]"}]}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"First", "[", "fine", "]"}], "]"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "40"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\[Kappa] t\>\"", ",", 
            " ", "\"\<syndrome probability\>\""}], "}"}]}], ",", "\n", 
         "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]", ",", 
                 " ", "\"\<,   \[Gamma]/\[Kappa] = \>\"", ",", " ", 
                 "\[Gamma]"}], "}"}], "]"}], ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<largest gap at \[Kappa] dt = 0.01, 0.005: \>\"", 
                 ",", " ", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"Last", "[", "coarse", "]"}], ",", " ", "2"}], 
                  "]"}], ",", " ", "\"\<, \>\"", ",", " ", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"Last", "[", "fine", "]"}], ",", " ", "2"}], 
                  "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", "Center"}], 
           "]"}]}], ",", "\n", "     ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<(\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<S\>\"", ",", " ", "\"\<1\>\""}], "]"}], ",", 
                " ", "\"\<, \>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<S\>\"", ",", " ", "\"\<2\>\""}], "]"}], ",", 
                " ", "\"\<) = (\>\"", ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<, \>\"", ",", 
                " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<)\>\""}], 
               "}"}], "]"}], " ", "&"}], " ", "/@", " ", "qecSigns"}], 
           ")"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecPanels", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"qecPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0.2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.01", ",", " ", "0.05", ",", " ", "0.2"}], "}"}]}], "]"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "qecPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"qecPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[40]:= ",
 CellID->453774196,ExpressionUUID->"5b5dd8c2-a171-759c-67f1-a8a01e82735b"],

Cell["\<\
The gap roughly halves with the time step, so it is the integration's error: \
the four probabilities follow the full state, coherences included, and need \
nothing else from it. With a perfect detector and rare flips the filter jumps \
cleanly from sector to sector as each flip happens. With a poor detector and \
frequent flips it rarely settles before the next flip.\
\>", "Text",
 CellID->2005971825,ExpressionUUID->"2b2b0827-24be-b103-6b52-afbb78ccdc3c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1080501523,ExpressionUUID->"6fe248cd-f8df-5fbf-79e1-8478e869f9a6"],

Cell["\<\
Markovian feedback that protects the code space, and what the detector costs\
\>", "Subsection",
 CellID->266990780,ExpressionUUID->"4e5a615e-7a09-2eb3-2f65-ff220a3deb60"],

Cell[TextData[{
 "Three qubits carry the bit-flip code, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox["0", 
      StyleBox["L", "TI"]]},
    "Ket"], "=", 
   TemplateBox[{"000"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d8d86d6-e44a-5cc3-5938-f1b00ef7749f"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox["1", 
      StyleBox["L", "TI"]]},
    "Ket"], "=", 
   TemplateBox[{"111"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20874507-5548-38fe-7529-34b9e7153c87"],
 ", and each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c0494a-a65f-5cc2-4d71-4ce23ff06cd1"],
 " through the channel ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["i", "TI"]], "=", 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fbff323-309b-3ffd-1216-24fba349be2d"],
 ". Each channel is monitored by homodyne detection of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25421937-550d-a321-2b49-bfdbec1617ab"],
 ", and its current ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4eb69561-8ce1-3c6c-0625-11b117bba9b6"],
 " drives the qubits at once through the Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd2d9b7-6cc7-8996-68d8-45d034a58b03"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["i", "TI"], 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox[
      RowBox[{"c", "o", "d", "e"}], "TI"]], ",", 
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a3bb810-e7fd-1c55-33bd-7b2ad0144b15"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox[
     RowBox[{"c", "o", "d", "e"}], "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{"000"},
      "Ket"], 
     TemplateBox[{"000"},
      "Bra"]}], "+", 
    RowBox[{
     TemplateBox[{"111"},
      "Ket"], 
     TemplateBox[{"111"},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "773702d2-27a6-37fc-0f8a-d4072c32ec1d"],
 ". How well does this loop hold an encoded state?"
}], "Text",
 CellID->658048876,ExpressionUUID->"0afd44e9-c57c-5fe0-7f53-d5474a50b919"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "282ba3fe-c545-314c-603d-e9a71ba9ae45"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51ea7add-69a1-644d-4428-49ddaf13a885"],
 ", the Wiseman-Milburn feedback master equation is"
}], "Text",
 CellID->723744305,ExpressionUUID->"20158c04-545f-0638-452e-3eb16d35c016"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    FractionBox[
     StyleBox["i", "TI"], "2"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "[", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["i", "TI"], "\[Dagger]"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["F", "TI"], "^"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["F", "TI"], "^"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["c", "TI"], "^"], 
       StyleBox["i", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["c", "TI"], "^"], 
      StyleBox["i", "TI"]], "-", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["F", "TI"], "^"], 
      StyleBox["i", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    FractionBox[
     RowBox[{"1", "-", 
      StyleBox["\[Eta]", "TI"]}], 
     StyleBox["\[Eta]", "TI"]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["F", "TI"], "^"], 
     StyleBox["i", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->878430531,ExpressionUUID->"2524ae08-9ee7-21b0-3aad-e488e83ca998"],

Cell[TextData[{
 "The two identities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    StyleBox["i", "TI"]], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["i", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31ee2952-723f-8eb3-07e3-65148db820af"],
 ", which removes the Hamiltonian term, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], 
     StyleBox["i", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["F", "TI"], "^"], 
     StyleBox["i", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox[
     RowBox[{"c", "o", "d", "e"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4195b1d3-5c1b-69e0-4f3b-9e05659d1f4f"],
 " both hold exactly. The master equation evolves from ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46908190-67ba-6c29-3166-be6a31257e8c"],
 " and from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox["+", 
      StyleBox["L", "TI"]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"000"},
       "Ket"], "+", 
      TemplateBox[{"111"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "197423b8-f2c8-ce23-1e77-9accc475dfc2"],
 ", with ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["i", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5acb639c-b458-d86a-4340-371867f05e6c"],
 " alone as the case without feedback; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15bb9315-ccbb-4328-7a7a-716c48e83f1c"],
 ":"
}], "Text",
 CellID->1953655798,ExpressionUUID->"2fffac4d-cb33-0cdd-33e6-768427899d9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fbOp", "[", 
    RowBox[{"o_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "3"}], "]"}], ",",
       " ", 
      RowBox[{"k", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbFlips", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"fbOp", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "#"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbCode", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"UnitVector", "[", 
      RowBox[{"8", ",", " ", "1"}], "]"}], " ", "+", " ", 
     RowBox[{"UnitVector", "[", 
      RowBox[{"8", ",", " ", "8"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbF", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fbCode", " ", ".", " ", "#"}], " ", "-", " ", 
        RowBox[{"#", " ", ".", " ", "fbCode"}]}], ")"}]}], " ", "&"}], " ", "/@",
     " ", "fbFlips"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbChecks", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
           RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"fbFlips", ",", " ", "fbF"}], "}"}]}], "]"}], "]"}], "]"}], 
     ",", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", ".", " ", "fbCode"}], ")"}], " ", "&"}], " ", "/@",
         " ", 
        RowBox[{"(", 
         RowBox[{"fbFlips", " ", "-", " ", 
          RowBox[{"I", " ", "fbF"}]}], ")"}]}], "]"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fbRho", "[", 
    RowBox[{"ops_", ",", " ", "rates_", ",", " ", "\[Psi]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"QuantumOperator", " ", "/@", " ", "ops"}], " ", "->", " ", 
        "rates"}], ",", " ", 
       RowBox[{"QuantumState", "[", "\[Psi]", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbEtas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     RowBox[{"1", "/", "2"}], ",", " ", 
     RowBox[{"1", "/", "10"}], ",", " ", 
     RowBox[{"1", "/", "50"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbStarts", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<|\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<0\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
          " ", "\"\<\:27e9\>\""}], "}"}], "]"}], ",", " ", 
       RowBox[{"UnitVector", "[", 
        RowBox[{"8", ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<|\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<+\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
          " ", "\"\<\:27e9\>\""}], "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"UnitVector", "[", 
           RowBox[{"8", ",", " ", "1"}], "]"}], " ", "+", " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"8", ",", " ", "8"}], "]"}]}], ")"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fbCurves", "[", "\[Psi]_", "]"}], " ", ":=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"\[Eta]", ",", " ", 
        RowBox[{"fbRho", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"fbFlips", " ", "-", " ", 
             RowBox[{"I", " ", "fbF"}]}], ",", " ", "fbF"}], "]"}], ",", " ", 
          
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", "\[Eta]"}], ")"}], "/", 
               "\[Eta]"}], ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
          "\[Psi]"}], "]"}]}], "]"}], " ", "/@", " ", "fbEtas"}], ",", " ", 
     RowBox[{"fbRho", "[", 
      RowBox[{"fbFlips", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
       "\[Psi]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbObs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"fbCode", " ", ".", " ", "#1"}], "]"}], "]"}], " ", "&"}], ",",
        " ", "\"\<code-space population\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", "#2", "]"}], " ", ".", " ", "#1", " ", ".",
           " ", "#2"}], "]"}], " ", "&"}], ",", 
       " ", "\"\<fidelity with the start\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fbPanel", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name_", ",", " ", "\[Psi]_"}], "}"}], ",", " ", "\[Rho]s_", ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"obs_", ",", " ", "label_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"obs", "[", 
         RowBox[{"#", ",", " ", "\[Psi]"}], "]"}], " ", "&"}], " ", "/@", " ",
        "\[Rho]s"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Gamma] t\>\"", ",", " ", "label"}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"GridLinesStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], "]"}]}],
      ",", "\n", "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<start \>\"", ",", " ", "name"}], "}"}], "]"}]}], ",", 
     " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
        "Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
          "&"}], " ", "/@", " ", "fbEtas"}], ",", 
        " ", "\"\<no feedback\>\""}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbPanels", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"start", ",", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]s", " ", "=", " ", 
          RowBox[{"fbCurves", "[", 
           RowBox[{"Last", "[", "start", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"fbPanel", "[", 
           RowBox[{"start", ",", " ", "\[Rho]s", ",", " ", "#"}], "]"}], " ", 
          "&"}], " ", "/@", " ", "fbObs"}]}], "]"}]}], "]"}], " ", "/@", " ", 
    "fbStarts"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Map", "[", 
         RowBox[{"First", ",", " ", "fbPanels", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "700"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"fbPanels", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<c\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<F\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\< + \>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<F\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<c\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\< = \>\"", ",", " ", 
        RowBox[{"fbChecks", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<   and   (\>\"", ",", 
        "\n", "     ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<c\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\< - i \>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<F\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\<)\>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<\[CapitalPi]\>\"", ",", " ", "\"\<code\>\""}], "]"}], ",",
         " ", "\"\< = \>\"", ",", " ", 
        RowBox[{"fbChecks", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<   for every i\>\""}],
        "}"}], "]"}], ",", " ", "14", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[41]:= ",
 CellID->1318894631,ExpressionUUID->"577ccdec-bb66-eb94-40ca-c5c9119e6afa"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a56877b-80cb-aa94-2e24-31a03bdb7505"],
 " the two identities make every encoded state a fixed point, for ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb8e284-7db0-a98a-11f3-1839b4f66846"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["+", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b2ff43-ed96-9223-2b97-80cc6cc36657"],
 " alike. Below unit efficiency the ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    StyleBox["i", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d1ec098-4fe1-c334-65ec-6b1f1517059e"],
 " term feeds detector noise back onto the qubits: the plateau falls with ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55344bda-38aa-5bd9-0299-a5882be3ae00"],
 ", and at low efficiency the loop empties the code space faster than no \
feedback. From ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "140af14b-ed80-3a3e-6c59-284e7fbd0ea6"],
 " the fidelity falls below the code-space population while from ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["+", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6550b119-840c-f517-312b-bed2719072a2"],
 " the two agree: the noisy loop also flips ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ef98abd-1783-579b-3abf-28cab0bdd5ae"],
 " into ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["1", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73a18a25-b5b5-c803-310a-46ad385a3b23"],
 ", which no stabilizer sees."
}], "Text",
 CellID->1986353928,ExpressionUUID->"17ab445e-641c-2bf2-1b0e-50e9cf826d59"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1732688669,ExpressionUUID->"5f2de42b-5cdd-68db-10d7-23e6cc733fd9"],

Cell["\<\
Syndrome populations of a repetition code: a closed equation from a general \
state\
\>", "Subsection",
 CellID->953325239,ExpressionUUID->"3b27918a-43fa-d2d2-1bc6-424fa92238ea"],

Cell[TextData[{
 "Three qubits carry the bit-flip code with stabilizers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "1"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "421e91fb-356c-b1a4-7556-e0a0d12242a8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "2"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78fbe297-f933-5912-0540-592d6881d6ca"],
 ", each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52a8bc68-e7d2-ec4b-1d58-e1b5cb93639c"],
 ", and a field may drive the first qubit through ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", "\[CapitalOmega]", 
   SubscriptBox[
    StyleBox["X", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e392250-1595-65c2-0315-8f75382246b7"],
 ". The four syndrome sectors, with projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox["s", "TI"]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "2"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22c628e3-c97e-bc23-4f05-e9c724784291"],
 ", have populations ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["s", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["s", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13432bb1-261d-86de-08ac-5435c002171a"],
 ". Do these four numbers obey a closed equation of their own?"
}], "Text",
 CellID->467957530,ExpressionUUID->"2e7a64b5-1b7d-a2b4-6e60-ae90f1b5f743"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e3ee85a-96c8-481c-2a10-cfcc8ed5baea"],
 ", the three-qubit state obeys the Lindblad equation"
}], "Text",
 CellID->2110390618,ExpressionUUID->"5d42874a-4c16-afaf-45b2-510b0ba598fd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "\[ThinSpace]", "\[CapitalOmega]", "\[ThinSpace]", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["X", "TI"], "1"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["X", "TI"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      StyleBox["X", "TI"], 
      StyleBox["k", "TI"]], "-", 
     StyleBox["\[Rho]", "TI"]}], ")"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->783797437,ExpressionUUID->"6ca8bbd6-832b-bc92-2380-d5e0b91dd6ca"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "."], 
    StyleBox["s", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["s", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c68a715-7c93-b5b6-7a8b-e054170bc08d"],
 " with ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "756a7d08-c100-c016-00f9-fe456a9b6367"],
 " the adjoint generator, the populations obey a closed equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "."], "=", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["A", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a31a7e3-0dca-8bca-27c5-83687deb04e4"],
 " for every ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00f905f8-ce0d-c2a5-6860-aee12b9464bb"],
 " exactly when each ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox["s", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f12651b-9b04-b63a-15d3-60d09154e4a7"],
 " is a combination ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   UnderscriptBox["\[Sum]", 
    SuperscriptBox[
     StyleBox["s", "TI"], "\[Prime]"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["s", "TI"], 
     SuperscriptBox[
      StyleBox["s", "TI"], "\[Prime]"]}]], 
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    SuperscriptBox[
     StyleBox["s", "TI"], "\[Prime]"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "700532ae-2a2e-668c-3ff7-8eb66e4a975f"],
 " of the projectors."
}], "Text",
 CellID->1786937431,ExpressionUUID->"3bbffb2d-edf3-9d16-3abb-c07349cdf240"],

Cell[TextData[{
 "Applying the flip part of ",
 Cell[BoxData[
  SuperscriptBox["\[ScriptCapitalL]", "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e45071a-f6ef-a356-0657-b51ab16488b5"],
 " to the four projectors gives ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31834fe3-14c7-1c6c-64b7-1dbb94470b29"],
 "; the full equation evolves from ",
 Cell[BoxData[
  TemplateBox[{"000"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66643912-3927-a96d-1c22-e1ed7821e93f"],
 " and from a superposition of two sectors (solid), against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"\[Gamma]", "A", "t"}], "TI"]], 
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52a2e275-c428-2329-6943-4e6ea190733d"],
 " from the flip term alone (dashed), with time in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cb9997-93f7-fb5e-716e-445524339004"],
 ":"
}], "Text",
 CellID->418411907,ExpressionUUID->"56b228cb-d921-0465-45d1-40780c5ef311"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"synOp", "[", 
    RowBox[{"o_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "3"}], "]"}], ",",
       " ", 
      RowBox[{"k", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"synStabs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"synOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "1"}], "]"}], " ", ".",
       " ", 
      RowBox[{"synOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "2"}], "]"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{"synOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "2"}], "]"}], " ", ".",
       " ", 
      RowBox[{"synOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"synProj", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", 
          RowBox[{"synStabs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"synStabs", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "4"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "1"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"synAdj", "[", "gen_", "]"}], " ", ":=", " ", 
   RowBox[{"gen", " ", "/@", " ", "synProj"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"synFlipAdj", " ", "=", " ", 
   RowBox[{"synAdj", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"synOp", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "k"}], "]"}], 
         " ", ".", " ", "#", " ", ".", " ", 
         RowBox[{"synOp", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "k"}], "]"}]}], 
        " ", "-", " ", "#"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], " ", "&"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"synFlipA", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"#1", " ", ".", " ", "#2"}], "]"}], "/", "2"}], " ", "&"}], ",",
      " ", "synFlipAdj", ",", " ", "synProj", ",", " ", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"synPanel", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name_", ",", " ", "\[Psi]0_"}], "}"}], ",", " ", 
     "\[CapitalOmega]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]t", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumEvolve", "[", 
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{"\[CapitalOmega]", " ", 
             RowBox[{"synOp", "[", 
              RowBox[{
               RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "1"}], 
              "]"}]}], "]"}], ",", "\n", "       ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"QuantumOperator", "[", 
               RowBox[{"synOp", "[", 
                RowBox[{
                 RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "#"}], 
                "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "3", "]"}]}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], ",", " ", 
           RowBox[{"QuantumState", "[", "\[Psi]0", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "1.5"}], "}"}]}], "]"}], 
         "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"#", " ", ".", " ", "\[Rho]t"}], "]"}], "]"}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"Take", "[", 
            RowBox[{"synProj", ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "1.5"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "     ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<(\>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<S\>\"", ",", " ", "1"}], "]"}], ",", 
               " ", "\"\<, \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<S\>\"", ",", " ", "2"}], "]"}], ",", 
               " ", "\"\<) = (1, 1)\>\""}], "}"}], "]"}], ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<(\>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<S\>\"", ",", " ", "1"}], "]"}], ",", 
               " ", "\"\<, \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<S\>\"", ",", " ", "2"}], "]"}], ",", 
               " ", "\"\<) = (\[Minus]1, 1)\>\""}], "}"}], "]"}], ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<(\>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<S\>\"", ",", " ", "1"}], "]"}], ",", 
               " ", "\"\<, \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<S\>\"", ",", " ", "2"}], "]"}], ",", 
               " ", "\"\<) = (\[Minus]1, \[Minus]1) and (1, \[Minus]1): equal \
by symmetry\>\""}], "}"}], "]"}]}], "}"}]}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"MatrixExp", "[", 
              RowBox[{"synFlipA", " ", "t"}], "]"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", 
                 RowBox[{
                  RowBox[{"Conjugate", "[", "\[Psi]0", "]"}], " ", ".", " ", 
                  "#", " ", ".", " ", "\[Psi]0"}], "]"}], " ", "&"}], " ", "/@",
                " ", "synProj"}], ")"}]}], ",", " ", "3"}], "]"}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "1.5"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Gamma] t\>\"", ",", 
          " ", "\"\<sector population\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"GridLinesStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<start \>\"", ",", " ", "name", ",", 
                 " ", "\"\<,  \[CapitalOmega]/\[Gamma] = \>\"", ",", " ", 
                 "\[CapitalOmega]"}], "}"}], "]"}], ",", " ", "10"}], "]"}], ",",
             " ", 
            RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
            RowBox[{"FrameStyle", " ", "->", " ", 
             RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
            RowBox[{"FrameMargins", " ", "->", " ", "2"}]}], "]"}], ",", " ", 
          
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.97"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"synPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"synPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"Ket", "[", 
           RowBox[{"{", "\"\<000\>\"", "}"}], "]"}], "]"}], ",", " ", 
         RowBox[{"UnitVector", "[", 
          RowBox[{"8", ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"HoldForm", "[", 
           RowBox[{"Divide", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Ket", "[", 
               RowBox[{"{", "\"\<000\>\"", "}"}], "]"}], " ", "+", " ", 
              RowBox[{"I", " ", 
               RowBox[{"Ket", "[", 
                RowBox[{"{", "\"\<100\>\"", "}"}], "]"}]}]}], ",", " ", 
             RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{"8", ",", " ", "1"}], "]"}], " ", "+", " ", 
            RowBox[{"I", " ", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"8", ",", " ", "5"}], "]"}]}]}], ")"}], "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "4"}], "}"}], ",", " ", "1"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "synPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Last", "[", 
        RowBox[{"synPanels", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", " ", "Dashed"}], "]"}], "}"}], ",", " ", 
         RowBox[{
         "{", "\"\<closed equation from the flip term alone\>\"", "}"}]}], 
        "]"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[42]:= ",
 CellID->1996901633,ExpressionUUID->"2f637c7e-0a98-bb25-598b-c7f7c643db34"],

Cell[TextData[{
 "The flip term closes with no remainder, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "."], 
    StyleBox["s", "TI"]], "=", 
   StyleBox["\[Gamma]", "TI"], "(", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     SuperscriptBox[
      StyleBox["s", "TI"], "\[Prime]"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     SuperscriptBox[
      StyleBox["s", "TI"], "\[Prime]"]], "-", "4", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["s", "TI"]]}], ")", "=", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", "4", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["s", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21619318-2385-cf62-27f6-bf6aa61df916"],
 ", so every sector relaxes to ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0be1f3bb-57e9-456b-7fce-d8bea6d69331"],
 " at rate ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61752a10-9cf2-6c9b-4ee7-619dea5de0b9"],
 " whatever coherences the start carries. The drive term has no closed \
equation: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["X", "TI"], "1"], ",", 
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["s", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0738e18d-5b64-2113-455b-5cbe0dc6918d"],
 " is orthogonal to every projector yet nonzero, so it reads the coherences \
between sectors, and once ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "\[NotEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49bff186-50a1-5959-05ad-764f3e3d9f60"],
 " the full evolution leaves the dashed curves, soonest from the \
superposition."
}], "Text",
 CellID->1172544731,ExpressionUUID->"608670ba-47f9-b5d6-1eaa-588e568576af"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->575723684,ExpressionUUID->"092eca4c-ebfd-dc52-6e4e-0c4493edb4fb"],

Cell["A parametric oscillator as a Langevin process in phase space", \
"Subsection",
 CellID->2092821110,ExpressionUUID->"5c0e86cc-1077-a18b-7507-e9d26f72eba8"],

Cell[TextData[{
 "A cavity mode of frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a45dfd2-2d22-db3c-61b2-a750ef00abf1"],
 " is pumped at ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc75de7-39c7-b5e3-281c-5bd69bacc680"],
 " by a classical field that creates photons in pairs with strength ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46f33ecb-7715-9a6a-562c-d59b235d8383"],
 ", and leaks photons at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e79a054-c421-6c4f-08c1-07b67b14fe38"],
 ". Can classical random trajectories in phase space reproduce the noise of \
its quantum steady state?"
}], "Text",
 CellID->1925920113,ExpressionUUID->"4e9bd86a-e9ee-45b5-0dee-d07c4265b559"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "489c9707-0caa-2558-7f32-1abdb24e061b"],
 ", the Hamiltonian, and its form in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ef3dcab-ed71-77bc-7c6d-950c0ebd908c"],
 ", are"
}], "Text",
 CellID->314502351,ExpressionUUID->"0c77e75d-e804-fda3-6f55-d5837d876a86"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox[
     RowBox[{
      StyleBox["i", "TI"], "\[Epsilon]"}], "2"], "(", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      RowBox[{"\[Dagger]", "2"}]], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", "2", 
       StyleBox["i", "TI"], 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["p", "TI"]], 
       StyleBox["t", "TI"]}]], "-", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "2"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"2", 
       StyleBox["i", "TI"], 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["p", "TI"]], 
       StyleBox["t", "TI"]}]]}], ")", "\[ThickSpace]", "\[LongRightArrow]", 
    "\[ThickSpace]", "\[CapitalDelta]", "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox[
     RowBox[{
      StyleBox["i", "TI"], "\[Epsilon]"}], "2"], "(", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      RowBox[{"\[Dagger]", "2"}]], "-", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "2"]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["c", "TI"]], "-", 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["p", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->195787063,ExpressionUUID->"13c11fc3-24a0-cd28-09a1-9e1b71fdd968"],

Cell[TextData[{
 "with the loss ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4effab73-1c05-5c1f-7d14-7ccc3722bfba"],
 " in the Lindblad equation. In the quadratures ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "271c2f0e-fe8e-fab5-110c-74fd29acac41"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["i", "TI"], 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b0658fd-f336-14a7-6144-0c3e230eac5f"],
 ", a quadratic ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "538c922c-c5a4-2079-1eb8-a3c1340e4224"],
 " and a linear loss make the Wigner function obey an exact Fokker-Planck \
equation, which is the law of an It\[OHat] process ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r",
    FontWeight->"Bold",
    FontSlant->"Plain"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "537cd6bc-5a14-b2c4-4e64-03c674ecbb69"],
 " driven by two independent Wiener processes:"
}], "Text",
 CellID->598157926,ExpressionUUID->"44ce514e-ae39-1218-4946-8f167155325a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", 
     StyleBox["t", "TI"]], 
    StyleBox["W", "TI"], "=", "-", "\[Del]", "\[CenterDot]", "(", 
    RowBox[{
     StyleBox["J", "TI"], 
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["W", "TI"]}], ")", "+", 
    FractionBox[
     StyleBox["\[Kappa]", "TI"], "4"], 
    SuperscriptBox["\[Del]", "2"], 
    StyleBox["W", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]", "\[DoubleLongLeftRightArrow]",
     "\[NonBreakingSpace]\[NonBreakingSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    StyleBox["J", "TI"], 
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     RowBox[{
      StyleBox["\[Kappa]", "TI"], "/", "2"}]], "\[ThickSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["w",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["J", "TI"], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"\[Epsilon]", "-", 
          StyleBox["\[Kappa]", "TI"], "/", "2"}], "\[CapitalDelta]"},
        {
         RowBox[{"-", "\[CapitalDelta]"}], 
         RowBox[{"-", "\[Epsilon]", "-", 
          StyleBox["\[Kappa]", "TI"], "/", "2"}]}
       }], ")"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1697802771,ExpressionUUID->"5c1f5c9d-9a92-6bc0-6b13-76f6d736ba8e"],

Cell[TextData[{
 "The steady-state condition ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["\[Sigma]", "TI"], "+", 
   StyleBox["\[Sigma]", "TI"], 
   SuperscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["T", "TI"]], "+", 
   FractionBox[
    StyleBox["\[Kappa]", "TI"], "2"], 
   StyleBox["I", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37f17196-0770-a86b-11f3-06bba3ecc8a8"],
 " gives the covariance matrix ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7857b9d0-b6cd-6b86-397d-c6cfebe0dc44"],
 " in closed form; 400 trajectories of the It\[OHat] process start from the \
origin, and the master equation evolves the vacuum on 30 Fock levels, both to \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], 
   StyleBox["t", "TI"], "=", "40"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2af67e8a-7f74-232c-18be-3011ec353162"],
 "; each panel shows the trajectory end points and the ellipses ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["T", "TI"]], 
   SuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    RowBox[{"-", "1"}]], 
   StyleBox["r",
    FontWeight->"Bold",
    FontSlant->"Plain"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e03e65c-2364-aada-7f71-2e6c14a17a7e"],
 " of their sample covariance and of the master equation's covariance matrix, \
with rates in units of ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064fde84-e25c-9589-1234-1e2ab566fd38"],
 ":"
}], "Text",
 CellID->1957202297,ExpressionUUID->"208bb108-4469-293b-025c-2a7a8a8f98f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"opoA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "30", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"opoJ", "[", 
    RowBox[{"\[CurlyEpsilon]_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CurlyEpsilon]", " ", "-", " ", 
        RowBox[{"1", "/", "2"}]}], ",", " ", "\[CapitalDelta]"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "\[CapitalDelta]"}], ",", " ", 
       RowBox[{
        RowBox[{"-", "\[CurlyEpsilon]"}], " ", "-", " ", 
        RowBox[{"1", "/", "2"}]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"opoCloud", "[", 
    RowBox[{"\[CurlyEpsilon]_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"ItoProcess", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"opoJ", "[", 
              RowBox[{"\[CurlyEpsilon]", ",", " ", "\[CapitalDelta]"}], "]"}],
              " ", ".", " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "p"}], "}"}]}], ",", " ", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"1", "/", "2"}], "]"}], " ", 
             RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "p"}], "}"}], ",", " ", "t"}], "]"}], ",", 
        "\n", "     ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "40", ",", " ", "0.05"}], "}"}], ",", " ", 
        "400"}], "]"}], "[", 
      RowBox[{"\"\<SliceData\>\"", ",", " ", "40"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"opoSigma", "[", 
    RowBox[{"\[CurlyEpsilon]_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"CovarianceMatrix", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalDelta]", " ", 
         RowBox[{
          RowBox[{"SuperDagger", "[", "opoA", "]"}], " ", "@", " ", 
          "opoA"}]}], " ", "+", " ", 
        RowBox[{"I", " ", 
         RowBox[{"\[CurlyEpsilon]", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"SuperDagger", "[", "opoA", "]"}], " ", "@", " ", 
            RowBox[{"SuperDagger", "[", "opoA", "]"}]}], " ", "-", " ", 
           RowBox[{"opoA", " ", "@", " ", "opoA"}]}], ")"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", "opoA", "}"}], " ", "->", " ", 
        RowBox[{"{", "1", "}"}]}], ",", "\n", "     ", 
       RowBox[{"FockState", "[", 
        RowBox[{"0", ",", " ", "30"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "40"}], "}"}]}], "]"}], "[", 
     "40", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"opoEllipse", "[", "\[Sigma]_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"MatrixPower", "[", 
        RowBox[{"\[Sigma]", ",", " ", 
         RowBox[{"1", "/", "2"}]}], "]"}], " ", ".", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "u", "]"}], ",", " ", 
         RowBox[{"Sin", "[", "u", "]"}]}], "}"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}], ",", " ", 
       RowBox[{"Pi", "/", "60"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"opoPanel", "[", 
    RowBox[{"\[CurlyEpsilon]_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cloud", " ", "=", " ", 
        RowBox[{"opoCloud", "[", 
         RowBox[{"\[CurlyEpsilon]", ",", " ", "\[CapitalDelta]"}], "]"}]}], ",",
        " ", 
       RowBox[{"\[Sigma]", " ", "=", " ", 
        RowBox[{"opoSigma", "[", 
         RowBox[{"\[CurlyEpsilon]", ",", " ", "\[CapitalDelta]"}], "]"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cloud", ",", " ", 
         RowBox[{"opoEllipse", "[", "\[Sigma]", "]"}], ",", " ", 
         RowBox[{"opoEllipse", "[", 
          RowBox[{"Covariance", "[", "cloud", "]"}], "]"}], ",", " ", 
         RowBox[{"opoEllipse", "[", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"Joined", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "False", ",", " ", "True", ",", " ", "True", ",", " ", "True"}], 
         "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "0.006", "]"}], ",", " ", "Thick", ",", 
          " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", "Dashed"}], "]"}], ",", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", "Dotted"}], "]"}]}], "}"}]}], ",", "\n",
        "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Langevin end points\>\"", ",", 
          " ", "\"\<master equation\>\"", ",", 
          " ", "\"\<Langevin covariance\>\"", ",", " ", "\"\<vacuum\>\""}], 
         "}"}]}], ",", "\n", "    ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<\[CurlyEpsilon]/\[Kappa] = \>\"", ",", " ", 
                 "\[CurlyEpsilon]", ",", 
                 " ", "\"\<,  \[CapitalDelta]/\[Kappa] = \>\"", ",", " ", 
                 "\[CapitalDelta]"}], "}"}], "]"}], ",", " ", "10"}], "]"}], ",",
             " ", 
            RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
            RowBox[{"FrameStyle", " ", "->", " ", 
             RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
            RowBox[{"FrameMargins", " ", "->", " ", "2"}]}], "]"}], ",", " ", 
          
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.97"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"opoPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"opoPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.2", ",", " ", "0.4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"Map", "[", 
       RowBox[{"First", ",", " ", "opoPanels", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "620"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"opoPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[43]:= ",
 CellID->292826501,ExpressionUUID->"0e0cfbec-c02b-6c75-4cfc-123104b3d47c"],

Cell[TextData[{
 "In every panel the ellipse of the Langevin end points lies on the master \
equation's: the Fokker-Planck equation is exact for a quadratic ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dbe4811-38f5-3be9-0125-e4938c05d495"],
 ", so a cloud of classical random walkers carries the steady-state Wigner \
function, vacuum noise included. The pump stretches the cloud along one \
quadrature and pulls it inside the vacuum circle along the other, more \
strongly at the larger ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6727a0fa-0044-1d78-6ecb-ad828f0851ba"],
 ", and detuning tilts the squeezed axis and weakens the squeezing. The \
closed form diverges where its denominator ",
 Cell[BoxData[
  RowBox[{"1", "+", "4", 
   SuperscriptBox["\[CapitalDelta]", "2"], "-", "4", 
   SuperscriptBox["\[Epsilon]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7096096c-8aac-6576-4b76-c5f0bed6bd0a"],
 " vanishes: above the threshold ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[Epsilon]", "2"], "=", 
   SuperscriptBox[
    StyleBox["\[Kappa]", "TI"], "2"], "/", "4", "+", 
   SuperscriptBox["\[CapitalDelta]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "535b6506-42a1-859a-46f7-e2bddd1d74ec"],
 " no steady state exists."
}], "Text",
 CellID->2125497565,ExpressionUUID->"02af0a4b-0162-50d3-5a40-c1b8e6abc71f"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1470571867,ExpressionUUID->"7d2b45bf-dd76-a89b-4bd6-5c2faa7b165e"],

Cell["A tetrahedron measurement on an unknown qubit", "Subsection",
 CellID->1541041306,ExpressionUUID->"3a1a36b2-7ac1-1be0-22b6-54f29782dc70"],

Cell[TextData[{
 "A qubit is in an unknown state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15286a93-15e1-6486-21ef-feac7c9e3e07"],
 ", pure when ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42ff15ec-d7b6-1025-62f7-a48eee3b0b41"],
 ", and a single detector with four outcomes measures it. What do the four \
outcome probabilities reveal about the state?"
}], "Text",
 CellID->572862704,ExpressionUUID->"3ebb417d-08df-2782-24f4-ee05d599cb1b"],

Cell[TextData[{
 "The detector is the symmetric informationally complete POVM of a qubit: \
four effects ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], 
    StyleBox["i", "TI"]], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Ket"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37603cfd-d667-6990-678c-0ca464357a26"],
 " with ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05485646-89f6-d155-71a4-cf1220d1ba5e"],
 " and equal overlaps ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], 
          StyleBox["j", "TI"]]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   FractionBox["1", "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18dc104f-ff7b-80a2-4d43-bb7679618e00"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[NotEqual]", 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a736c36-3880-b230-2718-e9e871eae545"],
 ", whose Bloch vectors are the vertices of a regular tetrahedron. Here the \
first vertex is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], "1"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f844d22-fc96-e0e7-7e75-dd02c356a767"],
 "; the other three are ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["k", "TI"]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"0"},
       "Ket"], "+", 
      RowBox[{
       SqrtBox["2"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         StyleBox["i", "TI"], 
         SubscriptBox[
          StyleBox["\[Chi]", "TI"], 
          StyleBox["k", "TI"]]}]], 
       TemplateBox[{"1"},
        "Ket"]}]}], ")"}], "/", 
    SqrtBox["3"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "468acce3-76c4-840a-7cf7-a66754aecb64"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Chi]", "TI"], "2"], ",", 
    SubscriptBox[
     StyleBox["\[Chi]", "TI"], "3"], ",", 
    SubscriptBox[
     StyleBox["\[Chi]", "TI"], "4"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox[
     RowBox[{"4", "\[Pi]"}], "3"], ",", 
    FractionBox[
     RowBox[{"2", "\[Pi]"}], "3"], ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a848374-5ccd-cfde-4d02-ba23ba5e03b4"],
 ". The Born rule gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a70701-0f8f-5082-7f85-a316cac298cf"],
 "."
}], "Text",
 CellID->775350673,ExpressionUUID->"5a063f5c-b1a0-e928-0f87-e3addf6a3bc1"],

Cell[TextData[{
 "Applied to a general ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c9dcc77-326a-a088-0c11-77916df59a5e"],
 ", the Born rule recovers ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c7eeec-fe99-2337-1229-30056a275b12"],
 " from the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45bdc21e-0128-9a53-00b9-6c8b40ae8bd8"],
 "; applied to general ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "364615c8-4d03-d720-1f62-d8bce03794a2"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b56834a-dd04-6c00-189f-c30aba6c3db5"],
 ", it maps each probability over the sphere of pure states:"
}], "Text",
 CellID->1302506098,ExpressionUUID->"73da7581-2b4e-8442-094f-03fd2cde8f7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sicE", " ", "=", " ", 
   RowBox[{"Normal", " ", "/@", " ", 
    RowBox[{
     RowBox[{
     "QuantumMeasurementOperator", "[", "\"\<TetrahedronSICPOVM\>\"", "]"}], 
     "[", "\"\<POVMElements\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sicN", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"#", "/", 
        RowBox[{"Tr", "[", "#", "]"}]}], "]"}], "[", "\"\<BlochVector\>\"", 
      "]"}], " ", "&"}], " ", "/@", " ", "sicE"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sicBorn", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", 
            RowBox[{"\"\<BlochVector\>\"", "[", "r", "]"}], "]"}], 
           "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", ".", " ", "#"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "sicE"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sicP", " ", "=", " ", 
   RowBox[{"sicBorn", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sicPanels", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GeoDensityPlot", "[", 
      RowBox[{
       RowBox[{"Rule", " ", "@@", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"GeoPosition", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"90", " ", "-", " ", 
                   RowBox[{"\[Theta]v", " ", 
                    RowBox[{"180", "/", "Pi"}]}]}], ",", " ", 
                  RowBox[{
                   RowBox[{"\[CurlyPhi]v", " ", 
                    RowBox[{"180", "/", "Pi"}]}], " ", "-", " ", "180"}]}], 
                 "}"}], "]"}], ",", " ", 
               RowBox[{"#", " ", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"\[Theta]", " ", "->", " ", "\[Theta]v"}], ",", " ", 
                  RowBox[{"\[CurlyPhi]", " ", "->", " ", "\[CurlyPhi]v"}]}], 
                 "}"}]}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\[Theta]v", ",", " ", "0", ",", " ", "Pi", ",", " ", 
               RowBox[{"Pi", "/", "40"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\[CurlyPhi]v", ",", " ", "0", ",", " ", 
               RowBox[{"2", " ", "Pi"}], ",", " ", 
               RowBox[{"Pi", "/", "40"}]}], "}"}]}], "]"}], ",", " ", "1"}], 
          "]"}], "]"}]}], ",", "\n", "     ", 
       RowBox[{"GeoProjection", " ", "->", " ", "\"\<Hammer\>\""}], ",", " ", 
       
       RowBox[{"GeoBackground", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"OpacityFunction", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"GeoGridLines", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"GeoGridLinesStyle", " ", "->", " ", "Gray"}], ",", "\n", 
       "     ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}], " ", "&"}], " ",
     "/@", " ", "sicP"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sicLabel", "[", "i_", "]"}], " ", ":=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<p\>\"", ",", " ", "i"}], "]"}], ",", 
        " ", "\"\< = (1 + \>\"", ",", " ", 
        RowBox[{"OverVector", "[", "\"\<r\>\"", "]"}], ",", 
        " ", "\"\<\[CenterDot]\>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{
          RowBox[{"OverVector", "[", "\"\<n\>\"", "]"}], ",", " ", "i"}], 
         "]"}], ",", " ", "\"\<)/4\>\""}], "}"}], "]"}], ",", " ", "13", ",", 
     " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Labeled", "[", 
             RowBox[{
              RowBox[{"First", "[", "#1", "]"}], ",", " ", 
              RowBox[{"sicLabel", "[", 
               RowBox[{"First", "[", "#2", "]"}], "]"}], ",", " ", "Top"}], 
             "]"}], " ", "&"}], ",", " ", "sicPanels"}], "]"}], ",", " ", 
         "2"}], "]"}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"Last", "[", 
        RowBox[{"First", "[", "sicPanels", "]"}], "]"}], ",", " ", "Right"}], 
      "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<for \>\"", ",", " ", 
        RowBox[{"OverVector", "[", "\"\<r\>\"", "]"}], ",", 
        " ", "\"\< = (x, y, z):   \>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<p\>\"", ",", " ", "1"}], "]"}], ",", " ", "\"\< + \>\"",
         ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<p\>\"", ",", " ", "2"}], "]"}], ",", " ", "\"\< + \>\"",
         ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<p\>\"", ",", " ", "3"}], "]"}], ",", " ", "\"\< + \>\"",
         ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<p\>\"", ",", " ", "4"}], "]"}], ",", " ", "\"\< = \>\"",
         ",", " ", 
        RowBox[{"Simplify", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"sicBorn", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "]"}], "]"}], 
         "]"}], ",", "\n", "    ", "\"\<,   3 \[CapitalSigma] \>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<p\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{
          RowBox[{"OverVector", "[", "\"\<n\>\"", "]"}], ",", 
          " ", "\"\<i\>\""}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{"3", " ", 
          RowBox[{
           RowBox[{"sicBorn", "[", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "]"}], " ", ".",
            " ", "sicN"}]}], "]"}]}], "}"}], "]"}], ",", " ", "13", ",", " ", 
     
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[44]:= ",
 CellID->219680269,ExpressionUUID->"1db155a0-bc12-b494-1d0b-2c1670f5b04f"],

Cell[TextData[{
 "Each probability is ",
 Cell[BoxData[
  FractionBox["1", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ffe0ae-7db7-3e04-45be-001626ab5277"],
 " plus a linear function of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6750d0df-424f-02b7-6de4-99a190a59a57"],
 ", largest, ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1106402f-6c12-2e15-7216-4ec4b47b64f3"],
 ", at its own vertex and zero at the opposite point, and the four sum to one \
for every state. Inverting that linear map, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "=", "3", 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "\[RightVector]"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f0a07e7-b5ff-0e7d-3e2c-7c3da8df8cdc"],
 " returns the Bloch vector of any state, mixed or pure: one measurement \
setting determines the state."
}], "Text",
 CellID->2095861829,ExpressionUUID->"013dc06a-0875-ce4c-29ab-809cae2e476b"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1866772333,ExpressionUUID->"3e24880d-63e8-97a9-507e-52183b990751"],

Cell["State tomography from finite counts", "Subsection",
 CellID->805821437,ExpressionUUID->"3583dc8d-99ca-9c45-256d-33333999f9db"],

Cell[TextData[{
 "An unknown qubit state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a290021-b468-4190-0a76-b187751dce23"],
 " is measured on ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f48f9f1-3380-bacc-3fa7-e9caa3d4f4f0"],
 " copies in each of the three Pauli bases, and the state is estimated from \
the counts. How does the error of the estimate fall with ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "684b2a7a-bfae-821d-077c-867579bc3618"],
 " for a maximally mixed and for a pure state?"
}], "Text",
 CellID->1559947742,ExpressionUUID->"78465b66-4bf2-3a00-09da-cb208c81a74e"],

Cell[TextData[{
 "In setting ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e35b8ba-cd35-ee02-7d53-b1a69ecc0f1f"],
 " the counts ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "\[PlusMinus]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c2313c-d4f9-72db-421b-b602d84bab65"],
 " give ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["k", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[TildeTilde]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], "+"], "-", 
    SubscriptBox[
     StyleBox["n", "TI"], "-"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51562702-4f40-6705-508a-a979960366e0"],
 ", each an average of ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "273d2c74-a717-de9c-5ec7-8f84c6d378cf"],
 " outcomes ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d99c937-b20f-682d-60dc-fa9ae89290a6"],
 " with variance ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03cd48be-c246-3755-45e3-cbbd4681863f"],
 ", so the linear-inversion estimate has mean squared error ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dececa5-750e-48ba-67c4-61aa9f83cbdf"],
 ". For a pure state the estimate is held inside the Bloch ball, which \
removes the outward half of the error along ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e421015-a0ac-31e9-5174-5768965f27ca"],
 ": ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{"2", "-", 
    FractionBox["1", "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     UnderscriptBox["\[Sum]", 
      StyleBox["k", "TI"],
      LimitsPositioning->False], 
     SubsuperscriptBox[
      StyleBox["r", "TI"], 
      StyleBox["k", "TI"], "4"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")", "/", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023b7267-38d3-7ab8-71d7-d69222bbb8e8"],
 ". The estimator used here inverts the Born rule linearly, makes the result \
a valid state, and then climbs the likelihood of the counts by random steps, \
so the estimate is always a state."
}], "Text",
 CellID->1666922708,ExpressionUUID->"07d73953-ef3a-04de-29a9-f4dd2efc0888"],

Cell[TextData[{
 "The counts come from a true ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38722bc1-c7eb-bcb9-7cb7-2026946b9150"],
 " off every measurement axis, along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"4", ",", "3"}], ",", "8.5"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d2f7253-33cc-2eab-1cfa-9c28c24f604a"],
 "; the figure plots ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["N", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40403d79-8092-6e3a-1584-9671fff494fa"],
 " times the root-mean-square error ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["r", "TI"], "\[RightVector]"], 
       StyleBox[
        RowBox[{"e", "s", "t"}], "TI"]], "-", 
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "543532a1-b818-41a3-6636-dd174ed431ac"],
 " over 100 runs, against these two references (dashed); a flat curve means \
the error falls as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["N", "TI"], 
   RowBox[{"-", "1", "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3357b825-3302-beb1-540c-a9e68555fada"],
 ":"
}], "Text",
 CellID->1650855363,ExpressionUUID->"76b6e788-b7b7-daaa-7e15-be7de6ede226"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tomoOps", " ", "=", " ", 
   RowBox[{"QuantumMeasurementOperator", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tomoNs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"30", ",", " ", "300", ",", " ", "3000"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tomoErr", "[", "len_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"len", " ", 
          RowBox[{"Normalize", "[", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "3", ",", " ", "8.5"}], "}"}], "]"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"n", " ", 
             RowBox[{"Mean", " ", "@", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Norm", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"QuantumStateEstimate", "[", 
                    RowBox[{"QuantumMeasurementSimulation", "[", 
                    RowBox[{
                    RowBox[{"QuantumState", "[", 
                    RowBox[{"\"\<BlochVector\>\"", "[", "r", "]"}], "]"}], ",",
                     " ", "tomoOps", ",", " ", "n"}], "]"}], "]"}], "[", "\n",
                     "          ", "\"\<MaximumLikelihoodState\>\"", "]"}], 
                    "[", "\"\<BlochVector\>\"", "]"}], " ", "-", " ", "r"}], 
                  "]"}], "^", "2"}], ",", " ", "100"}], "]"}]}]}], "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "tomoNs"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tomoLens", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"tomoErr", " ", "/@", " ", "tomoLens"}], ",", " ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"len", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"3", " ", "-", " ", 
              RowBox[{"len", "^", "2"}], " ", "-", " ", 
              RowBox[{
               RowBox[{"len", "^", "2"}], " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", " ", "-", " ", 
                  RowBox[{"Total", "[", 
                   RowBox[{
                    RowBox[{"Normalize", "[", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", " ", "3", ",", " ", "8.5"}], "}"}], 
                    "]"}], "^", "4"}], "]"}]}], ")"}], "/", "2"}]}]}], 
             "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", "tomoNs"}]}], "]"}], 
      " ", "/@", " ", "tomoLens"}]}], "]"}], ",", " ", 
   RowBox[{"ScalingFunctions", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Log\>\"", ",", " ", "None"}], "}"}]}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "Automatic", ",", " ", "Automatic", ",", " ", "None", ",", " ", "None"}],
      "}"}]}], ",", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "Automatic", ",", " ", "Automatic", ",", " ", "Dashed", ",", " ", 
      "Dashed"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "2"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<|r| = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", "&"}],
        " ", "/@", " ", "tomoLens"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<projected linear-inversion reference, |r| = \>\"", ",",
            " ", "#"}], "}"}], "]"}], " ", "&"}], " ", "/@", " ", 
       "tomoLens"}]}], "]"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<shots per setting N\>\"", ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\"\<N\>\"", "]"}], ",", 
         " ", "\"\< \[Times] rms Bloch-vector error\>\""}], "}"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}]}], "]"}]}], "Input",
 CellLabel->"In[45]:= ",
 CellID->1512509229,ExpressionUUID->"238df6a6-de6e-fe15-5a70-dc32a5280e6d"],

Cell[TextData[{
 "Both curves are flat, so the error falls as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["N", "TI"], 
   RowBox[{"-", "1", "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c58d96f-f8ae-2296-0d5c-e519633fde96"],
 ", and each scatters about its reference. The pure state is estimated more \
accurately at every ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b8a642a-19f5-4882-56fc-3d42fb9b20fa"],
 ", partly because its outcomes are less random and partly because the \
estimate cannot leave the Bloch ball."
}], "Text",
 CellID->1169625615,ExpressionUUID->"21d8de33-8821-2206-4916-b1ceea06cfe2"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1918215688,ExpressionUUID->"65f43fc3-6eba-a49e-79dd-304ba240420d"],

Cell["Process tomography of a decaying qubit", "Subsection",
 CellID->461593182,ExpressionUUID->"28b1537f-dfbb-a8a4-6e0b-1360009034c6"],

Cell[TextData[{
 "A qubit relaxes from ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27dd59da-1e82-3588-164a-1f968ed4901f"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "570d9607-2154-778c-4c05-ca3d445f1d48"],
 " with probability ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34f7c60d-d6d5-eb02-5b59-c8a9a1a2059f"],
 ". The channel is treated as unknown: four probe states go through it, and \
each output is reconstructed from ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47f96892-5976-acca-5f09-5ebddb66e64d"],
 " shots per Pauli setting. How does the reconstructed channel approach the \
true one as ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12a68989-9059-7b91-7ddc-0015f43e2d23"],
 " grows?"
}], "Text",
 CellID->1783166340,ExpressionUUID->"1253cba2-444f-b5d6-7923-0f4831c39aa1"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], 
     TemplateBox[{"0"},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{"1"},
      "Ket"], 
     TemplateBox[{"1"},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c04b793-15eb-cd2e-142c-1b1079a453b9"],
 ", the amplitude-damping channel has Kraus operators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "^"], "0"], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], 
     TemplateBox[{"0"},
      "Bra"]}], "+", 
    RowBox[{
     SqrtBox[
      RowBox[{"1", "-", 
       StyleBox["\[Gamma]", "TI"]}]], 
     TemplateBox[{"1"},
      "Ket"], 
     TemplateBox[{"1"},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d4de303-7c6f-0eec-0f4a-ceac4b9286a5"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "^"], "1"], "=", 
   RowBox[{
    SqrtBox[
     StyleBox["\[Gamma]", "TI"]], 
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"1"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07daa957-e5f4-999b-3e2a-fe8c2fb45e0f"],
 ". Any qubit channel acts on Bloch vectors as ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "\[Function]", 
   StyleBox["T", "TI"], 
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "+", 
   OverscriptBox[
    StyleBox["c", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f318fc2-8a30-2a61-2d18-a22087f550d5"],
 ". The probes ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", 
   TemplateBox[{"1"},
    "Ket"], ",", 
   TemplateBox[{"+"},
    "Ket"], ",", 
   TemplateBox[{
     RowBox[{"+", 
       StyleBox["i", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dec074c-2cdf-e40c-1fba-0f47602517ac"],
 " have Bloch vectors ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["z", "TI"], "^"], ",", 
   RowBox[{"-", 
    OverscriptBox[
     StyleBox["z", "TI"], "^"]}], ",", 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], ",", 
   OverscriptBox[
    StyleBox["y", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b44bb60-116f-f4ad-6f4f-3ebc745bb263"],
 ", so their outputs give"
}], "Text",
 CellID->979603465,ExpressionUUID->"47db281d-5625-6915-00cf-38b4b3b7a70e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["c", "TI"], "\[RightVector]"], "=", 
    FractionBox["1", "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"], "0"], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"], "1"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["T", "TI"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["r", "TI"], "\[RightVector]"], "+"], "-", 
        OverscriptBox[
         StyleBox["c", "TI"], "\[RightVector]"]}], ",", " ", " ", 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["r", "TI"], "\[RightVector]"], 
         RowBox[{"+", 
          StyleBox["i", "TI"]}]], "-", 
        OverscriptBox[
         StyleBox["c", "TI"], "\[RightVector]"]}], ",", " ", " ", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          SubscriptBox[
           OverscriptBox[
            StyleBox["r", "TI"], "\[RightVector]"], "0"], "-", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["r", "TI"], "\[RightVector]"], "1"]}], 
         StyleBox[")",
          SpanMaxSize->1]}]}]}], ")"}], " ", 
     StyleBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], "columns", 
       StyleBox[")",
        SpanMaxSize->1]}],
      FontSlant->"Plain"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1336720477,ExpressionUUID->"00967e83-cff1-a185-6a66-ce5cf32f011b"],

Cell[TextData[{
 "with each output ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3043ffcc-f027-25f5-43d7-3531268655a3"],
 " estimated by maximum likelihood from the counts."
}], "Text",
 CellID->2076424842,ExpressionUUID->"10dc1200-121a-90c7-6c1e-e7cb5a3c462d"],

Cell[TextData[{
 "The figure draws the image of the input great circle in the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d572ebd-ed34-7735-1146-5fc1a68456f1"],
 " plane under the reconstructed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["T", "TI"], ",", 
    OverscriptBox[
     StyleBox["c", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d300885-e0f5-0650-5c0e-74b602180081"],
 " and under the exact channel:"
}], "Text",
 CellID->1516117956,ExpressionUUID->"3cf93609-7818-3afd-7046-b82af5f0e0f9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ptProbes", " ", "=", " ", 
   RowBox[{"QuantumState", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<0\>\"", ",", " ", "\"\<1\>\"", ",", " ", "\"\<Plus\>\"", ",",
       " ", "\"\<Right\>\""}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ptOps", " ", "=", " ", 
   RowBox[{"QuantumMeasurementOperator", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ptMap", "[", 
    RowBox[{"{", 
     RowBox[{"r0_", ",", " ", "r1_", ",", " ", "rp_", ",", " ", "ri_"}], 
     "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r0", " ", "+", " ", "r1"}], ")"}], "/", "2"}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rp", " ", "-", " ", "c"}], ",", " ", 
          RowBox[{"ri", " ", "-", " ", "c"}], ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r0", " ", "-", " ", "r1"}], ")"}], "/", "2"}]}], "}"}], 
        "]"}], ",", " ", "c"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ptCurve", "[", 
    RowBox[{"{", 
     RowBox[{"tm_", ",", " ", "c_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"tm", " ", ".", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Alpha]", "]"}], ",", " ", "0", ",", " ", 
         RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], "}"}]}], " ", "+", " ", 
      "c"}], ")"}], "[", 
    RowBox[{"[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ptOut", "[", 
    RowBox[{"\[Gamma]_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "n", "]"}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"QuantumStateEstimate", "[", 
          RowBox[{"QuantumMeasurementSimulation", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"QuantumChannel", "[", 
              RowBox[{"\"\<AmplitudeDamping\>\"", "[", "\[Gamma]", "]"}], 
              "]"}], "[", "#", "]"}], ",", " ", "ptOps", ",", " ", "n"}], 
           "]"}], "]"}], "[", "\"\<MaximumLikelihoodState\>\"", "]"}], 
        "[", "\"\<BlochVector\>\"", "]"}], " ", "&"}], " ", "/@", " ", 
      "ptProbes"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ptNs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"30", ",", " ", "300", ",", " ", "3000"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ptPanel", "[", "\[Gamma]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"exact", " ", "=", " ", 
        RowBox[{"ptMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QuantumChannel", "[", 
              RowBox[{"\"\<AmplitudeDamping\>\"", "[", "\[Gamma]", "]"}], 
              "]"}], "[", "#", "]"}], "[", "\"\<BlochVector\>\"", "]"}], " ", 
           "&"}], " ", "/@", " ", "ptProbes"}], "]"}]}], ",", " ", 
       RowBox[{"rec", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"ptMap", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"ptOut", "[", 
             RowBox[{"\[Gamma]", ",", " ", "#"}], "]"}], "]"}], "]"}], " ", 
          "&"}], " ", "/@", " ", "ptNs"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"ptCurve", " ", "/@", " ", "rec"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ptCurve", "[", "exact", "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", "\[Alpha]", "]"}], ",", " ", 
              RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], "}"}]}], "}"}]}], 
         "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", " ", "0", ",", " ", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
          "Dashed", ",", " ", "Dotted"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<N = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
            "&"}], " ", "/@", " ", "ptNs"}], ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<exact channel\>\"", ",", 
            " ", "\"\<input great circle\>\""}], "}"}]}], "]"}]}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<z\>\""}], "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", "\n", "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<\[Gamma] = \>\"", ",", " ", "\[Gamma]"}], "}"}], 
               "]"}], ",", " ", "10"}], "]"}], ",", " ", 
            RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
            RowBox[{"FrameStyle", " ", "->", " ", 
             RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
            RowBox[{"FrameMargins", " ", "->", " ", "2"}]}], "]"}], ",", " ", 
          
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.97"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ptPanels", " ", "=", " ", 
   RowBox[{"ptPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", " ", "0.5", ",", " ", "0.8"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "ptPanels"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "ptPanels", "]"}], "]"}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[46]:= ",
 CellID->991448093,ExpressionUUID->"5c2809dc-e00f-276d-4964-f266dafd380f"],

Cell[TextData[{
 "The exact channel shrinks the circle to an ellipse pulled toward ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf3d211-071a-7698-470c-58552e749599"],
 " at the top, flatter along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46b2565b-ba9e-1cf5-387d-393de198798f"],
 " than along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27179ce7-8cff-0d69-7dbf-1a437af308a3"],
 ", and smaller as ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17b54961-b8bd-0b0a-515a-327fe81dca12"],
 " grows. The reconstruction error falls as ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bedafb2-7c24-c7fd-5a09-c6feb91e3b42"],
 " grows. The exact image touches the sphere at ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5913a136-b2e1-1743-0d38-1100ead4e461"],
 " with the sphere's own curvature, so the reconstruction errors carry part \
of the image of the sphere outside the Bloch ball, by less as ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09db3de1-f8bb-644e-23b0-cb492c411a0d"],
 " grows: although every output it was built from is a state, the \
reconstructed map is not a channel."
}], "Text",
 CellID->390341740,ExpressionUUID->"543404d6-5276-e0b5-4234-d3f01fa8e1b1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1772228778,ExpressionUUID->"5df7e25f-893a-6e12-6e27-c27662f58506"],

Cell["Undoing a measurement while its record survives", "Subsection",
 CellID->140501601,ExpressionUUID->"1a574ae1-d056-520c-66c7-fa2b6e7df499"],

Cell[TextData[{
 "A qubit in ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Theta]", "TI"], "2"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Phi]"}], "TI"]], 
     StyleBox["sin",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Theta]", "TI"], "2"], 
     TemplateBox[{"1"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6323b527-f353-1313-6407-e3c3d87bd1fe"],
 " is measured in the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49dc7a1b-f0bb-f811-2b98-582fec3f4a2d"],
 " basis, and the outcome is written on a pointer qubit instead of being \
read. Before the measurement is reversed, the environment partly decoheres \
the pointer, at strength ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "180af65a-bc49-ac9c-5b9b-dc5618fb8a5a"],
 ". How much of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a58c52a-b58d-b1d3-268b-68387664408c"],
 " does the reversal return?"
}], "Text",
 CellID->474244502,ExpressionUUID->"1b4cd190-e266-2dd1-1603-17b54019cafe"],

Cell[TextData[{
 "The measurement is the isometry ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["V", "TI"], "^"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["P", "TI"], "^"], 
      StyleBox["k", "TI"]], 
     RowBox[{
      TemplateBox[{
        StyleBox["\[Psi]", "TI"]},
       "Ket"], "\[CircleTimes]", 
      SubscriptBox[
       TemplateBox[{
         StyleBox["k", "TI"]},
        "Ket"], 
       StyleBox["P", "TI"]]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8d710a-47ad-4fad-290d-861b921c1905"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], 
    StyleBox["k", "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["k", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["k", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35bb1b53-3b2b-7842-0669-9b649870c8b1"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["V", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["V", "TI"], "^"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2989d7d3-9f50-f00b-02d1-91d1b4a94c6c"],
 ", so ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["V", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23033e5e-9e04-80fb-3535-e666cc2f403c"],
 " is its exact left inverse. Between the two, phase damping ",
 Cell[BoxData[
  SubscriptBox["\|01d49f", 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bee87cd-017b-f0f3-0f60-dc1ac64fa7c5"],
 " acts on the pointer with Kraus operators ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"0"},
     "Bra"]}], "+", 
   RowBox[{
    SqrtBox[
     RowBox[{"1", "-", 
      StyleBox["\[Lambda]", "TI"]}]], 
    TemplateBox[{"1"},
     "Ket"], 
    TemplateBox[{"1"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2feff1bf-11a7-39c2-3d1e-37135201753a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Lambda]", "TI"]], 
   TemplateBox[{"1"},
    "Ket"], 
   TemplateBox[{"1"},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "680297e4-2d22-3a8a-6623-b0ae0e3055a6"],
 ", which multiply the record's coherence by ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"1", "-", 
    StyleBox["\[Lambda]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51b41fd3-b1b5-03bb-5688-99bc11e675f6"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b6ea86-8b25-e087-662a-8074e3f819fb"],
 " keeps the record intact and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "373a8cc2-9aac-f240-69fd-6cda5fc8ea69"],
 " erases its coherence. From ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69077da0-e1f0-bc8a-3be6-ee0702dbf0c1"],
 " the returned state is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], "=", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["V", "TI"], "^"], "\[Dagger]"], "\[ThinSpace]", 
   SubscriptBox["\|01d49f", 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["V", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["V", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["V", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ca953a2-4fc9-731e-4733-ca03f49f4d85"],
 ", with fidelity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox[
      RowBox[{"o", "u", "t"}], "TI"]], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69344492-45cc-71bb-1b22-d6672ff8db2c"],
 "."
}], "Text",
 CellID->789196777,ExpressionUUID->"08892af8-60b9-cce8-3233-32b0589e4ce2"],

Cell[TextData[{
 "The measurement's dilation ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["V", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304b1f67-e3c1-7d39-6e50-c0fdff3a03ea"],
 " puts its pointer on wire 2, and measure, damp, un-measure run as one \
circuit for general ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d33b10c-1d16-7a96-7d78-8104217ec472"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6039b814-548c-0922-209b-91f26331d065"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1247149c-5073-3ae1-6bb3-d42b9b847aed"],
 "; ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"o", "u", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "410f32e0-1884-140b-1efc-c27f47c1e6dd"],
 " and ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31403397-cfc5-2c36-0eb6-9da17132683d"],
 " come out in closed form:"
}], "Text",
 CellID->1106041681,ExpressionUUID->"134af0b6-fac7-782d-41c0-f44d3fc2fc8e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"umPsi", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "\[CurlyPhi]"}], "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"umV", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumMeasurementOperator", "[", 
       RowBox[{"{", "1", "}"}], "]"}], "[", "\"\<SuperOperator\>\"", "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"umRho", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{"umV", ",", " ", 
        RowBox[{"QuantumChannel", "[", 
         RowBox[{
          RowBox[{"\"\<PhaseDamping\>\"", "[", "\[Lambda]", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"umV", "[", "\"\<Dagger\>\"", "]"}]}], "}"}], "]"}], "[", 
     "umPsi", "]"}], "[", "\"\<DensityMatrix\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"umRhoOut", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Normal", "[", "umRho", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "}"}], " ", "\[Element]",
        " ", "Reals"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<=", " ", "\[Lambda]", " ", "<=", " ", "1"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"umF", " ", "=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"ComplexExpand", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{"umPsi", "[", "\"\<StateVector\>\"", "]"}], "]"}], "]"}],
            " ", ".", " ", "umRhoOut", " ", ".", " ", 
           RowBox[{"Normal", "[", 
            RowBox[{"umPsi", "[", "\"\<StateVector\>\"", "]"}], "]"}]}], 
          "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "}"}], " ", "\[Element]",
            " ", "Reals"}], " ", "&&", " ", 
          RowBox[{"0", " ", "<=", " ", "\[Lambda]", " ", "<=", " ", "1"}]}]}],
         "]"}], " ", "/.", "\n", "     ", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Theta]"}], "]"}], " ", "->", " ", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}]}], "]"}], ",",
      " ", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], ",", " ", 
     "Simplify"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Style", "[", 
  RowBox[{
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<\[Rho]\>\"", ",", " ", "\"\<out\>\""}], "]"}], ",", 
          " ", "\"\< = \>\"", ",", " ", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"MatrixForm", "[", "umRhoOut", "]"}], "]"}]}], "}"}], 
        "]"}], ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<F = \>\"", ",", " ", 
          RowBox[{"TraditionalForm", "[", "umF", "]"}]}], "}"}], "]"}]}], 
      "}"}], ",", " ", "Center", ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}], ",", " ", "14", ",", 
   " ", 
   RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[47]:= ",
 CellID->1271044621,ExpressionUUID->"543ac1fc-0d03-64d9-7adb-2e3f311263c5"],

Cell["The fidelity is plotted against the input's polar angle:", "Text",
 CellID->254279889,ExpressionUUID->"144bb0d9-637b-5c78-1dd7-3625ea51b64e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"um\[Lambda]s", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0.36", ",", " ", "0.75", ",", " ", "1"}], "}"}]}],
   ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"umF", " ", "/.", " ", 
     RowBox[{"\[Lambda]", " ", "->", " ", "um\[Lambda]s"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0.45", ",", " ", "1.02"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<fidelity F\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Pi", "/", "4"}], ",", " ", 
          RowBox[{"Pi", "/", "2"}], ",", " ", 
          RowBox[{"3", " ", 
           RowBox[{"Pi", "/", "4"}]}], ",", " ", "Pi"}], "}"}], ",", " ", 
        "None"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Lambda] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
       "&"}], " ", "/@", " ", "um\[Lambda]s"}], ")"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[48]:= ",
 CellID->1979172420,ExpressionUUID->"1285dbd6-dd4c-ec46-4a09-18f5c4230671"],

Cell[TextData[{
 "The reversal returns ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20df215b-3578-a906-3b74-cb874cd410a9"],
 " with its populations intact and its coherence multiplied by ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"1", "-", 
    StyleBox["\[Lambda]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2832e2a4-40cb-e9ee-58ec-2ebc25f2d98c"],
 ": decohering the record dephases the qubit, so ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7347a605-563b-17ec-6c64-582eb1a47254"],
 " does not depend on ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b4d4b02-bfa5-4945-2961-9104d52e27e8"],
 " and with the record intact every input returns exactly. As the record \
decoheres, the poles, which the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57e17c14-48ba-a92c-3525-81adc6194d31"],
 " measurement does not disturb, still return intact while the equator loses \
most; at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22a1c686-d1bf-2df2-71ca-d93e7d9ceca5"],
 " the equatorial fidelity is ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58356a4e-e83d-fe58-3658-ec56430bdad8"],
 ", the value left by a completed measurement."
}], "Text",
 CellID->1824958391,ExpressionUUID->"6dd73621-e11e-2a2d-027c-e46d7a7d9331"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1513822381,ExpressionUUID->"6b8e5159-2259-abb0-3e9c-9de4facd52de"],

Cell["Randomized benchmarking: the decay of sequence fidelity", "Subsection",
 CellID->1313380668,ExpressionUUID->"27cdc669-97fe-e83f-5f86-3c792cfb0f73"],

Cell[TextData[{
 "A qubit starts in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31d56d00-71ff-3e1d-2f38-e0521ca09fb6"],
 ", undergoes ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6084f931-75d8-4406-3d60-975c8aa04eaa"],
 " Clifford gates drawn at random and then the Clifford that undoes their \
product, and is measured; every gate is followed by the same noise. The noise \
is amplitude damping, which drops ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4291d9ae-bdc3-7a1c-60c1-c8fa7b512894"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417e3181-a1e2-b89a-080f-87e8965526dc"],
 " with probability ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d5f8004-40be-5985-24cb-1a653b077f13"],
 ", or a coherent over-rotation ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], "\[Epsilon]", 
    StyleBox["X", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58b48839-b5b6-750a-792c-0b94da289dc0"],
 " with ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af09d35-15bd-3d24-582c-29f0bec56837"],
 " chosen so that both noises have the same average gate fidelity ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35d5bb10-25f3-89a2-70d8-25904f3c6ebd"],
 ". How does the survival probability, the chance of finding ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08aa56c9-a7f2-a607-2cfb-3cb68042dc75"],
 " at the end, decay with ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b281a47-02a6-455e-71d8-8525cdccb559"],
 "?"
}], "Text",
 CellID->623383732,ExpressionUUID->"4570879f-d0a3-d8ee-2a13-c7738351ff2f"],

Cell[TextData[{
 "Any qubit channel moves the Bloch vector as ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "\[Function]", 
   StyleBox["M", "TI"], 
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "+", 
   OverscriptBox[
    StyleBox["c", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24d3f7cd-4a9c-0a36-334c-7fbd94515521"],
 ". The 24 Cliffords act on ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5663b66f-7088-feb2-1da8-13ff577b2acb"],
 " as the rotations of a cube, and averaging the noise over them, which the \
random sequence does, leaves a depolarizing map that shrinks ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3675c779-7279-978a-4af0-8ce2f8155094"],
 " by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["M", "TI"], "/", "3", "=", "2", 
   StyleBox["F", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7906461f-d704-1239-110b-624cac27c779"],
 ". With the final noise left over, the mean survival is exactly"
}], "Text",
 CellID->2056806778,ExpressionUUID->"700fbb73-c49f-c013-69d2-ac962d1517dc"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["m", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox["1", "2"], "(", 
    RowBox[{"1", "+", 
     SubscriptBox[
      StyleBox["c", "TI"], 
      StyleBox["z", "TI"]], "+", 
     SubscriptBox[
      StyleBox["M", "TI"], 
      StyleBox[
       RowBox[{"z", "z"}], "TI"]], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["m", "TI"]]}], ")", "=", 
    StyleBox["A", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["m", "TI"]], "+", 
    StyleBox["B", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1240090152,ExpressionUUID->"2088de29-77a7-5886-174c-83f6425e0010"],

Cell[TextData[{
 "For damping ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SqrtBox[
     RowBox[{"1", "-", 
      StyleBox["\[Gamma]", "TI"]}]], ",", 
    SqrtBox[
     RowBox[{"1", "-", 
      StyleBox["\[Gamma]", "TI"]}]], ",", 
    RowBox[{"1", "-", 
     StyleBox["\[Gamma]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "328d18e8-91a2-6e54-6350-6ef73d515c25"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["c", "TI"], "\[RightVector]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"0", ",", "0"}], ",", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00183e3a-dfa2-0fce-5f6b-a282f85ae45c"],
 "; for the rotation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["M", "TI"], "=", "1", "+", "2", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[Epsilon]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "491c91eb-af38-5c1c-1510-2cc867e258b4"],
 ", so equal ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54d25738-494c-5740-5523-58520a1b2869"],
 " means ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[Epsilon]", "=", 
   SqrtBox[
    RowBox[{"1", "-", 
     StyleBox["\[Gamma]", "TI"]}]], "-", 
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36212f39-4f29-9316-4017-9a5105a1fc8b"],
 "."
}], "Text",
 CellID->1621024691,ExpressionUUID->"163816ba-ed54-d29b-0d1d-01461ed7160d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e70a31b-efe0-a11d-54fc-41de0453239a"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dffa3c9-987c-3d97-1be8-059fefad7a59"],
 " of each noise come from its action on Bloch states; the survival is \
averaged over 50 random sequences at each ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f8e4e89-727b-57fe-0517-f5fe546ccdaf"],
 ", in three independent runs (markers), against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["m", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e1dfb8-912e-8de7-6fe6-1e4ba6e17bac"],
 " (dashed):"
}], "Text",
 CellID->719818017,ExpressionUUID->"7d95dee9-8995-e653-45e1-28d723b3fb9f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cliffordRB", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"DiagonalMatrix", "[", "#1", "]"}], " ", ".", " ", "#2"}], 
          " ", "&"}], ",", " ", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}], ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{"Permutations", "[", 
          RowBox[{"IdentityMatrix", "[", "3", "]"}], "]"}], ",", " ", "1"}], 
        "]"}], ",", " ", "1"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Det", "[", "#", "]"}], " ", "==", " ", "1"}], " ", "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"blochMapRB", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"QuantumState", "[", 
          RowBox[{"\"\<BlochVector\>\"", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}], "]"}], 
         "]"}], "[", "\"\<BlochVector\>\"", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"QuantumState", "[", 
              RowBox[{"\"\<BlochVector\>\"", "[", "#", "]"}], "]"}], "]"}], 
            "[", "\"\<BlochVector\>\"", "]"}], " ", "-", " ", "c"}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], ",", " ", "c"}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"survivalRB", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mm_", ",", " ", "c_"}], "}"}], ",", " ", "m_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"seq", " ", "=", " ", 
        RowBox[{"RandomChoice", "[", 
         RowBox[{"cliffordRB", ",", " ", "m"}], "]"}]}], ",", " ", 
       RowBox[{"step", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"mm", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{"#2", " ", ".", " ", "#1"}], ")"}]}], " ", "+", " ", 
          "c"}], " ", "&"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"Last", "[", 
         RowBox[{"step", "[", 
          RowBox[{
           RowBox[{"Fold", "[", 
            RowBox[{"step", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
             "seq"}], "]"}], ",", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Dot", " ", "@@", " ", 
             RowBox[{"Reverse", "[", "seq", "]"}]}], "]"}]}], "]"}], "]"}]}], 
       ")"}], "/", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"decayRB", "[", 
     RowBox[{"{", 
      RowBox[{"mm_", ",", " ", "c_"}], "}"}], "]"}], "[", "m_", "]"}], " ", ":=",
    " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"c", "[", 
       RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"mm", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Tr", "[", "mm", "]"}], "/", "3"}], ")"}], "^", "m"}]}]}], 
     ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelRB", "[", 
    RowBox[{"noise_", ",", " ", "title_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"map", " ", "=", " ", 
        RowBox[{"Chop", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"N", "[", 
           RowBox[{"blochMapRB", "[", "noise", "]"}], "]"}], "]"}], "]"}]}], ",",
        " ", 
       RowBox[{"ms", " ", "=", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"1", ",", " ", "61", ",", " ", "4"}], "]"}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"BlockRandom", "[", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "run", "]"}], ";", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#", ",", " ", 
                 RowBox[{"Mean", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"survivalRB", "[", 
                    RowBox[{"map", ",", " ", "#"}], "]"}], ",", " ", "50"}], 
                   "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
              "ms"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"run", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "8"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"decayRB", "[", "map", "]"}], "[", "m", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "61"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.4", ",", " ", "1.01"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<m\>\"", ",", " ", "\"\<survival\>\""}], "}"}]}], ",", 
       " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", "\n", "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Framed", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Column", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"title", ",", " ", 
                  RowBox[{"Row", "[", 
                   RowBox[{"{", 
                    RowBox[{"\"\<p = Tr M/3 = \>\"", ",", " ", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Tr", "[", 
                    RowBox[{"First", "[", "map", "]"}], "]"}], "/", "3"}], ",",
                     " ", "3"}], "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
                RowBox[{"Alignment", " ", "->", " ", "Right"}]}], "]"}], ",", 
              " ", "10"}], "]"}], ",", " ", 
            RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
            RowBox[{"FrameStyle", " ", "->", " ", 
             RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
            RowBox[{"FrameMargins", " ", "->", " ", "2"}]}], "]"}], ",", "\n",
           "      ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.97"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]sRB", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "/", "20"}], ",", " ", 
     RowBox[{"1", "/", "5"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsRB", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"panelRB", "[", 
        RowBox[{
         RowBox[{"QuantumChannel", "[", 
          RowBox[{"\"\<AmplitudeDamping\>\"", "[", "#", "]"}], "]"}], ",", 
         " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<damping, \[Gamma] = \>\"", ",", " ", "#"}], "}"}], 
          "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", "\[Gamma]sRB"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"panelRB", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<RX\>\"", "[", 
           RowBox[{"ArcCos", "[", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"1", " ", "-", " ", "#"}], "]"}], " ", "-", " ", 
             RowBox[{"#", "/", "2"}]}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<over-rotation matched to \[Gamma] = \>\"", ",", " ", 
            "#"}], "}"}], "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
      "\[Gamma]sRB"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{"panelsRB", ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "700"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PointLegend", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
          RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<run 1\>\"", ",", " ", "\"\<run 2\>\"", ",", 
           " ", "\"\<run 3\>\""}], "}"}], ",", " ", 
         RowBox[{"LegendMarkers", " ", "->", " ", "Automatic"}]}], "]"}], ",",
        "\n", "   ", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ",
             "Dashed"}], "]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<P(m) = A \>\"", ",", " ", 
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<p\>\"", ",", " ", "\"\<m\>\""}], "]"}], ",", 
             " ", "\"\< + B\>\""}], "}"}], "]"}], "}"}]}], "]"}]}], "}"}], 
     "]"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[49]:= ",
 CellID->149078220,ExpressionUUID->"09aff923-032f-43be-0955-ba3a26592bd2"],

Cell[TextData[{
 "In each column the mean survival of the two noises falls at the same rate: \
averaging over random Cliffords keeps only ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39a13e8f-1287-fee5-19a5-8032f2cb2231"],
 " of the noise. The floors differ: damping pulls toward ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b31bac3-466c-c7af-3dc0-efa3ae6390ff"],
 " and holds long sequences above ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4da31b57-b626-e912-3dde-78388ea2a07f"],
 ", while the rotation, which has no shift ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["c", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fd0e4c1-4324-6ac4-0c97-ef716fe7f710"],
 ", settles at ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b9cb9eb-75c3-7a55-6e02-c093538b8ce0"],
 ". The rotation's runs scatter more, because within one sequence coherent \
errors can add up or cancel, and only the average over sequences follows the \
exponential."
}], "Text",
 CellID->1804992986,ExpressionUUID->"67fedb4d-423d-cac4-403f-ece188f5fbf2"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1569019346,ExpressionUUID->"3edc381f-dbf8-3974-3be7-c02f1659cb68"],

Cell["Two qubits entangled by a measurement alone", "Subsection",
 CellID->1900592021,ExpressionUUID->"7779e814-124a-f90a-313a-b5f6afd3edcb"],

Cell[TextData[{
 "Two qubits that never interact are read by one probe, a half-parity meter: \
its output ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d858db-9c0c-21db-1939-668a57f32926"],
 ", averaged over a window ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c8029ca-b5ce-4823-0148-186ec9b082b3"],
 ", is Gaussian about ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "716121e7-615e-6ac5-3ac9-648c81b7e1ee"],
 " for ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64595ecb-dc4f-cfdf-73e4-d5af0e752473"],
 ", ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b1eabdb-f01d-03d5-1aad-6d23b9671c37"],
 " for ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71f43715-43f5-6f6e-1712-82b7876b3cba"],
 " and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e5b7dea-1e85-5a59-5d01-931708e48362"],
 " for both ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "177ffad4-26e6-e78d-557d-6a3acf882bfc"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abbe786-9617-8ef0-320a-869368a2f87e"],
 ", with white noise of spectral density ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fa38420-7c88-4b74-4018-1553cc9f3c6f"],
 ", and the meter also dephases the odd pair at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25fb86c4-56a8-d172-5829-fab151a88a5f"],
 ". Starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], 
   TemplateBox[{"+"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "228cfa67-3f80-f288-226d-023ea1e9c814"],
 ", can the record alone entangle the pair?"
}], "Text",
 CellID->2042972589,ExpressionUUID->"65251ced-949c-4b2e-26f6-60abf4f7b17c"],

Cell[TextData[{
 "A window leaves a reading of variance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", 
   StyleBox["s", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[CapitalDelta]", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08be578c-4e18-df50-342b-0fa04256866b"],
 ". Coherences between states the meter tells apart are assumed to dephase \
fast, so the state keeps five numbers ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"00", ",", "00"}]], ",", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"01", ",", "01"}]], ",", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"10", ",", "10"}]], ",", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"11", ",", "11"}]], ",", GridBox[{
      {
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        RowBox[{"01", ",", "10"}]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58dd4611-79e6-3cd3-3a8b-609b1678096c"],
 ", and Korotkov's quantum Bayes rule updates them for each reading:"
}], "Text",
 CellID->989807480,ExpressionUUID->"791a2df7-c238-10b1-1761-2a0a56304159"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["i", "TI"]], "\[Rule]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["i", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["j", "TI"], "=", "1"}], "4",
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]], 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["j", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]], " ", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], "\[LessEqual]", "4"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "5"], "\[Rule]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "5"], 
      SubscriptBox[
       StyleBox["P", "TI"], "2"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["\[Gamma]", "TI"], "\[CapitalDelta]", 
        StyleBox["t", "TI"]}]]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["j", "TI"], "=", "1"}], "4",
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]], 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["j", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["i", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["V", "TI"], "-", 
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["i", "TI"]]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"], "/", "2", 
      StyleBox["D", "TI"]}]]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["v", "TI"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       RowBox[{"-", 
        StyleBox["\[Delta]", "TI"], 
        StyleBox["v", "TI"]}], ",", "0", ",", "0", ",", 
       StyleBox[
        RowBox[{"\[Delta]", "v"}], "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->616437651,ExpressionUUID->"6ef9331d-8a33-e37e-1b25-d848a2a8fd8d"],

Cell[TextData[{
 "On the states this rule produces, the Wootters concurrence is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", 
   RowBox[{"2", 
    StyleBox["max",
     FontSlant->"Plain"], "\[ThinSpace]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "\[ThinSpace]", 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], "5"], "-", 
       SqrtBox[
        RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], 
         SubscriptBox[
          StyleBox["x", "TI"], "4"]}]]}]}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f06332-4f97-143d-2a9d-1af076f8dc08"],
 ". Gaussian likelihoods multiply, so from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], 
   TemplateBox[{"+"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b4b472c-8b98-2782-789f-66d7a71ed6be"],
 " a record enters only through its running mean ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["V", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f4cf316-37eb-a7e7-7b98-4464bbfa7202"],
 ", and after a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14955533-2367-2e65-56bd-fa96d8bb292c"]
}], "Text",
 CellID->1678034594,ExpressionUUID->"59210c19-1d90-f863-2203-d73cc298c94c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["C", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["V", "TI"], "_"], ",", 
      StyleBox["t", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    StyleBox["max",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0", ",", " ", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Gamma]", "TI"], 
           StyleBox["t", "TI"]}]], "-", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Delta]", "TI"], 
           SuperscriptBox[
            StyleBox["v", "TI"], "2"], 
           StyleBox["t", "TI"], "/", 
           StyleBox["s", "TI"]}]]}], 
        RowBox[{"1", "+", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Delta]", "TI"], 
           SuperscriptBox[
            StyleBox["v", "TI"], "2"], 
           StyleBox["t", "TI"], "/", 
           StyleBox["s", "TI"]}]], 
         StyleBox["cosh",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"2", 
          StyleBox["\[Delta]", "TI"], 
          StyleBox["v", "TI"], "\[ThinSpace]", 
          OverscriptBox[
           StyleBox["V", "TI"], "_"], 
          StyleBox["t", "TI"], "/", 
          StyleBox["s", "TI"]}], 
         StyleBox[")",
          SpanMaxSize->1]}]]}], ")"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->775251273,ExpressionUUID->"081461f5-8722-c860-0133-94720655a615"],

Cell[TextData[{
 "Five records per panel follow the update rule (lines), with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["V", "TI"], "_"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c02b455-aa7e-df59-12c8-07b1ac0a6540"],
 " marked at each record's own ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["V", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6404acc6-2c0b-831f-56bd-854f30cf0d62"],
 " (markers) and its ceiling ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b8cf5b-22ce-6fa5-2000-fd098baad0bf"],
 " dashed; time is in units of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "/", 
   StyleBox["\[Delta]", "TI"], 
   SuperscriptBox[
    StyleBox["v", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7147bdc3-9eff-72df-679f-fec50c398be3"],
 ":"
}], "Text",
 CellID->416754414,ExpressionUUID->"1341da9b-3088-daca-62fb-8f9c8b498605"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hpmUpdate", "[", 
    RowBox[{
    "x_", ",", " ", "v_", ",", " ", "dv_", ",", " ", "var_", ",", " ", 
     "gdt_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "dv"}], ",", " ", "0", ",", " ", "0", ",", " ", 
               "dv"}], "}"}], " ", "-", " ", "v"}], ")"}], "^", "2"}]}], "/", 
         
         RowBox[{"(", 
          RowBox[{"2", " ", "var"}], ")"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"x", ",", " ", "4"}], "]"}], " ", "p"}], ",", " ", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", "5", "]"}], "]"}], " ", 
         RowBox[{"p", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "gdt"}], "]"}]}]}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"x", ",", " ", "4"}], "]"}], " ", ".", " ", "p"}], ")"}]}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmConc", "[", 
    RowBox[{"vb_", ",", " ", "\[Tau]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], " ", "\[Tau]"}], "]"}], " ", "-", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Delta]v", "^", "2"}]}], " ", 
        RowBox[{"\[Tau]", "/", "s"}]}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[Delta]v", "^", "2"}]}], " ", 
         RowBox[{"\[Tau]", "/", "s"}]}], "]"}], " ", 
       RowBox[{"Cosh", "[", 
        RowBox[{"2", " ", "\[Delta]v", " ", "vb", " ", 
         RowBox[{"\[Tau]", "/", "s"}]}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmC", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Ramp", "[", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "5", "]"}], "]"}], " ", "-", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", 
        RowBox[{"x", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hpmDt", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"hpmVar", " ", "=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "hpmDt"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmRun", "[", 
    RowBox[{"gs_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", " ", "=", " ", 
            RowBox[{
             RowBox[{"RandomChoice", "[", 
              RowBox[{
               RowBox[{"Take", "[", 
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], ",", " ", "4"}], "]"}], 
               " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1."}], ",", " ", "0.", ",", " ", "0.", ",", 
                 " ", "1."}], "}"}]}], "]"}], " ", "+", " ", 
             RowBox[{"RandomVariate", "[", 
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"Sqrt", "[", "hpmVar", "]"}]}], "]"}], "]"}]}]}], 
           "}"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"hpmUpdate", "[", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], ",", " ", "v", ",", " ", "1.",
               ",", " ", "hpmVar", ",", " ", 
              RowBox[{"gs", " ", "hpmDt"}]}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], " ", "+", " ", "v"}]}], "}"}]}],
          "]"}], " ", "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.25", ",", " ", "5"}], "]"}], ",", " ", "0."}], "}"}], ",",
        " ", 
       RowBox[{"Round", "[", 
        RowBox[{"5", "/", "hpmDt"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmPanel", "[", "gs_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"runs", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"hpmRun", "[", 
           RowBox[{"gs", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Range", "[", "5", "]"}]}]}], ",", " ", 
       RowBox[{"conc", " ", "=", " ", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vb", ",", " ", "\[Tau]"}], "}"}], ",", " ", 
          RowBox[{"Ramp", "[", 
           RowBox[{
            RowBox[{"hpmConc", "[", 
             RowBox[{"vb", ",", " ", "\[Tau]"}], "]"}], " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Delta]v", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"s", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"\[Gamma]", " ", "->", " ", "gs"}]}], "}"}]}], "]"}]}], 
         "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"hpmC", " ", "/@", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], " ", "&"}], " ",
           "/@", " ", "runs"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"k", " ", "hpmDt"}], ",", " ", 
               RowBox[{"conc", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"k", " ", "+", " ", "1"}], ",", " ", "2"}], "]"}],
                    "]"}], "/", "k"}], ",", " ", 
                 RowBox[{"k", " ", "hpmDt"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "25", ",", " ", 
               RowBox[{"Round", "[", 
                RowBox[{"5", "/", "hpmDt"}], "]"}], ",", " ", "25"}], "}"}]}],
             "]"}], " ", "&"}], " ", "/@", " ", "runs"}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "9"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"conc", "[", 
          RowBox[{"0", ",", " ", "\[Tau]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", " ", "Dashed", ",", " ", "Thick"}], "]"}]}], ",",
          " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<\[Delta]v\>\"", ",", " ", "2"}], "]"}], ",", 
             " ", "\"\<t/s\>\""}], "}"}], "]"}], ",", 
          " ", "\"\<concurrence C\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Gamma] s/\>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<\[Delta]v\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\< = \>\"", ",", " ", "gs"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"hpmPanel", " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0.3", ",", " ", "1.5"}], "}"}]}], "}"}], ",",
        " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<each color: one record\>\"", ",", "\n", "    ", 
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"{", "Gray", "}"}], ",", " ", 
           RowBox[{"{", "\"\<concurrence from the update rule\>\"", "}"}]}], 
          "]"}], ",", " ", 
         RowBox[{"PointLegend", "[", 
          RowBox[{
           RowBox[{"{", "Gray", "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<C(\>\"", ",", " ", 
               RowBox[{"OverBar", "[", "\"\<V\>\"", "]"}], ",", 
               " ", "\"\<, t) at the record's running mean\>\""}], "}"}], 
             "]"}], "}"}], ",", " ", 
           RowBox[{"LegendMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "9"}], "}"}]}]}], 
          "]"}], ",", "\n", "    ", 
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed", ",", " ", "Thick"}], "]"}], 
            "}"}], ",", " ", 
           RowBox[{"{", "\"\<ceiling C(0, t)\>\"", "}"}]}], "]"}]}], "}"}], 
       "]"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<ceiling:  \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{
          RowBox[{"hpmConc", "[", 
           RowBox[{"0", ",", " ", "t"}], "]"}], " ", "/.", " ", 
          RowBox[{
           RowBox[{"Exp", "[", "e_", "]"}], " ", ":>", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<e\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<-\>\"", ",", " ", 
                RowBox[{"-", "e"}]}], "}"}], "]"}]}], "]"}]}]}], "]"}], ",", 
        " ", "\"\<  =  \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"hpmConc", "[", 
             RowBox[{"0", ",", " ", "t"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], 
          "]"}], "]"}], ",", " ", "\"\< + O(\>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<t\>\"", ",", " ", "2"}], "]"}], ",", " ", "\"\<)\>\""}],
        "}"}], "]"}], ",", "\n", "   ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[50]:= ",
 CellID->721125552,ExpressionUUID->"1a19b25e-79d5-fc95-61cf-72ba2a4cf166"],

Cell[TextData[{
 "Each record's concurrence lands on the closed form at its own running mean: \
records that settle near ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["V", "TI"], "_"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46eac520-483d-508b-1631-2e432288428d"],
 " press against the dashed ceiling, while records pushed toward ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ebcc85-87a0-8dfb-1b86-136b5335d6ed"],
 " lose their concurrence. The ceiling starts with slope ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4619b4ac-1c3d-e92c-0fc1-1254980ccf21"],
 ": without dephasing it climbs toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1537a5e3-c577-f5ea-2402-9f6d54f30a1d"],
 ", with weak dephasing it peaks and falls, and once ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["s", "TI"], ">", 
   StyleBox["\[Delta]", "TI"], 
   SuperscriptBox[
    StyleBox["v", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f58d00-23bf-1c5e-2efb-3120f7916bf1"],
 " its numerator stays negative and no record entangles the pair."
}], "Text",
 CellID->460863017,ExpressionUUID->"74278649-516d-be20-2bd8-6cfc067cacac"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1687507410,ExpressionUUID->"23f1223a-6871-a607-4209-e799cb28430f"],

Cell["GHZ against product probes when every qubit dephases", "Subsection",
 CellID->1832340146,ExpressionUUID->"1277c470-efa8-98b2-467b-5b71a31e7311"],

Cell[TextData[{
 "A frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aa09759-ff90-f704-3503-7148f4e2a737"],
 " is written on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56fbac10-5a76-12d0-08e8-812f8471c85b"],
 " qubits, each dephasing independently at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c0197b-33a8-315a-4df2-49fb7b8250ab"],
 ", by Ramsey runs of length ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6493b306-f5b8-ca85-4b68-3841b1b25482"],
 " repeated over a total time ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e30aa99-418b-7ab0-333e-e0d1041b5138"],
 ". Without noise a GHZ probe has quantum Fisher information ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70a843cb-f10d-3f1f-54f5-0dece9cf57db"],
 " against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76bcddf2-e0da-4ac0-402a-9d8dd90d84de"],
 " for the product probe ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "718ff52c-1030-edf8-0031-c1c6de4e32ad"],
 "; does the GHZ advantage survive once ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e70db46-18ac-66fc-437d-d2c4885dd6b9"],
 " is chosen optimally?"
}], "Text",
 CellID->729105885,ExpressionUUID->"026505c2-2762-4516-0d7d-4c01245fbba9"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5157631f-063a-3e3f-2c77-6ac65d82c6ee"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d740b52-0f0a-5a08-3ead-66b2f2a9bde0"],
 ", each run evolves under"
}], "Text",
 CellID->1322272499,ExpressionUUID->"73e3053a-5d88-0cd5-79f3-86217b4bfdde"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["k", "TI"], "=", "1"}], 
       StyleBox["n", "TI"],
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["k", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    StyleBox["\[Gamma]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], 
     StyleBox["n", "TI"],
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->245486753,ExpressionUUID->"47d8debc-a47c-8ec7-459b-10cc5e79ffdc"],

Cell[TextData[{
 "which damps each qubit's coherence as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "2", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a4fead2-5c8c-0cfb-15d7-11027035a52a"],
 ". The ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9c4dd7-6ece-a412-1787-681779b8ce29"],
 " runs carry information ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["T", "TI"], "/", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "143a4571-238d-2302-3ec1-4329bd3a26e9"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"]], "=", 
   RowBox[{"2", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Lambda]", "TI"], 
        StyleBox["i", "TI"]], "+", 
       SubscriptBox[
        StyleBox["\[Lambda]", "TI"], 
        StyleBox["j", "TI"]], ">", "0"}],
      LimitsPositioning->False], 
     RowBox[{
      SuperscriptBox[GridBox[{
         {
          RowBox[{
           TemplateBox[{
             StyleBox["i", "TI"]},
            "Bra"], 
           RowBox[{
            SubscriptBox["\[PartialD]", 
             StyleBox["\[Omega]", "TI"]], 
            StyleBox["\[Rho]", "TI"]}], 
           TemplateBox[{
             StyleBox["j", "TI"]},
            "Ket"]}]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], 
         StyleBox["i", "TI"]], "+", 
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], 
         StyleBox["j", "TI"]]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e7a03a9-85d8-2ecf-721b-73843673d249"],
 " over the eigenpairs ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["i", "TI"]], ",", 
    TemplateBox[{
      StyleBox["i", "TI"]},
     "Ket"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ec35aa2-89f3-a3d5-5530-771f1dcf7277"],
 " of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47add0fd-1f3e-b9ff-7a72-162dc8ba7119"],
 "; the noise commutes with the phase, so ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["Q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d78572d-c947-36d1-67e8-c3240348af2e"],
 " does not depend on ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40a150e1-a8f0-4a32-3578-34497d639223"],
 " and is taken at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a5156ed-3147-bbb5-2421-12d1bca939b4"],
 "."
}], "Text",
 CellID->1002263134,ExpressionUUID->"4bd037ff-ef8f-c73f-3193-879fcfc48e4b"],

Cell[TextData[{
 "The GHZ coherence decays as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "2", 
    StyleBox["n", "TI"], 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5536d11c-86f1-525d-57dc-6a7afa575ad8"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"], 
    StyleBox[
     RowBox[{"G", "H", "Z"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     StyleBox["n", "TI"], 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f38c483-172a-f97e-4635-8d72df5c4f8e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"], 
    StyleBox[
     RowBox[{"p", "r", "o", "d", "u", "c", "t"}], "TI"]], "=", 
   StyleBox["n", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21f0c94e-1ea0-e7f4-4e27-364e867e583f"],
 ", and the best run lengths ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", 
    StyleBox["n", "TI"], 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "190d840d-dd4a-70aa-22ba-5b0074a2a8e6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f33f626-1927-b1d5-5bff-7855c816ac62"],
 " give"
}], "Text",
 CellID->1973252530,ExpressionUUID->"14322953-b13c-f3ac-480a-0f07961b0c0f"],

Cell[BoxData[
 PaneBox[
