       SpanMaxSize->1], 
      StyleBox["E", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1467770714,ExpressionUUID->"7cde1e56-08be-b338-4802-8b433096827e"],

Cell[TextData[{
 "Summing over all ",
 Cell[BoxData[
  SuperscriptBox["4", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5556039d-5a7f-4f6d-1ae3-934445cc6881"],
 " errors for general ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "163ee62e-5042-3b18-0742-47c5782078a6"],
 ", with each syndrome's most probable class chosen at small ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1350ae0a-ec80-bcfb-4266-4f1cfbe0e70a"],
 ", gives ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21559bb8-bc2f-7071-67f3-701db016203b"],
 " as a polynomial for each decoder; the panels plot ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["L", "TI"]], "/", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fc52fa0-190c-430b-1c67-4b677ecfb683"],
 ", whose value at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "369de988-050e-c26f-19d1-943ce4511c6d"],
 " is the coefficient of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["p", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b5f7ae0-0a29-4fb6-71f0-5719095c839b"],
 ":"
}], "Text",
 CellID->908766975,ExpressionUUID->"2254ae0f-a1a3-a99a-3c8e-bff11368670c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Get", "[", \
"\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/OngoingProjects/QEC/\
QECCore/QECCore.wl\>\"", "]"}], ";", " ", 
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`QEC`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mlDecCases", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", " ", 
          RowBox[{"#2", " ", "<>", " ", "\"\<, depolarizing\>\""}], ",", " ", 
          
          RowBox[{"QECNoiseModel", "[", 
           RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], "}"}], 
        " ", "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<5QubitCode\>\"", ",", " ", "\"\<ShorCode\>\"", ",", 
           " ", "\"\<SteaneCode\>\""}], "}"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<five-qubit code\>\"", ",", " ", "\"\<Shor code\>\"", ",",
            " ", "\"\<Steane code\>\""}], "}"}]}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<SteaneCode\>\"", ",", " ", "\"\<Steane code, Z-biased\>\"",
        ",", " ", 
       RowBox[{"QECNoiseModel", "[", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<X\>\"", " ", "->", " ", 
           RowBox[{"p", "/", "10"}]}], ",", " ", 
          RowBox[{"\"\<Y\>\"", " ", "->", " ", 
           RowBox[{"p", "/", "10"}]}], ",", " ", 
          RowBox[{"\"\<Z\>\"", " ", "->", " ", "p"}]}], "|>"}], "]"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mlDecRates", "[", 
    RowBox[{"code_", ",", " ", "noise_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{"QECLogicalErrorRate", "[", 
       RowBox[{
        RowBox[{"QECCode", "[", "code", "]"}], ",", " ", "noise", ",", " ", 
        RowBox[{"\"\<Decoder\>\"", " ", "->", " ", "#"}]}], "]"}], "]"}], " ",
      "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<MaximumLikelihood\>\"", ",", " ", "\"\<MinimumWeight\>\""}],
      "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mlDecPanel", "[", 
    RowBox[{"{", 
     RowBox[{"code_", ",", " ", "title_", ",", " ", "noise_"}], "}"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"mlDecRates", "[", 
        RowBox[{"code", ",", " ", "noise"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Expand", "[", 
         RowBox[{"r", "/", 
          RowBox[{"p", "^", "2"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "0.2"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<maximum likelihood\>\"", ",", 
          " ", "\"\<lookup table\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
             " ", "\"\< / \>\"", ",", " ", 
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<p\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}]}], 
         "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "360"}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"title", ",", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"SameQ", " ", "@@", " ", "r"}], ",", " ", 
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Subscript", "[", 
                    RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
                   " ", "\"\< = \>\"", ",", " ", 
                   RowBox[{"TraditionalForm", "[", 
                    RowBox[{"First", "[", "r", "]"}], "]"}]}], "}"}], "]"}], ",",
                 "\n", "         ", 
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{"\"\<order \>\"", ",", " ", 
                   RowBox[{"Superscript", "[", 
                    RowBox[{"\"\<p\>\"", ",", " ", "2"}], "]"}], ",", 
                   " ", "\"\<:  \>\"", ",", " ", 
                   RowBox[{"TraditionalForm", "[", 
                    RowBox[{
                    RowBox[{"Coefficient", "[", 
                    RowBox[{
                    RowBox[{"r", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "p", ",", " ", 
                    "2"}], "]"}], " ", 
                    RowBox[{"p", "^", "2"}]}], "]"}], ",", 
                   " ", "\"\<  against  \>\"", ",", " ", 
                   RowBox[{"TraditionalForm", "[", 
                    RowBox[{
                    RowBox[{"Coefficient", "[", 
                    RowBox[{
                    RowBox[{"r", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", "p", ",", " ", 
                    "2"}], "]"}], " ", 
                    RowBox[{"p", "^", "2"}]}], "]"}]}], "}"}], "]"}]}], 
               "]"}]}], "}"}], ",", " ", 
            RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", 
          " ", "12", ",", " ", 
          RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
         "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mlDecPanels", " ", "=", " ", 
   RowBox[{"mlDecPanel", " ", "/@", " ", "mlDecCases"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"First", " ", "/@", " ", "mlDecPanels"}], ",", " ", "2"}], 
      "]"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "mlDecPanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[91]:= ",
 CellID->70446803,ExpressionUUID->"4d292510-3567-bf2d-464b-b0431c9e5f42"],

Cell[TextData[{
 "The five-qubit code gives one polynomial for both decoders: its fifteen \
nonzero syndromes come from the fifteen one-qubit errors, so the lightest \
error already lies in the most probable class. The Shor code is degenerate, \
with many light errors that differ by a check and so share a class, and \
adding up their probabilities is where maximum likelihood lowers the ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["p", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe7fca9-c3c3-980f-6771-4538ad56a25a"],
 " coefficient most. The Steane code gains less, under depolarizing and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58970f22-65a0-48a6-00c5-c113d95b6a08"],
 "-biased noise alike, and in every panel the order of the two curves holds \
over the whole range of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "418646b6-9768-125c-1ba6-2a53a79fc9d2"],
 "."
}], "Text",
 CellID->646510180,ExpressionUUID->"1d460779-37d9-33d1-009d-3036e6a6dbde"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1352692614,ExpressionUUID->"5764331b-50ce-e448-2053-11b982562330"],

Cell["Noise inside the circuit that measures the checks", "Subsection",
 CellID->1077482300,ExpressionUUID->"7dcfaeeb-86b2-2bad-1a52-52d96ce5beec"],

Cell[TextData[{
 "The five-qubit code corrects any one error when its checks are read \
perfectly; the bit-flip and phase-flip codes correct any one error of a \
single type. Here a circuit reads the checks, and every gate, reset and \
readout in it fails with probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "489f0ec6-7f4e-d5fa-615f-07fdda017610"],
 ". What does noise inside the measuring circuit do to the protection the \
code gives?"
}], "Text",
 CellID->125244541,ExpressionUUID->"652774b4-50f7-3e75-3089-266276ab0177"],

Cell[TextData[{
 "Each check ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "411fb5a2-9dc7-0a61-736d-0e0ef925a90e"],
 " is measured with a reset ancilla: every data qubit in the support of ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457a43a3-562e-216b-2fc2-eafd6dc49e23"],
 " is rotated so that its letter becomes ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f634760-6d50-d4e6-2609-df5c9610a596"],
 " (",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2473238c-68cf-2b20-2f03-e4afa1f28858"],
 " for ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02385ff9-6e21-055b-5380-f0ecd46f8f13"],
 "), CNOTs copy those qubits' parity into the ancilla, the rotations are \
undone, and the ancilla is read. After each one-qubit gate ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a33e4ea-d4d6-c091-25ac-1cd76f28216f"],
 ", ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73609610-2251-35ea-0b87-83112351f0a1"],
 " or ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e546d8e-28f4-8faf-37eb-3b1619f5798a"],
 " strikes with probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087058d8-c235-56ea-5050-1339b40edca8"],
 " each, after each CNOT one of the 15 two-qubit Paulis with probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "/", "15"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "228659b8-0a01-f7e1-6c16-b4977bc4f3ca"],
 " each, and each reset and each readout is flipped with probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "790b60df-e1a0-0b5f-6cdc-1460b31c11bc"],
 "; waiting qubits do not err. One noisy round is followed by a perfect \
readout of the data, and the decoder reads the round's syndrome and its \
change at the final readout. The transversal extraction instead measures each \
check through a verified cat state with one qubit per data qubit of ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336c93f9-bf9c-94f5-4aaa-9dceea464dd4"],
 ", each coupled to its data qubit by one two-qubit gate, and keeps only \
shots that pass the verification. As a reference, code capacity puts \
depolarizing noise of rate ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8d2977-e7c3-af8b-3250-9b71e3db8870"],
 " on the data and reads the checks perfectly."
}], "Text",
 CellID->196485571,ExpressionUUID->"78d6a347-c537-196d-2771-7fa1790938a5"],

Cell[TextData[{
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55a093cf-6a28-243f-4318-226f8087ecbf"],
 " for the five-qubit code (checks the cyclic shifts of ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"X", "Z", "Z", "X", "I"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5157620a-2ab0-f61f-0ff0-8e80d5656397"],
 ") is an exact polynomial in ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c780688-e58a-df4d-5b4b-becbda9cc822"],
 ", shown with the transversal rate at six values of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26079929-44f7-0abe-3ad2-4721463b2f8a"],
 "; the second panel plots ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["L", "TI"]], "/", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1abee2bc-7df4-fa20-751c-b5bb936df55f"],
 " for the bit-flip code (checks ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01b320c8-3da9-4347-1859-1b4d57baf112"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2df7a54a-2178-a60e-3b75-5f22fbf48974"],
 ") and the phase-flip code (checks ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["X", "TI"], "1"], 
   SubscriptBox[
    StyleBox["X", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bfca7d-2305-1462-3304-715fd37afd6e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["X", "TI"], "2"], 
   SubscriptBox[
    StyleBox["X", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "279595ba-9944-9075-3d5b-d06422df2fa9"],
 "):"
}], "Text",
 CellID->1855870767,ExpressionUUID->"2786391a-471b-f375-3898-02a560569b7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Get", "[", \
"\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/OngoingProjects/QEC/\
QECCore/QECCore.wl\>\"", "]"}], ";", " ", 
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`QEC`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"faultCircNoise", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<code capacity\>\"", " ", "->", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Depolarizing\>\"", ",", " ", "p"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<circuit, all locations\>\"", " ", "->", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Circuit\>\"", ",", " ", "p"}], "]"}]}], ",", "\n", "   ", 
     
     RowBox[{"\"\<circuit, one-qubit gates noiseless\>\"", " ", "->", " ", 
      RowBox[{"QECNoiseModel", "[", 
       RowBox[{"\"\<Circuit\>\"", ",", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<TwoQubit\>\"", " ", "->", " ", "p"}], ",", " ", 
          RowBox[{"\"\<Measurement\>\"", " ", "->", " ", "p"}], ",", " ", 
          RowBox[{"\"\<Reset\>\"", " ", "->", " ", "p"}]}], "|>"}]}], 
       "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"faultCircRate", "[", 
    RowBox[{"code_", ",", " ", "\"\<code capacity\>\""}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", "code", "]"}], ",", " ", 
      RowBox[{"faultCircNoise", "[", "\"\<code capacity\>\"", "]"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"faultCircRate", "[", 
    RowBox[{"code_", ",", " ", "key_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", "code", "]"}], ",", " ", 
      RowBox[{"faultCircNoise", "[", "key", "]"}], ",", " ", 
      RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"faultCircFive", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"faultCircRate", "[", 
      RowBox[{"\"\<5QubitCode\>\"", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{"\"\<code capacity\>\"", ",", 
      " ", "\"\<circuit, all locations\>\""}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"faultCircTransversal", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"QECLogicalErrorRate", "[", 
        RowBox[{
         RowBox[{"QECCode", "[", "\"\<5QubitCode\>\"", "]"}], ",", " ", 
         RowBox[{"QECNoiseModel", "[", 
          RowBox[{"\"\<Circuit\>\"", ",", " ", "q"}], "]"}], ",", " ", 
         RowBox[{"\"\<Rounds\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<Extraction\>\"", " ", "->", 
          " ", "\"\<Transversal\>\""}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"10.", "^", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "4"}], ",", " ", 
          RowBox[{"-", "1.5"}], ",", " ", "0.5"}], "]"}]}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"faultCircPairs", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<code capacity\>\"", ",", 
          " ", "\"\<circuit, all locations\>\""}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<BitFlipCode\>\"", ",", " ", "\"\<PhaseFlipCode\>\""}], 
         "}"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<circuit, one-qubit gates noiseless\>\"", ",", 
       " ", "\"\<PhaseFlipCode\>\""}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"faultCircDual", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"faultCircRate", "[", 
      RowBox[{"#2", ",", " ", "#1"}], "]"}], " ", "&"}], " ", "@@@", " ", 
    "faultCircPairs"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"faultCircLabel", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{"s", ",", " ", "12", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"q", ",", " ", 
                RowBox[{"#", " ", "/.", " ", 
                 RowBox[{"p", " ", "->", " ", "q"}]}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"q", ",", " ", 
                RowBox[{"10.", "^", 
                 RowBox[{"Range", "[", 
                  RowBox[{
                   RowBox[{"-", "4"}], ",", " ", 
                   RowBox[{"-", "1.5"}], ",", " ", "0.05"}], "]"}]}]}], 
               "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", "faultCircFive"}], 
          ",", " ", "faultCircTransversal"}], "]"}], ",", " ", 
        RowBox[{"Joined", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "True", ",", " ", "False"}], "}"}]}], ",",
         " ", 
        RowBox[{"PlotMarkers", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", "None", ",", " ", "Automatic"}], "}"}]}], 
        ",", "\n", "    ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<code capacity\>\"", ",", 
             " ", "\"\<bare-ancilla circuit\>\"", ",", 
             " ", "\"\<transversal circuit, kept shots\>\""}], "}"}], ",", 
           " ", "Below"}], "]"}]}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<p\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}]}], "}"}]}], ",",
         " ", 
        RowBox[{"ImageSize", " ", "->", " ", "380"}], ",", "\n", "    ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"faultCircLabel", "[", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<five-qubit code\>\"", ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<bare ancilla:  \>\"", ",", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
                 " ", "\"\< = \>\"", ",", " ", 
                 RowBox[{"TraditionalForm", "[", 
                  RowBox[{
                   RowBox[{"Coefficient", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "faultCircFive", "]"}], ",", " ", 
                    "p", ",", " ", "1"}], "]"}], " ", "p"}], "]"}], ",", 
                 " ", "\"\< + O(\>\"", ",", " ", 
                 RowBox[{"Superscript", "[", 
                  RowBox[{"\"\<p\>\"", ",", " ", "2"}], "]"}], ",", 
                 " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}], ",", " ", 
            RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], 
          "]"}]}]}], "]"}], ",", "\n", "   ", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{"Expand", "[", 
          RowBox[{"Cancel", "[", 
           RowBox[{"faultCircDual", "/", "p"}], "]"}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "0", ",", " ", "0.05"}], "}"}], ",", " ", 
        RowBox[{"PlotStyle", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "Automatic", ",", " ", "Dashed", ",", " ", "Automatic", ",", " ", 
           "Dashed", ",", " ", "DotDashed"}], "}"}]}], ",", " ", 
        RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<p\>\"", ",", " ", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
              " ", "\"\< / p\>\""}], "}"}], "]"}]}], "}"}]}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "380"}], ",", "\n", "    ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"LineLegend", "[", 
            RowBox[{"Automatic", ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"#2", " ", "/.", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    
                    RowBox[{"\"\<BitFlipCode\>\"", " ", "->", 
                    " ", "\"\<bit flip\>\""}], ",", " ", 
                    
                    RowBox[{"\"\<PhaseFlipCode\>\"", " ", "->", 
                    " ", "\"\<phase flip\>\""}]}], "}"}]}], ",", 
                  " ", "\"\<, \>\"", ",", " ", "#1"}], "}"}], "]"}], " ", 
               "&"}], " ", "@@@", " ", "faultCircPairs"}], ",", " ", 
             RowBox[{"LegendLayout", " ", "->", " ", "\"\<Column\>\""}]}], 
            "]"}], ",", " ", "Below"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"faultCircLabel", "[", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<bit-flip and phase-flip codes\>\"", ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<all locations, bit flip \>\"", ",", " ", 
                 RowBox[{"TraditionalForm", "[", 
                  RowBox[{
                   RowBox[{"Coefficient", "[", 
                    RowBox[{
                    RowBox[{"faultCircDual", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", " ", "p", ",", " ", 
                    "1"}], "]"}], " ", "p"}], "]"}], ",", 
                 " ", "\"\<,  phase flip \>\"", ",", " ", 
                 RowBox[{"TraditionalForm", "[", 
                  RowBox[{
                   RowBox[{"Coefficient", "[", 
                    RowBox[{
                    RowBox[{"faultCircDual", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], ",", " ", "p", ",", " ", 
                    "1"}], "]"}], " ", "p"}], "]"}]}], "}"}], "]"}]}], "}"}], 
            ",", " ", 
            RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], 
          "]"}]}]}], "]"}]}], "\n", "   ", "}"}], "}"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Top"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[92]:= ",
 CellID->788579190,ExpressionUUID->"147a1547-9658-8f47-757f-ec0fe73d8a55"],

Cell[TextData[{
 "With the bare ancilla the five-qubit code fails at first order in ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70fdef27-65a0-21b5-1509-6041ff06e174"],
 ": one fault on an ancilla partway through its CNOTs spreads to several data \
qubits. The transversal extraction restores the second-order slope of code \
capacity on the kept shots, although at the largest values of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07cf35e4-1904-3c46-2935-644c573c8cb0"],
 " it fails more often than the bare ancilla. The bit-flip and phase-flip \
codes fail identically at code capacity but not once their checks are \
measured by a circuit, because only the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a2b39b7-a8b4-209d-476a-a6ef7e3d7142"],
 " checks need ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7062859c-b8ca-6c41-3853-4033ce08a2de"],
 " gates on the data: with one-qubit-gate noise switched off, the phase-flip \
code falls back onto the bit-flip curve."
}], "Text",
 CellID->1682190697,ExpressionUUID->"1c0b30e6-3a8e-caf5-3277-0b99a19bb1dd"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1801951969,ExpressionUUID->"2f8bddb8-117e-08ef-58c0-f98059dbb7b8"],

Cell["A diagonal magic circuit as one phase polynomial", "Subsection",
 CellID->744703753,ExpressionUUID->"6837d53c-9df0-0b4b-6a5d-74c5d48ac787"],

Cell[TextData[{
 "Start ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "103793f7-158a-7e6a-3fb5-25ac72c3d09b"],
 " qubits in ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "004f37e7-9049-df15-2c43-ef951f78d10c"],
 ", apply ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2063f877-3c9f-11c2-70e9-be1f823cefb1"],
 " to every qubit, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aa20fad-9880-2ff8-1103-37a005a71595"],
 " to every neighboring pair and one ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6731478e-295f-07bc-006c-53e40eff95eb"],
 " to qubits 1, 2, 3. Each ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366fec93-d35a-7c45-7e4a-2bca69c3d0b1"],
 " doubles a sum of stabilizer states, so kept that way the state would need ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31ac0c4c-8110-f2c8-5c1c-8fcc3ab6c45c"],
 " terms. What does one amplitude of the result cost as ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739fe1c8-14eb-b66f-00e3-7675e4de53a8"],
 " grows?"
}], "Text",
 CellID->711146155,ExpressionUUID->"209476e5-15b0-b37d-7f56-a5f55ea87a17"],

Cell[TextData[{
 "Every gate is diagonal in the computational basis, so it only multiplies ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["x", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1625b129-bf72-c584-1886-011bd0c727cb"],
 " by a power of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[Pi]", "/", "4"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "408321fd-0ad1-14d3-7fe8-c010be54aa17"],
 ": ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox["q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ee87a13-1618-eb77-7e13-ef71b8981286"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Omega]", "TI"], 
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["q", "TI"]]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3d0279-2be6-d6a6-76c0-861a5283e3a9"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "398ed663-febc-1fdd-1e3b-a308fbb0e30d"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Omega]", "TI"], 
   RowBox[{"4", 
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["q", "TI"]], 
    SubscriptBox[
     StyleBox["x", "TI"], 
     RowBox[{
      StyleBox["q", "TI"], "+", "1"}]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4efdeda8-4c22-85da-20e5-f01018381bd5"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18c657b8-6aa0-4b63-5330-264c56641427"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Omega]", "TI"], 
   RowBox[{"4", 
    SubscriptBox[
     StyleBox["x", "TI"], "1"], 
    SubscriptBox[
     StyleBox["x", "TI"], "2"], 
    SubscriptBox[
     StyleBox["x", "TI"], "3"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bb37faa-ee95-f8a5-4dbf-7e074d443623"],
 ". The whole circuit is one phase polynomial over ",
 Cell[BoxData[
  SubscriptBox["\:2124", "8"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42017d37-5e5f-28eb-59e6-dc59c99a1a49"],
 ","
}], "Text",
 CellID->1660656482,ExpressionUUID->"246d3e9c-51e7-4eb8-56d0-ba18df0cfbe4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["U", "TI"], 
     SuperscriptBox[
      TemplateBox[{"+"},
       "Ket"], 
      RowBox[{"\[CircleTimes]", 
       StyleBox["n", "TI"]}]]}], "=", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"-", 
       StyleBox["n", "TI"], "/", "2"}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        RowBox[{
         StyleBox["x", "TI"], "\[Element]", "{", "0"}], ",", 
        RowBox[{"1", 
         SuperscriptBox["}", 
          StyleBox["n", "TI"]]}]}],
       LimitsPositioning->False], 
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Omega]", "TI"], 
        RowBox[{"\[CurlyPhi]", 
         StyleBox["(",
          SpanMaxSize->1], 
         StyleBox["x", "TI"], 
         StyleBox[")",
          SpanMaxSize->1]}]], 
       TemplateBox[{
         StyleBox["x", "TI"]},
        "Ket"]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{"\[CurlyPhi]", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["x", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["q", "TI"], "=", "1"}], 
       StyleBox["n", "TI"],
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["q", "TI"]]}], "+", 
     RowBox[{"4", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["q", "TI"], "=", "1"}], 
        RowBox[{
         StyleBox["n", "TI"], "-", "1"}],
        LimitsPositioning->False], 
       RowBox[{
        SubscriptBox[
         StyleBox["x", "TI"], 
         StyleBox["q", "TI"]], 
        SubscriptBox[
         StyleBox["x", "TI"], 
         RowBox[{
          StyleBox["q", "TI"], "+", "1"}]]}]}]}], "+", 
     RowBox[{"4", 
      SubscriptBox[
       StyleBox["x", "TI"], "1"], 
      SubscriptBox[
       StyleBox["x", "TI"], "2"], 
      SubscriptBox[
       StyleBox["x", "TI"], "3"], 
      StyleBox["mod",
       FontSlant->"Plain"], "8"}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1956510695,ExpressionUUID->"2bff46cd-bbb2-f7e4-746b-f276cd6e17ae"],

Cell[TextData[{
 "so an amplitude is the single term ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      RowBox[{
       StyleBox["y", "TI"], GridBox[{
         {
          StyleBox["U", "TI"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}], "+"}], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], "=", 
   SuperscriptBox["2", 
    RowBox[{"-", 
     StyleBox["n", "TI"], "/", "2"}]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], 
    RowBox[{"\[CurlyPhi]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["y", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37eac1c9-d89c-5f29-2bf0-2791438f6089"],
 "."
}], "Text",
 CellID->718393952,ExpressionUUID->"1f8867e8-056d-7a22-7722-27df209a70d2"],

Cell[TextData[{
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13131839-2600-d3c9-3010-5ab171f23402"],
 " is held as a phase polynomial, with the register starting in ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "681d6935-7a88-4a79-6836-7af4673f143c"],
 "; the figure times, fastest of three, building it, reading the amplitude of \
",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"10", "\[CenterEllipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15dc02f5-2160-4087-30df-57d695d2c186"],
 ", and reading the same amplitude from the dense state vector of the circuit \
with an ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ad5b57f-fe21-ae4a-0730-d6fe1277597f"],
 " layer in front:"
}], "Text",
 CellID->1702497997,ExpressionUUID->"4474814a-1be7-a5e1-0b36-5dbba69d9feb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phasePolyGates", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"\"\<T\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "n", "]"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", 
          RowBox[{"q", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", 
         RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{
        RowBox[{"\"\<Z\>\"", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phasePolyState", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"phasePolyGates", "[", "n", "]"}], "]"}], "[", 
    RowBox[{"Method", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Stabilizer\>\"", ",", " ", 
       RowBox[{"\"\<Compress\>\"", " ", "->", 
        " ", "\"\<PhasePolynomial\>\""}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phasePolyY", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"PadRight", "[", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", " ", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"phasePolyTime", ",", " ", "HoldFirst"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phasePolyTime", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Min", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ClearSystemCache", "[", "]"}], ";", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"AbsoluteTiming", "[", "expr", "]"}]}]}], ",", " ", "3"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phasePolyTimes", " ", "=", " ", 
   RowBox[{"{", "\n", "   ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"phasePolyTime", "[", 
          RowBox[{"phasePolyState", "[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "10", ",", " ", "100", ",", " ", "10"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", " ", "=", " ", 
           RowBox[{"phasePolyState", "[", "n", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", 
           RowBox[{"phasePolyTime", "[", 
            RowBox[{"s", "[", 
             RowBox[{"\"\<Amplitude\>\"", ",", " ", 
              RowBox[{"phasePolyY", "[", "n", "]"}]}], "]"}], "]"}]}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "10", ",", " ", "100", ",", " ", "10"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"phasePolyTime", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"QuantumCircuitOperator", "[", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"Thread", "[", 
                 RowBox[{"\"\<H\>\"", " ", "->", " ", 
                  RowBox[{"Range", "[", "n", "]"}]}], "]"}], ",", " ", 
                RowBox[{"phasePolyGates", "[", "n", "]"}]}], "]"}], "]"}], "[",
              "]"}], "[", "\"\<StateVector\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"n", " ", "-", " ", "1"}], ")"}]}], " ", "+", " ", 
             "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4", ",", " ", "18", ",", " ", "2"}], "}"}]}], 
      "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{"phasePolyTimes", ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<qubits n\>\"", ",", " ", "\"\<seconds\>\""}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<build the phase polynomial\>\"", ",", 
      " ", "\"\<one amplitude from it\>\"", ",", 
      " ", "\"\<dense state vector\>\""}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[LeftAngleBracket]10\[CenterEllipsis]0|\[Psi]\
\[RightAngleBracket] at n = 20:  \>\"", ",", " ", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{
           RowBox[{"phasePolyState", "[", "20", "]"}], "[", 
           RowBox[{"\"\<Amplitude\>\"", ",", " ", 
            RowBox[{"phasePolyY", "[", "20", "]"}]}], "]"}], "]"}]}], "}"}], 
       "]"}], ",", " ", "13", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}]}], "Input",
 CellLabel->"In[93]:= ",
 CellID->131631487,ExpressionUUID->"4ffdeb72-3eef-3ae9-2df2-c0066d765f30"],

Cell[TextData[{
 "The dense state vector rises from a fixed floor into exponential growth, a \
straight line on the log scale. Building ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13496c57-a1f7-8420-4b2b-058abb2793df"],
 " and reading one amplitude from it grow slowly with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ebdcd2-c150-734f-638c-dfa205f5cd93"],
 " and continue to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "100"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "715448e8-af98-0656-61d0-9ea63fc35558"],
 ", where a dense vector of ",
 Cell[BoxData[
  SuperscriptBox["2", "100"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2ba6d2-1489-1745-0051-0b8c47643d88"],
 " entries cannot be stored, because an amplitude is ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18df2182-794a-0858-43d2-97183790a703"],
 " evaluated at one bit string rather than a sum over ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3302b3ab-c336-2d23-0df4-103fa40c1634"],
 " terms. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "20"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62bb3463-a428-ec29-56c9-f1e6459afc68"],
 " that amplitude is a single term: the ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"-", 
    StyleBox["n", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b1a6276-01d0-b9c1-1751-448861d8a745"],
 " of a flat superposition times the phase ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a605d36-1076-042a-6f60-334dc8b96e11"],
 " that the one ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44f9eeda-855f-f8a0-6038-3bade6e56d44"],
 " acting on ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "1"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ce8fb6c-3427-88fd-5966-c70fc7a10942"],
 " wrote into it."
}], "Text",
 CellID->383810822,ExpressionUUID->"62b1c9f6-82c7-46ed-041b-9ede40f1326e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->774606554,ExpressionUUID->"498f1292-12c7-4049-3287-c2994a405770"],

Cell["Light: interferometers and phase space", "Section",
 CellID->1135754729,ExpressionUUID->"3ff4e189-c6a3-b976-298b-328de849d4a2"],

Cell["\<\
The examples in this section are light in linear optical networks and in \
phase space. Photons meet at beam splitters: the Hong-Ou-Mandel dip with loss \
and with partly distinguishable photons, bunching, suppression laws in \
Fourier interferometers, the cost of one boson-sampling amplitude, and a \
nonlinear sign gate built from linear optics. Squeezed vacua, cat states, \
heralded states and squeezed thermal light are then drawn as Wigner and \
Husimi functions, where negative regions mark nonclassical light, and \
homodyne detection reads their quadratures. QF describes the network by its \
transfer matrix and gives output probabilities with the photon numbers, \
angles and phases left symbolic where it can; WL turns states into \
quasi-probability distributions and draws them.\
\>", "Text",
 CellID->1158159695,ExpressionUUID->"6a594964-2e89-38af-21af-5729b830b972"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2061392384,ExpressionUUID->"5bbbfecb-a057-00e5-56b1-e867d77282d2"],

Cell["A beam splitter with symbolic photon numbers", "Subsection",
 CellID->510626575,ExpressionUUID->"5783a203-e823-b779-1d28-9ad39a89e035"],

Cell[TextData[{
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2674aca0-7b82-475e-7a5d-c75bae5a0670"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3501556b-b88e-4289-093d-847bc984f2be"],
 " photons enter the two ports of a beam splitter with mixing angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7752b962-e227-4ac8-70cb-2d0dd70c4c20"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19f0ae95-f06e-121f-595c-6d6af0190277"],
 ". What is the probability of finding ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "675e22a5-571f-0a66-5f2b-94ce230dc046"],
 " photons in the first output, for every photon number at once?"
}], "Text",
 CellID->1454888947,ExpressionUUID->"6c02f624-2fe2-d5ed-50a2-a49c6ac0477c"],

Cell["The splitter rotates the creation operators,", "Text",
 CellID->1657526998,ExpressionUUID->"06f7b1c8-d37a-480f-515d-d4ff7f49bb56"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         StyleBox["i", "TI"], "\[CurlyPhi]"}]]}], 
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "1", "\[Dagger]"]}], "+", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->339724315,ExpressionUUID->"1c76cae3-c000-a8a8-5695-e44fb7689e6e"],

Cell[TextData[{
 "so it conserves the photon number, and the second output holds ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], "-", 
   SubscriptBox[
    StyleBox["t", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a5fd9bb-8b80-e81e-64f2-40562a66f577"],
 " photons."
}], "Text",
 CellID->455522786,ExpressionUUID->"5e7dd2fc-4dfc-e569-7c88-bb0a5cae7bc9"],

Cell[TextData[{
 "The probability for general ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], "1"], ",", 
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52c42b50-d9b8-7380-52d0-527bbbfe7ae6"],
 " comes out in closed form (shown at ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4011f98c-59e2-99d2-3541-dbdfad9f817b"],
 "); each panel fixes the input photon numbers:"
}], "Text",
 CellID->277899058,ExpressionUUID->"1b5e55a3-3069-df37-3b2d-350ef189c7bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"splitterProb", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"t1", ",", " ", 
        RowBox[{"n1", " ", "+", " ", "n2", " ", "-", " ", "t1"}]}], "}"}]}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"twinPanel", "[", 
    RowBox[{"{", 
     RowBox[{"p_", ",", " ", "q_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"splitterProb", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"n1", " ", "->", " ", "p"}], ",", " ", 
             RowBox[{"n2", " ", "->", " ", "q"}], ",", " ", 
             RowBox[{"t1", " ", "->", " ", "j"}]}], "}"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", 
            RowBox[{"p", " ", "+", " ", "q"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Element", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "}"}], ",", " ", 
          "Reals"}], "]"}]}], "]"}], "]"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
       RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OddQ", "[", "j", "]"}], ",", " ", "Dashed", ",", " ", 
            RowBox[{"{", "}"}]}], "]"}], ",", " ", 
          RowBox[{"AbsoluteThickness", "[", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"j", " ", "<", " ", "2"}], ",", " ", "4", ",", " ", 
             "1.6"}], "]"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "0", ",", " ", 
          RowBox[{"p", " ", "+", " ", "q"}]}], "}"}]}], "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<t\>\"", ",", " ", "1"}], "]"}], ",", 
           " ", "\"\< = \>\"", ",", " ", "j"}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "0", ",", " ", 
          RowBox[{"p", " ", "+", " ", "q"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Pi]", "/", "4"}], "}"}], ",", " ", "None"}], "}"}]}], ",",
      " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", " ", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"TraditionalForm", "[", "#", "]"}], ",", " ", 
                RowBox[{"FractionBoxOptions", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], 
               "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"\[Pi]", "/", "2"}], ",", " ", 
             RowBox[{"\[Pi]", "/", "8"}]}], "]"}]}], ",", " ", "None"}], 
         "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Theta]\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<P(\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<t\>\"", ",", " ", "1"}], "]"}], ",", 
           " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<n\>\"", ",", " ", "1"}], "]"}], ",", " ", "\"\< = \>\"",
          ",", " ", "p", ",", " ", "\"\<,   \>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}], ",", " ", "\"\< = \>\"",
          ",", " ", "q"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"twinPanels", " ", "=", " ", 
   RowBox[{"twinPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", "twinPanels"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"Last", "[", "twinPanels", "]"}], "]"}], "]"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"TraditionalForm", "[", 
      RowBox[{"splitterProb", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CurlyPhi]", " ", "->", " ", "0"}], ",", " ", 
         RowBox[{"n1", " ", "->", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"n", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"n2", " ", "->", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"n", ",", " ", "2"}], "]"}]}], ",", " ", 
         RowBox[{"t1", " ", "->", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"t", ",", " ", "1"}], "]"}]}]}], "}"}]}], "]"}], ",", " ", 
     "14", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Times\>\""}]}], "]"}], ",", 
   " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[94]:= ",
 CellID->367864257,ExpressionUUID->"5e59bd81-70cf-3e86-0029-e32f25082e22"],

Cell[TextData[{
 "The probability is the squared Wigner D-function of a spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["n", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f8bea8-b877-c069-75c4-a1de300d41f8"],
 " rotated by ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09908dbf-322f-a09a-6771-7f8dac78f304"],
 ": two modes holding ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79a9cd42-9e31-a137-6c96-2879907d125d"],
 " photons carry the spin-",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69f4c04c-c250-ac59-17db-8d97058b5d8f"],
 " representation of SU(2), and the splitter rotates it. The phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cab88ce-6ceb-ef6a-1a9f-23f5af879513"],
 " enters the D-function only as a phase factor, so it drops out of the \
probability. At the balanced splitter (vertical line) equal inputs never \
leave an odd ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fb66cd9-82e4-9f41-6751-a57c5d501b20"],
 " (dashed), with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f80397-a124-013d-04d1-4f31966693aa"],
 " the Hong-Ou-Mandel zero, while one and three photons never leave two in \
each output."
}], "Text",
 CellID->1956791327,ExpressionUUID->"7a331d2c-0e9f-5f39-6c54-6788891e3076"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->46633693,ExpressionUUID->"2f01d8f6-8a58-f034-74bd-7ab3d4041fa6"],

Cell["Photon loss, and a Hong-Ou-Mandel zero that survives it", "Subsection",
 CellID->820484149,ExpressionUUID->"28281a76-5072-020c-130d-345bb234682d"],

Cell[TextData[{
 "One photon enters each input of a beam splitter with angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "003fd625-04af-5468-2df7-47465daeffb9"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b3e3a6-a09b-2f73-22e7-85571340a925"],
 ", and attenuators of transmissivities ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Eta]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2617b259-86b7-8bb5-4803-3b2fad65825e"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Eta]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6caaa907-cdab-ad83-4ec0-410efe7bf673"],
 " sit on the two outputs. Does the two-photon coincidence zero survive the \
loss?"
}], "Text",
 CellID->887573696,ExpressionUUID->"13fb1abe-7b62-7fe6-3b9b-afea8cb61692"],

Cell[TextData[{
 "Pure loss mixes the mode with a vacuum mode ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5891a813-6a64-8654-7142-2989b35a783d"],
 " and discards ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5c58a6-067b-9505-1647-8e15dcd25703"],
 ": ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "\[Rule]", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "+", 
   SqrtBox[
    RowBox[{"1", "-", 
     StyleBox["\[Eta]", "TI"]}]], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["b", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1de3fbcd-988d-74c3-1872-dd8cb870fdea"],
 ", so each photon survives independently with probability ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56319631-a715-9610-7639-22036cea691d"],
 ". The splitter ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444be1a2-8e8b-1a31-5a0f-fc3831c443d6"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18ad8996-cde0-d632-2a63-fa253238573e"],
 " acts first, then the loss on each output, and the coincidence probability \
is"
}], "Text",
 CellID->2048520678,ExpressionUUID->"231a2213-723e-929d-714d-7a574ff5cad7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", ",", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SubscriptBox[
     StyleBox["\[Eta]", "TI"], "1"], 
    SubscriptBox[
     StyleBox["\[Eta]", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
    StyleBox["\[Theta]", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]", 
    StyleBox[
     RowBox[{"for", "\[NonBreakingSpace]", "every", "\[NonBreakingSpace]"}],
     FontSlant->"Plain"], "\[CurlyPhi]"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1799278092,ExpressionUUID->"0502b832-0ddd-484c-53da-2c89a2ca72be"],

Cell[TextData[{
 "The coincidence probability for general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]", ",", 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0127b4c6-eafb-b49e-4803-d9884899359b"],
 " comes out in closed form:"
}], "Text",
 CellID->923075595,ExpressionUUID->"36bdbf46-8e1c-55a0-5f5e-070ad82d7be7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lossyCoincidence", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"\"\<Loss\>\"", "[", "\[Eta]1", "]"}], " ", "->", " ", "1"}],
         ",", " ", 
        RowBox[{
         RowBox[{"\"\<Loss\>\"", "[", "\[Eta]2", "]"}], " ", "->", " ", 
         "2"}]}], "}"}], "]"}], "[", 
     RowBox[{"\"\<Probability\>\"", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"lossPairs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.9", ",", " ", "0.5"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.6", ",", " ", "0.3"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"lossyCoincidence", " ", "/.", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Eta]1", ",", " ", "\[Eta]2"}], "}"}], " ", "->", " ", 
         "#"}], "]"}]}], " ", "&"}], " ", "/@", " ", "lossPairs"}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<\[Eta]\>\"", ",", " ", "1"}], "]"}], ",", 
          " ", "\"\< = \>\"", ",", " ", "#1", ",", " ", "\"\<,  \>\"", ",", 
          " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<\[Eta]\>\"", ",", " ", "2"}], "]"}], ",", 
          " ", "\"\< = \>\"", ",", " ", "#2"}], "}"}], "]"}], " ", "&"}], " ",
       "@@@", " ", "lossPairs"}], ")"}]}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Pi]", "/", "4"}], "}"}], ",", " ", "None"}], "}"}]}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"\[Pi]", "/", "2"}], ",", " ", 
          RowBox[{"\[Pi]", "/", "8"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<P(1, 1)\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"lossyCoincidence", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Eta]1", " ", "->", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Eta]", ",", " ", "1"}], "]"}]}], ",", " ", 
          RowBox[{"\[Eta]2", " ", "->", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Eta]", ",", " ", "2"}], "]"}]}]}], "}"}]}], "]"}], ",",
       " ", "14", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Times\>\""}]}], "]"}]}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[95]:= ",
 CellID->350100119,ExpressionUUID->"25fd4686-0241-ffbb-6d1d-94800d3fb971"],

Cell[TextData[{
 "Loss only scales the coincidence curve by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], "1"], 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25cfdff5-2425-e3f1-3e98-0b1f7133751e"],
 ", the chance that both photons survive, so its zero at the balanced \
splitter stays for every pair of transmissivities, equal or not: a \
coincidence needs both photons to survive, and a surviving pair carries the \
lossless amplitude."
}], "Text",
 CellID->1770755569,ExpressionUUID->"5741fd18-6cc8-1b5f-6d8d-9ae0a5b8b71c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->950918900,ExpressionUUID->"11725ddc-cfff-5f0c-1daf-5ddd753dc4e2"],

Cell["Two squeezed vacua on a balanced beam splitter", "Subsection",
 CellID->944543353,ExpressionUUID->"51f95595-96a3-07bf-14c1-74b20ccda6a5"],

Cell[TextData[{
 "Each of two modes is squeezed from the vacuum, with complex parameters ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Xi]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "587bd799-70fd-8356-5b02-e485de09f237"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Xi]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d062e98-6b93-9217-6568-1ab25682ea38"],
 ", and the modes meet on a balanced beam splitter. When does one photon \
appear in each output?"
}], "Text",
 CellID->1793413879,ExpressionUUID->"0bf34fac-2c64-2d90-549b-3a75e482b77f"],

Cell[TextData[{
 "Each squeezer is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["S", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Xi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "[", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Xi]", "TI"], "*"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "2"], "-", 
     StyleBox["\[Xi]", "TI"], "\[ThinSpace]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      RowBox[{"\[Dagger]", "2"}]]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", "2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518c468a-fc27-0aa5-6d49-1b5bb8b95991"],
 "; the splitter then maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d9eb4b3-b8bf-b640-6866-dd7c39d72f84"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "-", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e558ebf-3d4f-74be-5583-c337f3359914"],
 "."
}], "Text",
 CellID->1011619015,ExpressionUUID->"5e91d2f1-d3c6-bc6d-3916-b6ee11af5448"],

Cell[TextData[{
 "The coincidence probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "406e9985-ceb6-3b35-38af-a65ef14b1284"],
 " for general ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Xi]", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["\[Xi]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd01d6e-16cc-048d-1d42-5115759c6f1b"],
 " is plotted for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Xi]", "TI"], "1"], "=", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a4c3d1-2a08-64c8-2522-a7d2ae7fd8c7"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Xi]", "TI"], "2"], "=", 
   StyleBox["q", "TI"], "\[ThinSpace]", 
   StyleBox["r", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Phi]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e114e38-84f4-c74e-1c32-a6580c2e12e9"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["q", "TI"], "=", GridBox[{
     {
      SubscriptBox[
       StyleBox["\[Xi]", "TI"], "2"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "/", GridBox[{
     {
      SubscriptBox[
       StyleBox["\[Xi]", "TI"], "1"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f69f886-976e-7cb5-6a00-457c4240fad5"],
 " together with the pair probabilities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "033dccab-0d70-ab6f-46e3-8dcd440a767d"],
 " for opposite squeezers ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23d73a59-ecb9-eefd-0da3-294b87d0c2d5"],
 " for general ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "283c081d-bb03-116d-46e3-aee9e6570d54"],
 ", all in closed form:"
}], "Text",
 CellID->479954229,ExpressionUUID->"2b203413-d675-fa1d-6dbf-75c37d4bddfa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairProb", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "\[Xi]1", "]"}], " ", "->", " ", "1"}], ",",
        " ", 
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "\[Xi]2", "]"}], " ", "->", " ", "2"}], ",",
        " ", 
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"\[Pi]", "/", "4"}], "]"}]}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oppositeSqueezers", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", "r", "]"}], " ", "->", " ", "1"}], ",", " ", 
      
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", 
        RowBox[{"-", "r"}], "]"}], " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Pi]", "/", "4"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"squeezerPairLaw", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"oppositeSqueezers", "[", 
        RowBox[{"\"\<Probability\>\"", ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "m"}], "}"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"r", " ", ">", " ", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coincidencePanel", "[", "q_", "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"pairProb", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Xi]1", " ", "->", " ", "r"}], ",", " ", 
           RowBox[{"\[Xi]2", " ", "->", " ", 
            RowBox[{"q", " ", "r", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "p"}], "]"}]}]}]}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"\[Pi]", "/", "2"}], ",", " ", "\[Pi]"}], "}"}]}], 
         "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "2"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.005"}], ",", " ", "0.26"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Phi] = 0\>\"", ",", " ", "\"\<\[Phi] = \[Pi]/2\>\"", ",",
         " ", "\"\<\[Phi] = \[Pi]\>\""}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<P(1, 1)\>\""}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<|\>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Xi]\>\"", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\<|/|\>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Xi]\>\"", ",", " ", "1"}], "]"}], ",", 
         " ", "\"\<| = \>\"", ",", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"q", ",", " ", "InputForm"}], "]"}]}], "}"}], "]"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"coincidencePanels", " ", "=", " ", 
   RowBox[{"coincidencePanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"Grid", "[", 
          RowBox[{"{", 
           RowBox[{"First", " ", "/@", " ", "coincidencePanels"}], "}"}], 
          "]"}], ",", " ", 
         RowBox[{"legendBelow", "[", 
          RowBox[{"Last", "[", 
           RowBox[{"Last", "[", "coincidencePanels", "]"}], "]"}], "]"}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"pairProb", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Xi]1", " ", "->", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\[Xi]", ",", " ", "1"}], "]"}]}], ",", " ", 
             RowBox[{"\[Xi]2", " ", "->", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\[Xi]", ",", " ", "2"}], "]"}]}]}], "}"}]}], "]"}], ",",
          " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Times\>\""}]}], "]"}], ",",
        " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", "squeezerPairLaw", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<m = \>\"", ",", " ", 
             RowBox[{"m", " ", "-", " ", "1"}], ",", " ", "\"\<:  \>\"", ",", 
             " ", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"squeezerPairLaw", "[", 
               RowBox[{"[", "m", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}]}], ",", "\n", "    ", 
       
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", " ", "\"\<P(m, m)\>\""}], "}"}]}], ",", 
       " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Xi]\>\"", ",", " ", "1"}], "]"}], ",", 
           " ", "\"\< = r,  \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Xi]\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\< = -r\>\""}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "}"}], "}"}], 
  "]"}]}], "Input",
 CellLabel->"In[96]:= ",
 CellID->1780072828,ExpressionUUID->"18146445-0c50-3de7-0b30-9a937ec34f8e"],

Cell[TextData[{
 "The coincidence vanishes only for identical squeezers (",
 Cell[BoxData[
  RowBox[{
   StyleBox["q", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06794cf3-4860-8c37-7ac3-ef63a767d4d2"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b6cbea7-c34a-9a14-39d8-26b2eeb31422"],
 "): the pair generator ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", 
    RowBox[{"\[Dagger]", "2"}]], "+", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", 
    RowBox[{"\[Dagger]", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06fa2d22-7384-58f0-5734-7895d83f68f1"],
 " is unchanged by the splitter, so the output is again two independent \
squeezed vacua, each holding only even photon numbers. Any difference in \
strength or phase lets coincidences through, most for opposite squeezers, \
whose outputs carry ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02b4b838-68a6-a16e-2701-3a07f8295ff9"],
 " photons each with the two-mode squeezed vacuum statistics ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"2", 
     StyleBox["m", "TI"]}]], "\[ThinSpace]", 
   StyleBox["r", "TI"], "/", 
   SuperscriptBox[
    StyleBox["cosh",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07e50bc1-1147-a38c-6786-2a3088207996"],
 "."
}], "Text",
 CellID->703638690,ExpressionUUID->"6eba69fc-6478-a8b2-2fa9-3cd194de1b24"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1062485795,ExpressionUUID->"3f000aa7-024b-0d27-1884-dc3cc71330ef"],

Cell["Fourier interferometers with one photon per port", "Subsection",
 CellID->441123202,ExpressionUUID->"5d6a19fd-8951-649a-4996-79e5d1d610ec"],

Cell[TextData[{
 "One photon enters each port of an ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7845f0bf-4283-3088-0337-a1d23801aed2"],
 "-mode interferometer whose transfer matrix is the discrete Fourier matrix. \
Which output patterns occur?"
}], "Text",
 CellID->59899864,ExpressionUUID->"3aee3ee6-850e-962b-7114-c65e04a2b3d7"],

Cell[TextData[{
 "The network maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], "\[Rule]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["j", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "344c112b-277f-8a64-5be7-bd80f446acd8"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["j", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["k", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a619e11-4330-9554-0fe1-5498208abed9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"2", "\[Pi]", 
     StyleBox["i", "TI"], "/", 
     StyleBox["N", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52db7e49-95da-f568-701e-31eca58c3c4f"],
 "; each output amplitude is a permanent of an ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "\[Times]", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "504da1a6-582b-c35c-656e-a8f86bf8a873"],
 " matrix built from ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b3cd5dd-ced2-bbaf-3def-174b7dbd4033"],
 "."
}], "Text",
 CellID->571548368,ExpressionUUID->"16ab8f30-0bec-c157-386d-087f2f52dbc6"],

Cell[TextData[{
 "The figure gives the exact probability of every output pattern ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     StyleBox["t", "TI"], "1"]}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["N", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "745c1dd8-d4d3-36f8-6298-7c206978b7f7"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"1", ",", "\[Ellipsis]", ",", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7be2e9b1-519b-b7f9-691d-175c14b3bc8d"],
 ", for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5df3e11b-decb-a9c8-1b3b-73c2cc040be7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dc0b977-c4da-0b88-1b87-b6bf4fd6c879"],
 ":"
}], "Text",
 CellID->1535269840,ExpressionUUID->"5890cd19-5e3b-61a0-3e2b-b972c8488e10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fourierProbabilities", "[", "d_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"FourierMatrix", "[", "d", "]"}], "]"}], "[", 
    RowBox[{"\"\<Probabilities\>\"", ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", " ", "d"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fourierChart", "[", "d_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pr", " ", "=", " ", 
       RowBox[{"fourierProbabilities", "[", "d", "]"}]}], "}"}], ",", " ", 
     RowBox[{"BarChart", "[", 
      RowBox[{
       RowBox[{"Values", "[", "pr", "]"}], ",", " ", 
       RowBox[{"ChartLabels", " ", "->", " ", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"StringJoin", "[", 
             RowBox[{"ToString", " ", "/@", " ", 
              RowBox[{"#", "[", "\"\<Name\>\"", "]"}]}], "]"}], " ", "&"}], 
           " ", "/@", " ", 
           RowBox[{"Keys", "[", "pr", "]"}]}], ",", " ", "Axis", ",", " ", 
          RowBox[{
           RowBox[{"Rotate", "[", 
            RowBox[{"#", ",", " ", 
             RowBox[{"Pi", "/", "2"}]}], "]"}], " ", "&"}]}], "]"}]}], ",", 
       "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0.4"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", "\"\<probability\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<output patterns,  N = \>\"", ",", " ", "d"}], "}"}], 
         "]"}]}], ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "Full"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"80", " ", "+", " ", 
           RowBox[{"18", " ", 
            RowBox[{"Length", "[", "pr", "]"}]}]}], ",", " ", "280"}], 
         "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"fourierChart", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "4"}], "}"}]}], ",", " ", 
   RowBox[{"Spacer", "[", "20", "]"}]}], "]"}]}], "Input",
 CellLabel->"In[97]:= ",
 CellID->1172970169,ExpressionUUID->"062773eb-be1e-468b-6d98-a32d302cff99"],

Cell[TextData[{
 "Most patterns are exactly zero, among them every two-plus-one pattern at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c528898-8690-738d-7e77-07f79d7b6fee"],
 " and the input pattern ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"1", ",", "1"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f44d31c-1e35-8d80-3ac7-2212bad0f4a9"],
 " itself at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65540809-125f-c810-38d3-5589ff3e0d7b"],
 ". Relabeling the input ports cyclically leaves the input unchanged but \
multiplies the amplitude of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     StyleBox["t", "TI"], "1"]}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["N", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3331d8d1-2b71-89f9-222a-d879334fd9a3"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Omega]", "TI"], 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["j", "TI"], "-", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["j", "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e97d921-a5fb-560a-1a3c-05f71701c8aa"],
 ", so a pattern can occur only if that sum is a multiple of ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71189847-8807-3c12-3045-1cde5d016110"],
 ", and in both networks every pattern that passes this test does occur."
}], "Text",
 CellID->962588295,ExpressionUUID->"26d14ead-b909-dd1a-717c-f9e80502a5d9"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1333233628,ExpressionUUID->"2f68f775-b782-4f81-1522-76893c0e9d15"],

Cell["The nonlinear sign gate of Knill, Laflamme and Milburn", "Subsection",
 CellID->2038381213,ExpressionUUID->"39d4d595-2fdf-e1d4-1deb-c5310431ad2f"],

Cell[TextData[{
 "A signal mode holds ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], "0"], 
    TemplateBox[{"0"},
     "Ket"]}], "+", 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], "1"], 
    TemplateBox[{"1"},
     "Ket"]}], "+", 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], "2"], 
    TemplateBox[{"2"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25438c7b-273d-d236-3ca0-6a3e726689f3"],
 "; two auxiliary modes hold one photon and the vacuum. A three-mode network \
mixes them, and a run is kept only when the auxiliary detectors count ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0081b6aa-e291-2ad9-06cf-03cdef5e78a3"],
 ". A phase shifter cannot flip the sign of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519b1750-3abe-2d31-54b5-fe7927d0b60c"],
 " alone, since it multiplies ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c87b27-46d1-8234-3d97-455c341b709d"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "n", "\[Alpha]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ca3f190-e99d-759e-6b8d-2158dc5d91cd"],
 ". What does the kept signal look like?"
}], "Text",
 CellID->715072697,ExpressionUUID->"132393ad-9f63-a5f3-4c91-6ab7dc492709"],

Cell[TextData[{
 "The network maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], "\[Rule]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["j", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47492524-f78b-f7cc-02c8-0179015d6e12"],
 " with the real transfer matrix (Knill, Laflamme and Milburn, Nature 409, 46 \
(2001))"
}], "Text",
 CellID->510434943,ExpressionUUID->"4dc16412-a02a-3910-61c9-dbd8794e0e52"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], "=", "(", GridBox[{
      {
       RowBox[{"1", "-", 
        SqrtBox["2"]}], 
       SuperscriptBox["2", 
        RowBox[{"-", "1", "/", "4"}]], 
       SqrtBox[
        RowBox[{"3", "/", 
         SqrtBox["2"], "-", "2"}]]},
      {
       SuperscriptBox["2", 
        RowBox[{"-", "1", "/", "4"}]], 
       RowBox[{"1", "/", "2"}], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         SqrtBox["2"]}], 
        StyleBox[")",
         SpanMaxSize->1], "/", "2"}]},
      {
       SqrtBox[
        RowBox[{"3", "/", 
         SqrtBox["2"], "-", "2"}]], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         SqrtBox["2"]}], 
        StyleBox[")",
         SpanMaxSize->1], "/", "2"}], 
       RowBox[{
        SqrtBox["2"], "-", "1", "/", "2"}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->477590855,ExpressionUUID->"348f2ee5-ec1b-5b27-5bb4-01b01ce41424"],

Cell[TextData[{
 "so the kept signal is ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["m", "TI"],
    LimitsPositioning->False], 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["m", "TI"]], 
    TemplateBox[{
      RowBox[{
        StyleBox["m", "TI"], ",", "1", ",", "0"}]},
     "Bra"], 
    OverscriptBox[
     StyleBox["U", "TI"], "^"], 
    TemplateBox[{
      RowBox[{
        StyleBox["m", "TI"], ",", "1,0"}]},
     "Ket"], 
    TemplateBox[{
      StyleBox["m", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01b79373-6b70-4fcf-1310-8487347b0b18"],
 "."
}], "Text",
 CellID->1783904458,ExpressionUUID->"5342139c-625a-485c-1537-3c65ad1b4425"],

Cell[TextData[{
 "The network gives these amplitudes for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", "5"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f96ae7-774b-b4d1-09b9-8d3d7ec35dcd"],
 " (bars); the first three give the kept signal for general ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], "0"], ",", 
   SubscriptBox[
    StyleBox["c", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["c", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7807ac11-0493-520c-4803-49698f199e54"],
 ":"
}], "Text",
 CellID->927157045,ExpressionUUID->"6ccc85a7-96a7-391f-764c-911438ab15c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nsGate", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"3", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}]}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
        RowBox[{"1", "/", "2"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"3", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}], ",",
         " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], " ", "-", " ", 
         RowBox[{"1", "/", "2"}]}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nsAmps", " ", "=", " ", 
   RowBox[{"RootReduce", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"nsGate", "[", 
       RowBox[{"\"\<Amplitude\>\"", ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
         
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "1", ",", " ", "0"}], "}"}]}]}], "]"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"keptSignal", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c0", ",", " ", "c1", ",", " ", "c2"}], "}"}], " ", 
    RowBox[{"Take", "[", 
     RowBox[{"nsAmps", ",", " ", "3"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"BarChart", "[", 
    RowBox[{"nsAmps", ",", " ", 
     RowBox[{"PlotLabels", " ", "->", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "5"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"LabelingFunction", " ", "->", " ", "Above"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<signal photons m\>\"", ",", 
        " ", "\"\<\:27e8m,1,0|U|m,1,0\:27e9\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<kept signal  \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", "keptSignal", "]"}]}], "}"}], "]"}], ",",
      " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[98]:= ",
 CellID->795881714,ExpressionUUID->"5b262e30-19ae-3f12-0d12-dde51df6af5c"],

Cell[TextData[{
 "For zero, one and two signal photons the amplitudes have the same size and \
only the two-photon one is negative, so every input comes out with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e2ee94-9e35-fd98-517e-a49360312c45"],
 " flipped and the same overall factor: the gate works with a probability \
that does not depend on the input. From three signal photons on the \
amplitudes differ, so the gate works only on inputs with at most two signal \
photons."
}], "Text",
 CellID->1567874936,ExpressionUUID->"1f319844-2e10-87f7-7dd5-3890ff0d00c7"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->787259543,ExpressionUUID->"6b91d897-10d4-084f-25c9-3c4af0b1e183"],

Cell["\<\
Bosons, distinguishable particles and fermions at one beam splitter\
\>", "Subsection",
 CellID->2095485479,ExpressionUUID->"6d8869ba-5e81-4037-4709-a64e48386857"],

Cell[TextData[{
 "Two particles, one in each input of a beam splitter with angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "629719b2-4142-5f78-1d1f-1ca1b4837480"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74ae48c4-fef3-6c63-5f66-85ea25ea834e"],
 ", can both be transmitted or both be reflected. How likely is it that they \
leave through different ports?"
}], "Text",
 CellID->1514403046,ExpressionUUID->"3cd592d1-c583-aa1e-5670-d9179b499e71"],

Cell[TextData[{
 "With transfer matrix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", "(", GridBox[{
     {
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["\[Theta]", "TI"]}], 
      RowBox[{"-", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["\[Theta]", "TI"]}]},
     {
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["\[Theta]", "TI"]}], 
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["\[Theta]", "TI"]}]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "446935fe-4848-81b9-192f-57c8423db720"],
 ", bosons add the two histories with a plus sign, fermions with a minus \
sign, and distinguishable particles add their probabilities:"
}], "Text",
 CellID->186916530,ExpressionUUID->"76ee4edf-44af-4675-139f-3be2463cdbde"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["B", "TI"]], "=", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         StyleBox["Per",
          FontSlant->"Plain"], 
         StyleBox["W", "TI"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["F", "TI"]], "=", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         StyleBox["det",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["W", "TI"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["D", "TI"]], "=", 
    RowBox[{
     StyleBox["Per",
      FontSlant->"Plain"], 
     RowBox[{
      RowBox[{"(", 
       SuperscriptBox[GridBox[{
          {
           SubscriptBox[
            StyleBox["W", "TI"], 
            StyleBox[
             RowBox[{"j", "k"}], "TI"]]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], ")"}], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->885327750,ExpressionUUID->"112a6232-b925-e8d4-47b1-5bd12e6c44d2"],

Cell[TextData[{
 "For general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b95683f-0fcc-db55-09e4-dacabf863e9b"],
 " the three coincidence probabilities follow from ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e086a6-fafa-2f63-3a8f-2ec93d915c57"],
 " in closed form (legend):"
}], "Text",
 CellID->1238698301,ExpressionUUID->"6ce7b6f1-d893-c391-7fbb-d8e427fd24ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"statisticsW", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], "}"}], "]"}], 
    "[", "\"\<Unitary\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statisticsCoincidences", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Permanent", "[", "statisticsW", "]"}], "]"}], "^", "2"}], ",",
        " ", 
       RowBox[{"Permanent", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "statisticsW", "]"}], "^", "2"}], "]"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Det", "[", "statisticsW", "]"}], "]"}], "^", "2"}]}], "}"}],
      ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "}"}], ",", " ", 
       "Reals"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "statisticsCoincidences", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Pi]", "/", "4"}], "}"}], ",", " ", "None"}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"#1", ",", " ", "\"\<:  \>\"", ",", " ", 
          RowBox[{"TraditionalForm", "[", "#2", "]"}]}], "}"}], "]"}], " ", 
       "&"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<bosons\>\"", ",", " ", "\"\<distinguishable\>\"", ",", 
          " ", "\"\<fermions\>\""}], "}"}], ",", " ", 
        "statisticsCoincidences"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"\[Pi]", "/", "2"}], ",", " ", 
          RowBox[{"\[Pi]", "/", "8"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<P(1, 1)\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[99]:= ",
 CellID->1092242739,ExpressionUUID->"72bf3cb6-d09e-c6d5-66cd-5b97a1f42a8a"],

Cell[TextData[{
 "The phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "603f8f3f-c69a-4d25-5322-f187a4518a75"],
 " drops out of all three. Bosons never separate at the balanced splitter, \
fermions separate at every ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06cc4319-4fd5-c82e-64a2-dd5257268a7d"],
 ", and distinguishable particles lie between them. Bosons and fermions \
differ only in the sign of the exchange term; distinguishable particles have \
none, so their curve is the average of the other two."
}], "Text",
 CellID->1905508997,ExpressionUUID->"22b3d53c-30e9-4854-0f19-2772026c00ae"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1544711139,ExpressionUUID->"05f41618-7bb2-f1bb-6f91-68299c3e682c"],

Cell["Hong-Ou-Mandel with partially distinguishable photons", "Subsection",
 CellID->479883716,ExpressionUUID->"6861af77-d3f9-d829-6883-120d1b426897"],

Cell[TextData[{
 "Two photons meet at a beam splitter with angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2126cdad-5830-2cd1-3214-0d232cac0585"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "384f8d97-a248-3440-737d-4ed15a2641c2"],
 ". The first is horizontally polarized, the second is polarized at angle ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d57d54b-3f7f-b8f4-3ff8-74841688e539"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    StyleBox["\[Chi]", "TI"], 
    TemplateBox[{
      StyleBox["H", "TI"]},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], 
    StyleBox["\[Chi]", "TI"], 
    TemplateBox[{
      StyleBox["V", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa47ef7-e997-c309-1f2b-fefdb887fb5f"],
 ", and the detectors do not resolve polarization. How does the coincidence \
probability depend on ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d9b5461-f64b-37c1-4e10-697ea1a1b865"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b25d776-620f-99be-7dbc-c29f3334b2bc"],
 "?"
}], "Text",
 CellID->1483477317,ExpressionUUID->"44b601ce-8d3a-6fe6-4dc8-ffcb079db00f"],

Cell[TextData[{
 "Treat the polarizations as extra modes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["1", 
    StyleBox["H", "TI"]], ",", 
   SubscriptBox["2", 
    StyleBox["H", "TI"]], ",", 
   SubscriptBox["1", 
    StyleBox["V", "TI"]], ",", 
   SubscriptBox["2", 
    StyleBox["V", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f2759-2f38-4f21-43e1-536c2663ceb5"],
 ", with the same splitter ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bd7d598-60d5-bc8f-60e6-7b29ffbca533"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ecc9e7-0091-96b6-288c-c6ac37b9757a"],
 " on the ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00b039b0-6984-4e4e-1829-0542f89abe80"],
 " pair and on the ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "467f0db4-611e-b009-0113-52091e86519a"],
 " pair. The input is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    StyleBox["\[Chi]", "TI"], 
    TemplateBox[{"1,1,0,0"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], 
    StyleBox["\[Chi]", "TI"], 
    TemplateBox[{"1,0,0,1"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a8bc600-9dc8-9771-16c5-2206356e214d"],
 ", and the coincidence sums over the four outputs ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec0f123-fc72-cd1c-09fb-e9c4f39ec508"],
 " with one photon in each path:"
}], "Text",
 CellID->298556388,ExpressionUUID->"04f6106c-efe8-1074-6e5a-daa2728e7d2d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"c", "o", "i", "n", "c"}], "TI"]], "=", 
    UnderscriptBox["\[Sum]", 
     StyleBox["T", "TI"],
     LimitsPositioning->False], 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         StyleBox["cos",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
         StyleBox["A", "TI"], 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"1100", "\[Rule]", 
          StyleBox["T", "TI"]}], 
         StyleBox[")",
          SpanMaxSize->1], "+", 
         StyleBox["sin",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
         StyleBox["A", "TI"], 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"1001", "\[Rule]", 
          StyleBox["T", "TI"]}], 
         StyleBox[")",
          SpanMaxSize->1]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->824567418,ExpressionUUID->"42f34a7c-3716-ea5b-3ded-e708b2b1fd1b"],

Cell[TextData[{
 "Summing the polarization-resolved probabilities gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox[
     RowBox[{"c", "o", "i", "n", "c"}], "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", 
    StyleBox["\[Chi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b8843cb-4a8e-efde-7e3b-ef6084a145c7"],
 " for general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]", ",", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aff199b-7926-770a-50ff-6c16a907e984"],
 " in closed form:"
}], "Text",
 CellID->1842336436,ExpressionUUID->"2314590e-522c-e296-55f4-a2f74910086a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"polarizedHOM", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}]}], "}"}], ",", " ", "4"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"partialCoincidence", " ", "=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", " ", "@", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", "\[Chi]", "]"}], " ", 
               RowBox[{"polarizedHOM", "[", 
                RowBox[{"\"\<Amplitude\>\"", ",", " ", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"1", ",", " ", "1", ",", " ", "0", ",", " ", "0"}],
                    "}"}], " ", "->", " ", "#"}]}], "]"}]}], " ", "+", " ", 
              RowBox[{
               RowBox[{"Sin", "[", "\[Chi]", "]"}], " ", 
               RowBox[{"polarizedHOM", "[", 
                RowBox[{"\"\<Amplitude\>\"", ",", " ", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "1"}],
                    "}"}], " ", "->", " ", "#"}]}], "]"}]}]}], "]"}], "^", 
            "2"}], " ", "&"}], " ", "/@", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], 
             "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], 
             "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], 
             "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], 
             "}"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Element", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]", ",", " ", "\[Chi]"}], 
           "}"}], ",", " ", "Reals"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Chi]", "]"}], "^", "2"}], ",", " ", "Simplify"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"partialCoincidence", " ", "/.", " ", 
       RowBox[{"\[Chi]", " ", "->", " ", "c"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"\[Pi]", "/", "8"}], ",", " ", 
          RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
          RowBox[{"3", " ", 
           RowBox[{"\[Pi]", "/", "8"}]}], ",", " ", 
          RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "}"}]}], "]"}], "]"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Chi] = 0\>\"", ",", " ", "\"\<\[Chi] = \[Pi]/8\>\"", ",", 
      " ", "\"\<\[Chi] = \[Pi]/4\>\"", ",", " ", "\"\<\[Chi] = 3\[Pi]/8\>\"", 
      ",", " ", "\"\<\[Chi] = \[Pi]/2\>\""}], "}"}]}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Pi]", "/", "4"}], "}"}], ",", " ", "None"}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"\[Pi]", "/", "2"}], ",", " ", 
          RowBox[{"\[Pi]", "/", "8"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<P(coincidence)\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"TraditionalForm", "[", "partialCoincidence", "]"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[100]:= ",
 CellID->1005289403,ExpressionUUID->"34e7f449-7aad-b7ad-5657-404b9601a9f5"],

Cell[TextData[{
 "The phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18f45cc7-190f-8e1e-010d-372ab11fb275"],
 " drops out, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox[
    RowBox[{"c", "o", "i", "n", "c"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b93eb89-ee3c-c080-7e02-bfb388ad48cf"],
 " is the Hong-Ou-Mandel curve ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "22"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72172948-fef7-0e9e-303d-fb58f888b58d"],
 " of identical photons weighted by the squared polarization overlap ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65562475-cdea-7fd2-7ebf-33eb724b642f"],
 ", plus the distinguishable-particle curve ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", "+", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "4", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4", "=", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1b7314-a6cd-dbdc-2857-7588ee9cf535"],
 " weighted by ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2290ffe2-56c8-9a80-4d2b-b5a159ce9c9f"],
 ". At the balanced splitter only the second term survives, so the depth of \
the dip measures how indistinguishable the photons are."
}], "Text",
 CellID->1641195148,ExpressionUUID->"3e71f216-7e82-d208-30b5-813ad1935738"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1051707071,ExpressionUUID->"0f7e9924-6431-6cdb-3f03-9ab8c0b51283"],

Cell["When n photons per port return to their inputs", "Subsection",
 CellID->727407266,ExpressionUUID->"5d4ea4cf-3a72-e8f9-7eeb-78e2a819dbac"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e393c-291f-3002-0080-3ef5af866507"],
 " photons enter each port of a beam splitter with reflectivity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "524cbe95-7c38-3250-1dc2-cc0a418c36b6"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d84d225-78bc-afa3-79ce-96426c07ae0e"],
 ". For which reflectivities does the probability that they leave as they \
came, ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7847cacb-b97c-aeef-4e68-6ca1de18590d"],
 " in each output, vanish?"
}], "Text",
 CellID->1032156393,ExpressionUUID->"3cf4a288-50bf-44a8-7da4-25e47d666e0a"],

Cell[TextData[{
 "The splitter maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e0d2f64-00bf-58f5-51c6-3d0eb8007c19"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50c46b5a-d80f-7a01-0d39-7d9f130a1c21"],
 "."
}], "Text",
 CellID->1473123207,ExpressionUUID->"47899431-6483-897d-43a5-a5af92704633"],

Cell[TextData[{
 "The amplitude ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], ",", 
    RowBox[{
     StyleBox["n", "TI"], GridBox[{
       {
        OverscriptBox[
         StyleBox["U", "TI"], "^"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     StyleBox["n", "TI"]}], ",", 
    StyleBox["n", "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cc5408e-f24d-15ed-55a3-93d507924444"],
 " for general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], ",", 
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee3ac9c-9d88-eda3-48c5-161e5eb6f318"],
 " comes out in closed form (shown at ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fa6a813-e6d2-912a-42fd-ab8d274e9763"],
 "); the curves substitute ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "1"}], ",", "\[Ellipsis]", ",", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bfdf689-d492-498d-3c28-f3c576e48c53"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", 
   StyleBox["arcsin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SqrtBox[
    StyleBox["R", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b9ab528-b4a4-5a66-7c82-93973c1f9c3d"],
 ":"
}], "Text",
 CellID->514973491,ExpressionUUID->"531cad16-8b83-c303-349e-e816333c52ed"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"returnAmplitude", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"returnAmplitude", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"n", " ", "->", " ", "j"}], ",", " ", 
             RowBox[{"\[Theta]", " ", "->", " ", 
              RowBox[{"ArcSin", "[", 
               RowBox[{"Sqrt", "[", "R", "]"}], "]"}]}]}], "}"}]}], "]"}], "^",
          "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "4"}], "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"R", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<n = \>\"", ",", " ", "j"}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<R\>\"", ",", " ", "\"\<P(n, n \[RightArrow] n, n)\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"TraditionalForm", "[", 
      RowBox[{"returnAmplitude", " ", "/.", " ", 
       RowBox[{"\[CurlyPhi]", " ", "->", " ", "0"}]}], "]"}], ",", " ", "14", 
     ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Times\>\""}]}], "]"}], ",", 
   " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[101]:= ",
 CellID->600499116,ExpressionUUID->"0a66ae17-6cb9-c594-1d6e-97de28e939fc"],

Cell[TextData[{
 "The return amplitude is the rotation matrix element ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["d", "TI"], "00", 
    RowBox[{"\[ThinSpace]", 
     StyleBox["n", "TI"]}]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"2", 
     StyleBox["\[Theta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "275d1bc7-796f-e308-307a-47c299b38bc9"],
 ", which is the Legendre polynomial ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", "2", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", "2", 
    StyleBox["R", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58230f96-4e4d-380f-495d-1293c5be7d62"],
 ", so ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4790475a-ee24-443c-3a6d-0c5ccb7359a1"],
 " photons per port never return at the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31960a20-d1b2-3d9a-78a7-2561c41ff019"],
 " zeros of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1896a531-fb5a-8bbe-6177-090f4d05002d"],
 ". Since ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["n", "TI"]], 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "791bbdf2-fd95-66c3-2c65-10631b9174f9"],
 ", every curve is symmetric about ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77aa5239-0eec-e1fd-756c-c9d7c69a2574"],
 ", and the balanced splitter, where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2274a9bd-f7af-7410-6660-eed2e756dc31"],
 ", is a zero for every odd ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b1fe876-4af6-f8d5-0f06-3d66b47c18a1"],
 " and never for even ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e9cb8ce-31de-3f44-6f12-9786e3b1a8b4"],
 "."
}], "Text",
 CellID->1581580197,ExpressionUUID->"107930df-64c4-0ae0-323b-006251cf9daa"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1978527161,ExpressionUUID->"1374861c-93bb-1195-52cb-1dc59a4c305f"],

Cell["A Schr\[ODoubleDot]dinger-cat state in phase space", "Subsection",
 CellID->1131962928,ExpressionUUID->"12d7858b-fe49-d154-55cb-0b87391d2388"],

Cell[TextData[{
 "A field mode holds a superposition of two coherent states of real amplitude \
",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6962134d-963d-5094-27be-0cc77795416c"],
 " with relative phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dab7381-bde4-fdeb-4742-bda0d4e44af5"],
 ". What sets the sign of its Wigner function at the origin?"
}], "Text",
 CellID->1815309897,ExpressionUUID->"036c76ab-29e0-1287-1c6f-168dfe2a5acd"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647ec3de-e42c-5245-1d92-e0ef381ad43c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["i", "TI"], 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06778889-d5ef-c4de-6c96-62a712c63130"],
 ", the state and its Wigner function are"
}], "Text",
 CellID->489594608,ExpressionUUID->"27a59c58-3063-a2f8-168f-8e13d253d206"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], "=", 
    RowBox[{"\|01d4a9", 
     RowBox[{"(", 
      RowBox[{
       TemplateBox[{
         StyleBox["\[Alpha]", "TI"]},
        "Ket"], "+", 
       RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
        TemplateBox[{
          RowBox[{"-", 
            StyleBox["\[Alpha]", "TI"]}]},
         "Ket"]}]}], ")"}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["W", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["x", "TI"], ",", 
       StyleBox["p", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox["1", "\[Pi]"], 
     RowBox[{
      StyleBox["\[Integral]",
       FontSize->1.4 Inherited], 
      RowBox[{
       TemplateBox[{
         RowBox[{
           StyleBox["x", "TI"], "-", 
           StyleBox["y", "TI"]}]},
        "Bra"], 
       StyleBox["\[Rho]", "TI"], 
       TemplateBox[{
         RowBox[{
           StyleBox["x", "TI"], "+", 
           StyleBox["y", "TI"]}]},
        "Ket"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"2", 
         StyleBox["i", "TI"], 
         StyleBox["p", "TI"], 
         StyleBox["y", "TI"]}]], 
       StyleBox["d", "TI"], 
       StyleBox["y", "TI"]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1793069219,ExpressionUUID->"2459ce8b-e769-9e57-6ba1-83c8a2149693"],

Cell[TextData[{
 "and the photon-number parity ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[CapitalPi]", "^"], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "096f11cc-f2f2-14c1-0f2d-e57f3256c3f1"],
 " maps ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "734309ad-8d71-0686-2e58-97dc724e2b45"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"-", 
      StyleBox["\[Alpha]", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b1dfcb8-b558-9c55-5388-aba346d20dae"],
 ". Since ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox["\[CapitalPi]", "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c7e2dd0-f751-76d3-4275-d66f327e2169"],
 " for every state, the overlap ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"], 
     RowBox[{"-", 
       StyleBox["\[Alpha]", "TI"]}]},
    "BraKet"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "086b467b-fd95-9391-5549-b2dca78b0310"],
 " fixes the value at the origin in closed form."
}], "Text",
 CellID->1054297528,ExpressionUUID->"57852fed-a6b5-412e-575b-9b6a0953bbaa"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06f78a22-7cf0-e56a-27ad-de076d2c8f99"],
 " comes from the state on a Fock space cut at 40 levels. Each panel draws ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dacc496-427d-354a-2d98-f78551157dc9"],
 " as a surface over phase space, prints the computed ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704646ee-e995-003c-67b3-37f1c707a44a"],
 ", marks ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d7a70e0-f770-1116-7961-f652c1f18cdc"],
 " with a white line, and all panels share one color scale:"
}], "Text",
 CellID->684399075,ExpressionUUID->"15dd545a-85d9-615b-4e19-0bb0de703404"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"catColors", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "#"}], ")"}], "/", "2"}], "]"}], " ", 
    "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"catParity", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"\[Alpha]", "^", "2"}]}], "]"}], " ", "+", " ", 
      RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"\[Alpha]", "^", "2"}]}], "]"}], " ", 
       RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"catPanel", "[", 
    RowBox[{"amp_", ",", " ", "phase_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"WignerRepresentation", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"CatState", "[", "40", "]"}], "[", 
          RowBox[{
           RowBox[{"N", "[", "amp", "]"}], ",", " ", 
           RowBox[{"N", "[", "phase", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "61"}]}], "]"}]}], "}"}],
      ",", "\n", "  ", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"\[Pi]", " ", 
        RowBox[{"w", "[", 
         RowBox[{"x", ",", " ", "p"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"ColorFunction", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"catColors", "[", "#3", "]"}], " ", "&"}], ")"}]}], ",", 
       " ", 
       RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "40"}], ",", " ", 
       RowBox[{"MaxRecursion", " ", "->", " ", "0"}], ",", "\n", "   ", 
       RowBox[{"MeshFunctions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"#3", " ", "&"}], "}"}]}], ",", " ", 
       RowBox[{"Mesh", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", "0", "}"}], "}"}]}], ",", " ", 
       RowBox[{"MeshStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", " ", "Thick"}], "]"}]}], ",", " ", 
       RowBox[{"BoxRatios", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1", ",", " ", "0.6"}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\"", ",", 
          " ", "\"\<\[Pi]W\>\""}], "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "340"}], ",", "\n", "   ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              
              RowBox[{"\"\<\[Alpha] = \>\"", ",", " ", "amp", ",", 
               " ", "\"\<,   \[CurlyPhi] = \>\"", ",", " ", 
               RowBox[{"StringReplace", "[", 
                RowBox[{
                 RowBox[{"ToString", "[", 
                  RowBox[{"phase", ",", " ", "InputForm"}], "]"}], ",", " ", 
                 RowBox[{"\"\<Pi\>\"", " ", "->", " ", "\"\<\[Pi]\>\""}]}], 
                "]"}]}], "}"}], "]"}], ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<computed \[Pi]W(0,0) = \>\"", ",", " ", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"\[Pi]", " ", 
                  RowBox[{"w", "[", 
                   RowBox[{"0", ",", " ", "0"}], "]"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"4", ",", " ", "3"}], "}"}], ",", " ", 
                 RowBox[{"ExponentFunction", " ", "->", " ", 
                  RowBox[{"(", 
                   RowBox[{"Null", " ", "&"}], ")"}]}]}], "]"}]}], "}"}], 
             "]"}]}], "}"}], ",", " ", 
          RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"catPanels", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"catPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"\[Pi]", "/", "2"}], ",", " ", "\[Pi]"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{"{", 
         RowBox[{"catPanels", "[", "amp", "]"}], "}"}], "]"}], ",", " ", 
       RowBox[{"BarLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"catColors", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"LegendLabel", " ", "->", " ", "\"\<\[Pi]W\>\""}]}], "]"}]}],
       "]"}], ",", "\n", "  ", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Pi]W(0,0) = \:27e8\[CapitalPi]\:27e9 = \>\"", ",", 
          " ", 
          RowBox[{"TraditionalForm", "[", "catParity", "]"}]}], "}"}], "]"}], 
       ",", " ", "15", ",", " ", 
       RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
      " ", "Top"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amp", ",", " ", "2", ",", " ", "\"\<\[Alpha]\>\""}], "}"}], ",",
      " ", 
     RowBox[{"Keys", "[", "catPanels", "]"}], ",", " ", "SetterBar"}], "}"}], 
   ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[102]:= ",
 CellID->273198959,ExpressionUUID->"7dbbd35a-79b4-47c0-12d8-89fcf2fca4d4"],

Cell[TextData[{
 "As ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a8793d1-4c34-fa31-0401-317a9710fc63"],
 " grows the two coherent lobes, at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "\[PlusMinus]", 
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df7a50d-c80d-8ba8-3790-0d2a3e255041"],
 ", pull apart, and the fringes along ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f374966-4f99-4e89-0814-e359d6e59633"],
 " between them dip below zero and crowd together; at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23dca6a0-8902-14ba-5885-ba88513d1704"],
 " the lobes still overlap, yet ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c70081c-09a6-4ecb-1bfa-a4ee43c51d52"],
 " already goes negative. In every panel the origin takes the closed-form \
parity: ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d0d6401-ae2e-71cc-5798-2061afceb52c"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64a7789a-9c7d-d560-742f-a898a422b342"],
 " give parity eigenstates at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed15317-53e2-84b1-7d0e-51340bdf6487"],
 " for every ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "163de278-5ae1-1a17-1c81-94da81a31361"],
 ", while at ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1757525c-7d3d-df24-4600-1fd0ab226a07"],
 " the parity is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "2", 
    SuperscriptBox[
     StyleBox["\[Alpha]", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387f8b19-19f7-8d75-2a7b-ad9c370e2925"],
 ", so the origin falls toward zero, between a positive and a negative fringe."
}], "Text",
 CellID->1033598325,ExpressionUUID->"27778eb4-2185-5c09-10af-bdafbc561167"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->663339553,ExpressionUUID->"5371fdac-bb57-a8d9-73ab-0531a7921705"],

Cell["Squeezed thermal light: Wigner against Husimi", "Subsection",
 CellID->851728173,ExpressionUUID->"014b4a7a-872a-c408-393a-72826f699182"],

Cell[TextData[{
 "A field mode in thermal equilibrium, with mean photon number ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "173ca67a-e153-d13c-1b62-1b03787188d1"],
 ", is squeezed by a degenerate parametric amplifier with squeeze parameter \
",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42d0aa3c-4d24-cdc1-4143-72ec99670c8d"],
 ". How do its Wigner and Husimi ellipses compare with the vacuum's?"
}], "Text",
 CellID->533286518,ExpressionUUID->"0d501095-e8e9-28ea-6f7e-dbb2a5b0b848"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3bfedf-3823-3337-361b-767c9c576d42"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["i", "TI"], 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4226ae23-d07c-4e79-1ac9-6ee91dc42f10"],
 ", the state is"
}], "Text",
 CellID->368589264,ExpressionUUID->"49c9f336-6f00-9c1e-2e7b-bcd74089f866"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Rho]", "TI"], "=", 
    RowBox[{
     OverscriptBox[
      StyleBox["S", "TI"], "^"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["r", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"t", "h"}], "TI"]], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], "\[Dagger]"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["r", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["S", "TI"], "^"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["r", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["r", "TI"], "(", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "2"], "-", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], 
        RowBox[{"\[Dagger]", "2"}]]}], ")", "/", "2"}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox[
      RowBox[{"t", "h"}], "TI"]], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["n", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      FractionBox[
       OverscriptBox[
        OverscriptBox[
         StyleBox["n", "TI"], "_"], 
        RowBox[{"\[ThinSpace]", 
         StyleBox["n", "TI"]}]], 
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"1", "+", 
          OverscriptBox[
           StyleBox["n", "TI"], "_"]}], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        RowBox[{
         StyleBox["n", "TI"], "+", "1"}]]], 
      TemplateBox[{
        StyleBox["n", "TI"]},
       "Ket"], 
      RowBox[{
       TemplateBox[{
         StyleBox["n", "TI"]},
        "Bra"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1031775320,ExpressionUUID->"79c2b7a1-ac92-2936-6685-f288562b6701"],

Cell[TextData[{
 "The state is Gaussian, so its Wigner function is the Gaussian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "\[Proportional]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["v", "TI"], "\[CenterDot]", 
     SuperscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      RowBox[{"-", "1"}]], 
     StyleBox["v", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16d2cca1-57ac-3855-4946-876d010cf874"],
 " in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e8fa6a7-816f-4f46-2e44-4c49b492689d"],
 ", fixed by the quadrature covariance matrix ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11bb7609-0c63-1205-4528-fb9495597d73"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Sigma]", "TI"], "=", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7433cee9-103e-70eb-7eaa-810d6968c7e0"],
 " for the vacuum). The Husimi function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     TemplateBox[{
       StyleBox["\[Alpha]", "TI"]},
      "Ket"], "/", "2"}], "\[Pi]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ab46531-7adb-2c59-4ae5-cab5110ffdbb"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], "+", 
    StyleBox["i", "TI"], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54de7527-67b3-a9c0-5017-0c3ecb103fea"],
 ", is ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6499d9f1-786e-eed8-26b0-1c462200965f"],
 " smoothed by the vacuum's Wigner function, so it is the Gaussian with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Sigma]", "TI"], "+", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b182e1-3670-a2aa-300d-bcd221db97a7"],
 ". Half the peak of either lies on the ellipse ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "\[CenterDot]", 
   SuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    RowBox[{"-", "1"}]], 
   StyleBox["v", "TI"], "=", "2", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39a74942-4a59-8983-60cd-3433768aecd5"],
 ". Here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Sigma]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "_"], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", "2", 
      StyleBox["r", "TI"]}]], ",", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", 
      StyleBox["r", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50bd2958-d48d-0d8d-6d4c-a734aebb093f"],
 ", so the ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e2f3cb0-bbe9-e115-3549-6e45c1dfa409"],
 " ellipse enters the vacuum's circle once ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], ">", 
   FractionBox["1", "2"], 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    OverscriptBox[
     StyleBox["n", "TI"], "_"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419045f9-d0e9-517e-7146-9575a0d22475"],
 "."
}], "Text",
 CellID->1773306216,ExpressionUUID->"21636d2b-17ab-3eff-64d9-31b421d2a9a8"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f3d832f-01f9-8007-7209-d39e2b926e9c"],
 " comes from the state on a Fock space cut at 140 levels. Each panel draws \
the half-peak ellipses of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54f9ecf1-ef78-553a-7c7b-67715f6187c7"],
 " and ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a6dd4e8-c05b-dc5f-67c9-ba91bf32b01a"],
 " and, dashed, those of the vacuum:"
}], "Text",
 CellID->2088012347,ExpressionUUID->"59a94590-20a4-bb1c-1ba3-bb0b669e022a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sqLevels", " ", "=", " ", "140"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sqCovariance", "[", 
    RowBox[{"nb_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{"CovarianceMatrix", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SqueezeOperator", "[", 
       RowBox[{
        RowBox[{"N", "[", "r", "]"}], ",", " ", "sqLevels"}], "]"}], "[", 
      RowBox[{"ThermalState", "[", 
       RowBox[{
        RowBox[{"N", "[", "nb", "]"}], ",", " ", "sqLevels"}], "]"}], "]"}], 
     "[", "\"\<Normalized\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sqPanel", "[", 
    RowBox[{"nb_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cov", " ", "=", " ", 
        RowBox[{"sqCovariance", "[", 
         RowBox[{"nb", ",", " ", "r"}], "]"}]}], ",", " ", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "p"}], "}"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"v", " ", ".", " ", 
            RowBox[{"Inverse", "[", "cov", "]"}], " ", ".", " ", "v"}], " ", "==",
            " ", 
           RowBox[{"2", " ", 
            RowBox[{"Log", "[", "2", "]"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"v", " ", ".", " ", 
            RowBox[{"Inverse", "[", 
             RowBox[{"cov", " ", "+", " ", 
              RowBox[{
               RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}]}], "]"}],
             " ", ".", " ", "v"}], " ", "==", " ", 
           RowBox[{"2", " ", 
            RowBox[{"Log", "[", "2", "]"}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"v", " ", ".", " ", "v"}], " ", "==", " ", 
           RowBox[{"Log", "[", "2", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"v", " ", ".", " ", "v"}], " ", "==", " ", 
           RowBox[{"2", " ", 
            RowBox[{"Log", "[", "2", "]"}]}]}]}], "}"}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"ContourStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Automatic", ",", " ", "Automatic", ",", " ", "Dashed", ",", " ", 
          "Dashed"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Wigner W\>\"", ",", " ", "\"\<Husimi Q\>\"", ",", 
          " ", "\"\<vacuum W\>\"", ",", " ", "\"\<vacuum Q\>\""}], "}"}]}], ",",
        "\n", "   ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}], ",", " ", "\"\< = \>\"",
            ",", " ", "nb", ",", " ", "\"\<,   r = \>\"", ",", " ", "r"}], 
          "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sqPanels", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.5", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"sqPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.5", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.5", ",", " ", "1"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", 
         RowBox[{"sqPanels", "[", "nb", "]"}]}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "780"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{
        RowBox[{"sqPanels", "[", "0", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nb", ",", " ", "0.5", ",", " ", 
       RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}]}], "}"}], ",", " ", 
     RowBox[{"Keys", "[", "sqPanels", "]"}], ",", " ", "SetterBar"}], "}"}], ",",
    " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[103]:= ",
 CellID->2028208847,ExpressionUUID->"081c7759-f5de-901c-7368-865e9065e5cf"],

Cell[TextData[{
 "Squeezing narrows both ellipses along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11c3247a-c9d1-8cdc-7f9b-c2361fbe0e7f"],
 " and stretches them along ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "216b0449-d8dc-31fe-46f9-a7c823e1851b"],
 ", while thermal noise widens them in every direction, so at ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574bf5c4-278f-db31-0b13-ba1db3470624"],
 " the Wigner ellipse at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1beeee45-b8dc-b12f-64ff-51698c484717"],
 " still sits just outside the vacuum's circle and only ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114651d6-c74a-1593-79b5-24108e48e78c"],
 " pushes it inside, as the threshold predicts. ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "274d4816-cd26-9a87-3dbf-82451b431db9"],
 " is ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4474fddf-6a1e-993a-27fa-ee6ae99dcba3"],
 " smoothed by the vacuum, so every ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34093777-0882-7937-6a59-4ed40f83c695"],
 " ellipse is its ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e30ed73-d7da-94d9-08ab-207feab5ce01"],
 " ellipse widened by one vacuum's worth of noise: it never enters the \
vacuum's ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b1df11-38e2-7090-390b-d15420db3314"],
 " circle, yet it enters the vacuum's own ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c68da0a-38a7-ecb1-06fa-5723ff5273d0"],
 " circle exactly when ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e1364d-4aa3-f137-2831-45e538e85379"],
 " enters the vacuum's ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6be5f3c1-8bcd-399c-4132-19894958714d"],
 " circle. Only the width of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ae227b7-babc-dfe5-1cde-4152b4c2b6c0"],
 " is the quadrature noise itself."
}], "Text",
 CellID->417860422,ExpressionUUID->"69d2ed7d-2da3-f34a-599d-4c358b1094b2"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2059382961,ExpressionUUID->"63064a39-4532-ea9d-71e6-b6c5ad72de7a"],

Cell["\<\
One photon or a coherent pulse in a Mach-Zehnder interferometer\
\>", "Subsection",
 CellID->1935659301,ExpressionUUID->"247dca80-da9c-eab3-64df-1bd77b8b3eb0"],

Cell[TextData[{
 "A single photon, or a coherent pulse of amplitude ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a8af861-0aea-7a86-71dd-357f3aee7d32"],
 ", enters port 2 of a Mach-Zehnder interferometer whose arms differ in phase \
by ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a062819-de81-8d5b-0136-7c0a843f60c6"],
 " and whose two beam splitters have mixing angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cec897-dc0f-19a5-1350-b21b92fb69e2"],
 ". Detectors ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52f91784-7277-70da-3b03-e7fa8c3b8018"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056c9312-9d96-bf87-4c97-205a1dbcde9c"],
 " count the photons leaving the two output ports. What does a single photon \
do that a classical pulse cannot?"
}], "Text",
 CellID->1824512272,ExpressionUUID->"406d926c-1bd0-5f95-3faf-8d230cff731d"],

Cell[TextData[{
 "Each splitter maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bc13ccc-9b18-497e-6d8f-93fd0354f34e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", "-", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59b0f047-729e-ac27-722c-0b47a33cbca0"],
 ", and arm 1 adds ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0661bc16-0c78-80f4-1e32-61d717a713aa"],
 ", so the network maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], "\[Rule]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["j", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a99e786-3334-47ff-76cf-fba03de5c9a2"],
 ". The input is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    TemplateBox[{"0"},
     "Ket"], "1"], 
   SubscriptBox[
    TemplateBox[{"1"},
     "Ket"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d1626ec-1f4f-4844-452f-8db13e58654f"],
 " or ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    TemplateBox[{"0"},
     "Ket"], "1"], 
   SubscriptBox[
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "568ba30c-32e7-de72-7d9e-5273e950c121"],
 "; a coherent input leaves as the coherent state with amplitudes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", 
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["\[Alpha]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37cd31ab-41ce-12ef-6a21-2510a86bf3c1"],
 ", and detector ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20f5e84d-d189-0821-454f-ade1276bd8ad"],
 " then fires with probability ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[GridBox[{
        {
         SubscriptBox[
          StyleBox["\[Beta]", "TI"], 
          StyleBox["j", "TI"]]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]]}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "6081afdb-6457-13e4-771c-298c3c6b2fb8"],
 "."
}], "Text",
 CellID->1367056360,ExpressionUUID->"60f02e90-8c14-3570-39ce-fdf5b3dcc5f7"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "618e24fc-8a6d-a4bf-54ba-0455d5b6c968"],
 " and the photon's probabilities for general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "262fd1dd-8bdb-f9c9-2080-4a65f0a648d1"],
 ", the panels show the share of the light that reaches ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b4fa6e6-0db7-86fa-7400-19b56022a586"],
 " and the probability that both detectors fire:"
}], "Text",
 CellID->359828226,ExpressionUUID->"1fee8695-499e-a32a-4ae8-6b5204bd2607"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mzNet", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<PS\>\"", "[", "\[CurlyPhi]", "]"}], " ", "->", " ", "1"}],
       ",", " ", 
      RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mzBeta", " ", "=", " ", 
   RowBox[{
    RowBox[{"mzNet", "[", "\"\<TransferMatrix\>\"", "]"}], " ", ".", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "\[Alpha]"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mzShare", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mzNet", "[", 
      RowBox[{"\"\<Probability\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"First", "[", "mzBeta", "]"}], "]"}], "^", "2"}], "/", 
      RowBox[{
       RowBox[{"Abs", "[", "\[Alpha]", "]"}], "^", "2"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mzBoth", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mzNet", "[", 
      RowBox[{"\"\<Probability\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"Abs", "[", "mzBeta", "]"}], "^", "2"}]}], "]"}]}], 
       ")"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mzPanel", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"photon_", ",", " ", "pulse_"}], "}"}], ",", " ", "label_", ",",
      " ", "th_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"photon", ",", " ", 
         RowBox[{"pulse", " ", "/.", " ", 
          RowBox[{"\[Alpha]", " ", "->", " ", "1"}]}], ",", " ", 
         RowBox[{"pulse", " ", "/.", " ", 
          RowBox[{"\[Alpha]", " ", "->", " ", "2"}]}]}], "}"}], " ", "/.", 
       " ", 
       RowBox[{"\[Theta]", " ", "->", " ", "th"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"2", " ", "\[Pi]"}], ",", " ", 
            RowBox[{"\[Pi]", "/", "2"}]}], "]"}], ",", " ", "None"}], "}"}]}],
        "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", "Dashed", ",", " ", "Dotted"}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<|1\:27e9\>\"", ",", " ", "\"\<|\[Alpha] = 1\:27e9\>\"", ",",
         " ", "\"\<|\[Alpha] = 2\:27e9\>\""}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CurlyPhi]\>\"", ",", " ", "label"}], "}"}]}], ",", " ", 
     
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "th"}], "}"}], "]"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mzPanels", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"mzPanel", "[", 
      RowBox[{
       RowBox[{"Sequence", " ", "@@", " ", "ql"}], ",", " ", "th"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"ql", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"mzShare", ",", " ", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<share at \>\"", ",", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<D\>\"", ",", " ", "1"}], "]"}]}], "}"}], "]"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"mzBoth", ",", " ", "\"\<P(both fire)\>\""}], "}"}]}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"th", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
         RowBox[{"\[Pi]", "/", "8"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"First", ",", " ", "mzPanels", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"mzPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[104]:= ",
 CellID->1837935878,ExpressionUUID->"747cbb9b-9451-0cd7-4952-994fb94f0b93"],

Cell[TextData[{
 "The share reaching ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ab4cb18-b8c1-730f-55b6-55b50db39f04"],
 " is one fringe for the photon and both pulses alike, the intensity split of \
a classical wave, blind to the statistics of the light; unbalanced splitters \
shrink it for all three. The single photon never fires both detectors, at any \
phase or splitting. A coherent pulse does, more often as ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41827211-446b-f6a7-53bd-4f96c2d8497a"],
 " grows, except at the phases where the fringe sends all of its light to one \
port."
}], "Text",
 CellID->1458485678,ExpressionUUID->"160d81b1-4933-205f-292e-66c050b07564"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1226287678,ExpressionUUID->"5ec5453c-9e14-f701-5bb9-94653453bcf5"],

Cell["Photon statistics behind a beam splitter", "Subsection",
 CellID->453812722,ExpressionUUID->"449f3fb0-4e75-45fd-0798-cac92d0511f2"],

Cell[TextData[{
 "Light from a source holding ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "545950d9-0182-ea86-3e8c-201ce336b8b7"],
 " photons on average (a photon-number state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "382d3a1f-d79a-50d7-5ea3-1c8a6dd2c526"],
 ", a laser in a coherent state, or a thermal lamp) falls on a beam splitter \
of mixing angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25466292-0a94-2641-64dc-a148e348a66d"],
 ", with vacuum in the other port, and a detector counts the photons in each \
output. Do the joint counts tell the three sources apart, whatever the \
splitting?"
}], "Text",
 CellID->350566135,ExpressionUUID->"4275553c-d044-3657-225a-ec48aca26662"],

Cell[TextData[{
 "The splitter mixes the source mode ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54736d67-6f2e-a6a2-6a90-3c513f880b49"],
 " with the empty mode ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22ff06be-4aa6-1ecc-63b8-81729612f790"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["N", "TI"], "^"], 
    StyleBox["c", "TI"]], ",", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["N", "TI"], "^"], 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "147faca4-67c8-b48a-3de4-98141fa8a161"],
 " count the photons in its two outputs. The splitter, the source's \
second-order coherence and the detectors' normalized joint count are"
}], "Text",
 CellID->1414769709,ExpressionUUID->"5df540e6-b175-9da6-5dd2-4e8d47c78ace"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["B", "TI"], "^"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["\[Theta]", "TI"], "(", 
      RowBox[{
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["b", "TI"], "^"], "\[Dagger]"], "-", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"], 
       OverscriptBox[
        StyleBox["b", "TI"], "^"]}], ")"}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], "2", 
       StyleBox[")",
        SpanMaxSize->1]}]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "0", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    FractionBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], 
        RowBox[{"\[Dagger]", "2"}]], 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "2"]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     SuperscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        SuperscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "\[Dagger]"], 
        OverscriptBox[
         StyleBox["a", "TI"], "^"]}], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], "2"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["N", "TI"], "^"], 
        StyleBox["c", "TI"]], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["N", "TI"], "^"], 
        StyleBox["d", "TI"]]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["N", "TI"], "^"], 
       StyleBox["c", "TI"]], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["N", "TI"], "^"], 
       StyleBox["d", "TI"]], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}]], "."}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1009561513,ExpressionUUID->"7ca5d22a-f717-ac27-72e8-a5b2f144602c"],

Cell[TextData[{
 "With vacuum in ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d9ab58-1fe6-ddf3-2e54-b5925e19dcc8"],
 ", ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "278a7cf2-d6e7-5ac0-4944-8167ea522d5d"],
 " source photons split binomially, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["k", "TI"], "\[VerticalSeparator]", 
      StyleBox["n", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["n", "TI"], 
      StyleBox["k", "TI"]},
     "Binomial"], 
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], 
     RowBox[{"2", 
      StyleBox["k", "TI"]}]], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], 
     RowBox[{"2", 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["n", "TI"], "-", 
       StyleBox["k", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27cee5db-9c7c-bfd7-03b0-c88831d001bc"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["c", "TI"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["d", "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     RowBox[{"\[Dagger]", "2"}]], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33178756-5299-9819-2456-53c2ba2bede3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["N", "TI"], "^"], 
    StyleBox["c", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["N", "TI"], "^"], 
    StyleBox["d", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"]}], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a8f594e-b895-797a-52b5-fc306074b157"],
 ": for every splitting the joint count is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b49ca17-fa41-f981-6331-7ea605b5cc07"],
 "."
}], "Text",
 CellID->1969470740,ExpressionUUID->"0c0ece2a-d655-d349-150e-fd513000f851"],

Cell[TextData[{
 "The markers are ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16c77b78-0b22-446c-5c82-ee810e87ebd6"],
 " of each source, and the lines the joint counts from the source's \
photon-number distribution and the splitter's exact law ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "\[VerticalSeparator]", 
    StyleBox["n", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0deb852c-06d3-ae2f-63b8-14e4681ae248"],
 ", on 70 levels:"
}], "Text",
 CellID->1554229219,ExpressionUUID->"3e1f7153-400b-9b08-4053-f5e675711a09"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hbtLevels", " ", "=", " ", "70"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbtSources", "[", "nb_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"hbtSources", "[", "nb", "]"}], " ", "=", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Fock |n\:27e9\>\"", " ", "->", " ", 
       RowBox[{"FockState", "[", 
        RowBox[{"nb", ",", " ", "hbtLevels"}], "]"}]}], ",", " ", 
      RowBox[{"\"\<coherent\>\"", " ", "->", " ", 
       RowBox[{
        RowBox[{"CoherentState", "[", "hbtLevels", "]"}], "[", 
        RowBox[{"N", "[", 
         RowBox[{"Sqrt", "[", "nb", "]"}], "]"}], "]"}]}], ",", "\n", "    ", 
      
      RowBox[{"\"\<thermal\>\"", " ", "->", " ", 
       RowBox[{"ThermalState", "[", 
        RowBox[{
         RowBox[{"N", "[", "nb", "]"}], ",", " ", "hbtLevels"}], "]"}]}]}], 
     "|>"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hbtLaw", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", 
        RowBox[{"n", " ", "-", " ", "k"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbtMoments", "[", "th_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"hbtMoments", "[", "th", "]"}], " ", "=", " ", 
    RowBox[{"Transpose", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pk", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{"hbtLaw", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"k", ",", " ", "0", ",", " ", "nn"}], "}"}]}], "]"}],
               " ", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"n", " ", "->", " ", "nn"}], ",", " ", 
                RowBox[{"\[Theta]", " ", "->", " ", "th"}]}], "}"}]}], 
             "]"}]}], ",", " ", 
           RowBox[{"ks", " ", "=", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "nn"}], "]"}]}]}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ks", " ", ".", " ", "pk"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nn", " ", "-", " ", "ks"}], ")"}], " ", ".", " ", 
            "pk"}], ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"ks", " ", 
              RowBox[{"(", 
               RowBox[{"nn", " ", "-", " ", "ks"}], ")"}]}], ")"}], " ", ".", 
            " ", "pk"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"nn", ",", " ", "0", ",", " ", 
         RowBox[{"hbtLevels", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hbtRatio", "[", "th_", "]"}], "[", "src_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"src", "[", "\"\<ProbabilitiesList\>\"", "]"}]}], ",", " ", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"hbtMoments", "[", "th", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"p", " ", ".", " ", 
       RowBox[{"m", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", " ", ".", " ", 
          RowBox[{"m", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"p", " ", ".", " ", 
          RowBox[{"m", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ")"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbtData", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"nb", ",", " ", 
          RowBox[{"f", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"hbtSources", "[", "nb", "]"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"nb", ",", " ", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hbtMarkers", " ", "=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"hbtData", "[", "G2Coherence", "]"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Keys", "[", 
       RowBox[{"hbtSources", "[", "1", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"First", "[", "hbtMarkers", "]"}], ",", " ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"hbtData", "[", 
        RowBox[{"hbtRatio", "[", 
         RowBox[{"\[Pi]", "/", "4"}], "]"}], "]"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"hbtData", "[", 
        RowBox[{"hbtRatio", "[", 
         RowBox[{"\[Pi]", "/", "8"}], "]"}], "]"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dotted"}]}], "]"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.8", ",", " ", "4.2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.05"}], ",", " ", "2.2"}], "}"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", "4", "]"}], ",", " ", "None"}], "}"}]}], 
       "}"}]}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\:27e8n\:27e9\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<g\>\"", ",", " ", "\"\<(2)\>\""}], "]"}], ",", 
           " ", "\"\<(0),   \:27e8\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<N\>\"", ",", " ", "\"\<c\>\""}], "]"}], ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<N\>\"", ",", " ", "\"\<d\>\""}], "]"}], ",", 
           " ", "\"\<\:27e9/\:27e8\>\"", ",", "\n", "      ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<N\>\"", ",", " ", "\"\<c\>\""}], "]"}], ",", 
           " ", "\"\<\:27e9\:27e8\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<N\>\"", ",", " ", "\"\<d\>\""}], "]"}], ",", 
           " ", "\"\<\:27e9\>\""}], "}"}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Last", "[", "hbtMarkers", "]"}], ",", " ", 
     RowBox[{"LineLegend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", " ", "Dotted"}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<joint counts, \[Theta] = \[Pi]/4\>\"", ",", 
         " ", "\"\<joint counts, \[Theta] = \[Pi]/8\>\""}], "}"}]}], "]"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[105]:= ",
 CellID->1950687935,ExpressionUUID->"2e2692e3-ec33-8b1e-6524-68344c27070e"],

Cell[TextData[{
 "The joint counts at both splittings lie on the source's ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fa2740f-c801-8f61-7080-a0140251076a"],
 ". The photon-number state sits below 1, at ",
 Cell[BoxData[
  RowBox[{"1", "-", "1", "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23731daf-255c-c1d5-1e30-ff36b4e020e2"],
 ", the laser at 1 and the thermal lamp at 2, so the joint counts sort the \
sources by their statistics while the mean photon number cannot."
}], "Text",
 CellID->4550225,ExpressionUUID->"70fd53ea-5982-3e0d-18ce-d826fd896592"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1817901213,ExpressionUUID->"6ae7080e-c9ed-5f7d-54bc-9b78dfedd731"],

Cell["What one boson-sampling amplitude costs", "Subsection",
 CellID->74847416,ExpressionUUID->"28a9be76-c57c-d6f4-0241-9bcb07e61bff"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "228e53e5-cfbd-90ca-4877-3c3cd6ca47d0"],
 " identical photons enter a random lossless network of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "2", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492b488b-483c-147d-414e-86468269f43f"],
 " modes with occupation list ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["S", "TI"], "=", "{", 
    SubscriptBox[
     StyleBox["s", "TI"], "1"]}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["m", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a3a7bde-1db9-381a-3569-2a596ff4d970"],
 ", and we ask for the amplitude of one output list ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72d97204-6ed9-7c99-0a96-f865115b76ba"],
 ". How does the cost of that one number depend on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315bf106-894c-57e2-0258-83ad5e2774d5"],
 " and on how the photons share the modes?"
}], "Text",
 CellID->1637861593,ExpressionUUID->"70edf782-d9c0-05ab-4187-791da65bc50e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "028449fd-b3d8-67e0-0ebf-b98981ad1022"],
 " the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "\[Times]", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621a7789-ef06-8386-4f72-7423452bf9fe"],
 " transfer matrix and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], 
   RowBox[{
    StyleBox["T", "TI"], ",", 
    StyleBox["S", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38411260-5d56-117d-79b3-c7c9a9fd5fdd"],
 " the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Times]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "731ee701-9684-8718-0568-23071740aedc"],
 " matrix that repeats column ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1aa4a0df-6eb8-643a-3240-9ad75652e2c7"],
 " ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6a3ab5-fc67-ef36-5e60-eb118f8ad2de"],
 " times and row ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35cbd1af-a190-0e21-3997-7c1031e385b3"],
 " ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "042111a6-9420-5ace-52db-79909b11f51b"],
 " times,"
}], "Text",
 CellID->1114470812,ExpressionUUID->"11573921-2a02-128e-00d3-da85e4f57369"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["T", "TI"], "\[LeftArrow]", 
      StyleBox["S", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["Per",
       FontSlant->"Plain"], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       RowBox[{
        StyleBox["T", "TI"], ",", 
        StyleBox["S", "TI"]}]]}], 
     SqrtBox[
      RowBox[{
       RowBox[{
        RowBox[{
         UnderscriptBox["\[Product]", 
          StyleBox["k", "TI"],
          LimitsPositioning->False], 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["k", "TI"]]}], "!"}], "\[ThinSpace]", 
       RowBox[{
        UnderscriptBox["\[Product]", 
         StyleBox["j", "TI"],
         LimitsPositioning->False], 
        RowBox[{
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["j", "TI"]], "!"}]}]}]]], "."}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->324171658,ExpressionUUID->"364f5d53-c1d2-4914-331d-5ddcb6430349"],

Cell[TextData[{
 "Ryser's and Glynn's formulas evaluate a permanent in about ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[ThinSpace]", 
   SuperscriptBox["2", 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d2fddd3-4039-c6c4-6666-4201ec16131b"],
 " operations. When modes hold several photons, the amplitude can instead be \
grouped into a sum of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["min",
     FontSlant->"Plain"], "\[ThinSpace]", "{", 
    UnderscriptBox["\[Product]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["k", "TI"]], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    UnderscriptBox["\[Product]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["t", "TI"], 
      StyleBox["j", "TI"]], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "432ab1e5-fd78-d5a8-122f-338732c09aca"],
 " terms, each costing about one multiply per pair of occupied input and \
output modes; the computation here takes this grouped sum only when its \
estimated cost is about 50 times below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[ThinSpace]", 
   SuperscriptBox["2", 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cffc24f-257f-9d79-02b0-e163d1577ae9"],
 "."
}], "Text",
 CellID->417709428,ExpressionUUID->"176f5f06-9553-6893-72fd-be4b1308dba3"],

Cell[TextData[{
 "Each amplitude is timed as the fastest of five runs, each with cleared \
caches, with the input in the first ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a44a150-0a22-9676-10d3-5b684a34ada0"],
 " modes and the output pattern moved to the last ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a874467-28e8-1994-282a-8fb0b2adeff3"],
 ":"
}], "Text",
 CellID->1061361203,ExpressionUUID->"3d2edc3d-99b4-5d11-781f-c72f1f7b9322"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bsOccupations", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"PadRight", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"2", " ", "n"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<collision-free\>\"", " ", "->", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", " ", "n"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<pairs\>\"", " ", "->", " ", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"Quotient", "[", 
            RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"\"\<bunched\>\"", " ", "->", " ", 
       RowBox[{"{", "n", "}"}]}]}], "|>"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bsNetwork", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", 
      RowBox[{"1107", " ", "+", " ", 
       RowBox[{"1000", " ", "n"}]}], "]"}], ";", " ", 
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"\"\<Random\>\"", "[", 
       RowBox[{"2", " ", "n"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bsSeconds", "[", 
    RowBox[{"q_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", " ", "=", " ", 
       RowBox[{"RotateRight", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"Total", "[", "s", "]"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Min", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ClearSystemCache", "[", "]"}], ";", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"AbsoluteTiming", "[", 
           RowBox[{"q", "[", 
            RowBox[{"\"\<Amplitude\>\"", ",", " ", 
             RowBox[{"s", " ", "->", " ", "t"}]}], "]"}], "]"}]}]}], ",", " ",
         "5"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bsTimes", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"n", ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"bsNetwork", "[", "n", "]"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"bsSeconds", "[", 
            RowBox[{"q", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"bsOccupations", "[", "n", "]"}]}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
      "12", ",", " ", "14", ",", " ", "16", ",", " ", "18", ",", " ", "20"}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", "bsTimes", "]"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<photons n  (m = 2n modes)\>\"", ",", 
      " ", "\"\<seconds per amplitude\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}], "Input",
 CellLabel->"In[106]:= ",
 CellID->627307494,ExpressionUUID->"2e1cd5ba-07a3-2e30-342e-3a4cd446ae7b"],

Cell[TextData[{
 "The collision-free amplitude grows exponentially, a straight line on the \
log scale. For pairs at these photon numbers the grouped sum is not cheap \
enough (it overtakes the permanent only near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "44"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d25cd64-8a23-b294-0581-5c8cf0753ba9"],
 "), so the permanent is computed and the paired curve tracks the \
collision-free one within timing noise, while the fully bunched amplitude \
needs only ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09e4f50c-4028-7cf4-178a-685e6f1a2198"],
 " terms and stays essentially free."
}], "Text",
 CellID->1650523581,ExpressionUUID->"16578cfe-b102-b360-6fbd-baf735d26588"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1781030251,ExpressionUUID->"18a1eeda-f3ce-2d12-45e4-e78cd36e40c1"],

Cell["Cascaded beam splitters with symbolic photon numbers", "Subsection",
 CellID->1279340886,ExpressionUUID->"3a2dd2f0-8f38-41a8-56b0-6e56ba658822"],

Cell[TextData[{
 "Three modes are chained by beam splitters: the first mixes modes 1 and 2, \
the second modes 2 and 3, the third modes 1 and 2 again, splitter ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e3241a8-5d5d-92b4-3b52-3a20a001ffad"],
 " with mixing angle ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Theta]", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a5f9056-5244-325d-2df5-93798eb1c902"],
 " and phase ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Phi]", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5da0d534-b65a-75c6-4155-e03d505d9863"],
 ". With ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d886609-e190-238e-6aaf-a8586f153b2a"],
 " photons entering each of modes 1 and 2 and mode 3 empty, how likely is the \
pattern ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["n", "TI"], ",", 
      StyleBox["n", "TI"], ",", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366c4ce4-b02d-0bb6-1a93-a09d8b833ea7"],
 " to come back out, for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b75743e-de71-364b-42cb-735b7fb4b41c"],
 " at once?"
}], "Text",
 CellID->30015555,ExpressionUUID->"6546d68f-3d80-65e0-0111-4beb25a395e5"],

Cell["The network is", "Text",
 CellID->979275747,ExpressionUUID->"0ad748ce-607a-7b99-4632-f430928e483f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["U", "TI"], "^"], "=", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["B", "TI"], "^"], "12"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], "3"], ",", 
     SubscriptBox[
      StyleBox["\[Phi]", "TI"], "3"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["B", "TI"], "^"], "23"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], "2"], ",", 
     SubscriptBox[
      StyleBox["\[Phi]", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["B", "TI"], "^"], "12"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Theta]", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["\[Phi]", "TI"], "1"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["B", "TI"], "^"], 
      StyleBox[
       RowBox[{"j", "k"}], "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Theta]", "TI"], ",", 
       StyleBox["\[Phi]", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["\[Theta]", "TI"], "(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         StyleBox[
          RowBox[{"i", "\[Phi]"}], "TI"]], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], 
         StyleBox["j", "TI"]], 
        SubsuperscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], 
         StyleBox["k", "TI"], "\[Dagger]"], "-", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
          StyleBox["i", "TI"], 
          StyleBox["\[Phi]", "TI"]}]], 
        SubsuperscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], 
         StyleBox["j", "TI"], "\[Dagger]"], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], 
         StyleBox["k", "TI"]]}], ")"}]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2027207411,ExpressionUUID->"65f3d3b9-3eb0-332c-2770-7d3462f75d82"],

Cell[TextData[{
 "For this return the phase ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Phi]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dcab936-739d-17bd-0a9d-9dd9e2a7b198"],
 " cancels, because its ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce8d6c3-81a2-5299-33dd-a43493aa6ed6"],
 "-function has equal indices, and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55489b7e-59ce-05a6-5d02-b0d7e692ad35"],
 " enter only through ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], "1"], "-", 
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6214697f-5208-e574-7a5e-29d84a585af5"],
 ". The return probability for general ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763b3286-6ae2-0d0a-348a-e47c867da118"],
 ", every angle and every phase comes out as a sum over one index; the panels \
evaluate it at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], "1"], "=", "\[Pi]", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2713f2dc-3203-b0ad-3927-4d9fd8b0d684"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6dc457-d4f6-26cb-3055-3615e758ff5c"],
 ":"
}], "Text",
 CellID->2096800126,ExpressionUUID->"2d0305ef-595a-9131-7ac9-a4c025f9f7b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cascade", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]1", ",", " ", "\[Phi]1"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]2", ",", " ", "\[Phi]2"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]3", ",", " ", "\[Phi]3"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "}"}], ",", " ", "3"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cascadeProb", " ", "=", " ", 
   RowBox[{"cascade", "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n", ",", " ", "0"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"cascadeReturn", " ", "=", " ", 
   RowBox[{"cascadeProb", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Theta]1", " ", "->", " ", 
       RowBox[{"Pi", "/", "4"}]}], ",", " ", 
      RowBox[{"\[Phi]1", " ", "->", " ", "0"}], ",", " ", 
      RowBox[{"\[Phi]2", " ", "->", " ", "0"}], ",", " ", 
      RowBox[{"\[Phi]3", " ", "->", " ", "0"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cascadeAngles", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "Pi"}], "/", "4"}], ",", " ", 
     RowBox[{"Pi", "/", "8"}], ",", " ", 
     RowBox[{"Pi", "/", "3"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cascadePanel", "[", "a2_", "]"}], " ", ":=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Activate", "[", 
        RowBox[{"N", "[", 
         RowBox[{"cascadeReturn", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Theta]2", " ", "->", " ", "a2"}], ",", " ", 
            RowBox[{"\[Theta]3", " ", "->", " ", "a3"}], ",", " ", 
            RowBox[{"n", " ", "->", " ", "k"}]}], "}"}]}], "]"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"a3", ",", " ", "cascadeAngles"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "12"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "12"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<n\>\"", ",", 
        " ", "\"\<P(|n,n,0\[RightAngleBracket] \[Rule] |n,n,0\
\[RightAngleBracket])\>\""}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Theta]\>\"", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\< = \>\"", ",", " ", "a2"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Theta]\>\"", ",", " ", "3"}], "]"}], ",", 
            " ", "\"\< = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], 
        " ", "/@", " ", "cascadeAngles"}], ")"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cascadePanels", " ", "=", " ", 
   RowBox[{"cascadePanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Pi", "/", "8"}], ",", " ", 
      RowBox[{"Pi", "/", "4"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", "cascadePanels"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "cascadePanels", "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"TraditionalForm", "[", 
      RowBox[{"cascadeProb", " ", "/.", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ",
            "\[Phi]1", ",", " ", "\[Phi]2", ",", " ", "\[Phi]3"}], "}"}], " ",
          "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Theta]", ",", " ", "1"}], "]"}], ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Theta]", ",", " ", "2"}], "]"}], ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Theta]", ",", " ", "3"}], "]"}], ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Phi]", ",", " ", "1"}], "]"}], ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Phi]", ",", " ", "2"}], "]"}], ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Phi]", ",", " ", "3"}], "]"}]}], "}"}]}], "]"}]}], 
      "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[107]:= ",
 CellID->781514613,ExpressionUUID->"3a96d89f-e78d-e970-3e11-9241d16f0387"],

Cell[TextData[{
 "The probability is one finite sum over ",
 Cell[BoxData[
  StyleBox["K", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08d103df-b82f-4409-26b6-84b6fbf1d680"],
 ", the photon number in mode 1 between the first and the last splitter; no \
detector sees ",
 Cell[BoxData[
  StyleBox["K", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19238cb9-9372-db2b-2972-1ba87198bd72"],
 ", so its values interfere. One formula gives the return for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40001730-24cb-3665-3c06-1d16e5a9cd1d"],
 ": without a leak into mode 3, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], "3"], "=", "-", "\[Pi]", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42afd74c-5a4c-ad64-37a8-7450fb8b966c"],
 " undoes the first splitter and the pattern always returns, while any leak \
makes that return fall steadily with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d85d486-0583-3859-018c-8c96ef81a142"],
 "."
}], "Text",
 CellID->597995628,ExpressionUUID->"29835871-f556-7eb5-5492-4d170a2337c1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1118191117,ExpressionUUID->"65cc45cd-02a2-45e1-3d47-2c01b3bb3f5a"],

Cell["The phase of a light field", "Subsection",
 CellID->136230810,ExpressionUUID->"1d4f794b-f038-0470-66de-ca309e233e65"],

Cell[TextData[{
 "A field mode holds ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187c275b-e019-c182-7a82-e29064a4e1e8"],
 " photons on average, either in the number state ",
 Cell[BoxData[
  TemplateBox[{
    OverscriptBox[
     StyleBox["n", "TI"], "_"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37a9868f-375c-d7ca-11fd-ac33658c70b9"],
 ", in the coherent state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79683e4e-22a0-3fca-73a4-86c5e8318a50"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   SqrtBox[
    OverscriptBox[
     StyleBox["n", "TI"], "_"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[Pi]", "/", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "208cd48d-e63c-1bc6-183d-19debc80064d"],
 ", or in a thermal state. How sharply does each of them define a phase?"
}], "Text",
 CellID->2072137268,ExpressionUUID->"3e810c25-fdda-f12f-33bb-c921e7b1c6a2"],

Cell[TextData[{
 "Following Susskind and Glogower, the phase exponential ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["E", "TI"], "^"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["a", "TI"], "^"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{"-", "1", "/", "2"}]], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["n", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      TemplateBox[{
        StyleBox["n", "TI"]},
       "Ket"], 
      TemplateBox[{
        RowBox[{
          StyleBox["n", "TI"], "+", "1"}]},
       "Bra"]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c93e2b2-a0ec-aefb-4336-b43799cc1295"],
 " has the unnormalizable eigenstates ",
 Cell[BoxData[
  TemplateBox[{"\[CurlyPhi]"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333f08f7-1ced-c7a7-143b-b37fa9d4dae9"],
 ", which are not orthogonal but resolve the identity, so a state ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43a857a8-d138-0f0c-7b3d-4219592d4363"],
 " has the phase distribution ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyPhi]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3102a448-9fc8-1caf-1176-df4fec812b2f"],
 ":"
}], "Text",
 CellID->301699750,ExpressionUUID->"58d62b36-58fc-fed9-7352-084389b0211b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["E", "TI"], "^"], 
     TemplateBox[{"\[CurlyPhi]"},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
     TemplateBox[{"\[CurlyPhi]"},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{"\[CurlyPhi]"},
     "Ket"], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["n", "TI"], "\[GreaterEqual]", "0"}],
      LimitsPositioning->False], 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["n", "TI"], "\[CurlyPhi]"}]], 
      TemplateBox[{
        StyleBox["n", "TI"]},
       "Ket"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Pi]"}]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Pi]"}], "\[Pi]"], 
      RowBox[{
       TemplateBox[{"\[CurlyPhi]"},
        "Ket"], 
       TemplateBox[{"\[CurlyPhi]"},
        "Bra"], 
       StyleBox["d", "TI"], "\[CurlyPhi]"}]}]}], "=", "1"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["P", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "\[CurlyPhi]", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       TemplateBox[{"\[CurlyPhi]"},
        "Bra"], 
       StyleBox["\[Rho]", "TI"], 
       TemplateBox[{"\[CurlyPhi]"},
        "Ket"]}], 
      RowBox[{"2", "\[Pi]"}]], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->497349430,ExpressionUUID->"78e93c87-f441-a4aa-406f-d76e45b216b8"],

Cell[TextData[{
 "With the number and coherent states on 60 Fock levels and the thermal state \
on 200, the figure plots ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", 
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyPhi]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a080d9-f0b5-5949-228e-292c6af4b2a4"],
 ", so a uniform distribution sits at 1; the dotted curve is the large-",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "726d0361-9243-2da5-4cba-aa00d5635e28"],
 " limit of the coherent state, ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{"8", "\[Pi]", 
     OverscriptBox[
      StyleBox["n", "TI"], "_"]}]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "2", 
     OverscriptBox[
      StyleBox["n", "TI"], "_"], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"\[CurlyPhi]", "-", "\[Pi]", "/", "3"}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fdbf8bc-6ec0-b18d-76d8-9875bc2f197b"],
 ", a Gaussian of width ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     OverscriptBox[
      StyleBox["n", "TI"], "_"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cf21269-653c-9c4e-7d89-7f51b08c29fe"],
 ":"
}], "Text",
 CellID->1037284428,ExpressionUUID->"2f95f338-b7d7-575a-0a2b-5b584b53e3c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phaseKet", "[", 
    RowBox[{"\[CurlyPhi]_", ",", " ", "d_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", "\[CurlyPhi]", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"d", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phaseStates", "[", "nb_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FockState", "[", 
      RowBox[{"nb", ",", " ", "60"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"CoherentState", "[", "60", "]"}], "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "nb", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"Pi", "/", "3"}]}], "]"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"ThermalState", "[", 
      RowBox[{
       RowBox[{"N", "[", "nb", "]"}], ",", " ", "200"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phasePanel", "[", "nb_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ms", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"#", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", 
          "&"}], " ", "/@", " ", 
         RowBox[{"phaseStates", "[", "nb", "]"}]}]}], ",", " ", 
       RowBox[{"\[CurlyPhi]s", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"N", "[", "Pi", "]"}]}], ",", " ", 
          RowBox[{"N", "[", "Pi", "]"}], ",", " ", "360"}], "]"}]}]}], "}"}], 
     ",", "\n", "   ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"v", " ", "=", " ", 
               RowBox[{"phaseKet", "[", 
                RowBox[{"\[CurlyPhi]", ",", " ", 
                 RowBox[{"Length", "[", "m", "]"}]}], "]"}]}], "}"}], ",", 
             " ", 
             RowBox[{"Re", "[", 
              RowBox[{
               RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "m", " ", 
               ".", " ", "v"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "ms"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[CurlyPhi]", ",", " ", "\[CurlyPhi]s"}], "}"}]}], "]"}],
          ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"8", " ", "Pi", " ", "nb"}], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", "nb", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CurlyPhi]s", " ", "-", " ", 
               RowBox[{"Pi", "/", "3"}]}], ")"}], "^", "2"}]}], "]"}]}]}], 
        "]"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Thick", ",", " ", "Automatic", ",", " ", "Dashed", ",", " ", 
          "Dotted"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<number state\>\"", ",", " ", "\"\<coherent state\>\"", ",",
           " ", "\"\<thermal state\>\"", ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<large-\>\"", ",", " ", 
             RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}], ",", 
             " ", "\"\< Gaussian\>\""}], "}"}], "]"}]}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"-", "Pi"}], ",", " ", "Pi", ",", " ", 
              RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
         "}"}]}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[CurlyPhi]\>\"", ",", 
          " ", "\"\<2\[Pi] P(\[CurlyPhi])\>\""}], "}"}]}], ",", "\n", "    ", 
       
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}], ",", " ", "\"\< = \>\"",
            ",", " ", "nb"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"phasePanels", " ", "=", " ", 
   RowBox[{"phasePanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "4", ",", " ", "16"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Row", "[", 
    RowBox[{
     RowBox[{"First", " ", "/@", " ", "phasePanels"}], ",", " ", 
     RowBox[{"Spacer", "[", "10", "]"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "phasePanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[108]:= ",
 CellID->1002640735,ExpressionUUID->"72ad71d2-7f9b-039e-7014-08f951a3ed3c"],

Cell[TextData[{
 "The number and thermal states lie flat at 1 for every ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "758b270f-f400-49b9-7fe6-eb152e6a0cf2"],
 ": their density matrices are diagonal in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c9ac35f-9297-cc65-31b8-c8d4800f8a89"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{"\[CurlyPhi]"},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    TemplateBox[{"\[CurlyPhi]"},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["n", "TI"],
      LimitsPositioning->False], 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"n", "n"}], "TI"]]}], "=", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f8071f8-153c-b07a-0d09-c0ac3552f381"],
 " and no phase is preferred. The coherent state, a superposition of number \
states with locked relative phases, peaks at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arg",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"], "=", "\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1298871c-61fc-8ee5-1d3c-85a6130642df"],
 " and narrows onto the Gaussian as ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e9f3f85-43da-a41f-6d7b-23cd0ffc1e3e"],
 " grows, so its phase is defined to within ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     OverscriptBox[
      StyleBox["n", "TI"], "_"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a8cb9f-509e-b3cc-6711-158e197bfcf1"],
 "."
}], "Text",
 CellID->1012672790,ExpressionUUID->"31f6a94a-e84c-9e5e-6428-2a5a1f1207d5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1987437535,ExpressionUUID->"19888e25-4844-7d58-1f31-de870e76877c"],

Cell["Balanced homodyne detection of squeezed light", "Subsection",
 CellID->466787693,ExpressionUUID->"36f96255-46b9-ca52-672e-c33746cb4760"],

Cell[TextData[{
 "A signal mode ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b92ab79-8563-73c2-2cdf-65cf282dce1b"],
 " in the displaced squeezed state ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["D", "TI"], "^"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Alpha]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   OverscriptBox[
    StyleBox["S", "TI"], "^"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["r", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "195bacb6-72f1-82ef-24b4-967a09f41ca3"],
 ", with real ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f83364f-97ed-51e0-7e03-7bfd52dc511a"],
 " and ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "461d90cd-565b-b71f-61bf-fcbf7f66f4f3"],
 ", meets a local oscillator, a coherent state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Beta]", "TI"], 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
         StyleBox["i", "TI"], "\[CurlyPhi]"}]]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31bf0d64-ef40-d68c-08d5-d8561ea3f59f"],
 " in mode ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a8f20ad-63dd-4058-585a-9615bef0684f"],
 ", on a balanced beam splitter, and two detectors count the photons ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["N", "TI"], "^"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "778f30cc-10ea-158e-593f-950aa7e74141"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["N", "TI"], "^"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d52ec7e-c625-5fd7-2366-d9cd3ca27a7a"],
 " in its outputs. How strong must the local oscillator be for the difference \
count to show the signal's quadrature noise?"
}], "Text",
 CellID->1584052192,ExpressionUUID->"2886ebd6-91a7-3029-63d2-c9163ddc07cc"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["S", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["r", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "2"], "-", 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], 
       RowBox[{"\[Dagger]", "2"}]]}], 
     StyleBox[")",
      SpanMaxSize->1], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7efbcd9a-aa33-2eb3-7bdf-e487a54381ea"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["D", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], "-", 
      OverscriptBox[
       StyleBox["a", "TI"], "^"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f544de5-701f-3630-3738-396d5dd9ec26"],
 ", the splitter and the quadrature that the oscillator's phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2601723a-ce5c-c5c4-1e30-82e587e9f315"],
 " selects are"
}], "Text",
 CellID->1953741086,ExpressionUUID->"53edca91-3949-2de2-54e0-6e22e62c835a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["B", "TI"], "^"], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      FractionBox["\[Pi]", "4"], "(", 
      RowBox[{
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["b", "TI"], "^"], "\[Dagger]"], "-", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"], 
       OverscriptBox[
        StyleBox["b", "TI"], "^"]}], ")"}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["X", "TI"], "^"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "\[CurlyPhi]", 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         StyleBox["i", "TI"], "\[CurlyPhi]"}]], "+", 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "\[Dagger]"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         StyleBox["i", "TI"], "\[CurlyPhi]"}]]}], ")"}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1103440368,ExpressionUUID->"0872ca66-2746-4177-3f00-0415dd479402"],

Cell[TextData[{
 Cell[BoxData[
  OverscriptBox[
   StyleBox["B", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4811b207-6205-c894-124b-f2625b164238"],
 " turns the difference count, up to its sign, into ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["b", "TI"], "^"], "+", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["b", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1515f15c-310e-9bf8-57bc-97677cbdc42f"],
 ", and its square is normal-ordered; with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348d1630-1dee-f988-331e-05c3a50d8f96"],
 " coherent this gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["c", "TI"]], "-", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "4", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Beta]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
   StyleBox["Var",
    FontSlant->"Plain"], 
   OverscriptBox[
    StyleBox["X", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyPhi]", 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b948d0f-b7e7-7bd8-4dab-4b1653ab6741"],
 ", the second term coming from the signal's own photons beating with the \
oscillator's vacuum fluctuations."
}], "Text",
 CellID->1554416916,ExpressionUUID->"59914042-4745-ef44-5e69-c1a030a58a75"],

Cell[TextData[{
 "With the two modes sent through ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["B", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16c458d2-454a-e299-0ce3-4b7dc4aa1fb8"],
 " on 40 Fock levels each, the markers are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["c", "TI"]], "-", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Beta]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "751d6450-03cb-9de9-2a26-38e35df7ddd9"],
 " from the joint photon-count distribution and the curves the closed form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], 
   OverscriptBox[
    StyleBox["X", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyPhi]", 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "/", "4", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Beta]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32eb14ec-9387-b116-0b61-48519d768780"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["sinh",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "613575f8-e57c-a70f-31b1-4f26f9933404"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], 
   OverscriptBox[
    StyleBox["X", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyPhi]", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64cc95d3-f3df-6fea-1676-8194ba833917"],
 " from the signal's covariance matrix dashed:"
}], "Text",
 CellID->879979874,ExpressionUUID->"3ceffc24-60a6-9b67-32ee-ebdcd07a7a98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hdVars", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"FieldVariables", "[", "\[FormalA]", "]"}], ",", " ", 
     RowBox[{"FieldVariables", "[", "\[FormalB]", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hdCount", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"hdVars", "[", 
      RowBox[{"[", "2", "]"}], "]"}], " ", "**", " ", 
     RowBox[{"hdVars", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"hdVars", "[", 
      RowBox[{"[", "4", "]"}], "]"}], " ", "**", " ", 
     RowBox[{"hdVars", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hdLevels", " ", "=", " ", "40"}], ";", " ", 
  RowBox[{"hdK", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"hdLevels", " ", "-", " ", "1"}]}], "]"}]}], ";", " ", 
  RowBox[{"hdDiff", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"Subtract", ",", " ", "hdK", ",", " ", "hdK"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hdSplitter", " ", "=", " ", 
   RowBox[{"BeamSplitterOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"Pi", "/", "4"}], "]"}], ",", " ", "0"}], "}"}], ",", " ", 
     "hdLevels"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hdNoise", "[", 
     RowBox[{"sig_", ",", " ", "\[Beta]_"}], "]"}], "[", "\[CurlyPhi]_", 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pr", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hdSplitter", "[", 
           RowBox[{"QuantumTensorProduct", "[", 
            RowBox[{"sig", ",", " ", 
             RowBox[{
              RowBox[{"PhaseShiftOperator", "[", 
               RowBox[{"\[CurlyPhi]", ",", " ", "hdLevels"}], "]"}], " ", "@",
               " ", 
              RowBox[{
               RowBox[{"CoherentState", "[", "hdLevels", "]"}], "[", 
               "\[Beta]", "]"}]}]}], "]"}], "]"}], 
          "[", "\"\<ProbabilitiesList\>\"", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"hdLevels", ",", " ", "hdLevels"}], "}"}]}], "]"}]}], "}"}],
      ",", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"hdDiff", "^", "2"}], " ", "pr"}], ",", " ", "2"}], "]"}], 
        " ", "-", " ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"hdDiff", " ", "pr"}], ",", " ", "2"}], "]"}], "^", 
         "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"\[Beta]", "^", "2"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hdPanel", "[", 
    RowBox[{"\[Alpha]_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sig", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"DisplacementOperator", "[", 
            RowBox[{
             RowBox[{"N", "[", "\[Alpha]", "]"}], ",", " ", "hdLevels"}], 
            "]"}], " ", "@", " ", 
           RowBox[{
            RowBox[{"SqueezeOperator", "[", 
             RowBox[{
              RowBox[{"N", "[", "r", "]"}], ",", " ", "hdLevels"}], "]"}], 
            " ", "@", " ", 
            RowBox[{"FockState", "[", 
             RowBox[{"0", ",", " ", "hdLevels"}], "]"}]}]}], ")"}], 
         "[", "\"\<Normalize\>\"", "]"}]}], ",", " ", 
       RowBox[{"\[CurlyPhi]s", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"0.", ",", " ", 
          RowBox[{"N", "[", "Pi", "]"}], ",", " ", "12"}], "]"}]}]}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"varX", " ", "=", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Sigma]", " ", "=", " ", 
             RowBox[{"CovarianceMatrix", "[", "sig", "]"}]}], "}"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", "#", "]"}], ",", " ", 
                RowBox[{"Sin", "[", "#", "]"}]}], "}"}], " ", ".", " ", 
              "\[Sigma]", " ", ".", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", "#", "]"}], ",", " ", 
                RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}], "/", "2"}], " ", 
            "&"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"Show", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"LogPlot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
