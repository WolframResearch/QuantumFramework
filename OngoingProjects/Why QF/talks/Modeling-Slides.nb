Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dgzZ", "[", 
    RowBox[{"n_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Z\>\"", ",", " ", 
     RowBox[{"{", "k", "}"}], ",", " ", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dgzRho", "[", "\[Psi]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"\[Psi]", "[", "\"\<Qudits\>\"", "]"}]}], "}"}], ",", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumEvolve", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"\[Omega]", "/", "2"}], " ", 
               RowBox[{"dgzZ", "[", 
                RowBox[{"n", ",", " ", "#"}], "]"}]}], " ", "&"}], " ", "/@", 
             " ", 
             RowBox[{"Range", "[", "n", "]"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"dgzZ", "[", 
               RowBox[{"n", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
             " ", 
             RowBox[{"Range", "[", "n", "]"}]}], " ", "->", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"\[Gamma]", ",", " ", "n"}], "]"}]}], ",", " ", "\[Psi]",
            ",", " ", "t"}], "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], 
        "]"}], ",", " ", 
       RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dgzQFI", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"es", " ", "=", " ", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"\[Rho]", " ", "/.", " ", 
         RowBox[{"\[Omega]", " ", "->", " ", "0"}]}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "=", " ", 
          RowBox[{"First", "[", "es", "]"}]}], ",", " ", 
         RowBox[{"V", " ", "=", " ", 
          RowBox[{"Orthogonalize", "[", 
           RowBox[{"Last", "[", "es", "]"}], "]"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"M", " ", "=", " ", 
           RowBox[{
            RowBox[{"Conjugate", "[", "V", "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{"\[Rho]", ",", " ", "\[Omega]"}], "]"}], " ", "/.", 
              " ", 
              RowBox[{"\[Omega]", " ", "->", " ", "0"}]}], ")"}], " ", ".", 
            " ", 
            RowBox[{"Transpose", "[", "V", "]"}]}]}], "}"}], ",", "\n", 
         "    ", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"PossibleZeroQ", "[", "#2", "]"}], ",", " ", "0", ",",
                    " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "#1", "]"}], "^", "2"}], "/", 
                    "#2"}]}], "]"}], " ", "&"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"M", ",", " ", 
                  RowBox[{"Outer", "[", 
                   RowBox[{
                   "Plus", ",", " ", "\[Lambda]", ",", " ", "\[Lambda]"}], 
                   "]"}]}], "}"}], ",", " ", "2"}], "]"}], ",", " ", "2"}], 
             "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"\[Gamma]", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"t", " ", ">", " ", "0"}]}]}], "]"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dgzF", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dgzQFI", "[", 
        RowBox[{"dgzRho", "[", 
         RowBox[{"QuantumState", "[", 
          RowBox[{"\"\<GHZ\>\"", "[", "n", "]"}], "]"}], "]"}], "]"}], ",", 
       " ", 
       RowBox[{"dgzQFI", "[", 
        RowBox[{"dgzRho", "[", 
         RowBox[{"QuantumState", "[", 
          RowBox[{"StringRepeat", "[", 
           RowBox[{"\"\<+\>\"", ",", " ", "n"}], "]"}], "]"}], "]"}], "]"}]}],
       "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dgzBest", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Maximize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "/", "t"}], " ", "/.", " ", 
           RowBox[{"\[Gamma]", " ", "->", " ", "1"}]}], ",", " ", 
          RowBox[{"t", " ", ">", " ", "0"}]}], "}"}], ",", " ", "t"}], "]"}], 
      " ", "&"}], ",", " ", "dgzF", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dgzForms", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"k", "^", "2"}], " ", 
      RowBox[{"t", "^", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "4"}], " ", "k", " ", "\[Gamma]", " ", "t"}], "]"}]}], ",",
      " ", 
     RowBox[{"k", " ", 
      RowBox[{"t", "^", "2"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "4"}], " ", "\[Gamma]", " ", "t"}], "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dgzMatch", " ", "=", " ", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"dgzF", " ", "-", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"dgzForms", "[", "k", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}],
     " ", "===", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dgzAnyN", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"f", ",", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t0", " ", "=", " ", 
          RowBox[{"t", " ", "/.", " ", 
           RowBox[{"First", "[", 
            RowBox[{"Solve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"f", "/", "t"}], ",", " ", "t"}], "]"}], " ", "==", 
               " ", "0"}], ",", " ", "t"}], "]"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"f", "/", "t"}], " ", "/.", " ", 
            RowBox[{"t", " ", "->", " ", "t0"}]}], "]"}], ",", " ", "t0"}], 
         "}"}]}], "]"}]}], "]"}], " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"dgzForms", "[", "n", "]"}], " ", "/.", " ", 
      RowBox[{"\[Gamma]", " ", "->", " ", "1"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dgzPanel", "[", "i_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dgzF", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", "t"}], " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "0.6"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<GHZ\>\"", ",", " ", "\"\<product\>\""}], "}"}]}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"List", " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"t", " ", "/.", " ", 
              RowBox[{"Last", "[", "#", "]"}]}], ",", " ", 
             RowBox[{"First", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"dgzBest", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "10"}], "}"}]}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0.6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0.5"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Gamma] t\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Gamma] \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<F\>\"", ",", " ", "\"\<Q\>\""}], "]"}], ",", 
           " ", "\"\</t\>\""}], "}"}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"Inset", "[", 
       RowBox[{
        RowBox[{"Framed", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<n = \>\"", ",", " ", 
               RowBox[{"i", " ", "+", " ", "1"}]}], "}"}], "]"}], ",", " ", 
            "10"}], "]"}], ",", " ", 
          RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
          RowBox[{"FrameStyle", " ", "->", " ", 
           RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
          RowBox[{"FrameMargins", " ", "->", " ", "2"}]}], "]"}], ",", " ", 
        RowBox[{"Scaled", "[", 
         RowBox[{"{", 
          RowBox[{"0.97", ",", " ", "0.97"}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dgzPanels", " ", "=", " ", 
   RowBox[{"dgzPanel", " ", "/@", " ", 
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
