     RowBox[{"Contours", " ", "->", " ", "20"}], ",", " ", 
     RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", "\n", "   ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
