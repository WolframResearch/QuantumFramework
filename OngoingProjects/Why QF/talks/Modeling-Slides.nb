    StyleBox["r", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c0cb092-4ea7-eed8-6664-06124d93b753"],
 ", with time in units of ",
 Cell[BoxData[
