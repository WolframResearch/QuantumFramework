 ","
}], "Text",
 CellID->474279505,ExpressionUUID->"1a74626e-1156-6fdb-34f1-a694077ca08f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["k", "TI"],
       LimitsPositioning->False], 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["k", "TI"]], 
       TemplateBox[{
         StyleBox["k", "TI"]},
        "Ket"], 
       TemplateBox[{
         StyleBox["k", "TI"]},
        "Bra"]}]}], "+", 
     RowBox[{
      StyleBox["V", "TI"], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["k", "TI"],
        LimitsPositioning->False], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            StyleBox["i", "TI"]},
           "Ket"], 
          TemplateBox[{
            StyleBox["k", "TI"]},
           "Bra"]}], "+", 
         RowBox[{
          TemplateBox[{
            StyleBox["k", "TI"]},
           "Ket"], 
          TemplateBox[{
            StyleBox["i", "TI"]},
           "Bra"]}]}], ")"}]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{"1", "-", 
     RowBox[{
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["i", "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}], "\[TildeTilde]", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["k", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"4", 
         SuperscriptBox[
          StyleBox["V", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["sin",
           FontSlant->"Plain"], "2"], "\[ThinSpace]", 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          SubscriptBox[
           StyleBox["E", "TI"], 
           StyleBox["k", "TI"]], 
          StyleBox["t", "TI"], "/", "2"}], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        SubsuperscriptBox[
         StyleBox["E", "TI"], 
         StyleBox["k", "TI"], "2"]], "\[LongRightArrow]", "\[CapitalGamma]"}], 
      StyleBox["t", "TI"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalGamma]", "=", 
    FractionBox[
     RowBox[{"2", "\[Pi]", 
      SuperscriptBox[
       StyleBox["V", "TI"], "2"]}], 
     StyleBox["\[Delta]", "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->462495998,ExpressionUUID->"2643c043-46d9-2b87-1895-a40e6609a761"],

Cell[TextData[{
 "where the limit treats the band as a continuum of density ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Delta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "414fb427-5e79-8cab-533f-a528ee4020bf"],
 "."
}], "Text",
 CellID->258659266,ExpressionUUID->"7c254d90-f5e7-9025-4b07-79059fa8e636"],

Cell[TextData[{
 "Diagonalizing ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d3f6d46-84ca-9e4e-751c-720fda939bf0"],
 ", with ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa22c11-2734-07cf-55d4-b2b8c0f3102f"],
 " set by ",
 Cell[BoxData["\[CapitalGamma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c884a59-d972-d102-5b11-16469165e8b1"],
 ", gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        UnderscriptBox["\[Sum]", 
         StyleBox["n", "TI"],
         LimitsPositioning->False], 
        SuperscriptBox[GridBox[{
           {
            TemplateBox[{
              StyleBox["n", "TI"], 
              StyleBox["i", "TI"]},
             "BraKet"]}
          },
          GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
          GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
          StyleBox["i", "TI"], 
          SubscriptBox[
           StyleBox["E", "TI"], 
           StyleBox["n", "TI"]], 
          StyleBox["t", "TI"]}]]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bf34a1-f46a-dc98-7e88-1039624fd77f"],
 " as an exact finite sum of oscillating terms in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eed13f3-b62c-102c-74cc-be5fd49e72b5"],
 " over its eigenstates ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3faad66c-212c-4c90-0abd-f350b853c79d"],
 ", compared with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[CapitalGamma]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ab724c9-10cf-2a1f-580f-d923d8319b26"],
 " (dashed), with time in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[CapitalGamma]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ee830c2-c7b0-55df-11df-f612f4ec4148"],
 ":"
}], "Text",
 CellID->928836406,ExpressionUUID->"7fb8370c-453f-61e1-054e-3d047f5db6e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fgrH", "[", 
    RowBox[{"gd_", ",", " ", "wg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kk", " ", "=", " ", 
        RowBox[{"Round", "[", 
         RowBox[{"wg", " ", 
          RowBox[{"gd", "/", "2"}]}], "]"}]}], ",", " ", 
       RowBox[{"fgrV", " ", "=", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi", " ", "gd"}], ")"}]}], "]"}]}]}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"N", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "j_"}], "}"}], " ", "/;", " ", 
             RowBox[{"j", " ", ">", " ", "1"}]}], " ", "->", " ", "fgrV"}], ",",
            " ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"j_", ",", " ", "1"}], "}"}], " ", "/;", " ", 
             RowBox[{"j", " ", ">", " ", "1"}]}], " ", "->", " ", "fgrV"}], ",",
            " ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"j_", ",", " ", "j_"}], "}"}], " ", "/;", " ", 
             RowBox[{"j", " ", ">", " ", "1"}]}], " ", "->", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"j", " ", "-", " ", "kk", " ", "-", " ", "2"}], ")"}], "/",
              "gd"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"2", " ", "kk"}], " ", "+", " ", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"2", " ", "kk"}], " ", "+", " ", "2"}]}], "}"}]}], "]"}], 
       "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fgrP", "[", 
    RowBox[{"gd_", ",", " ", "wg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"es", " ", "=", " ", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"fgrH", "[", 
         RowBox[{"gd", ",", " ", "wg"}], "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"es", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}], 
           "]"}], "^", "2"}], ")"}], " ", ".", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"es", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "t"}], "]"}]}], "]"}], "^", 
      "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fgrPanel", "[", 
    RowBox[{"wg_", ",", " ", "gd_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"fgrP", "[", 
         RowBox[{"gd", ",", " ", "wg"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "15"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", " ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "t"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "15"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalGamma] t\>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<P\>\"", ",", " ", "\"\<i\>\""}], "]"}]}], "}"}]}], ",", 
     "\n", "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[CapitalGamma]/\[Delta] = \>\"", ",", " ", "gd", ",", 
         " ", "\"\<,   W/\[CapitalGamma] = \>\"", ",", " ", "wg"}], "}"}], 
       "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{"Outer", "[", 
   RowBox[{"fgrPanel", ",", " ", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "40"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0.5", ",", " ", "2", ",", " ", "8"}], "}"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[66]:= ",
 CellID->1026062183,ExpressionUUID->"67bc9a71-725c-99f6-3e14-0cfb4925132b"],

Cell[TextData[{
 "In the wide band the population follows ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[CapitalGamma]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6505db2a-f9cf-1d90-21d8-e19f45be98e2"],
 " until ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "2", "\[Pi]", "/", 
   StyleBox["\[Delta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "709b1c80-5614-0e87-259a-8c13cfd45483"],
 ", when the levels come back into phase and return part of it; the smaller \
",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "/", 
   StyleBox["\[Delta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4442c7cd-9726-25d2-1c93-83f3cfdfe58e"],
 ", the earlier this revival: at ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "/", 
   StyleBox["\[Delta]", "TI"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ca562b5-6636-fba4-0955-7962c18ea733"],
 " it repeats several times within the plotted time, and at ",
 Cell[BoxData[
  RowBox[{"\[CapitalGamma]", "/", 
   StyleBox["\[Delta]", "TI"], "=", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27eb74ba-63a2-9922-523c-817695221119"],
 " it comes after it. The narrow band breaks the rule at short times: the \
population starts flat, stays above ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[CapitalGamma]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d4a985d-9631-b5b6-3cbc-fa9aaed6f0cc"],
 ", then falls below it."
}], "Text",
 CellID->734189399,ExpressionUUID->"481e500b-78ca-df16-0c32-e25d4f15aab7"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->991087451,ExpressionUUID->"5ebca030-b4d0-9c68-4d53-a432b5532de6"],

Cell["\<\
An atom in a thermal cavity field: where the populations settle\
\>", "Subsection",
 CellID->1028179726,ExpressionUUID->"10619f1b-ea05-023c-4264-9c8a4517efbf"],

Cell[TextData[{
 "A two-level atom, frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "742f17ec-c4d9-92ee-233e-eb777d3b15ac"],
 ", starts with excited-state population ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e150b69-d38d-6025-13c0-6ff114aaef9e"],
 " in a cavity of frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05c0824a-0495-bd39-2ae0-82e7ff2375f6"],
 " whose field is thermal with mean photon number ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4f2403-f961-8e4b-08f2-ed5d40d73811"],
 ", and couples to it at strength ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d73c735-6164-f378-18c9-65bccf462d6c"],
 ". On average over long times, what ratio of excited to ground population \
does the atom settle at?"
}], "Text",
 CellID->1088621025,ExpressionUUID->"01f8cdf8-d444-d5f1-09de-402ccf4a0a6d"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49525a06-df22-6ca2-5116-a9dd615d33eb"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b242c49-d474-5a50-3fcb-08889e032b80"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cb59e0d-e23a-cc58-02f8-df1ed1ca8bda"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["a", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75c23f41-e92b-f724-7614-ed62d1faaf3f"],
 ", the Jaynes-Cummings Hamiltonian and its form in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073120ea-5e31-3786-4864-fe8eb481d1bf"],
 " are"
}], "Text",
 CellID->1963137299,ExpressionUUID->"3b4cada2-2413-0ac9-7a37-359e16db5cff"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["\[Omega]", "TI"], 
       StyleBox["c", "TI"]], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"]}], "+", 
     RowBox[{
      FractionBox[
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["a", "TI"]], "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]]}], "+", 
     RowBox[{
      StyleBox["g", "TI"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox[
           OverscriptBox[
            StyleBox["\[Sigma]", "TI"], "^"], "-"], 
          SuperscriptBox[
           OverscriptBox[
            StyleBox["a", "TI"], "^"], "\[Dagger]"]}], "+", 
         RowBox[{
          SubscriptBox[
           OverscriptBox[
            StyleBox["\[Sigma]", "TI"], "^"], "+"], 
          OverscriptBox[
           StyleBox["a", "TI"], "^"]}]}], ")"}], "\[LongRightArrow]", 
       FractionBox["\[CapitalDelta]", "2"]}], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]]}], "+", 
     RowBox[{
      StyleBox["g", "TI"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["\[Sigma]", "TI"], "^"], "-"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["a", "TI"], "^"], "\[Dagger]"]}], "+", 
        RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["\[Sigma]", "TI"], "^"], "+"], 
         OverscriptBox[
          StyleBox["a", "TI"], "^"]}]}], ")"}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox[
      RowBox[{"f", "i", "e", "l", "d"}], "TI"]], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["n", "TI"], "\[GreaterEqual]", "0"}],
      LimitsPositioning->False], 
     RowBox[{
      FractionBox[
       OverscriptBox[
        OverscriptBox[
         StyleBox["n", "TI"], "_"], 
        RowBox[{"\[ThinSpace]", 
         StyleBox["n", "TI"]}]], 
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          OverscriptBox[
           StyleBox["n", "TI"], "_"], "+", "1"}], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        RowBox[{
         StyleBox["n", "TI"], "+", "1"}]]], 
      TemplateBox[{
        StyleBox["n", "TI"]},
       "Ket"], 
      RowBox[{
       TemplateBox[{
         StyleBox["n", "TI"]},
        "Bra"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1959740799,ExpressionUUID->"591c4d6f-32b1-13d4-4364-c81634d32026"],

Cell[TextData[{
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73d22ac3-b3a0-cafa-514e-a251e73e1df9"],
 " couples ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0262208b-427b-a10c-49e2-bb473803317b"],
 " only to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["n", "TI"], "+", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66a9676a-e280-5c4a-5d6e-9341e4d93afe"],
 ", and the long-time average keeps only the part of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58237999-7816-41e0-70be-1c40b3f0a26f"],
 " diagonal in the eigenbasis of each such pair. An atomic coherence links ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78ddffe3-5bf1-fc17-7581-ba7edd70c9c8"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40552819-dec9-4ea9-37b9-5efd5672624c"],
 ", which sit in different pairs, so it drops out, and the atom starts as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], 
    TemplateBox[{
      StyleBox["e", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["e", "TI"]},
     "Bra"]}], "+", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["c", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      StyleBox["g", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["g", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a933b1a-0729-db68-1ec0-121423351e84"],
 "."
}], "Text",
 CellID->1451431996,ExpressionUUID->"3b6c40a1-d394-a3c0-60d8-e41a48465f43"],

Cell[TextData[{
 "Each pair's populations, averaged from its eigenvectors and summed over the \
thermal distribution, give the closed form (curves); the time average of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c1230e9-5b14-ee4c-3519-0d84d672931d"],
 " in the eigenbasis of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b1d5082-48e7-98dc-6063-7b26b8f44b84"],
 " on 100 Fock levels, for general ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66313025-5778-a126-1666-c5a67d9458aa"],
 ", gives the markers; ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0406719c-099e-96a9-2d36-f84d6feb7e6d"],
 " is in units of ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56112a21-0571-be95-05eb-11dc4d538215"],
 ":"
}], "Text",
 CellID->1299574811,ExpressionUUID->"14caf9e1-9f32-2b9d-1678-01a2face46fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"jctFromE", "[", 
    RowBox[{"\[CapitalDelta]_", ",", " ", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "^", "4"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", " ", ".", " ", "#"}], ")"}], "^", "2"}]}], " ", "&"}],
        " ", "/@", " ", 
       RowBox[{"Eigenvectors", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "/", "2"}], ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"m", " ", "+", " ", "1"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"m", " ", "+", " ", "1"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"-", "\[CapitalDelta]"}], "/", "2"}]}], "}"}]}], "}"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"m", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[CapitalDelta]", " ", "\[Element]", " ", "Reals"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jctFromG", "[", 
    RowBox[{"\[CapitalDelta]_", ",", " ", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", " ", ".", " ", "#"}], ")"}], "^", "2"}]}]}], " ", 
        "&"}], " ", "/@", " ", 
       RowBox[{"Eigenvectors", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "/", "2"}], ",", " ", 
            RowBox[{"Sqrt", "[", "m", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "m", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"-", "\[CapitalDelta]"}], "/", "2"}]}], "}"}]}], "}"}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[CapitalDelta]", " ", "\[Element]", " ", "Reals"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jctPe", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"nb", "^", "m"}], "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nb", " ", "+", " ", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"m", " ", "+", " ", "1"}], ")"}]}]}], " ", 
          RowBox[{"jctFromE", "[", 
           RowBox[{"\[CapitalDelta]", ",", " ", "m"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], 
        "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "c"}], ")"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"nb", "^", "m"}], "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nb", " ", "+", " ", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"m", " ", "+", " ", "1"}], ")"}]}]}], " ", 
          RowBox[{"jctFromG", "[", 
           RowBox[{"\[CapitalDelta]", ",", " ", "m"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "1", ",", " ", "Infinity"}], "}"}]}], 
        "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"nb", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[CapitalDelta]", " ", "\[Element]", " ", "Reals"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jctRatio", " ", "=", " ", 
   RowBox[{"jctPe", "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", "jctPe"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jctA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"100", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"jctLower", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jctQF", "[", "\[CapitalDelta]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"es", " ", "=", " ", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"N", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
              RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", 
             " ", 
             RowBox[{"jctLower", " ", "@", " ", 
              RowBox[{"SuperDagger", "[", "jctA", "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"SuperDagger", "[", "jctLower", "]"}], " ", "@", " ", 
              "jctA"}]}], ")"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w", " ", "=", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"es", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "#"}], "]"}], "]"}], "]"}], " ", ".",
                 " ", 
                RowBox[{"Conjugate", "[", 
                 RowBox[{"es", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", " ", "#"}], "]"}], "]"}], "]"}]}], "]"}],
               "^", "2"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"GatherBy", "[", 
             RowBox[{
              RowBox[{"Range", "[", "200", "]"}], ",", " ", 
              RowBox[{
               RowBox[{"Round", "[", 
                RowBox[{
                 RowBox[{"es", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", " ", "#"}], "]"}], "]"}], ",", " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "8"}]}]}], "]"}], " ", "&"}]}], "]"}]}], 
           "]"}]}], ",", "\n", "     ", 
         RowBox[{"\[Rho]0", " ", "=", " ", 
          RowBox[{"Diagonal", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{
             RowBox[{"QuantumTensorProduct", "[", 
              RowBox[{
               RowBox[{"QuantumState", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"c", ",", " ", "0"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", " ", 
                    RowBox[{"1", " ", "-", " ", "c"}]}], "}"}]}], "}"}], 
                "]"}], ",", " ", 
               RowBox[{"ThermalState", "[", 
                RowBox[{"nb", ",", " ", "100"}], "]"}]}], "]"}], 
             "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}]}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "/", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "#"}], ")"}]}], " ", "&"}], "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"w", "[", 
           RowBox[{"[", 
            RowBox[{"1", " ", ";;", " ", "100"}], "]"}], "]"}], "]"}], " ", ".",
          " ", "\[Rho]0"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jctMarks", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"jctQF", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jctPanel", "[", "cv_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"jctRatio", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c", " ", "->", " ", "cv"}], ",", " ", 
             RowBox[{"\[CapitalDelta]", " ", "->", " ", "#"}]}], "}"}]}], " ",
           "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"nb", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[CapitalDelta]/g = \>\"", ",", " ", "#"}], "}"}], 
            "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "2", ",", " ", "5"}], "}"}]}], ")"}]}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", 
             RowBox[{
              RowBox[{"jctMarks", "[", "#", "]"}], " ", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nb", " ", "->", " ", "x"}], ",", " ", 
                RowBox[{"c", " ", "->", " ", "cv"}]}], "}"}]}]}], "}"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", 
             RowBox[{"{", 
              RowBox[{
              "0.5", ",", " ", "1", ",", " ", "2", ",", " ", "3", ",", " ", 
               "4.5", ",", " ", "6"}], "}"}]}], "}"}]}], "]"}], " ", "&"}], 
        " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2", ",", " ", "5"}], "}"}]}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "9"}], "}"}]}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}], ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"OverBar", "[", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<P\>\"", ",", " ", "\"\<e\>\""}], "]"}], "]"}], ",", 
           " ", "\"\</\>\"", ",", " ", 
           RowBox[{"OverBar", "[", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<P\>\"", ",", " ", "\"\<g\>\""}], "]"}], "]"}]}], 
          "}"}], "]"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<c = \>\"", ",", " ", 
         RowBox[{"InputForm", "[", "cv", "]"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "290"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jctPanels", " ", "=", " ", 
   RowBox[{"jctPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", 
      RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"First", " ", "/@", " ", "jctPanels"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "jctPanels", "]"}], "]"}], "]"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalDelta] = 0:   \>\"", ",", " ", 
        RowBox[{"OverBar", "[", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<P\>\"", ",", " ", "\"\<e\>\""}], "]"}], "]"}], ",", 
        " ", "\"\</\>\"", ",", " ", 
        RowBox[{"OverBar", "[", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<P\>\"", ",", " ", "\"\<g\>\""}], "]"}], "]"}], ",", 
        " ", "\"\< = \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{
          RowBox[{"FullSimplify", "[", 
           RowBox[{
            RowBox[{"jctRatio", " ", "/.", " ", 
             RowBox[{"\[CapitalDelta]", " ", "->", " ", "0"}]}], ",", " ", 
            RowBox[{"nb", " ", ">", " ", "0"}]}], "]"}], " ", "/.", " ", 
          RowBox[{"nb", " ", "->", " ", 
           RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}]}]}], "]"}]}], "}"}], 
      "]"}], ",", " ", "14", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[67]:= ",
 CellID->1124555597,ExpressionUUID->"06a15516-9b2d-1a51-5ccd-82d529765270"],

Cell[TextData[{
 "On resonance the state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e04c38-d30c-6348-0a49-8d25d1298661"],
 " never evolves, so the ground state keeps an excess that fades as the field \
warms and every start approaches equal populations; an excited atom on \
resonance sits at equal populations for every ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec1af83-4707-ecb8-7edd-606d4869a9a5"],
 ". Detuning keeps the atom nearer its starting state, so an atom that starts \
in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055eccc2-3063-22d1-3956-eaa8dc43a28e"],
 " or in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c520d5f-3605-97c6-1110-ca4dd9c1a2a7"],
 " approaches equal populations more slowly."
}], "Text",
 CellID->753083579,ExpressionUUID->"28a63b46-7485-3102-0d2c-ba08952df792"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1538264166,ExpressionUUID->"443a47ef-357a-d12b-5d30-6953b6a1a297"],

Cell["Circuits, codes and algorithms", "Section",
 CellID->1801210539,ExpressionUUID->"0cc88e0f-1ddb-ee1c-6844-1703962f589e"],

Cell["\<\
The examples in this section are quantum circuits. The textbook algorithms \
appear with their full output distributions: Grover search, phase estimation, \
Shor's factoring and his discrete logarithm on an elliptic curve, \
Deutsch-Jozsa and Bernstein-Vazirani, HHL, QAOA and a variational \
ground-state search. Alongside them come teleportation, a CHSH strategy \
imported from OpenQASM, the sign of a 2\[Pi] rotation, Heisenberg-limited \
phase sensing, compiling a rotation from H and T, search on one qudit, and \
one site of a Trotterized Ising chain. Error correction runs through the \
section: the repetition, five-qubit, Shor and Steane codes, their syndromes \
and exact logical error rates, noise inside the measuring circuit, and a code \
watched continuously. Stabilizer methods carry a thousand-qubit GHZ state and \
keep measurement outcomes as symbolic bits. QF builds the circuits from named \
gates or imported QASM, runs them as state vectors, tensor networks or \
stabilizer tableaux, and returns probabilities and error rates as exact \
numbers or polynomials.\
\>", "Text",
 CellID->723659743,ExpressionUUID->"0bb77c47-40bb-8b35-3f95-3c6499ea6638"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->252597621,ExpressionUUID->"4b227fd7-0ce1-b4dd-6fc0-749aaa9e17fd"],

Cell["QAOA on MaxCut: the exact landscape and a certified optimum", \
"Subsection",
 CellID->1325113891,ExpressionUUID->"3d097d3a-93e7-530c-275d-cace044324d4"],

Cell[TextData[{
 "Color the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "616108d6-068b-1273-41d9-961afd04bb45"],
 " vertices of a graph with two colors so that as many edges as possible join \
different colors; take the triangle, the square and the complete graph ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69d7490a-0a73-0e2c-1869-a14e327944e6"],
 ". One layer of the quantum approximate optimization algorithm (QAOA) \
prepares a state that depends on two angles ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "293f4287-288e-46db-32a9-0095f54703a4"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d952035-2168-b81f-471a-17c461ab15ef"],
 " and scores it by the expected number of cut edges. How close does the best \
pair of angles come to the true maximum cut?"
}], "Text",
 CellID->2095869317,ExpressionUUID->"10fd4e8c-9c75-85e6-44e6-879a438d8a3b"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["Z", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3575bd7f-1958-1f29-5407-08a46bd3143d"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["X", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3faddc86-fbc0-27e5-2d2d-eb21193e1bd9"],
 " the Pauli operators on vertex ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01882449-c493-810a-5e13-da485afaa54f"],
 ", the cost Hamiltonian, the one-layer state and its landscape are"
}], "Text",
 CellID->505127192,ExpressionUUID->"3f63b879-a34e-5dda-3d8e-75ddb3827007"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["C", "TI"]], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1], "\[Element]", "\[ScriptCapitalE]"}],
      LimitsPositioning->False], 
     FractionBox[
      RowBox[{"1", "-", 
       SubscriptBox[
        StyleBox["Z", "TI"], 
        StyleBox["i", "TI"]], 
       SubscriptBox[
        StyleBox["Z", "TI"], 
        StyleBox["j", "TI"]]}], "2"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Gamma]", "TI"], ",", 
        StyleBox["\[Theta]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], "=", 
    RowBox[{
     UnderscriptBox["\[Product]", 
      StyleBox["i", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["i", "TI"], 
        StyleBox["\[Theta]", "TI"], 
        SubscriptBox[
         StyleBox["X", "TI"], 
         StyleBox["i", "TI"]], "/", "2"}]], 
      RowBox[{
       UnderscriptBox["\[Product]", 
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          StyleBox["i", "TI"], ",", 
          StyleBox["j", "TI"]}], 
         StyleBox[")",
          SpanMaxSize->1], "\[Element]", "\[ScriptCapitalE]"}],
        LimitsPositioning->False], 
       RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
          StyleBox["i", "TI"], 
          StyleBox["\[Gamma]", "TI"], 
          SubscriptBox[
           StyleBox["Z", "TI"], 
           StyleBox["i", "TI"]], 
          SubscriptBox[
           StyleBox["Z", "TI"], 
           StyleBox["j", "TI"]], "/", "2"}]], 
        SuperscriptBox[
         TemplateBox[{"+"},
          "Ket"], 
         RowBox[{"\[CircleTimes]", 
          StyleBox["n", "TI"]}]]}]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["E", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Gamma]", "TI"], ",", 
       StyleBox["\[Theta]", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Bra"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      StyleBox["C", "TI"]], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->615288702,ExpressionUUID->"29e84bad-5128-8316-5fe0-92aa61de0a4f"],

Cell[TextData[{
 "with ",
 Cell[BoxData["\[ScriptCapitalE]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21b7fcde-4bd0-f37c-34e9-5863116e2856"],
 " the edge set."
}], "Text",
 CellID->968798610,ExpressionUUID->"27d89f6c-bbd5-7aac-4792-106c0fbf22df"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Gamma]", "TI"], ",", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "363249cb-6f08-fdc3-1d8f-ddea5a25f516"],
 " is in closed form from each graph's edge list, with its exact maximum as a \
dot; each title compares that maximum, with its minimal polynomial when it is \
irrational, with the graph's maximum cut:"
}], "Text",
 CellID->1717690090,ExpressionUUID->"30645e1b-0d2f-7b48-4f65-78b36e4d8a1f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qaoaLandscape", "[", "graph_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"VertexCount", "[", "graph", "]"}]}], ",", " ", 
       RowBox[{"e", " ", "=", " ", 
        RowBox[{"List", " ", "@@@", " ", 
         RowBox[{"EdgeList", "[", "graph", "]"}]}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"hc", " ", "=", " ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"QuantumOperator", "[", 
               RowBox[{"\"\<ZZ\>\"", ",", " ", "#"}], "]"}]}], ")"}], "/", 
            "2"}], " ", "&"}], " ", "/@", " ", "e"}], "]"}]}], ",", "\n", 
       "     ", 
       RowBox[{"\[Psi]", " ", "=", " ", 
        RowBox[{
         RowBox[{"QuantumCircuitOperator", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<H\>\"", " ", "->", " ", 
             RowBox[{"Range", "[", "n", "]"}]}], ",", " ", 
            RowBox[{"Splice", "[", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"\"\<R\>\"", "[", 
                RowBox[{"\[Gamma]", ",", " ", "\"\<ZZ\>\""}], "]"}], " ", "->",
                " ", "e"}], "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
             RowBox[{"Range", "[", "n", "]"}]}]}], "}"}], "]"}], "[", 
         "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]", "[", "\"\<Dagger\>\"", "]"}], "[", 
         RowBox[{"hc", "[", "\[Psi]", "]"}], "]"}], "[", "\"\<Scalar\>\"", 
        "]"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}], " ", "\[Element]",
         " ", "Reals"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qaoaPanel", "[", "graph_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", " ", "=", " ", 
       RowBox[{"qaoaLandscape", "[", "graph", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"opt", " ", "=", " ", 
       RowBox[{"Maximize", "[", 
        RowBox[{"l", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}]}], "]"}]}], "}"}],
      ",", "\n", "    ", 
     RowBox[{"DensityPlot", "[", 
      RowBox[{"l", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Gamma]", ",", " ", "0", ",", " ", 
         RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "\[Pi]"}], "}"}], ",", 
       " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Theta]\>\""}], "}"}]}], 
       ",", "\n", "     ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "Large", "]"}], ",", " ", 
          RowBox[{"Point", "[", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}], " ", "/.", 
               " ", 
               RowBox[{"Last", "[", "opt", "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", " ", "\[Pi]"}], ",", " ", "\[Pi]"}], "}"}]}], 
            "]"}], "]"}]}], "}"}]}], ",", "\n", "     ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Graph", "[", 
                RowBox[{"graph", ",", " ", 
                 RowBox[{"ImageSize", " ", "->", " ", "40"}]}], "]"}], ",", 
               " ", "\"\<   max cut = \>\"", ",", " ", 
               RowBox[{"First", "[", 
                RowBox[{"FindMaximumCut", "[", "graph", "]"}], "]"}]}], "}"}],
              "]"}], ",", "\n", "        ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<max E = \>\"", ",", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"First", "[", "opt", "]"}], " ", "\[Element]", " ", 
                  "Rationals"}], ",", " ", 
                 RowBox[{"First", "[", "opt", "]"}], ",", "\n", "           ", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"First", "[", "opt", "]"}], ",", " ", "4"}], 
                    "]"}], ",", " ", "\"\<, root of \>\"", ",", " ", 
                    RowBox[{"TraditionalForm", "[", 
                    RowBox[{
                    RowBox[{"MinimalPolynomial", "[", 
                    RowBox[{
                    RowBox[{"First", "[", "opt", "]"}], ",", " ", "x"}], 
                    "]"}], " ", "==", " ", "0"}], "]"}]}], "}"}], "]"}]}], 
                "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], ",", 
       "\n", "     ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<H\>\"", " ", "->", " ", 
            RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
           RowBox[{"Splice", "[", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"\"\<R\>\"", "[", 
               RowBox[{"\[Gamma]", ",", " ", "\"\<ZZ\>\""}], "]"}], " ", "->",
               " ", 
              RowBox[{"(", 
               RowBox[{"List", " ", "@@@", " ", 
                RowBox[{"EdgeList", "[", 
                 RowBox[{"CycleGraph", "[", "3", "]"}], "]"}]}], ")"}]}], 
             "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
            RowBox[{"Range", "[", "3", "]"}]}]}], "}"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<one QAOA layer on the triangle\>\"", ",", " ", "13", ",",
          " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{"qaoaPanel", " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CycleGraph", "[", "3", "]"}], ",", " ", 
          RowBox[{"CycleGraph", "[", "4", "]"}], ",", " ", 
          RowBox[{"CompleteGraph", "[", "4", "]"}]}], "}"}]}], "}"}], "]"}]}],
     "}"}], ",", " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[68]:= ",
 CellID->106421490,ExpressionUUID->"7c3a945e-54d4-50eb-1cbd-48b0dfd22157"],

Cell[TextData[{
 "For the triangle the best angles reach the maximum cut. For the square one \
layer reaches exactly three quarters of the edges, the ratio Farhi, Goldstone \
and Gutmann found for long even rings, and for ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0412f0d1-4a0f-6b5a-522b-b42127d3bbfe"],
 " it also falls short. The maximum is exact, not the best point a search \
visited, so the shortfall is certified."
}], "Text",
 CellID->779134222,ExpressionUUID->"7adfa18a-34e2-a75b-54e7-be4db9697a74"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->251649233,ExpressionUUID->"3ef38ad5-80c9-28d4-233a-02d062d101c7"],

Cell["SU(2) double cover from a controlled rotation", "Subsection",
 CellID->477204074,ExpressionUUID->"6fe2ba37-5d9c-ba03-5e75-df54b988f9c6"],

Cell[TextData[{
 "A rotation by ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f706012-97f3-0c3b-07f9-f6734fa79edd"],
 " returns every Bloch vector to itself but multiplies the spinor by ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3475cab1-3279-16cf-5397-52349b1931cc"],
 ", so the rotated qubit alone cannot reveal it. An ancilla in superposition \
decides whether a target qubit, in an arbitrary pure state, is rotated by the \
angle ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b4f7c02-551f-7e3b-5394-b1412e789960"],
 " about an arbitrary axis ",
 Cell[BoxData[
  StyleBox["n",
   FontWeight->"Bold",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c466c-7f9e-785b-76f3-a6f0cd1b642e"],
 ". How often does the ancilla read 1 as a function of ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c079059-9b40-0a6c-554e-fcdfe430edb7"],
 "?"
}], "Text",
 CellID->1066285715,ExpressionUUID->"5e63e732-899d-2b99-28ef-db99ad5a488f"],

Cell[TextData[{
 "With the target ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Phi]"}], "TI"]], 
     StyleBox["sin",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     TemplateBox[{"1"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "380fd703-b417-52b9-09e7-62377e68fe41"],
 ", the axis ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n",
    FontWeight->"Bold",
    FontSlant->"Plain"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Chi]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Eta]", "TI"]}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Chi]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Eta]", "TI"]}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Chi]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea39b25-7027-dd4e-39fe-438689276757"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", 
     StyleBox["n",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[CenterDot]", 
     OverscriptBox[
      StyleBox[
       StyleBox["\[Sigma]", "TI"],
       FontWeight->"Bold"], "^"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e52e78-6602-ec10-00af-555ef48bedf6"],
 ", the ancilla starts in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b366c9f-fa25-ae64-2dfb-db7807b6a5e8"],
 " and the circuit is"
}], "Text",
 CellID->1268950568,ExpressionUUID->"32c34d92-618e-85e7-28be-01af9e752e78"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["H", "TI"], "\[CircleTimes]", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       TemplateBox[{"0"},
        "Ket"], 
       RowBox[{
        TemplateBox[{"0"},
         "Bra"], "\[CircleTimes]", "1"}]}], "+", 
      RowBox[{
       TemplateBox[{"1"},
        "Ket"], 
       RowBox[{
        TemplateBox[{"1"},
         "Bra"], "\[CircleTimes]", 
        StyleBox["R", "TI"]}], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["\[Alpha]", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}]}]}], ")"}], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["H", "TI"], "\[CircleTimes]", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1076445199,ExpressionUUID->"66fbc081-b39b-54de-5bed-5f39810a1a93"],

Cell["followed by a measurement of the ancilla.", "Text",
 CellID->730606502,ExpressionUUID->"2d02f835-d546-d074-09ba-99f3d431858b"],

Cell[TextData[{
 "For general ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "395ceaa9-b016-396f-3c1f-82a60423950a"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b2a393c-09a4-9577-2453-4af2f7f1c7b8"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519637f-ad0a-d9f8-022c-0383ed3e5ccf"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "740dee8e-d005-9682-709c-ecf155d097f3"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77592509-0c46-3b33-1de5-b2a4d6abce83"],
 ", the probability of reading 1 comes out in closed form:"
}], "Text",
 CellID->1896761250,ExpressionUUID->"25b4cd87-c19c-d3f4-385f-b283c9889043"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ancillaProbs", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", "\n", "       ", 
           RowBox[{"\"\<C\>\"", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"\"\<R\>\"", "[", 
               RowBox[{"\[Alpha]", ",", " ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Sin", "[", "\[Chi]", "]"}], " ", 
                    RowBox[{"Cos", "[", "\[Eta]", "]"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"Sin", "[", "\[Chi]", "]"}], " ", 
                    RowBox[{"Sin", "[", "\[Eta]", "]"}]}], ",", " ", 
                   RowBox[{"Cos", "[", "\[Chi]", "]"}]}], "}"}], " ", ".", 
                 " ", 
                 RowBox[{"(", 
                  RowBox[{"QuantumOperator", " ", "/@", " ", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", 
                    " ", "\"\<Z\>\""}], "}"}]}], ")"}]}]}], "]"}], " ", "->", 
              " ", "2"}], ",", " ", 
             RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
           RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"{", "1", "}"}]}], "}"}], "]"}], "[", "\n", "     ", 
        RowBox[{"QuantumTensorProduct", "[", 
         RowBox[{
          RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
          RowBox[{"QuantumState", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"\[Beta]", "/", "2"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Beta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}], 
         "]"}], "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], "]"}], ",", 
     " ", 
     RowBox[{"0", " ", "<", " ", "\[Alpha]", " ", "<", " ", 
      RowBox[{"4", " ", "\[Pi]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\"\<C\>\"", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"\"\<R\>\"", "[", 
               RowBox[{"\[Alpha]", ",", " ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Sin", "[", "\[Chi]", "]"}], " ", 
                    RowBox[{"Cos", "[", "\[Eta]", "]"}]}], ",", " ", 
                   RowBox[{
                    RowBox[{"Sin", "[", "\[Chi]", "]"}], " ", 
                    RowBox[{"Sin", "[", "\[Eta]", "]"}]}], ",", " ", 
                   RowBox[{"Cos", "[", "\[Chi]", "]"}]}], "}"}], " ", ".", 
                 " ", 
                 RowBox[{"(", 
                  RowBox[{"QuantumOperator", " ", "/@", " ", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", 
                    " ", "\"\<Z\>\""}], "}"}]}], ")"}]}]}], "]"}], " ", "->", 
              " ", "2"}], ",", " ", 
             RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
           RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"{", "1", "}"}]}], "}"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<the interference circuit\>\"", ",", " ", "13", ",", " ", 
         
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Last", "[", "ancillaProbs", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", " ", "0", ",", " ", 
         RowBox[{"4", " ", "\[Pi]"}]}], "}"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Alpha]\>\"", ",", " ", "\"\<P(ancilla reads 1)\>\""}],
          "}"}]}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"4", " ", "\[Pi]"}], ",", " ", "\[Pi]"}], "]"}], ",", 
            " ", "None"}], "}"}]}], "}"}]}], ",", "\n", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<P(1) = \>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"Last", "[", "ancillaProbs", "]"}], "]"}]}], "}"}], 
         "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}], "}"}], ",", 
   " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[69]:= ",
 CellID->69769096,ExpressionUUID->"39a9c850-a6a2-3bff-4769-768cb196615e"],

Cell[TextData[{
 "This probability has no trace of the state or the axis: the ancilla sees \
only the real part of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    StyleBox["R", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Alpha]", "TI"], "2"]}], "-", 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Alpha]", "TI"], "2"], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Bra"], 
     RowBox[{
      StyleBox["n",
       FontWeight->"Bold",
       FontSlant->"Plain"], "\[CenterDot]", 
      OverscriptBox[
       StyleBox[
        StyleBox["\[Sigma]", "TI"],
        FontWeight->"Bold"], "^"]}], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73a09097-5524-c576-14f7-66a751e6e578"],
 ", and the state-dependent part is imaginary. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68426efb-4ef8-0a3b-553b-f628964f47f9"],
 ", where every Bloch vector is back where it started, the ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146f905f-f272-832f-27be-8284ebb32a4f"],
 " of the spinor makes the ancilla read 1 with certainty; it returns to 0 \
only at ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1061694f-854e-4833-1c97-2ea64bc9671d"],
 "."
}], "Text",
 CellID->2027744737,ExpressionUUID->"02f7655d-cee5-e1b9-6fd7-db956cfe3854"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->578496122,ExpressionUUID->"6379a1b2-8369-91ad-42b7-f7868a4f5d6e"],

Cell["Quantum Fisher information: n for product probes, n\.b2 for GHZ", \
"Subsection",
 CellID->1693794817,ExpressionUUID->"74a9bdb3-16e4-2b27-78ee-11e976084c7f"],

Cell[TextData[{
 "A phase ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a1f43d-2e78-aff5-20b3-6742befab7ca"],
 " is written on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21cc0333-2177-3dc3-593c-8b5e7fdf5645"],
 " qubits by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Phi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0487bc69-edf7-1c5e-137a-ad81839f9198"],
 " on each, and any unbiased estimate of ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "411b824e-57fa-31ad-6c66-c4d215a4d646"],
 " from ",
 Cell[BoxData[
  StyleBox["\[Nu]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00c85d76-6d9c-91cb-1181-259e9ea36a98"],
 " repetitions has variance at least ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Nu]", "TI"], 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["Q", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dfb8028-2f5c-178a-32f7-d1f0c0eabfb1"],
 ". How does the quantum Fisher information ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["Q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ad26a0f-a2be-3c7b-127e-988fff151287"],
 " grow with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "584bd6ea-4326-b9f5-00c9-6d65f282145e"],
 " for the product probe ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fc67116-c970-4732-3beb-f4c2ba8bce71"],
 " and for the GHZ probe ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       RowBox[{"0", "\[CenterEllipsis]", "0"}]},
      "Ket"], "+", 
     TemplateBox[{
       RowBox[{"1", "\[CenterEllipsis]", "1"}]},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "489ae1eb-aea5-030b-1579-0ae6f7661677"],
 "?"
}], "Text",
 CellID->2063992596,ExpressionUUID->"2d817d28-5aff-6b11-1d24-4967fd0a5c1d"],

Cell["\<\
For a pure probe the phase family and its Fisher information, four times the \
Fubini-Study metric, are\
\>", "Text",
 CellID->1916581357,ExpressionUUID->"68e235f5-d9ba-aaa3-2ff1-534b0d41a223"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["\[Phi]", "TI"]]},
     "Ket"], "=", 
    RowBox[{
     UnderoverscriptBox["\[CircleTimes]", 
      RowBox[{
       StyleBox["k", "TI"], "=", "1"}], 
      StyleBox["n", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["i", "TI"], 
        StyleBox["\[Phi]", "TI"], 
        SubscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["k", "TI"]], "/", "2"}]], 
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "0"]},
       "Ket"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["Q", "TI"]], "=", 
    RowBox[{
     RowBox[{"4", 
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SubscriptBox["\[PartialD]", 
             StyleBox["\[Phi]", "TI"]], 
            SubscriptBox[
             StyleBox["\[Psi]", "TI"], 
             StyleBox["\[Phi]", "TI"]]}], 
          RowBox[{
            SubscriptBox["\[PartialD]", 
             StyleBox["\[Phi]", "TI"]], 
            SubscriptBox[
             StyleBox["\[Psi]", "TI"], 
             StyleBox["\[Phi]", "TI"]]}]},
         "BraKet"], "-", 
        SuperscriptBox[GridBox[{
           {
            TemplateBox[{
              SubscriptBox[
               StyleBox["\[Psi]", "TI"], 
               StyleBox["\[Phi]", "TI"]], 
              RowBox[{
                SubscriptBox["\[PartialD]", 
                 StyleBox["\[Phi]", "TI"]], 
                SubscriptBox[
                 StyleBox["\[Psi]", "TI"], 
                 StyleBox["\[Phi]", "TI"]]}]},
             "BraKet"]}
          },
          GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
          GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ")"}]}], "=", 
     RowBox[{"4", 
      SubscriptBox[
       StyleBox["Var",
        FontSlant->"Plain"], 
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], "0"]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"],
          LimitsPositioning->False], 
         FractionBox[
          SubscriptBox[
           StyleBox["Z", "TI"], 
           StyleBox["k", "TI"]], "2"]}], ")"}], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->368350515,ExpressionUUID->"2c943894-8b2b-7bf8-339b-fc50254d63fd"],

Cell[TextData[{
 "The metric comes from differentiating the state for general ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a466b3d-0cd5-2f8e-3e98-a956e3795cf8"],
 ", for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7009aeae-8331-f53e-277a-cfa1959aaa2b"],
 " to ",
 Cell[BoxData["6"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fc965a2-6c78-f259-2302-47bc47b4bd5f"],
 ":"
}], "Text",
 CellID->111763971,ExpressionUUID->"6222f912-497c-4b80-3470-1666a92cec68"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`QuantumOptimization`\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qfiPhase", "[", "probe_", "]"}], " ", ":=", " ", 
   RowBox[{"4", " ", 
    RowBox[{
     RowBox[{"FubiniStudyMetricTensor", "[", "\n", "     ", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<RZ\>\"", "[", "\[Phi]", "]"}], " ", "->", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"probe", "[", "\"\<Qudits\>\"", "]"}], "]"}]}], "}"}], 
         "]"}], "[", "probe", "]"}], ",", " ", "\"\<Matrix\>\"", ",", " ", 
       RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
        RowBox[{"{", "\[Phi]", "}"}]}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"qfiPhase", "[", 
        RowBox[{"probe", "[", "m", "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"probe", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"StringRepeat", "[", 
            RowBox[{"\"\<+\>\"", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], ",",
          " ", 
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"\"\<GHZ\>\"", "[", "#", "]"}], "]"}], " ", "&"}]}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "6"}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<product\>\"", ",", " ", "\"\<GHZ\>\""}], "}"}]}], ",", " ", 
   
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<n\>\"", ",", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<F\>\"", ",", " ", "\"\<Q\>\""}], "]"}]}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "40"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]}], "Input",
 CellLabel->"In[70]:= ",
 CellID->2425678,ExpressionUUID->"53b2d847-0564-90be-079e-d861212eb38b"],

Cell[TextData[{
 "The product probe gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6260ca-3322-d2c2-7865-48ba2290e094"],
 ", the standard quantum limit, since the variances of independent qubits \
add; the GHZ probe gives ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "618c6631-84a9-ede1-0061-17a34ecd6fa9"],
 ", the Heisenberg limit, since ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["k", "TI"]], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1243689f-469b-2259-4c7b-b5c4bc89809d"],
 " takes only the values ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["n", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d3abc10-a9e5-ed61-00f9-3eb7f11aec6d"],
 " on it. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38e52ea8-48b5-9991-7e01-e1d842531bda"],
 " the two probes are the same state."
}], "Text",
 CellID->1054455800,ExpressionUUID->"61361344-5f87-9b59-1167-8254f1ebc943"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->541913648,ExpressionUUID->"28d32922-4b10-63a5-3072-be2ae38ff752"],

Cell["\<\
A coherent error on the three-qubit code, undone by measurement records\
\>", "Subsection",
 CellID->529869483,ExpressionUUID->"1f72ed52-195a-c8f4-7981-cf670c1aab3d"],

Cell[TextData[{
 "Encode a qubit in three, rotate the middle one by the angle ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04c5ab37-1444-87ad-18fe-2b36c88f8abb"],
 " about ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05271954-ff05-878c-516e-9a0f3025154c"],
 " (a coherent error, not a Pauli flip), measure the two parities, and flip \
back the qubit the parities point to; for comparison, rotate all three qubits \
instead. Each measurement outcome is kept as a record qubit, so each \
correction is a gate controlled by the records. Does the cycle restore the \
encoded state for every ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60622690-8f21-d3e4-4319-a8da7bbf8eaf"],
 "?"
}], "Text",
 CellID->540800815,ExpressionUUID->"41feffaf-28c5-b624-54e9-e531538a216b"],

Cell[TextData[{
 "With the input ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Phi]"}], "TI"]], 
     StyleBox["sin",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     TemplateBox[{"1"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37af351e-eb91-b883-5d4a-d8a43c81336e"],
 ", the code word, the two errors and the measured parity bits are"
}], "Text",
 CellID->377174341,ExpressionUUID->"20fc62a2-3901-8210-12fa-d42159f46fbe"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      OverscriptBox[
       StyleBox["\[Psi]", "TI"], "_"]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      FractionBox[
       StyleBox["\[Beta]", "TI"], "2"], 
      TemplateBox[{"000"},
       "Ket"]}], "+", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       StyleBox[
        RowBox[{"i", "\[Phi]"}], "TI"]], 
      StyleBox["sin",
       FontSlant->"Plain"], 
      FractionBox[
       StyleBox["\[Beta]", "TI"], "2"], 
      TemplateBox[{"111"},
       "Ket"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Theta]", "TI"], 
      SubscriptBox[
       StyleBox["X", "TI"], "2"]}]], 
    StyleBox[
     RowBox[{"\[NonBreakingSpace]", "or", "\[NonBreakingSpace]"}],
     FontSlant->"Plain"], 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{
       StyleBox["k", "TI"], "=", "1"}], "3",
      LimitsPositioning->False], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["\[Theta]", "TI"], 
       SubscriptBox[
        StyleBox["X", "TI"], 
        StyleBox["k", "TI"]]}]]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "12"], "=", 
    FractionBox[
     RowBox[{"1", "-", 
      SubscriptBox[
       StyleBox["Z", "TI"], "1"], 
      SubscriptBox[
       StyleBox["Z", "TI"], "2"]}], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "23"], "=", 
    FractionBox[
     RowBox[{"1", "-", 
      SubscriptBox[
       StyleBox["Z", "TI"], "2"], 
      SubscriptBox[
       StyleBox["Z", "TI"], "3"]}], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1374674810,ExpressionUUID->"11a27000-c8c6-84c3-58fa-a5334fbd613b"],

Cell[TextData[{
 "each measured by its two eigenspace projectors, which leave superpositions \
inside an eigenspace intact. The records ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], "12"], ",", 
     SubscriptBox[
      StyleBox["m", "TI"], "23"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", ",", "0"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", ",", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"0", ",", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d4ef422-e9d6-c7ad-20d2-62464a465719"],
 " trigger ",
 Cell[BoxData[
  SubscriptBox[
