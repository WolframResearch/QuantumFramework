Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Alpha]", "TI"], "."], "0"], "=", "-", "(", 
    RowBox[{
     FractionBox[
      StyleBox["\[Kappa]", "TI"], "2"], "+", 
     StyleBox["i", "TI"], 
     StyleBox["\[Chi]", "TI"]}], ")", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], "0"], "-", 
    FractionBox[
     StyleBox["i", "TI"], "2"], 
    SubscriptBox[
     StyleBox["\[CurlyEpsilon]", "TI"], 
     StyleBox["max",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Epsilon]", 
     StyleBox["r", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Alpha]", "TI"], "."], "1"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          StyleBox["\[Kappa]", "TI"], "2"], "-", 
         StyleBox["i", "TI"], 
         StyleBox["\[Chi]", "TI"]}], ")"}]}], 
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], "1"]}], "-", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], 
      SubscriptBox[
       StyleBox["\[CurlyEpsilon]", "TI"], 
       StyleBox["max",
        FontSlant->"Plain"]], 
      SubscriptBox["\[Epsilon]", 
       StyleBox["r", "TI"]], 
      RowBox[{
