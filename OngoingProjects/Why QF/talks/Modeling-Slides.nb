 CellID->1010997909,ExpressionUUID->"6250d3c8-1f0d-9379-3919-d48dad8d9544"],

Cell[TextData[{
 "A spin ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a27ba7f-5cbc-1701-0e57-562e0e453997"],
 " starts in ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["j", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13490057-110c-4f2b-757c-272d1c1c0488"],
 ", pointing along ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a47de0f-353d-fbbf-5c9b-12ed2f9e00a7"],
 ", and is rotated to point along the direction ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a5af9c7-0f0e-574a-6e98-677b3f0e5e3e"],
 " with polar angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0f61dc-2a6f-aeba-644e-923641a1522e"],
 " and azimuth ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e42c4b7-e079-e0a0-585c-7901f7476114"],
 ". How is the rotated spin spread over the levels ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74c5d172-b2f9-1491-31cc-6760e2171e0b"],
 " of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["J", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "745038d9-6605-64cd-07f1-eaf5da913e58"],
 "?"
}], "Text",
 CellID->596806402,ExpressionUUID->"0ed2a8e4-c6f5-6964-0a80-8be8d3a20e8c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["J", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], ",", 
        StyleBox["m", "TI"]}]},
     "Ket"]}], "=", 
   RowBox[{
    StyleBox["m", "TI"], 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], ",", 
        StyleBox["m", "TI"]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a0f2b94-f007-2d68-4b32-436e051c0862"],
 ", the spin coherent state and its level populations are"
}], "Text",
 CellID->961254067,ExpressionUUID->"0fb2f87b-4271-31d6-6729-75e75c015e72"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], ",", 
        OverscriptBox[
         StyleBox["n", "TI"], "^"]}]},
     "Ket"], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], "\[CurlyPhi]", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["J", "TI"], "^"], 
        StyleBox["z", "TI"]]}]], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["\[Theta]", "TI"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["J", "TI"], "^"], 
        StyleBox["y", "TI"]]}]], 
     TemplateBox[{
       RowBox[{
         StyleBox["j", "TI"], ",", 
         StyleBox["j", "TI"]}]},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["P", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["m", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[GridBox[{
        {
         TemplateBox[{
           RowBox[{
             StyleBox["j", "TI"], ",", 
             StyleBox["m", "TI"]}], 
           RowBox[{
             StyleBox["j", "TI"], ",", 
             OverscriptBox[
              StyleBox["n", "TI"], "^"]}]},
          "BraKet"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
     SuperscriptBox[GridBox[{
        {
         RowBox[{
          SubsuperscriptBox[
           StyleBox["d", "TI"], 
           StyleBox[
            RowBox[{"m", "j"}], "TI"], 
           RowBox[{"\[ThinSpace]", 
            StyleBox["j", "TI"]}]], 
          RowBox[{
           StyleBox["(",
            SpanMaxSize->1], 
           StyleBox["\[Theta]", "TI"], 
           StyleBox[")",
            SpanMaxSize->1]}]}]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1619237638,ExpressionUUID->"5fa79083-bfad-9c23-67e2-62155acae2fd"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["d", "TI"], 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "\[Prime]"], 
      StyleBox["m", "TI"]}], 
     RowBox[{"\[ThinSpace]", 
      StyleBox["j", "TI"]}]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Theta]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["j", "TI"], ",", 
     RowBox[{
      SuperscriptBox[
       StyleBox["m", "TI"], "\[Prime]"], GridBox[{
        {
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["i", "TI"], 
           StyleBox["\[Theta]", "TI"], 
           SubscriptBox[
            OverscriptBox[
             StyleBox["J", "TI"], "^"], 
            StyleBox["y", "TI"]]}]]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], 
      StyleBox["j", "TI"]}], ",", 
     StyleBox["m", "TI"]}], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14141388-753e-f87c-4c2e-3718af8dff1f"],
 " is the Wigner small-",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57e5f70b-d739-6afd-6536-d984f6153619"],
 " matrix; ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18a1a616-ec3d-110d-219c-e8f2fc2eb74d"],
 " only multiplies each amplitude by a phase."
}], "Text",
 CellID->1474857315,ExpressionUUID->"7ca8ed75-4446-4403-0a24-6e56897a46fd"],

Cell[TextData[{
 "Applying ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Theta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["J", "TI"], "^"], 
     StyleBox["y", "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b9fed2-4557-4111-083d-6913fd82d646"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["j", "TI"], ",", 
      StyleBox["j", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47d13b0f-12b1-a9db-2716-233d5b3f70b2"],
 " for general ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65414bcb-1a11-ef93-34ef-4f241aa98b6e"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["m", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "674e8a21-703f-bbd6-0fbb-60c0cb24d093"],
 ", checked against the binomial law; the figure plots ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["m", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56aa66f1-8220-92d3-7c32-0b48278ce80d"],
 " against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "/", 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c422ab-2cb3-eb85-2674-c07bd71f0e26"],
 ", with the Gaussian of the same mean ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034bfb63-777a-bc8b-67ae-003746058e63"],
 " and variance ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["j", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36b7d1ac-82bb-8dac-10c9-bc6cc4381b64"],
 " dashed:"
}], "Text",
 CellID->1017587897,ExpressionUUID->"777f37d3-2eb8-9237-3009-1005c030deee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinCohP", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"\"\<WignerD\>\"", "[", 
            RowBox[{"j", ",", " ", 
             RowBox[{"-", "\[Theta]"}]}], "]"}], "]"}], " ", "@", " ", 
          RowBox[{"QuantumState", "[", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
              RowBox[{
               RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "]"}], ",", 
            " ", 
            RowBox[{
             RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "]"}]}], ")"}], 
        "[", "\"\<StateVector\>\"", "]"}], "]"}], "]"}], "^", "2"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"spins", ",", " ", "polars"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "10", ",", " ", "40"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pi", "/", "6"}], ",", " ", 
       RowBox[{"Pi", "/", "2"}], ",", " ", 
       RowBox[{"5", " ", 
        RowBox[{"Pi", "/", "6"}]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spinCoh", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"spinCohP", ",", " ", "spins"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"binomialQ", " ", "=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"spinCoh", "[", "#", "]"}], " ", "==", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Binomial", "[", 
              RowBox[{
               RowBox[{"2", " ", "#"}], ",", " ", 
               RowBox[{"#", " ", "+", " ", "m"}]}], "]"}], " ", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"(", 
                 RowBox[{"#", " ", "+", " ", "m"}], ")"}]}], ")"}]}], " ", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"(", 
                 RowBox[{"#", " ", "-", " ", "m"}], ")"}]}], ")"}]}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"m", ",", " ", 
              RowBox[{"-", "#"}], ",", " ", "#"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "Pi"}]}], 
        "]"}], " ", "&"}], " ", "/@", " ", "spins"}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spinPanel", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"-", "j"}], ",", " ", "j"}], "]"}], "/", "j"}], ",", 
            " ", 
            RowBox[{
             RowBox[{"spinCoh", "[", "j", "]"}], " ", "/.", " ", 
             RowBox[{"\[Theta]", " ", "->", " ", "th"}]}]}], "}"}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"th", ",", " ", "polars"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "     ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "#"}], "}"}], "]"}], 
           " ", "&"}], " ", "/@", " ", "polars"}], ")"}]}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PDF", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{
              RowBox[{"j", " ", 
               RowBox[{"Cos", "[", "#", "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"Sqrt", "[", 
                RowBox[{"j", "/", "2"}], "]"}], " ", 
               RowBox[{"Sin", "[", "#", "]"}]}]}], "]"}], ",", " ", 
            RowBox[{"j", " ", "mj"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
         "polars"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"mj", ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<m/j\>\"", ",", " ", "\"\<P(m)\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<j = \>\"", ",", " ", "j"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spinPanels", " ", "=", " ", 
   RowBox[{"spinPanel", " ", "/@", " ", "spins"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{"First", " ", "/@", " ", "spinPanels"}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "spinPanels", "]"}], "]"}], "]"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<P(m) = \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"HoldForm", "[", 
          RowBox[{
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"2", " ", "j"}], ",", " ", 
             RowBox[{"j", " ", "+", " ", "m"}]}], "]"}], " ", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"j", " ", "+", " ", "m"}], ")"}]}], ")"}]}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"j", " ", "-", " ", "m"}], ")"}]}], ")"}]}]}], "]"}], 
         "]"}], ",", 
        " ", "\"\< for 0 < \[Theta] < \[Pi] at j = 2, 10, 40: \>\"", ",", " ",
         "binomialQ"}], "}"}], "]"}], ",", "\n", "    ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[60]:= ",
 CellID->1948991108,ExpressionUUID->"286ac3c5-6561-72f4-7444-94a28f929481"],

Cell[TextData[{
 "The populations are binomial: the spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "706b9126-594a-1d69-11ae-0ef0287918ec"],
 " coherent state is ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ad7f3e-124b-0d63-4dbf-720cb8a05912"],
 " spin-",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f86f3a-c18c-2966-1820-cb16cf53e82a"],
 " particles all pointing along ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ff245b4-d61e-e6c1-1655-043d209a2a58"],
 ", each found up with probability ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d639c6-f690-b5ab-6d66-df31e3aee6e7"],
 ". As ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a0c4c4d-4da1-0e53-38e7-03c24dc62e5f"],
 " grows the binomial approaches the dashed Gaussian centered at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["j", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ae8095-1342-2e8d-6e65-5b87776676a3"],
 ", and its width relative to ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fe2240b-7ae8-a7ba-0efb-63d4dab4828a"],
 " shrinks as ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65a3234f-d2de-2f4a-481b-e8c1d6e33083"],
 ", so a large spin points like a classical arrow."
}], "Text",
 CellID->1707946965,ExpressionUUID->"5a4cadf8-f347-e577-4276-1e12b72cb099"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1768734680,ExpressionUUID->"4a36a3cf-9b44-9ff5-2c35-cca725678ac3"],

Cell["The Hamiltonian behind a chirped rotation", "Subsection",
 CellID->1426265652,ExpressionUUID->"6e1061c2-7e35-94f8-16d0-62ceb3b8e0e6"],

Cell[TextData[{
 "A qubit should follow the trajectory ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    SuperscriptBox[
     StyleBox["t", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CapitalOmega]", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d207b13-aa72-67b8-2065-4c5aa8127d26"],
 ": a rotation about ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39825472-ab53-c8cc-2018-36c09c8f6aa2"],
 " at rate ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e081b8-d9b0-4483-229f-f293dd77133f"],
 ", followed by a ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c248597-e201-e557-76f8-ab37f7d4f04f"],
 " rotation whose angle grows quadratically at chirp rate ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49acaa8b-be05-3e2e-2f7a-063d6e15bc1a"],
 ". What control Hamiltonian drives it?"
}], "Text",
 CellID->1553320916,ExpressionUUID->"3f291237-fe93-2f48-7772-11f757d410f2"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79272ec8-f047-1533-2cdf-9e5417f16680"],
 ", Pauli matrices ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7689318e-1714-6f16-51d0-cf60f2b3b226"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyTheta]", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyTheta]", 
     StyleBox["Z", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "246257d7-e834-fd42-2501-1b2d445ae888"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyTheta]", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyTheta]", 
     StyleBox["X", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48266ba0-68c3-c6b6-0f20-27e0c3edeb96"],
 ", a propagator obeys ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e20b5a8-d8a4-3c78-7a51-59dabc21296d"],
 ", so the Hamiltonian is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3245f0ed-1dc5-a6b3-3f05-e382c5f9e7d2"],
 ", written as ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["x", "TI"]], 
   StyleBox["X", "TI"], "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["Y", "TI"], "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ea43977-6486-22dc-6ca5-0d7e65c32f99"],
 "."
}], "Text",
 CellID->1601890013,ExpressionUUID->"73be912d-ae05-3085-26a4-ad1ea1c13bed"],

Cell[TextData[{
 "Differentiating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "009531f3-eb97-5ae6-10db-98a1d4d99e01"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   OverscriptBox[
    StyleBox["U", "TI"], "."], 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0553dcd9-e287-f868-1bb6-7ab96e5d96d0"],
 ", whose three Pauli coefficients are read off, and evolving under them is \
checked to return ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39d5f2e5-be0a-b725-32fd-a256867d4854"],
 "; units of ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a22961a-5d09-c57f-27ec-a3ab4fdda106"],
 ", time in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5411b344-8678-4cf8-564d-87409b0f7bdd"],
 ":"
}], "Text",
 CellID->1091985469,ExpressionUUID->"1652b093-d3c7-3926-224f-22df5536f02c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hfU", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<RZ\>\"", "[", 
      RowBox[{"\[Beta]", " ", 
       RowBox[{"t", "^", "2"}]}], "]"}], "]"}], " ", "@", " ", 
    RowBox[{"QuantumOperator", "[", 
     RowBox[{"\"\<RX\>\"", "[", 
      RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hfField", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ComplexExpand", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"I", " ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"hfU", ",", " ", "t"}], "]"}], " ", "@", " ", 
        RowBox[{"hfU", "[", "\"\<Dagger\>\"", "]"}]}]}], ")"}], 
     "[", "\"\<PauliDecompose\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hfBackQ", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumEvolve", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#2", " ", 
               RowBox[{"QuantumOperator", "[", "#1", "]"}]}], " ", "&"}], ",",
              " ", "hfField"}], "]"}], "]"}], ",", " ", "None", ",", " ", 
          "t"}], "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"hfU", "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", " ", "\[CapitalOmega]", ",", " ", "t"}], "}"}],
       " ", "\[Element]", " ", "Reals"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hfPanel", "[", "b_", "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"hfField", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}],
           "}"}]}], "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\[Beta]", " ", "->", " ", "b"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<h\>\"", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<h\>\"", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<h\>\"", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalOmega] t\>\"", ",", 
        " ", "\"\<coefficient / \[CapitalOmega]\>\""}], "}"}]}], ",", "\n", 
     "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Beta]/\>\"", ",", " ", 
         RowBox[{"Superscript", "[", 
          RowBox[{"\"\<\[CapitalOmega]\>\"", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\< = \>\"", ",", " ", "b"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hfPanels", " ", "=", " ", 
   RowBox[{"hfPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.05", ",", " ", "0.2", ",", " ", "0.5"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", "hfPanels"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "hfPanels", "]"}], "]"}], "]"}]}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Riffle", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<h\>\"", ",", " ", "#1"}], "]"}], ",", 
                " ", "\"\< = \>\"", ",", " ", 
                RowBox[{"TraditionalForm", "[", "#2", "]"}]}], "}"}], "]"}], 
             " ", "&"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\"", ",", 
                " ", "\"\<z\>\""}], "}"}], ",", " ", 
              RowBox[{"Lookup", "[", 
               RowBox[{"hfField", ",", " ", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", 
                  " ", "\"\<Z\>\""}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",", 
          " ", "\"\<,    \>\""}], "]"}], ",", "\n", "   ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<;    evolving under H returns U(t): \>\"", ",", " ", 
           "hfBackQ"}], "}"}], "]"}]}], "]"}], "]"}], ",", " ", "13", ",", 
     " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[61]:= ",
 CellID->1325775310,ExpressionUUID->"5ee77503-1ec1-42e3-26e1-34966a0c6115"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644e8f8d-1a49-23a5-3299-2bde91f19df1"],
 " field splits the levels by ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ccddbe6-9f16-d339-619e-3dfceb85d297"],
 ", exactly the instantaneous frequency of the transverse field turning with \
phase ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13310964-35b3-a70d-4e70-f5c84764e43a"],
 ", so the chirped drive stays resonant at every instant. In the frame that \
turns with it the qubit sees a constant field ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47141ab0-ca68-2aab-6359-e8b57b423979"],
 " along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64cc7387-9460-4fc6-4e93-97a3abf5fb36"],
 ", which is the rotation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CapitalOmega]", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27be94e6-babd-f3be-2a3e-5b5f155250f1"],
 "."
}], "Text",
 CellID->1020754267,ExpressionUUID->"76dbd58c-09e8-1a57-48a5-00690e7a62a6"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1846511060,ExpressionUUID->"3c84a409-5e08-7694-54db-bb6e734c2f96"],

Cell["Stern-Gerlach magnets in sequence", "Subsection",
 CellID->321839891,ExpressionUUID->"655bb892-42c6-b2d7-320b-4736a8593f2d"],

Cell[TextData[{
 "A beam of spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ab0a37-aab0-ba69-19fd-dc9408684f04"],
 " atoms meets three Stern-Gerlach magnets. The first, along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b87dc51-66af-b3bf-544a-57cee1f49397"],
 ", lets only its top beam ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["j", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06e1c34d-36b1-24b3-59f0-38a5f2e7f09e"],
 " through; the second, tilted by ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13c4b398-e3c8-1f5c-36c5-4a12562e0e95"],
 " from ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68e8ac72-3b48-7180-5eb7-45f201be7df5"],
 ", again lets only its top beam through; the third, along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bbff721-e0c1-4bd1-5e80-41caa84d3d3b"],
 ", splits what arrives into its ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["j", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d79738c-6d75-2b22-57e0-48a61b1aea51"],
 " beams. What fraction of the atoms that leave the first magnet comes out of \
each beam of the third?"
}], "Text",
 CellID->1246797575,ExpressionUUID->"1d6880a4-99b8-da18-7680-b52b33bc7b3e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0202f48c-6da5-0d2d-798b-1b031195717c"],
 ", a magnet along ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6c9605-5875-e9c7-1b0d-bfc38373447e"],
 " projects onto the eigenstates ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      OverscriptBox[
       StyleBox["n", "TI"], "^"], ",", 
      StyleBox["m", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11c59263-49ab-1c1d-2474-e5408bd9bee5"],
 " of ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["J",
     FontWeight->"Bold",
     FontSlant->"Plain"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e98d53-adbb-2f22-32b4-d3912c6a9ac3"],
 ". Rotating the whole setup about ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2722ddd4-2353-fb35-740c-560460bf5b08"],
 " puts the second axis at ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}], ",", "0", ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "495c633a-9e90-3095-41bd-b74d3a1de322"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       OverscriptBox[
        StyleBox["n", "TI"], "^"], ",", 
       StyleBox["j", "TI"]}]},
    "Ket"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Theta]", "TI"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["J", "TI"], "^"], 
       StyleBox["y", "TI"]]}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["z", "TI"], ",", 
        StyleBox["j", "TI"]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ad0a8f4-5767-06ac-7ba3-cf5c50ede9f5"],
 ", and Born's rule applied twice gives"
}], "Text",
 CellID->752778609,ExpressionUUID->"1f299be0-c025-b1db-1678-b062fca72ad6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["P", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["m", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[GridBox[{
         {
          TemplateBox[{
            RowBox[{
              StyleBox["z", "TI"], ",", 
              StyleBox["j", "TI"]}], 
            RowBox[{
              OverscriptBox[
               StyleBox["n", "TI"], "^"], ",", 
              StyleBox["j", "TI"]}]},
           "BraKet"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
      SuperscriptBox[GridBox[{
         {
          TemplateBox[{
            RowBox[{
              StyleBox["z", "TI"], ",", 
              StyleBox["m", "TI"]}], 
            RowBox[{
              OverscriptBox[
               StyleBox["n", "TI"], "^"], ",", 
              StyleBox["j", "TI"]}]},
           "BraKet"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], "=", 
     RowBox[{
      SuperscriptBox[GridBox[{
         {
          RowBox[{
           SubsuperscriptBox[
            StyleBox["d", "TI"], 
            StyleBox[
             RowBox[{"j", "j"}], "TI"], 
            RowBox[{"\[ThinSpace]", 
             StyleBox["j", "TI"]}]], 
           RowBox[{
            StyleBox["(",
             SpanMaxSize->1], 
            StyleBox["\[Theta]", "TI"], 
            StyleBox[")",
             SpanMaxSize->1]}]}]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
      SuperscriptBox[GridBox[{
         {
          RowBox[{
           SubsuperscriptBox[
            StyleBox["d", "TI"], 
            StyleBox[
             RowBox[{"m", "j"}], "TI"], 
            RowBox[{"\[ThinSpace]", 
             StyleBox["j", "TI"]}]], 
           RowBox[{
            StyleBox["(",
             SpanMaxSize->1], 
            StyleBox["\[Theta]", "TI"], 
            StyleBox[")",
             SpanMaxSize->1]}]}]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox[
      StyleBox["d", "TI"], 
      RowBox[{
       SuperscriptBox[
        StyleBox["m", "TI"], "\[Prime]"], 
       StyleBox["m", "TI"]}], 
      RowBox[{"\[ThinSpace]", 
       StyleBox["j", "TI"]}]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["z", "TI"], ",", 
       RowBox[{
        SuperscriptBox[
         StyleBox["m", "TI"], "\[Prime]"], GridBox[{
          {
           SuperscriptBox[
            StyleBox["e", "TI"], 
            RowBox[{"-", 
             StyleBox["i", "TI"], 
             StyleBox["\[Theta]", "TI"], 
             SubscriptBox[
              OverscriptBox[
               StyleBox["J", "TI"], "^"], 
              StyleBox["y", "TI"]]}]]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], 
        StyleBox["z", "TI"]}], ",", 
       StyleBox["m", "TI"]}], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2007574231,ExpressionUUID->"2f6e853a-ff25-5c38-4dbc-a00af9956630"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["z", "TI"], ",", 
