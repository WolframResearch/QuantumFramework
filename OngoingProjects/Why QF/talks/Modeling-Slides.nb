Cell["Fully bunched photons are n! times likelier", "Subsection",
 CellID->661768933,ExpressionUUID->"18718465-6a31-7711-4263-df3a24d21466"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c83f8b2-b2bc-670e-3a18-20d896e60177"],
 " photons enter the first ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e29ae46-0959-4434-7822-5d2817bd1ff8"],
 " ports of a six-mode lossless network with transfer matrix ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71bdc67a-bf14-a3ff-35a1-c4eb7dc3a9a8"],
 ", one per port, and all of them leave through the same port ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a4513fe-ab4b-465e-43e3-60c08e9b2e08"],
 ". How much likelier is this for identical photons than for distinguishable \
ones, whatever ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78760bcf-0d96-6bae-72cf-b20241634cfc"],
 " is?"
}], "Text",
 CellID->321531890,ExpressionUUID->"71aabc68-3c10-01b7-7cb2-48398a734c57"],

