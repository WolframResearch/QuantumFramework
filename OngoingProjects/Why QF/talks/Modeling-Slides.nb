  FontSize->0.9 Inherited,ExpressionUUID->
  "58581d72-c99f-7674-7eed-ce22c2282488"],
 "; with a single excitation, two field levels suffice. Rates are in units of \
",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11bc2bfc-81bf-a42e-2bcd-22d87248303b"],
 ":"
}], "Text",
 CellID->313917289,ExpressionUUID->"10cf7f15-0834-2ba0-715f-1ced26ab7dfb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"2", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"\[Sigma]m", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "\[CapitalDelta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{"\[Sigma]m", " ", "@", " ", 
     RowBox[{"SuperDagger", "[", "a", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"SuperDagger", "[", "\[Sigma]m", "]"}], " ", "@", " ", "a"}]}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\[Kappa]s", ",", " ", "\[CapitalDelta]s", ",", " ", "\[Gamma]s"}], "}"}],
    " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.1", ",", " ", "1", ",", " ", "5"}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.1", ",", " ", "0.5"}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qf", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Re", " ", "@", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumPartialTrace", "[", 
          RowBox[{
           RowBox[{"QuantumEvolve", "[", 
            RowBox[{
             RowBox[{"h", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\[Sigma]m", ",", " ", "a"}], "}"}], " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ",", "\n", 
             "       ", 
             RowBox[{"QuantumTensorProduct", "[", 
              RowBox[{
               RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
               RowBox[{"FockState", "[", 
                RowBox[{"0", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "0", ",", " ", "10"}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], " ", "&"}], ",", " ", 
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{
       "\[Kappa]s", ",", " ", "\[CapitalDelta]s", ",", " ", "\[Gamma]s"}], 
       "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panel", "[", 
    RowBox[{"\[Kappa]_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"qf", "[", 
           RowBox[{"{", 
            RowBox[{"\[Kappa]", ",", " ", "\[CapitalDelta]", ",", " ", "#"}], 
            "}"}], "]"}], " ", "&"}], " ", "/@", " ", "\[Gamma]s"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "10"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Gamma]/g = \>\"", ",", " ", "#"}], "}"}], "]"}], 
           " ", "&"}], " ", "/@", " ", "\[Gamma]s"}], ")"}]}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Kappa]", " ", "==", " ", 
        RowBox[{"Last", "[", "\[Kappa]s", "]"}]}], ",", " ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"#", " ", "+", " ", 
                 RowBox[{"4", " ", 
                  RowBox[{"\[Kappa]", "/", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Kappa]", "^", "2"}], " ", "+", " ", 
                    RowBox[{"4", " ", 
                    RowBox[{"\[CapitalDelta]", "^", "2"}]}]}], ")"}]}]}]}], 
                ")"}]}], " ", "t"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "\[Gamma]s"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "10"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", " ", 
       RowBox[{"Graphics", "[", "]"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<g t\>\"", ",", " ", "\"\<P(e)\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cavityPanels", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"\[Kappa]v", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"panel", "[", 
             RowBox[{"\[Kappa]v", ",", " ", "#"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Graphics", "[", 
            RowBox[{"Inset", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{"\"\<\[CapitalDelta]/g = \>\"", ",", " ", "#"}], 
                  "}"}], "]"}], ",", " ", "12"}], "]"}], ",", " ", 
              RowBox[{"Scaled", "[", 
               RowBox[{"{", 
                RowBox[{"0.95", ",", " ", "0.95"}], "}"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}], "]"}]}], 
          "]"}], " ", "&"}], " ", "/@", " ", "\[CapitalDelta]s"}]}], "]"}], ",",
      " ", "\[Kappa]s"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cavityPanels", "[", "\[Kappa]", "]"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "660"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "\[Gamma]s", "]"}], "]"}]}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"\[Kappa]", " ", "==", " ", 
              RowBox[{"Last", "[", "\[Kappa]s", "]"}]}], ",", " ", 
             RowBox[{"Directive", "[", 
              RowBox[{"Gray", ",", " ", "Dashed"}], "]"}], ",", " ", 
             "Nothing"}], "]"}]}], "]"}], ",", "\n", "      ", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Gamma]/g = \>\"", ",", " ", "#"}], "}"}], "]"}],
              " ", "&"}], " ", "/@", " ", "\[Gamma]s"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"\[Kappa]", " ", "==", " ", 
              RowBox[{"Last", "[", "\[Kappa]s", "]"}]}], ",", 
             " ", "\"\<rate-equation decay\>\"", ",", " ", "Nothing"}], 
            "]"}]}], "]"}], ",", " ", 
         RowBox[{"LegendLayout", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Row\>\"", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ",
        "Below"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Kappa]", ",", " ", "1", ",", " ", "\"\<\[Kappa]/g\>\""}], 
      "}"}], ",", " ", "\[Kappa]s", ",", " ", "SetterBar"}], "}"}], ",", " ", 
   
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->451134304,ExpressionUUID->"53628cd7-bbb3-b200-2d7b-8e69c7073564"],

Cell[TextData[{
 "At small ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598336ec-1f33-0025-7495-d36520478711"],
 " the photon returns and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d4daab5-75de-aba9-5649-cf094f07972b"],
 " oscillates; by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", 
   StyleBox["g", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05551317-1ef8-9ce7-0bcc-2ecc68283667"],
 " the atom simply decays, near the Purcell rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "+", "4", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], 
   StyleBox["\[Kappa]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Kappa]", "TI"], "2"], "+", "4", 
    SuperscriptBox["\[CapitalDelta]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d10e1fe-8299-2300-54dd-839647c9731e"],
 " (dashed), which becomes exact only for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "\[GreaterGreater]", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f0566-c1f1-f7e4-092f-82ed71a5f353"],
 ". Detuning makes the exchange faster but incomplete and slows the leak \
through the cavity."
}], "Text",
 CellID->844157360,ExpressionUUID->"1a87c268-a8ce-79bd-25b5-580db22edbfa"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1463381688,ExpressionUUID->"0620a49f-088c-026a-2941-f2f410851c0c"],

Cell["Why a qubit's coherence time T2 is at most 2T1", "Subsection",
 CellID->10151855,ExpressionUUID->"4c38b132-407a-59aa-59e6-21cdb0afac2e"],

Cell[TextData[{
 "A qubit with level splitting ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e16f1cd-19cd-b1dd-20e3-8b41202209da"],
 " loses its energy, decaying from ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3084a9a7-c082-9f50-4d75-b9ad7786be95"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9c6d77-e524-3b90-2e52-7435927c9581"],
 " at rate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "075fa20c-87f4-981d-535c-8cc0430d3fc7"],
 ", and loses its phase through the jump operator ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01478ae7-1e13-89cb-2f92-758a6b192698"],
 ". How long can a superposition of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4416b512-4887-b304-37ee-63a1ef6ae158"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "602bec11-d739-7372-293e-79500ca8092e"],
 " keep its phase?"
}], "Text",
 CellID->905391953,ExpressionUUID->"2612c84a-0155-f77b-4002-84d84b7fafaa"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a364f71-f913-e67b-3ca8-4db33e4a448d"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "592aa7c2-bd88-a161-09e3-6f65f656eb71"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f193539-a824-d95b-75e6-64eea0a73392"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1a0760-88d8-53f0-0ca5-7f933cf971d3"],
 ", the Lindblad equation is"
}], "Text",
 CellID->430045044,ExpressionUUID->"49b4a1fc-b1dc-05a6-677c-fdfebaa8dfe2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["L", "TI"], "^"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     StyleBox["\[Rho]", "TI"]}], "=", 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["L", "TI"], "^"], 
      StyleBox["\[Rho]", "TI"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["L", "TI"], "^"], "\[Dagger]"]}], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          OverscriptBox[
           StyleBox["L", "TI"], "^"], "\[Dagger]"], 
         OverscriptBox[
          StyleBox["L", "TI"], "^"]}], ",", 
        RowBox[{
         RowBox[{
          StyleBox["\[Rho]", "TI"], "}"}], "."}]}]}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->234837243,ExpressionUUID->"616f94af-e2aa-f291-6179-349920126942"],

Cell[TextData[{
 "Starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{
        StyleBox["e", "TI"]},
       "Ket"], "+", 
      TemplateBox[{
        StyleBox["g", "TI"]},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e72314-6dd6-cfe6-18de-96aeab6a43a9"],
 ", the exact solution for general ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "502f453a-dc39-6e6f-37d6-08f0987a583f"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323cb63d-6ef8-3e89-3933-6861221f87ac"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440c7fc0-cd6d-ce8c-55a5-35094f574156"],
 " is"
}], "Text",
 CellID->199760013,ExpressionUUID->"45af5c39-d746-32a0-6888-bd5d3249d1e1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["t", "TI"], "/", 
      SubscriptBox[
       StyleBox["T", "TI"], "2"]}]], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    FractionBox["1", 
     SubscriptBox[
      StyleBox["T", "TI"], "2"]], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", 
     RowBox[{"2", 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Gamma]", "TI"], 
        StyleBox["\[Phi]", "TI"]], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1072894386,ExpressionUUID->"4cd55275-352d-b42b-2807-1513b7b12c47"],

Cell[TextData[{
 "The figure plots it with time in units of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f17767-a12d-36cb-1f52-d2c8b4afd427"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], 
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fbe7708-eab8-ce16-6e2f-ae6d332b3838"],
 ". The dashed curves are ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["t", "TI"], "/", 
     SubscriptBox[
      StyleBox["T", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71104ab2-abaa-aacc-34c0-edbeec463974"],
 ", and the gray curves are the same envelope at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50636079-68fb-9748-30fd-cccbfafa3cc3"],
 ", the value with no dephasing:"
}], "Text",
 CellID->1333411129,ExpressionUUID->"29403e3c-2495-a7bb-1a79-ec4178705cab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sxA1", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumEvolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Omega]", "/", "2"}], " ", 
            RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], ",", " ", 
              RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "}"}], 
            " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[CurlyPhi]"}], "}"}]}], 
           ",", "\n", "      ", 
           RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}], ",", " ", "t"}], 
          "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", ".", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"t", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelA1", "[", "\[Gamma]\[CurlyPhi]v_", "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "t"}], "/", "2"}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "t"}], "/", "2"}], "]"}]}], ",", " ", 
        RowBox[{"sxA1", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]1", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{
           "\[Gamma]\[CurlyPhi]", " ", "->", " ", "\[Gamma]\[CurlyPhi]v"}], ",",
            " ", 
           RowBox[{"\[Omega]", " ", "->", " ", "6"}]}], "}"}]}], ",", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"1", "/", "2"}], " ", "+", " ", 
             RowBox[{"2", " ", "\[Gamma]\[CurlyPhi]v"}]}], ")"}]}], " ", 
          "t"}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "2"}], " ", "+", " ", 
              RowBox[{"2", " ", "\[Gamma]\[CurlyPhi]v"}]}], ")"}]}], " ", 
           "t"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "6"}], "}"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
     RowBox[{"PlotPoints", " ", "->", " ", "200"}], ",", "\n", "    ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Gray", ",", " ", "Gray", ",", " ", 
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", " ", 
          "Dashed"}], "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", " ", 
          "Dashed"}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<t/\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<T\>\"", ",", " ", "1"}], "]"}]}], "}"}], "]"}], ",", 
        " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<x\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}]}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<T\>\"", ",", " ", "2"}], "]"}], ",", " ", "\"\</\>\"", 
         ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<T\>\"", ",", " ", "1"}], "]"}], ",", " ", "\"\< = \>\"",
          ",", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "2"}], " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"Rationalize", "[", "\[Gamma]\[CurlyPhi]v", "]"}]}]}], 
             ")"}]}], ",", " ", "InputForm"}], "]"}]}], "}"}], "]"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"panelA1", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.1", ",", " ", "0.25"}], "}"}]}], "}"}], ",",
      " ", 
     RowBox[{"ImageSize", " ", "->", " ", "660"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"LineLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", " ", 
           "Dashed"}], "]"}], ",", " ", "Gray"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<x\>\""}], "]"}], ",", 
            " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[PlusMinus]\>\"", ",", " ", 
            RowBox[{"Superscript", "[", 
             RowBox[{"\"\<e\>\"", ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<\[Minus]t/\>\"", ",", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<T\>\"", ",", " ", "2"}], "]"}]}], "}"}], 
               "]"}]}], "]"}]}], "}"}], "]"}], ",", "\n", "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[PlusMinus]\>\"", ",", " ", 
            RowBox[{"Superscript", "[", 
             RowBox[{"\"\<e\>\"", ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<\[Minus]t/\>\"", ",", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<T\>\"", ",", " ", "2"}], "]"}]}], "}"}], 
               "]"}]}], "]"}], ",", " ", "\"\< at \>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<T\>\"", ",", " ", "2"}], "]"}], ",", 
            " ", "\"\< = 2\>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<T\>\"", ",", " ", "1"}], "]"}], ",", 
            " ", "\"\< (no dephasing)\>\""}], "}"}], "]"}]}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"LegendLayout", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Row\>\"", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ", 
     "Below"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:= ",
 CellID->1825142838,ExpressionUUID->"7f3576f9-71c3-85f7-516e-436c53bf0d50"],

Cell[TextData[{
 "Energy loss alone already removes the phase at rate ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ce0c850-4146-4e30-7aa7-5f10cbda20a0"],
 ", and dephasing can only add to that rate, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "170c367e-0186-4080-053f-8d2a2228f011"],
 ", with equality only when ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17ba67d1-5fc5-da1c-367a-848b49b3eebc"],
 ". In the figure the oscillation touches the dashed envelope at every peak; \
at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "421c5cb9-2fe1-10c9-4576-0f1651bbc0b6"],
 " that envelope lies on the gray limit, and as ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec887f1-8bc1-2035-466f-6cc9ad0d78b5"],
 " grows it pulls inside it."
}], "Text",
 CellID->990404510,ExpressionUUID->"12ac60b9-2693-1844-7902-9458a423ecb6"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
