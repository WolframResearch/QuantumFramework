Cell[TextData[{
 "The nested square roots collapse exactly: the definition equals the formula \
for every pair of lengths and every angle, and the randomly rotated pairs \
fall on the curves. ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f752866-e08d-f567-770a-382d2b6f201a"],
 " reaches zero, at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35974518-b93f-14d0-6804-cbbc584c0da5"],
 ", only when both states are pure; any mixedness keeps opposite Bloch \
vectors from being perfectly distinguishable. The maximally mixed state (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], "1"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74dca883-939f-458e-0153-0a2918092e7a"],
 ") has the same fidelity with every state of a given length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fa21564-92cc-05df-0f31-075d08b96774"],
 ", whatever its direction."
}], "Text",
 CellID->1416370036,ExpressionUUID->"0d9158c2-ed32-880e-6a57-df8c3a908961"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2146546837,ExpressionUUID->"2c9cb37f-6159-f5eb-4055-7f5d20de8da9"],

Cell["Two qutrits entangled with a positive partial transpose", "Subsection",
 CellID->1163796977,ExpressionUUID->"43d55ea8-0417-cc0b-79d5-c651252bedef"],

Cell[TextData[{
 "Five orthonormal product states of two qutrits, the Tiles basis, leave a \
four-dimensional subspace, and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61ef823f-da29-f686-18f5-02d3ec3ea1d0"],
 " is the normalized projector onto it; ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["p", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"], "+", 
   StyleBox["p", "TI"], "\[ThinSpace]", 
   StyleBox["I", "TI"], "/", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b695e0-332a-dd8d-1deb-b196d761adf3"],
 " adds white noise of weight ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5adabb9e-c5a0-86ef-2d3a-c6fb29df5d13"],
 ". Its partial transpose has no negative eigenvalue, so the Peres test is \
silent. Is ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "663072bf-ce44-0534-1df9-83823fe7a29d"],
 " nevertheless entangled?"
}], "Text",
 CellID->1373133996,ExpressionUUID->"44204dc8-07d9-5480-4b04-e12ae576dce9"],

Cell[TextData[{
 "With qutrit states ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", 
   TemplateBox[{"1"},
    "Ket"], ",", 
   TemplateBox[{"2"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dcbe568-2dbb-4468-7c8e-a76f480c21e5"],
 ", the Tiles states and the state are"
}], "Text",
 CellID->1082484428,ExpressionUUID->"5f2d6f01-2c5a-428d-02e4-68dc24a53802"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{
      RowBox[{"0", "-", "1"}]},
     "Ket"]}], ",", 
   RowBox[{
    TemplateBox[{"2"},
     "Ket"], 
    TemplateBox[{
      RowBox[{"1", "-", "2"}]},
     "Ket"]}], ",", 
   RowBox[{
    TemplateBox[{
      RowBox[{"0", "-", "1"}]},
     "Ket"], 
    TemplateBox[{"2"},
     "Ket"]}], ",", 
   RowBox[{
    TemplateBox[{
      RowBox[{"1", "-", "2"}]},
     "Ket"], 
    TemplateBox[{"0"},
     "Ket"]}], ",", 
   RowBox[{
    TemplateBox[{
      RowBox[{"0", "+", "1", "+", "2"}]},
     "Ket"], 
    TemplateBox[{
      RowBox[{"0", "+", "1", "+", "2"}]},
     "Ket"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "=", 
    RowBox[{
     FractionBox["1", "4"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["I", "TI"], "-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{
          StyleBox["k", "TI"], "=", "1"}], "5",
         LimitsPositioning->False], 
        RowBox[{
         TemplateBox[{
           SubscriptBox[
            StyleBox["\[Psi]", "TI"], 
            StyleBox["k", "TI"]]},
          "Ket"], 
         TemplateBox[{
           SubscriptBox[
            StyleBox["\[Psi]", "TI"], 
            StyleBox["k", "TI"]]},
          "Bra"]}]}]}], ")"}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1127085489,ExpressionUUID->"3c87b053-69ce-be82-41e9-e2af5b71f66b"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["i", "TI"], "\[PlusMinus]", 
      StyleBox["j", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3162f6f5-1a14-5216-7bca-1269eb9a1f57"],
 " normalized. A separable ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c839667-0eb4-a9e7-72e8-dde3443f8cc9"],
 " would be a mixture of product states in its range, that is, product states \
orthogonal to all five ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Psi]", "TI"], 
     StyleBox["k", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "493819fc-924e-3cb5-35ee-f272d8a484af"],
 ". The realignment test ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[GridBox[{
      {GridBox[{
         {
          RowBox[{
           StyleBox["R", "TI"], 
           StyleBox["(",
            SpanMaxSize->1], 
           StyleBox["\[Rho]", "TI"], 
           StyleBox[")",
            SpanMaxSize->1]}]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.22}}}], "1"], ">", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36096b0a-f2fa-ac28-6652-dc06694d1bb2"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], 
   SubscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     StyleBox[
      RowBox[{"i", "j"}], "TI"], ",", 
     StyleBox[
      RowBox[{"k", "l"}], "TI"]}]], "=", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox[
      RowBox[{"i", "k"}], "TI"], ",", 
     StyleBox[
      RowBox[{"j", "l"}], "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "103a3e5c-8a4f-c150-1a67-285bec55fb17"],
 ", is a second, independent proof of entanglement."
}], "Text",
 CellID->239418696,ExpressionUUID->"2428bd48-1ae9-7750-520b-ab6a1dcddcc4"],

Cell[TextData[{
 "The search is for a product vector ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "536239c0-3f7f-d204-3308-aac61c2f6731"],
 " with complex amplitudes, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["a", "TI"]},
    "Ket"], ",", 
   RowBox[{
    TemplateBox[{
      StyleBox["b", "TI"]},
     "Ket"], "\[NotEqual]", "0"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6953e38a-e8ec-ac37-051e-52b5c992485a"],
 ", orthogonal to all five; the smallest eigenvalue of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Rho]", "TI"], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["B", "TI"]]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21ce26f4-4fb4-8085-7f9e-7ade622f8045"],
 " is exact, and the figure plots the realignment value ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[GridBox[{
      {GridBox[{
         {
          RowBox[{
           StyleBox["R", "TI"], 
           StyleBox["(",
            SpanMaxSize->1], 
           SubscriptBox[
            StyleBox["\[Rho]", "TI"], 
            StyleBox["p", "TI"]], 
           StyleBox[")",
            SpanMaxSize->1]}]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.22}}}], "1"], "-", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559e191a-8679-ef09-1cd0-37de783f5dcc"],
 " against ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a6bbdaa-107b-c3e3-2c73-ddd98b0e3bd4"],
 ", marking where it crosses zero:"
}], "Text",
 CellID->67179135,ExpressionUUID->"3f05acdf-2093-2ed9-5287-1add25e3951a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tilesStates", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", " ", "=", " ", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", " ", 
       RowBox[{"u", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Normalize", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"KroneckerProduct", " ", "@@", " ", "#"}], "]"}], "]"}], " ",
        "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"e", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"e", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"e", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"e", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"e", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"e", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"e", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"e", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
          RowBox[{"e", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"e", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"e", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
          RowBox[{"e", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"u", ",", " ", "u"}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tilesRho", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "9", "]"}], " ", "-", " ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"#", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "tilesStates"}], "]"}]}], ")"}], "/", "4"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tilesNoisy", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "p"}], ")"}], " ", "tilesRho"}], " ", "+", 
    " ", 
    RowBox[{"p", " ", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "9", "]"}], "/", "9"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tilesProductQ", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"Array", "[", 
         RowBox[{"tilesA", ",", " ", "3"}], "]"}]}], ",", " ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"Array", "[", 
         RowBox[{"tilesB", ",", " ", "3"}], "]"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Reduce", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"And", " ", "@@", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"tilesStates", " ", ".", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"a", ",", " ", "b"}], "]"}], "]"}]}], " ", "==", " ", 
           "0"}], "]"}]}], " ", "&&", " ", 
        RowBox[{"Or", " ", "@@", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"a", " ", "!=", " ", "0"}], "]"}]}], " ", "&&", " ", 
        RowBox[{"Or", " ", "@@", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"b", " ", "!=", " ", "0"}], "]"}]}]}], ",", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"a", ",", " ", "b"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tilesRegroup", "[", 
    RowBox[{"r_", ",", " ", "perm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"r", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "3", ",", " ", "3", ",", " ", "3"}], "}"}]}],
         "]"}], ",", " ", "perm"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"9", ",", " ", "9"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tilesMinPT", " ", "=", " ", 
   RowBox[{"Min", "[", 
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"tilesRegroup", "[", 
      RowBox[{"tilesRho", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4", ",", " ", "3", ",", " ", "2"}], "}"}]}], 
      "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tilesRealign", "[", 
    RowBox[{"p_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"SingularValueList", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"tilesRegroup", "[", 
         RowBox[{
          RowBox[{"tilesNoisy", "[", "p", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3", ",", " ", "2", ",", " ", "4"}], 
           "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"Tolerance", " ", "->", " ", "0"}]}], "]"}], "]"}], " ", "-", 
    " ", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tilesPStar", " ", "=", " ", 
   RowBox[{"\[FormalP]", " ", "/.", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"tilesRealign", "[", "\[FormalP]", "]"}], " ", "==", " ", 
       "0"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[FormalP]", ",", " ", "0.1"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"tilesRealign", "[", "p", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "0.2"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "tilesPStar", "}"}], ",", " ", 
        RowBox[{"{", "0", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"GridLinesStyle", " ", "->", " ", "Dashed"}], ",", "\n", "   ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<noise weight p\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[LeftDoubleBracketingBar]\>\"", ",", " ", "\"\<R(\>\"",
            ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Rho]\>\"", ",", " ", "\"\<p\>\""}], "]"}], ",", 
           " ", "\"\<)\>\"", ",", " ", "\"\<\[RightDoubleBracketingBar]\>\"", 
           ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\>\"", ",", " ", "1"}], "]"}], ",", 
           " ", "\"\< - 1\>\""}], "}"}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<product vector orthogonal to all five Tiles states \
exists:  \>\"", ",", " ", "tilesProductQ"}], "}"}], "]"}], ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<smallest eigenvalue of \>\"", ",", " ", 
            RowBox[{"Superscript", "[", 
             RowBox[{"\"\<\[Rho]\>\"", ",", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<T\>\"", ",", " ", "\"\<B\>\""}], "]"}]}], "]"}], ",",
             " ", "\"\<:  \>\"", ",", " ", "tilesMinPT"}], "}"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", " ", 
     "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[130]:= ",
 CellID->1713419403,ExpressionUUID->"3ef23179-4699-e81b-4a46-5dde8adac93e"],

Cell[TextData[{
 "No product vector is orthogonal to the Tiles states, so the range of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75b981bf-f006-36e4-71c0-7556da498c37"],
 " contains no product state and ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39b10e85-bef4-08ca-1530-3222b7857aa3"],
 " is entangled, although its partial transpose has no negative eigenvalue. \
Realignment sees the entanglement from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40e3be98-eea3-46c8-3a0c-8b9ecef8320f"],
 " up to the marked noise weight and is silent beyond it."
}], "Text",
 CellID->1997849961,ExpressionUUID->"28fa1a90-c911-671d-7ad9-35b92ae74a60"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->281497421,ExpressionUUID->"064c0446-60f3-a5aa-4472-37c5bd8f5002"],

Cell["Theorems by quantifier elimination", "Section",
 CellID->470788389,ExpressionUUID->"76bfdc18-a8a2-5105-7062-4f9276335c63"],

Cell["\<\
The examples in this section are theorems rather than simulations. Each \
states a claim for every state, measurement or parameter in a range: the \
input that maximizes the coherent information of amplitude damping, the \
data-processing inequality, the Helstrom bound on telling two states apart, \
the Robertson-Schr\[ODoubleDot]dinger uncertainty relation, an entropic \
uncertainty relation, the absence of bound entanglement for two qubits, the \
Werner threshold in every dimension, and the error bound of a circuit's \
arithmetic. QF supplies the states and channels as exact formulas, and WL \
decides the statement with quantifier elimination (Reduce and Resolve over \
the reals), which returns either a proof that it holds everywhere or the \
exact region where it fails.\
\>", "Text",
 CellID->666699825,ExpressionUUID->"6db9ed30-153b-47ea-40be-b0dcf6b44b72"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->659864158,ExpressionUUID->"7a863caa-595f-3d03-35ca-d89122ea73f5"],

Cell["\<\
Coherent information of amplitude damping, maximized over the input\
\>", "Subsection",
 CellID->1129714332,ExpressionUUID->"2a004cb1-311b-96d6-1821-181a89d93322"],

Cell[TextData[{
 "A qubit holds ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["p", "TI"]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{"0"},
      "Ket"], 
     TemplateBox[{"0"},
      "Bra"]}], "+", 
    RowBox[{
     StyleBox["p", "TI"], 
     TemplateBox[{"1"},
      "Ket"], 
     TemplateBox[{"1"},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "264ef103-a6e2-9938-4682-c3da5db75aeb"],
 ", with ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25ce422e-c0e6-b87d-1dc5-62e4b00b6394"],
 " excited, and a reference qubit ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a4ad0bc-ba78-2056-7c4b-14d9985f7c74"],
 " purifies it. Only the qubit crosses an amplitude-damping channel, which \
drops ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fd31103-182c-adf6-355e-78747b16f0fa"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59bb8cc5-53ed-1536-67d1-f54e0d2448e0"],
 " with probability ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654d098a-3cb3-87bb-4561-0aa6ff5e9c1a"],
 ". Which input population ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b5b3070-8ffa-75d5-37a2-a1c66cd4360e"],
 " carries the most quantum information across?"
}], "Text",
 CellID->1509698982,ExpressionUUID->"6420f74e-5c74-5fba-19c9-e31e77dd7e6b"],

Cell["The channel and the coherent information, in bits, are", "Text",
 CellID->806525040,ExpressionUUID->"75efacbd-8e6e-f664-1c99-e3ae7455b059"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\|01d4a9", 
     StyleBox["\[Gamma]", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["K", "TI"], "^"], "0"], 
    StyleBox["\[Rho]", "TI"], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["K", "TI"], "^"], "0", "\[Dagger]"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["K", "TI"], "^"], "1"], 
    StyleBox["\[Rho]", "TI"], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["K", "TI"], "^"], "1", "\[Dagger]"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["K", "TI"], "^"], "0"], "=", 
    RowBox[{"(", GridBox[{
       {"1", "0"},
       {"0", 
        SqrtBox[
         RowBox[{"1", "-", 
          StyleBox["\[Gamma]", "TI"]}]]}
      }], ")"}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["K", "TI"], "^"], "1"], "=", 
