Cell["Pulse area sets the rotation", "Subsection",
 CellID->1639372801,ExpressionUUID->"491014fe-4637-6146-3dc9-69f20eafb9c2"],

Cell[TextData[{
 "A qubit is driven for a time ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e4a7d20-f9ad-85c0-1873-4258dbe59f3e"],
 " by a pulse ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox["\[CapitalOmega]", "0"], "\[ThinSpace]", "\[Epsilon]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76bac922-855e-f465-576c-cfa65264ee86"],
 " of shape ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3333d089-3956-5879-00e4-1f763b54b617"],
 " with peak 1, detuned by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["q", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b9cdc2a-32d9-52fd-0ca5-9b2343fc4a28"],
 ". Does only the pulse area set the rotation, for any shape and detuning?"
}], "Text",
 CellID->2128090218,ExpressionUUID->"011491ad-4e0a-3c5a-7221-0c670c58955d"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54719cde-8745-f773-2635-f73088e3c697"],
 ", ground state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "155d5f22-c8f0-c4a1-4310-68532cf40b2b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    TemplateBox[{"0"},
     "Ket"]}], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c32564e-0c7c-43fa-5786-b4f473b1e788"],
 ", the qubit in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14a7de72-8ebd-f1be-3c05-191e535c84a3"],
 " has"
}], "Text",
 CellID->1261191909,ExpressionUUID->"28f6020b-ffab-2cc9-7e81-0c2b8d60684d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    FractionBox[
     StyleBox["\[Delta]", "TI"], "2"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "+", 
    FractionBox[
     RowBox[{"\[CapitalOmega]", 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Theta]", "TI"], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", 
      StyleBox["T", "TI"]], 
     RowBox[{"\[CapitalOmega]", "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->595599998,ExpressionUUID->"42d98c2d-2681-84f0-1345-57533a708b1b"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45b03ee2-ba0c-05c8-6582-5d62237bfb08"],
 " is a Gaussian of width ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c91b158-41f1-eb90-42a8-b24886a5feac"],
 " centred at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74fb023b-785d-9003-59b6-81ef2329a5b9"],
 " and cut off at the pulse edges, a raised cosine ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", 
    StyleBox["t", "TI"], "/", 
    StyleBox["T", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e111ad9-b285-4f2b-095a-c18d5e1607c5"],
 ", or a square. On resonance ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab9bc45-abfd-0396-6a1d-40c641908127"],
 " commutes with itself at all times and rotates the qubit by the area ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3408646a-fdbc-428a-5fe9-25568d955a59"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "1", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c623270-153c-825c-7fa6-95b77e9eb74b"],
 "; the square pulse is solvable at any detuning, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "1", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    SuperscriptBox[
     StyleBox["\[Theta]", "TI"], "2"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Theta]", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Delta]", "TI"], "2"], 
     SuperscriptBox[
      StyleBox["T", "TI"], "2"]}]], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox[
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["\[Theta]", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["\[Delta]", "TI"], "2"], 
      SuperscriptBox[
       StyleBox["T", "TI"], "2"]}]], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "332352c6-e1ff-e92e-3f31-8b85916d388e"],
 "."
}], "Text",
 CellID->919236821,ExpressionUUID->"3219d422-383f-85ae-516e-6be1b91f4f68"],

Cell[TextData[{
 "From ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42717310-cc1f-f7de-6cb4-04fff08df812"],
 ", the figure plots ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "1", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42ab67c5-e287-aff9-48b5-305a1846df76"],
 " at the end of the pulse against ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c9607f6-9182-2938-368e-8f2fd6b4caab"],
 " (points), with time in units of ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf62912-d065-49fa-1217-9e50eaa22515"],
 " and the exact square-pulse formula dashed:"
}], "Text",
 CellID->1855420397,ExpressionUUID->"3a061f9b-361c-33a8-6267-37f369068dd2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rabiShapes", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Gaussian\>\"", " ", "->", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "25"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", " ", "-", " ", 
            RowBox[{"1", "/", "2"}]}], ")"}], "^", "2"}], "/", "2"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<Cosine\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"Pi", " ", "t"}], "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"\"\<Square\>\"", " ", "->", " ", "1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rabiArea", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", 
     "&"}], " ", "/@", " ", "rabiShapes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rabiP1", "[", 
    RowBox[{"shape_", ",", " ", "\[Delta]T_", ",", " ", "\[Theta]_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"QuantumEvolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Delta]T", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"\[Theta]", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"rabiArea", "[", "shape", "]"}]}], ")"}]}], "]"}], " ", 
          
          RowBox[{"rabiShapes", "[", "shape", "]"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", "\n", 
        "     ", 
        RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], "[", 
      "1", "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rabiPanel", "[", "\[Delta]T_", "]"}], " ", ":=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", " ", 
           RowBox[{"rabiP1", "[", 
            RowBox[{"s", ",", " ", "\[Delta]T", ",", " ", "\[Theta]"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", 
           RowBox[{"Keys", "[", "rabiShapes", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", " ", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "Pi"}], ",", " ", "24"}], "]"}]}], "}"}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Theta]", "^", "2"}], "/", "4"}], " ", 
            RowBox[{
             RowBox[{"Sinc", "[", 
              RowBox[{
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"\[Theta]", "^", "2"}], " ", "+", " ", 
                 RowBox[{"\[Delta]T", "^", "2"}]}], "]"}], "/", "2"}], "]"}], 
             "^", "2"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", " ", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "Pi"}], ",", " ", "120"}], "]"}]}], "}"}]}], 
        "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Joined", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "True", ",", " ", "False", ",", " ", "False", ",", " ", "False"}], 
       "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "Dashed", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
        "Automatic"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\>\"", ",", " ", "\"\<\[FilledCircle]\>\"", ",", 
        " ", "\"\<\[FilledSquare]\>\"", ",", 
        " ", "\"\<\[FilledUpTriangle]\>\""}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Keys", "[", "rabiShapes", "]"}], ",", 
        " ", "\"\<square, exact\>\""}], "]"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", " ", "Pi"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", " ", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"TraditionalForm", "[", "#", "]"}], ",", " ", 
                RowBox[{"FractionBoxOptions", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], 
               "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "Pi"}], ",", " ", 
             RowBox[{"Pi", "/", "2"}]}], "]"}]}], ",", " ", "None"}], "}"}]}],
        "}"}]}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<P(1)\>\""}], "}"}]}], ",", 
     "\n", "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<T \[Delta] = \>\"", ",", " ", "\[Delta]T"}], "}"}], 
       "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rabiPanels", " ", "=", " ", 
   RowBox[{"rabiPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "rabiPanels"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "rabiPanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[153]:= ",
 CellID->1514056945,ExpressionUUID->"19db24c0-bcb7-45ca-0b81-24d3759d1548"],

Cell[TextData[{
 "On resonance all three shapes fall on ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d3a1dd2-9af1-ddae-31fc-b591f3708b34"],
 ": only the area matters. Detuning breaks this, and the square pulse, which \
follows the exact formula, departs most: it spreads the area over the whole \
window, so its spectrum is the narrowest and a given detuning falls furthest \
down it."
}], "Text",
 CellID->993481444,ExpressionUUID->"4b1cec27-b331-5452-1a67-236968dc90a0"],

