  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->66331113,ExpressionUUID->"3c581cd4-ca87-8b08-123a-b589385d1244"],

Cell[TextData[{
 "which does not commute with itself at different times; the propagator \
solves ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35e3caf0-e3db-2bea-605a-a95192c0687a"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1caa454e-d8ba-d056-03b9-62188ede9b0d"],
 ", and for an infinitely long sweep the probability to stay in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da24ccf-522d-5552-1668-999f2c220a44"],
 " is the Landau-Zener value ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[Pi]", 
    SuperscriptBox["\[CapitalDelta]", "2"], "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"2", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6d9c0e-4bdc-979e-14c1-c3fb1c7466f3"],
 "."
}], "Text",
 CellID->1729644541,ExpressionUUID->"3590d9a2-353f-7cbb-3ee3-8046e9913038"],

Cell[TextData[{
 "The qubit starts in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "796b5560-0d07-3a62-246c-d3567846f198"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["v", "TI"]], "\[ThinSpace]", 
