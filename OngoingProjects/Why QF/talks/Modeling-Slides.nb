    StyleBox["e", "TI"], 
    RowBox[{"2", "\[Pi]", 
     StyleBox["i", "TI"], "/", "9"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2a85a2-adda-c52d-13ac-c63fd932e17c"],
 " and indices mod 3, the gates are"
}], "Text",
 CellID->410831485,ExpressionUUID->"689977de-305d-e0c3-0eef-f1f1fc5da229"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["X", "TI"], 
     TemplateBox[{
       StyleBox["j", "TI"]},
      "Ket"]}], "=", 
    TemplateBox[{
      RowBox[{
        StyleBox["j", "TI"], "+", "1"}]},
     "Ket"]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["Z", "TI"], 
     TemplateBox[{
       StyleBox["j", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Omega]", "TI"], 
      RowBox[{"-", 
       StyleBox["j", "TI"]}]], 
     TemplateBox[{
       StyleBox["j", "TI"]},
      "Ket"]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["F", "TI"], 
     TemplateBox[{
       StyleBox["j", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["3"]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["k", "TI"],
       LimitsPositioning->False], 
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox[
         RowBox[{"j", "k"}], "TI"]], 
       TemplateBox[{
         StyleBox["k", "TI"]},
        "Ket"]}]}]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["T", "TI"], "=", 
    RowBox[{
     StyleBox["diag",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{"1", ",", 
       StyleBox["\[Zeta]", "TI"], ",", 
       SuperscriptBox[
        StyleBox["\[Zeta]", "TI"], 
        RowBox[{"-", "1"}]]}], ")"}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{"+"},
     "Ket"], "=", 
    RowBox[{
     StyleBox["F", "TI"], 
     RowBox[{
      TemplateBox[{"0"},
       "Ket"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->128796841,ExpressionUUID->"23128183-c6ac-ee88-73a2-802e6ec7b13c"],

Cell[TextData[{
 "After each gate ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b7e34e5-6f87-b40d-21dd-a50ba67532df"],
 " is read from the state; each panel shows the nine values of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5537d518-c464-5444-528e-5a1fba4acf96"],
 ", negative ones in bold and framed, with its sum-negativity:"
}], "Text",
 CellID->1932004746,ExpressionUUID->"3e1c23ff-ffea-d205-7de1-766641b0021c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"magicFmt", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"NumberForm", "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"magicStates", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"Ket", "[", 
        RowBox[{"{", "\"\<+\>\"", "}"}], "]"}], "]"}], " ", "->", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "3"}], "]"}]}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"HoldForm", "[", 
        RowBox[{"Divide", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Ket", "[", 
            RowBox[{"{", "1", "}"}], "]"}], " ", "-", " ", 
           RowBox[{"Ket", "[", 
            RowBox[{"{", "2", "}"}], "]"}]}], ",", " ", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "]"}], "]"}], " ", "->", 
      " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "3"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"magicGates", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<no gate\>\"", " ", "->", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<I\>\"", "[", "3", "]"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<F\>\"", " ", "->", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<H\>\"", "[", "3", "]"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<XZ\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<X\>\"", "[", "3", "]"}], "]"}], " ", "@", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<Z\>\"", "[", "3", "]"}], "]"}]}]}], ",", " ", 
     RowBox[{"\"\<T\>\"", " ", "->", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "Pi", " ", 
             RowBox[{"I", "/", "9"}]}], "]"}], ",", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "Pi", " ", 
             RowBox[{"I", "/", "9"}]}], "]"}]}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", "1", "}"}], ",", " ", "3"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qutritMagicPanel", "[", 
    RowBox[{"gate_", ",", " ", "state_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"N", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"magicGates", "[", "gate", "]"}], "[", 
            RowBox[{"magicStates", "[", "state", "]"}], "]"}], 
           "[", "\"\<PhaseSpace\>\"", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",",
      " ", 
     RowBox[{"Style", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Labeled", "[", 
        RowBox[{
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"Reverse", "[", 
              RowBox[{"MapThread", "[", 
               RowBox[{"Prepend", ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Map", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"#", " ", "<", " ", 
                    RowBox[{"-", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "9"}]}]}]}], ",", " ", 
                    RowBox[{"Item", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"magicFmt", "[", "#", "]"}], ",", " ", "Bold"}], 
                    "]"}], ",", " ", 
                    RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
                    RowBox[{"FrameStyle", " ", "->", " ", "Thick"}]}], "]"}], 
                    ",", " ", 
                    RowBox[{"magicFmt", "[", "#", "]"}]}], "]"}], " ", "&"}], 
                    ",", " ", "w", ",", " ", 
                    RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
                  RowBox[{"Range", "[", 
                   RowBox[{"0", ",", " ", "2"}], "]"}]}], "}"}]}], "]"}], 
              "]"}], ",", "\n", "      ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<p\\\\q\>\"", ",", " ", "0", ",", " ", "1", ",", 
               " ", "2"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Dividers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"2", " ", "->", " ", "True"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "2"}], " ", "->", " ", "True"}], "}"}]}], 
             "}"}]}], ",", " ", 
           RowBox[{"ItemSize", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"3.5", ",", " ", "1.6"}], "}"}]}], ",", " ", 
           RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", 
         "\n", "    ", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"gate", ",", " ", "\"\<,  \>\"", ",", " ", "state"}], 
               "}"}], "]"}], ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<sn = \>\"", ",", " ", 
                RowBox[{"magicFmt", "[", 
                 RowBox[{"Total", "[", 
                  RowBox[{"Select", "[", 
                   RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{"-", "w"}], "]"}], ",", " ", "Positive"}], "]"}], 
                  "]"}], "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", "Center"}],
           "]"}], ",", " ", "Top", ",", " ", 
         RowBox[{"LabelStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}], ",", 
            " ", "13"}], "}"}]}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}], ",", " ", 
       "13"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Outer", "[", 
     RowBox[{"qutritMagicPanel", ",", " ", 
      RowBox[{"Keys", "[", "magicGates", "]"}], ",", " ", 
      RowBox[{"Keys", "[", "magicStates", "]"}]}], "]"}], "\[Transpose]"}], ",",
    " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "2"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[127]:= ",
 CellID->1354506979,ExpressionUUID->"034da191-a886-4ec7-51cc-dfe826029569"],

Cell[TextData[{
 "The two Clifford gates only rearrange the nine numbers, so the \
sum-negativity never changes: ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71944e5d-157d-1d58-0db9-fc390ed814f8"],
 " stays nonnegative, and the single negative entry of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"1"},
      "Ket"], "-", 
     TemplateBox[{"2"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29640f0c-993d-b353-3ab9-672847809026"],
 " moves to another phase-space point under ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"X", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ba94af-403f-0ade-18cc-4838f70f5061"],
 ". ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae610c4-0b0e-c8e5-3f8e-b0e6b2b121ab"],
 " changes the numbers themselves: it gives ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55e69040-77c1-80f6-63a9-a041e7403cd2"],
 " three negative entries, creating magic from a stabilizer state, and it \
changes the negativity of the other state too."
}], "Text",
 CellID->1505472181,ExpressionUUID->"52b0de22-8e65-846b-0708-81252bc04393"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->968084255,ExpressionUUID->"29c39f80-37c4-6803-07c9-3105afb60460"],

Cell["Gleason's theorem needs three outcomes", "Subsection",
 CellID->648216625,ExpressionUUID->"5369f563-d815-4e89-2d3e-d45f1f364178"],

Cell[TextData[{
 "Gleason's theorem says that in dimension three or more the only rule that \
assigns probabilities to measurement outcomes, adding to 1 over every \
measurement, is the Born rule ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   StyleBox["\[Rho]", "TI"], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46341a75-ca25-03d6-2a8f-3f0212901a6f"],
 "; Busch's theorem extends this to a qubit once generalized measurements \
(POVMs) are allowed. Which measurements expose a rule that is not Born's?"
}], "Text",
 CellID->557146394,ExpressionUUID->"52776eb4-3495-a7e7-4d6b-1c22a43fb17f"],

Cell[TextData[{
 "Take the rule that replaces each Born probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e6431a9-96cf-bafa-3e50-652197c42fca"],
 " by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "3", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], "-", "2", 
   SuperscriptBox[
    StyleBox["p", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fcaa8bd-d752-3523-7606-e787babfaf28"],
 ", which is increasing and maps ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409cc348-00c5-7531-075d-2c5cd924f65d"],
 " onto itself. A qubit basis has two outcomes, ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a892d52-0031-79b0-410d-166d31d384b0"],
 " and ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bd1339c-e658-ee5b-0daa-ff97b2236ca4"],
 "; a qutrit basis, or the qubit trine POVM with effects ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], 
    StyleBox["k", "TI"]], "=", 
   FractionBox["1", "3"], "(", 
   RowBox[{"1", "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], 
     StyleBox["k", "TI"]], "\[CenterDot]", 
    OverscriptBox[
     StyleBox[
      StyleBox["\[Sigma]", "TI"],
      FontWeight->"Bold"], "^"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d75e110-45df-d223-5881-0393ac6c078f"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "302df206-3477-f720-1431-270a24f4321f"],
 " at ",
 Cell[BoxData[
  SuperscriptBox["120", "\[SmallCircle]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd9251b-79a6-0010-761f-ab5cfd4c4655"],
 " in the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54eb3ee8-ad5d-fa8f-1c04-557945bcede5"],
 " plane, has three, ",
 Cell[BoxData[
  StyleBox["u", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a9de9b9-7e0d-5497-1658-638a0de6ed69"],
 ", ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38467949-3e9c-ba9c-42e7-d1a715e6d5fd"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", "1", "-", 
   StyleBox["u", "TI"], "-", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "780ea4c4-6464-c360-3635-685ed770d608"],
 ". The rule is consistent only where"
}], "Text",
 CellID->369723885,ExpressionUUID->"71ab6f00-3b5d-db8b-7a11-99df0ab1c252"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["g", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["p", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    StyleBox["g", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", "1", "\[NonBreakingSpace]\[NonBreakingSpace]", 
    StyleBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"two", "\[NonBreakingSpace]", "outcomes"}], 
      StyleBox[")",
       SpanMaxSize->1]}],
     FontSlant->"Plain"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["u", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["v", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      StyleBox["g", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["w", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}], "=", 
    RowBox[{"1", "\[NonBreakingSpace]\[NonBreakingSpace]", 
     RowBox[{
      StyleBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"three", "\[NonBreakingSpace]", "outcomes"}], 
        StyleBox[")",
         SpanMaxSize->1]}],
       FontSlant->"Plain"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1984631204,ExpressionUUID->"7ca63678-9333-cc4a-6c0f-595feec8fdfe"],

Cell[TextData[{
 "Both sums simplify in closed form, and the three-outcome sum is plotted \
over the triangle of probabilities, with the outcome probabilities of the \
trine on twelve pure qubit states with Bloch vectors in the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57ef2712-2985-4966-4288-237d738bba8e"],
 " plane and of a qutrit basis on twelve random pure states:"
}], "Text",
 CellID->368168435,ExpressionUUID->"616c07db-1dad-c4b1-63e4-55f57cd540f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gleasonG", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"3", " ", 
     RowBox[{"s", "^", "2"}]}], " ", "-", " ", 
    RowBox[{"2", " ", 
     RowBox[{"s", "^", "3"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gleasonEffects", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"2", " ", "\[Pi]", " ", 
             RowBox[{"k", "/", "3"}]}], "]"}], ",", " ", "0", ",", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", "\[Pi]", " ", 
             RowBox[{"k", "/", "3"}]}], "]"}]}], "}"}], " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
       ")"}], "/", "3"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gleasonTrine", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Most", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumMeasurementOperator", "[", "gleasonEffects", "]"}], "[", 
        RowBox[{"QuantumState", "[", 
         RowBox[{"\"\<BlochVector\>\"", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], ",", " ", "0", ",", " ", 
            RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}], "}"}], "]"}], "]"}], 
        "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", 
       RowBox[{"11", " ", 
        RowBox[{"\[Pi]", "/", "6"}]}], ",", " ", 
       RowBox[{"\[Pi]", "/", "6"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gleasonQutrit", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Most", "[", 
        RowBox[{
         RowBox[{"QuantumState", "[", 
          RowBox[{"\"\<RandomPure\>\"", ",", " ", "3"}], "]"}], 
         "[", "\"\<ProbabilitiesList\>\"", "]"}], "]"}], ",", " ", "12"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"gleasonG", "[", "p", "]"}], ",", " ", "p"}], "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"PlotStyle", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<g(p)\>\"", ",", " ", "\"\<Born: p\>\""}], "}"}], ",",
            " ", "Below"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Born probability p\>\"", ",", 
           " ", "\"\<assigned probability\>\""}], "}"}]}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "330"}], ",", "\n", "    ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             
             RowBox[{"\"\<two outcomes: g(p) + g(1\[Minus]p) = \>\"", ",", 
              " ", 
              RowBox[{"Simplify", "[", 
               RowBox[{
                RowBox[{"gleasonG", "[", "p", "]"}], " ", "+", " ", 
                RowBox[{"gleasonG", "[", 
                 RowBox[{"1", " ", "-", " ", "p"}], "]"}]}], "]"}]}], "}"}], 
            "]"}], ",", " ", "13", ",", " ", 
           RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
          "]"}]}]}], "]"}], ",", "\n", "   ", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"DensityPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gleasonG", "[", "u", "]"}], " ", "+", " ", 
           RowBox[{"gleasonG", "[", "v", "]"}], " ", "+", " ", 
           RowBox[{"gleasonG", "[", 
            RowBox[{"1", " ", "-", " ", "u", " ", "-", " ", "v"}], "]"}]}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"u", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"RegionFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", " ", "+", " ", "#2"}], " ", "<=", " ", "1"}], " ",
              "&"}], ")"}]}], ",", " ", 
          RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}]}], "]"}], ",", 
        "\n", "    ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gleasonTrine", ",", " ", "gleasonQutrit"}], "}"}], ",", 
          " ", 
          RowBox[{"PlotMarkers", " ", "->", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[FilledCircle]\>\"", ",", 
             " ", "\"\<\[FilledSquare]\>\""}], "}"}]}], ",", " ", 
          RowBox[{"PlotLegends", " ", "->", " ", 
           RowBox[{"Placed", "[", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<qubit trine POVM\>\"", ",", 
               " ", "\"\<qutrit basis\>\""}], "}"}], ",", " ", "Below"}], 
            "]"}]}]}], "]"}], ",", "\n", "    ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<u\>\"", ",", " ", "\"\<v\>\""}], "}"}]}], ",", " ", 
        RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", "\n", "    ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             
             RowBox[{"\"\<three outcomes: g(u) + g(v) + g(w) = 1 \[Minus] \
\>\"", ",", " ", 
              RowBox[{"Simplify", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", " ", "-", " ", 
                  RowBox[{"gleasonG", "[", "u", "]"}], " ", "-", " ", 
                  RowBox[{"gleasonG", "[", "v", "]"}], " ", "-", " ", 
                  RowBox[{"gleasonG", "[", 
                   RowBox[{"1", " ", "-", " ", "u", " ", "-", " ", "v"}], 
                   "]"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"u", " ", "v", " ", 
                  RowBox[{"(", 
                   RowBox[{"1", " ", "-", " ", "u", " ", "-", " ", "v"}], 
                   ")"}]}], ")"}]}], "]"}], ",", " ", "\"\< u v w\>\""}], 
             "}"}], "]"}], ",", " ", "13", ",", " ", 
           RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
          "]"}]}]}], "]"}]}], "}"}], "}"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Top"}]}], "]"}]}], "Input",
 CellLabel->"In[128]:= ",
 CellID->210054172,ExpressionUUID->"443ffcce-008b-0291-4798-b3592ca9bef9"],

Cell[TextData[{
 "For two outcomes the sum is 1 identically, so a qubit basis cannot tell ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "490b249f-e9b4-0ed4-1649-3036b4000aa5"],
 " from the Born rule. For three outcomes the sum falls below 1 everywhere \
inside the triangle and reaches 1 only on its edges, where one outcome is \
impossible. The qutrit basis and the qubit trine put most states inside, so \
either measurement rules ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d977fa0-2e44-e5ce-51e1-53e0856c0552"],
 " out."
}], "Text",
 CellID->1615989803,ExpressionUUID->"2c8bc3cb-e453-50eb-5ab6-04415640e0d1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->899669792,ExpressionUUID->"3332aed4-ce49-cbb1-4585-8b9dec5f8780"],

Cell["Fidelity of two mixed qubits in closed form", "Subsection",
 CellID->41184890,ExpressionUUID->"6a6bf94d-9c22-c8fa-3333-e67eb1abd532"],

Cell[TextData[{
 "Two qubit states ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["r", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddad3a3-bd81-004c-7900-9940827a7ff3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["r", "TI"], "\[RightVector]"], "2"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "316eab79-1ad7-e5d3-3d7c-1ea1842e62d6"],
 " have Bloch vectors of lengths ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["r", "TI"], "1"], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["r", "TI"], "2"], "\[LessEqual]", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32304036-62e5-6fae-2f7e-121d256c2b5b"],
 " at an angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ecc7e6b-aa42-0765-722e-0c2862835456"],
 ". Uhlmann's fidelity is defined through nested matrix square roots; does it \
reduce to a formula in the Bloch vectors alone?"
}], "Text",
 CellID->865485169,ExpressionUUID->"3dfd70fb-c565-200d-6991-b89956170da1"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["F", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], 
       SqrtBox[
        RowBox[{
         SqrtBox[
          SubscriptBox[
           StyleBox["\[Rho]", "TI"], "1"]], "\[ThinSpace]", 
         SubscriptBox[
          StyleBox["\[Rho]", "TI"], "2"], 
         SqrtBox[
          SubscriptBox[
           StyleBox["\[Rho]", "TI"], "1"]]}]]}], ")"}], "2"], "\[ThickSpace]", 
    OverscriptBox["=", "?"], "\[ThickSpace]", 
    FractionBox["1", "2"], "(", 
    RowBox[{"1", "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"], "2"], "+", 
     SqrtBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SubsuperscriptBox[
         StyleBox["r", "TI"], "1", "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SubsuperscriptBox[
         StyleBox["r", "TI"], "2", "2"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]]}], ")"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1331986931,ExpressionUUID->"6c0abc93-b291-715b-2874-43c7473560e3"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35791018-debd-4ab4-33af-2d6a3cf767f5"],
 " is unchanged when both states are rotated together, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "1"], "=", 
   SubscriptBox[
    StyleBox["r", "TI"], "1"], 
   OverscriptBox[
    StyleBox["z", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7daba448-f787-8434-6bf9-d34c92157c33"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "2"], "=", 
   SubscriptBox[
    StyleBox["r", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}], ",", "0", ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a012fc1-deb6-dbb9-7b2d-cfaf712a5e4b"],
 " cover every pair."
}], "Text",
 CellID->788118345,ExpressionUUID->"120d3d9b-0dc0-597b-74ce-f25228fbe689"],

Cell[TextData[{
 "The definition, square roots included, is compared with the formula for \
general ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a39933-e99b-c458-3787-095f3a9bf6c6"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499ee8bf-4af9-295f-3f4c-e4e6c71d90b1"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29b81992-8d33-245d-3dca-74248d9ea621"],
 "; the figure draws the formula against ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "668e5465-b389-e292-727f-a3ff2bc8bea9"],
 " and, as markers, the fidelity of random pairs of states with the same \
lengths and angle, each pair turned by a random rotation:"
}], "Text",
 CellID->1458873312,ExpressionUUID->"6c4833e0-d7ed-602f-5eb0-37b2951a04b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"uhlBloch", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{"r", " ", ".", " ", 
       RowBox[{"PauliMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], ")"}],
     "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uhlDefinition", "[", 
    RowBox[{"r1_", ",", " ", "r2_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{
         RowBox[{"uhlBloch", "[", "r1", "]"}], ",", " ", 
         RowBox[{"1", "/", "2"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{
         RowBox[{"s", " ", ".", " ", 
          RowBox[{"uhlBloch", "[", "r2", "]"}], " ", ".", " ", "s"}], ",", 
         " ", 
         RowBox[{"1", "/", "2"}]}], "]"}], "]"}], "^", "2"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uhlFormula", "[", 
    RowBox[{"r1_", ",", " ", "r2_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"r1", " ", ".", " ", "r2"}], " ", "+", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"r1", " ", ".", " ", "r1"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"r2", " ", ".", " ", "r2"}]}], ")"}]}], "]"}]}], ")"}], "/",
     "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uhlPair", "[", 
    RowBox[{"l1_", ",", " ", "l2_", ",", " ", "\[Theta]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "l1"}], "}"}], ",", " ", 
     RowBox[{"l2", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uhlIdentity", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"uhlDefinition", " ", "@@", " ", 
       RowBox[{"uhlPair", "[", 
        RowBox[{"l1", ",", " ", "l2", ",", " ", "\[Theta]"}], "]"}]}], " ", "==",
       " ", 
      RowBox[{"uhlFormula", " ", "@@", " ", 
       RowBox[{"uhlPair", "[", 
        RowBox[{"l1", ",", " ", "l2", ",", " ", "\[Theta]"}], "]"}]}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{"0", " ", "<=", " ", "l1", " ", "<=", " ", "1"}], " ", "&&", 
      " ", 
      RowBox[{"0", " ", "<=", " ", "l2", " ", "<=", " ", "1"}], " ", "&&", 
      " ", 
      RowBox[{"0", " ", "<=", " ", "\[Theta]", " ", "<=", " ", "\[Pi]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uhlRandom", "[", 
    RowBox[{"l1_", ",", " ", "l2_", ",", " ", "\[Theta]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rot", " ", "=", " ", 
       RowBox[{"RotationMatrix", "[", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"2", " ", "\[Pi]"}]}], "}"}], "]"}], ",", " ", 
         RowBox[{"RandomPoint", "[", 
          RowBox[{"Sphere", "[", "]"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"QuantumDistance", "[", 
           RowBox[{"##", ",", " ", "\"\<Fidelity\>\""}], "]"}]}], " ", "&"}], 
        " ", "@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumState", "[", 
            RowBox[{"\"\<BlochVector\>\"", "[", 
             RowBox[{"rot", " ", ".", " ", "#"}], "]"}], "]"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"uhlPair", "[", 
           RowBox[{"l1", ",", " ", "l2", ",", " ", "\[Theta]"}], "]"}]}], 
         ")"}]}], ")"}], "^", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uhlPanel", "[", "l1_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"uhlFormula", " ", "@@", " ", 
           RowBox[{"uhlPair", "[", 
            RowBox[{"l1", ",", " ", "#", ",", " ", "\[Theta]"}], "]"}]}], " ",
           "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0.5", ",", " ", "1"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "\[Pi]"}], "}"}], ",", 
       " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<r\>\"", ",", " ", "2"}], "]"}], ",", 
              " ", "\"\< = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0.5", ",", " ", "1"}], "}"}]}], ")"}]}], ",",
        " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "Automatic", ",", " ", "Dashed"}], 
         "}"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Theta]", ",", " ", 
               RowBox[{"uhlRandom", "[", 
                RowBox[{"l1", ",", " ", "#", ",", " ", "\[Theta]"}], "]"}]}], 
              "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
              "\[Theta]", ",", " ", "0", ",", " ", "\[Pi]", ",", " ", 
               RowBox[{"\[Pi]", "/", "8"}]}], "}"}]}], "]"}], " ", "&"}], " ",
           "/@", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0.5", ",", " ", "1"}], "}"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "14"}], "}"}]}]}], 
        "]"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "\[Pi]"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<angle \[Theta] between the Bloch vectors\>\"", ",", 
        " ", "\"\<F\>\""}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "x"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "0", ",", " ", "\[Pi]", ",", " ", 
              RowBox[{"\[Pi]", "/", "4"}]}], "}"}]}], "]"}], ",", " ", 
          "None"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<r\>\"", ",", " ", "1"}], "]"}], ",", " ", "\"\< = \>\"",
          ",", " ", "l1"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uhlPanels", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{"uhlPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.9", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
