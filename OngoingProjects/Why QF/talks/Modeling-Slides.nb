        RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"catalystNielsen", " ", "=", " ", 
   RowBox[{"schmidtNielsen", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"3", "/", "5"}], ",", " ", 
      RowBox[{"2", "/", "5"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pairsNielsen", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "/", "5"}], ",", " ", 
           RowBox[{"2", "/", "5"}], ",", " ", 
           RowBox[{"1", "/", "10"}], ",", " ", 
           RowBox[{"1", "/", "10"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", 
           RowBox[{"1", "/", "4"}], ",", " ", 
           RowBox[{"1", "/", "4"}], ",", " ", "0"}], "}"}]}], "}"}]}], "}"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"schmidtNielsen", " ", "/@", " ", "w"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{
           RowBox[{"schmidtNielsen", "[", "#", "]"}], ",", " ", 
           "catalystNielsen"}], "]"}], " ", "&"}], " ", "/@", " ", "w"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelNielsen", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s1_", ",", " ", "s2_"}], "}"}], ",", " ", "title_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w1", " ", "=", " ", 
        RowBox[{"aliceNielsen", "[", "s1", "]"}]}], ",", " ", 
       RowBox[{"w2", " ", "=", " ", 
        RowBox[{"aliceNielsen", "[", "s2", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"w1", ",", " ", "0"}], "]"}], "]"}], ",", " ", 
         RowBox[{"Accumulate", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{"w2", ",", " ", "0"}], "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Length", "[", "w1", "]"}]}], "}"}]}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "9"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.02"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"Length", "[", "w1", "]"}]}], "]"}], ",", " ", "None"}],
            "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<k\>\"", ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Sum]\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              
              RowBox[{"\"\<\[Lambda]\>\"", ",", 
               " ", "\"\<i \[LessEqual] k\>\""}], "]"}]}], "}"}], "]"}]}], 
         "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Psi]\>\"", ",", " ", "\"\<\[Phi]\>\""}], "}"}]}], ",",
        "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"title", ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<\[Psi] \[RightArrow] \[Phi]: \>\"", ",", " ", 
                 RowBox[{"majorizedNielsen", "[", 
                  RowBox[{"w1", ",", " ", "w2"}], "]"}], ",", 
                 " ", "\"\<,   \[Phi] \[RightArrow] \[Psi]: \>\"", ",", " ", 
                 RowBox[{"majorizedNielsen", "[", 
                  RowBox[{"w2", ",", " ", "w1"}], "]"}]}], "}"}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", 
          " ", "13", ",", " ", 
          RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
         "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsNielsen", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{"panelNielsen", ",", " ", 
     RowBox[{"{", 
      RowBox[{"pairsNielsen", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<ququart pairs\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<ququart pairs with \>\"", ",", 
            " ", "\"\<\[Chi]\>\""}], "}"}], "]"}]}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"regionNielsen", ",", " ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"First", " ", "/@", " ", "panelsNielsen"}], "]"}], ",", " ", 
       RowBox[{"legendBelow", "[", 
        RowBox[{"Last", "[", 
         RowBox[{"First", "[", "panelsNielsen", "]"}], "]"}], "]"}]}], 
      "]"}]}], "}"}], "}"}], "]"}]}], "Input",
 CellLabel->"In[122]:= ",
 CellID->878364011,ExpressionUUID->"53ed6e24-b288-8d3e-1b8a-aca7493c6d9e"],

Cell[TextData[{
 "Inside the dashed triangle of ordered qutrit weights, every target in the \
right-hand region, ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee64427-290e-55f2-5373-38abaff87184"],
 " among them, is reachable from ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25ac1210-6931-5c8a-6500-82e00eefba63"],
 ", the targets in the left-hand region reach ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c625fa0-2233-0b34-6277-d642ecf48271"],
 ", and the rest are incomparable: LOCC can only make the weights steeper. \
The ququart curves cross, so neither state converts to the other, yet with ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c1ed8c5-d6e3-2ff2-5abf-fc795348dc49"],
 " borrowed the crossing disappears and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["\[Chi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ea01108-7323-dea1-149a-2bfadd61454d"],
 " converts to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Phi]", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["\[Chi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a096b30-0b40-3860-6495-f121c1b8c63f"],
 ", which hands ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00f5c31f-fe18-20b4-5610-a41fc73c183b"],
 " back unchanged."
}], "Text",
 CellID->778483716,ExpressionUUID->"6a7db6b8-5800-b621-7b67-ed74b527596c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1365990518,ExpressionUUID->"12d64a3c-92bd-ed72-3d40-f7196de0cf5b"],

Cell["The Holevo bound on accessible information", "Subsection",
 CellID->1264890204,ExpressionUUID->"1f1c4243-826d-6dc0-4bf2-d7877d76106d"],

Cell[TextData[{
 "A sender picks ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["X", "TI"], "\[Element]", "{", "1"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00253a9b-7b33-b651-62c5-8d26667f8dc4"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], "=", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9e765e-d98a-a7fa-3d1b-14f849dd2b11"],
 " and sends a qubit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["X", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6840017e-6060-c67a-60c7-c9623c68e4cd"],
 " whose Bloch vector ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], 
   StyleBox["X", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "729e998e-e3bc-acbc-7e5b-92e3b35e9684"],
 " has length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "765904e9-3a0b-f30e-6c42-933e94a64178"],
 "; ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74f9b7b9-336c-ffa6-60f8-ab745a419959"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4ffbd5-0e07-2ef4-3d29-948d0d5f1593"],
 " are ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3176083c-398c-5f93-0cfd-4013ea44b261"],
 " apart. The receiver measures and gets an outcome ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "340e2a51-8264-de55-4f79-4ed5db6d1114"],
 ". How much of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "412681d2-118a-4e22-371b-0e87842e82f0"],
 " can a measurement recover?"
}], "Text",
 CellID->1500073089,ExpressionUUID->"2a0beace-5b31-2934-642e-6b9f562cd77a"],

Cell[TextData[{
 "The recovered information is the mutual information ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], ":", 
    StyleBox["Y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Y", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   UnderscriptBox["\[Sum]", 
    StyleBox["x", "TI"],
    LimitsPositioning->False], 
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["Y", "TI"], 
    StyleBox["|",
     SpanMaxSize->1], 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c2643fb-b2b9-60d3-63e4-562a1d8b9f79"],
 ", in bits. Holevo's theorem bounds it for every measurement by"
}], "Text",
 CellID->1709476398,ExpressionUUID->"2a753659-eb3e-8e70-235c-db877f43635b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Chi]", "TI"], "=", 
    StyleBox["S", "TI"], "(", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["x", "TI"],
      LimitsPositioning->False], 
     StyleBox["P", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox["x", "TI"]]}], ")", "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["x", "TI"],
     LimitsPositioning->False], 
    StyleBox["P", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["S", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["x", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThickSpace]", "\[GreaterEqual]", "\[ThickSpace]", 
    StyleBox["I", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["X", "TI"], ":", 
     StyleBox["Y", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1821066458,ExpressionUUID->"6b419cc3-5dd8-9d19-37ff-29068e5582b1"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7110474c-e002-9671-7df1-3c42e18dd561"],
 " the von Neumann entropy. A projective measurement along a unit vector ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f53db7c-3b9f-9865-1a80-828e110ca37c"],
 " returns ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ef11046-d768-eb6f-22af-b67d3f49b38a"],
 " with probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[PlusMinus]", 
    StyleBox["|",
     SpanMaxSize->1], 
    StyleBox["x", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["r", "TI"], "\[RightVector]"], 
     StyleBox["x", "TI"]], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141410ec-274a-aa3d-135c-17e7b9384ee7"],
 "."
}], "Text",
 CellID->1786093766,ExpressionUUID->"51fc8a1a-e481-7225-5d26-fc54e9c4e08c"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f437d43-ecb5-f55d-6320-d586c51b4fc8"],
 " (dashed) comes from the entropies of the two states and of their mixture, \
and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], ":", 
    StyleBox["Y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647efd9e-4780-e81e-1bdc-e5a6f7ab973a"],
 " (solid) is plotted for ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ee62e0f-539a-c5e4-6d76-71b3cad07afa"],
 " in the plane of the two Bloch vectors, at angle ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bcbe8b8-64e4-23df-2a3b-b9193430da8e"],
 " from ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["r", "TI"], "\[RightVector]"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f18fe52-b072-979d-4d22-b96708f6ffc1"],
 ":"
}], "Text",
 CellID->1780167450,ExpressionUUID->"29a2f2c8-7077-daff-638b-802a9d18d884"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"blochHolevo", "[", 
    RowBox[{"r_", ",", " ", "\[Theta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<BlochVector\>\"", "[", 
       RowBox[{"N", "[", "#", "]"}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "r"}], "}"}], ",", " ", 
      RowBox[{"r", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chiHolevo", "[", 
    RowBox[{"pr_", ",", " ", "qs_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantityMagnitude", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pr", ",", " ", 
          RowBox[{"1", " ", "-", " ", "pr"}]}], "}"}], " ", "qs"}], "]"}], 
      "[", "\"\<VonNeumannEntropy\>\"", "]"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pr", ",", " ", 
        RowBox[{"1", " ", "-", " ", "pr"}]}], "}"}], " ", ".", " ", 
      RowBox[{"Through", "[", 
       RowBox[{"qs", "[", "\"\<VonNeumannEntropy\>\"", "]"}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h2Holevo", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "x"}], " ", 
       RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
       RowBox[{"Log2", "[", 
        RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", "0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"infoHolevo", "[", 
    RowBox[{
    "pr_", ",", " ", "r_", ",", " ", "\[Theta]_", ",", " ", "\[CurlyPhi]_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"plus", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"r", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "\[Theta]"}], "}"}], " ", "-", " ", 
             "\[CurlyPhi]"}], "]"}]}]}], ")"}], "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"h2Holevo", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pr", ",", " ", 
          RowBox[{"1", " ", "-", " ", "pr"}]}], "}"}], " ", ".", " ", 
        "plus"}], "]"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pr", ",", " ", 
         RowBox[{"1", " ", "-", " ", "pr"}]}], "}"}], " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{"h2Holevo", " ", "/@", " ", "plus"}], ")"}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Theta]sHolevo", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pi", "/", "4"}], ",", " ", 
     RowBox[{"Pi", "/", "2"}], ",", " ", 
     RowBox[{"3", " ", 
      RowBox[{"Pi", "/", "4"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelHolevo", "[", 
    RowBox[{"r_", ",", " ", "pr_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"infoHolevo", "[", 
           RowBox[{
           "pr", ",", " ", "r", ",", " ", "#", ",", " ", "\[CurlyPhi]"}], 
           "]"}], " ", "&"}], " ", "/@", " ", "\[Theta]sHolevo"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", 
       " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "#"}], "}"}], "]"}], 
           " ", "&"}], " ", "/@", " ", "\[Theta]sHolevo"}], ")"}]}]}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"chiHolevo", "[", 
           RowBox[{
            RowBox[{"N", "[", "pr", "]"}], ",", " ", 
            RowBox[{"blochHolevo", "[", 
             RowBox[{"r", ",", " ", "#"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
          " ", "\[Theta]sHolevo"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", 
       " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "All"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Phi]\>\"", ",", " ", "\"\<bits\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "260"}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"Pi", "/", "4"}], ",", " ", 
            RowBox[{"Pi", "/", "2"}], ",", " ", 
            RowBox[{"3", " ", 
             RowBox[{"Pi", "/", "4"}]}], ",", " ", "Pi"}], "}"}], ",", " ", 
          "None"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<r = \>\"", ",", " ", "r", ",", " ", "\"\<,   p = \>\"",
            ",", " ", "pr"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
        RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsHolevo", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"panelHolevo", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{"3", "/", "4"}], ",", " ", 
       RowBox[{"9", "/", "10"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"First", ",", " ", "panelsHolevo", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"panelsHolevo", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[123]:= ",
 CellID->880973186,ExpressionUUID->"257cfaa0-1f1f-6083-133c-4b1ec4f0e255"],

Cell[TextData[{
 "In every panel each solid curve stays below its dashed ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01bd0103-aa30-0306-0576-ea458fccaccc"],
 " for every direction ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cefe4ae-825a-9396-2ac1-3b56f0dfcae9"],
 ", and falls to zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", 
   StyleBox["\[Theta]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "775d369a-fef1-ea93-3497-97363bc10ab2"],
 ", where both states give the same outcome probabilities. For pure states \
the best direction stays well below ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c6077c4-2b8b-7e07-00dd-08334627e94e"],
 "; at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3663720b-3644-ae4c-7010-34db94ce02b1"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d5477a0-e1cd-28f5-72d7-3adc5a487901"],
 " itself is lower and the best direction comes close to it."
}], "Text",
 CellID->631937412,ExpressionUUID->"4164ba8e-5ed9-9cf9-1465-76cb16be6d5e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->879449704,ExpressionUUID->"17bfa9ef-1fc9-a221-1f52-2ad1806d5bda"],

Cell["Classical and quantum capacity of a noisy qubit channel", "Subsection",
 CellID->1369173580,ExpressionUUID->"0ce9c40e-1652-56b2-0a9d-344c57595103"],

Cell[TextData[{
 "A qubit crosses a dephasing channel or a depolarizing channel at noise \
strength ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58103e0a-f67f-49f6-5559-27f75d35a5b9"],
 ". A classical sender encodes one bit with equal priors in the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6abab2e5-af8b-ecec-418a-97a0344a0e4f"],
 " basis ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], ",", 
    TemplateBox[{"1"},
     "Ket"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26331a60-b619-2fe2-6518-31d18dd226bf"],
 " or the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cced730-adc9-8d3e-0324-e62e2ceec0c4"],
 " basis ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{"+"},
     "Ket"], ",", 
    TemplateBox[{"-"},
     "Ket"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b671c27-ab68-fad8-33b8-824baf996d1a"],
 "; a quantum sender keeps a reference ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fff6fbf-3eea-5064-7ff8-ecfb57feea77"],
 " entangled with the input. How many bits per use does each sender get \
across?"
}], "Text",
 CellID->415695091,ExpressionUUID->"78a0c419-f240-13b0-6feb-c629c7be03be"],

Cell[TextData[{
 "With Pauli matrices ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70a75911-ced1-c288-69b7-42895f27d5dd"],
 " the two channels are"
}], "Text",
 CellID->755208663,ExpressionUUID->"1e1d3936-e1f0-d7ec-5029-1048811d3329"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\|01d4a9", 
     StyleBox[
      RowBox[{"d", "e", "p", "h"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["p", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox["Z", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox["\|01d4a9", 
      StyleBox[
       RowBox[{"d", "e", "p"}], "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Rho]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", 
          StyleBox["p", "TI"]}], "4"]}], ")"}], 
      StyleBox["\[Rho]", "TI"]}], "+", 
     RowBox[{
      FractionBox[
       StyleBox["p", "TI"], "4"], "\[ThinSpace]", 
      RowBox[{
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["X", "TI"], 
         StyleBox["\[Rho]", "TI"], 
         StyleBox["X", "TI"], "+", 
         StyleBox["Y", "TI"], 
         StyleBox["\[Rho]", "TI"], 
         StyleBox["Y", "TI"], "+", 
         StyleBox["Z", "TI"], 
         StyleBox["\[Rho]", "TI"], 
         StyleBox["Z", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->344532710,ExpressionUUID->"28371661-8c9f-b480-436e-5141cbbf3938"],

Cell[TextData[{
 "A pair of input states ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "1"]}], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63babd97-b29e-f82c-1484-0df63e9dd2a2"],
 " carries at most its Holevo quantity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], "=", 
   StyleBox["S", "TI"], "(", 
   RowBox[{"\|01d4a9", 
    StyleBox["(",
     SpanMaxSize->1], 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], "1"], "+", 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], "2"]}], "2"], 
    StyleBox[")",
     SpanMaxSize->1]}], ")", "-", 
   FractionBox["1", "2"], 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d4a9", 
    StyleBox["(",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "22"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a17c6d4-4ab6-3ff6-19c8-7e57c7aad7b6"],
 " bit. The one-use quantum rate is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "1", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", 
   UnderscriptBox[
    StyleBox["max",
     FontSlant->"Plain"], 
    StyleBox["\[Rho]", "TI"],
    LimitsPositioning->False], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3098579f-43d7-38e9-7940-cbc779e155b8"],
 ", with coherent information ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["c", "TI"]], "=", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["B", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"R", "B"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f88be13-f01b-6728-342f-df169728db62"],
 " for the purified input. For both channels the maximally mixed input ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e2db13b-b1a2-13be-5807-78c8f4742d01"],
 " maximizes ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54ebd1a4-5b5c-1e3e-4bf0-71bb011d1529"],
 " wherever the maximum is positive, and past that point a pure input's ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["c", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64675a16-25cf-cfa7-51e3-02414e05f4ea"],
 " is the maximum, so ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["Q", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "1", 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    SubscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["c", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fdfe1ab-d97d-85f5-4f7a-2b5be19d4cf8"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4308cfcf-4a12-b354-3940-dd1d2c17776d"],
 "; the dephasing channel is degradable, so for it ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["Q", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], "1", 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac4beb0-90fa-a6e7-27ae-9a84b988208f"],
 " is the quantum capacity."
}], "Text",
 CellID->1325985995,ExpressionUUID->"729b7c2c-45fe-d83b-2471-7e7fc2808d4d"],

Cell[TextData[{
 "The channels act, for general ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d8b76c5-de27-af41-3aa8-99597b93ccb6"],
 ", on the code states, their average and the purified ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d81e025-8e8d-e02c-324b-13376ee654e7"],
 "; the entropies come from the closed-form output spectra, in bits:"
}], "Text",
 CellID->1106713991,ExpressionUUID->"53d8039d-5dbc-a83d-1d95-99001e499a04"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"capS", "[", "st_", "]"}], " ", ":=", " ", 
   RowBox[{"-", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"#", " ", ">", " ", "0"}], ",", " ", 
         RowBox[{"#", " ", 
          RowBox[{"Log2", "[", "#", "]"}]}], ",", " ", "0"}], "]"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"st", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], ",",
         " ", 
        RowBox[{"0", " ", "<=", " ", "\[FormalP]", " ", "<=", " ", "1"}]}], 
       "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"capRates", "[", "name_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", " ", "=", " ", 
        RowBox[{"QuantumChannel", "[", 
         RowBox[{
          RowBox[{"name", "[", "\[FormalP]", "]"}], ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], ",", " ", 
       RowBox[{"rb", " ", "=", " ", 
        RowBox[{
         RowBox[{"QuantumState", "[", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}], "]"}], 
         "[", "\"\<Purify\>\"", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"capS", "[", 
            RowBox[{"out", "[", 
             RowBox[{
              RowBox[{"Total", "[", "#", "]"}], "/", "2"}], "]"}], "]"}], " ",
            "-", " ", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"capS", "[", 
                RowBox[{"out", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
              " ", "#"}], "]"}], "/", "2"}]}], ")"}], " ", "&"}], " ", "/@", 
        " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"QuantumState", "[", "#", "]"}], 
            "[", "\"\<MatrixState\>\"", "]"}], " ", "&"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<0\>\"", ",", " ", "\"\<1\>\""}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<+\>\"", ",", " ", "\"\<-\>\""}], "}"}]}], "}"}], ",",
           " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{
          RowBox[{"capS", "[", 
           RowBox[{"QuantumPartialTrace", "[", 
            RowBox[{
             RowBox[{"out", "[", "rb", "]"}], ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], "]"}], " ", "-", " ", 
          RowBox[{"capS", "[", 
           RowBox[{"out", "[", "rb", "]"}], "]"}]}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelCap", "[", 
    RowBox[{"name_", ",", " ", "title_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"capRates", "[", "name", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[FormalP]", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Dashed", ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.4", "]"}], ",", " ", 
          RowBox[{"AbsoluteThickness", "[", "7", "]"}]}], "]"}]}], "}"}]}], ",",
      "\n", "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", " ", "\"\<bits per use\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "320"}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Chi], z basis\>\"", ",", " ", "\"\<\[Chi], x basis\>\"",
         ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<Q\>\"", ",", " ", "\"\<(1)\>\""}], "]"}]}], "}"}]}], ",",
      " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"title", ",", " ", "13", ",", " ", 
        RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsCap", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{"panelCap", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<PhaseFlip\>\"", ",", " ", "\"\<Depolarizing\>\""}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<dephasing\>\"", ",", " ", "\"\<depolarizing\>\""}], 
        "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "panelsCap"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "640"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "panelsCap", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[124]:= ",
 CellID->1166590470,ExpressionUUID->"201fbffd-2966-ded6-55aa-c49963f7f248"],

Cell[TextData[{
 "Dephasing never touches the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e57cec-a1ef-f6d8-39d4-9b7894bee4fb"],
 "-basis states, which reach the one-bit ceiling at every ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2500607b-c7db-984f-03e2-d0a6404dac17"],
 ", while the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277c2261-49f6-d228-29c1-fad6c0a4c959"],
 "-basis states and the quantum rate fall together to zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39afbf07-be40-8ee7-55e1-e730370b0519"],
 ": there a full classical bit crosses a channel that carries no quantum \
information. The depolarizing channel treats both bases alike, and its ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["Q", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], "1", 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d588caa-156f-9821-4d8e-bc3be98dc4fb"],
 " hits zero at a noise level where classical bits still get through. That \
curve is a one-use rate, so for this channel it is only a lower bound on the \
quantum capacity."
}], "Text",
 CellID->1889524720,ExpressionUUID->"3b95f8ae-b3b6-700b-20e0-ffe3ecf81a93"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->97473707,ExpressionUUID->"02b07597-950c-47bd-4846-dbc4ee80f486"],

Cell["\<\
Bell-CHSH violation and the Tsirelson bound for a family of states\
\>", "Subsection",
 CellID->1930545411,ExpressionUUID->"3bbfa452-1172-4d8d-7e2a-c98da1711dac"],

Cell[TextData[{
 "Two qubits share ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["p", "TI"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Theta]", "TI"]]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Theta]", "TI"]]},
      "Bra"]}], "+", 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{
      StyleBox["I", "TI"], "/", "4"}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71dd1d0f-5156-7fe8-1e9f-bbf61eb9072e"],
 ", a partly entangled pure state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["\[Theta]", "TI"]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     StyleBox["\[Theta]", "TI"], 
     TemplateBox[{"00"},
      "Ket"]}], "+", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], 
     StyleBox["\[Theta]", "TI"], 
     TemplateBox[{"11"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31bd000b-ac4d-36f5-7057-8c797158fed3"],
 " mixed with white noise. Alice measures ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
   OverscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ace4f0-9ffd-d44d-41f3-446d8107ad12"],
 " or ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "\[RightVector]"], "2"], "\[CenterDot]", 
   OverscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14c8dbd2-a89e-51cd-46b0-164fdd5b07e9"],
 ", Bob ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
   OverscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67bbcf80-7628-ed5e-3bdf-45c7b033063a"],
 " or ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], "2"], "\[CenterDot]", 
   OverscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ed887f7-483a-9b38-6f58-7262ec54d5ab"],
 ", all with outcomes ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da91020-0138-a17a-2f6d-19314917d2dc"],
 ". For which ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37aff359-320a-dfdb-3a8c-b07da1d65f19"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f6272e9-70cb-ac6d-659a-5a4a023a545c"],
 " can the correlations violate the CHSH inequality?"
}], "Text",
 CellID->1668303208,ExpressionUUID->"59d5b57f-824f-3a20-38e9-599c43a31935"],

Cell[TextData[{
 "Local models obey the CHSH inequality ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], "\[ScriptCapitalB]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f3aed44-7e47-ff0b-4b77-9a3cb3b9bf57"],
 " for"
}], "Text",
 CellID->777735929,ExpressionUUID->"6905ef2f-bb8f-673e-51b9-ca116a9bdbbd"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalB]", "=", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], "1"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"], "\[CircleTimes]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "\[RightVector]"], "1"], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "\[RightVector]"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], "2"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"], "\[CircleTimes]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "\[RightVector]"], "1"], "-", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "\[RightVector]"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1969964931,ExpressionUUID->"3a99be02-cb42-b350-76d9-f10ea5e6cc5f"],

Cell[TextData[{
 "while quantum states reach at most ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14df2a49-89da-dc9e-10ea-c215f655b83d"],
 " (Tsirelson). With the correlation matrix ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["i", "TI"]], "\[CircleTimes]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ed370c1-b707-a690-49b6-588b38382f48"],
 ", the Horodecki theorem gives the best value over all settings, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], "\[ScriptCapitalB]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "2", 
   SqrtBox[
    RowBox[{
     SubscriptBox[
      StyleBox["t", "TI"], "1"], "+", 
     SubscriptBox[
      StyleBox["t", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34923fb2-779d-5898-1144-61ad32ecfa76"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c9506fd-e56e-c6c8-0d48-3cedb29916ef"],
 " are the two largest eigenvalues of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["T",
     FontFamily->"Helvetica",
     FontSlant->"Plain"]], 
   StyleBox["T", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0221cab9-8d92-997d-06e1-fac15c7267bc"],
 ". For two qubits ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "467677f0-de74-0d77-1ff2-58bfdd5e88e3"],
 " is entangled exactly when its partial transpose has a negative eigenvalue \
(Peres-Horodecki)."
}], "Text",
 CellID->1722985548,ExpressionUUID->"62f5b966-30ad-09c7-172a-584ae4c1f386"],

Cell[TextData[{
 "For general ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28309594-900e-9dba-1c87-a9f7b633eea1"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5018fd57-f306-9621-0934-1a80479b4d0d"],
 " the optimal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], "\[ScriptCapitalB]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56091ab4-92a4-e9d1-2038-705a0c4fc4ae"],
 " is in closed form; the figure maps, over every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7016c6fa-0a3d-2de4-6a8b-80723334ac5a"],
 ", where the partial transpose has a negative eigenvalue, where the optimal \
settings violate CHSH, and where the settings optimal for a Bell state (",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "\[RightVector]"], 
     RowBox[{"1", ",", "2"}]], "=", 
    OverscriptBox[
     StyleBox["z", "TI"], "^"]}], ",", 
   OverscriptBox[
    StyleBox["x", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "706889b2-033a-7078-1919-1c2e4771b66e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], 
    RowBox[{"1", ",", "2"}]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["z", "TI"], "^"], "\[PlusMinus]", 
    OverscriptBox[
     StyleBox["x", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13a665b3-1b56-e975-383f-d7d49b865f6b"],
 ") do:"
}], "Text",
 CellID->1954587557,ExpressionUUID->"2d4fb204-b8ef-115d-6897-6e557dd44369"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rhoCHSH", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[FormalP]", " ", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "\[FormalTheta]", "]"}], ",", " ", "0", ",", 
          " ", "0", ",", " ", 
          RowBox[{"Sin", "[", "\[FormalTheta]", "]"}]}], "}"}], ",", " ", 
        "2"}], "]"}], "[", "\"\<MatrixState\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "\[FormalP]"}], ")"}], " ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"corrCHSH", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{"rhoCHSH", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", 
         ".", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "i", "]"}], ",", " ", 
           RowBox[{"PauliMatrix", "[", "j", "]"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"0", " ", "<", " ", "\[FormalTheta]", " ", "<", " ", 
      RowBox[{"Pi", "/", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bestCHSH", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ev", " ", "=", " ", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "corrCHSH", "]"}], " ", ".", " ", 
         "corrCHSH"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"Total", "[", "ev", "]"}], " ", "-", " ", 
          RowBox[{"Min", "[", "ev", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"0", " ", "<", " ", "\[FormalP]", " ", "<=", " ", "1"}], " ", 
        "&&", " ", 
        RowBox[{"0", " ", "<", " ", "\[FormalTheta]", " ", "<", " ", 
         RowBox[{"Pi", "/", "2"}]}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bellCHSH", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "2", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"corrCHSH", "[", 
       RowBox[{"[", 
        RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], " ", "+", " ", 
      RowBox[{"corrCHSH", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ptCHSH", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumPartialTranspose", "[", 
       RowBox[{"rhoCHSH", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<Eigenvalues\>\"", "]"}], ",",
      " ", 
     RowBox[{"0", " ", "<", " ", "\[FormalTheta]", " ", "<", " ", 
      RowBox[{"Pi", "/", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"RegionPlot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", "ptCHSH", "]"}], " ", "<", " ", "0"}], ",", " ", 
      RowBox[{"bestCHSH", " ", ">", " ", "2"}], ",", " ", 
      RowBox[{"bellCHSH", " ", ">", " ", "2"}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[FormalTheta]", ",", " ", "0", ",", " ", 
     RowBox[{"Pi", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[FormalP]", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"PlotPoints", " ", "->", " ", "50"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<entangled (negative partial transpose)\>\"", ",", 
      " ", "\"\<violates CHSH, best settings\>\"", ",", 
      " ", "\"\<violates CHSH, Bell-state settings\>\""}], "}"}]}], ",", "\n",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Pi", "/", "2"}], ",", " ", 
          RowBox[{"Pi", "/", "8"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", "\n", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<max\[LeftAngleBracket]\[ScriptCapitalB]\
\[RightAngleBracket] = \>\"", ",", " ", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"bestCHSH", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[FormalP]", " ", "->", " ", "p"}], ",", " ", 
             RowBox[{"\[FormalTheta]", " ", "->", " ", "\[Theta]"}]}], 
            "}"}]}], "]"}]}], "}"}], "]"}], ",", " ", "13", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[125]:= ",
 CellID->1860260427,ExpressionUUID->"5665241f-3965-69c6-7941-9030b6737379"],

Cell[TextData[{
 "Every violating state is entangled, but below the violating region lies a \
band of entangled states that no CHSH settings detect, and as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b8c004e-aaf9-ac84-4f7c-46b8d18b833e"],
 " it fills almost all of the entangled region. The optimal value reaches the \
Tsirelson value ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d9be94d-b49a-953b-7b2b-84124a27eb36"],
 " only for the Bell state at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b4ad91a-daff-f800-2091-ae02ff272c29"],
 ". The Bell-state settings find only part of the violating region once ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "\[NotEqual]", "\[Pi]", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c0dd639-9299-1f04-3744-19043d4a5d20"],
 "."
}], "Text",
 CellID->813578764,ExpressionUUID->"2a714647-2055-0b47-355d-d9e47e030fa3"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->984849303,ExpressionUUID->"64a5adc6-5b84-eb25-0184-2d07e728d02a"],

Cell["A qutrit beats every noncontextual model", "Subsection",
 CellID->1194714241,ExpressionUUID->"2c3b1d08-2c7b-1606-61f6-3191b2f00a1c"],

Cell[TextData[{
 "Five projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox["k", "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["k", "TI"]]},
     "Ket"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["k", "TI"]]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f335e10-80ed-5407-2ae7-d094bfe1e5f0"],
 " on a qutrit form a pentagon: each can be measured jointly with its two \
neighbors, and no two neighbors both answer yes. If every test had a \
predetermined answer, whatever it is measured with, then ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox["k", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[LessEqual]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd159fd-9ba5-e933-618e-c70417400322"],
 " (Klyachko, Can, Binicio\:011flu and Shumovsky); the qutrit is in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["p", "TI"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Alpha]", "TI"]]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["\[Psi]", "TI"], 
        StyleBox["\[Alpha]", "TI"]]},
      "Bra"]}], "+", 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"\|01d7d9", "/", "3"}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d45178-babf-01bd-76f7-ebdd8d36fcf0"],
 ", a pure state tilted by ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5557e375-07b2-d5b3-46cd-990c22ab9aec"],
 " from ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4324cb63-a02c-85a5-6ff7-78da85863f9f"],
 " mixed with white noise. Which of these states break the bound?"
}], "Text",
 CellID->2082634716,ExpressionUUID->"063559c5-8402-aad1-7a01-edee4d31ad9a"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", 
   TemplateBox[{"1"},
    "Ket"], ",", 
   TemplateBox[{"2"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60659b5f-6405-2d85-1689-f7b1c7e40d7e"],
 " as the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ",", 
   StyleBox["y", "TI"], ",", 
   StyleBox["z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43491631-736c-362d-42fe-8be549a1d45c"],
 " axes of a real space, the five rays sit on a cone around ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "671aaabf-c9f5-a1d7-03d4-4a066cd962cd"],
 ", one turned from the next by ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]", "/", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a366465-dd20-76c2-2e02-0f007dd38b1f"],
 ":"
}], "Text",
 CellID->1791805122,ExpressionUUID->"74f2d8b8-c337-20cb-3657-17bb32c8a3d9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["k", "TI"]], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox["z", "TI"]], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{"4", "\[Pi]", 
        StyleBox["k", "TI"]}], "5"], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        StyleBox["sin",
         FontSlant->"Plain"], "\[CurlyTheta]"}], ",", "0", ",", 
       RowBox[{
        StyleBox["cos",
         FontSlant->"Plain"], "\[CurlyTheta]"}]}], ")"}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["cos",
       FontSlant->"Plain"], "2"], "\[CurlyTheta]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SqrtBox["5"]], "\[DoubleLongLeftRightArrow]", 
       SubscriptBox[
        StyleBox["v", "TI"], 
        StyleBox["k", "TI"]]}], "\[CenterDot]", 
      SubscriptBox[
       StyleBox["v", "TI"], 
       RowBox[{
        StyleBox["k", "TI"], "+", "1"}]]}], "=", "0"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["\[Alpha]", "TI"]]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], 
      StyleBox["\[Alpha]", "TI"], 
      TemplateBox[{"0"},
       "Ket"]}], "+", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      StyleBox["\[Alpha]", "TI"], 
      RowBox[{
       TemplateBox[{"2"},
        "Ket"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1417549333,ExpressionUUID->"56bdb3ff-72cd-5e79-6e58-9f1eaca14f8f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["K", "TI"], "^"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30facdd7-d40d-927a-4d9e-34c6ed077c9e"],
 " and neighboring rays checked orthogonal, the figure maps where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["K", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"], 
   OverscriptBox[
    StyleBox["K", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a489993-b0fa-a3b9-6a42-9975d51667ba"],
 " exceeds the noncontextual bound over every tilt and noise weight:"
}], "Text",
 CellID->1140850858,ExpressionUUID->"7261c77e-a63f-058b-6ba7-e7cd585dadc3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kcbsRays", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RotationMatrix", "[", 
       RowBox[{
        RowBox[{"4", " ", "Pi", " ", 
         RowBox[{"k", "/", "5"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", ".",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"1", "/", 
           RowBox[{"Sqrt", "[", "5", "]"}]}]}], "]"}], ",", " ", "0", ",", 
        " ", 
        RowBox[{"5", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "4"}], ")"}]}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kcbsExclusiveQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"MapThread", "[", 
      RowBox[{"Dot", ",", " ", 
       RowBox[{"{", 
        RowBox[{"kcbsRays", ",", " ", 
         RowBox[{"RotateLeft", "[", "kcbsRays", "]"}]}], "}"}]}], "]"}], 
     "]"}], " ", "===", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", " ", "5"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kcbsK", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"#", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     "kcbsRays"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kcbsMean", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Tr", "[", 
     RowBox[{"kcbsK", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[FormalP]", " ", 
           RowBox[{"Outer", "[", 
            RowBox[{"Times", ",", " ", "#", ",", " ", "#"}], "]"}]}], " ", 
          "&"}], "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", "\[FormalAlpha]", "]"}], ",", " ", "0", ",", 
           " ", 
           RowBox[{"Cos", "[", "\[FormalAlpha]", "]"}]}], "}"}], "]"}], " ", "+",
         " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "\[FormalP]"}], ")"}], " ", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "3", "]"}], "/", "3"}]}]}], ")"}]}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"RegionPlot", "[", 
  RowBox[{
   RowBox[{"kcbsMean", " ", ">", " ", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[FormalAlpha]", ",", " ", "0", ",", " ", 
     RowBox[{"Pi", "/", "2"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[FormalP]", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"PlotPoints", " ", "->", " ", "50"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Alpha]\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Pi", "/", "2"}], ",", " ", 
          RowBox[{"Pi", "/", "8"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Row", "[", 
      RowBox[{
      "{", "\"\<\[LeftAngleBracket]K\[RightAngleBracket] > 2\>\"", "}"}], 
      "]"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<neighbors orthogonal: \>\"", ",", " ", 
             "kcbsExclusiveQ"}], "}"}], "]"}], ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[LeftAngleBracket]K\[RightAngleBracket] = \>\"", ",",
              " ", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"kcbsMean", " ", "/.", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[FormalP]", " ", "->", " ", "p"}], ",", " ", 
                 RowBox[{"\[FormalAlpha]", " ", "->", " ", "\[Alpha]"}]}], 
                "}"}]}], "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", " ", 
      "13", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[126]:= ",
 CellID->781570005,ExpressionUUID->"1bf3c33a-2647-08b7-2233-822de51f5eee"],

Cell[TextData[{
 "Only states close to the cone axis, with little noise, break the bound; the \
axis state tolerates the most noise, and tilting or mixing pulls ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["K", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c1f9859-791d-9e3b-3854-d80e1ff9bfb9"],
 " down. A state tilted far enough toward the plane perpendicular to the axis \
stays below 2 even when pure."
}], "Text",
 CellID->1157733043,ExpressionUUID->"1b7c5bef-883a-0d6e-5cf0-bdfc8b2a20da"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2014141554,ExpressionUUID->"718043c0-52b8-2ce6-64cf-dcf84ddd7c92"],

Cell["\<\
Qutrit magic in the discrete Wigner function: Clifford gates only move it\
\>", "Subsection",
 CellID->607554314,ExpressionUUID->"5bc2cf1f-cda2-62e7-297e-22cd0b6c9f9d"],

Cell[TextData[{
 "A qutrit state maps to a quasi-probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["q", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "720148d2-1e08-dfd0-4c67-a9fb4aa6cca1"],
 " on the nine points of a ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74322080-07ad-f667-0337-0bd85e129460"],
 " phase space. For odd dimension a pure state has ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14221e41-1a68-da40-0c1f-7311cd598b42"],
 " exactly when it is a stabilizer state (Gross), so the sum-negativity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sn",
    FontSlant->"Plain"], "=", 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["W", "TI"], "<", "0"}],
    LimitsPositioning->False], GridBox[{
     {
      StyleBox["W", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e71638d-b9b3-3924-31d8-dd87835780ab"],
 " measures magic. Starting from the stabilizer state ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa0123d-5b41-48cd-41f6-db2f5c3b8f81"],
 " and from ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"1"},
      "Ket"], "-", 
     TemplateBox[{"2"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62396166-3de3-061d-627e-b3d3d7da1f86"],
 ", which of the Clifford gates ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0478d9e3-53b9-6866-6c82-33fefb7c25e6"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"X", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "088c16bf-46d4-5f1a-6a78-5d417d1f65c8"],
 " and the non-Clifford gate ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c59853a-821e-f928-5fe1-0a85eaba94ae"],
 " changes the negativity?"
}], "Text",
 CellID->1796000993,ExpressionUUID->"4d09df93-7575-e8aa-0c98-641b353819d4"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"2", "\[Pi]", 
     StyleBox["i", "TI"], "/", "3"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
