  "6e5f148d-142a-1c87-2fed-83741d372738"],
 ", is"
}], "Text",
 CellID->1180044206,ExpressionUUID->"1996ec9a-a45d-c0b1-6f7d-ecf577ffd9ba"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["C", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"2", "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], 
         StyleBox["A", "TI"]], "+", 
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], 
         StyleBox["B", "TI"]]}], 
       StyleBox[")",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], "/", "2"}]], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
     StyleBox["max",
      FontSlant->"Plain"], "\[ThinSpace]", 
     RowBox[{"(", 
      RowBox[{"0", ",", " ", 
       RowBox[{
        RowBox[{
         StyleBox["cos",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["\[Theta]", "TI"]}], "-", 
        RowBox[{
         StyleBox["sin",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["\[Theta]", "TI"], 
         SqrtBox[
          RowBox[{
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{"-", 
              SubscriptBox[
               StyleBox["\[Gamma]", "TI"], 
               StyleBox["A", "TI"]], 
              StyleBox["t", "TI"]}]]}], 
           StyleBox[")",
            SpanMaxSize->1], 
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{"-", 
              SubscriptBox[
               StyleBox["\[Gamma]", "TI"], 
               StyleBox["B", "TI"]], 
              StyleBox["t", "TI"]}]]}], 
           StyleBox[")",
            SpanMaxSize->1]}]]}]}]}], ")"}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->378596892,ExpressionUUID->"02d9412e-128c-3f57-4f36-b6ff82a4b653"],

Cell[TextData[{
 "and the curves plot it, with a dot where a curve reaches zero; time is in \
units of ",
 Cell[BoxData[
