 CellID->25958871,ExpressionUUID->"6af9e95a-6ef4-bc19-08e5-f2ea694e5b9e"],

Cell[TextData[{
 "which reaches zero once the cat has become the mixture; the cross term \
alone would not, because its trace ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65c0e04e-1e41-0455-1f3b-df910e0b1bd4"],
 " is conserved."
}], "Text",
 CellID->1462357393,ExpressionUUID->"2e8a4f29-7908-26c3-5974-4084b8384e27"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      StyleBox["\[Rho]", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34dc2e9d-3dbb-7267-40c8-42f55a36ca80"],
 " term damps ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["x", "TI"]},
    "Bra"], 
   StyleBox["C", "TI"], 
   TemplateBox[{
     SuperscriptBox[
      StyleBox["x", "TI"], "\[Prime]"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dfdb8fe-02d1-611a-0a48-8dbee1a7050e"],
 " at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["M", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], "-", 
      SuperscriptBox[
       StyleBox["x", "TI"], "\[Prime]"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b10fb60-aa16-9aad-2741-35a8030e4184"],
 "; the lobes sit ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CapitalOmega]", 
   StyleBox["t", "TI"], "/", 
   SqrtBox[
    RowBox[{
     StyleBox["M", "TI"], "\[CapitalOmega]"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a48a6c5-00a6-6da2-7700-c34e540a1da5"],
 " apart for ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox[
    RowBox[{"2", 
     StyleBox["M", "TI"], "\[CapitalOmega]"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dc4b4fe-c08a-750b-05a8-ca4e268ddeb6"],
 ", which, for lobes of no width, predicts ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "8", 
     StyleBox["\[Gamma]", "TI"], 
     SubscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["B", "TI"]], 
     StyleBox["T", "TI"], 
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CapitalOmega]", 
      StyleBox["t", "TI"], "+", 
      StyleBox["sin",
       FontSlant->"Plain"], "\[ThinSpace]", "2", "\[CapitalOmega]", 
      StyleBox["t", "TI"], "/", "2"}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "068fe480-ff08-603a-393a-038fe4838292"],
 "."
}], "Text",
 CellID->572246452,ExpressionUUID->"0bdc0995-fdc2-211d-3061-5984219166cf"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5f80c4-a2a2-37d0-09ee-fc47a98954ec"],
 " evolves under the exponential of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b5f68d9-3ad3-da0c-567b-60a3057c6a7c"],
 " on 40 Fock levels of the trap; the prediction is dashed, and units are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", "\[CapitalOmega]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aadbcc9-3a03-d5f3-11f8-c40c0c800df0"],
 ":"
}], "Text",
 CellID->351728041,ExpressionUUID->"55aef23f-b1d2-8392-334c-98d60fa972b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qbmLevels", " ", "=", " ", "40"}], ";", " ", 
  RowBox[{"qbmA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "qbmLevels", "]"}]}], ";", " ", 
  RowBox[{"qbmX", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"qbmA", " ", "+", " ", 
      RowBox[{"SuperDagger", "[", "qbmA", "]"}]}], ")"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";", " ", 
  RowBox[{"qbmP", " ", "=", " ", 
   RowBox[{"I", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SuperDagger", "[", "qbmA", "]"}], " ", "-", " ", "qbmA"}], 
      ")"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qbmStep", "[", 
    RowBox[{"\[Gamma]_", ",", " ", "kT_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"qbmStep", "[", 
     RowBox[{"\[Gamma]", ",", " ", "kT"}], "]"}], " ", "=", " ", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "32"}], " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"Normal", " ", "@", " ", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<Liouvillian\>\"", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"qbmP", " ", "@", " ", "qbmP"}], " ", "+", " ", 
                RowBox[{"qbmX", " ", "@", " ", "qbmX"}]}], ")"}], "/", "2"}], 
             " ", "+", " ", 
             RowBox[{
              RowBox[{"\[Gamma]", "/", "2"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"qbmX", " ", "@", " ", "qbmP"}], " ", "+", " ", 
                RowBox[{"qbmP", " ", "@", " ", "qbmX"}]}], ")"}]}]}], ",", 
            "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"qbmX", ",", " ", "qbmP"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"4", " ", "\[Gamma]", " ", "kT"}], ",", " ", 
                RowBox[{
                 RowBox[{"-", "I"}], " ", "\[Gamma]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"I", " ", "\[Gamma]"}], ",", " ", 
                RowBox[{"\[Gamma]", "/", 
                 RowBox[{"(", 
                  RowBox[{"4", " ", "kT"}], ")"}]}]}], "}"}]}], "}"}]}], 
           "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}]}]}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qbmDiff", "[", "\[Alpha]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"CoherentState", "[", "qbmLevels", "]"}], "[", 
           RowBox[{"N", "[", "\[Alpha]", "]"}], "]"}], 
          "[", "\"\<StateVector\>\"", "]"}], "]"}]}], ",", " ", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"CoherentState", "[", "qbmLevels", "]"}], "[", 
           RowBox[{"-", 
            RowBox[{"N", "[", "\[Alpha]", "]"}]}], "]"}], 
          "[", "\"\<StateVector\>\"", "]"}], "]"}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", " ", "u", ",", " ", 
         RowBox[{"Conjugate", "[", "v", "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", " ", "v", ",", " ", 
         RowBox[{"Conjugate", "[", "u", "]"}]}], "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "u"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", " ", "u", ",", " ", 
            RowBox[{"Conjugate", "[", "u", "]"}]}], "]"}], " ", "+", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", " ", "v", ",", " ", 
            RowBox[{"Conjugate", "[", "v", "]"}]}], "]"}]}], ")"}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qbmCoherence", "[", 
    RowBox[{"\[Gamma]_", ",", " ", "kT_", ",", " ", "\[Alpha]_"}], "]"}], " ",
    ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"SingularValueList", "[", 
           RowBox[{"Partition", "[", 
            RowBox[{"#", ",", " ", "qbmLevels"}], "]"}], "]"}], "]"}], " ", 
         "&"}], " ", "/@", " ", 
        RowBox[{"NestList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"qbmStep", "[", 
             RowBox[{"\[Gamma]", ",", " ", "kT"}], "]"}], " ", ".", " ", 
            "#"}], " ", "&"}], ",", " ", 
          RowBox[{"qbmDiff", "[", "\[Alpha]", "]"}], ",", " ", "64"}], 
         "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", " ", "\[Pi]"}], ",", " ", 
          RowBox[{"\[Pi]", "/", "32"}]}], "]"}], ",", " ", 
        RowBox[{"c", "/", 
         RowBox[{"First", "[", "c", "]"}]}]}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qbm\[Gamma]s", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.00005", ",", " ", "0.0001", ",", " ", "0.0002"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qbmPanel", "[", 
    RowBox[{"\[Alpha]_", ",", " ", "kT_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"qbmCoherence", "[", 
          RowBox[{"#", ",", " ", "kT", ",", " ", "\[Alpha]"}], "]"}], " ", 
         "&"}], " ", "/@", " ", "qbm\[Gamma]s"}], ",", " ", 
       RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Gamma]/\[CapitalOmega] = \>\"", ",", " ", "#"}], 
             "}"}], "]"}], " ", "&"}], " ", "/@", " ", "qbm\[Gamma]s"}], 
         ")"}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"LogPlot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "8"}], " ", "#", " ", "kT", " ", 
            RowBox[{"\[Alpha]", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"t", " ", "+", " ", 
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"2", " ", "t"}], "]"}], "/", "2"}]}], ")"}]}], "]"}], 
          " ", "&"}], " ", "/@", " ", "qbm\[Gamma]s"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", 
         RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", "0.18", "]"}], ",", " ", 
        RowBox[{"Log", "[", "1.05", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalOmega] t\>\"", ",", " ", "\"\<D\>\""}], "}"}]}], 
     ",", "\n", "    ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log", "[", "#", "]"}], ",", " ", "#"}], "}"}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{
            "0.2", ",", " ", "0.3", ",", " ", "0.5", ",", " ", "0.7", ",", 
             " ", "1"}], "}"}]}], ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"k", " ", 
               RowBox[{"\[Pi]", "/", "2"}]}], ",", " ", 
              RowBox[{"k", " ", 
               RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ",",
           " ", "None"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"k", " ", 
           RowBox[{"\[Pi]", "/", "2"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", "None"}], 
       "}"}]}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", 
      RowBox[{"1", "/", "2"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Alpha] = \>\"", ",", " ", "\[Alpha]", ",", 
         " ", "\"\<,   \>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<k\>\"", ",", " ", "\"\<B\>\""}], "]"}], ",", 
         " ", "\"\<T/\[CapitalOmega] = \>\"", ",", " ", "kT"}], "}"}], 
       "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qbmPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"qbmPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "10"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "qbmPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "720"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Last", "[", 
        RowBox[{"qbmPanels", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", " ", "Dashed"}], "]"}], "}"}], ",", " ", 
         RowBox[{"{", "\"\<closed form\>\"", "}"}]}], "]"}]}], "}"}], "]"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[18]:= ",
 CellID->1224652745,ExpressionUUID->"02d80c58-2519-d584-6556-a1816ff7d1e9"],

Cell[TextData[{
 "The coherence falls in steps: it drops while the two lobes sit apart in \
position, near ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[CapitalOmega]", 
    StyleBox["t", "TI"], "=", "0"}], ",", "\[Pi]", ",", 
   RowBox[{"2", "\[Pi]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23729e0d-94b5-a98d-4f71-4f7dd7d9a110"],
 ", and stalls near ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f1fd37b-bc02-9f4f-1db7-3bff800ee1e0"],
 " and ",
 Cell[BoxData[
  RowBox[{"3", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc6b9b8-2f29-e5dd-3325-6f8180af5ad7"],
 ", where the trap has turned their separation into momentum, which the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["x", "TI"], "^"], ",", 
      StyleBox["\[Rho]", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2266b3e2-f4ba-b413-5388-b8a1c18d6080"],
 " term does not see. The rate grows as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["k", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox["T", "TI"], 
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02ba11ca-ae5d-88d6-2388-2d4eb076c7ce"],
 ", so a larger cat, a hotter bath or stronger friction makes every step \
deeper. The friction here is weak enough that the bath adds little noise to \
each lobe within a period, so the lobes stay sharp and the solid curves \
follow the prediction, which treats each lobe as a point. A gap opens only \
for the large cat in the hotter bath at the strongest friction, where the \
bath begins to heat the lobes themselves and the coherence decays more slowly \
than the prediction."
}], "Text",
 CellID->1289919228,ExpressionUUID->"6c688d09-aa5e-1854-6aca-d1b1bae4f623"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1169389055,ExpressionUUID->"034d1377-6f9b-dea0-17c0-dba9376ceb70"],

Cell["A driven, leaky cavity settles into a coherent state", "Subsection",
 CellID->1710318553,ExpressionUUID->"5667734c-b3a0-720e-161b-f5acef409605"],

Cell[TextData[{
 "A cavity mode of frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee3fa71-078e-4095-2f03-65c3ff0777cf"],
 " is driven by a classical field of frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "752fc0a3-cc58-6190-4e61-1073a5900e51"],
 " and strength ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c702543-53a2-b43e-3858-0a480036e9bf"],
 ", and its mirror leaks photons at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60e3345a-648f-61ec-1f77-c1f01a370970"],
 ". Does the field end in the same pure coherent state whatever its start?"
}], "Text",
 CellID->543569477,ExpressionUUID->"135d4a9e-dcf5-3430-3898-c971c59f1b3a"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6257dd06-f247-e98b-6116-766816ea62f9"],
 ", the Hamiltonian, and its form in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4265d19b-016e-f298-5a5e-224f204ec446"],
 ", are"
}], "Text",
 CellID->524241718,ExpressionUUID->"0f46d704-d826-e4bd-1ced-99823f297592"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    StyleBox["G", "TI"], "(", 
    RowBox[{
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["i", "TI"], 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["d", "TI"]], 
       StyleBox["t", "TI"]}]], "+", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["d", "TI"]], 
       StyleBox["t", "TI"]}]]}], ")", "\[ThickSpace]", "\[LongRightArrow]", 
    "\[ThickSpace]", "\[CapitalDelta]", "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    StyleBox["G", "TI"], "(", 
    RowBox[{
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "+", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["c", "TI"]], "-", 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["d", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->674005596,ExpressionUUID->"5995c5ba-5a06-e8e5-7908-7b412d7eb421"],

Cell[TextData[{
 "the loss enters as ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21469327-1d8c-05aa-2cf0-f8f0fc0e6f68"],
 " with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["L", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    OverscriptBox[
     StyleBox["L", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["L", "TI"], "^"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["L", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["L", "TI"], "^"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dccc349-a3d8-d6b5-0c67-30a4248b2f16"],
 ", and the mean field obeys ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "."], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], "\[CapitalDelta]", "+", 
    StyleBox["\[Kappa]", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   StyleBox["i", "TI"], 
   StyleBox["G", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d9fdc5e-ac98-1f2b-2a77-e8f96f870705"],
 ", whose fixed point is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["G", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Kappa]", "TI"], "/", "2", "+", 
    StyleBox["i", "TI"], "\[CapitalDelta]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5993d494-9204-f341-7931-3573f712bd7a"],
 ". Shifted by ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bc11ca8-8317-fe57-1998-b713884db8f4"],
 ", the master equation describes the same detuned, lossy mode with no drive, \
so from the vacuum ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["\[Beta]", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      StyleBox["\[Beta]", "TI"]},
     "Ket"]}], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Beta]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Kappa]", "TI"], 
       StyleBox["t", "TI"]}]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60641dd5-5d75-532b-4773-ed9a76389fc5"],
 ", from a thermal state of mean ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "483e62ed-06cb-613b-495e-53c066a056ca"],
 " it is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Beta]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Kappa]", "TI"], 
       StyleBox["t", "TI"]}]], "/", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      OverscriptBox[
       StyleBox["n", "TI"], "_"], 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["\[Kappa]", "TI"], 
        StyleBox["t", "TI"]}]]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    OverscriptBox[
     StyleBox["n", "TI"], "_"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["\[Kappa]", "TI"], 
      StyleBox["t", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22d25c61-df3b-9f4d-1380-093627f8e845"],
 ", and from the number state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "163f5981-2d42-3f3d-07f7-aac37f11b4a2"],
 " it is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["n", "TI"]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Beta]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["\[Kappa]", "TI"], 
       StyleBox["t", "TI"]}]]}]], 
   SubscriptBox[
    StyleBox["L", "TI"], 
    StyleBox["n", "TI"]], "(", 
   RowBox[{"-", 
    SuperscriptBox[GridBox[{
       {
        StyleBox["\[Beta]", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", "2", 
      StyleBox["\[Kappa]", "TI"], 
      StyleBox["t", "TI"]}]], "/", 
    StyleBox["s", "TI"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38ca6fed-3f24-79bd-43bb-23b4a2337cbe"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "1", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e164543-0a81-d4fb-1da2-5c62c2e88119"],
 "."
}], "Text",
 CellID->1067394268,ExpressionUUID->"7b0e7efe-d851-eb1b-195e-b30557c7a10e"],

Cell[TextData[{
 "The vacuum, the number state ",
 Cell[BoxData[
  TemplateBox[{"3"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73a1cf77-43c0-a974-56c5-e4a9bc2035b2"],
 " and a thermal state with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65149050-f53f-387a-284c-79162298128e"],
 " evolve under the exponential of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b53b87-6513-8bda-59e5-00c3b5580145"],
 " on 30 Fock levels; points are their overlap ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Beta]", "TI"]},
    "Bra"], 
   StyleBox["\[Rho]", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{
     StyleBox["\[Beta]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28ac372b-a6fc-4ffe-7913-669fa26a1da6"],
 ", with the closed forms dashed; rates are in units of ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e307079-6096-a4b0-14d6-40db033f05c1"],
 ":"
}], "Text",
 CellID->662938664,ExpressionUUID->"14e96255-5caf-5995-6ddf-13ad1af50e5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"balLevels", ",", " ", "balTimes"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"30", ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "8", ",", " ", "0.1"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"balA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "balLevels", "]"}]}], ";", " ", 
  RowBox[{"balFock", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "y"}], "}"}], ",", " ", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"s", "^", "3"}], " ", 
        RowBox[{"LaguerreL", "[", 
         RowBox[{"3", ",", " ", 
          RowBox[{
           RowBox[{"-", "y"}], "/", "s"}]}], "]"}]}], "]"}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"balStarts", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"#", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FockState", "[", 
       RowBox[{"0", ",", " ", "balLevels"}], "]"}], ",", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{"3", ",", " ", "balLevels"}], "]"}], ",", " ", 
      RowBox[{"ThermalState", "[", 
       RowBox[{"2.", ",", " ", "balLevels"}], "]"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"balOverlap", "[", 
    RowBox[{"G_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"CoherentState", "[", "balLevels", "]"}], "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"G", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"1", "/", "2"}], " ", "+", " ", 
                RowBox[{"I", " ", "\[CapitalDelta]"}]}], ")"}]}]}], "]"}], 
           "]"}], "[", "\"\<StateVector\>\"", "]"}], "]"}]}], ",", "\n", 
       "     ", 
       RowBox[{"step", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{"0.1", " ", 
          RowBox[{"N", " ", "@", " ", 
           RowBox[{"Normal", " ", "@", " ", 
            RowBox[{
             RowBox[{"QuantumOperator", "[", 
              RowBox[{"\"\<Liouvillian\>\"", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[CapitalDelta]", " ", 
                  RowBox[{
                   RowBox[{"SuperDagger", "[", "balA", "]"}], " ", "@", " ", 
                   "balA"}]}], " ", "+", " ", 
                 RowBox[{"G", " ", 
                  RowBox[{"(", 
                   RowBox[{"balA", " ", "+", " ", 
                    RowBox[{"SuperDagger", "[", "balA", "]"}]}], ")"}]}]}], ",",
                 " ", 
                RowBox[{"{", "balA", "}"}], ",", " ", 
                RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "[", "\"\<Matrix\>\"",
              "]"}]}]}]}], "]"}]}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"balTimes", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", 
              RowBox[{"Partition", "[", 
               RowBox[{"#", ",", " ", "balLevels"}], "]"}], " ", ".", " ", 
              "v"}], "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"NestList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"step", " ", ".", " ", "#"}], " ", "&"}], ",", " ", "#",
              ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "balTimes", "]"}], " ", "-", " ", 
              "1"}]}], "]"}]}]}], "}"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "balStarts"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"balPanel", "[", 
    RowBox[{"G_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b2", " ", "=", " ", 
       RowBox[{
        RowBox[{"G", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", "4"}], " ", "+", " ", 
          RowBox[{"\[CapitalDelta]", "^", "2"}]}], ")"}]}]}], "}"}], ",", " ", 
     RowBox[{"Show", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"balOverlap", "[", 
           RowBox[{"G", ",", " ", "\[CapitalDelta]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", 
            RowBox[{";;", " ", ";;", " ", "4"}]}], "]"}], "]"}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<|0\[RightAngleBracket]\>\"", ",", 
            " ", "\"\<|3\[RightAngleBracket]\>\"", ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<thermal, \>\"", ",", " ", 
               RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}], ",", 
               " ", "\"\< = 2\>\""}], "}"}], "]"}]}], "}"}]}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "b2"}], " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", "t"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"balFock", "[", 
             RowBox[{
              RowBox[{"1", " ", "-", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"-", "t"}], "]"}]}], ",", " ", 
              RowBox[{"b2", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "2"}], " ", "t"}], "]"}]}]}], "]"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "b2"}], " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"-", "t"}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "b2"}], " ", 
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{"-", "t"}], "]"}], "/", 
               RowBox[{"(", 
                RowBox[{"1", " ", "+", " ", 
                 RowBox[{"2", " ", 
                  RowBox[{"Exp", "[", 
                   RowBox[{"-", "t"}], "]"}]}]}], ")"}]}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"-", "t"}], "]"}]}]}], ")"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.02"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Kappa] t\>\"", ",", 
          " ", "\"\<\[LeftAngleBracket]\[Beta]|\[Rho]|\[Beta]\
\[RightAngleBracket]\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<G/\[Kappa] = \>\"", ",", " ", "G", ",", 
           " ", "\"\<,   \[CapitalDelta]/\[Kappa] = \>\"", ",", " ", 
           "\[CapitalDelta]"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"balPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"balPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "1.5"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "balPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Last", "[", 
        RowBox[{"balPanels", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", " ", "Dashed"}], "]"}], "}"}], ",", " ", 
         RowBox[{"{", "\"\<closed form\>\"", "}"}]}], "]"}]}], "}"}], "]"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[19]:= ",
 CellID->244926620,ExpressionUUID->"1682ead8-474f-7551-1238-709427d78ad7"],

Cell[TextData[{
 "From every start, the mixed thermal state included, the overlap reaches 1 \
after several ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "365c28bc-b038-8749-0166-5064fd349e2b"],
 ", later the larger ",
 Cell[BoxData[GridBox[{
    {
     StyleBox["\[Beta]", "TI"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ba5da5f-7c52-9e90-5cbd-64777975f3de"],
 ", and every start lies on its closed form: the loss empties the shifted \
mode into its vacuum, and that vacuum is ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Beta]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "482b4c3f-6e4e-c178-7fc8-5c288f3a37ba"],
 ". The drive and the detuning only set where ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "692646bc-6534-2f95-609d-d70959f39cb1"],
 " lies, so the vacuum and thermal starts begin lowest where ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[Beta]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", 
   StyleBox["G", "TI"], "/", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Kappa]", "TI"], "2"], "/", "4", "+", 
     SuperscriptBox["\[CapitalDelta]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60038416-996c-0feb-2b0f-1126b8c1318e"],
 " is largest."
}], "Text",
 CellID->356162114,ExpressionUUID->"34b45a9d-4a83-ca22-1d12-45eacbcf5a7c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1968701164,ExpressionUUID->"4ceaf103-4327-7b4b-219b-d629375f9dcb"],

Cell["\<\
A charge qubit read by a point contact: when the Rabi peaks merge\
\>", "Subsection",
 CellID->1848903766,ExpressionUUID->"1be9afa8-7770-99ee-1004-6c6965fd8a34"],

Cell[TextData[{
 "One electron tunnels between two quantum dots, left ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["L", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22395b6c-402f-d2bc-1228-9196dddd3341"],
 " and right ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["R", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b48d6-4aca-376f-1041-f5eb26b20cf0"],
 ", with tunnelling ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7230cf54-88d3-da30-73d2-cc8d9874cf18"],
 " and level offset ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae78344-43f3-0bae-652f-a5c733982d3b"],
 ", while a nearby quantum point contact passes a current that depends on \
which dot is occupied. The current noise carries the fluctuations of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["L", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["L", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["R", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["R", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73a8fb0c-143f-303f-470c-9225dfe517e5"],
 ". As the contact reads more strongly, do the Rabi peaks of that noise \
spectrum merge where the Liouvillian's eigenvectors coalesce?"
}], "Text",
 CellID->2043314122,ExpressionUUID->"1cdf15ee-362a-4295-00cc-5cad9fabf3c8"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "660d0adf-0288-dd9f-21aa-2a6f13e4ce9e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["L", "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["L", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["L", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09c81b69-0b5a-7756-131c-10e9df046ff6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22eabe25-9bdc-eba0-396f-f7bd500e898e"],
 ","
}], "Text",
 CellID->1823573859,ExpressionUUID->"453bc8ca-bf85-c840-638e-efb18120a7e7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox["\[Epsilon]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]], "+", 
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], 
     StyleBox["L", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["k", "TI"], "=", 
    RowBox[{
     StyleBox["\[Kappa]", "TI"], "/", "4"}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->801822598,ExpressionUUID->"6d9401a5-f06a-4535-6567-b48e5688949d"],

Cell[TextData[{
 "since ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["L", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   FractionBox["1", "4"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3773e782-42c8-4776-15ad-2daf32d089ac"],
 ", the watched-qubit Liouvillian of the Zeno crossover with ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e1024c2-5ef3-2098-00ad-6145175236b6"],
 " for ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f879d5c-5cf0-38b1-377f-9bb349939a53"],
 ". By quantum regression, the symmetrized spectrum is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["Tr",
    FontSlant->"Plain"], "[", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{"-", "1"}]], 
     FractionBox["1", "2"], "{", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], 
      StyleBox["z", "TI"]], "-", 
     SubscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], 
      StyleBox[
       RowBox[{"s", "s"}], "TI"]]}], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"s", "s"}], "TI"]], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39221c93-66fd-698d-2507-d7ace268b227"],
 " with steady state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"s", "s"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f948a7-0f93-4d6f-3e25-2461b7600276"],
 ". A side peak exists when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["S", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["\[Omega]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b9de2c-5f9f-db34-7721-8db99fb47fad"],
 " has a root at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26de0e7d-130b-68f6-7256-879a54481e6a"],
 "; an exceptional point is a ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd71c4a-607f-c2bb-370c-4cbce619e16a"],
 " where two nonzero eigenvalues of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13512771-5692-7257-6ef8-42f517c37bf0"],
 " coincide."
}], "Text",
 CellID->1331179845,ExpressionUUID->"4c5ca88b-f084-e3e0-1b5f-78b6844b2237"],

Cell[TextData[{
 "Inverting ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2adaadfd-4b56-69c8-124f-047df5b34511"],
 " for general ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56fe5e8e-2555-8971-5340-351ff77b49d9"],
 ", ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "236fdd98-78c7-5c6b-77f1-ac8bd6b7b82c"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c891171-e830-4bae-54f3-275182744cf6"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44926db0-e90d-f596-27ed-9baca71f0527"],
 " in closed form, with the largest ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c4cf4ce-bdd3-c6b5-3203-85000c7afb1b"],
 " that keeps side peaks and the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0965de78-1c8c-6664-34af-a1f2e1d7a8ff"],
 " where the discriminant of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68cf647b-7ddd-8133-7a5c-190f12ada9c1"],
 "'s characteristic polynomial vanishes; on resonance these are:"
}], "Text",
 CellID->700675467,ExpressionUUID->"7110d5a3-374d-e340-311a-c0657bc823ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qpcL", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Liouvillian\>\"", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[CurlyEpsilon]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}], "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"4", " ", "k"}], "}"}]}], "]"}], "]"}], "[", "\"\<Matrix\>\"",
      "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcSS", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"NullSpace", "[", "qpcL", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"v", "/", 
      RowBox[{"Tr", "[", "v", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcSpec", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dz", " ", "=", " ", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "qpcSS"}], 
          "]"}], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"2", " ", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"LinearSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"I", " ", "\[Omega]", " ", 
                 RowBox[{"IdentityMatrix", "[", "4", "]"}]}], " ", "-", " ", 
                "qpcL"}], ",", " ", 
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"dz", " ", ".", " ", "qpcSS"}], " ", "+", " ", 
                   RowBox[{"qpcSS", " ", ".", " ", "dz"}]}], ")"}], "/", 
                 "2"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}], "]"}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qpcSideEdge", "[", "\[CurlyEpsilon]v_", "]"}], " ", ":=", " ", 
   RowBox[{"MaxValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"Reduce", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exists", "[", 
           RowBox[{"u", ",", " ", 
            RowBox[{
             RowBox[{"u", " ", ">", " ", "0"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Numerator", "[", 
               RowBox[{"Together", "[", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"qpcSpec", " ", "/.", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\[Omega]", " ", "->", " ", 
                    RowBox[{"Sqrt", "[", "u", "]"}]}], ",", " ", 
                    RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", 
                    " ", 
                    RowBox[{
                    "\[CurlyEpsilon]", " ", "->", " ", "\[CurlyEpsilon]v"}]}],
                     "}"}]}], ",", " ", "u"}], "]"}], "]"}], "]"}], " ", "==",
               " ", "0"}]}]}], "]"}], " ", "&&", " ", 
          RowBox[{"k", " ", ">", " ", "0"}]}], ",", " ", "k"}], "]"}]}], 
      "}"}], ",", " ", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcDisc", " ", "=", " ", 
   RowBox[{"Discriminant", "[", 
    RowBox[{
     RowBox[{"Cancel", "[", 
      RowBox[{
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{"qpcL", ",", " ", "\[Lambda]"}], "]"}], "/", "\[Lambda]"}], 
      "]"}], ",", " ", "\[Lambda]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qpcEP", "[", "\[CurlyEpsilon]v_", "]"}], " ", ":=", " ", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"qpcDisc", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{
             "\[CurlyEpsilon]", " ", "->", " ", "\[CurlyEpsilon]v"}]}], 
            "}"}]}], ")"}], " ", "==", " ", "0"}], " ", "&&", " ", 
        RowBox[{"k", " ", ">", " ", "0"}]}], ",", " ", "k", ",", " ", 
       "Reals"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", " ", "->", " ", "v_"}], "}"}], " ", ":>", " ", "v"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<S(\[Omega])\>\"", " ", "->", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"qpcSpec", " ", "/.", " ", 
      RowBox[{"\[CurlyEpsilon]", " ", "->", " ", "0"}]}], "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<side peaks\>\"", " ", "->", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"Reduce", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"SeriesCoefficient", "[", 
           RowBox[{
            RowBox[{"qpcSpec", " ", "/.", " ", 
             RowBox[{"\[CurlyEpsilon]", " ", "->", " ", "0"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Omega]", ",", " ", "0", ",", " ", "2"}], "}"}]}], 
           "]"}], " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], ",", " ", "k"}], 
       "]"}], ",", " ", 
      RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<exceptional point\>\"", " ", "->", " ", 
    RowBox[{"k", " ", "==", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"k", " ", "/.", " ", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"qpcDisc", " ", "/.", " ", 
              RowBox[{"\[CurlyEpsilon]", " ", "->", " ", "0"}]}], ")"}], " ", 
            "==", " ", "0"}], " ", "&&", " ", 
           RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], ",", " ", "k"}],
          "]"}], "]"}]}], "]"}]}]}]}], "|>"}]}], "Input",
 CellLabel->"In[20]:= ",
 CellID->817607514,ExpressionUUID->"0ae97428-42e1-5e9d-260a-a163435887f2"],

Cell[TextData[{
