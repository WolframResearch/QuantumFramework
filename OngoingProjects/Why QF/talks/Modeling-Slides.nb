 CellID->1413782510,ExpressionUUID->"12e2d5c1-b8a6-1142-1821-839e432845b6"],

Cell[TextData[{
 "A qubit with splitting ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44f991bc-781a-f2fc-605b-b70310e1a7dc"],
 " is driven at frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "714b4940-3b25-ca34-651d-d9adb32d7c66"],
 ", detuned by ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"], "-", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30dfb01e-8e41-451f-2443-3976764f8378"],
 ", by a Gaussian pulse of peak Rabi frequency ",
 Cell[BoxData[
  SubscriptBox["\[CapitalOmega]", "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25ce9cd1-a01b-69ec-15ff-c7f5a91cd710"],
 ", width ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78bd990a-ce3f-4df9-1040-deff4cab932d"],
 ", centered at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fac90c5-9b8e-37b6-3328-24a6a473b8f2"],
 ". How much population has the pulse moved into ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "432e3fec-5f02-8759-1aaf-22ebb1b2b23b"],
 " by time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "345c8a13-e98e-1d4e-3ce5-de112c51f6c7"],
 ", on and off resonance?"
}], "Text",
 CellID->1044224263,ExpressionUUID->"2148ea3f-c665-2d7c-0f61-5067dab5e52b"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "427360a4-cf28-070c-0317-7f22b9abfa09"],
 ", the lab-frame Hamiltonian and its form in the frame rotating at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "407d7d3e-529e-bfcd-3a08-cec66fd2f713"],
 ", after the rotating-wave approximation, are"
}], "Text",
 CellID->877015706,ExpressionUUID->"55dd910a-4526-c708-169a-6219a791ea46"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    FractionBox[
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], "0"], "2"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "+", "\[CapitalOmega]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]], "\[ThickSpace]", "\[LongRightArrow]", 
    "\[ThickSpace]", 
    FractionBox["\[CapitalDelta]", "2"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "+", 
    FractionBox[
     RowBox[{"\[CapitalOmega]", 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["x", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "0"], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          StyleBox["t", "TI"], "-", 
          SubscriptBox[
           StyleBox["t", "TI"], "0"]}], 
         StyleBox[")",
          SpanMaxSize->1]}], "2"], "/", "2", 
       SuperscriptBox[
        StyleBox["\[Tau]", "TI"], "2"]}]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->787058812,ExpressionUUID->"49b20055-45aa-0492-337a-6aea6c106ca7"],

Cell[TextData[{
 "and the propagator solves ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "\[ThinSpace]", 
