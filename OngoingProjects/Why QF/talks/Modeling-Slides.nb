 " copies of one row, so ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Per",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["T", "TI"]], "=", 
    StyleBox["n", "TI"]}], "!", 
   RowBox[{
