Cell["\<\
Grover search: the success probability, iteration by iteration\
\>", "Subsection",
 CellID->2069287741,ExpressionUUID->"4fa0effb-8fbf-eda7-644b-10a944cd18dc"],

Cell[TextData[{
 "A Boolean oracle accepts ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35a5fb7a-09a3-97a9-1dc8-f8a642b8182c"],
 " of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", 
   SuperscriptBox["2", 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3afee322-e6e1-46bf-27ea-ff4492fb5468"],
 " bit strings. Grover's search starts from the uniform superposition and \
repeats one iteration, a phase flip of the accepted strings followed by a \
reflection about the uniform state. How does the probability of finding an \
accepted string change with the number of iterations ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "711a44ec-c3da-507e-4367-0f0b8556831d"],
 "?"
}], "Text",
 CellID->1055846006,ExpressionUUID->"60db6b08-0784-efa0-1c80-368582181806"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6248d5f8-639d-a786-4066-661f07da8d3b"],
 " the oracle and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["s", "TI"]},
    "Ket"], "=", 
   SuperscriptBox[
    TemplateBox[{"+"},
     "Ket"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf5831f-428d-ff34-601c-551ef0954829"],
 ", one iteration, the state after ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32c2a80b-fab3-9b33-5309-fdeadec8d2b0"],
 " of them and the success probability are"
}], "Text",
 CellID->1888029085,ExpressionUUID->"304c8b9f-cdc9-75b6-1075-723e93e11b08"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["G", "TI"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        TemplateBox[{
          StyleBox["s", "TI"]},
         "Ket"], 
        TemplateBox[{
          StyleBox["s", "TI"]},
         "Bra"]}], "-", "1"}], ")"}], 
     StyleBox["O", "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["O", "TI"], 
     TemplateBox[{
       StyleBox["x", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]], 
     TemplateBox[{
       StyleBox["x", "TI"]},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["k", "TI"]]},
     "Ket"], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["G", "TI"], 
      StyleBox["k", "TI"]], 
     TemplateBox[{
       StyleBox["s", "TI"]},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["k", "TI"]], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["f", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1], "=", "1"}],
      LimitsPositioning->False], 
     RowBox[{
      SuperscriptBox[GridBox[{
         {
          TemplateBox[{
            StyleBox["x", "TI"], 
            SubscriptBox[
             StyleBox["\[Psi]", "TI"], 
             StyleBox["k", "TI"]]},
           "BraKet"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1603873801,ExpressionUUID->"109e428b-7563-4f84-1dcd-34f9f981d276"],

Cell[TextData[{
 "In the plane of the accepted and rejected uniform states, ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["s", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c376cdd-0db4-e7bc-0d62-d0ddd80fdf14"],
 " sits at the angle ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35711a8b-3b30-99c0-0e1c-fb1b9046a37c"],
 " from the rejected one, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["a", "TI"], "=", 
   SqrtBox[
    RowBox[{
     StyleBox["M", "TI"], "/", 
     StyleBox["N", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25457dc1-8b04-750d-2025-25abfff15838"],
 ", and ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1638e9-b077-89e1-08f2-29ca83276b21"],
 " is a rotation by ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c7ea771-05a6-db3d-77bf-4b9327e11d61"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "(", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"2", 
     StyleBox["k", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["a", "TI"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61baf719-50c4-40c7-075e-1c3cb68dbc2d"],
 "."
}], "Text",
 CellID->781397590,ExpressionUUID->"61cc574d-4722-fe72-03b1-ce5eb22d4822"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68b18b9d-b6a5-a345-165f-60601864f3cd"],
 ", built from the Boolean function, acts on the state again and again \
(markers), up to about ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   SqrtBox[
    StyleBox["N", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "181de7b5-ed1e-7e53-200a-7f011dafb1bd"],
 " iterations, against the closed form (dashed); the accepted strings are a \
few fixed integers below 16:"
}], "Text",
 CellID->9103532,ExpressionUUID->"351e37bf-c7b7-8e33-4bef-445ee21542c5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"groverSuccess", "[", 
    RowBox[{"n_", ",", " ", "accepted_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"QuantumCircuitOperator", "[", 
           RowBox[{"\"\<GroverPhase\>\"", "[", 
            RowBox[{"BooleanFunction", "[", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"2", "^", "accepted"}], "]"}], ",", " ", "n"}], "]"}], 
            "]"}], "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "}"}],
      ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"accepted", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], "^",
          "2"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"NestList", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"g", " ", ".", " ", "#"}], " ", "&"}], ",", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "n"}], "/", "2"}], ")"}]}], ",", " ", 
          RowBox[{"2", "^", "n"}]}], "]"}], ",", " ", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"\[Pi]", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "^", "n"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"groverAccepted", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "5", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "9"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "9", ",", " ", "12", ",", " ", "14"}], "}"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"groverPanels", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"groverSuccess", "[", 
            RowBox[{"n", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
          "groverAccepted"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"Ceiling", "[", 
             RowBox[{"\[Pi]", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", "^", "n"}], "]"}]}], "]"}]}], "}"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<M = \>\"", ",", " ", 
                RowBox[{"Length", "[", "#", "]"}]}], "}"}], "]"}], " ", "&"}],
             " ", "/@", " ", "groverAccepted"}], ")"}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"a", " ", "=", " ", 
                RowBox[{"ArcSin", "[", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"Length", "[", "#", "]"}], "/", 
                   RowBox[{"2", "^", "n"}]}], "]"}], "]"}]}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "k"}], " ", "+", " ", "1"}], ")"}], " ", 
                 "a"}], "]"}], "^", "2"}]}], "]"}], " ", "&"}], " ", "/@", 
           " ", "groverAccepted"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "0", ",", " ", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"\[Pi]", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"2", "^", "n"}], "]"}]}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.02"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<iterations k\>\"", ",", 
          " ", "\"\<success probability\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<N = \>\"", ",", " ", 
           RowBox[{"2", "^", "n"}]}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "6", ",", " ", "8"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"\"\<GroverPhase\>\"", "[", 
          RowBox[{"BooleanFunction", "[", 
           RowBox[{
            RowBox[{"2", "^", "5"}], ",", " ", "4"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "520"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<one Grover iteration, N = 16, marked item 5\>\"", ",", 
         " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"PlotGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"First", " ", "/@", " ", "groverPanels"}], "}"}], ",", " ", 
         
         RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
       RowBox[{"legendBelow", "[", 
        RowBox[{"Last", "[", 
         RowBox[{"First", "[", "groverPanels", "]"}], "]"}], "]"}]}], "]"}]}],
     "}"}], ",", " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[73]:= ",
 CellID->757245908,ExpressionUUID->"73797c1c-c2b1-722f-79d5-a7982bcc8fc3"],

Cell[TextData[{
 "The simulated probabilities sit on the closed form, which depends on the \
accepted strings only through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "/", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50ba58e8-fcdf-00ea-4eae-b256a967cfd9"],
 ". Each rotation by ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21f15921-2817-92e0-74ac-6aea684f009f"],
 " carries the state toward the accepted strings and then past them, so the \
first peak comes near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[TildeTilde]", 
   FractionBox["\[Pi]", "4"], 
   SqrtBox[
    RowBox[{
     StyleBox["N", "TI"], "/", 
     StyleBox["M", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "119f478b-3eda-5a0e-732e-d60f64bfc448"],
 ": later for a larger search space, earlier for more accepted strings. For \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "16"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c950949-7572-68d4-71ad-e42c1d04b8bc"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df8a97b-b274-b851-6b59-8d31012ac5f1"],
 " one iteration finds an accepted string with certainty."
}], "Text",
 CellID->1076797340,ExpressionUUID->"06632d25-43b9-ded9-28ee-630d5fce3d84"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->131625446,ExpressionUUID->"1aa268c3-f00a-315e-6120-5d25a78b49d9"],

Cell["Shor's discrete logarithm on a toy elliptic curve", "Subsection",
 CellID->327002827,ExpressionUUID->"2ef46a68-7fac-f49a-01d0-299488192322"],

Cell[TextData[{
 "The points of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["y", "TI"], "2"], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], "+", 
   StyleBox["x", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560168ad-8fbe-cb83-3177-af4fed748d05"],
 " over the integers mod 23, with the point at infinity ",
 Cell[BoxData["\|01d4aa"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a92ca6a-d58c-bfd9-602f-f93a0c9abb72"],
 ", form a cyclic group of order ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "322409f8-ce09-c8c5-2ad2-4d3e5ffafad3"],
 " under point addition. A public key is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], "=", "\[ScriptL]", 
   StyleBox["G", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44c4b74c-7e29-e679-7c3e-505328cfbea1"],
 " for a generator ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77448b50-050f-7720-6a29-53faf76d719c"],
 " and a secret integer ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "591ef151-ee1e-9be5-35b3-9681265a2590"],
 ". Can the interference pattern of Shor's algorithm reveal ",
 Cell[BoxData["\[ScriptL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18341745-2455-e6eb-512e-8c8a40c3624a"],
 " from ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64498428-457e-9fe8-2f80-8c0d0657b229"],
 " and ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ce9968-b46b-90cc-417f-522072e49682"],
 " alone?"
}], "Text",
 CellID->909811885,ExpressionUUID->"3cf00beb-3cf1-b472-4ba2-1d98c687d3d8"],

Cell[TextData[{
 "Two registers of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "7"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05db9550-fca3-0b46-1d41-bad30cf2218a"],
 " qubits hold ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3edae1c1-acb5-3a30-6e5e-91412466f235"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7605078d-e6ac-27b5-0dfd-4905f516e345"],
 " in uniform superposition, a third register receives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["a", "TI"], 
   StyleBox["G", "TI"], "+", 
   StyleBox["b", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d8e2630-edac-9a26-0886-587f57c876d6"],
 " and is measured, and a Fourier transform on each input register gives the \
outcome ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b2d15a6-f64c-a743-7a12-a3a58ef6f949"],
 " with probability"
}], "Text",
 CellID->1245609771,ExpressionUUID->"051125f3-dcd3-fe23-1f00-f35b737c8f7a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["d", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox["\[Sum]", 
     StyleBox["w", "TI"],
     LimitsPositioning->False], 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         FractionBox["1", 
          SuperscriptBox["2", 
           RowBox[{"2", 
            StyleBox["t", "TI"]}]]], 
         UnderscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["f", "TI"], 
           StyleBox["(",
            SpanMaxSize->1], 
           RowBox[{
            StyleBox["a", "TI"], ",", 
            StyleBox["b", "TI"]}], 
           StyleBox[")",
            SpanMaxSize->1], "=", 
           StyleBox["w", "TI"]}],
          LimitsPositioning->False], 
         StyleBox["exp",
          FontSlant->"Plain"], "\[ThinSpace]", "(", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"2", "\[Pi]", 
            StyleBox["i", "TI"], "\[ThinSpace]", 
            StyleBox["(",
             SpanMaxSize->1], 
            RowBox[{
             StyleBox["a", "TI"], 
             StyleBox["c", "TI"], "+", 
             StyleBox["b", "TI"], 
             StyleBox["d", "TI"]}], 
            StyleBox[")",
             SpanMaxSize->1]}], 
           SuperscriptBox["2", 
            StyleBox["t", "TI"]]]}], ")"}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1721882498,ExpressionUUID->"3030816b-2970-a77c-5773-66797acbe372"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3a12e0-a250-2fd8-3002-9ecc1daf70a6"],
 " is constant along ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "+", "\[ScriptL]", 
   StyleBox["b", "TI"], "\[Congruent]", 
   StyleBox["const",
    FontSlant->"Plain"], "(", 
   StyleBox["mod",
    FontSlant->"Plain"], " ", 
   StyleBox["r", "TI"], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e1b20aa-c1c4-fcc8-1a8f-a1a81b013e78"],
 ", the peaks sit near ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["d", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "\[TildeTilde]", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["j", "TI"], ",", "\[ThinSpace]", 
      RowBox[{
       StyleBox["j", "TI"], "\[ScriptL]"}]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "\[ThinSpace]", 
    RowBox[{
     SuperscriptBox["2", 
      StyleBox["t", "TI"]], "/", 
     StyleBox["r", "TI"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a4a4a16-5922-468d-3274-61eac297d775"],
 ", and every shot with ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65eeffef-4627-58c8-2264-d418ace1b52a"],
 " invertible mod ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a244e0c-6775-8850-1098-01ae37391845"],
 " gives a candidate ",
 Cell[BoxData[
  RowBox[{"\[ScriptL]", "=", 
   StyleBox["round",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], 
    StyleBox["d", "TI"], "/", 
    SuperscriptBox["2", 
     StyleBox["t", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{"-", "1"}]], 
   StyleBox["mod",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "466b26b5-1eba-1ba5-2c94-732f654cfc7c"],
 ", kept only if ",
 Cell[BoxData[
  RowBox[{"\[ScriptL]", 
   StyleBox["G", "TI"], "=", 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0814b419-879b-6483-62bd-7cecada36e5c"],
 "."
}], "Text",
 CellID->1353484138,ExpressionUUID->"54ffd163-6caa-2d78-422e-92b5d33f3a60"],

Cell[TextData[{
 "Points add by the chord-and-tangent rule, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a4564a5-bfa9-fc79-5bdb-6a43771dc54d"],
 " comes from a discrete Fourier transform, and 20 shots are drawn for three \
secret keys; each disk's area is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78390df2-9d7f-9844-7ac9-b8ef9cf3b42c"],
 ", open circles mark the predicted peaks ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["j", "TI"], ",", "\[ThinSpace]", 
     RowBox[{
      StyleBox["j", "TI"], "\[ScriptL]"}]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "\[ThinSpace]", 
   RowBox[{
    SuperscriptBox["2", 
     StyleBox["t", "TI"]], "/", 
    StyleBox["r", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "069e48af-c5c9-4a83-5999-ed3422ef6c3c"],
 ", and each title gives the candidates that pass the check:"
}], "Text",
 CellID->810439633,ExpressionUUID->"6a564bea-4b38-61cc-4567-40e8d82ea9df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ecPrime", " ", "=", " ", "23"}], ";", " ", 
  RowBox[{"ecBits", " ", "=", " ", "7"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ecChord", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1_", ",", " ", "y1_"}], "}"}], ",", " ", "x2_", ",", " ", 
     "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x3", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "^", "2"}], " ", "-", " ", "x1", " ", "-", " ", "x2"}],
          ",", " ", "ecPrime"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x3", ",", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s", " ", 
           RowBox[{"(", 
            RowBox[{"x1", " ", "-", " ", "x3"}], ")"}]}], " ", "-", " ", 
          "y1"}], ",", " ", "ecPrime"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ecAdd", "[", 
    RowBox[{"\[Infinity]", ",", " ", "q_"}], "]"}], " ", ":=", " ", "q"}], ";",
   " ", 
  RowBox[{
   RowBox[{"ecAdd", "[", 
    RowBox[{"q_", ",", " ", "\[Infinity]"}], "]"}], " ", ":=", " ", "q"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ecAdd", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1_", ",", " ", "y1_"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x1_", ",", " ", "y2_"}], "}"}]}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"y1", " ", "+", " ", "y2"}], ",", " ", "ecPrime"}], "]"}], " ",
      "==", " ", "0"}]}], " ", ":=", " ", "\[Infinity]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ecAdd", "[", 
    RowBox[{
     RowBox[{"pt", " ", ":", " ", 
      RowBox[{"{", 
       RowBox[{"x1_", ",", " ", "y1_"}], "}"}]}], ",", " ", "pt_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"ecChord", "[", 
    RowBox[{"pt", ",", " ", "x1", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"x1", "^", "2"}]}], " ", "+", " ", "1"}], ")"}], " ", 
      RowBox[{"PowerMod", "[", 
       RowBox[{
        RowBox[{"2", " ", "y1"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "ecPrime"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ecAdd", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1_", ",", " ", "y1_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x2_", ",", " ", "y2_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"ecChord", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1", ",", " ", "y1"}], "}"}], ",", " ", "x2", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
      RowBox[{"PowerMod", "[", 
       RowBox[{
        RowBox[{"x2", " ", "-", " ", "x1"}], ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "ecPrime"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ecMultiples", "[", "pt_", "]"}], " ", ":=", " ", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ecAdd", "[", 
       RowBox[{"#", ",", " ", "pt"}], "]"}], " ", "&"}], ",", " ", 
     "\[Infinity]", ",", " ", 
     RowBox[{
      RowBox[{"2", "^", "ecBits"}], " ", "-", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ecPoints", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"ecPrime", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "3"}], " ", "-", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}], ",", " ", 
         "ecPrime"}], "]"}], " ", "==", " ", "0"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ecOrder", " ", "=", " ", 
   RowBox[{
    RowBox[{"Length", "[", "ecPoints", "]"}], " ", "+", " ", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ecGen", " ", "=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"ecPoints", ",", " ", 
     RowBox[{
      RowBox[{"DuplicateFreeQ", "[", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"ecMultiples", "[", "#", "]"}], ",", " ", "ecOrder"}], "]"}],
        "]"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ecGenMultiples", " ", "=", " ", 
   RowBox[{"ecMultiples", "[", "ecGen", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"shorRecover", "[", 
    RowBox[{"pub_", ",", " ", "shots_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"DeleteDuplicates", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"j", " ", "=", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"Round", "[", 
                RowBox[{"ecOrder", " ", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "/", 
                  RowBox[{"2", "^", "ecBits"}]}]}], "]"}], ",", " ", 
               "ecOrder"}], "]"}]}], ",", " ", 
            RowBox[{"l", " ", "=", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"Round", "[", 
                RowBox[{"ecOrder", " ", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "/", 
                  RowBox[{"2", "^", "ecBits"}]}]}], "]"}], ",", " ", 
               "ecOrder"}], "]"}]}]}], "}"}], ",", "\n", "       ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"CoprimeQ", "[", 
             RowBox[{"j", ",", " ", "ecOrder"}], "]"}], ",", " ", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"l", " ", 
               RowBox[{"PowerMod", "[", 
                RowBox[{"j", ",", " ", 
                 RowBox[{"-", "1"}], ",", " ", "ecOrder"}], "]"}]}], ",", " ",
               "ecOrder"}], "]"}], ",", " ", "Nothing"}], "]"}]}], "]"}], " ",
         "&"}], " ", "/@", " ", "shots"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ecGenMultiples", "[", 
        RowBox[{"[", 
         RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], " ", "===", " ", 
       "pub"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"shorPanel", "[", "key_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pub", " ", "=", " ", 
       RowBox[{"ecGenMultiples", "[", 
        RowBox[{"[", 
         RowBox[{"key", " ", "+", " ", "1"}], "]"}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"fab", " ", "=", " ", 
       RowBox[{"Outer", "[", 
        RowBox[{"ecAdd", ",", " ", "ecGenMultiples", ",", " ", 
         RowBox[{"ecMultiples", "[", "pub", "]"}], ",", " ", "1"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"probs", " ", "=", " ", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"w", ",", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Fourier", "[", 
               RowBox[{
                RowBox[{"Boole", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", " ", "===", " ", "w"}], " ", "&"}], ",", " ",
                    "fab", ",", " ", 
                   RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
                RowBox[{"FourierParameters", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "]"}], "^", 
             "2"}]}], "]"}], " ", "/@", "\n", "         ", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"fab", ",", " ", "1"}], "]"}], "]"}]}], "]"}], "/", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"2", " ", "ecBits"}], ")"}]}]}]}], "}"}], ",", "\n", 
     "     ", 
     RowBox[{"{", 
      RowBox[{"shots", " ", "=", " ", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "[", "probs", "]"}], " ", "->", " ", 
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{
               RowBox[{"2", "^", "ecBits"}], " ", "-", " ", "1"}]}], "]"}], ",",
             " ", "2"}], "]"}]}], ",", " ", "20"}], "]"}]}], "}"}], ",", "\n",
      "      ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.45", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Disk", "[", 
             RowBox[{
              RowBox[{"Most", "[", "#", "]"}], ",", " ", 
              RowBox[{"3", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"Last", "[", "#", "]"}], "/", 
                 RowBox[{"Max", "[", "probs", "]"}]}], "]"}]}]}], "]"}], " ", 
            "&"}], " ", "/@", "\n", "          ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"MapIndexed", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Append", "[", 
                   RowBox[{
                    RowBox[{"#2", " ", "-", " ", "1"}], ",", " ", "#1"}], 
                   "]"}], " ", "&"}], ",", " ", "probs", ",", " ", 
                 RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "1"}], "]"}], ",",
              " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Last", "[", "#", "]"}], " ", ">", " ", 
               RowBox[{"10", "^", 
                RowBox[{"-", "4"}]}]}], " ", "&"}]}], "]"}]}]}], "}"}], "]"}],
        ",", "\n", "       ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"j", ",", " ", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"j", " ", "key"}], ",", " ", "ecOrder"}], "]"}]}], 
               "}"}], " ", 
              RowBox[{
               RowBox[{"2", "^", "ecBits"}], "/", "ecOrder"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "0", ",", " ", 
               RowBox[{"ecOrder", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",",
            " ", "shots"}], "}"}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "13"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "7"}], "}"}]}], 
           "}"}]}]}], "]"}], ",", "\n", "       ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", 
            RowBox[{
             RowBox[{"2", "^", "ecBits"}], " ", "+", " ", "2"}]}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", " ", 
            RowBox[{
             RowBox[{"2", "^", "ecBits"}], " ", "+", " ", "2"}]}], "}"}]}], 
         "}"}]}], ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<c\>\"", ",", " ", "\"\<d\>\""}], "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "330"}], ",", "\n", "       ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<secret key = \>\"", ",", " ", "key", ",", 
           " ", "\"\<,   recovered: \>\"", ",", " ", 
           RowBox[{"Row", "[", 
            RowBox[{
             RowBox[{"shorRecover", "[", 
              RowBox[{"pub", ",", " ", "shots"}], "]"}], ",", 
             " ", "\"\<, \>\""}], "]"}]}], "}"}], "]"}]}]}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"BlockRandom", "[", 
