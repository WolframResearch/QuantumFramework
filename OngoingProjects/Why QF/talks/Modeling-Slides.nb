 CellID->1324119915,ExpressionUUID->"2d3eff4d-962c-39a7-142e-0f1e904a97d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"concA2", " ", "=", " ", 
   RowBox[{"QuantumEntanglementMonotone", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"0", " ", 
         RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"\"\<-\>\"", ",", " ", 
            RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"\"\<-\>\"", ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]A", ",", " ", "\[Gamma]B"}], "}"}]}], ",", "\n", 
       "     ", 
       RowBox[{"QuantumState", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", "0",
           ",", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], "]"}], ",", " ", 
       "t"}], "]"}], ",", " ", "\"\<Concurrence\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Theta]sA2", ",", " ", "\[Gamma]BsA2"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "8"}], ",", " ", 
       RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
       RowBox[{"\[Pi]", "/", "3"}], ",", " ", 
       RowBox[{"5", " ", 
        RowBox[{"\[Pi]", "/", "12"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"3", "/", "10"}], ",", " ", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"deathA2", "[", 
    RowBox[{"\[Gamma]Bv_", ",", " ", "\[Theta]v_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]v", " ", ">", " ", 
       RowBox[{"\[Pi]", "/", "4"}]}], " ", "&&", " ", 
      RowBox[{"\[Gamma]Bv", " ", ">", " ", "0"}]}], ",", " ", 
     RowBox[{"First", "[", 
      RowBox[{"NSolveValues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", "t"}], "]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "\[Gamma]Bv"}], " ", "t"}], "]"}]}], ")"}]}], " ",
           "==", " ", 
          RowBox[{
           RowBox[{"Cot", "[", "\[Theta]v", "]"}], "^", "2"}]}], " ", "&&", 
         " ", 
         RowBox[{"t", " ", ">", " ", "0"}]}], ",", " ", "t", ",", " ", 
        "Reals"}], "]"}], "]"}], ",", " ", "None"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelA2", "[", "\[Gamma]Bv_", "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"concA2", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]A", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\[Gamma]B", " ", "->", " ", "\[Gamma]Bv"}], ",", " ", 
           RowBox[{"\[Theta]", " ", "->", " ", "#"}]}], "}"}]}], " ", "&"}], 
       " ", "/@", " ", "\[Theta]sA2"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.05"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"WorkingPrecision", " ", "->", " ", "20"}], ",", " ", 
     RowBox[{"Exclusions", " ", "->", " ", "None"}], ",", "\n", "    ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "0", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.035", "]"}], ",", " ", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", "#1", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"ColorData", "[", "97", "]"}], "[", 
                RowBox[{"First", "[", "#2", "]"}], "]"}], ",", " ", 
               RowBox[{"Point", "[", 
                RowBox[{"{", 
                 RowBox[{"#1", ",", " ", "0"}], "}"}], "]"}]}], "}"}], ",", 
             " ", "Nothing"}], "]"}], " ", "&"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"deathA2", "[", 
             RowBox[{"\[Gamma]Bv", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
            " ", "\[Theta]sA2"}]}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "Automatic", ",", " ", "Dashed", ",", " ", "Automatic", ",", " ", 
        "Automatic"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
         "&"}], " ", "/@", " ", "\[Theta]sA2"}], ")"}]}], ",", "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<A\>\""}], "]"}], ",", 
           " ", "\"\< t\>\""}], "}"}], "]"}], ",", 
        " ", "\"\<concurrence\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<B\>\""}], "]"}], ",", 
         " ", "\"\</\>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<A\>\""}], "]"}], ",", 
         " ", "\"\< = \>\"", ",", " ", "\[Gamma]Bv"}], "}"}], "]"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsA2", " ", "=", " ", 
   RowBox[{"panelA2", " ", "/@", " ", "\[Gamma]BsA2"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "panelsA2"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "660"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Last", "[", 
        RowBox[{"First", "[", "panelsA2", "]"}], "]"}], ",", " ", 
       RowBox[{"PointLegend", "[", 
        RowBox[{
         RowBox[{"{", "Gray", "}"}], ",", " ", 
         RowBox[{"{", "\"\<entanglement dies\>\"", "}"}], ",", " ", 
         RowBox[{"LegendMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "9"}], "}"}]}]}], 
        "]"}]}], "}"}], "]"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:= ",
 CellID->1978785535,ExpressionUUID->"302e0d1a-396c-30f4-361b-c7db92962f49"],

Cell[TextData[{
 "It vanishes once ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["A", "TI"]], 
      StyleBox["t", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["B", "TI"]], 
      StyleBox["t", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "265b0132-b686-cd53-5801-8270aac48673"],
 " reaches ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cot",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1afd75b6-4bbe-cb70-6815-da1f95e05293"],
 ". That needs both qubits to decay and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ">", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b09dcd0-48b4-367d-664b-064881127a66"],
 ", where ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], 
      StyleBox["e", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e10a14e-4bb8-dcb2-75f0-a01d1784629a"],
 " outweighs ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], 
      StyleBox["g", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a51875e-82a1-1afd-128f-db4ed6748038"],
 ": those states lose all their entanglement at a finite time and never \
regain it, and the more slowly B decays, the later that time comes. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "\[LessEqual]", "\[Pi]", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "302f1efe-f38b-6119-34d5-493184a6e994"],
 " (the boundary case ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd3e988-9251-7ef5-2f3f-3a8a99569e09"],
 " is dashed), or if B does not decay, the entanglement only fades."
}], "Text",
 CellID->2016628702,ExpressionUUID->"13c50911-dabf-e503-284f-642dd8d759d9"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->96606702,ExpressionUUID->"49803dd5-17c8-783c-147e-e36c46dd18f7"],

Cell["\<\
Two atoms in a shared field: superradiance, subradiance and a dark state\
\>", "Subsection",
 CellID->1721132978,ExpressionUUID->"01f0bd29-2a33-e33a-4ff3-c6974cca5bee"],

Cell[TextData[{
 "Two identical atoms, frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d9ad4df-f045-62e1-1ecd-ade4fa0c2546"],
 ", sit close enough to radiate into the same field modes, so each decays at \
rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "142b6be3-68eb-8ce5-2f57-4989d160047d"],
 " and the field correlates their emission with strength ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["r", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35a4e461-5c60-d855-0a5b-709cdddec45e"],
 ". Which states radiate faster or slower than a lone atom, and can one stop \
radiating altogether?"
}], "Text",
 CellID->2121435355,ExpressionUUID->"476da040-ccec-38f3-0339-347eb14ea7f0"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23815da9-7b4b-7462-2dab-b8a707c45bcd"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c35610a-bc62-6ef0-7695-79841c27df56"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16fc5fc2-664a-bb55-29b0-59cf839b1c51"],
 ", the Lindblad equation in Kossakowski form, with rate matrix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "(", GridBox[{
     {"1", 
      StyleBox["r", "TI"]},
     {
      StyleBox["r", "TI"], "1"}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1362d513-07b5-d236-3f26-cfb374b2d250"],
 ", is"
}], "Text",
 CellID->1035562367,ExpressionUUID->"67c70cb6-1b45-aa62-544f-1ed746e749a2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       StyleBox["\[Omega]", "TI"], "2"], "(", 
      RowBox[{
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"], "1"], "+", 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], 
        StyleBox["z", "TI"], "2"]}], ")"}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    StyleBox["\[Gamma]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      RowBox[{
       StyleBox["j", "TI"], "=", "1"}]}], "2",
     LimitsPositioning->False], 
    SubscriptBox[
     RowBox[{"(", GridBox[{
        {"1", 
         StyleBox["r", "TI"]},
        {
         StyleBox["r", "TI"], "1"}
       }], ")"}], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "(", 
    RowBox[{
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "-", 
      StyleBox["i", "TI"]], 
     StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "+", 
      StyleBox["j", "TI"]], "-", 
     FractionBox["1", "2"], "{", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "+", 
        StyleBox["j", "TI"]], 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["\[Sigma]", "TI"], "^"], "-", 
        StyleBox["i", "TI"]]}], ",", 
      StyleBox["\[Rho]", "TI"]}], "}"}], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1623037933,ExpressionUUID->"14895ca5-73c6-2626-55c6-571f64c33380"],

Cell[TextData[{
 "and in the frame rotating at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04a83674-c538-d948-292c-8e5813da26bb"],
 " the Hamiltonian drops out; the field's coherent exchange between the atoms \
only shifts the energies of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["T", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44389583-018c-c855-4a66-8cb65abd80d0"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["S", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1052be48-b6ab-5c0f-5c42-c3f271ff7413"],
 " below, without mixing them, so it leaves ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["N", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e67c588-a37b-b49d-2635-8b9e7a17ce0c"],
 " unchanged and is left out."
}], "Text",
 CellID->1723954199,ExpressionUUID->"1f800fe0-b0ec-3442-3238-1401708852ae"],

Cell[TextData[{
 "The rate matrix enters as it stands, and the solution for general ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5629b47f-3231-2bdc-24c2-cc0340fe4d53"],
 " gives the mean number of excited atoms, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["N", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], "[", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "1"], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "]", "=", "2", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox[
      RowBox[{"e", "e"}], "TI"], ",", 
     StyleBox[
      RowBox[{"e", "e"}], "TI"]}]], "+", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox[
      RowBox[{"e", "g"}], "TI"], ",", 
     StyleBox[
      RowBox[{"e", "g"}], "TI"]}]], "+", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    RowBox[{
     StyleBox[
      RowBox[{"g", "e"}], "TI"], ",", 
     StyleBox[
      RowBox[{"g", "e"}], "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d8c64f7-b1f9-2f8e-540c-53e535e02115"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["i", "TI"]], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["e", "TI"]},
     "Ket"], 
    SubscriptBox[
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"], 
     StyleBox["i", "TI"]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4994a442-5c78-28c3-76e9-1593c8132489"],
 ", from four initial states, with ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["T", "TI"]},
    "Ket"], ",", 
   RowBox[{
    TemplateBox[{
      StyleBox["S", "TI"]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           StyleBox["e", "TI"], 
           StyleBox["g", "TI"]}]},
        "Ket"], "\[PlusMinus]", 
       TemplateBox[{
         RowBox[{
           StyleBox["g", "TI"], 
           StyleBox["e", "TI"]}]},
        "Ket"]}], ")"}], "/", 
     SqrtBox["2"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3faebca9-451b-6822-02eb-51eda09a1c4d"],
 ". Each curve is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["N", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f14137f-52ff-5831-0c6f-67e0f67b2a9a"],
 " divided by its starting value ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["N", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657fb2a2-3607-381b-44fe-507c732e18ab"],
 ", 2 for ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], 
      StyleBox["e", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42f9a457-30d2-1f71-7175-093d7607898f"],
 " and 1 for the others, and the shading marks where a state decays faster \
(orange) or slower (blue) than a lone atom, whose ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["N", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bb98c94-79e9-3c5f-6984-4b4711b50907"],
 "; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f0db80d-c2f4-7e1c-2e24-57b828f32ed7"],
 ":"
}], "Text",
 CellID->76814079,ExpressionUUID->"75d64d34-151b-17b6-022a-57d617d2a7fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"statesA3", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<|ee\[RightAngleBracket]\>\"", " ", "->", " ", 
      RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<|T\[RightAngleBracket]\>\"", " ", "->", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<|S\[RightAngleBracket]\>\"", " ", "->", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"\"\<|eg\[RightAngleBracket]\>\"", " ", "->", " ", 
      RowBox[{"QuantumState", "[", "\"\<01\>\"", "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"excitationA3", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"ComplexExpand", " ", "@", " ", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{"QuantumEvolve", "[", 
             RowBox[{
              RowBox[{"QuantumOperator", "[", 
               RowBox[{"0", " ", 
                RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], ",", " ", 
              
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"QuantumOperator", "[", 
                  RowBox[{"\"\<-\>\"", ",", " ", 
                   RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
                 RowBox[{"QuantumOperator", "[", 
                  RowBox[{"\"\<-\>\"", ",", " ", 
                   RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], " ", "->", " ", 
               
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "r"}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"r", ",", " ", "1"}], "}"}]}], "}"}]}], ",", "\n", 
              "       ", "#", ",", " ", "t"}], "]"}], 
            "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "}"}],
            "]"}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"0", " ", "<=", " ", "r", " ", "<=", " ", "1"}], " ", "&&", 
        " ", 
        RowBox[{"t", " ", ">=", " ", "0"}]}]}], "]"}], " ", "&"}], " ", "/@", 
    " ", "statesA3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"perExcitationA3", " ", "=", " ", 
   RowBox[{
    RowBox[{"Values", "[", "excitationA3", "]"}], "/", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"superColorA3", ",", " ", "subColorA3"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RGBColor", "[", 
      RowBox[{"1", ",", " ", "0.55", ",", " ", "0.3"}], "]"}], ",", " ", 
     RowBox[{"RGBColor", "[", 
      RowBox[{"0.55", ",", " ", "0.75", ",", " ", "1"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelA3", "[", "rv_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "t"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"Filling", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Bottom", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Opacity", "[", "0.22", "]"}], ",", " ", 
              "superColorA3"}], "]"}]}], "}"}]}], "}"}]}]}], "]"}], ",", "\n",
      "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "t"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"Filling", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1.02", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Opacity", "[", "0.22", "]"}], ",", " ", "subColorA3"}],
              "]"}]}], "}"}]}], "}"}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Limit", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"r", " ", "->", " ", "rv"}]}], "]"}], " ", "&"}], " ", "/@",
          " ", "perExcitationA3"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4", ",", " ", "5", ",", " ", "1"}], 
          "}"}]}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.02"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "    ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Gamma] t\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[LeftAngleBracket]N\[RightAngleBracket] / \>\"", ",", 
           " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<N\>\"", ",", " ", "0"}], "]"}]}], "}"}], "]"}]}], 
       "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<r = \>\"", ",", " ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"TraditionalForm", "[", "rv", "]"}], ",", " ", 
           RowBox[{"FractionBoxOptions", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], "]"}]}], 
        "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"panelA3", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "760"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4", ",", " ", "5", ",", " ", "1"}], 
            "}"}]}], ",", " ", 
          RowBox[{"Keys", "[", "statesA3", "]"}], ",", " ", 
          RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
         " ", 
        RowBox[{"Spacer", "[", "30", "]"}], ",", "\n", "     ", 
        RowBox[{"SwatchLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Opacity", "[", "0.22", "]"}], ",", " ", 
              "superColorA3"}], "]"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Opacity", "[", "0.22", "]"}], ",", " ", "subColorA3"}],
              "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<faster than a lone atom: superradiant\>\"", ",", 
            " ", "\"\<slower than a lone atom: subradiant\>\""}], "}"}], ",", 
          " ", 
          RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}]}], 
       "}"}], "]"}], ",", " ", "Below"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",
 CellID->440008987,ExpressionUUID->"55628adf-9976-862f-060b-93bddbc4e975"],

Cell[TextData[{
 "Without correlation, at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f2cad1-2d28-be8b-738e-2331e08b221d"],
 ", the atoms decay independently and all four curves, ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], 
      StyleBox["e", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29e15c43-7f2a-65e6-784c-1973ea0e2d66"],
 " per excitation included, lie on that of a lone atom, so they show as one \
curve. Correlation makes the symmetric state superradiant, decaying faster \
than a lone atom, and the antisymmetric one subradiant, decaying slower: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["T", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", 
      StyleBox["r", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008a9969-fafa-548f-4950-d7bbcb815086"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["N", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox["S", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["r", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e45858b-f417-109f-5c66-e640756095cd"],
 ". At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61cf67e9-78a0-794f-441c-132dcfb78a2c"],
 " the singlet is dark, so ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], 
      StyleBox["g", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66091024-4d8c-c18f-237e-cb7454dc813c"],
 ", half singlet, keeps half an excitation, while ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], 
      StyleBox["e", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca52c19-d065-a7a6-3922-a9cb95cda10a"],
 " empties completely and, per excitation, faster than a lone atom."
}], "Text",
 CellID->2121350252,ExpressionUUID->"21baade4-7c78-a882-1381-9bda6a5b3838"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->751547568,ExpressionUUID->"59d23b1d-9357-84e4-6f3f-56218ae201f7"],

Cell["\<\
Master equation, Kraus channels and a circuit: one Ramsey fringe\
\>", "Subsection",
 CellID->1805299078,ExpressionUUID->"1ff3fc88-ec7d-8662-5c52-03d93b9e019e"],

Cell[TextData[{
 "A Ramsey experiment applies a Hadamard to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["g", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49a718a6-82e8-5bf7-6e42-7ce8bd5bca7f"],
 ", waits a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bae7bf8-264d-d9f8-26ee-0bbcb7d823e5"],
 ", applies a second Hadamard and reads ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["e", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7684963b-5340-9feb-012b-640977cc8ad3"],
 ". During the wait the qubit, detuned by ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b72da4-c507-7a86-2980-70ecbf7c55b7"],
 " from the drive, decays at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69b23402-99c5-da95-5dc1-37e48235bcda"],
 " and dephases at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e0a56f0-3ce5-65a0-07f2-8d84062efd12"],
 ", and a residual drive of Rabi frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a954723-5789-a39a-7b2f-de9e2c615325"],
 " may act. Device simulators model such a wait not with a master equation \
but as a circuit: a gate followed by textbook noise channels. When do the two \
give the same fringe?"
}], "Text",
 CellID->1307459721,ExpressionUUID->"3b598168-22ce-7f7c-32c3-14becd5ee445"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38e161a1-c5ad-4ae6-663b-cc7b00b52f58"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44f7e541-86a6-f789-34d7-8ff415a67e7c"],
 " (the state the amplitude-damping channel relaxes to), ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe7d0-8566-2a10-690f-2fdd6ef274fc"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d71981-ee63-897f-19d2-9af1566c8ec9"],
 ", qubit frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad158dc-db46-8d0e-4fce-3be85f8bb3ea"],
 " and drive frequency ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["d", "TI"]], "=", 
   StyleBox["\[Omega]", "TI"], "-", 
   StyleBox["\[Delta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15c55c24-a64e-8660-65f6-a656c0807634"],
 ", the wait obeys, in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd805e3-13f3-f806-25bc-179555cf9a36"],
 ","
}], "Text",
 CellID->246421316,ExpressionUUID->"64dc62d1-bcfe-30de-1c69-e48f850b9eff"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       StyleBox["\[Delta]", "TI"], "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["z", "TI"]], "+", 
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       OverscriptBox[
        StyleBox["\[Sigma]", "TI"], "^"], 
       StyleBox["x", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1060885634,ExpressionUUID->"5b557d11-8ee5-a080-7484-4d5ac4fbb4bd"],

Cell[TextData[{
 "The circuit cuts the wait into ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "554879f6-fe09-4335-6c8a-5257c390f718"],
 " equal slices. Each slice is the unitary ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    StyleBox["t", "TI"], "/", 
    StyleBox["m", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4154fbf8-6e15-3e70-1d8e-6613456e3988"],
 ", then amplitude damping with decay probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["\[Gamma]", "TI"], "1"], 
     StyleBox["t", "TI"], "/", 
     StyleBox["m", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d5d5e05-a30a-c65a-33d6-54f945523deb"],
 ", then phase damping with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "1", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "4", 
     SubscriptBox[
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["\[Phi]", "TI"]], 
     StyleBox["t", "TI"], "/", 
     StyleBox["m", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0794453b-b1fb-9ba3-30ac-c625b0b4a180"],
 ", which shrinks the coherence by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "2", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]], 
    StyleBox["t", "TI"], "/", 
    StyleBox["m", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5edb409d-091c-dccf-06c9-5e0ff7b90352"],
 ", the same factor as the dephasing term. With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d81c886-4353-b7e5-7d20-d6c92a69ae2f"],
 " the whole wait is one gate and two channels, the usual circuit noise \
model. Larger ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6da49da4-598d-4d4e-054c-f2afa3f7eab8"],
 " follows the continuous evolution more closely."
}], "Text",
 CellID->1894213956,ExpressionUUID->"7846e2d4-f64f-3163-1d41-b45454f03838"],

Cell[TextData[{
 "Lines are the master equation, dots the circuit with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cdb73ba-a715-3779-2df3-a30830466d71"],
 " and squares with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "253567ba-d8cf-b3b2-3aa6-8832699698c1"],
 "; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18aec436-eceb-9b3f-2c9a-7568db74ab83"],
 ":"
}], "Text",
 CellID->1517395904,ExpressionUUID->"7b042fb9-7d38-a187-3a73-94a93fdf349d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hamA4", "[", 
    RowBox[{"\[Delta]_", ",", " ", "\[CapitalOmega]_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[Delta]"}], "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}]}], ";", " ", 
  RowBox[{"jumpsA4", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sliceA4", "[", 
    RowBox[{"h_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]1v_", ",", " ", "\[Gamma]\[CurlyPhi]v_"}], "}"}], ",", 
     " ", "\[Tau]_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"lu_", ",", " ", "lad_", ",", " ", "lpd_"}], "}"}]}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[Tau]", " ", "h"}], "]"}], ",", " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "lu"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"QuantumChannel", "[", 
      RowBox[{
       RowBox[{"\"\<AmplitudeDamping\>\"", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Gamma]1v"}], " ", "\[Tau]"}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "lad"}]}], "]"}], ",", " ", 
     RowBox[{"QuantumChannel", "[", 
      RowBox[{
       RowBox[{"\"\<PhaseDamping\>\"", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "4"}], " ", "\[Gamma]\[CurlyPhi]v", " ", "\[Tau]"}], 
          "]"}]}], "]"}], ",", " ", 
       RowBox[{"\"\<Label\>\"", " ", "->", " ", "lpd"}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pEA4", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"\[Rho]", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"viaMEA4", "[", 
    RowBox[{"h_", ",", " ", "\[Gamma]s_", ",", " ", "T_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"pEA4", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], "[", 
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{"h", ",", " ", 
       RowBox[{"jumpsA4", " ", "->", " ", "\[Gamma]s"}], ",", " ", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], "[", 
        RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "]"}], ",", " ", 
       "T"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"circuitA4", "[", 
    RowBox[{
    "h_", ",", " ", "\[Gamma]s_", ",", " ", "m_", ",", " ", "s_", ",", " ", 
     RowBox[{"labels_", " ", ":", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<U\>\"", ",", " ", "\"\<AD\>\"", ",", " ", "\"\<PD\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"group_", " ", ":", " ", "Catenate"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "\"\<H\>\"", "}"}], ",", " ", 
      RowBox[{"group", "[", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"sliceA4", "[", 
          RowBox[{"h", ",", " ", "\[Gamma]s", ",", " ", 
           RowBox[{"s", "/", "m"}], ",", " ", "labels"}], "]"}], ",", " ", 
         "m"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", "\"\<H\>\"", "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diagramsA4", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"circuitA4", "[", 
       RowBox[{
        RowBox[{"hamA4", "[", 
         RowBox[{"\[Delta]", ",", " ", "\[CapitalOmega]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[CurlyPhi]"}], "}"}], ",", 
        " ", "1", ",", " ", "t", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<e\>\"", ",", " ", "\"\<\[Minus]i H t\>\""}], "]"}], ",",
           " ", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<Amplitude\>\"", ",", " ", "\"\<damping\>\""}], 
             "}"}], ",", " ", 
            RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", 
          " ", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<Phase\>\"", ",", " ", "\"\<damping\>\""}], "}"}], ",",
             " ", 
            RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], "}"}],
         ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"QuantumCircuitOperator", "[", 
           RowBox[{"#", ",", " ", "\"\<slice\>\""}], "]"}], " ", "&"}], 
         "]"}]}], "]"}], "[", 
      RowBox[{"\"\<Diagram\>\"", ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "330"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"circuitA4", "[", 
       RowBox[{
        RowBox[{"hamA4", "[", 
         RowBox[{"\[Delta]", ",", " ", "\[CapitalOmega]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[CurlyPhi]"}], "}"}], ",", 
        " ", "8", ",", " ", "t", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<U\>\"", ",", " ", "\"\<AD\>\"", ",", 
          " ", "\"\<PD\>\""}], "}"}], ",", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"QuantumCircuitOperator", "[", 
           RowBox[{"#", ",", " ", "\"\<slice\>\""}], "]"}], " ", "&"}], 
         "]"}]}], "]"}], "[", 
      RowBox[{"\"\<Diagram\>\"", ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "760"}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"transferA4", "[", 
    RowBox[{"h_", ",", " ", "\[Gamma]s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalR]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"\[FormalS]", ",", " ", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Normal", "[", "\n", "      ", 
             RowBox[{
              RowBox[{
               RowBox[{"QuantumCircuitOperator", "[", 
                RowBox[{"sliceA4", "[", 
                 RowBox[{
                 "h", ",", " ", "\[Gamma]s", ",", " ", "\[FormalT]", ",", " ", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<U\>\"", ",", " ", "\"\<AD\>\"", ",", 
                    " ", "\"\<PD\>\""}], "}"}]}], "]"}], "]"}], "[", 
               RowBox[{"QuantumState", "[", "\[Rho]", "]"}], "]"}], 
              "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"Flatten", "[", "\[Rho]", "]"}], "}"}]}], "]"}], " ", "/.",
          " ", 
         RowBox[{"\[FormalT]", " ", "->", " ", "\[FormalS]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pointsA4", "[", 
    RowBox[{"T_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hm", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", "\"\<H\>\"", "]"}], 
         "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"hm", " ", ".", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"MatrixPower", "[", 
                 RowBox[{
                  RowBox[{"T", "[", 
                   RowBox[{"x", "/", "m"}], "]"}], ",", " ", "m"}], "]"}], 
                " ", ".", " ", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"hm", " ", ".", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", ".", 
                  " ", "hm"}], "]"}]}], ",", " ", "2"}], "]"}], " ", ".", " ",
              "hm"}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "4", ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"m", " ", "==", " ", "1"}], ",", " ", "0.2", ",", " ", 
           "0.4"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelA4", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Gamma]\[CurlyPhi]v_", ",", " ", "\[CapitalOmega]v_"}], "}"}],
      ",", " ", "\[Delta]v_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"me", " ", "=", " ", 
        RowBox[{"viaMEA4", "[", 
         RowBox[{
          RowBox[{"hamA4", "[", 
           RowBox[{"\[Delta]v", ",", " ", "\[CapitalOmega]v"}], "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "\[Gamma]\[CurlyPhi]v"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"T", " ", "=", " ", 
        RowBox[{"transferA4", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"hamA4", "[", 
            RowBox[{"\[Delta]v", ",", " ", "\[CapitalOmega]v"}], "]"}], "]"}],
           ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "\[Gamma]\[CurlyPhi]v"}], "}"}]}], 
         "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"pointsA4", "[", 
            RowBox[{"T", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[CapitalOmega]v", " ", "==", " ", "0"}], ",", " ", 
            RowBox[{"{", "1", "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "8"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", 
             RowBox[{"me", " ", "/.", " ", 
              RowBox[{"t", " ", "->", " ", "x"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "0", ",", " ", "4", ",", " ", "0.04"}], 
            "}"}]}], "]"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"Joined", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"True", ",", " ", "False", ",", " ", "False"}], "}"}]}], ",",
        " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "7"}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "11"}], "}"}]}], 
         "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<master equation\>\"", ",", 
            " ", "\"\<circuit, m = 1\>\"", ",", 
            " ", "\"\<circuit, m = 8\>\""}], "}"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[CapitalOmega]v", " ", "==", " ", "0"}], ",", " ", "2", 
            ",", " ", "3"}], "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}], ",", 
             " ", "\"\< t\>\""}], "}"}], "]"}], ",", " ", "\"\<P(e)\>\""}], 
         "}"}]}], ",", "\n", "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Delta]/\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}], ",", 
             " ", "\"\< = \>\"", ",", " ", "\[Delta]v"}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.96", ",", " ", "0.96"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"casesA4", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", "2"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsA4", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"panelA4", ",", " ", "casesA4", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "3", ",", " ", "8"}], "}"}], ",", " ", "1"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"diagramsA4", ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Manipulate", "[", 
      RowBox[{
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"PlotGrid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"First", " ", "/@", " ", 
             RowBox[{"panelsA4", "[", 
              RowBox[{"[", "c", "]"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "660"}]}], "]"}], ",", " ", 
         RowBox[{"legendBelow", "[", 
          RowBox[{"Last", "[", 
           RowBox[{"panelsA4", "[", 
            RowBox[{"[", 
             RowBox[{"c", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
        "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", ",", " ", "3", ",", " ", "\"\<case\>\""}], "}"}], ",", 
         " ", 
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"First", "[", "#2", "]"}], " ", "->", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 
                 RowBox[{"\"\<\[Gamma]\>\"", ",", 
                  " ", "\"\<\[CurlyPhi]\>\""}], "]"}], ",", " ", "\"\</\>\"", 
                ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}], ",", 
                " ", "\"\< = \>\"", ",", " ", 
                RowBox[{"#1", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                " ", "\"\<,  \[CapitalOmega]/\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}], ",", 
                " ", "\"\< = \>\"", ",", " ", 
                RowBox[{"#1", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], " ", "&"}],
            ",", " ", "casesA4"}], "]"}], ",", " ", "SetterBar"}], "}"}], ",",
        " ", 
       RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "}"}], 
   ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[6]:= ",
 CellID->1223813556,ExpressionUUID->"1184f576-568e-add5-7960-afc2b8bcbea4"],

Cell[TextData[{
 "Without a drive the two routes agree for every value of every parameter, \
because the rotation, the decay and the dephasing generators commute: the \
wait is exactly one rotation followed by two named channels. The fringe \
oscillates about ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["e", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b56e2bb-b1cc-c1d6-1293-0f879e0646c4"],
 " at the detuning, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "592a630a-2485-663b-2b64-d08771940efe"],
 " enters its decay only through ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1681f44d-2c3f-de71-50c1-e89afd18e4a3"],
 ". A drive during the wait stops the generators commuting, and the circuit \
approaches the master equation only as the wait is sliced finer."
}], "Text",
 CellID->1577573989,ExpressionUUID->"162ff05a-6489-545f-60f1-2d9726bda5ed"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->689611250,ExpressionUUID->"2f1dc953-04ad-6949-7306-adbd850d2c28"],

Cell["The quantum Zeno crossover as an exceptional point", "Subsection",
 CellID->1287491687,ExpressionUUID->"2262515e-f02d-be5e-1eb6-5f400f1cb9bd"],

Cell[TextData[{
 "A qubit is driven with Rabi frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d93277f-dd22-edbf-0447-d6ada2cb208a"],
 ", detuned by ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b4c7237-2d15-9d6c-34e0-e46c0a7c669f"],
 " from the drive, while a detector measures ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7daa4556-751a-ba77-1163-3680b38a4a74"],
 " at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "057b95be-e81e-1eb3-3148-0f16ca0b667a"],
 ". Weak watching damps the Rabi oscillation and strong watching freezes it; \
what happens to the dynamics at the crossover?"
}], "Text",
 CellID->976980945,ExpressionUUID->"48058b58-86ff-f9ab-3178-cc1d9d70d799"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dca1517-27e5-ef8c-1a0b-7c6c19cd47df"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25444a9d-2d86-1b53-683b-1ce7d419c6e0"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74c84243-311d-793c-13e1-342369e1383f"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff1467d-ce24-4306-229f-202ded5efbf2"],
 ", qubit frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1180dcd9-4e91-4d56-39c6-3c4f471015fc"],
 " and drive frequency ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "-", "\[CapitalDelta]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d84189b-da87-835f-0be3-583e064a0b9b"],
 ", the Hamiltonian in the frame rotating with the drive is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b174d95-327e-c344-7587-60e6352769c1"],
 ", and averaging over the detector record gives"
}], "Text",
 CellID->422269520,ExpressionUUID->"6d0ec827-43cf-f2ef-78b9-3a443cbdfdf8"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["H", "TI"], "^"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["k", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1078859116,ExpressionUUID->"6d8ac7bd-faff-723f-3a78-1d299205173d"],

Cell[TextData[{
 "Away from exceptional points, every solution is a sum of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"\[Lambda]", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "639560ae-eaa0-5e08-0af9-485277356060"],
 " over the eigenvalues ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53753557-9dad-942d-0663-5866754ee3bd"],
 " of the superoperator ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bc0a8d7-1583-37f0-01db-f87d0ef821e0"],
 ". At an exceptional point two eigenvalues and their eigenvectors coincide, \
so ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12655c9a-f9fd-87ea-797f-e1376069dc72"],
 " cannot be diagonalized; there the discriminant of its characteristic \
polynomial, with the steady state's root ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c6ed46d-2e5b-345b-4536-9d1766033091"],
 " divided out, vanishes."
}], "Text",
 CellID->1580990759,ExpressionUUID->"268bef87-edf5-f26f-7a1c-96125e1fa582"],

Cell[TextData[{
 "On resonance the Rabi pair solves ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "+", "2", 
   StyleBox["k", "TI"], 
   StyleBox["\[Lambda]", "TI"], "+", 
   SuperscriptBox["\[CapitalOmega]", "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "310d3b24-9453-eaf6-5b83-71c4a6abe0b8"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008107b7-740c-9f15-7e10-dca55e5a1cc9"],
 ": a damped oscillation for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5618099f-8ad4-f9f7-1e23-40636bd4809d"],
 ", and for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2969cfed-bd09-6ddf-6e4a-b1cedefe2951"],
 " two real rates, one of which, about ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04420d68-7afb-202e-654d-5d953c16485a"],
 ", slows as the watching grows stronger, the Zeno effect. The two meet at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "176642e1-5d43-5a58-3430-9c01995151be"],
 ". The discriminant of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d8e320-9244-8549-548a-c27c7deea9eb"],
 "'s characteristic polynomial, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "252c11bb-1734-31cf-0d3c-09619754f1fe"],
 " divided out, has a zero at some ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3438e129-4cef-f8ac-2950-033e5045a04f"],
 ", an exceptional point, only for:"
}], "Text",
 CellID->395337628,ExpressionUUID->"661b01fc-a01c-9112-2ce9-a5813ac2e19e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"liouA5", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Liouvillian\>\"", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "}"}], ",", " ", 
        
        RowBox[{"{", "k", "}"}]}], "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"discA5", " ", "=", " ", 
   RowBox[{"Discriminant", "[", 
    RowBox[{
     RowBox[{"Cancel", "[", 
      RowBox[{
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{
         RowBox[{"liouA5", " ", "/.", " ", 
          RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}]}], ",", " ", 
         "\[Lambda]"}], "]"}], "/", "\[Lambda]"}], "]"}], ",", " ", 
     "\[Lambda]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"TraditionalForm", "[", 
  RowBox[{
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{"Exists", "[", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"discA5", " ", "==", " ", "0"}]}]}], "]"}], ",", " ", 
     "\[CapitalDelta]", ",", " ", "Reals"}], "]"}], " ", "/.", " ", 
   RowBox[{"\[CapitalDelta]", " ", "->", " ", 
    RowBox[{"HoldForm", "[", 
     RowBox[{"\[CapitalDelta]", "/", "\[CapitalOmega]"}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[7]:= ",
 CellID->64637481,ExpressionUUID->"243debfd-d49a-f73d-1c50-bdcbd5fea316"],

Cell[TextData[{
 "The top row lets ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b1e4129-2654-ff51-281c-ce56b2b44535"],
 " be complex, so each exceptional point becomes an isolated zero of the \
discriminant ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["k", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "524555ae-c802-2bab-17e6-c9dafdfbf0c5"],
 ", marked by a dot at the center of its rings of constant ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["D", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "546528c8-d709-dda5-5113-6209e8a7a3b9"],
 ". The bottom row plots, on the same axis for real ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f5dc93a-3b89-8b85-2ec7-f3ead9609050"],
 ", the qubit's relaxation rate, the smallest nonzero ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Lambda]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c8b25dd-dac4-6798-1977-601a8d81c852"],
 " of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1d02d0-fd90-c6c4-1e23-9d8c993be093"],
 ", and its oscillation frequency, the largest ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      StyleBox["Im",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["\[Lambda]", "TI"]}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8b6ccd-6d35-bc8e-360d-bffbc55035e4"],
 "; dashed lines mark the real parts of the exceptional points, and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cc5d5fe-daa1-44cd-180d-a74dd22fc85e"],
 " and rates are in units of ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01813612-e95f-ec31-5aed-943eec8f1a23"],
 ":"
}], "Text",
 CellID->2093271564,ExpressionUUID->"350960f0-0412-b2b6-5348-c2f9876a1225"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]sA5", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", 
     RowBox[{"1", "/", "4"}], ",", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}], ",", " ", "1"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"epA5", "[", "\[CapitalDelta]v_", "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"ReIm", "[", 
      RowBox[{"k", " ", "/.", " ", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"discA5", " ", "/.", " ", 
            RowBox[{"\[CapitalDelta]", " ", "->", " ", "\[CapitalDelta]v"}]}],
            ")"}], " ", "==", " ", "0"}], ",", " ", "k"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{"First", "[", "#", "]"}], " ", ">", " ", "0"}], " ", "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
