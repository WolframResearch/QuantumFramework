Cell["Open quantum systems", "Section",
 CellID->633444251,ExpressionUUID->"57ac0905-17cb-d594-7b26-21f4df370fa9"],

Cell[TextData[{
 "The examples in this section move from one qubit to cavities and fields. A \
qubit relaxes and dephases (",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "043c6a49-2c40-6804-2a31-24712ddfa8b2"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cbaa588-6144-da35-66b9-e0fd0c5c367c"],
 "), is watched until the Zeno effect freezes it, or is held near a target \
population by switching its drive on and off. An atom in a cavity exchanges a \
photon with the field, shows collapse and revival, and emits the three-peaked \
Mollow spectrum. Cavity modes thermalize, settle into coherent states under a \
drive, or turn their light sub-Poissonian through a Kerr nonlinearity. Cat \
and NOON states lose their quantum features to loss and to a warm bath. \
Almost every case is a Lindblad equation written as a QF Hamiltonian plus \
jump operators. QF evolves the density matrix, WL solves the equations \
symbolically where it can, and the figure shows what the environment does."
}], "Text",
 CellID->2094125215,ExpressionUUID->"042d8526-542b-2564-4f69-b4838dee78e9"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->44134596,ExpressionUUID->"47cb90dd-6142-a18e-5e92-ac3b622d625c"],

Cell["One photon between an atom and a leaky cavity", "Subsection",
 CellID->1307007571,ExpressionUUID->"37b592a8-6a8e-790b-3396-990789286d60"],

Cell[TextData[{
 "An excited two-level atom, frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30cf53e1-f393-d878-6f80-784a7d41cbc1"],
 ", sits in an empty cavity, frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56995dc1-470e-9e77-7d85-62f13fbca634"],
 ". It hands its excitation to the field at coupling ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c22c29d-aac8-8f8c-56e4-b5748eb3a543"],
 ", decays on its own at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20991ed6-8dbb-80cb-25cb-af92b3f67f1d"],
 ", and the mirror leaks photons at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e17f7fb-ccf4-77a7-4831-e238c364207b"],
 ". Is the photon ever reabsorbed?"
}], "Text",
 CellID->525944366,ExpressionUUID->"263e1f2c-fb2c-f982-5d72-d96c97d1322e"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46252257-b0f5-c4ed-644c-249c331dd400"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60836150-e167-22fe-3618-eb959ed55545"],
 ", the Jaynes-Cummings Hamiltonian, and its form in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c805f55-2ffd-dd4a-5708-fdd11c577972"],
 ", are"
}], "Text",
 CellID->56923714,ExpressionUUID->"41f7b98d-6461-d82c-0bba-b84963e3b46d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox[
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["a", "TI"]], "2"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "+", 
    StyleBox["g", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "-"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "+"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}], ")", "\[ThickSpace]", "\[LongRightArrow]", 
    "\[ThickSpace]", 
    FractionBox["\[CapitalDelta]", "2"], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]], "+", 
    StyleBox["g", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "-"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], "+", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "^"], "+"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["a", "TI"]], "-", 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["c", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1498948129,ExpressionUUID->"11ab515c-f195-1c0f-4426-e281f13e40fe"],

Cell[TextData[{
 "and the losses enter through the Lindblad equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Gamma]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "+", 
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b4cb57b-ba00-092b-6d68-96013a28a784"],
 "."
}], "Text",
 CellID->1393935745,ExpressionUUID->"0864dc68-9a9a-2eb9-47fb-ce670b935f74"],

Cell[TextData[{
 "Starting from ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ec206f2-09f1-1d01-204f-7beb3545c53b"],
 ", the figure follows the excited-state population ",
 Cell[BoxData[
