Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    StyleBox["D", "TI"], "\[ThinSpace]", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], 
     StyleBox["z", "TI"], "2"], "+", 
    StyleBox["E", "TI"], "(", 
    RowBox[{
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], 
      StyleBox["x", "TI"], "2"], "-", 
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], 
      StyleBox["y", "TI"], "2"]}], ")", "+", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["B", "TI"], "(", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyTheta]", "\[ThinSpace]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], 
      StyleBox["z", "TI"]], "+", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyTheta]", "\[ThinSpace]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], 
      StyleBox["x", "TI"]]}], ")"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1968470284,ExpressionUUID->"2c90d22c-8c6c-7696-6fc6-76de645dbe66"],

Cell[TextData[{
 "The untilted spectrum is in closed form for general ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c152de4-59e0-6cd4-21d5-4027ebc0cdd1"],
 ", ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10904126-773a-7c33-3fcb-4d6a65dce17b"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Gamma]", "B"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65a6bdbd-5de3-823d-2b04-ae158495d03b"],
 "; the figure plots the three energy levels against the field for ",
 Cell[BoxData[
