Cell[TextData[{
 "A single ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0816412b-1f74-1696-56c6-e510b8e8f404"],
 "-level system, basis ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], ",", "\[Ellipsis]", ",", 
   TemplateBox[{
     RowBox[{
       StyleBox["d", "TI"], "-", "1"}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60256b1a-f0dd-7d90-212a-d66428a02605"],
 ", hides one marked level ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["w", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696a7cf2-38fe-8871-229d-fd00b4d0a15a"],
 ". An oracle flips the sign of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["w", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1ef4ec-e109-d1ac-442d-f90fa202371c"],
 ", and a diffusion step reflects the state about the uniform superposition \
",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["s", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234b7536-b5a5-d694-1852-055efa2fbd33"],
 ". How many oracle calls does it take to find ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6332dfe3-54dc-50f4-5b1d-d50462baba60"],
 "?"
}], "Text",
 CellID->1473594895,ExpressionUUID->"30b33bde-f767-fe3b-6022-deb4e1baf06b"],

Cell[TextData[{
 "Starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["s", "TI"]},
    "Ket"], "=", 
   RowBox[{
    StyleBox["F", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
