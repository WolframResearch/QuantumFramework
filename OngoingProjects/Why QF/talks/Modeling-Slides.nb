control qubits, and the four-qubit multiplier\>\"", ",", " ", "13", ",", " ", 
         
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Legended", "[", 
