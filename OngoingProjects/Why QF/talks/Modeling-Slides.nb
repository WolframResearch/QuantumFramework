Cell[TextData[{
 "The protocol runs for general ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d04a09e-622f-c6ee-4a8e-b072560bddbc"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37cd40e1-5262-ba39-7552-f14b92a3eb8d"],
 " with both record-controlled corrections, with one of them, and with none. \
Bob's Bloch vector comes out in closed form; each sphere draws it (dots) and \
the input's (dashed) along the inputs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", "4", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "232f1fff-4f18-8afc-6cf3-52c22edda8d6"],
 ", ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["\[Beta]", "TI"], "\[LessEqual]", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bed382c-a2ca-7ba3-7e7e-24bab20307de"],
 ":"
}], "Text",
 CellID->1921804624,ExpressionUUID->"59c8cb78-ef54-7058-035c-ff7d76961a04"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bobBloch", "[", "corrections_", "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumPartialTrace", "[", 
       RowBox[{
        RowBox[{"Replace", "[", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumCircuitOperator", "[", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
                RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
                RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
                RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
                RowBox[{"{", "1", "}"}], ",", " ", 
                RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", "corrections"}], 
             "]"}], "]"}], "[", "\n", "       ", 
           RowBox[{"QuantumTensorProduct", "[", 
            RowBox[{
             RowBox[{"QuantumState", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{"\[Beta]", "/", "2"}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{"Exp", "[", 
                  RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
                 RowBox[{"Sin", "[", 
                  RowBox[{"\[Beta]", "/", "2"}], "]"}]}]}], "}"}], "]"}], ",",
              " ", 
             RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}],
           ",", " ", 
          RowBox[{"m_QuantumMeasurement", " ", ":>", " ", 
           RowBox[{"m", "[", "\"\<State\>\"", "]"}]}]}], "]"}], ",", "\n", 
        "     ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
       "]"}], "[", "\"\<BlochVector\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", " ", "\[Phi]"}], "}"}], " ", "\[Element]", " ",
       "Reals"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"teleportPanel", "[", 
    RowBox[{"label_", ",", " ", "bob_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ResourceFunction", "[", "\"\<BlochSpherePlot\>\"", "]"}], "[",
         "]"}], ",", "\n", "   ", 
       RowBox[{"ParametricPlot3D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", "\[Beta]", "]"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"4", " ", "\[Beta]"}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Beta]", "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"4", " ", "\[Beta]"}], "]"}]}], ",", " ", 
           RowBox[{"Cos", "[", "\[Beta]", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Beta]", ",", " ", "0", ",", " ", "\[Pi]"}], "}"}], ",", 
         " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"ListPointPlot3D", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"bob", " ", "/.", " ", 
            RowBox[{"\[Phi]", " ", "->", " ", 
             RowBox[{"4", " ", "\[Beta]"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", " ", "0", ",", " ", "\[Pi]", ",", " ", 
             RowBox[{"\[Pi]", "/", "24"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"PointSize", "[", "0.03", "]"}]}]}], "]"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "240"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"label", ",", " ", 
           RowBox[{"TraditionalForm", "[", "bob", "]"}]}], "}"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", " ", 
       "13", ",", " ", 
       RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
      " ", "Top"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"teleportPanels", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"teleportPanel", "[", 
       RowBox[{"#1", ",", " ", 
        RowBox[{"bobBloch", "[", "#2", "]"}]}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<X and Z\>\"", ",", " ", "\"\<X only\>\"", ",", 
         " ", "\"\<Z only\>\"", ",", " ", "\"\<no correction\>\""}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "3"}], "}"}]}], ",", " ", 
           RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "3"}], "}"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "3"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", "}"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
           RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
           RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
           RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"{", "1", "}"}], ",", " ", 
           RowBox[{"{", "2", "}"}], ",", " ", 
           RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "3"}], "}"}]}], ",", " ", 
           RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "520"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<the protocol with both record-controlled corrections\>\"",
          ",", " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{"{", "teleportPanels", "}"}], "]"}], ",", " ", 
       RowBox[{"legendBelow", "[", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PointLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], "}"}], 
             ",", " ", 
             RowBox[{"{", "\"\<Bob's Bloch vector\>\"", "}"}], ",", " ", 
             RowBox[{"LegendMarkers", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "10"}], "}"}]}]}],
             "]"}], ",", "\n", "   ", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Directive", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", 
                " ", "Dashed"}], "]"}], "}"}], ",", " ", 
             RowBox[{"{", "\"\<input Bloch vector\>\"", "}"}]}], "]"}]}], 
          "}"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[72]:= ",
 CellID->287401270,ExpressionUUID->"62848188-8670-2939-251c-c536fd0829eb"],

Cell[TextData[{
 "With both corrections Bob's Bloch vector equals the input's for every ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24834d53-78cc-0f4c-6f8c-0845dc6bd2fb"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4df17d56-c958-c895-01a0-b6a5b5138959"],
 ". With only one correction, the Pauli Bob did not undo flips two Bloch \
components at random, so only the component it leaves unflipped survives and \
his dots collapse onto one axis. With neither, Bob holds the maximally mixed \
state at the center of the sphere."
}], "Text",
 CellID->263304192,ExpressionUUID->"504b60b9-5207-1ac5-6972-88abe9a01625"],

