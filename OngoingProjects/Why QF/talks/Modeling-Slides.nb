Cell[BoxData[{
 RowBox[{
  RowBox[{"dragB", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "5", "]"}]}], ";", " ", 
  RowBox[{"dragN", " ", "=", " ", 
   RowBox[{
    RowBox[{"SuperDagger", "[", "dragB", "]"}], " ", "@", " ", "dragB"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dragEnvelope", "[", "\[Tau]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Pi", "/", "\[Tau]"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"t", "/", "\[Tau]"}]}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dragH", "[", 
    RowBox[{
    "\[Alpha]_", ",", " ", "\[Tau]_", ",", " ", "\[Lambda]_", ",", " ", 
     "\[Delta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"dragN", " ", "@", " ", "dragN"}], " ", "-", " ", "dragN"}], 
      ")"}]}], " ", "-", " ", 
    RowBox[{"\[Delta]", " ", "dragN"}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"dragEnvelope", "[", "\[Tau]", "]"}], "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"dragB", " ", "+", " ", 
       RowBox[{"SuperDagger", "[", "dragB", "]"}]}], ")"}]}], " ", "-", "\n", 
    "    ", 
    RowBox[{"\[Lambda]", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"dragEnvelope", "[", "\[Tau]", "]"}], ",", " ", "t"}], "]"}], 
      "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Alpha]"}], ")"}]}], " ", "I", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SuperDagger", "[", "dragB", "]"}], " ", "-", " ", "dragB"}], 
      ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dragB2", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dragPops", "[", 
    RowBox[{"\[Tau]_", ",", " ", "\[Lambda]_", ",", " ", "\[Delta]_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"dragH", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "\[Tau]", ",", " ", "\[Lambda]", ",", 
         " ", "\[Delta]"}], "]"}], ",", " ", 
       RowBox[{"FockState", "[", 
        RowBox[{"0", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "\[Tau]"}], "}"}]}], "]"}], "[",
      "t", "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"drag\[Lambda]s", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0.5", ",", " ", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dragPanel", "[", 
    RowBox[{"\[Tau]_", ",", " ", "\[Delta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pops", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"dragPops", "[", 
          RowBox[{"\[Tau]", ",", " ", "#", ",", " ", "\[Delta]"}], "]"}], " ",
          "&"}], " ", "/@", " ", "drag\[Lambda]s"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"LogPlot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"3", " ", ";;"}], "]"}], "]"}], "]"}], " ", "&"}], " ",
            "/@", " ", "pops"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "\[Tau]"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Lambda] = \>\"", ",", " ", "#"}], "}"}], "]"}], 
             " ", "&"}], " ", "/@", " ", "drag\[Lambda]s"}], ")"}]}]}], "]"}],
        ",", "\n", "    ", 
       RowBox[{"LogPlot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"First", " ", "/@", " ", "pops"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "\[Tau]"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"\[Delta]", " ", "==", " ", "0"}], ",", " ", 
         RowBox[{"LogPlot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"First", " ", "@", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"QuantumEvolve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"dragEnvelope", "[", "\[Tau]", "]"}], "/", "2"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"dragB2", " ", "+", " ", 
                    RowBox[{"SuperDagger", "[", "dragB2", "]"}]}], ")"}]}], ",",
                  " ", 
                 RowBox[{"FockState", "[", 
                  RowBox[{"0", ",", " ", "2"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", " ", "0", ",", " ", "\[Tau]"}], "}"}]}], 
                "]"}], "[", "t", "]"}], "[", "\"\<ProbabilitiesList\>\"", 
              "]"}]}], "]"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "\[Tau]"}], "}"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", "Dotted"}]}], "]"}], ",", " ", 
         RowBox[{"Graphics", "[", "]"}]}], "]"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}], "]"}], ",", " ", 
          RowBox[{"Log", "[", "2", "]"}]}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<|\[Alpha]| t\>\"", ",", " ", "\"\<population\>\""}], 
         "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<|\[Alpha]|\[Tau] = \>\"", ",", " ", "\[Tau]", ",", 
           " ", "\"\<,   \[Delta]/|\[Alpha]| = \>\"", ",", " ", "\[Delta]"}], 
          "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dragPanels", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "10", ",", " ", "20"}], "}"}], ",", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"dragPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "10", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.05"}], ",", " ", "0", ",", " ", "0.05"}], "}"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", 
         RowBox[{"dragPanels", "[", "\[Tau]v", "]"}]}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{
        RowBox[{"dragPanels", "[", "5", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Tau]v", ",", " ", "10", ",", " ", "\"\<|\[Alpha]|\[Tau]\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"Keys", "[", "dragPanels", "]"}], ",", " ", "SetterBar"}], "}"}],
    ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[149]:= ",
 CellID->794174841,ExpressionUUID->"142541f7-b464-3bc2-426e-c7ac28432a74"],

Cell[TextData[{
 "The drive couples only neighboring levels, so leakage builds up through ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67159eb5-19da-afa5-0c21-bad10cb6c896"],
 " during the pulse; only the shortest pulse without DRAG keeps leaking to \
the end, and otherwise it peaks and partly returns. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48d6b023-64a3-d62b-2884-0a1349245a58"],
 " the population left outside the qubit drops by orders of magnitude, and a \
longer pulse lowers it further. Most of the remaining error is population \
left in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fc9f8b7-43ad-e7a4-5103-46b8036511e7"],
 ", which a resonant \[Pi] pulse on a two-level qubit would empty (dotted). \
The qubit transition is shifted by the ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4132f5bf-3382-3d6c-1727-1d72c5e20dde"],
 " level and, in the opposite direction, by the DRAG quadrature itself; for \
the longer pulses the two shifts nearly cancel at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a27b26a-7d4e-8d16-1182-50b220e92028"],
 ", and a detuning partly undoes what is left, a positive one without DRAG \
and a negative one at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7811d51c-c070-c93a-2f46-bdbfa7b27a28"],
 "."
}], "Text",
 CellID->223141827,ExpressionUUID->"5ce5834b-1a75-ba4f-3486-43dc717fedc8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1903017853,ExpressionUUID->"6a2c8ebf-b540-902e-1b69-5d6447370548"],

Cell["The CZ gate from two coupled transmons", "Subsection",
 CellID->1080461108,ExpressionUUID->"23b78ea0-9816-33f7-061f-f10bb60a26d4"],

Cell[TextData[{
 "Two transmons, frequencies ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444346f1-3510-03a9-7d84-2cd55545c236"],
 " and anharmonicities ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ecd39ec-edd2-5b23-3302-e246a480ab9e"],
 " (equal, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"], "=", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae762a1-ed40-eabc-48b1-f916f684e556"],
 ", in the figures), exchange excitations at coupling ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ff1f4a6-0439-8787-6a1d-9ed8ae844c3a"],
 ". A flux pulse tunes transmon 1 until ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b185977-ca6e-5702-32a9-a78480e9659a"],
 " is detuned by ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fbc77a4-f645-0d3e-3710-74af50edd377"],
 " from ",
 Cell[BoxData[
  TemplateBox[{"02"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08d4d2bf-fb0b-c16d-0d3b-9d5e5a4bcf09"],
 ", holds it there for a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7dfb8d-d3a4-c646-34b5-a295ad956981"],
 ", and tunes it back, both tunings taken as instant. How does this hold \
become a controlled-Z, and what does it need?"
}], "Text",
 CellID->354900717,ExpressionUUID->"59527f5b-d7e9-fde1-4b82-dc623cf74363"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1628d48a-dc75-2099-348c-845658708327"],
 " and three levels per transmon, the pair Hamiltonian is"
}], "Text",
 CellID->1246741540,ExpressionUUID->"315978c3-21d5-01d1-598f-d3d357e09c4f"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      RowBox[{
       StyleBox["j", "TI"], "=", "1"}], ",", "2"}],
     LimitsPositioning->False], "[", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["j", "TI"]], "\[ThinSpace]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], 
      StyleBox["j", "TI"]], "+", 
     FractionBox[
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["j", "TI"]], "2"], "\[ThinSpace]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], 
      StyleBox["j", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["n", "TI"], "^"], 
       StyleBox["j", "TI"]], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], "]", "+", 
    StyleBox["g", "TI"], "(", 
    RowBox[{
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "^"], "1", "\[Dagger]"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "^"], "2"], "+", 
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "^"], "2", "\[Dagger]"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "^"], "1"]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], 
     StyleBox["j", "TI"]], "=", 
    RowBox[{
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "^"], 
      StyleBox["j", "TI"], "\[Dagger]"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "^"], 
      StyleBox["j", "TI"]]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["\[Delta]", "TI"], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], "1"], "-", 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], "2"], "-", 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], "2"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1546959454,ExpressionUUID->"227c5351-14cd-24d8-4cf6-9ed84712d0b6"],

Cell[TextData[{
 "It conserves the total excitation number, so ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667a0dd3-9f4d-808f-4150-55c9d97934ee"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61d598c9-8cd7-d73b-5b10-7e27d1488a78"],
 " couple only to each other, and ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "681def9b-d178-c583-0723-6f702b338f45"],
 " only to ",
 Cell[BoxData[
  TemplateBox[{"02"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070e5c93-32ad-211b-504f-f8d86750c197"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"20"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af835b9-c053-ad77-03e1-d4e285b210cc"],
 ". Each transmon alone gives its states phases; the gate is what remains \
once they are removed, which for ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "436aef02-6b02-60bd-6f72-d31046d8d6b3"],
 " is the conditional amplitude ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   SubscriptBox[
    StyleBox["U", "TI"], 
    RowBox[{"11", ",", "11"}]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["arg",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["U", "TI"], 
       RowBox[{"01", ",", "01"}]], 
      SubscriptBox[
       StyleBox["U", "TI"], 
       RowBox[{"10", ",", "10"}]], "/", 
      SubscriptBox[
       StyleBox["U", "TI"], 
       RowBox[{"00", ",", "00"}]]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2177c6c6-882b-4136-097d-392077a20179"],
 "."
}], "Text",
 CellID->1977551557,ExpressionUUID->"5b20e3d6-00d0-519b-1c4c-46ac91cb268d"],

Cell[TextData[{
 "On resonance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d40304-ae6c-9f93-644b-917087c223ec"],
 ", the figure follows each computational state on all nine levels for one \
full swap, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "\[Pi]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SqrtBox["2"], "\[ThinSpace]", 
    StyleBox["g", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62e6f19b-a6a5-7de9-44aa-cc40616c1eb5"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d3a7644-8bb3-c3bd-1ce2-8233fb709520"],
 " and rates in units of ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "244bc6d1-8d84-91b7-24e4-4cce51119735"],
 ":"
}], "Text",
 CellID->1549167488,ExpressionUUID->"4ffcac68-9c51-de5b-3cc7-6b0942bb448c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"czLower", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ",", " ", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"czB1", ",", " ", "czB2"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"czLower", ",", " ", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], ",", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", " ", "czLower"}], 
      "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czDuffing", "[", 
    RowBox[{"bj_", ",", " ", "w_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nj", " ", "=", " ", 
       RowBox[{
        RowBox[{"Transpose", "[", "bj", "]"}], " ", ".", " ", "bj"}]}], "}"}],
      ",", " ", 
     RowBox[{
      RowBox[{"w", " ", "nj"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"a", "/", "2"}], " ", 
       RowBox[{"nj", " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{"nj", " ", "-", " ", 
          RowBox[{"IdentityMatrix", "[", "9", "]"}]}], ")"}]}]}]}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"czH", " ", "=", " ", 
   RowBox[{
    RowBox[{"czDuffing", "[", 
     RowBox[{"czB1", ",", " ", "\[Omega]1", ",", " ", "\[Alpha]1"}], "]"}], 
    " ", "+", " ", 
    RowBox[{"czDuffing", "[", 
     RowBox[{"czB2", ",", " ", "\[Omega]2", ",", " ", "\[Alpha]2"}], "]"}], 
    " ", "+", " ", 
    RowBox[{"g", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "czB1", "]"}], " ", ".", " ", "czB2"}], " ",
        "+", " ", 
       RowBox[{
        RowBox[{"Transpose", "[", "czB2", "]"}], " ", ".", " ", "czB1"}]}], 
      ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"czIndex", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"FromDigits", "[", 
        RowBox[{"#", ",", " ", "3"}], "]"}]}], " ", "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czU", "[", 
    RowBox[{"d_", ",", " ", "a_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "s", " ", 
     RowBox[{"N", "[", 
      RowBox[{"czH", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Omega]2", " ", "->", " ", "0"}], ",", " ", 
         RowBox[{"\[Alpha]1", " ", "->", " ", "a"}], ",", " ", 
         RowBox[{"\[Alpha]2", " ", "->", " ", "a"}], ",", " ", 
         RowBox[{"\[Omega]1", " ", "->", " ", 
          RowBox[{"a", " ", "+", " ", "d"}]}], ",", " ", 
         RowBox[{"g", " ", "->", " ", "1"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czCond", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"czIndex", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
       RowBox[{"czIndex", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"Arg", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"czIndex", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
           RowBox[{"czIndex", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}], "]"}]}], "]"}], "]"}], " ", 
        
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"czIndex", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], "]"}], ",", " ", 
            RowBox[{"czIndex", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], "]"}]}], "]"}], "]"}], "/", 
         RowBox[{"u", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"czIndex", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0"}], "}"}], "]"}], ",", " ", 
            RowBox[{"czIndex", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0"}], "}"}], "]"}]}], "]"}], "]"}]}]}], 
       "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"czSwap", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"\[Pi]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"czTimes", " ", "=", " ", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"0", ",", " ", "czSwap", ",", " ", "200"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czKet", "[", "l_", "]"}], " ", ":=", " ", 
   RowBox[{"Ket", "[", 
    RowBox[{"{", 
     RowBox[{"Row", "[", "l", "]"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czDynamics", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"us", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"czU", "[", 
          RowBox[{"0", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "&"}], " ",
         "/@", " ", "czTimes"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"czTimes", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", 
        "/@", " ", 
        RowBox[{"Join", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"czIndex", "[", "f", "]"}], ",", " ", 
                   RowBox[{"czIndex", "[", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}], 
                 "]"}], "]"}], "^", "2"}], " ", "&"}], " ", "/@", " ", "us"}],
             ",", " ", 
            RowBox[{"{", 
             RowBox[{"f", ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"2", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
           "]"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"czIndex", "[", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
                  RowBox[{"czIndex", "[", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", " ", "1"}], "}"}], "]"}]}], "]"}], 
                "]"}], "]"}], "^", "2"}], " ", "&"}], " ", "/@", " ", "us"}], 
           "}"}]}], "]"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"czTimes", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", 
        "/@", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"ReIm", "[", 
          RowBox[{"czCond", " ", "/@", " ", "us"}], "]"}], "]"}]}]}], "}"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czPopPanel", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"czDynamics", "[", "a", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
        "Dashed"}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", "\n", "   ", 
     
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
