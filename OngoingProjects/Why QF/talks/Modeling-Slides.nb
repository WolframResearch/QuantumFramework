  "6cf35c8e-cfec-ae35-7ab1-e0b667e35953"],
 "-point Fourier transform, each call applies"
}], "Text",
 CellID->1068696749,ExpressionUUID->"59132438-9749-e4de-3360-f13e072a6647"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["G", "TI"], "=", 
    StyleBox[
     RowBox[{"D", "O"}], "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["O", "TI"], "=", 
    RowBox[{"\|01d7d9", "-", 
     RowBox[{"2", 
      TemplateBox[{
        StyleBox["w", "TI"]},
       "Ket"], 
      TemplateBox[{
        StyleBox["w", "TI"]},
       "Bra"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["D", "TI"], "=", 
    RowBox[{
     RowBox[{"2", 
      TemplateBox[{
        StyleBox["s", "TI"]},
       "Ket"], 
      TemplateBox[{
        StyleBox["s", "TI"]},
       "Bra"]}], "-", "\|01d7d9"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["k", "TI"]], "=", 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         TemplateBox[{
           StyleBox["w", "TI"]},
          "Bra"], 
         SuperscriptBox[
          StyleBox["G", "TI"], 
          StyleBox["k", "TI"]], 
         TemplateBox[{
           StyleBox["s", "TI"]},
          "Ket"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1959810010,ExpressionUUID->"4bdc9406-8c8e-bdcf-5b2c-925bc51cb1fb"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6672e52f-57c8-5feb-7720-9cb251d2fe33"],
 " rotates the state in the plane of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["s", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf52b72-75f3-b79f-73ce-18711d9ff67e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["w", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1673fdbc-c7c9-d62f-7df5-e99dd360a517"],
 " by ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["arcsin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "/", 
    SqrtBox[
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[TildeTilde]", "2", "/", 
   SqrtBox[
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4130db30-11f5-5dd0-53d8-c1bd1922c958"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["k", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[NegativeThinSpace]", "(", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"2", 
     StyleBox["k", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["arcsin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "/", 
     SqrtBox[
      StyleBox["d", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16a8f8c2-e8d5-5b40-72ef-1a848ad4f11f"],
 ", which approaches ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"], "/", 
    SqrtBox[
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c468903-fa43-6ac9-58c9-40aee322f4c5"],
 " (dashed) as ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ae5327e-736f-7a41-45fa-05f1309d407d"],
 " grows, and reaching ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["w", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f50a70-9f43-7b71-0cd8-4f4a630393f6"],
 " takes about ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", "/", "4"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SqrtBox[
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5904f7d4-aed2-da6d-5efe-69a75cb31f10"],
 " calls."
}], "Text",
 CellID->1525685085,ExpressionUUID->"791c85ff-dcbf-d815-044c-6bbaf5e2fb9d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "189e915f-dc8e-eb83-3a73-31ec06897c9c"],
 " acts repeatedly with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cac12be-9096-6cfe-574b-fc940b581abf"],
 " for four qudit sizes, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5765a62b-347c-49af-5376-3c4f127b9141"],
 " is plotted against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   SqrtBox[
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32163a03-7af8-0f9d-0830-5387465d2465"],
 ":"
}], "Text",
 CellID->265065661,ExpressionUUID->"4125c907-8093-a1c5-4a31-e6ad31202847"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"quditSearch", "[", 
    RowBox[{"d_", ",", " ", 
     RowBox[{"w_", " ", ":", " ", "2"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"basis", " ", "=", " ", 
       RowBox[{"QuantumBasis", "[", 
        RowBox[{"{", "d", "}"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"step", " ", "=", " ", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{
                RowBox[{"1.", "/", "d"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], " ", "-", 
             " ", 
             RowBox[{"IdentityMatrix", "[", "d", "]"}]}], ",", " ", 
            RowBox[{"{", "1", "}"}], ",", " ", "basis"}], "]"}], " ", "@", 
          " ", 
          RowBox[{"QuantumOperator", "[", 
           RowBox[{
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{"1.", " ", "-", " ", 
              RowBox[{"2.", " ", 
               RowBox[{"UnitVector", "[", 
                RowBox[{"d", ",", " ", 
                 RowBox[{"w", " ", "+", " ", "1"}]}], "]"}]}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", "1", "}"}], ",", " ", "basis"}], "]"}]}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"First", "[", "#2", "]"}], " ", "-", " ", "1"}], ")"}],
              "/", 
             RowBox[{"Sqrt", "[", "d", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"#1", "[", "\"\<ProbabilitiesList\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"w", " ", "+", " ", "1"}], "]"}], "]"}]}], "}"}], " ", 
          "&"}], ",", "\n", "     ", 
         RowBox[{"NestList", "[", 
          RowBox[{"step", ",", " ", 
           RowBox[{
            RowBox[{"QuantumOperator", "[", 
             RowBox[{"\"\<Fourier\>\"", "[", "d", "]"}], "]"}], "[", 
            RowBox[{"QuantumState", "[", 
             RowBox[{
              RowBox[{"UnitVector", "[", 
               RowBox[{"d", ",", " ", "1"}], "]"}], ",", " ", "basis"}], 
             "]"}], "]"}], ",", " ", 
           RowBox[{"Floor", "[", 
            RowBox[{"1.6", " ", 
             RowBox[{"Sqrt", "[", "d", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quditSizes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"4", ",", " ", "16", ",", " ", "64", ",", " ", "256"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"quditSearch", " ", "/@", " ", "quditSizes"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<d = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], 
        " ", "/@", " ", "quditSizes"}], ")"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "u"}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "0", ",", " ", "1.6"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.05"}], ",", " ", "1.65"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.03"}], ",", " ", "1.04"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<k / \>\"", ",", " ", 
         RowBox[{"Sqrt", "[", "\"\<d\>\"", "]"}]}], "}"}], "]"}], ",", 
      " ", "\"\<P(w)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[86]:= ",
 CellID->317521864,ExpressionUUID->"7f487267-0724-4393-25e8-7688b51b158c"],

Cell[TextData[{
 "Every gate here acts on one ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c06e392-ed78-60f2-7815-adb8e834dce3"],
 "-level particle, so there is no second subsystem and no entanglement at any \
step, yet the marked level is found after a number of calls that grows as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06226acd-07a2-1140-45f4-36a71d7e9550"],
 ": in the rescaled time the curves close in on the dashed limit as ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c08b4e5-3abf-4711-35d9-0327a3551b0b"],
 " grows. The smallest qudit sits off the common curve because it starts a \
third of the way to ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["w", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ebfea39-c004-fea9-705c-a5b2bd024902"],
 " and turns by ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5356c2ed-c4e3-ef70-354e-300ecdc758fe"],
 " per call, so one call lands it on ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["w", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d358e04-5516-a8cc-273e-b9cff5d3da59"],
 " with certainty."
}], "Text",
 CellID->522725781,ExpressionUUID->"1a37524a-9261-dca1-7497-a6b0762fcac2"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->151458377,ExpressionUUID->"7224566b-d22f-13dc-63d8-6b6e83fbea47"],

Cell["An imported CHSH circuit reaches the Tsirelson value exactly", \
"Subsection",
 CellID->1317244748,ExpressionUUID->"72268926-92ff-02fe-071f-3048858ba4a4"],

Cell[TextData[{
 "A referee sends random bits ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c43cfd2-887a-2d84-4538-78ea6067eac2"],
 " to Alice and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "663ef19e-bf8a-8376-0713-73fb712363e6"],
 " to Bob, who share an entangled pair and answer with bits ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc71bc7-8aec-be1c-1fdd-5de30293c8bb"],
 " and ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b420e8c-2b72-fb2c-2b43-f83e1638f1cb"],
 "; they win when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "\[Wedge]", 
   StyleBox["y", "TI"], "=", 
   StyleBox["a", "TI"], "\[CirclePlus]", 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13cc3271-099d-e210-3638-aa6bd88e5fba"],
 ", which no classical strategy does more than ",
 Cell[BoxData[
  FractionBox["3", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "652f5b91-cfa0-574a-11fe-ab98a9a3a952"],
 " of the time. The strategy arrives as an OpenQASM 3 program in which Bob's \
measurement is set by a rotation angle ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Theta]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09c1daee-260a-aa58-03d6-9e85efecdce7"],
 ". How does the winning probability depend on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Theta]", "TI"], 
   StyleBox["B", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cec8839-bed3-784e-2885-1b168d647e0a"],
 "?"
}], "Text",
 CellID->1675044438,ExpressionUUID->"7c1331cc-9ddf-0f1f-71ea-2ddfc7c36893"],

Cell[TextData[{
 "The program prepares ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"00"},
      "Ket"], "+", 
     TemplateBox[{"11"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "149adde3-48fe-7bc2-5c52-99d2719fcbb0"],
 " on Alice's qubit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3285efe2-e134-85ee-4948-fb44060f5d0a"],
 " and Bob's ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53e13d99-020d-7755-15be-2c52acc7a6b1"],
 ", and puts ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["q", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["q", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31c3404d-2365-dd70-678a-281921d4dd8a"],
 " in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28b5bf02-4f71-d26f-235d-b50487e3cd48"],
 " so that measuring them supplies ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d5217d8-3be9-b219-468c-ac55ebf24f66"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e4ca058-8cb0-a9b7-5ec6-bd73b737eb06"],
 ". Alice applies a Hadamard to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bbe64c-6b1a-7c21-386b-5e047dc592fe"],
 " when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02175163-246f-0ed4-75dd-0459d815b2f9"],
 "; Bob applies ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["B", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox["B", "TI"]], ",", 
    RowBox[{"0", ",", "0"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49d467dd-79a5-6edd-0c90-f5e2bc371778"],
 " to ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["q", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11b4f26b-2c20-d69d-4050-2a59bad5dea7"],
 ", then a Hadamard when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["y", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d278cc4-c867-979a-539a-e1db9695aa63"],
 "; all four qubits are measured in ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2625256a-99db-36bf-20e9-c4bf27065703"],
 ", giving ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0123b0b1-abdf-5814-6d28-46f94a3efd96"],
 "."
}], "Text",
 CellID->845558184,ExpressionUUID->"78b44185-4f8d-6e9c-42bf-1c18571a2f65"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["B", "TI"]], "=", 
   StyleBox["k", "TI"], "\[Pi]", "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e99d02-6c7d-44ba-178d-b3a73efb6690"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["k", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", "16"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60e7220f-d893-1a74-7a9a-a267dbb81659"],
 ", the winning probability comes exactly from the joint outcome distribution \
of the program's circuit:"
}], "Text",
 CellID->647370967,ExpressionUUID->"4996b1a4-8e90-f1d7-287e-2f3c983cb6c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "chshProgram", " ", "=", 
   " ", "\"\<OPENQASM 3.0;\nqubit[4] q;\nbit[4] c;\nreset q[0];\nreset q[3];\n\
U(pi/2, 0, pi) q[3];\nU(pi/2, 0, pi) q[0];\nswap q[0], q[3];\nctrl(0) @ \
negctrl(1) @ U(pi/2, pi, pi) q[0], q[3];\nctrl(1) @ negctrl(0) @ U(pi/2, 0, \
0) q[0], q[3];\nreset q[1];\nU(pi/2, 0, pi) q[1];\nreset q[2];\nU(pi/2, 0, \
pi) q[2];\nctrl(1) @ negctrl(0) @ U(pi/2, 0, pi) q[1], q[0];\nU(THETAB, 0, 0) \
q[3];\nctrl(0) @ negctrl(1) @ U(pi/2, 0, pi) q[2], q[3];\nc[0] = measure \
q[0];\nc[1] = measure q[1];\nc[2] = measure q[2];\nc[3] = measure \
q[3];\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chshWin", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k", "/", "8"}], ",", " ", 
       RowBox[{"FullSimplify", " ", "@", " ", 
        RowBox[{"Probability", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BitAnd", "[", 
            RowBox[{"xBit", ",", " ", "yBit"}], "]"}], " ", "==", " ", 
           RowBox[{"BitXor", "[", 
            RowBox[{"aBit", ",", " ", "bBit"}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "aBit", ",", " ", "xBit", ",", " ", "yBit", ",", " ", "bBit"}], 
            "}"}], " ", "\[Distributed]", "\n", "       ", 
           RowBox[{
            RowBox[{
             RowBox[{"QuantumCircuitOperator", "[", 
              RowBox[{"StringReplace", "[", 
               RowBox[{"chshProgram", ",", " ", 
                RowBox[{"\"\<THETAB\>\"", " ", "->", " ", 
                 RowBox[{
                  RowBox[{"ToString", "[", "k", "]"}], " ", "<>", 
                  " ", "\"\<*pi/8\>\""}]}]}], "]"}], "]"}], "[", "]"}], 
            "[", "\"\<MultivariateDistribution\>\"", "]"}]}]}], "]"}]}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "16"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chshBest", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"MaximalBy", "[", 
     RowBox[{"chshWin", ",", " ", 
      RowBox[{"N", " ", "@*", " ", "Last"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"chshProgram", ",", " ", 
           RowBox[{"\"\<THETAB\>\"", " ", "->", " ", "\"\<pi/4\>\""}]}], 
          "]"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "600"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<the imported OpenQASM program, at \[Theta]_B = \[Pi]/4\>\
\"", ",", " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"chshWin", ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "9"}], "}"}]}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", "\"\<imported program\>\"", "}"}]}]}], "]"}], ",", 
       "\n", " ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "/", "4"}], ",", " ", 
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{"\[Pi]", " ", "u"}], " ", "-", " ", 
               RowBox[{"\[Pi]", "/", "4"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", 
               RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}]}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Dotted", ",", " ", "Dashed"}], "}"}]}], ",", "\n", "  ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<classical bound 3/4\>\"", ",", " ", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"HoldForm", "[", 
              RowBox[{
               RowBox[{"1", "/", "2"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"Subscript", "[", 
                   RowBox[{"\[Theta]", ",", " ", "\"\<B\>\""}], "]"}], " ", "-",
                   " ", 
                  RowBox[{"\[Pi]", "/", "4"}]}], "]"}], "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", 
                  RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], "]"}], 
             "]"}]}], "}"}]}]}], "]"}], ",", "\n", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.05"}], ",", " ", "2.05"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<B\>\""}], "]"}], ",",
              " ", "\"\</\[Pi]\>\""}], "}"}], "]"}], ",", 
          " ", "\"\<winning probability\>\""}], "}"}]}], ",", "\n", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<largest: \>\"", ",", " ", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"Last", "[", "chshBest", "]"}], "]"}], ",", 
             " ", "\"\<  at  \>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<B\>\""}], "]"}], ",",
              " ", "\"\</\[Pi] = \>\"", ",", " ", 
             RowBox[{"First", "[", "chshBest", "]"}]}], "}"}], "]"}], ",", 
          " ", "13", ",", " ", 
          RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "460"}]}], "]"}]}], "}"}], ",", 
   " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[87]:= ",
 CellID->1240404855,ExpressionUUID->"121e946c-de71-277d-329c-8ab22d0552e9"],

Cell[TextData[{
 "Every angle stays an exact multiple of ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15d9d06d-265c-c6c2-54a6-b65616655e07"],
 " through the import, so each probability is an exact number. The points lie \
on ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], "+", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox["B", "TI"]], "-", "\[Pi]", "/", "4"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3226e0c8-1edb-9048-3dd9-c27c14de2dce"],
 ", which beats the classical bound only for ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["B", "TI"]], "<", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07584593-010a-b8a2-59aa-286aac9db40e"],
 " and peaks at the Tsirelson value ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   FractionBox["\[Pi]", "8"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c13701f-ef58-b8d3-1118-f247b8f3437a"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["B", "TI"]], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f68ebec-2f2c-433d-1bab-073e34852f96"],
 "."
}], "Text",
 CellID->1529152894,ExpressionUUID->"563f1ffb-4198-34fe-6a73-74351f9de9a3"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1535025862,ExpressionUUID->"59f395f2-240b-ba52-4a32-746dbf19fddf"],

Cell["One site of an arbitrarily long Ising chain after a quench", \
"Subsection",
 CellID->42774844,ExpressionUUID->"5bea19b5-bd3d-e5e5-546b-e3a4346336fd"],

Cell[TextData[{
 "A chain of spins with coupling ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4daee53c-f11a-ea47-5aab-40c828ba3353"],
 " in a transverse field ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0225ff3d-18ee-04a9-0267-b253feadc0de"],
 " starts with every spin up, ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[CenterEllipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20389dfa-5216-2471-1f6e-bac1891b1501"],
 ", and evolves under the transverse-field Ising Hamiltonian, Trotterized \
with step ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Delta]", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f35f24b-370e-aacd-6cd8-23f832cb2c59"],
 ". What is the magnetization ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["c", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "269a704b-b29d-213a-4236-5ae3a0ecb95f"],
 " of a site deep inside the chain after ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58889802-5395-1eb9-60e9-2c67beea988f"],
 " steps?"
}], "Text",
 CellID->1789688384,ExpressionUUID->"15291b5e-d333-89ea-2fd8-98b8fe394f6b"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c0fa73a-ed22-7e61-3b26-718bbcf85491"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   StyleBox["J", "TI"], 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "+", "1"}]], "+", 
   StyleBox["h", "TI"], 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7322a58c-e839-556e-66b1-57096097538f"],
 ", and one step is ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Product]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubsuperscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["i", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["h", "TI"], "\[ThinSpace]", 
    StyleBox["\[Delta]", "TI"], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   UnderscriptBox["\[Product]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubsuperscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"Z", "Z"}], "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      RowBox[{
       StyleBox["i", "TI"], "+", "1"}]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["J", "TI"], "\[ThinSpace]", 
    StyleBox["\[Delta]", "TI"], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3640ba4c-1f91-c514-315d-99b213219aa4"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"Z", "Z"}], "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], "\[CurlyTheta]", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyTheta]", 
     StyleBox["Z", "TI"], "\[CircleTimes]", 
     StyleBox["Z", "TI"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b2592e6-a258-301f-263c-5625169a6f5c"],
 ". After ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc450d1-7ee9-e6cd-4b47-dadb902ad078"],
 " steps ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["c", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{"0"},
     "Bra"], 
    SuperscriptBox[
     StyleBox["U", "TI"], "\[Dagger]"], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["c", "TI"]], 
    StyleBox["U", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d58ea72-f7e4-dc76-7bc8-ca0598aea7ec"],
 ", and the first ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "563ec2b7-91e3-92fa-2256-bf7320cacff3"],
 " layer only multiplies ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[CenterEllipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b705e00-491e-973f-1f68-19e429d3e68d"],
 " by a phase, so every gate outside the sites ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["c", "TI"], "-", 
    StyleBox["d", "TI"], "+", "1"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["c", "TI"], "+", 
    StyleBox["d", "TI"], "-", "1"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "238b70e9-617d-8297-65ff-97adb6d81c46"],
 " cancels against its conjugate and a window of ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0777586c-ef26-e043-736a-3ff971ef8bf6"],
 " sites gives the value for a chain of any length."
}], "Text",
 CellID->1147270045,ExpressionUUID->"034c0975-7943-51c1-6f4a-01951299d327"],

Cell[TextData[{
 "The circuit runs from ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[CenterEllipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e32428-2268-2ef1-0fd9-2e8f971a725f"],
 " on a window of ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74e0305e-63ed-8f94-19ac-3844275be895"],
 " sites centered on ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55ecf6c2-866f-6ebb-3e3b-d44c56fe821d"],
 ", giving ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["c", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3752d952-b6e9-90c6-1242-fdbdce4ef295"],
 " for the ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d513af5-a744-fdeb-015d-ea85a200bce7"],
 "-site window (filled), a larger ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "+", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71c4130a-9716-3f1c-4a30-1f7331e953dd"],
 "-site window (open) and a smaller ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17f1fd73-7ebd-be52-0e0c-72cc5b43aca3"],
 "-site window (crosses), with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["t", "TI"], "=", "0.2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "588962be-5e31-89dc-4d9a-1b7349580b27"],
 ":"
}], "Text",
 CellID->620242300,ExpressionUUID->"68797abc-9bd2-c854-1f85-97174629b1c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lcJdt", " ", "=", " ", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lcQuench", "[", 
    RowBox[{"m_", ",", " ", "d_", ",", " ", "hJ_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumCircuitOperator", " ", "@", " ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"StringRepeat", "[", 
        RowBox[{"\"\<0\>\"", ",", " ", "m"}], "]"}], "}"}], ",", "\n", "    ", 
      RowBox[{"Flatten", " ", "@", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"\"\<R\>\"", "[", 
              RowBox[{
               RowBox[{"2", " ", "lcJdt"}], ",", " ", "\"\<ZZ\>\""}], "]"}], 
             " ", "->", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{
               RowBox[{"Range", "[", "m", "]"}], ",", " ", "2", ",", " ", 
               "1"}], "]"}]}], "]"}], ",", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"\"\<RX\>\"", "[", 
              RowBox[{"2", " ", "hJ", " ", "lcJdt"}], "]"}], " ", "->", " ", 
             RowBox[{"Range", "[", "m", "]"}]}], "]"}]}], "]"}], ",", " ", 
         "d"}], "]"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lcZ", "[", 
    RowBox[{"m_", ",", " ", "d_", ",", " ", "hJ_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"st", " ", "=", " ", 
       RowBox[{
        RowBox[{"lcQuench", "[", 
         RowBox[{"m", ",", " ", "d", ",", " ", "hJ"}], "]"}], "[", "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"st", "[", "\"\<Dagger\>\"", "]"}], "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<Z\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"m", " ", "+", " ", "1"}], ")"}], "/", "2"}], "}"}]}], 
          "]"}], "[", "st", "]"}], "]"}], "[", "\"\<Scalar\>\"", "]"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lcPanel", "[", "hJ_", "]"}], " ", ":=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lcJdt", " ", "d"}], ",", " ", 
           RowBox[{"lcZ", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"2", " ", "d"}], " ", "+", " ", "#"}], ",", " ", "d", ",",
              " ", "hJ"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"d", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "3", ",", " ", 
        RowBox[{"-", "3"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1.05"}], "}"}]}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "9"}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "18"}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"\"\<\[Times]\>\"", ",", " ", "14"}], "}"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "\"\<d - 1 sites\>\""}], "}"}], "]"}], ",", 
        " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "\"\<d + 3 sites\>\""}], "}"}], "]"}], ",", 
        " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "\"\<d - 3 sites\>\""}], "}"}], "]"}]}], 
       "}"}]}], ",", "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<J t\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<Z\>\"", ",", " ", "\"\<c\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}]}], "}"}]}], ",",
      " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<h/J = \>\"", ",", " ", "hJ"}], "}"}], "]"}]}], ",", " ", 
     
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lcPanels", " ", "=", " ", 
   RowBox[{"lcPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.5", ",", " ", "1", ",", " ", "2"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "lcPanels"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "lcPanels", "]"}], "]"}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[88]:= ",
 CellID->1269908674,ExpressionUUID->"49114493-1591-c589-2714-b1554ba4ecbc"],

Cell[TextData[{
 "At every depth the ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a72b9bb-ebd9-3b14-7ea4-ab3efdec5c84"],
 " and ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "+", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "310fee4b-012b-d755-29d5-70c46544cb5c"],
 " windows give the same magnetization, so each filled point is exact for a \
bulk site of an arbitrarily long chain, while the ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["d", "TI"], "-", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "074e67d7-d7df-b83a-3742-7c5950b6f013"],
 " window cuts into the light cone and departs from them, visibly at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"], "=", "0.4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ec3a26d-36e6-399c-77e0-76e057bb5d38"],
 ". The magnetization falls faster as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "/", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1430eb05-9778-a9b1-1752-c87b1a68bd19"],
 " grows, and at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "/", 
   StyleBox["J", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "796d5357-befa-8541-39a0-2ed21dcb8c15"],
 " it changes sign within the times shown."
}], "Text",
 CellID->1571622739,ExpressionUUID->"70b9c449-cc5b-edda-68b2-e0706935fc5a"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1202097284,ExpressionUUID->"6ec5a82a-b693-3d53-7296-841115aa3e68"],

Cell["The noise term in the syndrome equation of a watched code", "Subsection",
 CellID->1499647604,ExpressionUUID->"78193421-a125-d1b7-0e00-0c591ffe21b9"],

Cell[TextData[{
 "Three qubits carry the bit-flip code, each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32b66f41-5142-7bf6-18db-7dd123cb97ef"],
 ", and the stabilizers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "1"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16eb53ce-8f4d-fae1-0c64-bafb5ada5ede"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "2"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "422cb96e-04c5-fd39-0942-154767218475"],
 " are measured continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5050a27d-d3fc-328c-5cb0-dd0bb4f5ba81"],
 " by detectors of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fcaeca5-5bd2-4b94-768e-2c00324eeb92"],
 ". The four syndrome sectors ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69184e8a-0062-318e-29eb-1e09a648d96f"],
 ", with signs ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "302e4768-0d44-6ef1-71c0-0563075cf137"],
 " and projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox["j", "TI"]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], 
     RowBox[{
      StyleBox["j", "TI"], "1"}]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], 
     RowBox[{
      StyleBox["j", "TI"], "2"}]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a44d3fd-a0cb-a124-364a-726cbd9f02c2"],
 ", have probabilities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["j", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec5431e-86b9-625d-6ff0-952c3719bdd8"],
 ". Which term does the measurement record add to the equation for the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77f4d589-1855-a2d7-0adb-dfe619a7406b"],
 "?"
}], "Text",
 CellID->475123577,ExpressionUUID->"5378fac0-4801-224d-67be-70f26689537f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01c6f91a-a5ba-7f2c-36e4-1ebee7661a0e"],
 ", records ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["k", "TI"]], "=", "2", 
   SqrtBox[
    StyleBox[
     RowBox[{"\[Eta]", "\[Kappa]"}], "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], 
    StyleBox["k", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "437e7b0e-1bb9-ffa6-477e-7bf1d49492c5"],
 " and Wiener increments ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4564bf14-6db9-3ce9-49d8-6c06531c0ec9"],
 ", the state conditioned on the records obeys"
}], "Text",
 CellID->1360242628,ExpressionUUID->"2c18a3c2-18cb-e630-1841-8c8fbdbeac28"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["\[Gamma]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["\[Kappa]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "2",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], 
     StyleBox["k", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox[
      RowBox[{"\[Eta]", "\[Kappa]"}], "TI"]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "2",
     LimitsPositioning->False], "(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], 
      StyleBox["k", "TI"]], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["S", "TI"], "^"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], ")", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["k", "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->721967531,ExpressionUUID->"3a56d392-196d-47f0-35fa-c54257b08710"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["j", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ff70382-72f5-1bed-0802-cf7859832b68"],
 "."
}], "Text",
 CellID->14356621,ExpressionUUID->"2b7fdc69-a62d-41f4-0753-0e9cd1d28d2a"],

Cell[TextData[{
 "No matrix is ever built: ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43f6c3ad-c130-8ac2-4d6a-5a5fd1c1452d"],
 " is the most general element of the Pauli algebra, with 64 free \
coefficients, and requiring the identity for every coefficient turns the \
trace of ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox["\[CapitalPi]", "^"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d1e6cdc-071b-f54a-07cb-67c3a3f90c97"],
 " against each term into a combination of the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ecb6bd7-b4d8-0009-5aae-c62ec909c1d2"],
 ". The flip term, the averaged stabilizer back-action and the record's noise \
term of the four-number equation are:"
}], "Text",
 CellID->1281306675,ExpressionUUID->"518892aa-0ad7-4782-4a37-b8e0859995fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wsyGens", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "wsyX1", ",", " ", "wsyZ1", ",", " ", "wsyX2", ",", " ", "wsyZ2", ",", 
     " ", "wsyX3", ",", " ", "wsyZ3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyAlg", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", "wsyGens", "}"}]}], ",", " ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "**", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "**", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{"wsyGens", ",", " ", "2"}], "]"}]}], ")"}]}], ",", "\n", 
      "    ", 
      RowBox[{"\"\<Relations\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "**", " ", "#"}], " ", "-", " ", "1"}], " ", 
          "&"}], " ", "/@", " ", "wsyGens"}], ")"}]}]}], "|>"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyStab", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"wsyZ1", " ", "**", " ", "wsyZ2"}], ",", " ", 
     RowBox[{"wsyZ2", " ", "**", " ", "wsyZ3"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsySigns", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wsyProj", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", " ", "b_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"a", " ", 
        RowBox[{"wsyStab", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", "**", " ", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"b", " ", 
        RowBox[{"wsyStab", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "4"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wsyTr", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"8", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"NonCommutativeExpand", "[", 
         RowBox[{"w", ",", " ", "wsyAlg"}], "]"}], " ", "/.", " ", 
        RowBox[{"_NonCommutativeMultiply", " ", "->", " ", "0"}]}], ")"}], 
      " ", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{"wsyGens", " ", "->", " ", "0"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyRho", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"wsyA", "[", 
         RowBox[{"First", "[", "#2", "]"}], "]"}], " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#1", "]"}], " ", "<", " ", "2"}], ",", " ", 
          RowBox[{"Times", " ", "@@", " ", "#1"}], ",", " ", 
          RowBox[{"NonCommutativeMultiply", " ", "@@", " ", "#1"}]}], "]"}]}],
        " ", "&"}], ",", " ", 
      RowBox[{"Subsets", "[", "wsyGens", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyP", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"p", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", "4"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wsyInPops", "[", "tr_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{"wsyC", ",", " ", "4"}], "]"}], " ", ".", " ", "wsyP"}], " ", "/.",
     " ", 
    RowBox[{"First", "[", 
     RowBox[{"SolveAlways", "[", 
      RowBox[{
       RowBox[{"tr", " ", "==", " ", 
        RowBox[{
         RowBox[{"Array", "[", 
          RowBox[{"wsyC", ",", " ", "4"}], "]"}], " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"wsyTr", "[", 
             RowBox[{
              RowBox[{"wsyProj", "[", "#", "]"}], " ", "**", " ", "wsyRho"}], 
             "]"}], " ", "&"}], " ", "/@", " ", "wsySigns"}], ")"}]}]}], ",", 
       " ", 
       RowBox[{"Array", "[", 
        RowBox[{"wsyA", ",", " ", "64"}], "]"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyDrift", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"j", ",", " ", 
      RowBox[{"Simplify", "[", 
       RowBox[{"\[Gamma]", " ", 
        RowBox[{"wsyInPops", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"wsyTr", "[", 
             RowBox[{
              RowBox[{"wsyProj", "[", "j", "]"}], " ", "**", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", " ", "**", " ", "wsyRho", " ", "**", " ", "#"}], 
                " ", "-", " ", "wsyRho"}], ")"}]}], "]"}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"{", 
            RowBox[{"wsyX1", ",", " ", "wsyX2", ",", " ", "wsyX3"}], "}"}]}], 
          "]"}], "]"}]}], "]"}]}], "]"}], " ", "/@", " ", "wsySigns"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyFlipM", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"wsyDrift", ",", " ", 
      RowBox[{"{", "wsyP", "}"}]}], "]"}], " ", "/.", " ", 
    RowBox[{"\[Gamma]", " ", "->", " ", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyBack", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"j", ",", " ", 
      RowBox[{"\[Kappa]", " ", 
       RowBox[{"wsyInPops", "[", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"wsyTr", "[", 
            RowBox[{
             RowBox[{"wsyProj", "[", "j", "]"}], " ", "**", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", " ", "**", " ", "wsyRho", " ", "**", " ", "#"}], 
               " ", "-", " ", "wsyRho"}], ")"}]}], "]"}], " ", "&"}], " ", "/@",
           " ", "wsyStab"}], "]"}], "]"}]}]}], "]"}], " ", "/@", " ", 
    "wsySigns"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyMean", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"wsyInPops", "[", 
      RowBox[{"wsyTr", "[", 
       RowBox[{"#", " ", "**", " ", "wsyRho"}], "]"}], "]"}], " ", "&"}], " ",
     "/@", " ", "wsyStab"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyRecord", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"\[Eta]", " ", "\[Kappa]"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"wsyInPops", "[", 
          RowBox[{"wsyTr", "[", 
           RowBox[{
            RowBox[{"wsyProj", "[", "#1", "]"}], " ", "**", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#2", " ", "**", " ", "wsyRho"}], " ", "+", " ", 
              RowBox[{"wsyRho", " ", "**", " ", "#2"}]}], ")"}]}], "]"}], 
          "]"}], " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{"wsyInPops", "[", 
           RowBox[{"wsyTr", "[", 
            RowBox[{"#2", " ", "**", " ", "wsyRho"}], "]"}], "]"}], " ", 
          RowBox[{"wsyInPops", "[", 
           RowBox[{"wsyTr", "[", 
            RowBox[{
             RowBox[{"wsyProj", "[", "#1", "]"}], " ", "**", " ", "wsyRho"}], 
            "]"}], "]"}]}]}], ")"}]}], " ", "&"}], ",", " ", "wsySigns", ",", 
     " ", "wsyStab", ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyCheck", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"wsyRecord", " ", "==", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"\[Eta]", " ", "\[Kappa]"}], "]"}], " ", "wsyP", " ", 
      RowBox[{"(", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "wsySigns", "]"}], " ", "-", " ", 
         "wsyMean"}], "]"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyBar", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{
       RowBox[{"OverBar", "[", "\"\<s\>\"", "]"}], ",", " ", "#"}], "]"}], 
     " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyNoise", " ", "=", " ", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"\[Eta]", " ", "\[Kappa]"}], "]"}], " ", 
       RowBox[{"Subscript", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"First", "[", "#2", "]"}]}], "]"}], " ", 
       RowBox[{"HoldForm", "[", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"Simplify", "[", 
          RowBox[{"#1", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"\[Eta]", " ", "\[Kappa]"}], "]"}], " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"p", ",", " ", 
               RowBox[{"First", "[", "#2", "]"}]}], "]"}]}], ")"}]}], "]"}], 
         "]"}], "]"}]}], " ", "&"}], ",", " ", 
     RowBox[{"wsyRecord", " ", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{"wsyMean", " ", "->", " ", "wsyBar"}], "]"}]}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Style", "[", 
  RowBox[{
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", " ", 
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{"\"\<(\>\"", ",", " ", 
                   RowBox[{"#2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<, \>\"", ",",
                    " ", 
                   RowBox[{"#2", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<)\>\""}], 
                  "}"}], "]"}], ",", " ", 
                RowBox[{"TraditionalForm", "[", "#3", "]"}], ",", " ", 
                RowBox[{"TraditionalForm", "[", "#4", "]"}], ",", " ", 
                RowBox[{"Sequence", " ", "@@", " ", 
                 RowBox[{"(", 
                  RowBox[{"TraditionalForm", " ", "/@", " ", "#5"}], 
                  ")"}]}]}], "}"}], " ", "&"}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Range", "[", "4", "]"}], ",", " ", "wsySigns", ",", 
               " ", "wsyDrift", ",", " ", "wsyBack", ",", " ", "wsyNoise"}], 
              "}"}]}], "]"}], ",", "\n", "     ", 
           RowBox[{"{", 
            RowBox[{"\"\<sector j\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<(\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<s\>\"", ",", " ", "\"\<j1\>\""}], "]"}], ",", 
                " ", "\"\<, \>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<s\>\"", ",", " ", "\"\<j2\>\""}], "]"}], ",", 
                " ", "\"\<)\>\""}], "}"}], "]"}], ",", 
             " ", "\"\<flips (dt)\>\"", ",", 
             " ", "\"\<stabilizer back-action (dt)\>\"", ",", "\n", "      ", 
             
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<record (d\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<W\>\"", ",", " ", "1"}], "]"}], ",", 
                " ", "\"\<)\>\""}], "}"}], "]"}], ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<record (d\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<W\>\"", ",", " ", "2"}], "]"}], ",", 
                " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}], "]"}], ",", "\n",
          "    ", 
         RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"FrameStyle", " ", "->", " ", 
          RowBox[{"GrayLevel", "[", "0.75", "]"}]}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", 
         RowBox[{"Spacings", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1.5", ",", " ", "0.9"}], "}"}]}], ",", " ", 
         RowBox[{"Background", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", 
             RowBox[{"GrayLevel", "[", "0.93", "]"}], "}"}]}], "}"}]}], ",", 
         " ", 
         RowBox[{"ItemStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", "Bold", "}"}]}], "}"}]}]}], "]"}], ",", "\n", "   ", 
       
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{
                  RowBox[{"OverBar", "[", "\"\<s\>\"", "]"}], ",", 
                  " ", "\"\<k\>\""}], "]"}], ",", " ", "\"\< = Tr[\>\"", ",", 
                " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<S\>\"", ",", " ", "\"\<k\>\""}], "]"}], ",", 
                " ", "\"\<\[Rho]]\>\""}], "}"}], "]"}], ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"Riffle", "[", 
               RowBox[{
                RowBox[{"MapThread", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"#1", ",", " ", "\"\< = \>\"", ",", " ", 
                    RowBox[{"TraditionalForm", "[", "#2", "]"}]}], "}"}], 
                    "]"}], " ", "&"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"wsyBar", ",", " ", "wsyMean"}], "}"}]}], "]"}], ",",
                 " ", "\"\<,   \>\""}], "]"}], "]"}]}], "}"}], ",", "\n", 
           "     ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<record term = 2\>\"", ",", " ", 
                RowBox[{"Sqrt", "[", "\"\<\[Eta] \[Kappa]\>\"", "]"}], ",", 
                " ", "\"\< \>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<p\>\"", ",", " ", "\"\<j\>\""}], "]"}], ",", 
                " ", "\"\<(\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<s\>\"", ",", " ", "\"\<jk\>\""}], "]"}], ",", 
                " ", "\"\< \[Minus] \>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{
                  RowBox[{"OverBar", "[", "\"\<s\>\"", "]"}], ",", 
                  " ", "\"\<k\>\""}], "]"}], ",", 
                " ", "\"\<)  for every j, k\>\""}], "}"}], "]"}], ",", " ", 
             "wsyCheck"}], "}"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
         RowBox[{"Spacings", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0.8"}], "}"}]}]}], "]"}]}], "}"}], ",", 
     " ", "Center", ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "1.2"}]}], "]"}], ",", " ", "13", ",",
    " ", 
   RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[89]:= ",
 CellID->1431548280,ExpressionUUID->"4b3bd57b-76c8-794f-07cb-35a6a7c54bd2"],

Cell[TextData[{
 "The four-number equation is integrated from the code sector, three runs and \
the mean of 1000 against the mean from the flip term alone; time is in units \
of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "049562cf-1ff0-b998-509c-14ef5e079bff"],
 ":"
}], "Text",
 CellID->1958394592,ExpressionUUID->"6df01c3b-b796-a4ba-133b-3ebe850cf42c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wsyRun", "[", 
    RowBox[{"e_", ",", " ", "g_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Nest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dW", " ", "=", " ", 
               RowBox[{"RandomVariate", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"Sqrt", "[", "0.001", "]"}]}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"m", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
             "\n", "        ", 
             RowBox[{"#", " ", "+", " ", 
              RowBox[{"g", " ", 
               RowBox[{"#", " ", ".", " ", 
                RowBox[{"Transpose", "[", "wsyFlipM", "]"}]}], " ", "0.001"}],
               " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"Sqrt", "[", "e", "]"}], " ", "#", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"dW", " ", ".", " ", 
                  RowBox[{"Transpose", "[", "wsySigns", "]"}]}], " ", "-", 
                 " ", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"#", " ", ".", " ", "wsySigns"}], ")"}], " ", 
                    "dW"}], ",", " ", 
                   RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}]}]}], "]"}], 
           " ", "&"}], ",", " ", "#", ",", " ", "50"}], "]"}], " ", "&"}], ",",
        "\n", "     ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1.", ",", " ", "0.", ",", " ", "0.", ",", " ", "0."}], 
          "}"}], ",", " ", "m"}], "]"}], ",", " ", "400"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wsyPanel", "[", 
    RowBox[{"e_", ",", " ", "g_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"run", " ", "=", " ", 
        RowBox[{
         RowBox[{"wsyRun", "[", 
          RowBox[{"e", ",", " ", "g", ",", " ", "1000"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"flipsOnly", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"MatrixExp", "[", 
            RowBox[{"g", " ", "wsyFlipM", " ", "#"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"0", ",", " ", "20", ",", " ", "400"}], "]"}]}]}]}], "}"}], 
     ",", "\n", "   ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"run", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Mean", " ", "/@", " ", "run"}], ",", " ", "flipsOnly"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Thin", ",", " ", "Thin", ",", " ", "Thin", ",", " ", "Thick", ",", 
          " ", "Dashed"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<run 1\>\"", ",", " ", "\"\<run 2\>\"", ",", 
          " ", "\"\<run 3\>\"", ",", " ", "\"\<mean of 1000 runs\>\"", ",", 
          " ", "\"\<mean from the flip term alone\>\""}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "20"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Kappa] t\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<p\>\"", ",", " ", "\"\<code\>\""}], "]"}]}], "}"}]}], 
       ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "e", ",", 
           " ", "\"\<,   \[Gamma]/\[Kappa] = \>\"", ",", " ", "g"}], "}"}], 
         "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"wsyPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0.2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "0.1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "wsyPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "700"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"wsyPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[90]:= ",
 CellID->1957455654,ExpressionUUID->"0363108a-1e36-0c3c-5ddf-46cb13f51140"],

Cell["\<\
Each sector is pushed by its own probability times how far its signs sit from \
the running means, so the four probabilities form a closed equation, and the \
averaged back-action of the stabilizer measurement moves no probability. \
Conditioned on its record, each run jumps between near 0 and near 1, more \
sharply for the efficient detector, while the mean over runs follows the \
relaxation set by the flips alone, because the noise term has zero mean.\
\>", "Text",
 CellID->1884153554,ExpressionUUID->"37a8174d-0046-1a10-03fd-084c7d6e059f"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->517818842,ExpressionUUID->"47d66727-b4f3-1339-4e5d-a4aef222a392"],

Cell["\<\
Maximum-likelihood decoding: exact logical error rates of three codes\
\>", "Subsection",
 CellID->1218938536,ExpressionUUID->"4d5d9dd5-df36-47fd-66f9-ccefed88ac7b"],

Cell[TextData[{
 "A code stores one qubit in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a99e952-7cf1-5372-08b2-8222c2200e9d"],
 " physical qubits. Each qubit independently suffers ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cfa2d9e-7002-e71e-7337-8cd9c3b6c46c"],
 ", ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a79c5b6-e5ac-b1c7-42fe-b77bcdbcd03e"],
 " or ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ea292c8-1bb0-cf8a-3c1c-6e1d54ae036c"],
 " with probabilities ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["X", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79288f1b-42be-8541-34ff-5ecd1534df1f"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["Y", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33db73db-b829-9bec-27c0-98761626944b"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["Z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03ac0729-a1e6-4edd-7d31-83dce87cca06"],
 ", the checks are read without error, and a decoder turns the syndrome into \
a correction. How much lower is the probability ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f0ddc9f-cf08-9ed1-3eaa-c79c3250e28c"],
 " of a logical error when the decoder picks the most probable class of \
errors instead of the lightest error?"
}], "Text",
 CellID->355889803,ExpressionUUID->"3fc85774-de82-48f2-3579-9a342283e155"],

Cell["Each qubit passes through the Pauli channel", "Text",
 CellID->1368458383,ExpressionUUID->"694eccd4-1a90-6fae-0247-a2c2fdc9c87c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalE]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["X", "TI"]], "-", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["Y", "TI"]], "-", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["Z", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], "+", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["X", "TI"]], "\[ThinSpace]", 
    StyleBox["X", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox["X", "TI"], "+", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["Y", "TI"]], "\[ThinSpace]", 
    StyleBox["Y", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox["Y", "TI"], "+", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["Z", "TI"]], "\[ThinSpace]", 
    StyleBox["Z", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox["Z", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1863922772,ExpressionUUID->"2967fa7d-3582-ff49-3397-8d0d702d36b5"],

Cell[TextData[{
 "depolarizing when ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["X", "TI"]], "=", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["Y", "TI"]], "=", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["Z", "TI"]], "=", 
   StyleBox["p", "TI"], "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15e718b5-19e6-2180-48f4-53a9bb7b8530"],
 " and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58f8d424-24b5-bc01-20e0-31498b0c08a8"],
 "-biased here as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["X", "TI"]], "=", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["Y", "TI"]], "=", 
   StyleBox["p", "TI"], "/", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "083ce93b-0a33-5bce-6f78-4b284eedf86b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["Z", "TI"]], "=", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ab2581-e9be-640a-699a-f70012fb30ae"],
 ". An error ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d2d165c-85f2-d895-079f-60e897dc6bb9"],
 " on the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ea78762-ccd4-12bc-5d79-8851570d1e32"],
 " qubits has a syndrome, the checks it anticommutes with, and a class, the \
logical operators it anticommutes with. The lookup decoder answers each \
syndrome with the class of the lightest error that produces it; the \
maximum-likelihood decoder answers with the class of largest total \
probability. A round fails when the answer is not the class of the error that \
occurred:"
}], "Text",
 CellID->1239937202,ExpressionUUID->"42ae4916-4b37-049f-6a63-65be652fb5ae"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["L", "TI"]], "=", 
