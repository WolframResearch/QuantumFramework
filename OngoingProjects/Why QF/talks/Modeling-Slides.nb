  "34fafda1-7e1a-2939-6207-22665acc8bee"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0482ca77-db50-11e3-6cf0-203764fd711c"],
 " and tracing out the second spin gives ",
 Cell[BoxData[
