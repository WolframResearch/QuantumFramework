Cell[TextData[{
 "The two columns define an It\[OHat] process, sampled four times per panel \
from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["x", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "059efb31-b84e-3d08-0fcb-c94e57bcb335"],
 " and three times the zero-point variances, with ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47eb3988-cab3-4f3d-2f88-b9fe01075dca"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], 
    SuperscriptBox[
     StyleBox["\[Omega]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "381f533f-719a-a994-47ce-d5f0c8471f87"],
 ", time in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fcb2420-9478-c542-3c86-9fa1a25aaf81"],
 " and ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08482114-4b78-e1af-420a-18bfa0a278ed"],
 " dashed:"
}], "Text",
 CellID->2128371304,ExpressionUUID->"351064ee-2de7-4183-7689-5aea5fd7228b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaussRuns", "[", "\[Eta]0_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "4", "]"}], ";", " ", 
     RowBox[{
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"ItoProcess", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"gaussEqs", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
              RowBox[{"List", " ", "/@", " ", 
               RowBox[{"gaussEqs", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], " ",
             "/.", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "mx", ",", " ", "mp", ",", " ", "\[CapitalSigma]x", ",", " ", 
                "Cxp", ",", " ", "\[CapitalSigma]p"}], "}"}], " ", "->", " ", 
              
              RowBox[{"Through", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "mx", ",", " ", "mp", ",", " ", "\[CapitalSigma]x", ",", " ",
                   "Cxp", ",", " ", "\[CapitalSigma]p"}], "}"}], "[", "t", 
                "]"}], "]"}]}], "]"}]}], " ", "/.", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"m", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Omega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[HBar]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Lambda]", " ", "->", " ", "2"}], ",", " ", 
             RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}]}], "}"}]}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "mx", ",", " ", "mp", ",", " ", "\[CapitalSigma]x", ",", " ", 
              "Cxp", ",", " ", "\[CapitalSigma]p"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "0", ",", " ", 
              RowBox[{"3", "/", "2"}], ",", " ", "0", ",", " ", 
              RowBox[{"3", "/", "2"}]}], "}"}]}], "}"}], ",", " ", "t"}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.", ",", " ", "6.", ",", " ", "0.001"}], "}"}], ",", " ", 
        "4"}], "]"}], "[", "\"\<Paths\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussPanel", "[", 
    RowBox[{"\[Eta]0_", ",", " ", "runs_", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "label_", ",", " ", "f_", ",", " ", "range_", ",", " ", "grid_", ",", 
       " ", "legend_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"f", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
       " ", "runs", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "range"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"label", " ", "===", " ", "\"\<purity\>\""}], ",", " ", 
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "5", "]"}], ",", " ", 
        "Automatic"}], "]"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "    ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"grid", " ", "===", " ", "None"}], ",", " ", "Automatic", ",",
           " ", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"y", ",", " ", 
                RowBox[{"Directive", "[", 
                 RowBox[{
                  RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", 
                  "Dashed"}], "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"y", ",", " ", "0.2", ",", " ", "1", ",", " ", "0.2"}],
                "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "grid", "]"}], ",", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{"Gray", ",", " ", "Dashed", ",", " ", 
                RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], 
             "}"}]}], "]"}]}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"GridLinesStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], "]"}]}],
      ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Omega] t\>\"", ",", " ", "label"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]0", ",", 
         " ", "\"\<,   \[Mu] = 4\>\""}], "}"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"If", "[", 
       RowBox[{"legend", ",", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "4", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<run \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
              "&"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "4", "]"}]}], ",", " ", 
            RowBox[{"LegendMarkerSize", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"12", ",", " ", "8"}], "}"}]}], ",", " ", 
            RowBox[{"LabelStyle", " ", "->", " ", "9"}], ",", " ", 
            RowBox[{"Spacings", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"0.3", ",", " ", "0.1"}], "}"}]}], ",", " ", 
            RowBox[{"LegendFunction", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Framed", "[", 
                RowBox[{"#", ",", " ", 
                 RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
                 RowBox[{"FrameStyle", " ", "->", " ", 
                  RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
                 RowBox[{"FrameMargins", " ", "->", " ", "1"}]}], "]"}], " ", 
               "&"}], ")"}]}]}], "]"}], ",", " ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.02", ",", " ", "0.02"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Left", ",", " ", "Bottom"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rows", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"\[Eta]0", ",", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"runs", " ", "=", " ", 
             RowBox[{"gaussRuns", "[", "\[Eta]0", "]"}]}], "}"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"gaussPanel", "[", 
              RowBox[{"\[Eta]0", ",", " ", "runs", ",", " ", "#"}], "]"}], 
             " ", "&"}], " ", "/@", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<\:27e8x\:27e9\>\"", ",", " ", "First", ",", " ", 
                "All", ",", " ", "None", ",", " ", 
                RowBox[{"\[Eta]0", " ", "==", " ", 
                 RowBox[{"1", "/", "5"}]}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<purity\>\"", ",", " ", 
                RowBox[{
                 RowBox[{"1", "/", 
                  RowBox[{"(", 
                   RowBox[{"2", " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "5", "]"}], "]"}]}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}], "]"}]}], 
                   ")"}]}], " ", "&"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "1.05"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"Sqrt", "[", "\[Eta]0", "]"}], "}"}], ",", " ", 
                "False"}], "}"}]}], "}"}]}]}], "]"}]}], "]"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "5"}], ",", " ", "1"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PlotGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"First", "[", "rows", "]"}], "}"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "650"}]}], "]"}], ",", " ", 
       RowBox[{"PlotGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Show", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"AspectRatio", " ", "->", " ", 
               RowBox[{"1", "/", "2"}]}]}], "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Last", "[", "rows", "]"}]}], "}"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "650"}]}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"Spacings", " ", "->", " ", "0"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[39]:= ",
 CellID->950870772,ExpressionUUID->"19039b8f-cc04-91cc-39a3-5917fb331a84"],

Cell[TextData[{
 "The noise of all three widths is zero for every parameter: the four runs \
put the packet in four places, so the means fan out, but they give it the \
same widths at the same time, and the purity curves fall on one line. The \
widths obey the Riccati equation in the drift column, where the efficiency \
scales the information terms ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Eta]", "\[Lambda]"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00703dba-d4af-e948-0020-cf39517e85e5"],
 " but not the heating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67240142-8f71-6409-04d8-5c55a3f178c5"],
 ", and every steady state of that equation has purity ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "096e87b2-306b-b17d-78f9-5f83cab8fddc"],
 "."
}], "Text",
 CellID->514924614,ExpressionUUID->"78b688a0-2819-9046-1b7f-fe07342e01b1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->282462320,ExpressionUUID->"57ca06a7-70ce-7472-60c7-2b1f83248dc0"],

Cell["\<\
Continuous syndrome tracking: four numbers follow the records\
\>", "Subsection",
 CellID->1296424774,ExpressionUUID->"76daf830-b319-bf93-3d21-f1b7e86ebb90"],

Cell[TextData[{
 "Three qubits carry the bit-flip code, and each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "041ddcdc-c4f5-c5ca-6813-799f9cf94ffc"],
 ". The stabilizers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "1"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32e19613-dc0f-7a0e-0fcb-39023150cf98"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "2"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2f7884-f9a3-eff3-0311-a8188f076703"],
 " are measured weakly and continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "674d50ec-b2ef-7be0-7f90-55c4e3d871b4"],
 " by detectors of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d0fb94a-4d14-a717-128f-70f0a9cb7ec3"],
 ". Can four numbers, fed only these two noisy records, track the syndrome?"
}], "Text",
 CellID->584425926,ExpressionUUID->"51d431e2-4d30-ac91-6db7-9bbf51cf8bb4"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    OverscriptBox[
     StyleBox["c", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["c", "TI"], "^"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
