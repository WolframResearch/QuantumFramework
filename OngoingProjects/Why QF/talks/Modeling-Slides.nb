  FontSize->0.9 Inherited,ExpressionUUID->
  "18b73416-12a7-ba80-4efe-9c46408177e7"],
 ":"
}], "Text",
 CellID->710769346,ExpressionUUID->"7e990c5a-88ef-6408-7aea-f6fb6bf799b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xxzH2", "[", 
    RowBox[{"b_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"Min", "[", 
           RowBox[{"b", ",", " ", "1"}], "]"}]}], ")"}], "/", "2"}]}], "}"}], 
     ",", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"q", " ", "==", " ", "1"}], ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "q"}], " ", 
         RowBox[{"Log2", "[", "q", "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "q"}], ")"}], " ", 
         RowBox[{"Log2", "[", 
          RowBox[{"1", " ", "-", " ", "q"}], "]"}]}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xxzTilts", ",", " ", "xxzAxials"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"Pi", "/", "4"}], ",", " ", 
       RowBox[{"Pi", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xxzPanel", "[", "jz_", "]"}], " ", ":=", " ", 
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"xxzH2", "[", 
           RowBox[{"xxzBloch", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"J", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"Jz", " ", "->", " ", "jz"}], ",", " ", 
              RowBox[{"\[CurlyTheta]", " ", "->", " ", "#"}]}], "}"}]}], 
           "]"}], " ", "&"}], " ", "/@", " ", "xxzTilts"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", 
         RowBox[{"Pi", "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<J t\>\"", ",", " ", "\"\<S (bits)\>\""}], "}"}]}]}], 
      "]"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<J\>\"", ",", " ", "\"\<z\>\""}], "]"}], ",", 
        " ", "\"\</J = \>\"", ",", " ", "jz"}], "}"}], "]"}], ",", " ", 
     "Top"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xxzPanel", " ", "/@", " ", "xxzAxials"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"LineLegend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "xxzTilts", "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[CurlyTheta] = \>\"", ",", " ", "#"}], "}"}], "]"}], 
         " ", "&"}], " ", "/@", " ", "xxzTilts"}], ",", " ", 
       RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",", 
     " ", "Below"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[57]:= ",
 CellID->1713310219,ExpressionUUID->"562500b5-0280-a243-5fa7-050cd1835ada"],

Cell[TextData[{
 "From ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fdd7ad6-860e-0028-6004-8729e36c001b"],
 " the excitation swaps between the spins at angular frequency ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0535a2bd-9a67-30df-7f2d-f4dff65c0961"],
 ", so the entropy reaches one bit whenever the excitation is shared equally, \
whatever ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "324c1063-404e-4c07-4e28-1a46ea5f56ce"],
 ". Tilting the spins puts weight on ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f3b62a-adc1-1d0d-31c0-70b124c9aff3"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e10b6cf-5eb3-4a59-70eb-0c735e47080c"],
 ", where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b717e3b-ff9b-59aa-1356-6f42f3f44f27"],
 " acts, so the curves change with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "155ea6b2-cd0b-7d45-708a-34409fb06daf"],
 ". At the isotropic point ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"]], "=", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "505ca9c7-30fa-295d-6b1a-addcb50ee2b6"],
 " the spins tilted to ",
 Cell[BoxData[
  RowBox[{"\[CurlyTheta]", "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f56cfe3-e7a9-6657-7b82-7ea4314cbeed"],
 " both point along ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a1e6808-017b-7926-2f77-406dcdca453c"],
 ", a symmetric product state that ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08e962c3-bb11-7f76-4855-034df7e7a7a3"],
 " leaves unchanged, so they never entangle."
}], "Text",
 CellID->1497493817,ExpressionUUID->"7ea95ce1-827e-93e0-3771-a6aadde6097f"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->656454033,ExpressionUUID->"7ff90ee8-8f1a-1ac8-2242-78ffc937f22b"],

Cell["A coherent state in a harmonic oscillator", "Subsection",
 CellID->979567533,ExpressionUUID->"21bcc079-bd12-58c0-1042-0959e5f85459"],

Cell[TextData[{
 "A field mode of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02108db4-a2dd-5067-0fa7-774e487baf25"],
 " starts in the coherent state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64607918-cf2d-1503-7f64-209fc2b4c0db"],
 ". Does it stay coherent, with and without a Kerr nonlinearity ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09e9dcb9-7e32-94a8-1496-3df762f9e7a9"],
 "?"
}], "Text",
 CellID->1355946928,ExpressionUUID->"17463941-5802-77a8-34cc-ae7187c81981"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315481d0-2805-8b70-5f02-9a71e8ac0976"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "=", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e07c7f8-96b2-5773-39c9-07b2e01618ea"],
 ", the harmonic and Kerr Hamiltonians, the latter ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], "+", 
   StyleBox["\[Chi]", "TI"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a39951c-792d-36dc-4d6a-d93fd8269e5b"],
 " written in the frame rotating at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "295a1c9a-3798-7220-1460-c46e6d7714e5"],
 ", and the expected harmonic answer are"
}], "Text",
 CellID->1133256110,ExpressionUUID->"0d0f0424-dd85-0669-1f07-451d576d945c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    RowBox[{
     StyleBox["\[Omega]", "TI"], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox[
        StyleBox["n", "TI"], "^"], "+", 
       FractionBox["1", "2"]}], ")"}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     StyleBox["K", "TI"]], "=", 
    RowBox[{
     StyleBox["\[Chi]", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "2"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       OverscriptBox[
        StyleBox["H", "TI"], "^"], 
       StyleBox["t", "TI"]}]], 
     TemplateBox[{
       StyleBox["\[Alpha]", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["\[Omega]", "TI"], 
       StyleBox["t", "TI"], "/", "2"}]], 
     RowBox[{
      TemplateBox[{
        RowBox[{
          StyleBox["\[Alpha]", "TI"], 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             StyleBox["i", "TI"], 
             StyleBox["\[Omega]", "TI"], 
             StyleBox["t", "TI"]}]]}]},
       "Ket"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2072491980,ExpressionUUID->"2e5ed890-08b6-94ec-1099-23e907caa9f5"],

Cell[TextData[{
 "Both propagators, for general parameters and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d8050a-6b59-811f-5025-3a1412a51a95"],
 " on 16 Fock levels, act on the unnormalized ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4278f418-7391-1d3e-7a94-11119f874798"],
 " with general ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4948bf2e-2914-a54b-549e-0c2a2d45b29c"],
 ", and the harmonic answer is checked amplitude by amplitude. The figure \
plots the Wigner function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a06d0f2-0425-11c1-0776-32af988a3b2f"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "+", 
   StyleBox["i", "TI"], 
   StyleBox["p", "TI"], "=", 
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19af223b-498e-9f49-57cd-78833fd28336"],
 ", of the evolved state at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "164dd639-72f4-8e4b-5602-76a7cee962ab"],
 ", every panel on one color scale from ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a32c6b3-4f2c-57ba-01e2-67926d460344"],
 " to ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e0b1bc2-6201-c062-28c6-4e1968c59ae9"],
 ", the bounds of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31bdd9aa-2491-4a98-6d7c-90ae90f5c18d"],
 ":"
}], "Text",
 CellID->1352023997,ExpressionUUID->"6bb4868c-9ea4-86fc-4b3a-f11940ddbcbe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"oscN", " ", "=", " ", 
   RowBox[{
    RowBox[{"SuperDagger", "[", 
     RowBox[{"AnnihilationOperator", "[", "]"}], "]"}], " ", "@", " ", 
    RowBox[{"AnnihilationOperator", "[", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oscAmps", "[", "h_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"QuantumEvolve", "[", 
       RowBox[{"h", ",", " ", "None", ",", " ", "t"}], "]"}], " ", "@", " ", 
      RowBox[{"CoherentState", "[", 
       RowBox[{"\"\<Normalized\>\"", " ", "->", " ", "False"}], "]"}]}], 
     ")"}], "[", "\"\<AmplitudesList\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"oscHarm", ",", " ", "oscKerr"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"oscAmps", "[", 
      RowBox[{"\[Omega]", " ", 
       RowBox[{"(", 
        RowBox[{"oscN", " ", "+", " ", 
         RowBox[{"1", "/", "2"}]}], ")"}]}], "]"}], ",", " ", 
     RowBox[{"oscAmps", "[", 
      RowBox[{"\[Chi]", " ", 
       RowBox[{"oscN", " ", "@", " ", "oscN"}]}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oscSameQ", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"oscHarm", " ", "==", " ", 
     RowBox[{
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[Omega]", " ", 
         RowBox[{"t", "/", "2"}]}], ")"}]}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"CoherentState", "[", 
         RowBox[{"\"\<Normalized\>\"", " ", "->", " ", "False"}], "]"}], "[", 
        
        RowBox[{"\[FormalAlpha]", " ", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "\[Omega]", " ", "t"}], ")"}]}]}], "]"}],
        "[", "\"\<AmplitudesList\>\"", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oscAxis", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "4.5"}], ",", " ", "4.5", ",", " ", "0.1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"oscSpecs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"oscHarm", ",", " ", "\[Omega]", ",", " ", "#"}], "}"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Pi", "/", "3"}], ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Pi", "/", "3"}]}], ",", " ", "Pi"}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"oscKerr", ",", " ", "\[Chi]", ",", " ", "#"}], "}"}], " ", 
       "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "16"}], ",", " ", 
        RowBox[{"Pi", "/", "4"}], ",", " ", 
        RowBox[{"Pi", "/", "2"}], ",", " ", "Pi"}], "}"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oscW", "[", 
    RowBox[{"{", 
     RowBox[{"amps_", ",", " ", "par_", ",", " ", "wt_"}], "}"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"WignerFunction", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"Normalize", "[", 
           RowBox[{"amps", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[FormalAlpha]", " ", "->", " ", "2"}], ",", " ", 
              RowBox[{"par", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"t", " ", "->", " ", "wt"}]}], "}"}]}], "]"}], "]"}], ",",
          " ", "16"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "p"}], "}"}]}], "]"}], " ", "/.", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"oscAxis", ",", " ", 
          RowBox[{"Length", "[", "oscAxis", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"p", " ", "->", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"oscAxis", ",", " ", 
           RowBox[{"Length", "[", "oscAxis", "]"}]}], "]"}], "]"}]}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oscData", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{"oscW", ",", " ", "oscSpecs", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oscColors", " ", "=", " ", 
   RowBox[{
    RowBox[{"Blend", "[", 
     RowBox[{"\"\<WL14DefaultDensityGradient\>\"", ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"Pi", " ", "#"}]}], ")"}], "/", "2"}]}], "]"}], " ", "&"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"oscPanels", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{"#1", ",", " ", 
        RowBox[{"DataRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4.5"}], ",", " ", "4.5"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4.5"}], ",", " ", "4.5"}], "}"}]}], "}"}]}], ",", 
        " ", 
        RowBox[{"PlotRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "/", "Pi"}], ",", " ", 
           RowBox[{"1", "/", "Pi"}]}], "}"}]}], ",", " ", 
        RowBox[{"ColorFunction", " ", "->", " ", "oscColors"}], ",", " ", 
        RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", "\n", 
        "     ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "220"}], ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#2", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\< t = \>\"", ",",
               " ", 
              RowBox[{"TraditionalForm", "[", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
           " ", "13", ",", " ", 
           RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
          "]"}]}]}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"oscData", ",", " ", "oscSpecs"}], "}"}], ",", " ", "2"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", "oscPanels", "]"}], ",", " ", 
     RowBox[{"BarLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"oscColors", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "/", "Pi"}], ",", " ", 
           RowBox[{"1", "/", "Pi"}]}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"LegendLabel", " ", "->", " ", "\"\<W\>\""}]}], "]"}]}], "]"}],
    ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<e\>\"", ",", " ", "\"\<\[Minus]iHt\>\""}], "]"}], ",", 
        " ", "\"\<|\[Alpha]\[RightAngleBracket] = \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<e\>\"", ",", " ", "\"\<\[Minus]i\[Omega]t/2\>\""}], 
         "]"}], ",", "\n", "    ", "\"\<|\[Alpha]\>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<e\>\"", ",", " ", "\"\<\[Minus]i\[Omega]t\>\""}], "]"}],
         ",", " ", "\"\<\[RightAngleBracket] for all 16 amplitudes: \>\"", ",",
         " ", "oscSameQ"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[58]:= ",
 CellID->1391511406,ExpressionUUID->"6ce78d4f-c430-26bc-4b95-1d32368bc768"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4196fd9a-13bc-4d8d-6554-9c148d576998"],
 " the identity holds for every ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06437c98-1d24-adae-2e42-9e868e440b25"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "170ecd27-e081-f5f5-105a-51a7ede87569"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21521e27-3a48-7655-4625-5b6350771220"],
 ", phase included: the round Gaussian moves clockwise on a circle of radius ",
 Cell[BoxData[
  RowBox[{
   SqrtBox["2"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["\[Alpha]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d49fec5-3206-1d4e-0828-0eaa8d786ffc"],
 " without changing shape. The Kerr term turns the phase of level ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "672cc253-fe79-1c5b-57e7-4eb1ee7bd091"],
 " by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48683da8-3ef8-8efa-383c-277f55ec8938"],
 ", so the Gaussian shears into a crescent, splits into four and then two \
copies at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], 
   StyleBox["t", "TI"], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f5596b7-e2de-96e7-09cb-ee60ad44b2f1"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ee1277-a8c6-8650-35ae-17e0493063ef"],
 ", and is a coherent state again, reflected to ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f84fd60-77d9-a69c-409a-196508572c66"],
 ", at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], 
   StyleBox["t", "TI"], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46fe40fe-157d-c1ae-007f-0330d651961c"],
 "."
}], "Text",
 CellID->758901761,ExpressionUUID->"6192cf83-1cfa-1e56-7184-6da778b3954a"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->982000964,ExpressionUUID->"440a52ae-63f8-32e0-4187-717a7bbe0963"],

Cell["The Mandelstam-Tamm bound for any drive", "Subsection",
 CellID->1813696053,ExpressionUUID->"6de7699d-eca2-3311-71e8-dfe3272c9b8d"],

Cell["\<\
A quantum system is driven by an arbitrary time-dependent Hamiltonian. Can \
its state ever move farther from where it started than its accumulated energy \
spread allows?\
\>", "Text",
 CellID->1210498725,ExpressionUUID->"4747e3b0-7a48-6f95-051d-b9b60344f3b4"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02b51fa9-5c96-4405-1fc4-6ab9e2ba941d"],
 " and a Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20260bbf-87b9-6ab6-16f0-c7ab3fd7eb57"],
 " of undetermined entries,"
}], "Text",
 CellID->979673517,ExpressionUUID->"54bfe33a-3da6-d25f-26a4-7a2346ea8afa"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      StyleBox["d", "TI"], 
      StyleBox[
       RowBox[{"d", "t"}], "TI"]], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      StyleBox["i", "TI"]}], 
     OverscriptBox[
      StyleBox["H", "TI"], "^"], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     FractionBox[
      StyleBox["d", "TI"], 
      StyleBox[
       RowBox[{"d", "t"}], "TI"]], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Bra"]}], "=", 
    RowBox[{
     StyleBox["i", "TI"], 
     TemplateBox[{
       StyleBox["\[Psi]", "TI"]},
      "Bra"], 
     OverscriptBox[
      StyleBox["H", "TI"], "^"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       OverscriptBox[
        StyleBox["\[Psi]", "TI"], "."], 
       OverscriptBox[
        StyleBox["\[Psi]", "TI"], "."]},
      "BraKet"], "-", 
     SuperscriptBox[GridBox[{
        {
         TemplateBox[{
           StyleBox["\[Psi]", "TI"], 
           OverscriptBox[
            StyleBox["\[Psi]", "TI"], "."]},
          "BraKet"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], "=", 
    RowBox[{"\[CapitalDelta]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["E", "TI"], "2"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1640286876,ExpressionUUID->"3989e1a2-ff6c-f20d-24d0-d586b04aa238"],

Cell[TextData[{
 "The third relation equates the squared Fubini-Study speed with the energy \
variance, which bounds the distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arccos",
    FontSlant->"Plain"], GridBox[{
     {
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "0"], 
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["t", "TI"]]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67484347-e3d1-1924-75cb-46b783965d59"],
 " by the path length ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], "\[CapitalDelta]", 
   StyleBox["E", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126f25b1-de69-b7dc-7879-fe121e77cb65"],
 ", the Mandelstam-Tamm bound in the geometric form of Anandan and Aharonov. \
For the runs, ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["h", "TI"], "0"], "\|01d7d9", "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["x", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]], "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["y", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["y", "TI"]], "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["z", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45d24c6c-c770-be17-321f-ea79e0ddaa3f"],
 " on a qubit with random amplitudes and frequencies of order ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49bfdc7f-d50d-00fc-19ba-902468861044"],
 ", and the constant drive ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   StyleBox["\[CurlyEpsilon]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05a1d819-d285-0bd0-5b15-abe690424332"],
 "."
}], "Text",
 CellID->1628779081,ExpressionUUID->"50cec01e-403b-0d2e-1f27-66a14b9b2f87"],

Cell[TextData[{
 "The identity is checked on a three-level system with every entry of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a5b118-1020-54d6-1f95-3e52584d8e4b"],
 " and the state general, using the Schr\[ODoubleDot]dinger equation only as \
a rule for time derivatives; three random drives are then integrated from ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f5eb84d-b105-e960-2f6e-1a50c91990d3"],
 " in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[CurlyEpsilon]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b4911-8c79-f27d-566d-24c9266e55e4"],
 ", with the path length dashed:"
}], "Text",
 CellID->869026095,ExpressionUUID->"05b3ccea-eab3-57fd-4d08-d4295ad3396b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ehH", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ehh", "[", "##", "]"}], "[", "t", "]"}], " ", "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ehKet", ",", " ", "ehBra"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ehc", "[", "#", "]"}], "[", "t", "]"}], " ", "&"}], ",", 
       " ", "3"}], "]"}], ",", " ", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ehb", "[", "#", "]"}], "[", "t", "]"}], " ", "&"}], ",", 
       " ", "3"}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ehRules", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"ehKet", ",", " ", "t"}], "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"ehH", " ", ".", " ", "ehKet"}]}]}], "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"ehBra", ",", " ", "t"}], "]"}], " ", "->", " ", 
       RowBox[{"I", " ", 
        RowBox[{"ehBra", " ", ".", " ", "ehH"}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"speedResidual", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"ehBra", ",", " ", "t"}], "]"}], " ", ".", " ", 
          RowBox[{"D", "[", 
           RowBox[{"ehKet", ",", " ", "t"}], "]"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"ehBra", " ", ".", " ", 
            RowBox[{"D", "[", 
             RowBox[{"ehKet", ",", " ", "t"}], "]"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"ehBra", ",", " ", "t"}], "]"}], " ", ".", " ", 
            "ehKet"}], ")"}]}]}], ")"}], " ", "/.", " ", "ehRules"}], ")"}], 
     " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "ehBra", " ", ".", " ", "ehH", " ", ".", " ", "ehH", " ", ".", " ", 
        "ehKet"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ehBra", " ", ".", " ", "ehH", " ", ".", " ", "ehKet"}], 
         ")"}], "^", "2"}]}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mtDrive", "[", "seed_", "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"3", " ", 
              RowBox[{"#1", "[", 
               RowBox[{"[", "3", "]"}], "]"}], " ", "s"}], " ", "+", " ", 
             RowBox[{"2", " ", "Pi", " ", 
              RowBox[{"#1", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}]}], "]"}]}]}], ")"}], " ", 
        "#2"}], " ", "&"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"BlockRandom", "[", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
        
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ",", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], "}"}]}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mtRun", "[", "hn_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ehC1", "[", "s", "]"}], ",", " ", 
         RowBox[{"ehC2", "[", "s", "]"}]}], "}"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"psi", ",", " ", "s"}], "]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"hn", " ", ".", " ", "psi"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"psi", " ", "/.", " ", 
            RowBox[{"s", " ", "->", " ", "0"}]}], ")"}], " ", "==", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}]}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"ehLen", "'"}], "[", "s", "]"}], " ", "==", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "hn", 
              " ", ".", " ", "hn", " ", ".", " ", "psi"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Conjugate", "[", "psi", "]"}], " ", ".", " ", "hn", 
                " ", ".", " ", "psi"}], ")"}], "^", "2"}]}], "]"}], "]"}]}], ",",
          " ", 
         RowBox[{
          RowBox[{"ehLen", "[", "0", "]"}], " ", "==", " ", "0"}]}], "}"}], ",",
        "\n", "      ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ArcCos", "[", 
          RowBox[{"Min", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{"ehC1", "[", "s", "]"}], "]"}]}], "]"}], "]"}], ",", " ", 
         RowBox[{"ehLen", "[", "s", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mtRuns", " ", "=", " ", 
   RowBox[{"mtRun", " ", "/@", " ", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"mtDrive", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"First", " ", "/@", " ", "mtRuns"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Last", " ", "/@", " ", "mtRuns"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "All"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Epsilon] t\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<arccos|\[LeftAngleBracket]\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Psi]\>\"", ",", " ", "0"}], "]"}], ",", 
           " ", "\"\<|\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Psi]\>\"", ",", " ", "\"\<t\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]|\>\""}], "}"}], "]"}]}], "}"}]}], ",",
      " ", 
     RowBox[{"ImageSize", " ", "->", " ", "440"}], ",", "\n", "  ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<three levels:  speed\.b2 \[Minus] \[CapitalDelta]E\.b2 \
= \>\"", ",", " ", "speedResidual"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
        
        RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
       "]"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
         RowBox[{"Range", "[", "4", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<drive 1\>\"", ",", " ", "\"\<drive 2\>\"", ",", 
          " ", "\"\<drive 3\>\"", ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<constant \>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<x\>\""}], "]"}]}], 
            "}"}], "]"}]}], "}"}]}], "]"}], ",", "\n", "   ", 
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Directive", "[", 
          RowBox[{"Gray", ",", " ", "Dashed"}], "]"}], "}"}], ",", " ", 
        RowBox[{
        "{", "\"\<path length \[Integral]\[CapitalDelta]E dt\>\"", "}"}]}], 
       "]"}]}], "}"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[59]:= ",
 CellID->1403548103,ExpressionUUID->"2fd2ff91-b65c-869a-01f9-f3da7788782c"],

Cell[TextData[{
 "The residual vanishes for every drive and state, and nothing in the algebra \
uses the dimension, so no drive can move the state farther than its path \
length. Along each random drive the distance stays below its dashed path \
length; it can turn back toward ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b1369c-3cde-bea7-720f-15def4f16794"],
 " while the path length only grows. A constant drive between two levels runs \
along the bound, distance equal to path length, until the state is orthogonal \
to where it started."
}], "Text",
 CellID->1815183444,ExpressionUUID->"0d72bc04-58d8-d2bc-4e9f-ec1ca411dca2"],

