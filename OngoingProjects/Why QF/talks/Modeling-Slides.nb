Cell["Two spins coupled by exchange", "Subsection",
 CellID->1149032613,ExpressionUUID->"7605481f-288b-0782-706f-40c73aa9815b"],

Cell[TextData[{
 "Two spins interact through an XXZ exchange with in-plane coupling ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc64c12-99ba-836f-6468-9605544790e7"],
 " and axial coupling ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a166a60-b971-cd9d-52f9-6e7959d3fd64"],
 ". The first spin is tilted from ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e63bb93-5fda-da38-2ed3-dbdcb6fb9984"],
 " and the second from ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35161952-8ac9-fecc-1ea2-4b6d380b411d"],
 ", both by a polar angle ",
 Cell[BoxData["\[CurlyTheta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e91bfb3-d23c-2e44-15ba-dd7244424c66"],
 " toward ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18f346f8-8e87-effb-3672-49f1484813a5"],
 ". How entangled do they become?"
}], "Text",
 CellID->1932658243,ExpressionUUID->"6a675bda-2b48-f8b4-1d44-4b6e4f2c0a27"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45d0098a-175c-d8d8-223e-9192f1bd9f11"],
 " and Pauli operators ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a4ffb8a-b447-0550-474c-50ad12d379f0"],
 " on each spin,"
}], "Text",
 CellID->1815762940,ExpressionUUID->"5ddcb7da-6558-7c47-7e0a-8b4fd2820963"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["J", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox[
         RowBox[{"X", "X"}], "TI"], "+", 
        StyleBox[
         RowBox[{"Y", "Y"}], "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "+", 
     RowBox[{
      SubscriptBox[
       StyleBox["J", "TI"], 
       StyleBox["z", "TI"]], 
      StyleBox["Z", "TI"], 
      StyleBox["Z", "TI"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], "0", 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        StyleBox["cos",
         FontSlant->"Plain"], 
        FractionBox["\[CurlyTheta]", "2"], 
        TemplateBox[{"0"},
         "Ket"]}], "+", 
       RowBox[{
        StyleBox["sin",
         FontSlant->"Plain"], 
        FractionBox["\[CurlyTheta]", "2"], 
        TemplateBox[{"1"},
         "Ket"]}]}], ")"}], "\[CircleTimes]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         StyleBox["sin",
          FontSlant->"Plain"], 
         FractionBox["\[CurlyTheta]", "2"], 
         TemplateBox[{"0"},
          "Ket"]}], "+", 
        RowBox[{
         StyleBox["cos",
          FontSlant->"Plain"], 
         FractionBox["\[CurlyTheta]", "2"], 
         TemplateBox[{"1"},
          "Ket"]}]}], ")"}], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1853265838,ExpressionUUID->"0945fecc-b3f8-7e00-1fb3-a44d715567fc"],

Cell[TextData[{
 "Evolving for general ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70a5fd19-f11b-4334-048d-8e14653523f2"],
 ", ",
 Cell[BoxData[
