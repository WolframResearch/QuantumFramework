TransmonLab\>\"", ",", 
     " ", "\"\</Users/mohammadb/Documents/GitHub/mbahram/QUALink/QUALink\>\""}\
], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframQuantumComputation`QUALink`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qua\[Sigma]", " ", "=", " ", "5"}], ";", " ", 
  RowBox[{"quaI", " ", "=", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", " ", "-", " ", "20"}], ")"}], "^", "2"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"qua\[Sigma]", "^", "2"}]}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quaProg", " ", "=", " ", 
   RowBox[{"QUAProgram", "[", 
    RowBox[{
     RowBox[{"\"\<Qubit\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"5.105*^9", ",", " ", 
        RowBox[{"{", 
         RowBox[{"quaI", ",", " ", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{"quaI", ",", " ", "t"}], "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "40"}], "}"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"\"\<Resonator\>\"", " ", "->", " ", "6.012*^9"}], ",", " ", 
     RowBox[{"\"\<\[Beta]\>\"", " ", "->", " ", 
      RowBox[{"qua\[Sigma]", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "1"}], "}"}]}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quaSpectrum", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"FourierTransform", "[", 
        RowBox[{
         RowBox[{"quaI", " ", "-", " ", 
          RowBox[{"I", " ", "\[Beta]", " ", 
           RowBox[{"D", "[", 
            RowBox[{"quaI", ",", " ", "t"}], "]"}]}]}], ",", " ", "t", ",", 
         " ", "\[Omega]", ",", " ", 
         RowBox[{"FourierParameters", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], "]"}], "^", "2"}], 
     ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", " ", "\[Omega]"}], "}"}], " ", "\[Element]", 
      " ", "Reals"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"quaSamples", "[", "pulse_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"quaProg", "[", "\"\<Waveforms\>\"", "]"}], " ", "/@", " ", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"quaProg", "[", "\"\<Config\>\"", "]"}], "[", "\"\<pulses\>\"",
         "]"}], "[", "pulse", "]"}], "[", "\"\<waveforms\>\"", "]"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quaSweep", " ", "=", " ", 
   RowBox[{"quaProg", "[", "\"\<SweepValues\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quaPoints", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"iq", " ", "=", " ", 
          RowBox[{"quaSamples", "[", "#1", "]"}]}], "}"}], ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"w", ",", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"iq", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
                 RowBox[{"I", " ", 
                  RowBox[{"iq", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], " ", ".", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"I", " ", "w", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", " ", "39"}], "]"}]}], "]"}]}], "]"}], "^",
              "2"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"w", ",", " ", 
            RowBox[{"-", "0.6"}], ",", " ", "0.6", ",", " ", "0.04"}], 
           "}"}]}], "]"}]}], "]"}], " ", "&"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Keys", "[", 
          RowBox[{
           RowBox[{"quaProg", "[", "\"\<Config\>\"", "]"}], 
           "[", "\"\<pulses\>\"", "]"}], "]"}], ",", " ", 
         RowBox[{"StringStartsQ", "[", "\"\<qubit_drive\>\"", "]"}]}], "]"}], 
       ",", " ", "quaSweep"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"quaSpectrum", " ", "/.", " ", 
         RowBox[{"\[Beta]", " ", "->", " ", "#"}]}], " ", "&"}], " ", "/@", 
       " ", "quaSweep"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Omega]", ",", " ", 
       RowBox[{"-", "0.6"}], ",", " ", "0.6"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"PlotPoints", " ", "->", " ", "100"}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"Automatic", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<\[Beta]/\[Sigma] = \>\"", ",", " ", 
               RowBox[{"#", "/", "qua\[Sigma]"}]}], "}"}], "]"}], " ", "&"}], 
           " ", "/@", " ", "quaSweep"}], ",", " ", 
          RowBox[{"LegendLayout", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Row\>\"", ",", " ", "1"}], "}"}]}]}], "]"}], ",", 
        " ", "Below"}], "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"ListLogPlot", "[", "quaPoints", "]"}], ",", "\n", "  ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"10", "^", 
        RowBox[{"-", "3"}]}], "]"}], ",", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"10", "^", "3"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Axes", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"False", ",", " ", "True"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Omega] (rad/ns)\>\"", ",", 
      " ", "\"\<power (ns\.b2)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]}], "Input",
 CellLabel->"In[156]:= ",
 CellID->561752205,ExpressionUUID->"53e8fc21-fa8c-3fa3-7d91-7757f4f3c614"],

Cell[TextData[{
 "The played samples (points) follow the closed-form spectrum (line) for \
every sweep value. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ca6ab8b-4cd9-406d-39d9-924f8f4e4dda"],
 " the spectrum is the Gaussian's, symmetric about the carrier; a nonzero ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a70f146-7764-4ecf-189f-3c12d985de2c"],
 " tilts it, and the closed form has a zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "1", "/", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7547aabe-b7ab-711f-479a-3570d481ded0"],
 ", on the side set by the sign of ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "601a9ff0-56fa-32f2-3bae-23e35f558d3a"],
 "."
}], "Text",
 CellID->1405561321,ExpressionUUID->"4c7836dc-6410-85e6-3ba3-187d29997ce5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1123366170,ExpressionUUID->"0ff5ff77-802e-bfd9-66da-db9fa64925d2"],

Cell["The transmon spectrum against offset charge", "Subsection",
 CellID->1242450891,ExpressionUUID->"1da0acf4-4f96-4bc8-08db-01046cf2a5ed"],

Cell[TextData[{
 "A Cooper-pair box is a superconducting island, charging energy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "026a49bb-5bff-1e80-3886-11e8eb73e331"],
 ", joined to a reservoir by a Josephson junction of energy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], 
   StyleBox["J", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37bdafe5-608f-abf9-17e0-d28b0369fe93"],
 "; a gate sets the offset charge ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["g", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24795717-df72-ef99-3bef-ab5d50e8c139"],
 ", in units of ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["e", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ac2b7b8-06c0-d3f8-31cc-eb5c250526c9"],
 ". How do its lowest levels depend on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["g", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14d3399a-98b2-e24d-051d-a75b496b687f"],
 " as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09832950-9002-6983-4181-a827d127abe4"],
 " grows?"
}], "Text",
 CellID->2086307057,ExpressionUUID->"21af4034-2458-3b78-70ad-4f2a9bf6e5c6"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "265d1d9b-3294-f499-05b0-5fccbdafb951"],
 " the number of Cooper pairs on the island and ",
 Cell[BoxData[
  OverscriptBox["\[CurlyPhi]", "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ad6849-a65d-3d8b-335d-087f97688d9b"],
 " the conjugate phase,"
}], "Text",
 CellID->1963836080,ExpressionUUID->"1a3e03ce-44e7-b0fb-102b-cbf499f7d818"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", "4", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["C", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["n", "TI"], "^"], "-", 
       SubscriptBox[
        StyleBox["n", "TI"], 
        StyleBox["g", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["J", "TI"]], 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    OverscriptBox["\[CurlyPhi]", "^"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1980553808,ExpressionUUID->"79e1c5cd-6a7a-b3f0-0198-b4923689129f"],

Cell[TextData[{
 "In the phase basis this is Mathieu's equation, so the levels are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["\[Nu]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["J", "TI"]], "/", "2", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["C", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68cfeae5-ad4d-ee42-4594-e33712216867"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Nu]", "TI"], "=", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["g", "TI"]], "+", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ef0cbaf-8f91-1eca-1ab8-e39ca9f17609"],
 " over integers ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14b0f2ad-73e7-fd5c-1b11-e398e97833ef"],
 ", where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["\[Nu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cd746c7-c933-c791-18de-afd247bd2e9c"],
 " is replaced by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["b", "TI"], GridBox[{
     {
      StyleBox["\[Nu]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "086e59a4-2a55-4deb-0a32-c61160a9529f"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Nu]", "TI"], "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b64b2d3-6108-84be-497a-44e17c65eb9d"],
 "; the two differ only at integer and half-integer ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], 
   StyleBox["g", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17dc3c67-725c-aa1a-2ada-4b77eb8fc073"],
 ", where ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37a33862-0e5b-efe3-51ab-17d7bf96973e"],
 " supplies the odd partner level."
}], "Text",
 CellID->1321626754,ExpressionUUID->"40cab5c0-732a-5cdc-4e2e-cd37eba94cc5"],

Cell[TextData[{
 "The figure shows the three lowest levels ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["m", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0849f583-3070-a371-5bbd-63ae91fab70d"],
 ", measured from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d50e044-ba2d-03b9-2efb-9630880d4e21"],
 " at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50d362b9-ad83-3e88-135f-fefc3f23885c"],
 " in units of the qubit splitting ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "01"], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], "1"], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55a59fdc-1669-14d7-2b2f-26d1c3d06988"],
 " there:"
}], "Text",
 CellID->2084525441,ExpressionUUID->"5aff7aee-5cda-8a21-7a67-0b0c3af771b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cpbLevels", "[", 
    RowBox[{"ej_", ",", " ", "ng_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Nu]", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"ng", " ", "+", " ", "k"}], ")"}]}], "]"}]}], "}"}], ",",
           " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[Nu]", " ", ">=", " ", "0"}], ",", " ", 
            RowBox[{"MathieuCharacteristicA", "[", 
             RowBox[{"\[Nu]", ",", " ", 
              RowBox[{
               RowBox[{"-", "ej"}], "/", "2."}]}], "]"}], ",", " ", 
            RowBox[{"MathieuCharacteristicB", "[", 
             RowBox[{
              RowBox[{"-", "\[Nu]"}], ",", " ", 
              RowBox[{
               RowBox[{"-", "ej"}], "/", "2."}]}], "]"}]}], "]"}]}], "]"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", 
          RowBox[{"-", "3"}], ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
     "3"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cpbPanel", "[", "ej_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ref", " ", "=", " ", 
       RowBox[{"cpbLevels", "[", 
        RowBox[{"ej", ",", " ", 
         RowBox[{"1", "/", "2"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"cpbLevels", "[", 
              RowBox[{"ej", ",", " ", "ng"}], "]"}], " ", "-", " ", 
             RowBox[{"ref", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ref", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
             RowBox[{"ref", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"ng", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "1", ",", " ", 
            RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<m = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", "2"}], "]"}]}], ")"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "260"}], ",", "\n", "    ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<n\>\"", ",", " ", "\"\<g\>\""}], "]"}], ",", " ", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"HoldForm", "[", 
            RowBox[{"Divide", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<E\>\"", ",", " ", "\"\<m\>\""}], "]"}], "[", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<n\>\"", ",", " ", "\"\<g\>\""}], "]"}], "]"}], 
               " ", "-", " ", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<E\>\"", ",", " ", "\"\<0\>\""}], "]"}], "[", 
                RowBox[{"1", "/", "2"}], "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<E\>\"", ",", " ", "\"\<01\>\""}], "]"}], "[", 
               RowBox[{"1", "/", "2"}], "]"}]}], "]"}], "]"}], "]"}]}], 
         "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<E\>\"", ",", " ", "\"\<J\>\""}], "]"}], ",", 
           " ", "\"\</\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<E\>\"", ",", " ", "\"\<C\>\""}], "]"}], ",", 
           " ", "\"\< = \>\"", ",", " ", "ej"}], "}"}], "]"}]}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cpbPanels", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"cpbPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "5", ",", " ", "10", ",", " ", "50"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"cpbPanels", "[", "ej", "]"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"cpbPanels", "[", "1", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ej", ",", " ", "10", ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<E\>\"", ",", " ", "\"\<J\>\""}], "]"}], ",", 
          " ", "\"\</\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<E\>\"", ",", " ", "\"\<C\>\""}], "]"}]}], "}"}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{"Keys", "[", "cpbPanels", "]"}], ",", " ", "SetterBar"}], "}"}], 
   ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[157]:= ",
 CellID->383218451,ExpressionUUID->"664224a6-1468-7628-5d7f-bdc6f3d3149c"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ca7ffe2-5e44-1d7b-09c4-36b534900e1f"],
 " the levels are charge parabolas that the junction splits at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["g", "TI"]], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "303227f8-6b8e-4e41-1221-d7247e66fa90"],
 ", and the qubit frequency swings strongly with offset charge. As ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05bbe4df-9da2-eb97-017e-e95e8c9a3c1b"],
 " grows the bands flatten. The price is the anharmonicity: at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], "=", "50"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b2ff97b-25ef-a806-29d2-dc0642cb2981"],
 " the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "184674f1-c9b4-3947-6ad1-5fa0137c7063"],
 " band sits flat just below the gridline at 2, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "12"], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], "01"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "449c075a-59a4-11e8-660e-938bd5798d22"],
 " is small, negative and fixed."
}], "Text",
 CellID->891471374,ExpressionUUID->"107cc5b0-ff65-73aa-0bae-0157d8e00e38"],

Cell["\<\
How flat the bands become is measured by the charge dispersion of the qubit \
frequency, its full range over offset charge,\
\>", "Text",
 CellID->1494829454,ExpressionUUID->"299961ea-0f81-2fbd-168e-a89816b5b871"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[CurlyEpsilon]", "TI"], "01"], "=", GridBox[{
      {
       RowBox[{
        SubscriptBox[
         StyleBox["E", "TI"], "01"], 
        StyleBox["(",
         SpanMaxSize->1], "0", 
        StyleBox[")",
         SpanMaxSize->1], "-", 
        SubscriptBox[
         StyleBox["E", "TI"], "01"], 
        StyleBox["(",
         SpanMaxSize->1], 
        FractionBox["1", "2"], 
        StyleBox[")",
         SpanMaxSize->1]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1162111880,ExpressionUUID->"7c9f989d-66ea-4e5c-6274-1fdde3d31628"],

Cell[TextData[{
 "which for large ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f8b5959-3665-f7db-37a2-7b5c17ad8997"],
 " tends to ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", "5"], 
   SqrtBox[
    RowBox[{"2", "/", "\[Pi]"}]], "[", 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["J", "TI"]], "/", "2", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["C", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"3", "/", "4"}]], "+", 
    SuperscriptBox["2", "4"], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["J", "TI"]], "/", "2", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["C", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"5", "/", "4"}]]}], "]", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SqrtBox[
      RowBox[{"8", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["J", "TI"]], "/", 
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["C", "TI"]]}]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cb79855-d7ee-04f1-7400-e155395bc4fe"],
 " (Koch et al. 2007), dashed:"
}], "Text",
 CellID->1751814701,ExpressionUUID->"7542b82c-abcb-32f8-3a2c-f4e5914ee6b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cpbE01", "[", 
    RowBox[{"ej_", ",", " ", "ng_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Subtract", " ", "@@", " ", 
    RowBox[{"Reverse", " ", "@", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"cpbLevels", "[", 
        RowBox[{"ej", ",", " ", "ng"}], "]"}], ",", " ", "2"}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"8", " ", "ej"}], "]"}], ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"cpbE01", "[", 
            RowBox[{"ej", ",", " ", "0"}], "]"}], " ", "-", " ", 
           RowBox[{"cpbE01", "[", 
            RowBox[{"ej", ",", " ", 
             RowBox[{"1", "/", "2"}]}], "]"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"ej", ",", " ", "1", ",", " ", "80"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Joined", " ", "->", " ", "True"}]}], "]"}], ",", "\n", "   ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"8", " ", "ej"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"2", "^", "5"}], " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "/", "Pi"}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"ej", "/", "2"}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"3", "/", "4"}], ")"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"2", "^", "4"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ej", "/", "2"}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"5", "/", "4"}], ")"}]}]}]}], ")"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"8", " ", "ej"}], "]"}]}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"ej", ",", " ", "1", ",", " ", "80"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
   "   ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2.5", ",", " ", "All"}], "}"}], ",", " ", "All"}], "}"}]}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<E\>\"", ",", " ", "\"\<J\>\""}], "]"}], ",", 
          " ", "\"\</\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<E\>\"", ",", " ", "\"\<C\>\""}], "]"}]}], "}"}], 
        "]"}], "]"}], ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Epsilon]\>\"", ",", " ", "\"\<01\>\""}], "]"}], ",", 
         " ", "\"\< / \>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<E\>\"", ",", " ", "\"\<C\>\""}], "]"}]}], "}"}], 
       "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "Input",
 CellLabel->"In[158]:= ",
 CellID->1510936921,ExpressionUUID->"2e76f6b3-5c1d-4a19-1e48-4f857a51b606"],

Cell[TextData[{
 "Once the bands are nearly flat, ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[CurlyEpsilon]", "TI"], "01"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "692619bc-0d63-b59a-7cf9-9dfbd63bed45"],
 " falls on a straight line on this logarithmic scale: it decreases \
exponentially in ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"8", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["J", "TI"]], "/", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["C", "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e8b50c3-cd7b-44a1-5fff-5ef9f6c78ee1"],
 ", the exponent of phase tunneling between neighboring wells of the cosine \
potential, which is the only way the offset charge reaches the levels. The \
asymptote overshoots where the bands are still charge parabolas and merges \
with the exact levels in the transmon regime, where offset charge barely \
moves the qubit frequency."
}], "Text",
 CellID->1842041740,ExpressionUUID->"5029ff62-435b-ced9-6be8-6cb0b16c4990"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (July 2, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"66c5b19f-fc1b-e050-3799-74b1f9e3c3a5"
]
