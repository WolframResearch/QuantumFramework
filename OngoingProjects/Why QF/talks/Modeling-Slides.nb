Cell["\<\
Five-qubit code: fifteen single-qubit errors, fifteen distinct syndromes\
\>", "Subsection",
 CellID->648300940,ExpressionUUID->"26cd7c6e-6082-8379-1066-8858d06f37f8"],

Cell[TextData[{
 "Five qubits store one logical qubit in the joint ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41914b3e-9617-f8f9-190d-e6c09e84be32"],
 " eigenspace of four commuting checks. One or two qubits suffer an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62d2b165-3703-6d1f-71f3-16c9f5e1612b"],
 ", ",
 Cell[BoxData[
  StyleBox["Y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "225d1f33-a3a7-0445-666e-3c0e5cd9b566"],
 " or ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fd46175-bb26-7b6f-28d8-081433c65dfd"],
 " error, and the four checks are measured. Which errors do the four outcomes \
tell apart?"
}], "Text",
 CellID->394676041,ExpressionUUID->"55f2e863-fafc-1091-4b31-82ef12630ad2"],

Cell[TextData[{
 "The checks are the cyclic shifts of ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"X", "Z", "Z", "X", "I"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50a01848-7fdc-b5a6-3f64-495448bf57d0"],
 ", and the logical operators are"
}], "Text",
 CellID->366531376,ExpressionUUID->"181daca7-fd02-b36f-572a-26ee00e4c9c6"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], "1"], "=", 
    StyleBox["X", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["Z", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["I", "TI"]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], "2"], "=", 
    StyleBox[
     RowBox[{"I", "X", "Z", "Z", "X"}], "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], "3"], "=", 
    StyleBox[
     RowBox[{"X", "I", "X", "Z", "Z"}], "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], "4"], "=", 
    StyleBox[
     RowBox[{"Z", "X", "I", "X", "Z"}], "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     StyleBox["Z", "TI"], "_"], "=", 
    StyleBox[
     RowBox[{"Z", "Z", "Z", "Z", "Z"}], "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     StyleBox["X", "TI"], "_"], "=", 
    RowBox[{
     StyleBox["X", "TI"], 
     StyleBox["X", "TI"], 
     StyleBox["X", "TI"], 
     StyleBox["X", "TI"], 
     RowBox[{
      StyleBox["X", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1437840563,ExpressionUUID->"65a915cd-68c3-ea6d-62dd-668302454f9c"],

Cell[TextData[{
 "After an error ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68ab8aaf-6445-fd00-0a21-0dfc211c33cb"],
 " on a codeword ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cca6ce9-eccc-f326-1d22-d52088c4ec49"],
 ", check ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30b07fa7-3c63-c7f1-1806-9113699a438f"],
 " reads the bit ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["k", "TI"]], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Bra"], 
       SuperscriptBox[
        StyleBox["E", "TI"], "\[Dagger]"], 
       SubscriptBox[
        StyleBox["g", "TI"], 
        StyleBox["k", "TI"]], 
       StyleBox["E", "TI"], 
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Ket"]}]}], ")"}], "/", "2"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b5ef884-fb50-f0de-592a-a96957fe1fe9"],
 ", which is 1 exactly when ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7276e344-ceb8-eef8-51ce-36371835fd87"],
 " anticommutes with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f941c21-88bf-d50b-7674-c84255cf5762"],
 ", whatever the codeword."
}], "Text",
 CellID->1809720786,ExpressionUUID->"0ed3520d-c953-4e43-784d-18c2d2361b90"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "353af3e6-247a-f863-0765-23b3155bd4fa"],
 " held as the tableau of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], "1"], ",", "\[Ellipsis]", ",", 
   SubscriptBox[
    StyleBox["g", "TI"], "4"], ",", 
   OverscriptBox[
    StyleBox["Z", "TI"], "_"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27160dcc-1525-64cc-7fb8-842f3481fc8f"],
 ", each of the 15 single-qubit errors and each of the 90 two-qubit errors \
acts on it; the figure shows the four bits (black is 1) and counts the \
two-qubit errors that share each single-qubit syndrome:"
}], "Text",
 CellID->297856386,ExpressionUUID->"7825e59b-8759-060b-63cd-6dec9855d1f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fiveCode", " ", "=", " ", 
   RowBox[{"PauliStabilizer", "[", "\"\<5QubitCode\>\"", "]"}]}], ";", " ", 
  RowBox[{"fiveChecks", " ", "=", " ", 
   RowBox[{"Most", "[", 
    RowBox[{"fiveCode", "[", "\"\<Stabilizers\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fiveSyndrome", "[", "errors_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"1", " ", "-", " ", 
        RowBox[{
         RowBox[{"fiveCode", "[", "errors", "]"}], "[", 
         RowBox[{"\"\<Expectation\>\"", ",", " ", "#"}], "]"}]}], " ", "&"}], 
      " ", "/@", " ", "fiveChecks"}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fiveErrors", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Outer", "[", 
     RowBox[{"Rule", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
       "}"}], ",", " ", 
      RowBox[{"Range", "[", "5", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fiveSingles", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"fiveSyndrome", "[", 
      RowBox[{"{", "#", "}"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "fiveErrors"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fivePairs", " ", "=", " ", 
   RowBox[{"Counts", "[", 
    RowBox[{"fiveSyndrome", " ", "/@", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{"#2", " ", "->", " ", "#1"}], "]"}], " ", "&"}], ",", " ", 
         
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", "5", "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", 
             " ", "\"\<Z\>\""}], "}"}], ",", " ", "2"}], "]"}], ",", " ", 
         "1"}], "]"}], ",", " ", "1"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fiveLabels", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", "#", "]"}], " ", "<>", " ", 
      RowBox[{"ToString", "[", 
       RowBox[{"Last", "[", "#", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
    "fiveErrors"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{"ArrayPlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "fiveSingles", "]"}], ",", " ", 
         RowBox[{"Mesh", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", "\n", "    ", 
         RowBox[{"FrameTicks", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Range", "[", "4", "]"}], ",", " ", "fiveChecks"}], 
                "}"}], "]"}], ",", " ", "None"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Range", "[", "15", "]"}], ",", " ", "fiveLabels"}], 
                "}"}], "]"}], ",", " ", "None"}], "}"}]}], "}"}]}]}], "]"}], ",",
        "\n", "   ", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<single-qubit errors: \>\"", ",", " ", 
            RowBox[{"Length", "[", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"Union", "[", "fiveSingles", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                "}"}]}], "]"}], "]"}], ",", 
            " ", "\"\< distinct nonzero syndromes\>\""}], "}"}], "]"}], ",", 
         " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"BarChart", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"fivePairs", ",", " ", "fiveSingles", ",", " ", "0"}], "]"}], 
       ",", " ", 
       RowBox[{"ChartLabels", " ", "->", " ", "fiveLabels"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", "\"\<two-qubit errors\>\""}], "}"}]}], ",",
        " ", 
       RowBox[{"AspectRatio", " ", "->", " ", 
        RowBox[{"1", "/", "4"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "520"}], ",", "\n", "   ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<two-qubit errors with the same syndrome; with zero \
syndrome: \>\"", ",", " ", 
             RowBox[{"Lookup", "[", 
              RowBox[{"fivePairs", ",", " ", 
               RowBox[{"Key", "[", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                 "}"}], "]"}], ",", " ", "0"}], "]"}]}], "}"}], "]"}], ",", 
          " ", "13", ",", " ", 
          RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
         "]"}]}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[75]:= ",
 CellID->1402015676,ExpressionUUID->"0dc0628a-b403-6fe9-3163-80622ccf2094"],

Cell["\<\
Every single-qubit error gives a different nonzero four-bit word, and four \
bits have only fifteen nonzero values: the checks have no room to spare, \
which is why the code is called perfect. Every two-qubit error also trips the \
checks, but it shares its syndrome with a single-qubit error, so a decoder \
that inverts the table leaves a nontrivial error of weight at most three with \
zero syndrome, which can only be a logical operator. The code detects all \
two-qubit errors and corrects none of them.\
\>", "Text",
 CellID->668532644,ExpressionUUID->"28a40e51-241d-6303-306b-7b28ee7a2da0"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1282647199,ExpressionUUID->"172cc7d6-532b-b22d-5371-d96e376dcccd"],

Cell["\<\
A thousand-qubit GHZ state: entanglement entropy as a rank over F\:2082\
\>", "Subsection",
 CellID->278355814,ExpressionUUID->"701e8379-b851-9808-40e6-78efece335b5"],

Cell[TextData[{
 "Take ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1000"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56cf3f29-496b-905c-55a8-3d0221ab5b54"],
 " qubits in the GHZ state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       RowBox[{"0", "\[CenterEllipsis]", "0"}]},
      "Ket"], "+", 
     TemplateBox[{
       RowBox[{"1", "\[CenterEllipsis]", "1"}]},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4449d99d-eff2-b1b8-3e2b-4a68292a9c2b"],
 ", and for comparison in the one-dimensional cluster state, made by putting \
every qubit in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6113c2d3-7811-9c0c-6b6c-5cfa9a92b238"],
 " and applying ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35e56393-712f-0833-310b-0ee04597f9d8"],
 " to each neighboring pair. How much entanglement separates a set ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7759120c-d989-c889-216f-bb44be17eb68"],
 " of ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b7be4d6-c105-27d0-147d-052dae85a70f"],
 " qubits from the rest, when ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f5201c6-4c5f-4d6d-01e6-23574763555f"],
 " is a block at the end of the chain and when ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2300f129-4e32-ea96-1a1c-767b95fb7034"],
 " is scattered at random?"
}], "Text",
 CellID->255627324,ExpressionUUID->"398ed27d-2e2b-2c32-679f-751dae433e2a"],

Cell[TextData[{
 "A stabilizer state is fixed by ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6354104e-48af-6fea-6a93-fc68c904c90e"],
 " commuting Pauli generators: ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["X", "TI"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42fe7738-9b99-3175-55e5-610c9f27dbae"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36209205-2b3c-54b7-60cc-df91d24ad04e"],
 " for GHZ, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "-", "1"}]], 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "302e6a3d-75b6-3845-6e29-f55746327a9e"],
 " for the cluster. Write each generator as a binary vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], 
    StyleBox["|",
     SpanMaxSize->1], 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[Element]", 
   SubsuperscriptBox["\|01d53d", "2", 
    RowBox[{"2", 
     StyleBox["n", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e85b908-c0a5-8684-3cc9-0d029cbb057b"],
 ", stack them as the rows of an ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Times]", "2", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34153c3b-02fd-6039-4ea5-143b1f179c70"],
 " matrix ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7131651b-59b4-efc0-7932-7ca94529cb3f"],
 ", and let ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["G", "TI"], 
   StyleBox["A", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "576237f8-bad5-84da-1856-38e4ceec9583"],
 " keep only the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b96ec02-408c-4bde-57e4-77ea60d372b2"],
 " and ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166a99b6-cb46-5852-7e3f-a9e5a2ea2f89"],
 " columns of the qubits in ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "224d09b8-6333-cc86-3d92-853622ee8ab4"],
 ". Then the entanglement entropy, in bits, is (Fattal et al. 2004)"
}], "Text",
 CellID->1784595618,ExpressionUUID->"1a493f9e-3e83-91f3-39dd-5f768fef2ec7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["S", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["A", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    SubscriptBox[
     StyleBox["rank",
      FontSlant->"Plain"], 
     SubscriptBox["\|01d53d", "2"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["G", "TI"], 
     StyleBox["A", "TI"]], "-", GridBox[{
      {
       StyleBox["A", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1760852355,ExpressionUUID->"4de31e53-75a4-2db3-443f-3bf3aac32f70"],

Cell[TextData[{
 "Both states are held as tableaux, and the rank is evaluated for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["k", "TI"], "=", "50"}], ",", "100", ",", "\[Ellipsis]", ",", 
   "950"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16693c11-b3ec-96ba-7dda-32665a0b20e9"],
 ", with one random set ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72329f2a-1dd1-a876-0622-0d848f46e837"],
 " per ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b8fa930-0cd6-ce8c-79e8-54d701b5cd55"],
 "; no ",
 Cell[BoxData[
  SuperscriptBox["2", "1000"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bafe5f5-2df7-aa12-24e6-f76845021f3c"],
 "-entry vector is ever formed:"
}], "Text",
 CellID->1443462708,ExpressionUUID->"39e5a3de-bb0e-b60b-0190-f4ee90d5071b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ghzChain", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "1000", "]"}], "[", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", 
           RowBox[{"q", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "999"}], "}"}]}], "]"}], ",", 
      " ", "\"\<H\>\""}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"clusterChain", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "1000", "]"}], "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"Range", "[", "1000", "]"}]}], "]"}], ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"q", ",", " ", 
           RowBox[{"q", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "999"}], "}"}]}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"entropyPanel", "[", 
    RowBox[{"label_", ",", " ", "ps_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"ps", "[", 
          RowBox[{"\"\<Entropy\>\"", ",", " ", 
           RowBox[{"sel", "[", "k", "]"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"sel", ",", " ", 
         RowBox[{"{", 
          RowBox[{"Range", ",", " ", 
           RowBox[{
            RowBox[{"RandomSample", "[", 
             RowBox[{
              RowBox[{"Range", "[", "1000", "]"}], ",", " ", "#"}], "]"}], 
            " ", "&"}]}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "50", ",", " ", "950", ",", " ", "50"}], 
        "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "16"}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"\"\<\[EmptyUpTriangle]\>\"", ",", " ", "8"}], "}"}]}], 
       "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.7", ",", " ", "500"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<block {1, \[Ellipsis], k}\>\"", ",", 
        " ", "\"\<k qubits at random\>\""}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k\>\"", ",", " ", "\"\<S(A)  (bits)\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "label"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"entropyPanels", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"entropyPanel", "[", 
        RowBox[{"\"\<GHZ\>\"", ",", " ", "ghzChain"}], "]"}], ",", " ", 
       RowBox[{"entropyPanel", "[", 
        RowBox[{"\"\<cluster\>\"", ",", " ", "clusterChain"}], "]"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "entropyPanels"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "680"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "entropyPanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[76]:= ",
 CellID->704413293,ExpressionUUID->"7b71ef0d-92e5-01cc-1477-449f813682f7"],

Cell["\<\
The GHZ state carries exactly one bit across every cut, a block or a \
scattered set of any size: its entanglement is a single shared parity. The \
cluster state also carries one bit across a block boundary, but far more when \
the same number of qubits is scattered, so its entanglement depends on the \
shape of the cut, not only on its size.\
\>", "Text",
 CellID->323414840,ExpressionUUID->"70182ea1-be0d-956f-6734-da054973adb1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1839393326,ExpressionUUID->"379bd580-199c-f6b4-2bf8-bb55f6e833a7"],

Cell["\<\
Stabilizer measurement kept symbolic: random outcomes as formal bits\
\>", "Subsection",
 CellID->1834088681,ExpressionUUID->"5b4cd868-880b-98ae-7224-e960185ac77f"],

Cell[TextData[{
 "Two qubits start in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50c5694f-a2f7-9b3c-309d-a009fcdf694c"],
 ", and two CNOTs copy their parity onto a third qubit. Then an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "104a97b5-88f0-29a8-186c-630101ce98c8"],
 " on qubit 1, an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160cd444-0465-e786-2b89-5d7446e0fba2"],
 " on qubit 3, or a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f2ed59b-953d-6aa0-31aa-8ba6a8773fc2"],
 " on qubit 1 may strike, and all three qubits are measured in the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "619cc8d8-690d-0eaa-44c4-513f0ef75f39"],
 " basis. How is the third outcome fixed by the first two?"
}], "Text",
 CellID->526183531,ExpressionUUID->"1884b931-9a05-6c5b-1d8b-6f5d12966664"],

Cell["Before the error the state and its stabilizer generators are", "Text",
 CellID->732467172,ExpressionUUID->"1108f142-de8a-7e62-4751-d8f98e6a0c03"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["CNOT",
       FontSlant->"Plain"], "23"], 
     SubscriptBox[
      StyleBox["CNOT",
       FontSlant->"Plain"], "13"], 
     SubscriptBox[
      StyleBox["H", "TI"], "1"], 
     SubscriptBox[
      StyleBox["H", "TI"], "2"], 
     TemplateBox[{"000"},
      "Ket"]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{
        SubscriptBox[
         StyleBox["m", "TI"], "1"], ",", 
        SubscriptBox[
         StyleBox["m", "TI"], "2"]}],
       LimitsPositioning->False], 
      TemplateBox[{
        RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], "1"], ",", 
          SubscriptBox[
           StyleBox["m", "TI"], "2"], ",", 
          SubscriptBox[
           StyleBox["m", "TI"], "1"], "\\veebar", 
          SubscriptBox[
           StyleBox["m", "TI"], "2"]}]},
       "Ket"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["X", "TI"], "1"], 
       SubscriptBox[
        StyleBox["X", "TI"], "3"]}], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["X", "TI"], "2"], 
       SubscriptBox[
        StyleBox["X", "TI"], "3"]}], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["Z", "TI"], "1"], 
       SubscriptBox[
        StyleBox["Z", "TI"], "2"], 
       SubscriptBox[
        StyleBox["Z", "TI"], "3"]}]}], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "."}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2114060994,ExpressionUUID->"140e9407-21c5-ceb8-4af0-508a79420211"],

Cell[TextData[{
 "A measurement whose outcome is random does not branch: it allocates a \
formal bit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70529f41-a3b1-9234-112a-2bf4ddbe6539"],
 ", which enters its generator as the sign ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["k", "TI"]]], "=", "1", "-", "2", 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bbfbe6d-a656-4900-46ae-43975b6ae4d6"],
 ". A measurement whose outcome is already determined is stored as a Boolean \
function of the earlier bits."
}], "Text",
 CellID->642701906,ExpressionUUID->"64c4d0d4-81eb-7099-1825-1d4e975db565"],

Cell[TextData[{
 "Each state is measured once with formal bits; each run reports how many \
formal bits were allocated and the stored third outcome ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["m", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "033b363e-67f4-514d-3de1-3dff9758cb26"],
 ", and the bars count 1000 shots drawn by substituting random values of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c5dad11-91b6-b3ff-23bb-803653c24822"],
 ":"
}], "Text",
 CellID->1585072493,ExpressionUUID->"3c49cbd9-3b75-2ba9-39a5-6bc5cafcc097"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parityState", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "3", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"parityPanel", "[", 
    RowBox[{"label_", ",", " ", "ps_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ms", " ", "=", " ", 
       RowBox[{"ps", "[", 
        RowBox[{"\"\<SymbolicMeasure\>\"", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"Union", "[", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"ms", "[", "\"\<Phase\>\"", "]"}], ",", " ", "_\[FormalS]",
            ",", " ", "Infinity"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"m3", " ", "=", " ", 
        RowBox[{"First", "[", 
         RowBox[{"Values", "[", 
          RowBox[{"ms", "[", "\"\<Outcomes\>\"", "]"}], "]"}], "]"}]}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"BarChart", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"Counts", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"Keys", "[", 
              RowBox[{"#", "[", 
               RowBox[{"\"\<M\>\"", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], 
              "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"ms", "[", 
            RowBox[{"\"\<SampleOutcomes\>\"", ",", " ", "1000"}], "]"}]}], 
          "]"}], ",", " ", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}], ",", 
         " ", "0"}], "]"}], ",", "\n", "     ", 
       RowBox[{"ChartLabels", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"StringJoin", "[", 
            RowBox[{"ToString", " ", "/@", " ", "#"}], "]"}], " ", "&"}], " ",
           "/@", " ", 
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}], 
         ")"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<m\>\"", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
             " ", 
            RowBox[{"Range", "[", "3", "]"}]}], "]"}], ",", 
          " ", "\"\<shots\>\""}], "}"}]}], ",", "\n", "     ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"label", ",", " ", "\"\<:  \>\"", ",", " ", 
           RowBox[{"Length", "[", "s", "]"}], ",", 
           " ", "\"\< formal bits,  \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<m\>\"", ",", " ", "3"}], "]"}], ",", 
           " ", "\"\< = \>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"BooleanFunction", "[", "\n", "          ", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Tuples", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "2"}], 
                 "]"}], " ", "->", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"m3", " ", "/.", " ", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"s", " ", "->", " ", "#"}], "]"}]}], " ", "&"}], 
                  " ", "/@", " ", 
                  RowBox[{"Tuples", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "2"}], 
                   "]"}]}], ")"}]}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<s\>\"", ",", " ", "1"}], "]"}], ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<s\>\"", ",", " ", "2"}], "]"}]}], "}"}], ",", 
              " ", "\"\<ANF\>\""}], "]"}], "]"}]}], "}"}], "]"}]}], ",", " ", 
       
       RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
   RowBox[{"Grid", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"parityPanel", "[", 
         RowBox[{"\"\<no error\>\"", ",", " ", "parityState"}], "]"}], ",", 
        " ", 
        RowBox[{"parityPanel", "[", 
         RowBox[{"\"\<X on qubit 1\>\"", ",", " ", 
          RowBox[{"parityState", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<X\>\"", " ", "->", " ", "1"}], "}"}], "]"}]}], 
         "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"parityPanel", "[", 
         RowBox[{"\"\<X on qubit 3\>\"", ",", " ", 
          RowBox[{"parityState", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<X\>\"", " ", "->", " ", "3"}], "}"}], "]"}]}], "]"}],
         ",", " ", 
        RowBox[{"parityPanel", "[", 
         RowBox[{"\"\<Z on qubit 1\>\"", ",", " ", 
          RowBox[{"parityState", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Z\>\"", " ", "->", " ", "1"}], "}"}], "]"}]}], 
         "]"}]}], "}"}]}], "}"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[77]:= ",
 CellID->1896941325,ExpressionUUID->"19e15222-b26e-4293-5e13-1bf412a845b7"],

Cell[TextData[{
 "Each state allocates two formal bits, and the shots split evenly over four \
strings: two fair coins and one dependent bit. Without an error ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], "3"], "=", 
   SubscriptBox[
    StyleBox["s", "TI"], "1"], 
   RowBox[{"\\", "veebar"}], 
   SubscriptBox[
    StyleBox["s", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "339faf49-cdde-f936-3ea3-68cc9efa2f7d"],
 " and every shot has even parity. An ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab195d5-5429-d354-6487-14744a2905bb"],
 " on qubit 1 or on qubit 3 negates the stored function and moves every shot \
to odd parity, which is how a parity check detects a bit flip; a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29de2658-f8de-2ca5-36d4-f8ad8e412b8a"],
 " error changes nothing that a ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4255e0f7-2601-81b0-7e3c-e197b78bbaf8"],
 " measurement sees."
}], "Text",
 CellID->1438985926,ExpressionUUID->"104bbd83-259d-c369-762d-237a9af684cd"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->345451514,ExpressionUUID->"7485fcf4-c7ed-8e90-4922-6b2280df651d"],

Cell["\<\
T gates as a sum of stabilizer states: how many terms survive compression\
\>", "Subsection",
 CellID->781238310,ExpressionUUID->"71ba1e7b-e796-a088-74b6-531fdd8cbedc"],

Cell[TextData[{
 "The gate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[Pi]", "/", "4"}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02de5244-587a-70e2-07cd-f64917691a0b"],
 " is not a Clifford gate, so a state made with ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ebddb26-7094-f3aa-681c-cca0dcdfeb3e"],
 " T gates is stored as a sum of stabilizer states. On ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15f01f1f-0611-dd9e-2278-050f8714dfff"],
 " qubits, two circuits use ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4058a8a4-eb84-18f1-08c2-01ff4f5ea40b"],
 " T gates: in the first, qubits ",
 Cell[BoxData[
  RowBox[{"1", ",", "\[Ellipsis]", ",", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376778f1-6775-b070-0d31-bf7c6b4f7715"],
 " each get ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d277fbd-cfb0-fbb3-40f8-504552a246cb"],
 " then ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d88fd58-316d-98f2-213e-0e22e7f9fc35"],
 ", and a CNOT ladder then entangles the chain; in the second, the ladder \
first makes a GHZ state and the T gates follow. How many terms does the frame \
keep after compression as ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "607f2717-43ce-ea8c-6697-abb00084e501"],
 " grows?"
}], "Text",
 CellID->1918869644,ExpressionUUID->"36a523c9-6d2f-e53b-5259-931c374071b4"],

Cell[TextData[{
 "As an operator, ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d022b1f-7b33-760f-7901-e654962d09e1"],
 " on qubit ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ee6f64-4d11-8f1d-1c30-7dd2e90889a9"],
 " is a sum of two Pauli operators,"
}], "Text",
 CellID->1317672405,ExpressionUUID->"3737f4b1-9b58-5290-1f28-480423175b7b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["q", "TI"]], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"1", "+", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["i", "TI"], "\[Pi]", "/", "4"}]]}], "2"], "\|01d7d9"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["i", "TI"], "\[Pi]", "/", "4"}]]}], "2"], 
      SubscriptBox[
       StyleBox["Z", "TI"], 
       StyleBox["q", "TI"]]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["i", "TI"], "=", "1"}], 
      SuperscriptBox["2", 
       StyleBox["t", "TI"]],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["i", "TI"]], 
      TemplateBox[{
        SubscriptBox[
         StyleBox["s", "TI"], 
         StyleBox["i", "TI"]]},
       "Ket"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1701460244,ExpressionUUID->"748f43ad-6c3b-5cf6-5f38-f68196f0fc44"],

Cell[TextData[{
 "so each T gate doubles the list of stabilizer states ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["i", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e18b48f-946f-cfe9-36e8-64a738a239e0"],
 " in the frame. The overlaps ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["j", "TI"]]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ba0ce67-2ae3-effe-496b-1e11bb2473c6"],
 " follow from the tableaux, and from them the reduction keeps a largest \
linearly independent subset of the ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["i", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e70e285-b728-f624-57fe-ff2bc0496d97"],
 " and recomputes the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6151e1c9-4240-cda3-3c6b-d35364cd602f"],
 " exactly, so ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Psi]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "453e18e7-a447-0135-1110-87a641f7fe08"],
 " is unchanged."
}], "Text",
 CellID->770237767,ExpressionUUID->"76f46e24-24c4-a838-5ab9-7e12f0495a5f"],

Cell[TextData[{
 "The figure counts each state's terms after this reduction against the \
number of T gates, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["t", "TI"], "=", "1"}], ",", "\[Ellipsis]", ",", "5"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c32a1d-5e6b-1cc8-7aab-582dac812d16"],
 ", on a log scale, computed at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "5"}], ",", "10", ",", "\[Ellipsis]", ",", 
   "30"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46ca80f0-0566-2139-02c8-9a883b49016f"],
 ":"
}], "Text",
 CellID->1772637398,ExpressionUUID->"600c7cc7-c884-a891-2f6c-b30687d771aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"magicLadder", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"i", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"magicProduct", "[", 
    RowBox[{"n_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "t", "]"}]}], "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"\"\<T\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "t", "]"}]}], "]"}], ",", " ", 
     RowBox[{"magicLadder", "[", "n", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"magicGHZ", "[", 
    RowBox[{"n_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"magicLadder", "[", "n", "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{"\"\<T\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "t", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"magicTerms", "[", 
    RowBox[{"n_", ",", " ", "gates_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"PauliStabilizer", "[", "n", "]"}], "[", "gates", "]"}], 
     "[", "\"\<Compress\>\"", "]"}], "[", "\"\<Length\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"magicCounts", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"magicTerms", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"n", ",", " ", "t"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "5", ",", " ", "30", ",", " ", "5"}], "}"}]}], 
      "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"magicProduct", ",", " ", "magicGHZ"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Range", "[", "5", "]"}], ",", " ", 
         RowBox[{"First", " ", "/@", " ", "#"}]}], "}"}], "]"}], " ", "&"}], ",",
      " ", "magicCounts"}], "]"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "12"}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<H, T on qubits 1..t, then ladder\>\"", ",", 
      " ", "\"\<ladder (GHZ), then T on qubits 1..t\>\""}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "0.7"}], ",", "\n", "  ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<T gates t\>\"", ",", 
      " ", "\"\<stabilizer terms after compression\>\""}], "}"}]}], ",", " ", 
   
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "5"}], "]"}]}], ",", " ", "None"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"All", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.8", ",", " ", "45"}], "}"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"magicCounts", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Equal", " ", "@@", " ", "#"}], " ", "&"}]}], "]"}], ",", 
      " ", "\"\<the same counts at every n = 5, 10, \[Ellipsis], 30\>\"", ",",
       " ", "\"\<the counts depend on n\>\""}], "]"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "460"}]}], "]"}]}], "Input",
 CellLabel->"In[78]:= ",
 CellID->1656605365,ExpressionUUID->"640a58a9-c307-58ec-164a-1c5dbc2858fa"],

Cell[TextData[{
 "When each T gate acts on its own ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647aa5ad-57b7-e3d1-7e0e-2eecc9e61a18"],
 ", the ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49630852-51c5-6140-70ac-81d38e727dee"],
 " terms are linearly independent and compression removes none, at every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f530751-079f-e2d9-7d6e-5214eaf7fca5"],
 ", while the state vector has ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78e73930-1aa7-e0b7-1877-f5fdac405afe"],
 " amplitudes. On the GHZ state the T gates only change the relative phase of \
",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[CenterEllipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "058b4b1e-2ca8-6124-54b7-980e942041df"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"1", "\[CenterEllipsis]", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48cf84aa-80a9-9747-5394-9149d06b1b96"],
 ", and two terms suffice for every ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e2fce58-cf5e-b713-7ae9-fe07cc8c241b"],
 ". For even ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70541e4f-2363-624a-3e5c-598404ab8437"],
 " that phase is a power of ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ae540-428f-65ab-0388-80609b69d793"],
 ", so the state is a single stabilizer state, yet the frame still keeps two \
terms: the count bounds the stabilizer rank from above."
}], "Text",
 CellID->1867175288,ExpressionUUID->"1b0ba59d-cdb2-0749-5294-1817c346115c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->648158631,ExpressionUUID->"3b29d31a-50d9-dfbc-66cf-cd4a57e0739a"],

Cell["\<\
Repetition code: the logical error rate is a polynomial in the flip \
probability\
\>", "Subsection",
 CellID->1446489158,ExpressionUUID->"3fc85105-b707-5967-3e10-bf4e37010e49"],

Cell[TextData[{
 "One bit is stored in an odd number ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e871863-06d9-de97-4049-7fbbadd03582"],
 " of qubits as ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[CenterEllipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0acaee05-629d-bc64-0c13-b799f41d83f3"],
 ". Each qubit is flipped independently with probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b401dbb-6b0d-b362-6eae-af80d75cca1c"],
 ", and the bit is decoded by majority vote. For which ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62cf6bd3-8358-17e0-05a9-3dda84848f2b"],
 " does a longer code lower the probability ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["L", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e34cbe0-6fc7-c38f-12fd-2083a72368a4"],
 " that the decoded bit is wrong?"
}], "Text",
 CellID->697264675,ExpressionUUID->"77851f10-b8b6-05e8-2040-39f9c643005f"],

Cell["Each qubit passes through the bit-flip channel", "Text",
 CellID->1668784320,ExpressionUUID->"338ed2a2-56d4-9a73-483b-b1bb0f2575a5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalE]", 
     StyleBox["p", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["p", "TI"], "\[ThinSpace]", 
    StyleBox["X", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox["X", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1650123869,ExpressionUUID->"56c274d1-7be7-c170-3a21-084ad739b40e"],

Cell[TextData[{
 "and majority vote fails when more than ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "105b3330-dba0-722b-3dcd-a841b1367b70"],
 " qubits flipped, so"
}], "Text",
 CellID->310598603,ExpressionUUID->"4d28d210-de3d-4322-0ce5-ce5ebae039d7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["L", "TI"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["n", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "TI"], ">", 
       StyleBox["n", "TI"], "/", "2"}],
      LimitsPositioning->False], 
     RowBox[{
      TemplateBox[{
        StyleBox["n", "TI"], 
        StyleBox["k", "TI"]},
       "Binomial"], 
      SuperscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["k", "TI"]], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         StyleBox["p", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       RowBox[{
        StyleBox["n", "TI"], "-", 
        StyleBox["k", "TI"]}]]}]}], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["I", "TI"], 
      StyleBox["p", "TI"]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          StyleBox["n", "TI"], "+", "1"}], "2"], ",", 
        FractionBox[
         RowBox[{
          StyleBox["n", "TI"], "+", "1"}], "2"]}], ")"}], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1234023651,ExpressionUUID->"220409f7-bea9-b56d-0d4f-570a2400261b"],

Cell[TextData[{
 "The bit-flip channel acts on each qubit of the stabilizer state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", "\[CenterEllipsis]", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3762cbd7-8ea9-ce05-02c6-27584ad0e1de"],
 "; every application splits each branch into an unflipped and a flipped \
tableau with weights ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d79a293-695f-8ab2-750c-dce4752b2d43"],
 " and ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c594e9f-d56f-0f17-002c-c3cc80be4cdb"],
 ", and qubit ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49dc95a3-cdba-1540-6c1b-43201247f904"],
 " reads 1 when its generator ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["Z", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19e3531d-9c1f-da8a-774e-f777316edc1d"],
 " has sign ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "263c2e71-8902-7bca-2922-4f14b3f3b584"],
 ". Summing the weights of the failing branches gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["L", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec00fcc-b681-9fd2-5e9f-6d47d0b4e3f3"],
 " exactly; the regularized beta function ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34dad0c5-3c1d-ccd8-1cd4-5d170bfd5026"],
 " (dashed) extends it to long codes:"
}], "Text",
 CellID->264487653,ExpressionUUID->"2d36411d-5ce1-5337-0b42-37754c256086"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"repFlip", "[", 
    RowBox[{"branches_", ",", " ", "q_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Join", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"w", ",", " ", "ps"}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"w", " ", "#1"}], ",", " ", "#2"}], "}"}], " ", "&"}], 
         " ", "@@@", " ", 
         RowBox[{
          RowBox[{"QuantumChannel", "[", 
           RowBox[{
            RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], ",", " ", 
            RowBox[{"{", "q", "}"}]}], "]"}], "[", "ps", "]"}]}]}], "]"}], 
      " ", "@@@", " ", "branches"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"repRate", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Fold", "[", 
        RowBox[{"repFlip", ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"PauliStabilizer", "[", "n", "]"}]}], "}"}], "}"}], ",", 
         " ", 
         RowBox[{"Range", "[", "n", "]"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"w_", ",", " ", "ps_"}], "}"}], " ", "/;", " ", 
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"ps", "[", "\"\<StabilizerSigns\>\"", "]"}], ",", " ", 
            RowBox[{"-", "1"}]}], "]"}], " ", ">", " ", 
          RowBox[{"n", "/", "2"}]}]}], " ", ":>", " ", "w"}]}], "]"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"repRates", " ", "=", " ", 
   RowBox[{"repRate", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "3", ",", " ", "5", ",", " ", "7"}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"repPanels", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"repRates", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"BetaRegularized", "[", 
             RowBox[{"p", ",", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#", " ", "+", " ", "1"}], ")"}], "/", "2"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#", " ", "+", " ", "1"}], ")"}], "/", "2"}]}], "]"}],
             " ", "&"}], " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"21", ",", " ", "101"}], "}"}]}]}], "]"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", "\n", "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
          "Automatic", ",", " ", "Dashed", ",", " ", "Dashed"}], "}"}]}], ",",
        " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<n = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{
           "1", ",", " ", "3", ",", " ", "5", ",", " ", "7", ",", " ", "21", ",",
             " ", "101"}], "}"}]}], ")"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}]}], "}"}]}], ",",
        "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
           " ", "\"\<(n+2) < \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
           " ", "\"\<(n)  \[DoubleLongLeftRightArrow]  \>\"", ",", "\n", 
           "       ", 
           RowBox[{"First", "[", 
            RowBox[{"Union", "[", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Reduce", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#2", " ", "<", " ", "#1"}], " ", "&&", " ", 
                   RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], ",",
                   " ", "p"}], "]"}], " ", "&"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Most", "[", "repRates", "]"}], ",", " ", 
                 RowBox[{"Rest", "[", "repRates", "]"}]}], "}"}]}], "]"}], 
             "]"}], "]"}]}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", "repRates", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}], ",", " ", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<p\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}]}], "}"}]}], ",",
        "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<P\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
           " ", "\"\<(3) = \>\"", ",", " ", 
           RowBox[{"repRates", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Row", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"First", "[", 
        RowBox[{"First", "[", "repPanels", "]"}], "]"}], ",", " ", 
       RowBox[{"Last", "[", "repPanels", "]"}]}], "}"}], ",", 
     " ", "\"\<  \>\""}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "repPanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[79]:= ",
 CellID->690387256,ExpressionUUID->"3597fab9-d8c0-bc44-5940-5f4683e84cfd"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e7ee76-1ce9-2862-7090-69592f544735"],
 " the rate has no linear term, so at small ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e1b2d7a-4f0a-f161-1acf-788406635849"],
 " the code fails far less often than a bare qubit; on the log-log axes each \
code becomes a straight line at small ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27120b47-0aba-a9a6-1411-0557b34bacaf"],
 ", with slope equal to the smallest number of flips that defeats the \
majority. All curves meet at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c3bafbf-4d85-c18f-09ac-03400888d6f1"],
 " and tend to a step there as ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285f3e23-887c-e27c-5921-02068bc9c74b"],
 " grows, and the exact threshold is the same for each pair of neighboring \
codes drawn: below one half the longer code is better, above it worse. For \
every odd ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "2", 
   StyleBox["m", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4951fc66-e83d-ae15-6dde-c02a6fb618e9"],
 " the difference factors as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["L", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["n", "TI"], "+", "2"}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "-", 
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["L", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["n", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], "=", 
   RowBox[{
    TemplateBox[{
      RowBox[{"2", 
        StyleBox["m", "TI"], "+", "1"}], 
      StyleBox["m", "TI"]},
     "Binomial"], "\[ThinSpace]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["p", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        StyleBox["p", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     RowBox[{
      StyleBox["m", "TI"], "+", "1"}]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"2", 
      StyleBox["p", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c4225bd-ee1f-d21e-0c05-f5ccfeea38f6"],
 ", which has the sign of ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["p", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a68d8dd-f94a-2430-2b63-cd55d8e11cc6"],
 "."
}], "Text",
 CellID->284878162,ExpressionUUID->"07e0d3e4-a5b8-ae64-0e1e-70ed21670326"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->918898713,ExpressionUUID->"2563e764-f206-b889-4893-9141058cc955"],

Cell["\<\
Variational ground state: plain against natural gradient descent\
\>", "Subsection",
 CellID->2037855749,ExpressionUUID->"05da6c86-6c5b-034f-4c86-2eae932d4c0e"],

Cell[TextData[{
 "A variational quantum eigensolver looks for the ground state of ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7260ef6a-47d5-e079-57a7-21b6527fb4d9"],
 " by adjusting the two angles of a one-qubit circuit to lower ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a591699-652d-4dab-3cb9-bdfbe9060c32"],
 ". Plain gradient descent steps against the gradient; quantum natural \
gradient descent first rescales it by the geometry of the state space. From \
different starting angles and learning rates ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e9b98c7-614f-4c76-1e3b-e26f38e311c8"],
 ", which optimizer reaches the ground energy in fewer steps?"
}], "Text",
 CellID->1775332556,ExpressionUUID->"124106be-4829-92c9-4f60-f54f3b1be8b5"],

Cell["The circuit, its energy and the update rules are", "Text",
 CellID->2019661220,ExpressionUUID->"42c7673c-c1c8-76d1-373c-53b4c6e0f720"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["\[Theta]", "TI"], ",", 
        StyleBox["\[Phi]", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["P", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"2", 
        StyleBox["\[Phi]", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      SubscriptBox[
       StyleBox["R", "TI"], 
       StyleBox["Y", "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"2", 
        StyleBox["\[Theta]", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      TemplateBox[{"0"},
       "Ket"]}], "=", 
     RowBox[{
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], 
       StyleBox["\[Theta]", "TI"], 
       TemplateBox[{"0"},
        "Ket"]}], "+", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"2", 
         StyleBox["i", "TI"], 
         StyleBox["\[Phi]", "TI"]}]], 
       StyleBox["sin",
        FontSlant->"Plain"], 
       StyleBox["\[Theta]", "TI"], 
       TemplateBox[{"1"},
        "Ket"]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["E", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Theta]", "TI"], ",", 
       StyleBox["\[Phi]", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      TemplateBox[{
        StyleBox["\[Psi]", "TI"]},
       "Bra"], 
      StyleBox["X", "TI"], 
      TemplateBox[{
        StyleBox["\[Psi]", "TI"]},
       "Ket"]}], "=", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "2", 
      StyleBox["\[Theta]", "TI"], 
      StyleBox["cos",
       FontSlant->"Plain"], "2", 
      StyleBox["\[Phi]", "TI"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2064005861,ExpressionUUID->"262177cd-1ab7-f5c0-371e-0cc5b8ee1e40"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox[
      StyleBox["\[Theta]", "TI"],
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["k", "TI"], "+", "1"}]], "=", 
    SubscriptBox[
     StyleBox[
      StyleBox["\[Theta]", "TI"],
      FontWeight->"Bold"], 
     StyleBox["k", "TI"]], "-", 
    StyleBox["\[Eta]", "TI"], "\[ThinSpace]", "\[Del]", 
    StyleBox["E", "TI"], "\[NonBreakingSpace]\[NonBreakingSpace]", 
    StyleBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], "plain", 
      StyleBox[")",
       SpanMaxSize->1]}],
     FontSlant->"Plain"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox[
      StyleBox["\[Theta]", "TI"],
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["k", "TI"], "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox[
       StyleBox["\[Theta]", "TI"],
       FontWeight->"Bold"], 
      StyleBox["k", "TI"]], "-", 
     RowBox[{
      StyleBox["\[Eta]", "TI"], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["g", "TI"], 
       RowBox[{"-", "1"}]], 
      RowBox[{"\[Del]", 
       StyleBox["E", "TI"]}], "\[NonBreakingSpace]\[NonBreakingSpace]", 
      StyleBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], "natural", 
        StyleBox[")",
         SpanMaxSize->1]}],
       FontSlant->"Plain"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1777479961,ExpressionUUID->"5c706e49-ccd2-db38-6540-8064fb86bc55"],

Cell[TextData[{
 "with the Fubini-Study metric ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", 
   RowBox[{
    RowBox[{
     StyleBox["Re",
      FontSlant->"Plain"], 
     RowBox[{"(", 
      RowBox[{
       TemplateBox[{
         RowBox[{
           SubscriptBox["\[PartialD]", 
            StyleBox["i", "TI"]], 
           StyleBox["\[Psi]", "TI"]}], 
         RowBox[{
           SubscriptBox["\[PartialD]", 
            StyleBox["j", "TI"]], 
           StyleBox["\[Psi]", "TI"]}]},
        "BraKet"], "-", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            SubscriptBox["\[PartialD]", 
             StyleBox["i", "TI"]], 
            StyleBox["\[Psi]", "TI"]}], 
          StyleBox["\[Psi]", "TI"]},
         "BraKet"], 
        TemplateBox[{
          StyleBox["\[Psi]", "TI"], 
          RowBox[{
            SubscriptBox["\[PartialD]", 
             StyleBox["j", "TI"]], 
            StyleBox["\[Psi]", "TI"]}]},
         "BraKet"]}]}], ")"}]}], "=", 
    RowBox[{
     StyleBox["diag",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", ",", 
       RowBox[{
        SuperscriptBox[
         StyleBox["sin",
          FontSlant->"Plain"], "22"], 
        StyleBox["\[Theta]", "TI"]}]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71796852-527a-6fd8-61e4-07b23a379329"],
 ". It vanishes in the ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7370f215-dcb1-7813-762d-ca7bb4bf5c96"],
 " direction at the poles ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Theta]", "TI"], "=", "0"}], ",", 
   RowBox[{"\[Pi]", "/", "2"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d8c381a-a250-c485-6148-b1d3c21a4f99"],
 ", where ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3daceba6-6844-4cdd-0ff1-5af022ed3d50"],
 " no longer changes the state."
}], "Text",
 CellID->913271290,ExpressionUUID->"3875c277-9191-2049-4897-dba00bb5cac6"],

Cell[TextData[{
 "The metric ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee79c9f-6e73-4f5d-266b-a8830b6eeeea"],
 " is that of the circuit's state; both optimizers run 40 steps on the exact \
gradient:"
}], "Text",
 CellID->714909948,ExpressionUUID->"251ba514-c975-accc-790d-bcb4bd3d0404"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`QuantumOptimization`\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vqeState", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<RY\>\"", "[", 
        RowBox[{"2", " ", "\[FormalTheta]"}], "]"}], ",", " ", 
       RowBox[{"\"\<P\>\"", "[", 
        RowBox[{"2", " ", "\[FormalPhi]"}], "]"}]}], "}"}], "]"}], "[", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vqeEnergy", "[", 
    RowBox[{"th_", ",", " ", "ph_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vqeState", "[", "\"\<Dagger\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], "[", "vqeState", 
        "]"}], "]"}], "[", "\"\<Scalar\>\"", "]"}], "]"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[FormalTheta]", " ", "->", " ", "th"}], ",", " ", 
      RowBox[{"\[FormalPhi]", " ", "->", " ", "ph"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vqeGrad", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"th", ",", " ", "ph"}], "}"}], ",", " ", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"vqeEnergy", "[", 
         RowBox[{"th", ",", " ", "ph"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"th", ",", " ", "ph"}], "}"}], "}"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vqeMetric", " ", "=", " ", 
   RowBox[{"FubiniStudyMetricTensor", "[", 
    RowBox[{"vqeState", ",", " ", 
     RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[FormalTheta]", ",", " ", "\[FormalPhi]"}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vqePanel", "[", 
    RowBox[{"\[Eta]_", ",", " ", "start_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"vqeEnergy", " ", "@@@", " ", 
        RowBox[{"Re", "[", 
         RowBox[{"QuantumNaturalGradientDescent", "[", 
          RowBox[{"vqeEnergy", ",", " ", "vqeMetric", ",", " ", 
           RowBox[{"\"\<InitialPoint\>\"", " ", "->", " ", "start"}], ",", 
           " ", 
           RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "\[Eta]"}], ",", 
           " ", 
           RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "40"}], ",", " ", 
           
           RowBox[{"\"\<Gradient\>\"", " ", "->", " ", "vqeGrad"}]}], "]"}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"vqeEnergy", " ", "@@@", " ", 
        RowBox[{"GradientDescent", "[", 
         RowBox[{"vqeEnergy", ",", " ", "start", ",", " ", 
          RowBox[{"\"\<LearningRate\>\"", " ", "->", " ", "\[Eta]"}], ",", 
          " ", 
          RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "40"}], ",", " ", 
          RowBox[{"\"\<Gradient\>\"", " ", "->", " ", "vqeGrad"}]}], 
         "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "40"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.1"}], ",", " ", "1.1"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<natural gradient\>\"", ",", 
        " ", "\"\<plain gradient\>\""}], "}"}]}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<step\>\"", ",", " ", "\"\<E\>\""}], "}"}]}], ",", "\n", 
     "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]", ",", 
         " ", "\"\<,   (\[Theta], \[Phi]) = (\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"start", ",", " ", "\"\<, \>\""}], "]"}], ",", 
         " ", "\"\<)\>\""}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vqePanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"vqePanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", " ", "0.2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "12"}], ",", " ", 
         RowBox[{"\[Pi]", "/", "12"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "3"}], ",", " ", 
         RowBox[{"\[Pi]", "/", "12"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.01", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "1"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"First", ",", " ", "vqePanels", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"vqePanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[80]:= ",
 CellID->404121397,ExpressionUUID->"520e1f9a-5eed-f422-521c-ee3b7c21aee0"],

Cell[TextData[{
 "At the smaller rate the natural gradient reaches the ground energy in fewer \
steps from every start. At the larger rate, from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", "/", "12"}], ",", 
    RowBox[{"\[Pi]", "/", "12"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2351942e-6187-0779-2b9b-0cc2a5d2800c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.01", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f5148bd-bbb2-2df3-5b20-08852f01c274"],
 ", its rescaled steps overshoot and the energy climbs back up before it \
falls, so plain descent gets there sooner. From ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", "/", "3"}], ",", 
    RowBox[{"\[Pi]", "/", "12"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55d0f07f-82a4-b4dc-6559-2fd56b2163d3"],
 " plain descent, at either rate, stalls at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ba602a4-b6f7-d510-43a5-679fa07aa54b"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"\[Pi]", "/", "2"}], ",", 
    RowBox[{"\[Pi]", "/", "4"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "129da705-4679-9234-029d-8f507e9f55ce"],
 ", a point on the pole ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518c500c-d5d9-1219-6ee4-45e6cffad1ae"],
 " where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[PartialD]", 
    StyleBox["\[Theta]", "TI"]], 
   StyleBox["E", "TI"], "=", "-", "2", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "2", 
   StyleBox["\[Phi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3266eab8-4d2f-879c-581e-7e1e3837f8c2"],
 " also vanishes, a saddle although ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "430adb87-ec68-4297-4d79-59da82604f8c"],
 " is not an eigenstate of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bb43e3b-f1fc-bb8d-3878-c6eeab80a51d"],
 "; the natural gradient follows the steepest descent on the states \
themselves and reaches the ground energy."
}], "Text",
 CellID->1453361039,ExpressionUUID->"240b7de9-9ed0-e591-4880-8d02dd29cf1b"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->640964388,ExpressionUUID->"025aeb51-504a-e2ae-3de1-34ec4526f3a4"],

Cell["Quantum linear solver: HHL on four qubits", "Subsection",
 CellID->1587525934,ExpressionUUID->"65b4b954-75ff-5aa9-18b9-3cb494190914"],

Cell[TextData[{
 "Solve ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox[
    StyleBox["x", "TI"],
    FontWeight->"Bold"], "=", 
   StyleBox[
    StyleBox["b", "TI"],
    FontWeight->"Bold"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f04d370-84a3-72a6-3bc4-200d53c52249"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", "(", GridBox[{
     {"1", 
      RowBox[{"-", "1", "/", "3"}]},
     {
      RowBox[{"-", "1", "/", "3"}], "1"}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cf112cf-283c-67ef-7440-3141bf5f97fb"],
 " and the unit vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    StyleBox["b", "TI"],
    FontWeight->"Bold"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b914e2-ed17-926d-071a-52a6d539abff"],
 ". The Harrow-Hassidim-Lloyd (HHL) circuit loads ",
 Cell[BoxData[
  StyleBox[
   StyleBox["b", "TI"],
   FontWeight->"Bold"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21d8158c-9815-b5d1-1b62-b9a8744db29b"],
 " into one qubit, writes the eigenvalues of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "005bf144-e85b-b8d9-5feb-a3a9c38d781f"],
 " into a two-qubit clock by phase estimation, rotates an ancilla by an angle \
set by each eigenvalue, clears the clock, and keeps only the runs where the \
ancilla reads 1. Does the kept qubit give the probabilities ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["j", "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", 
   SuperscriptBox[GridBox[{
      {
       StyleBox[
        StyleBox["x", "TI"],
        FontWeight->"Bold"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d0b30fb-59ad-a683-42bc-532ad22a96ee"],
 " of the solution?"
}], "Text",
 CellID->53653229,ExpressionUUID->"70223f56-e838-939b-4177-996a3ce5cec7"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a290ec6-83c9-fc58-63cf-a61035483ab4"],
 " has eigenvalues ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["j", "TI"]], "=", "2", "/", "3"}], ",", "\[ThinSpace]", 
   RowBox[{"4", "/", "3"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51b1ae43-762f-0043-485d-bba25624972f"],
 " with eigenvectors ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["j", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a8fcf02-9009-deb8-0528-ffdf81f48238"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["j", "TI"]], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["j", "TI"]]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133a511d-7c85-3a48-5984-09eab8628ce7"],
 ". Phase estimation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "A", "t"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65df5aed-14d4-fce3-2ed1-6154259c3bf2"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "3", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35d140a3-6c7d-d66a-5c5b-d14f88218987"],
 " writes ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Lambda]", "TI"], "~"], 
     StyleBox["j", "TI"]], "=", 
    SuperscriptBox["2", "2"], 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["j", "TI"]], 
    StyleBox["t", "TI"], "/", "2", "\[Pi]", "=", "1"}], ",", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dd9e2ef-aebf-1dd8-7ffb-e9c3079bf409"],
 " into the clock, exactly, because the eigenvalue ratio is 2. The controlled \
rotation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Theta]", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0763aca6-1854-8c8b-14bb-10d8aeb90c25"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Theta]", "TI"], 
     StyleBox["j", "TI"]], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "/", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Lambda]", "TI"], "~"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bedd494-6877-a243-5742-b01f9723e80b"],
 ", followed by clearing the clock, gives"
}], "Text",
 CellID->534346608,ExpressionUUID->"7ddbc9d7-127e-4516-6039-2e88b4140d10"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["j", "TI"]], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["j", "TI"]]},
      "Ket"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox["0", 
         StyleBox["a", "TI"]]},
       "Ket"], "\[LongRightArrow]", 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->False], 
       RowBox[{
        SubscriptBox[
         StyleBox["b", "TI"], 
         StyleBox["j", "TI"]], 
        TemplateBox[{
          SubscriptBox[
           StyleBox["u", "TI"], 
           StyleBox["j", "TI"]]},
         "Ket"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SqrtBox[
            RowBox[{"1", "-", 
             SubsuperscriptBox[
              OverscriptBox[
               StyleBox["\[Lambda]", "TI"], "~"], 
              StyleBox["j", "TI"], 
              RowBox[{"-", "2"}]]}]], 
           TemplateBox[{
             SubscriptBox["0", 
              StyleBox["a", "TI"]]},
            "Ket"]}], "+", 
          RowBox[{
           SubsuperscriptBox[
            OverscriptBox[
             StyleBox["\[Lambda]", "TI"], "~"], 
            StyleBox["j", "TI"], 
            RowBox[{"-", "1"}]], 
           TemplateBox[{
             SubscriptBox["1", 
              StyleBox["a", "TI"]]},
            "Ket"]}]}], ")"}]}]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->15565204,ExpressionUUID->"20f5a582-dbb1-5144-1c9a-5a015724d64e"],

Cell[TextData[{
 "and the branch with the ancilla in ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526d7120-35ba-e031-5f0c-2e33727a2854"],
 " is proportional to ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["A", "TI"], 
    RowBox[{"-", "1"}]], 
   TemplateBox[{
     StyleBox["b", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6c36db-a10d-0bdc-45af-c337d15be76e"],
 "."
}], "Text",
 CellID->1312507050,ExpressionUUID->"12dfa206-a09a-3a86-10df-237459e755fb"],

Cell[TextData[{
 "Each clock value sets one bit, so each rotation needs a single control. The \
circuit is phase estimation without its initial ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ef2a4be-2bc1-5b9f-63e4-65d19a57a6c5"],
 " and final measurements; the ancilla and solution qubit are measured for \
general ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d63dd88-82a7-2508-7623-d837c73bf2a2"],
 " and compared with the direct solution of the linear system:"
}], "Text",
 CellID->1434259810,ExpressionUUID->"1e4d4c68-e00a-44aa-3ee2-77bda06f7f02"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hhlA", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "3"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "3"}], ",", " ", "1"}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"hhlQPE", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", 
     RowBox[{"\"\<PhaseEstimation\>\"", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{"I", " ", "3", " ", 
          RowBox[{"\[Pi]", "/", "4"}], " ", "hhlA"}], "]"}], "]"}], ",", " ", 
       "2"}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"2", " ", ";;", " ", 
      RowBox[{"-", "3"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hhlP", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"QuantumState", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Beta]", "]"}], ",", " ", 
               RowBox[{"Sin", "[", "\[Beta]", "]"}]}], "}"}], "]"}], " ", "->",
             " ", 
            RowBox[{"{", "4", "}"}]}], ",", " ", 
           RowBox[{"hhlQPE", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", "\n", 
           "       ", 
           RowBox[{"Splice", "[", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"\"\<C\>\"", "[", 
                 RowBox[{"\"\<RY\>\"", "[", "#1", "]"}], "]"}], " ", "->", 
                " ", 
                RowBox[{"{", 
                 RowBox[{"#2", ",", " ", "1"}], "}"}]}], " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"2", " ", 
                 RowBox[{"ArcSin", "[", 
                  RowBox[{"1", "/", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
                
                RowBox[{"{", 
                 RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "]"}], "]"}],
            ",", " ", 
           RowBox[{
            RowBox[{"hhlQPE", "[", "\"\<Dagger\>\"", "]"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{"{", "1", "}"}], ",", " ", 
           RowBox[{"{", "4", "}"}]}], "}"}], "]"}], "[", "]"}], 
       "[", "\"\<ProbabilitiesList\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hhlExact", " ", "=", " ", 
   RowBox[{
    RowBox[{"Last", "[", 
     RowBox[{"Normalize", "[", 
      RowBox[{"LinearSolve", "[", 
       RowBox[{"hhlA", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Beta]", "]"}], ",", " ", 
          RowBox[{"Sin", "[", "\[Beta]", "]"}]}], "}"}]}], "]"}], "]"}], 
     "]"}], "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"hhlKept", ",", " ", "hhlCond"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], "}"}], " ", "&"}], "[",
     "hhlP", "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"QuantumState", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Beta]", "]"}], ",", " ", 
               RowBox[{"Sin", "[", "\[Beta]", "]"}]}], "}"}], "]"}], " ", "->",
             " ", 
            RowBox[{"{", "4", "}"}]}], ",", " ", 
           RowBox[{"hhlQPE", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{"Splice", "[", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"\"\<C\>\"", "[", 
                 RowBox[{"\"\<RY\>\"", "[", "#1", "]"}], "]"}], " ", "->", 
                " ", 
                RowBox[{"{", 
                 RowBox[{"#2", ",", " ", "1"}], "}"}]}], " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"2", " ", 
                 RowBox[{"ArcSin", "[", 
                  RowBox[{"1", "/", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
                
                RowBox[{"{", 
                 RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "]"}], "]"}],
            ",", " ", 
           RowBox[{
            RowBox[{"hhlQPE", "[", "\"\<Dagger\>\"", "]"}], " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], ",", " ", 
           RowBox[{"{", "1", "}"}], ",", " ", 
           RowBox[{"{", "4", "}"}]}], "}"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "600"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<HHL: phase estimation, controlled rotation of the \
ancilla, uncompute\>\"", ",", " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"{", 
         RowBox[{"hhlExact", ",", " ", "hhlCond", ",", " ", "hhlKept"}], 
         "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", " ", "0", ",", " ", "\[Pi]"}], "}"}], ",", 
       " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", " ", "Dashed", ",", " ", "Automatic"}], 
         "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Beta]\>\"", ",", " ", "\"\<probability\>\""}], 
         "}"}]}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "\[Pi]", ",", " ", 
              RowBox[{"\[Pi]", "/", "4"}]}], "]"}], ",", " ", "None"}], 
           "}"}]}], "}"}]}], ",", "\n", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<LinearSolve:  \>\"", ",", " ", 
             RowBox[{"Subsuperscript", "[", 
              RowBox[{"\"\<x\>\"", ",", " ", "2", ",", " ", "2"}], "]"}], ",",
              " ", "\"\</|x|\.b2\>\""}], "}"}], "]"}], ",", 
          " ", "\"\<HHL:  P(solution qubit 1 | ancilla 1)\>\"", ",", 
          " ", "\"\<HHL:  P(ancilla 1)\>\""}], "}"}]}], ",", "\n", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<HHL - LinearSolve = \>\"", ",", " ", 
             RowBox[{"FullSimplify", "[", 
              RowBox[{
               RowBox[{"hhlCond", " ", "-", " ", "hhlExact"}], ",", " ", 
               RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}]}], "]"}], 
             ",", "\n", "     ", "\"\<,    P(ancilla 1) = \>\"", ",", " ", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"TrigReduce", "[", "hhlKept", "]"}], "]"}]}], "}"}], 
           "]"}], ",", " ", "13", ",", " ", 
          RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}]}], "}"}], ",", 
   " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[81]:= ",
 CellID->517940332,ExpressionUUID->"5627659b-315c-e66d-1dfd-d0a818c1772c"],

Cell[TextData[{
 "The HHL probability equals the direct solution identically in ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cc0f152-c272-fd76-5f60-69be11279b3e"],
 ": the kept qubit carries ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["x", "TI"], "2"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", 
   SuperscriptBox[GridBox[{
      {
       StyleBox[
        StyleBox["x", "TI"],
        FontWeight->"Bold"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d043012-0422-c3ab-735e-e564070aebc7"],
 ". The price is the post-selection: a run is always kept when ",
 Cell[BoxData[
  StyleBox[
   StyleBox["b", "TI"],
   FontWeight->"Bold"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "357313b7-60c4-6058-36d3-ac93c2c87e32"],
 " lies along the eigenvector of the smaller eigenvalue, whose rotation turns \
the ancilla fully to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26fd908b-1bce-ee8f-4bc8-c1a61f036d92"],
 ", and only a quarter of the time along the other. The identity holds \
because the two-qubit clock represents both eigenvalues exactly."
}], "Text",
 CellID->1907076075,ExpressionUUID->"0be9f524-ad3c-abcd-4e52-a8e3c5ae4939"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->741457491,ExpressionUUID->"0bfa7a57-33c6-6072-51b9-cdd3fb9edad4"],

Cell["Compiling a rotation from H and T gates", "Subsection",
 CellID->447046172,ExpressionUUID->"7e7e36f5-a6ad-496a-1e1d-852a56e80158"],

Cell[TextData[{
 "A fault-tolerant qubit offers only a finite gate set: the Clifford gates \
generated by ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03c7ac4f-8c10-17f0-08bd-224fcb842158"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   SuperscriptBox[
    StyleBox["T", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74d340f4-bde4-2b1e-5e79-6a01497a2399"],
 ", which are cheap, and the ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "533165fe-30fa-b785-27a4-3cbb96704a45"],
 " gate, which is expensive. Any target rotation ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dbd0326-8727-1611-41aa-9b2cdc984ae0"],
 " can only be approximated by a product of them. How does the best \
approximation improve as the number of ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c7604c7-a68c-1a53-6209-e5e744fa43e7"],
 " gates grows?"
}], "Text",
 CellID->1314470359,ExpressionUUID->"62dfd6af-c155-cacc-642b-62020adbc8e1"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[Pi]", "/", "4"}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bd97acc-2168-de80-5c60-c1aa23aaf504"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", 
   SuperscriptBox[
    StyleBox["T", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d58d3a2-8594-f0b9-1b1f-9fd1021d2583"],
 ", every product of these gates equals, up to a global phase, a normal form \
(Matsumoto and Amano)"
}], "Text",
 CellID->267534352,ExpressionUUID->"32afc2c9-5bf5-d2a1-7ee5-83a82cbd0474"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], "=", "(", 
    RowBox[{
     StyleBox["T", "TI"], " ", 
     StyleBox["or",
      FontSlant->"Plain"], " ", "1"}], ")", "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["s", "TI"], "1"], 
    SubscriptBox[
     StyleBox["s", "TI"], "2"], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["C", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["i", "TI"]], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      StyleBox[
       RowBox[{"H", "T"}], "TI"], ",", " ", 
      StyleBox[
       RowBox[{"S", "H", "T"}], "TI"]}], "}"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["C", "TI"], "\[Element]", 
    StyleBox[
     RowBox[{
     "the", "\[NonBreakingSpace]", "24", "\[NonBreakingSpace]", "Cliffords"}],
     
     FontSlant->"Plain"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1189494914,ExpressionUUID->"701a71fc-b3db-0713-5d11-3f29244e83c3"],

Cell[TextData[{
 "whose ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473e03bd-0dfa-75fd-23bc-f36f980c94bc"],
 " count is ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aa4b9c8-058a-9a84-4c00-864355246e0a"],
 " or ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ba9442d-8728-7b18-2054-0cfbb70cdfb2"],
 ", so from ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2379f0-02d6-3507-536e-566e6feaaff0"],
 " count 1 on, each extra ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3182eeca-e975-3e7b-78f3-8c8af92f5623"],
 " gate doubles the number of candidates. The error of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d3b1aa-6d79-0add-4717-8a037516bfce"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[CurlyEpsilon]", "TI"], "=", "1", "-", 
   FractionBox["1", "2"], GridBox[{
     {
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], "\[ThinSpace]", 
       SuperscriptBox[
        StyleBox["W", "TI"], "\[Dagger]"], 
       StyleBox["U", "TI"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66629cda-3ea4-1da0-7b7f-ef602fc7253d"],
 ", which ignores the global phase."
}], "Text",
 CellID->530383920,ExpressionUUID->"284198ee-945d-5d13-2134-05593fa24869"],

Cell[TextData[{
 "Every normal form up to ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233448c3-c24c-dd48-36cc-b4e1981effe7"],
 " count 16 is enumerated and the smallest error kept, for three rotations ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", 
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "\[CenterDot]", 
     StyleBox[
      StyleBox["\[Sigma]", "TI"],
      FontWeight->"Bold"], "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3addc22c-4043-932c-4a91-4bf535ca7196"],
 " (",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   RowBox[{
    StyleBox["x", "TI"], "+", 
    StyleBox["z", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445728ee-d902-dd07-7e22-332b1b2205da"],
 " rotates about ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "+", 
    OverscriptBox[
     StyleBox["z", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a7a5c0-e6cc-9779-57f7-ea8c88833f09"],
 "); the circuit that gives the ",
