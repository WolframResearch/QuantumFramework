Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sgFractions", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amps", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<WignerD\>\"", "[", 
           RowBox[{"j", ",", " ", 
            RowBox[{"-", "\[Theta]"}]}], "]"}], "]"}], "[", 
         RowBox[{"QuantumState", "[", 
          RowBox[{
           RowBox[{"UnitVector", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}], ",", " ", 
             RowBox[{
              RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "]"}], ",", 
           " ", 
           RowBox[{
            RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "]"}], "]"}], 
        "[", "\"\<AmplitudesList\>\"", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Last", "[", "amps", "]"}], "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Abs", "[", "amps", "]"}], "^", "2"}]}], ",", " ", 
       RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sgPanel", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fr", " ", "=", " ", 
       RowBox[{"sgFractions", "[", "j", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "fr", "]"}], ",", " ", 
          RowBox[{"Total", "[", "fr", "]"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "\[Pi]"}], "}"}], ",", 
       " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{"Automatic", ",", " ", 
            RowBox[{
             RowBox[{"2", " ", "j"}], " ", "+", " ", "1"}]}], "]"}], ",", " ",
           "Dashed"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<m = \>\"", ",", " ", "m"}], "}"}], "]"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"m", ",", " ", "j", ",", " ", 
                RowBox[{"-", "j"}], ",", " ", 
                RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
            " ", "\"\<passes magnet 2\>\""}], "]"}], ",", " ", "Below"}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<fraction of atoms\>\""}], 
         "}"}]}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", " ", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"TraditionalForm", "[", "#", "]"}], ",", " ", 
                  RowBox[{"FractionBoxOptions", " ", "->", " ", 
                   RowBox[{"{", 
                    RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], 
                 "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", " ", "\[Pi]", ",", " ", 
               RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}], ",", " ", "None"}], 
           "}"}]}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<j = \>\"", ",", " ", "j", ",", 
             " ", "\"\<:   P(m = \[Minus]j) = \>\"", ",", " ", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"First", "[", "fr", "]"}], "]"}]}], "}"}], "]"}], ",", 
          " ", "13", ",", " ", 
          RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
         "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "330"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sgQ", " ", "=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sgFractions", "[", "#", "]"}], " ", "==", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Binomial", "[", 
              RowBox[{
               RowBox[{"2", " ", "#"}], ",", " ", 
               RowBox[{"#", " ", "+", " ", "m"}]}], "]"}], " ", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"4", " ", "#"}], " ", "+", " ", 
                RowBox[{"2", " ", 
                 RowBox[{"(", 
                  RowBox[{"#", " ", "+", " ", "m"}], ")"}]}]}], ")"}]}], " ", 
             
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"(", 
                 RowBox[{"#", " ", "-", " ", "m"}], ")"}]}], ")"}]}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"m", ",", " ", 
              RowBox[{"-", "#"}], ",", " ", "#"}], "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "\[Pi]"}]}], 
        "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", " ", "1", ",", " ", 
        RowBox[{"3", "/", "2"}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sgPanel", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", " ", "1", ",", " ", 
         RowBox[{"3", "/", "2"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "990"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<P(m) = \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"HoldForm", "[", 
          RowBox[{
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"2", " ", "j"}], ",", " ", 
             RowBox[{"j", " ", "+", " ", "m"}]}], "]"}], " ", 
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", "j"}], " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"j", " ", "+", " ", "m"}], ")"}]}]}], ")"}]}], " ", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"(", 
               RowBox[{"j", " ", "-", " ", "m"}], ")"}]}], ")"}]}]}], "]"}], 
         "]"}], ",", " ", "\"\< at j = 1/2, 1, 3/2: \>\"", ",", " ", "sgQ"}], 
       "}"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[62]:= ",
 CellID->1138461175,ExpressionUUID->"6f68be87-ac81-291c-12b2-f35572bffb7e"],

Cell[TextData[{
 "With the second magnet aligned with the first, every atom stays in the top \
beam. Tilting it refills beams the first magnet had emptied, the bottom beam \
included, even though the second magnet only removes atoms. The bottom beam \
carries ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     FractionBox["1", "2"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"4", 
    StyleBox["j", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b960560-8640-8897-5a89-a346bb6eb2a7"],
 ", largest when the middle magnet is perpendicular and exponentially weaker \
for larger spin."
}], "Text",
 CellID->758374913,ExpressionUUID->"337be231-d3b2-a76b-3025-c882e93c6221"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
