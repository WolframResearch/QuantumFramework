Cell[BoxData[{
 RowBox[{
  RowBox[{"rabiDetunings", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"rabiP", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\[Omega]", " ", "->", " ", 
          RowBox[{"\[Omega]0", " ", "-", " ", "#"}]}]}], "}"}]}], " ", "&"}], 
     " ", "/@", " ", "rabiDetunings"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", 
     RowBox[{"4", " ", "Pi"}]}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalOmega] t\>\"", ",", " ", "\"\<P(1)\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<\[CapitalDelta]/\[CapitalOmega] = \>\"", ",", " ", 
          "#"}], "}"}], "]"}], " ", "&"}], " ", "/@", " ", "rabiDetunings"}], 
     ")"}]}]}], "]"}]}], "Input",
 CellLabel->"In[53]:= ",
 CellID->1363762949,ExpressionUUID->"4ac0cf2a-9fa3-4245-7c84-04d4bfe6eaa5"],

Cell[TextData[{
 "The drive moves at most ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "+", 
    SuperscriptBox["\[CapitalDelta]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c5ef511-dc31-af1e-635d-d3c165dd6e6c"],
 " of the population, and it oscillates at the generalized Rabi frequency ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "+", 
    SuperscriptBox["\[CapitalDelta]", "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "184c8166-d265-1ac1-3088-7b7191227879"],
 ", faster than on resonance. Only the detuning enters: ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6651bcaf-cbf9-69de-5400-c21559630acf"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10be80ec-549d-d1a1-5e99-b9c1ce824374"],
 " separately drop out."
}], "Text",
 CellID->1395687866,ExpressionUUID->"7f00ad41-301e-59e4-6ecb-ff9386581e21"],

