Cell[TextData[{
 "and for the fully bunched pattern ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6289ebee-d25d-97a9-0c41-0742c42e5c28"],
 " is ",
