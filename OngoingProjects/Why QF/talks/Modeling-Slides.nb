   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a82c9f0-10a7-3be4-7911-e08105e72621"],
 " and adds to the phase, so the controlled-Z needs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3310bb8b-79ff-fc5f-0e78-8ef0132adc05"],
 ". The nine-level phases follow the closed form closely at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "/", 
   StyleBox["g", "TI"], "=", "-", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ac1c2f3-8478-e4e1-0b7c-8d98d723134b"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "40"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f636f2e-2bbc-1d19-2e56-ce3ed2844a87"],
 " and fall away from it at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "/", 
   StyleBox["g", "TI"], "=", "-", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4422e774-dc93-0897-4571-a3cab39b51bc"],
 "."
}], "Text",
 CellID->2402323,ExpressionUUID->"14c56789-5f07-ba31-5645-4661dc14bf40"],

Cell["\<\
After one full swap, the gate on all nine levels, with each transmon's own \
phases removed, is shown by its real and imaginary parts; the white square \
marks the four computational states:\
\>", "Text",
 CellID->1989300973,ExpressionUUID->"3d53f42d-a7fe-d69d-1a2e-680742ebeae6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"czOrder", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czGate", "[", 
    RowBox[{"d_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{
        RowBox[{"czU", "[", 
         RowBox[{"d", ",", " ", "a", ",", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Pi", "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"d", "^", "2"}], " ", "+", " ", "8"}], "]"}]}]}]}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"FromDigits", "[", 
              RowBox[{"#", ",", " ", "3"}], "]"}]}], " ", "&"}], " ", "/@", 
           " ", "czOrder"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"FromDigits", "[", 
              RowBox[{"#", ",", " ", "3"}], "]"}]}], " ", "&"}], " ", "/@", 
           " ", "czOrder"}]}], "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CurlyPhi]0", " ", "=", " ", 
          RowBox[{"Arg", "[", 
           RowBox[{"u", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"\[CurlyPhi]2", " ", "=", " ", 
          RowBox[{
           RowBox[{"Arg", "[", 
            RowBox[{"u", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "]"}], " ", "-", 
           " ", 
           RowBox[{"Arg", "[", 
            RowBox[{"u", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}]}], ",", " ", 
         RowBox[{"\[CurlyPhi]1", " ", "=", " ", 
          RowBox[{
           RowBox[{"Arg", "[", 
            RowBox[{"u", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], "]"}], " ", "-", 
           " ", 
           RowBox[{"Arg", "[", 
            RowBox[{"u", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]}]}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"(", 
              RowBox[{"\[CurlyPhi]0", " ", "+", " ", 
               RowBox[{"\[CurlyPhi]1", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
               RowBox[{"\[CurlyPhi]2", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "]"}], " ", 
           "&"}], " ", "/@", " ", "czOrder"}], "]"}], " ", ".", " ", "u"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"czColor", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<ThermometerColors\>\"", "]"}], "[", 
     RowBox[{"Rescale", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], "]"}], " ", 
    "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"czTicks", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", "9", "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<|\>\"", " ", "<>", " ", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"ToString", " ", "/@", " ", "#"}], "]"}], " ", "<>", 
         " ", "\"\<\[RightAngleBracket]\>\""}], " ", "&"}], " ", "/@", " ", 
       "czOrder"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"czMatrix", "[", 
    RowBox[{"m_", ",", " ", "label_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixPlot", "[", 
    RowBox[{"m", ",", " ", 
     RowBox[{"ColorFunction", " ", "->", " ", "czColor"}], ",", " ", 
     RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"Mesh", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"MeshStyle", " ", "->", " ", 
      RowBox[{"GrayLevel", "[", "0.5", "]"}]}], ",", "\n", "   ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"czTicks", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"czTicks", ",", " ", "None"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "label"}], ",", "\n", "   ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"White", ",", " ", 
        RowBox[{"AbsoluteThickness", "[", "3", "]"}], ",", " ", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "5"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "9"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "9"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "5"}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",",
      " ", 
     RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"czStep3", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"czGate", " ", "@@", " ", "#"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"czMatrix", "[", 
           RowBox[{
            RowBox[{"Re", "[", "u", "]"}], ",", " ", "\"\<Re U\>\""}], "]"}], 
          ",", " ", 
          RowBox[{"czMatrix", "[", 
           RowBox[{
            RowBox[{"Im", "[", "u", "]"}], ",", " ", "\"\<Im U\>\""}], 
           "]"}]}], "}"}]}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", " ", 
          RowBox[{"-", "10"}], ",", " ", 
          RowBox[{"-", "40"}]}], "}"}]}], "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{"czStep3", "[", 
        RowBox[{"{", 
         RowBox[{"cz\[Delta]", ",", " ", "cz\[Alpha]"}], "}"}], "]"}], "}"}], 
      "]"}], ",", " ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"BarLegend", "[", 
        RowBox[{"{", 
         RowBox[{"czColor", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "}"}], "]"}], ",", 
       " ", "Right"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cz\[Delta]", ",", " ", "0", ",", " ", "\"\<\[Delta]/g\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
     "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cz\[Alpha]", ",", " ", 
       RowBox[{"-", "40"}], ",", " ", "\"\<\[Alpha]/g\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", " ", 
       RowBox[{"-", "10"}], ",", " ", 
       RowBox[{"-", "40"}]}], "}"}], ",", " ", "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[152]:= ",
 CellID->1552595277,ExpressionUUID->"03309d3a-a496-cd5f-6263-4a67d80adec7"],

Cell[TextData[{
 "On resonance and with ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[Alpha]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[GreaterGreater]", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c5f2c36-8d95-54d2-30b3-38a9609aaeca"],
 ", the corner is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"1", ",", "1", ",", "1"}], ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0103b2c2-b050-95ac-055a-928446cb246b"],
 ", a controlled-Z, and nothing connects it to the other levels. Detuning \
keeps the corner diagonal but gives ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dc16333-18a4-f8be-7190-f6a1b9d0ce11"],
 " a complex phase; a small ",
 Cell[BoxData[GridBox[{
    {
     StyleBox["\[Alpha]", "TI"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fa61c69-100c-bd18-280d-c2048c2a69af"],
 " mixes ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e47a71e-f245-7366-08f9-1755f72ec3d6"],
 " with ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b263765-a592-aa1c-0939-c821c1ad49df"],
 " inside the corner and leaks ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22cb7198-18dd-9172-5cef-c9826a2519b8"],
 " into ",
 Cell[BoxData[
  TemplateBox[{"20"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc6086-c14c-ccaa-2b22-9aa32cd6c7a0"],
 "."
}], "Text",
 CellID->1996105401,ExpressionUUID->"173066fb-37d5-4665-254f-8b691da5ebdb"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
