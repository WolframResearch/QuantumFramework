}], "Text",
 CellID->1574114243,ExpressionUUID->"34d94574-2441-eb20-1098-b9af34a20318"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"shorU", "[", 
    RowBox[{"nN_", ",", " ", "a_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"2", "^", 
        RowBox[{"BitLength", "[", "nN", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"a", " ", 
                   RowBox[{"Range", "[", 
                    RowBox[{"0", ",", " ", 
                    RowBox[{"nN", " ", "-", " ", "1"}]}], "]"}]}], ",", " ", 
                  "nN"}], "]"}], ",", " ", 
                RowBox[{"Range", "[", 
                 RowBox[{"nN", ",", " ", 
                  RowBox[{"d", " ", "-", " ", "1"}]}], "]"}]}], "]"}], ",", 
              " ", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"d", " ", "-", " ", "1"}]}], "]"}]}], "}"}], "]"}], 
           " ", "+", " ", "1"}], " ", "->", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"shorProbs", "[", 
    RowBox[{"nN_", ",", " ", "a_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"QuantumCircuitOperator", "[", 
        RowBox[{"\"\<PhaseEstimation\>\"", "[", 
         RowBox[{
          RowBox[{"shorU", "[", 
           RowBox[{"nN", ",", " ", "a"}], "]"}], ",", " ", "t"}], "]"}], 
        "]"}], "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"BitLength", "[", "nN", "]"}], " ", "+", " ", "1"}], " ", 
         ";;"}], "]"}], "]"}], "]"}], "[", "\n", "    ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{"StringRepeat", "[", 
        RowBox[{"\"\<0\>\"", ",", " ", "t"}], "]"}], " ", "<>", " ", 
       RowBox[{"IntegerString", "[", 
        RowBox[{"1", ",", " ", "2", ",", " ", 
         RowBox[{"BitLength", "[", "nN", "]"}]}], "]"}]}], "]"}], "]"}], 
    "[", "\"\<ProbabilitiesList\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"shorPanel", "[", 
    RowBox[{"nN_", ",", " ", "a_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"shorProbs", "[", 
        RowBox[{"nN", ",", " ", "a", ",", " ", "t"}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"LCM", " ", "@@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Denominator", "[", 
              RowBox[{"Last", "[", 
               RowBox[{"Select", "[", 
                RowBox[{
                 RowBox[{"Convergents", "[", 
                  RowBox[{"#", "/", 
                   RowBox[{"2", "^", "t"}]}], "]"}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Denominator", "[", "#", "]"}], " ", "<", " ", 
                   "nN"}], " ", "&"}]}], "]"}], "]"}], "]"}], " ", "&"}], " ",
             "/@", " ", 
            RowBox[{"Pick", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{
                 RowBox[{"2", "^", "t"}], " ", "-", " ", "1"}]}], "]"}], ",", 
              " ", 
              RowBox[{"UnitStep", "[", 
               RowBox[{"p", " ", "-", " ", "0.05"}], "]"}], ",", " ", "1"}], 
             "]"}]}], ")"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"peaks", " ", "=", " ", 
           RowBox[{"Pick", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{
                RowBox[{"2", "^", "t"}], " ", "-", " ", "1"}]}], "]"}], ",", 
             " ", 
             RowBox[{"UnitStep", "[", 
              RowBox[{"p", " ", "-", " ", "0.05"}], "]"}], ",", " ", "1"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"fr", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Convergents", "[", 
                 RowBox[{"#", "/", 
                  RowBox[{"2", "^", "t"}]}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Denominator", "[", "#", "]"}], " ", "<", " ", 
                  "nN"}], " ", "&"}]}], "]"}], "]"}], " ", "&"}], " ", "/@", 
            " ", "peaks"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"ListPlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{
                    RowBox[{"2", "^", "t"}], " ", "-", " ", "1"}]}], "]"}], "/", 
                 RowBox[{"2", "^", "t"}]}], ",", " ", "p"}], "}"}], "]"}], ",",
              " ", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"peaks", "/", 
                    RowBox[{"2", "^", "t"}]}], ",", " ", 
                   RowBox[{"p", "[", 
                    RowBox[{"[", 
                    RowBox[{"peaks", " ", "+", " ", "1"}], "]"}], "]"}], ",", 
                   " ", "fr"}], "}"}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Denominator", "[", 
                   RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "==", " ", 
                  "r"}], " ", "&"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", 
                RowBox[{";;", " ", "2"}]}], "]"}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"peaks", "/", 
                    RowBox[{"2", "^", "t"}]}], ",", " ", 
                   RowBox[{"p", "[", 
                    RowBox[{"[", 
                    RowBox[{"peaks", " ", "+", " ", "1"}], "]"}], "]"}], ",", 
                   " ", "fr"}], "}"}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Denominator", "[", 
                   RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "<", " ", 
                  "r"}], " ", "&"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", 
                RowBox[{";;", " ", "2"}]}], "]"}], "]"}]}], "}"}], ",", "\n", 
           "     ", 
           RowBox[{"Filling", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"1", " ", "->", " ", "Axis"}], "}"}]}], ",", " ", 
           RowBox[{"PlotMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "2"}], "}"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "10"}], "}"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "10"}], "}"}]}], 
             "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.03"}], ",", " ", "1.03"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0.62"}], "}"}]}], "}"}]}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "     ", 
           RowBox[{"Epilog", " ", "->", " ", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"TraditionalForm", "[", "#3", "]"}], ",", " ", 
                   "11"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"#1", ",", " ", 
                   RowBox[{"#2", " ", "+", " ", "0.07"}]}], "}"}]}], "]"}], 
               " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"peaks", "/", 
                 RowBox[{"2", "^", "t"}]}], ",", " ", 
                RowBox[{"p", "[", 
                 RowBox[{"[", 
                  RowBox[{"peaks", " ", "+", " ", "1"}], "]"}], "]"}], ",", 
                " ", "fr"}], "}"}]}], "]"}]}], ",", "\n", "     ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<x / \>\"", ",", " ", 
                 RowBox[{"Superscript", "[", 
                  RowBox[{"2", ",", " ", "t"}], "]"}]}], "}"}], "]"}], ",", 
              " ", "\"\<P(x)\>\""}], "}"}]}], ",", " ", 
           RowBox[{"FrameTicks", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", " ", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"TraditionalForm", "[", "#", "]"}], ",", " ", 
                    RowBox[{"FractionBoxOptions", " ", "->", " ", 
                    RowBox[{"{", 
                    RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], 
                    "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", " ", "1", ",", " ", 
                   RowBox[{"1", "/", "4"}]}], "]"}]}], ",", " ", "None"}], 
               "}"}]}], "}"}]}], ",", "\n", "     ", 
           RowBox[{"PlotLabel", " ", "->", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              
              RowBox[{"\"\<N = \>\"", ",", " ", "nN", ",", 
               " ", "\"\<,  a = \>\"", ",", " ", "a", ",", 
               " ", "\"\<,  r = \>\"", ",", " ", "r", ",", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"EvenQ", "[", "r", "]"}], ",", " ", 
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   RowBox[{"\"\<,  gcd = \>\"", ",", " ", 
                    RowBox[{"GCD", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a", "^", 
                    RowBox[{"(", 
                    RowBox[{"r", "/", "2"}], ")"}]}], " ", "-", " ", "1"}], ",",
                     " ", "nN"}], "]"}], ",", " ", "\"\<, \>\"", ",", " ", 
                    RowBox[{"GCD", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a", "^", 
                    RowBox[{"(", 
                    RowBox[{"r", "/", "2"}], ")"}]}], " ", "+", " ", "1"}], ",",
                     " ", "nN"}], "]"}]}], "}"}], "]"}], ",", 
                 " ", "\"\< (odd)\>\""}], "]"}]}], "}"}], "]"}]}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
