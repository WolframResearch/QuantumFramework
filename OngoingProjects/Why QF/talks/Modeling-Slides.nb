   RowBox[{
    StyleBox["E", "TI"], "/", 
    StyleBox["D", "TI"], "=", "0"}], ",", "\[ThinSpace]", "0.1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425e7df3-facf-13d6-06a0-f5a3480a0559"],
 " and ",
 Cell[BoxData[
