Cell["\<\
Proving a circuit's phase approximation correct over the reals\
\>", "Subsection",
 CellID->1688810965,ExpressionUUID->"7bbcc018-536c-d46f-49a9-9128f0ea60e8"],

Cell[TextData[{
 "A circuit that applies ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["x", "TI"]},
    "Ket"], "\[Function]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", "\[Pi]", 
      StyleBox["i", "TI"], "/", 
      SqrtBox[
       StyleBox["x", "TI"]]}]], 
    TemplateBox[{
      StyleBox["x", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "546701d9-9c49-5943-4491-0235750d3b43"],
 " needs ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51f38155-1a62-94f5-17b5-53eb32db1ed7"],
 " in fixed-point arithmetic. Writing ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   SuperscriptBox["4", 
    StyleBox["k", "TI"]], 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a18b1f4-5823-a666-46c6-8e0aa9929993"],
 " with ",
 Cell[BoxData[
  RowBox[{"1", "\[LessEqual]", 
   StyleBox["m", "TI"], "<", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c7d18ca-b0cd-5a9d-2791-2f779c735180"],
 " reduces it to ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["m", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "720739d2-4a2e-7624-4a89-f596044fcb6b"],
 ", evaluated on ",
 Cell[BoxData[
  RowBox[{"3", "\[CenterDot]", 
   SuperscriptBox["2", 
    StyleBox["r", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d4d5ab7-3c4e-0444-4794-64fce669a7ec"],
 " intervals ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["a", "TI"], "+", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1825ee6e-f8c4-e2c4-4f38-4c20abf34a67"],
 ", ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["t", "TI"], "\[LessEqual]", 
   StyleBox["h", "TI"], "=", 
   SuperscriptBox["2", 
    RowBox[{"-", 
     StyleBox["r", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "523a7e19-5014-3669-6176-a9ebecd3af75"],
 ", as a quadratic ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "526564ed-dacf-8c97-1fce-6f2235fbcbf4"],
 " with coefficients in ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    RowBox[{"-", 
     StyleBox["w", "TI"]}]], "\:2124"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a20fcf-00d9-3ff5-54f8-7aa5ec969768"],
 ". Is the relative error below a bound ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52862c1a-437c-4abb-066a-326e1d392995"],
 ", proposed on each interval from finitely many samples, for every ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb3cc7b-4b17-9d27-4132-ab50e036af3e"],
 " in it?"
}], "Text",
 CellID->342533798,ExpressionUUID->"0340b36e-f320-2f76-7d64-92e153d3e5df"],

Cell["\<\
On each interval the claim is a polynomial inequality in one real variable,\
\>", "Text",
 CellID->2046003285,ExpressionUUID->"34f1ed95-24ca-dfb9-4f91-1b5de434d5be"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[ForAll]", "\[ThinSpace]", 
     StyleBox["t", "TI"], "\[Element]", 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{"0", ",", 
      StyleBox["h", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}], ":", "\[NonBreakingSpace]\[NonBreakingSpace]", 
    RowBox[{
     RowBox[{
      StyleBox["p", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], ">", 
     RowBox[{"0", " ", "\[Wedge]", " ", 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         StyleBox["\[Eta]", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"]}], "\[LessEqual]", 
     RowBox[{
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["a", "TI"], "+", 
        StyleBox["t", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "\[ThinSpace]", 
      StyleBox["p", "TI"], 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["t", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"]}], "\[LessEqual]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "+", 
         StyleBox["\[Eta]", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"], "\[DoubleLongLeftRightArrow]", GridBox[{
        {
         RowBox[{
          SqrtBox[
           RowBox[{
            StyleBox["a", "TI"], "+", 
            StyleBox["t", "TI"]}]], "\[ThinSpace]", 
          StyleBox["p", "TI"], 
          StyleBox["(",
           SpanMaxSize->1], 
          StyleBox["t", "TI"], 
          StyleBox[")",
           SpanMaxSize->1], "-", "1"}]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}]}], "\[LessEqual]", 
     StyleBox["\[Eta]", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->130983247,ExpressionUUID->"40205387-85a6-1c53-1753-1ca338135f8d"],

Cell[TextData[{
 "for ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["\[Eta]", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03dfd5d8-dbf8-b9c4-0cdb-45714ee9005c"],
 ", decided exactly over the reals, with rational ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e25ce1-e4dc-0d58-5b9f-434b4d88f56c"],
 ", ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d6c10b8-8186-48b3-78df-b47295ae3bef"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "479a3739-81f0-5043-2110-a2a55868cc52"],
 " and coefficients and no rounding. The quadratic interpolates ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    RowBox[{
     StyleBox["a", "TI"], "+", 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23f8c0d7-a5b3-75b3-718c-e2b6309951bd"],
 " at Chebyshev nodes before rounding, and ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72e762c4-ff61-bda0-0de7-edfe216632c7"],
 " is proposed from 201 samples with a 2% margin."
}], "Text",
 CellID->650236975,ExpressionUUID->"6e4f20b6-aa81-0466-02eb-5466f03df776"],

Cell[TextData[{
 "For each ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e5f267b-6b8d-2c6c-2dff-b095a5b67242"],
 " and ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c07be2-5f53-7f15-3a82-184d90112759"],
 " the figure plots ",
 Cell[BoxData[GridBox[{
    {
     RowBox[{
      SqrtBox[
       StyleBox["m", "TI"]], "\[ThinSpace]", 
      StyleBox["p", "TI"], "-", "1"}]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63aba018-9fff-748f-612f-4c9cebecbdaa"],
 " against ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cd53ca0-d034-74d4-24e2-1c6d370efb77"],
 " over every interval (solid) with each interval's ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48ec019c-c26d-9cbe-7337-8f5672cd0744"],
 " (dashed), and reports whether the claim is proved on all intervals:"
}], "Text",
 CellID->698400123,ExpressionUUID->"0c846977-e54d-1dfd-3ca8-f403b3054014"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"intervalsCert", "[", 
    RowBox[{"r_", ",", " ", "w_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", " ", "=", " ", 
        RowBox[{"2", "^", 
         RowBox[{"-", "r"}]}]}], ",", " ", 
       RowBox[{"nodes", " ", "=", " ", 
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"-", "r"}]}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{"Pi", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", 
                  RowBox[{"Range", "[", "3", "]"}]}], " ", "-", " ", "1"}], 
                ")"}], "/", "6"}]}], "]"}]}], ")"}], "/", "2"}]}]}], ",", " ", 
       RowBox[{"ts", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"0.", ",", " ", 
          RowBox[{"2.", "^", 
           RowBox[{"-", "r"}]}], ",", " ", "200"}], "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{"Table", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"poly", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Round", "[", 
              RowBox[{
               RowBox[{"2", "^", "w"}], " ", 
               RowBox[{"CoefficientList", "[", 
                RowBox[{
                 RowBox[{"InterpolatingPolynomial", "[", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"nodes", ",", " ", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"a", " ", "+", " ", "nodes"}], "]"}]}], ",", " ", 
                    "30"}], "]"}]}], "}"}], "]"}], ",", " ", "\[FormalT]"}], 
                  "]"}], ",", " ", "\[FormalT]"}], "]"}]}], "]"}], " ", ".", 
             " ", 
             RowBox[{"\[FormalT]", "^", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", " ", "2"}], "]"}]}]}], "/", 
            RowBox[{"2", "^", "w"}]}]}], "}"}], ",", "\n", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eta", " ", "=", " ", 
             RowBox[{
              RowBox[{"Ceiling", "[", 
               RowBox[{"1.02", " ", 
                RowBox[{"2", "^", "40"}], " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"a", " ", "+", " ", "ts"}], "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"poly", " ", "/.", " ", 
                    RowBox[{"\[FormalT]", " ", "->", " ", "ts"}]}], ")"}]}], 
                   " ", "-", " ", "1"}], "]"}], "]"}]}], "]"}], "/", 
              RowBox[{"2", "^", "40"}]}]}], "}"}], ",", "\n", "       ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<a\>\"", " ", "->", " ", "a"}], ",", " ", 
             RowBox[{"\"\<h\>\"", " ", "->", " ", "h"}], ",", " ", 
             RowBox[{"\"\<poly\>\"", " ", "->", " ", "poly"}], ",", " ", 
             RowBox[{"\"\<eta\>\"", " ", "->", " ", "eta"}], ",", "\n", 
             "        ", 
             RowBox[{"\"\<proof\>\"", " ", "->", " ", 
              RowBox[{"Resolve", "[", 
               RowBox[{
                RowBox[{"ForAll", "[", 
                 RowBox[{"\[FormalT]", ",", " ", 
                  RowBox[{
                  "0", " ", "<=", " ", "\[FormalT]", " ", "<=", " ", "h"}], ",",
                   " ", 
                  RowBox[{
                   RowBox[{"poly", " ", ">", " ", "0"}], " ", "&&", " ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "eta"}], ")"}], "^", "2"}], 
                    " ", "<=", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", " ", "+", " ", "\[FormalT]"}], ")"}], " ", 
                    RowBox[{"poly", "^", "2"}]}], " ", "<=", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "+", " ", "eta"}], ")"}], "^", 
                    "2"}]}]}]}], "]"}], ",", " ", "Reals"}], "]"}]}]}], 
            "|>"}]}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "1", ",", " ", 
         RowBox[{"4", " ", "-", " ", "h"}], ",", " ", "h"}], "}"}]}], "]"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelCert", "[", 
    RowBox[{"r_", ",", " ", "w_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ivs", " ", "=", " ", 
       RowBox[{"intervalsCert", "[", 
        RowBox[{"r", ",", " ", "w"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Piecewise", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Sqrt", "[", "m", "]"}], " ", 
                   RowBox[{"(", 
                    RowBox[{"#poly", " ", "/.", " ", 
                    RowBox[{"\[FormalT]", " ", "->", " ", 
                    RowBox[{"m", " ", "-", " ", "#a"}]}]}], ")"}]}], " ", "-",
                   " ", "1"}], "]"}], ",", " ", 
                RowBox[{"#a", " ", "<=", " ", "m", " ", "<", " ", 
                 RowBox[{"#a", " ", "+", " ", "#h"}]}]}], "}"}], "]"}], " ", 
             "&"}], " ", "/@", " ", "ivs"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "1", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"PlotPoints", " ", "->", " ", "100"}], ",", " ", 
         RowBox[{"Exclusions", " ", "->", " ", "None"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Piecewise", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"{", 
               RowBox[{"#eta", ",", " ", 
                RowBox[{"#a", " ", "<=", " ", "m", " ", "<", " ", 
                 RowBox[{"#a", " ", "+", " ", "#h"}]}]}], "}"}], "]"}], " ", 
             "&"}], " ", "/@", " ", "ivs"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "1", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", " ",
             "Dashed"}], "]"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Exclusions", " ", "->", " ", "None"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "All"}], "}"}]}], ",", " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<m\>\"", ",", " ", "\"\<|relative error|\>\""}], "}"}]}],
        ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "280"}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<r = \>\"", ",", " ", "r", ",", 
                 " ", "\"\<,   w = \>\"", ",", " ", "w", ",", 
                 " ", "\"\< bits\>\""}], "}"}], "]"}], ",", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"And", " ", "@@", " ", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"ivs", ",", " ", "\"\<proof\>\""}], "]"}]}], ",", 
                " ", 
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{"\"\<bound proved on all \>\"", ",", " ", 
                   RowBox[{"Length", "[", "ivs", "]"}], ",", 
                   " ", "\"\< intervals\>\""}], "}"}], "]"}], ",", 
                " ", "\"\<bound not proved on every interval\>\""}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", 
          " ", "13", ",", " ", 
          RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
         "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"Outer", "[", 
     RowBox[{"panelCert", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "16", ",", " ", "24"}], "}"}]}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"LineLegend", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", " ", 
          "Dashed"}], "]"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<|\>\"", ",", " ", 
           RowBox[{"Sqrt", "[", "\"\<m\>\"", "]"}], ",", 
           " ", "\"\< p \[Minus] 1|\>\""}], "}"}], "]"}], ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", "\"\<proved bound \[Eta] on each interval\>\"", "}"}], 
         "]"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[138]:= ",
 CellID->643668305,ExpressionUUID->"3da02f57-cc17-f0c6-4822-76cb056cb44c"],

Cell[TextData[{
 "The bound is proved on every interval in every panel, so the error stays \
under the dashed line for every real ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a83f978-643b-17e5-24c2-9341d3f0eb90"],
 ", not only at the samples that proposed ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33ec2d97-08f2-662a-5ae4-b688be79ae84"],
 ". With 8-bit coefficients rounding sets the error, which jumps from \
interval to interval and barely shrinks when the intervals halve. By 24 bits \
rounding is negligible and the error is the interpolation's ripple, which \
shrinks as the intervals halve and as ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60c32195-bf37-f526-1e96-dfef6bb466f5"],
 " grows."
}], "Text",
 CellID->1597475189,ExpressionUUID->"16fbf7a7-7f74-ac3b-1187-5d14e4a8d991"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1758394269,ExpressionUUID->"5152587f-33bf-552e-6b06-c0f5a4ef7fb0"],

Cell["Algebra beyond quantum states", "Section",
 CellID->1165415951,ExpressionUUID->"6825f911-9495-cfae-3522-a7aae89d4b96"],

Cell["\<\
The examples in this section use the same symbolic machinery outside the \
usual quantum state. Tensor identities and determinant and trace rules are \
proved at symbolic dimension; the Bianchi identity of the Riemann tensor \
follows from its Young diagram, and Young diagrams also give the energies of \
all-to-all exchange and a qubit spectrum estimated by Schur sampling. Dirac \
matrices are built for a curved metric of any signature, Snyder spacetime is \
set up as a noncommutative algebra and momenta are added on it, and a \
particle bound by its own gravity is solved with finite elements. WL's \
tensor, representation-theory, noncommutative-algebra and PDE tools carry \
these, and QF shows how it stores numbers against declared bases.\
\>", "Text",
 CellID->502385518,ExpressionUUID->"1453b47f-b9e2-1ce5-6b6e-658ffadd882a"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1710882561,ExpressionUUID->"1ec463f4-7bc6-a972-7f01-7a67e7db6ad9"],

Cell["Tensor identities proved at symbolic dimension", "Subsection",
 CellID->269885194,ExpressionUUID->"3f1e9361-965d-52e5-1e12-a5ce919ac2dd"],

Cell[TextData[{
 "Tensors in dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4512ef90-54c8-1163-1008-008a73a9df70"],
 " are given only by their index symmetries, never by entries: an \
antisymmetric ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2adf22c8-65d0-06d0-665f-5dc042161890"],
 ", a symmetric ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eef67-ce07-35c5-6a6f-e2d70b2bcd0c"],
 ", an inverse metric ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5779c409-9cbc-6cf9-005d-0290a720e761"],
 ", and a tensor ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4553e0e1-1ebe-5fe0-206a-8d24333fd536"],
 " with the pair symmetries of the Riemann tensor; in three dimensions, the \
Levi-Civita symbol ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d5e851a-03ac-0936-7c24-fc0e0f2f8a9a"],
 " and a Hessian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "=", 
   SubscriptBox["\[PartialD]", 
    StyleBox["j", "TI"]], 
   SubscriptBox["\[PartialD]", 
    StyleBox["k", "TI"]], 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37da4341-da58-8b5f-7ecb-395a1462eca2"],
 ". Which of these contractions vanish by symmetry alone?"
}], "Text",
 CellID->925211819,ExpressionUUID->"493dd4f2-b319-d7c8-2b70-e319d66d6b4b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "=", "-", 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "=", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "=", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "=", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox[
       StyleBox["R", "TI"], 
       StyleBox[
        RowBox[{"b", "a", "c", "d"}], "TI"]]}], "=", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox[
         RowBox[{"a", "b", "d", "c"}], "TI"]]}], "=", 
      SubscriptBox[
       StyleBox["R", "TI"], 
       StyleBox[
        RowBox[{"c", "d", "a", "b"}], "TI"]]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox["\[Epsilon]", 
     StyleBox[
      RowBox[{"i", "j", "k"}], "TI"]], " ", 
    StyleBox[
     RowBox[{"totally", "\[NonBreakingSpace]", "antisymmetric"}],
     FontSlant->"Plain"]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox[
      RowBox[{"j", "k"}], "TI"]], "=", 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox[
      RowBox[{"k", "j"}], "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->572164148,ExpressionUUID->"79913ac4-aea6-9e9f-6a48-88b3cd04c63b"],

Cell[TextData[{
 "and the Ricci tensor is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"b", "d"}], "TI"]], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox[
     RowBox[{"a", "c"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35b4dcfb-da64-7221-4717-f8b820bdce0a"],
 " (repeated indices summed)."
}], "Text",
 CellID->427922456,ExpressionUUID->"507b30ac-07ec-a4cf-1f6b-1d7e2c6b4f05"],

Cell["\<\
Each contraction reduces to a canonical form from these declarations alone:\
\>", "Text",
 CellID->44765869,ExpressionUUID->"259bdaab-3e9f-d8db-0a52-e50d455cd8cf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tensorDeclarations", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"aT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d"}], "}"}], ",", " ", "Reals", ",", " ", 
        RowBox[{"Antisymmetric", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"sT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d"}], "}"}], ",", " ", "Reals", ",", " ", 
        RowBox[{"Symmetric", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"gT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d"}], "}"}], ",", " ", "Reals", ",", " ", 
        RowBox[{"Symmetric", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{"rT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d", ",", " ", "d", ",", " ", "d"}], "}"}], ",",
         " ", "Reals", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cycles", "[", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "]"}], ",", " ", 
            RowBox[{"-", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cycles", "[", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "4"}], "}"}], "}"}], "]"}], ",", " ", 
            RowBox[{"-", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cycles", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", " ",
             "1"}], "}"}]}], "}"}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"epsT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
        "Reals", ",", " ", 
        RowBox[{"Antisymmetric", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"hT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], ",", " ", "Reals", ",", " ", 
        RowBox[{"Symmetric", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ricciT", " ", "=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"TensorProduct", "[", 
      RowBox[{"rT", ",", " ", "gT"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"reduceT", " ", "=", " ", 
   RowBox[{
    RowBox[{"TensorReduce", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"Assumptions", " ", "->", " ", "tensorDeclarations"}]}], "]"}], 
    " ", "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"reducesToZero", " ", "=", " ", 
   RowBox[{
    RowBox[{"MatchQ", "[", 
     RowBox[{
      RowBox[{"reduceT", "[", "#", "]"}], ",", " ", 
      RowBox[{"0", " ", "|", " ", "_SymbolicZerosArray"}]}], "]"}], " ", 
    "&"}]}], ";"}], "\n", 
 RowBox[{"Style", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<contraction\>\"", ",", 
         " ", "\"\<reduces to zero by symmetry\>\""}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<A\>\"", ",", " ", "\"\<ij\>\""}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<S\>\"", ",", " ", "\"\<ij\>\""}], "]"}]}], "}"}], 
          "]"}], ",", " ", 
         RowBox[{"reducesToZero", "[", 
          RowBox[{"TensorContract", "[", 
           RowBox[{
            RowBox[{"TensorProduct", "[", 
             RowBox[{"aT", ",", " ", "sT"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}], "]"}]}],
         "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<R\>\"", ",", " ", "\"\<bd\>\""}], "]"}], ",", 
            " ", "\"\< \[Minus] \>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<R\>\"", ",", " ", "\"\<db\>\""}], "]"}]}], "}"}], 
          "]"}], ",", " ", 
         RowBox[{
          RowBox[{"reduceT", "[", "ricciT", "]"}], " ", "===", " ", 
          RowBox[{"reduceT", "[", 
           RowBox[{"TensorTranspose", "[", 
            RowBox[{"ricciT", ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}], "]"}]}]}], "}"}], 
       ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[CurlyEpsilon]\>\"", ",", " ", "\"\<ijk\>\""}], 
             "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<H\>\"", ",", " ", "\"\<jk\>\""}], "]"}]}], "}"}], 
          "]"}], ",", " ", 
         RowBox[{"reducesToZero", "[", 
          RowBox[{"TensorContract", "[", 
           RowBox[{
            RowBox[{"TensorProduct", "[", 
             RowBox[{"epsT", ",", " ", "hT"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}], "]"}]}],
         "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<A\>\"", ",", " ", "\"\<ij\>\""}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<A\>\"", ",", " ", "\"\<ij\>\""}], "]"}]}], "}"}], 
          "]"}], ",", " ", 
         RowBox[{"reducesToZero", "[", 
          RowBox[{"TensorContract", "[", 
           RowBox[{
            RowBox[{"TensorProduct", "[", 
             RowBox[{"aT", ",", " ", "aT"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}], "]"}]}],
         "}"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ", "14", ",", 
   " ", 
   RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[139]:= ",
 CellID->1948273841,ExpressionUUID->"3566ae1a-5441-ff5e-40a4-cbca265bd66c"],

Cell[TextData[{
 "Symmetry alone makes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d412fc-29b4-967d-55e4-40119f75f9c5"],
 " vanish for every ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77e2dab9-f606-ca54-1f33-b5591c9de580"],
 ", makes the Ricci tensor symmetric, and makes the curl of a gradient vanish \
in three dimensions. The sum of squares ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e48b449-7b10-ddf3-0bad-19541754d8f9"],
 ", which no symmetry forces to vanish, is correctly not reduced to zero."
}], "Text",
 CellID->169977155,ExpressionUUID->"257e5eab-f90b-b8bc-7e99-378b84077b76"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
