      StyleBox["\[Gamma]", "TI"], 
      StyleBox["t", "TI"]}]], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], "0"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["q", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "-", 
     SubscriptBox[
      StyleBox["W", "TI"], "\[Infinity]"], 
     StyleBox["(",
