Cell[BoxData[{
 RowBox[{
  RowBox[{"rhoXXZ", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumPartialTrace", "[", 
      RowBox[{
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"J", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"QuantumOperator", "[", "\"\<XX\>\"", "]"}], " ", "+", 
             " ", 
             RowBox[{"QuantumOperator", "[", "\"\<YY\>\"", "]"}]}], ")"}]}], 
          " ", "+", " ", 
          RowBox[{"Jz", " ", 
           RowBox[{"QuantumOperator", "[", "\"\<ZZ\>\"", "]"}]}]}], ",", "\n",
          "    ", 
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"\[CurlyTheta]", "/", "2"}], "]"}], ",", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[CurlyTheta]", "/", "2"}], "]"}]}], "}"}], "]"}], ",",
            " ", 
           RowBox[{"QuantumState", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"\[CurlyTheta]", "/", "2"}], "]"}], ",", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[CurlyTheta]", "/", "2"}], "]"}]}], "}"}], "]"}]}], 
          "]"}], ",", " ", "t"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"xxzBloch", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"ComplexExpand", "[", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"Tr", "[", 
           RowBox[{"rhoXXZ", " ", ".", " ", "rhoXXZ"}], "]"}]}], " ", "-", 
         " ", "1"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "J", ",", " ", "Jz", ",", " ", "t", ",", " ", "\[CurlyTheta]"}], 
         "}"}], " ", "\[Element]", " ", "Reals"}]}], "]"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"J", ",", " ", "Jz", ",", " ", "t", ",", " ", "\[CurlyTheta]"}],
       "}"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}]}], "Input",
 CellLabel->"In[56]:= ",
 CellID->1584299858,ExpressionUUID->"3c49b71e-15ff-e34e-5baa-0c1bce374518"],

