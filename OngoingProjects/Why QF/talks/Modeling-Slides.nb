       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->880897349,ExpressionUUID->"0e04517a-6088-99fe-4b63-1bfcf6b03fc0"],

Cell[TextData[{
 "so under a constant drive ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e4ec3c7-92d8-15d7-4405-6afd38292d97"],
 " settles at ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox["max",
     FontSlant->"Plain"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Kappa]", "TI"], "\[PlusMinus]", "2", 
    StyleBox["i", "TI"], 
    StyleBox["\[Chi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44e1d5d7-8a26-c1ab-53e3-13a3366bbe29"],
 ". The field leaking out of the cavity, which the measurement records, is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f19c50-693b-276f-147f-e3872b417462"],
 "."
}], "Text",
 CellID->110183262,ExpressionUUID->"43e796ae-59b4-8c90-0ac2-f34fcfed4959"],

Cell[TextData[{
 "For a 4 \[Mu]s flat-top readout the figure plots, up to the fall of the \
drive, the intracavity field ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15f3a9a2-de9e-3ad4-1bac-a188f78c1d67"],
 " with its steady states as points, and the output separation ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], "0"], "-", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], "1"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b6fdc27-6710-64b9-237e-f4933b8408b5"],
 " in units of ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", GridBox[{
      {
       StyleBox["\[Chi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e3d5915-cf5a-6cc5-5c14-76193a60cefe"],
 ". The transmon has qubit-cavity coupling 50 MHz and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0afc9263-d279-9540-216a-2bad33a94f6a"],
 " \[Mu]s, so ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20fd1a38-8c9f-f63f-0379-9a84072478fe"],
 " comes from the dispersive formula and the drive is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox["max",
     FontSlant->"Plain"]], "\[TildeTilde]", "9", GridBox[{
     {
      StyleBox["\[Chi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "441def23-335b-b425-7ce6-815d6013d17b"],
 ":"
}], "Text",
 CellID->1179038019,ExpressionUUID->"058941eb-cc98-22b1-7b6d-021013172f16"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pointerSystem", "[", "\[Kappa]Hz_", "]"}], " ", ":=", " ", 
   RowBox[{"TransmonSystem", "[", 
    RowBox[{
     RowBox[{"\"\<Coupling\>\"", " ", "->", " ", "50*^6"}], ",", " ", 
     RowBox[{"\"\<CavityLinewidth\>\"", " ", "->", " ", "\[Kappa]Hz"}], ",", 
     " ", 
     RowBox[{"\"\<T1\>\"", " ", "->", " ", "10.*^-6"}], ",", " ", 
     RowBox[{"\"\<T2\>\"", " ", "->", " ", "10.*^-6"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerChiHz", " ", "=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"TransmonSystem", "[", 
      RowBox[{"\"\<Coupling\>\"", " ", "->", " ", "50*^6"}], "]"}], 
     "[", "\"\<Chi\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerRs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.3", ",", " ", "0.6", ",", " ", "2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerDR", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DispersiveReadout", "[", 
       RowBox[{
        RowBox[{"pointerSystem", "[", 
         RowBox[{"2", " ", "#", " ", "pointerChiHz"}], "]"}], ",", " ", 
        RowBox[{"Pulse", "[", 
         RowBox[{"\"\<FlatTop\>\"", ",", " ", "4000", ",", " ", 
          RowBox[{"\"\<RiseTime\>\"", " ", "->", " ", "50"}]}], "]"}]}], 
       "]"}], " ", "&"}], ",", " ", "pointerRs"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerEnd", " ", "=", " ", 
   RowBox[{"4000*^-9", " ", "-", " ", "50*^-9"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pointerSep", "[", 
    RowBox[{"r_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "r", "]"}], " ", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"pointerDR", "[", "r", "]"}], "[", "\"\<Alpha0\>\"", "]"}], "[", 
       RowBox[{"x", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi", " ", "pointerChiHz"}], ")"}]}], "]"}], " ", "-",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"pointerDR", "[", "r", "]"}], "[", "\"\<Alpha1\>\"", "]"}], "[", 
       RowBox[{"x", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi", " ", "pointerChiHz"}], ")"}]}], "]"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerXEnd", " ", "=", " ", 
   RowBox[{"2", " ", "Pi", " ", "pointerChiHz", " ", "pointerEnd"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerIQ", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
