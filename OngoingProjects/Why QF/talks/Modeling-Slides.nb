  "76464b13-4fdd-4962-0cf8-56ebf9963570"],
 ":"
}], "Text",
 CellID->1554103542,ExpressionUUID->"47471fbb-59d8-fa52-309b-854d1001f21c"],

Cell[BoxData[
 RowBox[{"rabiP", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"QuantumEvolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Omega]0", "/", "2"}], " ", 
              RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", 
             " ", 
             RowBox[{
              RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Cos", "[", 
                  RowBox[{"\[Omega]", " ", "t"}], "]"}], " ", 
                 RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], " ", "+",
                 " ", 
                RowBox[{
                 RowBox[{"Sin", "[", 
                  RowBox[{"\[Omega]", " ", "t"}], "]"}], " ", 
                 RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}]}], 
               ")"}]}]}], ",", " ", "None", ",", " ", "t"}], "]"}], 
          "[", "\"\<Matrix\>\"", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}], "^", "2"}], "]"}],
     ",", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]0", ",", " ", "\[Omega]", ",", " ", "t"}], "}"}], " ",
       "\[Element]", " ", "Reals"}], " ", "&&", " ", 
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->1913063583,ExpressionUUID->"7681c451-c70b-5c8b-669d-f92a75351053"],

Cell[TextData[{
 "The plot takes three detunings, with time in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d4f7fed-adbc-a02d-2e29-df1ee7deaeb6"],
