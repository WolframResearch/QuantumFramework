Cell["Dressed states and atom-field entanglement", "Subsection",
 CellID->1683099956,ExpressionUUID->"722bc200-81eb-e93f-2fd7-97c92a465613"],

Cell[TextData[{
 "A two-level atom with transition frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d43aad3-0ef7-f3d2-2528-0e23a6885c80"],
 " enters a cavity of frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "157e3670-91bd-c9f5-1225-55802822bee6"],
 " that holds a coherent field ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Alpha]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ec6a3a-7c1b-06ad-5c0d-4e785f1bb08b"],
 " with real ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   SqrtBox[
    OverscriptBox[
     StyleBox["n", "TI"], "_"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37a4f631-af2e-f7a4-04cc-5c38f3398288"],
 ", and couples to it at strength ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c1904f7-ae70-0e35-065e-18d839e99d42"],
 ". Which initial atomic states stay nearly unentangled with the field?"
}], "Text",
 CellID->1669378414,ExpressionUUID->"536b7240-9108-1ec3-3a2a-4b9c5b2f2ac1"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31c6da83-9154-4280-6029-734ed599e598"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e06bb67-43d4-2ca5-1f64-c80ff77cb068"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26669bc9-ff02-f58b-1066-0e6de3cf7991"],
 ", the interaction ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "+"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cf5d40-c68c-7710-121e-ba65166d5adb"],
 " couples only ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6569ce12-e39c-3ffb-5d83-88bf44dc3d56"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["n", "TI"], "+", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6246f2b3-ce7f-5263-4549-329348998914"],
 ". In the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5341d653-736a-456c-5f1c-ba56b57ff6cd"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "+"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1d42b5-059f-d608-605c-62538705579d"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["a", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4a898b-20ea-67d9-7cd4-f0c29932072a"],
 ", each such pair splits into the dressed states"
}], "Text",
 CellID->2005366405,ExpressionUUID->"7705254c-b787-f9f1-5b14-6c4f3d5a4559"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["n", "TI"], ",", "+"}]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      FractionBox[
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["n", "TI"]], "2"], 
      TemplateBox[{
        RowBox[{
          StyleBox["e", "TI"], ",", 
          StyleBox["n", "TI"]}]},
       "Ket"]}], "+", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], 
      FractionBox[
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["n", "TI"]], "2"], 
      TemplateBox[{
        RowBox[{
          StyleBox["g", "TI"], ",", 
          StyleBox["n", "TI"], "+", "1"}]},
       "Ket"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["n", "TI"], ",", "-"}]},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["sin",
        FontSlant->"Plain"]}], 
      FractionBox[
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["n", "TI"]], "2"], 
      TemplateBox[{
        RowBox[{
          StyleBox["e", "TI"], ",", 
          StyleBox["n", "TI"]}]},
       "Ket"]}], "+", 
     RowBox[{
      StyleBox["cos",
       FontSlant->"Plain"], 
      FractionBox[
       SubscriptBox["\[CapitalPhi]", 
        StyleBox["n", "TI"]], "2"], 
      TemplateBox[{
        RowBox[{
          StyleBox["g", "TI"], ",", 
          StyleBox["n", "TI"], "+", "1"}]},
       "Ket"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["n", "TI"]]}], "=", 
    FractionBox["\[CapitalDelta]", 
     SubscriptBox["\[CapitalOmega]", 
      StyleBox["n", "TI"]]]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], 
     SubscriptBox["\[CapitalPhi]", 
      StyleBox["n", "TI"]]}], "=", 
    FractionBox[
     RowBox[{"2", 
      StyleBox["g", "TI"], 
      SqrtBox[
       RowBox[{
        StyleBox["n", "TI"], "+", "1"}]]}], 
     SubscriptBox["\[CapitalOmega]", 
      StyleBox["n", "TI"]]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1135274804,ExpressionUUID->"56ab1322-2efb-56d4-23ad-88ebcbbd17a2"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["n", "TI"]], "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalDelta]", "2"], "+", "4", 
     SuperscriptBox[
      StyleBox["g", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e4ec842-fbf6-007c-3ada-bb5a0fba15ea"],
 " and energies ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["n", "TI"]], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ad1b495-d1b1-f023-16ca-ef8c2e980e6d"],
 " (plus ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a39ed45-535e-5420-7d1a-54a6189ca3d7"],
 " in the lab frame). Replacing ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1441a8-3fa2-c977-2b3d-b5572222022e"],
 " by ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e60c9ca-5eaa-9f76-1cdb-628270fec5a6"],
 " gives the atomic states ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["\[PlusMinus]", 
     StyleBox["\[Alpha]", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29e9f5ae-7e39-9b8f-2172-1a6078adbc7f"],
 ", the eigenstates of the atom in the classical field ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c302f3-c766-3e33-334d-37bb68d0fcbc"],
 "."
}], "Text",
 CellID->1294480848,ExpressionUUID->"5ae18697-93a2-fe4a-4421-987ea2d117dc"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["A", "TI"]]},
    "Ket"], 
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02ea55aa-8f6e-ebee-641b-c20222c852d4"],
 " evolves for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["A", "TI"]]},
     "Ket"], "=", 
    TemplateBox[{
      StyleBox["e", "TI"]},
     "Ket"]}], ",", 
   TemplateBox[{
     SubscriptBox["+", 
      StyleBox["\[Alpha]", "TI"]]},
    "Ket"], ",", 
   TemplateBox[{
     SubscriptBox["-", 
      StyleBox["\[Alpha]", "TI"]]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e7db58f-17f1-3492-56a6-21415d3363b0"],
 " on 40 Fock levels, and the figure plots the atom's von Neumann entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["A", "TI"]], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["A", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5da8f134-5008-931e-71e9-0ed0e9661da9"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["A", "TI"]], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox[
      RowBox[{"f", "i", "e", "l", "d"}], "TI"]], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d50fae5-7206-5539-4165-cc06e2590123"],
 "; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b155a75-5314-e974-0ea5-cd77f6150615"],
 ":"
}], "Text",
 CellID->877103400,ExpressionUUID->"061f9e10-eb6b-3fe7-1fba-8530cc950897"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"jcdA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"40", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"jcdLower", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jcdAtoms", "[", 
    RowBox[{"nb_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[CapitalPhi]", " ", "=", " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"\[CapitalDelta]", ",", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "nb", "]"}]}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"QuantumState", " ", "/@", " ", 
      RowBox[{"N", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[CapitalPhi]", "/", "2"}], "]"}], ",", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[CapitalPhi]", "/", "2"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[CapitalPhi]", "/", "2"}], "]"}]}], ",", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"\[CapitalPhi]", "/", "2"}], "]"}]}], "}"}]}], "}"}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"jcdEntropy", "[", 
     RowBox[{"nb_", ",", " ", "\[CapitalDelta]_"}], "]"}], "[", "atom_", 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]A", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumPartialTrace", "[", 
          RowBox[{
           RowBox[{"QuantumEvolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
               RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+",
               " ", 
              RowBox[{
               RowBox[{"SuperDagger", "[", "jcdLower", "]"}], " ", "@", " ", 
               "jcdA"}], " ", "+", " ", 
              RowBox[{"jcdLower", " ", "@", " ", 
               RowBox[{"SuperDagger", "[", "jcdA", "]"}]}]}], ",", "\n", 
             "       ", 
             RowBox[{"QuantumTensorProduct", "[", 
              RowBox[{"atom", ",", " ", 
               RowBox[{
                RowBox[{"CoherentState", "[", "40", "]"}], "[", 
                RowBox[{"N", "[", 
                 RowBox[{"Sqrt", "[", "nb", "]"}], "]"}], "]"}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "0", ",", " ", "30"}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
         "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", " ", 
         RowBox[{"QuantityMagnitude", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", 
            RowBox[{"\[Rho]A", " ", "/.", " ", 
             RowBox[{"t", " ", "->", " ", "s"}]}], "]"}], 
           "[", "\"\<VonNeumannEntropy\>\"", "]"}], "]"}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "30", ",", " ", "0.1"}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jcdPanel", "[", 
    RowBox[{"nb_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"jcdEntropy", "[", 
       RowBox[{"nb", ",", " ", "\[CapitalDelta]"}], "]"}], " ", "/@", " ", 
      RowBox[{"jcdAtoms", "[", 
       RowBox[{"nb", ",", " ", "\[CapitalDelta]"}], "]"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Thick", ",", " ", "Dashed"}], "}"}]}], 
     ",", "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<|e\[RightAngleBracket]\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<|\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<+\>\"", ",", " ", "\"\<\[Alpha]\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}], ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<|\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<-\>\"", ",", " ", "\"\<\[Alpha]\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}]}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<g t\>\"", ",", " ", "\"\<S (bits)\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}], ",", " ", "\"\< = \>\"", 
         ",", " ", "nb", ",", " ", "\"\<,   \[CapitalDelta]/g = \>\"", ",", 
         " ", "\[CapitalDelta]"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jcdPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"jcdPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "16"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"First", ",", " ", "jcdPanels", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"jcdPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[110]:= ",
 CellID->1602068524,ExpressionUUID->"437c851f-a479-60c3-7942-b999c1c03381"],

Cell[TextData[{
 "An excited atom is strongly entangled within a few ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e5c0656-0616-e080-58b9-0e07b9f48bf6"],
 "; in the larger field its entropy dips near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["t", "TI"], "=", "\[Pi]", 
   SqrtBox[
    OverscriptBox[
     StyleBox["n", "TI"], "_"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cefc44e-05c7-0406-652f-3759d44158ef"],
 ", midway to the revival, almost to zero on resonance, before rising again. \
In the larger field, which acts more like the classical amplitude ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71032b50-eaa8-8ae6-33de-b923bd1a40eb"],
 ", an atom started in a dressed state ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["\[PlusMinus]", 
     StyleBox["\[Alpha]", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7d8eca-2bab-b540-4cb5-840640713bdb"],
 " stays far less entangled than the excited atom except near that dip; in \
the weaker field on resonance it does so only briefly. Detuning lowers the \
excited atom's peaks and raises its dip, and separates the two dressed \
starts, which coincide on resonance."
}], "Text",
 CellID->1484769852,ExpressionUUID->"31be6ef1-4eb7-8bf1-3f07-3e602a6f424b"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->883700778,ExpressionUUID->"5007a8b7-65d2-7a38-222d-c55d53bd83b3"],

Cell["Where a two-mode squeezed vacuum is squeezed", "Subsection",
 CellID->14770034,ExpressionUUID->"7ff9eef0-45c6-b54a-387d-e27776cef253"],

Cell[TextData[{
 "Two field modes ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b4a2af8-0018-19fd-58b7-e12b0e3d075e"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "731bafa9-7628-5007-0965-814bad2e7f8d"],
 " start in the vacuum and are squeezed together, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], "2"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["r", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0,0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32e31012-f60c-2aa1-5cf2-75034255ccc9"],
 ". Where in the four-dimensional phase space is the state squeezed below the \
vacuum?"
}], "Text",
 CellID->1921099595,ExpressionUUID->"4164e0b7-cfe6-f511-7498-d655c1e4eb6f"],

Cell[TextData[{
 "The two-mode squeezer ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "-", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["b", "TI"], "^"], "\[Dagger]"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644898c3-08b6-bcdb-1e81-3d8a08aee770"],
 " creates and destroys photons in pairs, one in each mode. With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], 
    StyleBox["k", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["k", "TI"]], "+", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["k", "TI"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e8e96de-a1c9-f8e9-0041-5184a5b67eb0"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], 
    StyleBox["k", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["k", "TI"]], "-", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["k", "TI"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["i", "TI"], 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "777ee5f1-7727-9bbc-6a5b-e83ebe078dc1"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "^"], "1"], ",", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["p", "TI"], "^"], "1"], ",", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["x", "TI"], "^"], "2"], ",", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["p", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ea7d5a6-87c2-5f39-2f8f-20d4443610b8"],
 ", the covariance matrix is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox[
     RowBox[{"k", "l"}], "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"{", "\[CapitalDelta]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "^"], 
      StyleBox["k", "TI"]]}], ",", 
    RowBox[{"\[CapitalDelta]", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["r", "TI"], "^"], 
      StyleBox["l", "TI"]], "}"}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72039816-aa72-dd66-0258-7398d4e727d4"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Sigma]", "TI"], "=", 
   FractionBox["1", "2"], "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25dda6cf-a74c-0374-6370-fad3216cbee9"],
 " for the vacuum; here"
}], "Text",
 CellID->1007992846,ExpressionUUID->"0511d2b4-c312-3be9-227d-060b27169abb"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Sigma]", "TI"], "=", 
    FractionBox["1", "2"], "(", GridBox[{
      {
       StyleBox["c", "TI"], "0", 
       RowBox[{"-", 
        StyleBox["s", "TI"]}], "0"},
      {"0", 
       StyleBox["c", "TI"], "0", 
       StyleBox["s", "TI"]},
      {
       RowBox[{"-", 
        StyleBox["s", "TI"]}], "0", 
       StyleBox["c", "TI"], "0"},
      {"0", 
       StyleBox["s", "TI"], "0", 
       StyleBox["c", "TI"]}
     }], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["c", "TI"], "=", 
    RowBox[{
     StyleBox["cosh",
      FontSlant->"Plain"], "\[ThinSpace]", "2", 
     StyleBox["r", "TI"]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["s", "TI"], "=", 
    RowBox[{
     StyleBox["sinh",
      FontSlant->"Plain"], "\[ThinSpace]", "2", 
     StyleBox["r", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->784336504,ExpressionUUID->"0f08cb15-338c-2fd3-027f-fd27156523a3"],

Cell[TextData[{
 "so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "1"], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22a054a2-3d34-5e76-1bd7-ecdfdb9aa3a0"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "1"], "-", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "367122e5-5cab-9475-28c1-38cf082a1002"],
 " have variance ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "2", 
    StyleBox["r", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20c5e514-d841-7112-6a4f-e0701d71da5e"],
 ", against 1 for the vacuum. In each plane of two quadratures the Wigner \
marginal falls to ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "1", "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c415a5-72db-3160-2d17-0e4f45088e32"],
 " of its peak on the ellipse ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    StyleBox["T", "TI"]], 
   SuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    RowBox[{"-", "1"}]], 
   StyleBox["r",
    FontWeight->"Bold",
    FontSlant->"Plain"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a5ce797-1106-ab5d-7313-896a71584d62"],
 " built from that plane's ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2eaf96-d272-d45b-7508-21efd6ead03a"],
 " block of ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37d0d732-693a-444d-7d36-faba0216908e"],
 "."
}], "Text",
 CellID->508167779,ExpressionUUID->"11ada648-2758-3216-45de-da7880f7895b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22d570df-7eee-36f8-53a8-67820ea1032b"],
 ", a matrix exponential on 30 Fock levels per mode, acts on ",
 Cell[BoxData[
  TemplateBox[{"0,0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57e6c9b7-93a6-4863-112e-29e8e01fa296"],
 ", and the covariance matrix ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fc6424a-241d-50ae-4e1b-1c38702961e9"],
 " of the result gives the markers; each panel draws the closed-form ellipse \
in one plane (curves), with the vacuum's circle dashed:"
}], "Text",
 CellID->2082633789,ExpressionUUID->"181a28e3-7bbc-eeaf-6869-19d2e8f5c6c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmsA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"30", ",", " ", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"tmsB", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"30", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tmsSigma", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"tmsSigma", "[", "r", "]"}], " ", "=", " ", 
    RowBox[{"CovarianceMatrix", "[", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"r", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"tmsA", " ", "@", " ", "tmsB"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"SuperDagger", "[", "tmsA", "]"}], " ", "@", " ", 
           RowBox[{"SuperDagger", "[", "tmsB", "]"}]}]}], ")"}]}], ",", " ", 
       RowBox[{"FockState", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "30"}], "]"}]}], 
      "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tmsClosed", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cosh", "[", 
         RowBox[{"2", " ", "r"}], "]"}], ",", " ", "0", ",", " ", 
        RowBox[{"-", 
         RowBox[{"Sinh", "[", 
          RowBox[{"2", " ", "r"}], "]"}]}], ",", " ", "0"}], "}"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Cosh", "[", 
         RowBox[{"2", " ", "r"}], "]"}], ",", " ", "0", ",", " ", 
        RowBox[{"Sinh", "[", 
         RowBox[{"2", " ", "r"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Sinh", "[", 
          RowBox[{"2", " ", "r"}], "]"}]}], ",", " ", "0", ",", " ", 
        RowBox[{"Cosh", "[", 
         RowBox[{"2", " ", "r"}], "]"}], ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Sinh", "[", 
         RowBox[{"2", " ", "r"}], "]"}], ",", " ", "0", ",", " ", 
        RowBox[{"Cosh", "[", 
         RowBox[{"2", " ", "r"}], "]"}]}], "}"}]}], "}"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tmsEllipse", "[", "\[Sigma]_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MatrixPower", "[", 
       RowBox[{"\[Sigma]", ",", " ", 
        RowBox[{"1", "/", "2"}]}], "]"}], " ", ".", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "u", "]"}], ",", " ", 
        RowBox[{"Sin", "[", "u", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}], ",", " ", 
       RowBox[{"Pi", "/", "60"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tmsPanel", "[", 
    RowBox[{"{", 
     RowBox[{"i_", ",", " ", "j_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"labels", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<x\>\"", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<p\>\"", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<x\>\"", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<p\>\"", ",", " ", "2"}], "]"}]}], "}"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"tmsEllipse", "[", 
              RowBox[{
               RowBox[{"tmsClosed", "[", "#", "]"}], "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], "]"}], "]"}], 
             " ", "&"}], " ", "/@", " ", 
            RowBox[{"{", 
             RowBox[{"0.3", ",", " ", "0.6", ",", " ", "1."}], "}"}]}], ",", 
           " ", 
           RowBox[{"tmsEllipse", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}], "]"}]}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
           "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", 
            " ", "Dashed"}], "}"}]}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<r = 0.3\>\"", ",", " ", "\"\<r = 0.6\>\"", ",", 
            " ", "\"\<r = 1\>\"", ",", " ", "\"\<vacuum\>\""}], "}"}]}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"tmsEllipse", "[", 
             RowBox[{
              RowBox[{"tmsSigma", "[", "#", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", ";;", " ", "10"}], "]"}], "]"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"0.3", ",", " ", "0.6", ",", " ", "1."}], "}"}]}], ",", 
         " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "7"}], "}"}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2.5"}], ",", " ", "2.5"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2.5"}], ",", " ", "2.5"}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"labels", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "j"}], "}"}], "]"}], "]"}]}], ",", "\n", 
       "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<(\>\"", ",", " ", 
           RowBox[{"labels", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", " ", "\"\<, \>\"", ",", " ", 
           
           RowBox[{"labels", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", " ", "\"\<) plane\>\""}], 
          "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"tmsPanels", " ", "=", " ", 
   RowBox[{"tmsPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Row", "[", 
    RowBox[{
     RowBox[{"First", " ", "/@", " ", "tmsPanels"}], ",", " ", 
     RowBox[{"Spacer", "[", "10", "]"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "tmsPanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[111]:= ",
 CellID->1562788210,ExpressionUUID->"3f89b675-5906-1098-2b27-4c2d0f399efb"],

Cell[TextData[{
 "On its own, mode 1 is a circle wider than the vacuum's, an isotropic \
Gaussian, so it is thermal light, noisier for larger ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d0cfe7e-52a7-eedc-11af-0f4fac3d564f"],
 ". The squeezing lives only in joint quadratures: ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e09b407-3cad-9739-3201-9efb858c3567"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ab9e61-a041-dfa2-1378-83222ebc1d97"],
 " are anticorrelated and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b22a403-8286-0808-1f92-f9489e78bd18"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfd184e-0fb0-af63-201b-3b81a627b45e"],
 " correlated, so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "1"], "+", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b76abd9-eeb1-664b-1f95-301ef1bd9c88"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "1"], "-", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b76edf3-7b08-7a78-523a-1c2514b4bdaa"],
 " fall inside the vacuum circle along the narrow axes of the tilted \
ellipses, further for larger ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a344c06-b36a-8f73-2467-c900b588c478"],
 "."
}], "Text",
 CellID->257529101,ExpressionUUID->"00f1f7a9-20f7-9958-6f8b-09ebd244448f"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->134949497,ExpressionUUID->"198d76f2-062f-0fc0-345d-e6bba8d75b5d"],

Cell["Six photons that the suppression law does not darken", "Subsection",
 CellID->1814126899,ExpressionUUID->"619dcdc7-ba53-2c29-2180-661973582343"],

Cell[TextData[{
 "One photon enters each port of a six-mode lossless network whose transfer \
matrix is the discrete Fourier matrix. The suppression law of Tichy and \
coworkers says that an output pattern ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     StyleBox["t", "TI"], "1"]}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], "6"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75ef2fa4-e75b-2a4d-4077-07b5464bdee4"],
 " is dark whenever ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d7838f2-725f-709f-651b-49c566f23bc9"],
 " is not a multiple of 6. Is every pattern the law allows actually bright?"
}], "Text",
 CellID->323004448,ExpressionUUID->"56a3d8c0-a631-6ee9-430a-bdd23173c2bf"],

Cell[TextData[{
 "The network maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], "\[Rule]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["j", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "666d0b3c-241a-5faf-0b65-e2e1e265d813"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["j", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["k", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", 
   SqrtBox["6"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d8c003-4997-1b53-6bc7-956fbe2e6a68"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"2", "\[Pi]", 
     StyleBox["i", "TI"], "/", "6"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ff04664-48db-0293-6ebf-ae5cba17fdf2"],
 ". With one photon per input port, a pattern ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654ce37d-e940-92e0-7709-12ecdd3886a9"],
 " has probability"
}], "Text",
 CellID->146758005,ExpressionUUID->"5db05586-dea6-2d08-1e4b-1a257627d733"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["T", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     SuperscriptBox[GridBox[{
        {
         RowBox[{
          StyleBox["Per",
           FontSlant->"Plain"], 
          SubscriptBox[
           StyleBox["W", "TI"], 
           StyleBox["T", "TI"]]}]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
     RowBox[{
      RowBox[{
       UnderscriptBox["\[Product]", 
        StyleBox["j", "TI"],
        LimitsPositioning->False], 
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["j", "TI"]]}], "!"}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->232345095,ExpressionUUID->"43f2eed7-016e-8301-3116-9e385a9fa4c0"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539173bd-b771-1a49-6d46-dca6060466de"],
 " uses every column of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2130f0be-fc5a-5bda-19d3-f44c0c3d233b"],
 " once and repeats row ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14a92fb7-18cd-6613-6f3b-3a0895a4667f"],
 " ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c1cf48f-4573-7d44-2d76-30a90329220b"],
 " times."
}], "Text",
 CellID->864209885,ExpressionUUID->"07d97a86-dc4a-5d0e-0fda-3e663c920722"],

Cell[TextData[{
 "The probabilities of all ",
 Cell[BoxData[
  TemplateBox[{"11", "6"},
   "Binomial"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78c5d5f0-7428-b083-35b5-de53b2c3a5bf"],
 " output patterns from ",
 Cell[BoxData[
  TemplateBox[{"1,1,1,1,1,1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64b8a162-bd37-74eb-2d40-923985db5001"],
 " are exact rational numbers, so a zero is exact; the patterns are sorted by \
",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox["mod",
    FontSlant->"Plain"], "\[ThinSpace]", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "185e3255-5bad-abe9-65b1-fa7f8922f59c"],
 ":"
}], "Text",
 CellID->472350499,ExpressionUUID->"6e57b9ab-6d2e-c7c0-08e9-dfaf84ceb758"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sixPhotonProbs", " ", "=", " ", 
   RowBox[{"KeyMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<Name\>\"", "]"}], " ", "&"}], ",", " ", 
     RowBox[{
      RowBox[{"QuantumInterferometer", "[", 
       RowBox[{"FourierMatrix", "[", "6", "]"}], "]"}], "[", 
      RowBox[{"\"\<Probabilities\>\"", ",", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", " ", "6"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sixPhotonResidue", " ", "=", " ", 
   RowBox[{
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "5"}], "]"}], " ", ".", " ", "#"}], ",", " ", 
      "6"}], "]"}], " ", "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sixPhotonCounts", " ", "=", " ", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Keys", "[", "sixPhotonProbs", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"sixPhotonResidue", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"sixPhotonProbs", "[", "#", "]"}], " ", "===", " ", "0"}], 
        " ", "&"}]}], "}"}], ",", " ", "Length"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sixPhotonAllowedDark", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Keys", "[", "sixPhotonProbs", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"sixPhotonResidue", "[", "#", "]"}], " ", "==", " ", "0"}], 
       " ", "&&", " ", 
       RowBox[{
        RowBox[{"sixPhotonProbs", "[", "#", "]"}], " ", "===", " ", "0"}]}], 
      " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sixPhotonExtra", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Count", "[", 
    RowBox[{
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"KeyMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<Name\>\"", "]"}], " ", "&"}], ",", " ", 
        RowBox[{
         RowBox[{"QuantumInterferometer", "[", 
          RowBox[{"FourierMatrix", "[", "m", "]"}], "]"}], "[", 
         RowBox[{"\"\<Probabilities\>\"", ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"1", ",", " ", "m"}], "]"}]}], "]"}]}], "]"}]}], ",", " ", 
     
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t_", " ", "->", " ", "p_"}], ")"}], " ", "/;", " ", 
      RowBox[{
       RowBox[{"Divisible", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"m", " ", "-", " ", "1"}]}], "]"}], " ", ".", " ", "t"}], 
         ",", " ", "m"}], "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"N", "[", "p", "]"}], "]"}], " ", "==", " ", "0"}]}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"BarChart", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"sixPhotonCounts", "[", "r", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"False", ",", " ", "True"}], "}"}], ",", " ", "0"}], "]"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ChartLayout", " ", "->", " ", "\"\<Stacked\>\""}], ",", "\n", 
     "    ", 
     RowBox[{"ChartLabels", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "5"}], "]"}], ",", " ", "None"}], "}"}]}], ",",
      " ", 
     RowBox[{"ChartLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<bright\>\"", ",", " ", "\"\<exactly dark\>\""}], "}"}]}], 
     ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Sum] (j \[Minus] 1) \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<t\>\"", ",", " ", "\"\<j\>\""}], "]"}], ",", 
           " ", "\"\<  mod 6\>\""}], "}"}], "]"}], ",", 
        " ", "\"\<output patterns\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<allowed by the law, yet exactly dark (\>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<t\>\"", ",", " ", "\"\<1\>\""}], "]"}], ",", 
            " ", "\"\<\[Ellipsis]\>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<t\>\"", ",", " ", "\"\<6\>\""}], "]"}], ",", 
            " ", "\"\<):\>\""}], "}"}], "]"}], ",", " ", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"Row", " ", "/@", " ", "sixPhotonAllowedDark"}], ",", 
             " ", "6"}], "]"}], ",", " ", 
           RowBox[{"Spacings", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "0.5"}], "}"}]}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<allowed yet dark, m = 2, 3, 4, 5, 6 modes:  \>\"", ",",
             " ", 
            RowBox[{"Row", "[", 
             RowBox[{
              RowBox[{"Append", "[", 
               RowBox[{
                RowBox[{"sixPhotonExtra", " ", "/@", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"2", ",", " ", "5"}], "]"}]}], ",", " ", 
                RowBox[{"Length", "[", "sixPhotonAllowedDark", "]"}]}], "]"}],
               ",", " ", "\"\<, \>\""}], "]"}]}], "}"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], ",", " ", 
     "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[112]:= ",
 CellID->2045663203,ExpressionUUID->"4932bcf0-23ce-ff4e-304b-e5a8f5a4f058"],

Cell["\<\
Every pattern whose sum is not a multiple of 6 is exactly dark, as the law \
requires. Most patterns with sum 0 are bright, but some are exactly dark as \
well, each with one or two ports holding two photons. The law is sufficient \
for darkness but not necessary, and six ports is the smallest Fourier network \
where it fails to be necessary.\
\>", "Text",
 CellID->936563528,ExpressionUUID->"048803d3-0b0c-4465-3886-1439a24f9656"],

