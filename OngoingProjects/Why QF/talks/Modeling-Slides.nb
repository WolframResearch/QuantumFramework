Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"krausGauss", "[", 
    RowBox[{"i_", ",", " ", "A_", ",", " ", "d_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"i", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "d"}], ")"}]}], " ", "A"}], "]"}]}], ";"}], "\n", 
 RowBox[{"detKraus", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Det", "[", 
     RowBox[{"krausGauss", "[", 
      RowBox[{"iRead", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[CurlyTheta]", "]"}], " ", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[CurlyTheta]", "]"}], " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ",", " ", "dVar"}], 
      "]"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"iRead", ",", " ", "\[CurlyTheta]"}], "}"}], " ", "\[Element]",
       " ", "Reals"}], " ", "&&", " ", 
     RowBox[{"dVar", " ", ">", " ", "0"}]}]}], "]"}]}]}], "Input",
 CellLabel->"In[33]:= ",
 CellID->675545700,ExpressionUUID->"16f1fcc0-0157-9ee6-65fd-c4e0de72f5d4"],

Cell[TextData[{
 "A run of 20 readings starts from ",
