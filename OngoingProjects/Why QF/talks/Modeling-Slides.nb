Cell[TextData[{
 "The four syndrome sectors, with projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalPi]", "^"], 
    StyleBox["s", "TI"]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "2"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S", "TI"], "^"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fd19457-6ecb-f041-2709-c399e2fb967a"],
 ", have probabilities ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["s", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c342f69-4c81-38b4-7016-dc9edc105d61"],
 ". The filter relaxes them toward ",
