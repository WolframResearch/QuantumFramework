Cell[BoxData[{
 RowBox[{
  RowBox[{"parityBit", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"QuantumOperator", "[", "\"\<ZZ\>\"", "]"}]}], ")"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecIn", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"\[Beta]", "/", "2"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Beta]", "/", "2"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecEncoder", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
     RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecCode", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumCircuitOperator", "[", "qecEncoder", "]"}], "[", "qecIn", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecPanel", "[", 
    RowBox[{"label_", ",", " ", "err_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"out", " ", "=", " ", 
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"qecEncoder", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\"\<RX\>\"", "[", 
               RowBox[{"2", " ", "\[Theta]"}], "]"}], " ", "->", " ", "err"}],
              ",", "\n", "       ", 
             RowBox[{
              RowBox[{"\"\<Lueders\>\"", "[", "parityBit", "]"}], " ", "->", 
              " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
             RowBox[{
              RowBox[{"\"\<Lueders\>\"", "[", "parityBit", "]"}], " ", "->", 
              " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", "\n", "       ", 
             RowBox[{"\"\<C\>\"", "[", 
              RowBox[{
               RowBox[{"\"\<X\>\"", " ", "->", " ", "1"}], ",", " ", 
               RowBox[{"{", "0", "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"-", "1"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"\"\<C\>\"", "[", 
              RowBox[{
               RowBox[{"\"\<X\>\"", " ", "->", " ", "2"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"-", "1"}]}], "}"}], ",", " ", 
               RowBox[{"{", "}"}]}], "]"}], ",", " ", 
             RowBox[{"\"\<C\>\"", "[", 
              RowBox[{
               RowBox[{"\"\<X\>\"", " ", "->", " ", "3"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"-", "1"}], "}"}], ",", " ", 
               RowBox[{"{", "0", "}"}]}], "]"}]}], "}"}]}], "]"}], "]"}], "[",
         "qecIn", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rec", " ", "=", " ", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"Diagonal", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{
             RowBox[{"QuantumPartialTrace", "[", 
              RowBox[{"out", ",", " ", 
               RowBox[{"{", 
                RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}], 
             "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Theta]", ",", " ", "\[Beta]", ",", " ", "\[Phi]"}], 
            "}"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}], ",", "\n", 
       "     ", 
       RowBox[{"fid", " ", "=", " ", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"QuantumSimilarity", "[", 
           RowBox[{
            RowBox[{"QuantumPartialTrace", "[", 
             RowBox[{"out", ",", " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
            "qecCode", ",", " ", "\"\<Fidelity\>\""}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Theta]", ",", " ", "\[Beta]", ",", " ", "\[Phi]"}], 
            "}"}], " ", "\[Element]", " ", "Reals"}]}], "]"}]}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rec", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"rec", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
           RowBox[{"rec", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
          RowBox[{"rec", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", " ", 
          RowBox[{"fid", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Beta]", " ", "->", " ", "0"}], ",", " ", 
             RowBox[{"\[Phi]", " ", "->", " ", "0"}]}], "}"}]}], ",", " ", 
          RowBox[{"fid", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Beta]", " ", "->", " ", 
              RowBox[{"\[Pi]", "/", "2"}]}], ",", " ", 
             RowBox[{"\[Phi]", " ", "->", " ", "0"}]}], "}"}]}]}], "}"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "\[Pi]"}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
          "Dashed", ",", " ", "DotDashed"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "     ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Theta]\>\"", ",", 
          " ", "\"\<probability, fidelity\>\""}], "}"}]}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", " ", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  RowBox[{"TraditionalForm", "[", "#", "]"}], ",", " ", 
                  RowBox[{"FractionBoxOptions", " ", "->", " ", 
                   RowBox[{"{", 
                    RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], 
                 "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", " ", "\[Pi]", ",", " ", 
               RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}], ",", " ", "None"}], 
           "}"}]}], "}"}]}], ",", "\n", "     ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<records (0,0)\>\"", ",", " ", "\"\<one odd parity\>\"", 
          ",", " ", "\"\<records (1,1)\>\"", ",", 
          " ", "\"\<fidelity, input |0\:27e9\>\"", ",", 
          " ", "\"\<fidelity, input |+\:27e9\>\""}], "}"}]}], ",", "\n", 
       "     ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"label", ",", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fid", " ", "===", " ", "1"}], ",", 
              " ", "\"\<fidelity 1 for all \[Beta], \[Phi]\>\"", ",", 
              " ", "\"\<fidelity depends on \[Beta], \[Phi]\>\""}], "]"}]}], 
           "}"}], ",", " ", 
          RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], ",", 
       "\n", "     ", 
       RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qecPanels", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"qecPanel", "[", 
      RowBox[{"\"\<RX(2\[Theta]) on qubit 2\>\"", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"qecPanel", "[", 
      RowBox[{"\"\<RX(2\[Theta]) on every qubit\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"qecEncoder", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\"\<RX\>\"", "[", 
               RowBox[{"2", " ", "\[Theta]"}], "]"}], " ", "->", " ", 
              RowBox[{"{", "2", "}"}]}], ",", " ", 
             RowBox[{
              RowBox[{"\"\<Lueders\>\"", "[", "parityBit", "]"}], " ", "->", 
              " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
             RowBox[{
              RowBox[{"\"\<Lueders\>\"", "[", "parityBit", "]"}], " ", "->", 
              " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
             RowBox[{"\"\<C\>\"", "[", 
              RowBox[{
               RowBox[{"\"\<X\>\"", " ", "->", " ", "1"}], ",", " ", 
               RowBox[{"{", "0", "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"-", "1"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"\"\<C\>\"", "[", 
              RowBox[{
               RowBox[{"\"\<X\>\"", " ", "->", " ", "2"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"-", "1"}]}], "}"}], ",", " ", 
               RowBox[{"{", "}"}]}], "]"}], ",", " ", 
             RowBox[{"\"\<C\>\"", "[", 
              RowBox[{
               RowBox[{"\"\<X\>\"", " ", "->", " ", "3"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"-", "1"}], "}"}], ",", " ", 
               RowBox[{"{", "0", "}"}]}], "]"}]}], "}"}]}], "]"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "560"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<encode, error on qubit 2, two parity measurements, \
corrections controlled by the records\>\"", ",", " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"PlotGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"First", " ", "/@", " ", "qecPanels"}], "}"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "680"}]}], "]"}], ",", " ", 
       RowBox[{"legendBelow", "[", 
        RowBox[{"Last", "[", 
         RowBox[{"First", "[", "qecPanels", "]"}], "]"}], "]"}]}], "]"}]}], 
    "}"}], ",", " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[71]:= ",
 CellID->1621906047,ExpressionUUID->"2f804d9a-35af-c6dd-28e3-4ad72cd02044"],

Cell[TextData[{
 "With the error on qubit 2 a single odd parity never occurs, so the \
measurement turns the rotation into either no error or a full flip of the \
middle qubit, and the record-controlled gates undo both branches for every ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "575df90b-803f-08e4-4851-9e4d398f1886"],
 " and every input. When all three qubits rotate, two flips are mistaken for \
one and three go unseen, so each branch leaves a superposition of the code \
word and its logical flip ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["X", "TI"], "_"], "=", 
   StyleBox["X", "TI"], 
   StyleBox["X", "TI"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3446d3c9-6698-85a5-7095-8e16d13fdc32"],
 ": a logical rotation about ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a198ab8-a668-d2e6-1c5a-94e2bc6e6702"],
 ". It lowers the fidelity of ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4723e3fa-2c35-093e-70b5-812434939167"],
 " but leaves ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70858fd1-7802-e21c-411c-a4cb11211105"],
 ", an eigenstate of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["X", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3257f8fb-73c2-70cc-40de-a74651362f9b"],
 ", untouched, so the code fails and the damage depends on the input."
}], "Text",
 CellID->1970891289,ExpressionUUID->"68b1302c-98ed-5126-005b-7e7adb8a2684"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2126370359,ExpressionUUID->"4d9d758b-1371-b09e-79b7-aac1ea9ca33d"],

Cell["Teleportation with the classical channel as record wires", "Subsection",
 CellID->432959352,ExpressionUUID->"67f53df8-0559-8d09-5d73-376ad9ac9b06"],

Cell["\<\
Alice holds an unknown qubit and one half of a Bell pair; Bob holds the other \
half. She measures her two qubits in the Bell basis, and Bob corrects his \
qubit according to her two outcomes. The outcomes are kept as record qubits, \
so Bob's corrections are gates controlled by the records. Does Bob end up \
with Alice's state, for every input?\
\>", "Text",
 CellID->484094253,ExpressionUUID->"5c75fb62-bd56-bf78-5901-494bfec4c00d"],

Cell[TextData[{
 "With the input ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Phi]"}], "TI"]], 
     StyleBox["sin",
      FontSlant->"Plain"], 
     FractionBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     TemplateBox[{"1"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49ce02da-7a70-f98a-6a6f-644d9e4d64ee"],
 " on qubit 1, whose Bloch vector is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29752073-fcc3-fbac-53f2-50b463196ccf"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e3709e2-1aad-a486-6c14-6004f098902c"],
 " on qubits 2 and 3, the protocol is"
}], "Text",
 CellID->1163284687,ExpressionUUID->"51bfc462-2275-1fe9-05e9-fd214c628c6a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   UnderscriptBox[
    UnderscriptBox[
     RowBox[{
      SubscriptBox[
       StyleBox["CNOT",
        FontSlant->"Plain"], "23"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["H", "TI"], "2"]}], "\[UnderBrace]"], 
    StyleBox[
     RowBox[{"Bell", "\[NonBreakingSpace]", "pair"}],
     FontSlant->"Plain"]], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   UnderscriptBox[
    UnderscriptBox[
     RowBox[{
      SubscriptBox[
       StyleBox["H", "TI"], "1"], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["CNOT",
        FontSlant->"Plain"], "12"]}], "\[UnderBrace]"], 
    StyleBox[
     RowBox[{"Bell", "\[NonBreakingSpace]", "basis"}],
     FontSlant->"Plain"]], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{
