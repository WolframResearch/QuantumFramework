Cell["The spin-1 NV center in a tilted magnetic field", "Subsection",
 CellID->1899442138,ExpressionUUID->"74d76617-b0e1-b78c-36a6-b5624fefcdd0"],

Cell[TextData[{
 "The ground state of a nitrogen-vacancy center in diamond is a spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "508ea0dc-eddf-2cd4-582e-467b6fed8169"],
 ". The crystal field lifts ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["s", "TI"]], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d2ed813-6626-a840-3b89-0faa7d531c86"],
 " above ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["s", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54d2dda7-6dae-5691-5b5c-b9bc7f08d021"],
 " by the zero-field splitting ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a07500f-2eeb-dc05-118e-bc38cd03fbe7"],
 ", strain adds a transverse anisotropy ",
 Cell[BoxData[
  StyleBox["E", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6247c087-d0cf-753b-5e76-77478a0fa0dd"],
 ", and a magnetic field ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14b0342f-cc66-dcf4-61fb-6bbeda8f28ef"],
 ", tilted by ",
 Cell[BoxData["\[CurlyTheta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76084490-8183-c8c9-2403-4b0d3482eb7a"],
 " from the defect axis ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "059cadf2-5dad-0f9c-08b2-63b58c379be1"],
 ", couples through the electron's gyromagnetic ratio ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69553055-35e5-c283-6980-e6c955775cc0"],
 ". Which level crossings survive strain and a tilted field?"
}], "Text",
 CellID->1451899687,ExpressionUUID->"5fde56a8-fd61-0ae4-2395-8e38a94503c0"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fac4956-a677-0c75-75ae-ee412ddb45d9"],
 " and ",
