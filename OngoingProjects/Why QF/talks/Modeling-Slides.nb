        ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<r\>\"", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<, \[Theta]:  \>\"", ",", " ", "uhlIdentity"}], "}"}], "]"}],
      ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
