            RowBox[{"composeExactSum", "[", "name", "]"}], "[", 
            RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "/.", " ", "unit"}], 
          "]"}], "]"}], " ", "&"}]}], "}"}], ",", " ", 
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "c"}], "]"}], " ", "-",
        " ", 
       RowBox[{"f", "[", 
        RowBox[{"a", ",", " ", 
         RowBox[{"f", "[", 
          RowBox[{"b", ",", " ", "c"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"composeTriple", " ", "=", " ", 
   RowBox[{
    RowBox[{"3", "/", "5"}], " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", 
        RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{
         RowBox[{"-", "4"}], "/", "5"}], ",", " ", "0", ",", " ", "0"}], 
       "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", 
        RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"composeShow", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"compose\[Alpha]", "[", "\[Mu]_", "]"}], " ", ":>", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[Alpha]\>\"", ",", " ", "\[Mu]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"compose\[Beta]", "[", "\[Mu]_", "]"}], " ", ":>", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[Beta]\>\"", ",", " ", "\[Mu]"}], "]"}]}], ",", " ", 
     RowBox[{"composeK", " ", "->", " ", "\"\<\[Kappa]\>\""}], ",", " ", 
     RowBox[{"composeA", " ", "->", " ", "\"\<a\>\""}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"composePanel", "[", 
    RowBox[{"name_", ",", " ", "unit_", ",", " ", "s_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pts", " ", "=", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"composeAl", ",", " ", "composeBe"}], "]"}], " ", "->", " ", 
         RowBox[{"s", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "0"}], "}"}], 
            ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"3", "/", "5"}], ",", " ", 
              RowBox[{
               RowBox[{"-", "4"}], "/", "5"}], ",", " ", "0", ",", " ", "0"}],
              "}"}]}], "]"}]}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]", " ", "=", " ", 
          RowBox[{"composeAl", " ", "/.", " ", "pts"}]}], ",", " ", 
         RowBox[{"\[Beta]", " ", "=", " ", 
          RowBox[{"composeBe", " ", "/.", " ", "pts"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{
           RowBox[{"Chop", "[", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Alpha]", " ", "+", " ", "\[Beta]"}], ",", " ", 
                RowBox[{
                 RowBox[{"composeSeriesSum", "[", "name", "]"}], " ", "/.", 
                 " ", "pts"}], ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"composeSeriesSum", "[", "name", "]"}], " ", "/.", 
                  " ", "composeSwap"}], " ", "/.", " ", "pts"}], ",", " ", 
                RowBox[{
                 RowBox[{"composeExactSum", "[", "name", "]"}], "[", 
                 RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "]"}], ",", " ", 
                RowBox[{
                 RowBox[{"composeExactSum", "[", "name", "]"}], "[", 
                 RowBox[{"\[Beta]", ",", " ", "\[Alpha]"}], "]"}]}], "}"}], 
              " ", "/.", " ", "unit"}], "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{";;", " ", "2"}]}], "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledSquare]\>\"", ",", " ", "14"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "16"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "30"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\"\<+\>\"", ",", " ", "14"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Times]\>\"", ",", " ", "14"}], "}"}]}], "}"}]}], ",",
          "\n", "     ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\[Alpha] + \[Beta]\>\"", ",", 
            " ", "\"\<\[Alpha] \[CirclePlus] \[Beta], fourth order\>\"", ",", 
            " ", "\"\<\[Beta] \[CirclePlus] \[Alpha], fourth order\>\"", ",", 
            " ", "\"\<\[Alpha] \[CirclePlus] \[Beta], exact\>\"", ",", 
            " ", "\"\<\[Beta] \[CirclePlus] \[Alpha], exact\>\""}], "}"}]}], ",",
          "\n", "     ", 
         RowBox[{"Epilog", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Gray", ",", " ", 
            RowBox[{"Arrow", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
               RowBox[{"\[Alpha]", "[", 
                RowBox[{"[", 
                 RowBox[{";;", " ", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
            " ", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<\[Alpha]\>\"", ",", " ", 
              RowBox[{"0.55", " ", 
               RowBox[{"\[Alpha]", "[", 
                RowBox[{"[", 
                 RowBox[{";;", " ", "2"}], "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"-", "1.5"}]}], "}"}]}], "]"}], ",", " ", "Dashed", ",",
             " ", 
            RowBox[{"Arrow", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
               RowBox[{"\[Beta]", "[", 
                RowBox[{"[", 
                 RowBox[{";;", " ", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
            " ", 
            RowBox[{"Text", "[", 
             RowBox[{"\"\<\[Beta]\>\"", ",", " ", 
              RowBox[{"0.55", " ", 
               RowBox[{"\[Beta]", "[", 
                RowBox[{"[", 
                 RowBox[{";;", " ", "2"}], "]"}], "]"}]}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1.5"}], ",", " ", "0"}], "}"}]}], "]"}]}], 
           "}"}]}], ",", "\n", "     ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"s", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.1"}], ",", " ", "1.9"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1.1"}], ",", " ", "0.7"}], "}"}]}], "}"}]}]}], ",",
          " ", 
         RowBox[{"AspectRatio", " ", "->", " ", "Automatic"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<p\>\"", ",", " ", "0"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<p\>\"", ",", " ", "1"}], "]"}]}], "}"}]}], ",", 
         "\n", "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"name", ",", " ", "\"\<,   s = \>\"", ",", " ", "s"}], 
            "}"}], "]"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"composePanels", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"composePanel", "[", 
      RowBox[{
       RowBox[{"Sequence", " ", "@@", " ", "m"}], ",", " ", "s"}], "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<Snyder\>\"", ",", " ", 
           RowBox[{"composeA", " ", "->", " ", "1"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Kappa]-Minkowski\>\"", ",", " ", 
           RowBox[{"composeK", " ", "->", " ", "1"}]}], "}"}]}], "}"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.3", ",", " ", "0.6", ",", " ", "0.9"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"Map", "[", 
       RowBox[{"First", ",", " ", "composePanels", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"composePanels", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"{", "\n", "     ", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Snyder, fourth order:  \[Alpha] \[CirclePlus] \[Beta] \
\[Minus] \[Beta] \[CirclePlus] \[Alpha] = (\>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{
             RowBox[{"Factor", "[", 
              RowBox[{
               RowBox[{"composeSnyderSplit", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Superscript", "[", 
                  RowBox[{"\"\<\[Alpha]\>\"", ",", " ", "2"}], "]"}], ",", 
                 " ", 
                 RowBox[{"Superscript", "[", 
                  RowBox[{"\"\<\[Beta]\>\"", ",", " ", "2"}], "]"}], ",", 
                 " ", "\"\<\[Alpha]\[CenterDot]\[Beta]\>\""}], "}"}]}], "]"}],
              " ", "/.", " ", "composeShow"}], "]"}], ",", 
           " ", "\"\<) \[Alpha] + (\>\"", ",", "\n", "       ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{
             RowBox[{"Factor", "[", 
              RowBox[{
               RowBox[{"composeSnyderSplit", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Superscript", "[", 
                  RowBox[{"\"\<\[Alpha]\>\"", ",", " ", "2"}], "]"}], ",", 
                 " ", 
                 RowBox[{"Superscript", "[", 
                  RowBox[{"\"\<\[Beta]\>\"", ",", " ", "2"}], "]"}], ",", 
                 " ", "\"\<\[Alpha]\[CenterDot]\[Beta]\>\""}], "}"}]}], "]"}],
              " ", "/.", " ", "composeShow"}], "]"}], ",", 
           " ", "\"\<) \[Beta]\>\""}], "}"}], "]"}], ",", "\n", "     ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[Kappa]-Minkowski, fourth order:  \[Alpha] \
\[CirclePlus] \[Beta] \[Minus] \[Beta] \[CirclePlus] \[Alpha] = \>\"", ",", 
           " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{
             RowBox[{"Factor", "[", 
              RowBox[{
               RowBox[{
               "composeSeriesSum", "[", "\"\<\[Kappa]-Minkowski\>\"", "]"}], 
               " ", "-", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                 "composeSeriesSum", "[", "\"\<\[Kappa]-Minkowski\>\"", "]"}],
                  " ", "/.", " ", "composeSwap"}], ")"}]}], "]"}], " ", "/.", 
             " ", "composeShow"}], "]"}]}], "}"}], "]"}], ",", "\n", "     ", 
        
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<grouping, exact, \[Alpha], \[Beta], \[Gamma] = \>\"", ",",
            " ", 
           RowBox[{"Row", "[", 
            RowBox[{"composeTriple", ",", " ", "\"\<,  \>\""}], "]"}], ",", 
           " ", "\"\< in units 1/a or \[Kappa]:  (\[Alpha] \[CirclePlus] \
\[Beta]) \[CirclePlus] \[Gamma] \[Minus] \[Alpha] \[CirclePlus] (\[Beta] \
\[CirclePlus] \[Gamma]) = \>\"", ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"composeAssoc", "[", 
              RowBox[{"\"\<Snyder\>\"", ",", " ", 
               RowBox[{"composeA", " ", "->", " ", "1"}], ",", " ", 
               RowBox[{"Sequence", " ", "@@", " ", "composeTriple"}]}], "]"}],
              ",", " ", "2"}], "]"}], ",", " ", "\"\< (Snyder),  \>\"", ",", 
           " ", 
           RowBox[{"composeAssoc", "[", 
            RowBox[{"\"\<\[Kappa]-Minkowski\>\"", ",", " ", 
             RowBox[{"composeK", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"Sequence", " ", "@@", " ", "composeTriple"}]}], "]"}], ",",
            " ", "\"\< (\[Kappa]-Minkowski)\>\""}], "}"}], "]"}], ",", "\n", 
        "     ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Values", "[", "composeChecks", "]"}], ",", " ", 
            "TrueQ"}], "]"}], ",", 
          " ", "\"\<checks passed: the 5\[Times]5 matrices obey Snyder's \
relations, the 2\[Times]2 product gives the exact \[Kappa] sum, both exact \
sums match their series, and a spatial Snyder momentum wraps around\>\"", ",",
           "\n", "      ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<checks failed: \>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{
               RowBox[{"Keys", "[", 
                RowBox[{"Select", "[", 
                 RowBox[{
                  RowBox[{"Association", "[", "composeChecks", "]"}], ",", 
                  " ", 
                  RowBox[{"Not", " ", "@*", " ", "TrueQ"}]}], "]"}], "]"}], ",",
                " ", "\"\<, \>\""}], "]"}]}], "}"}], "]"}]}], "]"}]}], "}"}], 
      "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[146]:= ",
 CellID->1357301499,ExpressionUUID->"5afd479a-4770-fd1d-5e56-a3887e794221"],

Cell[TextData[{
 "The deformed sum moves away from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "+", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28af3858-6678-1422-3ae8-9b2357abfe4e"],
 " in both spacetimes, more so at larger ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1289dd9f-623b-4e52-1b4b-f3f6a1876c01"],
 ", and in both it depends on which momentum comes first. In Snyder's \
spacetime the two orders split by ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "2"], "(", 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Alpha]", "TI"], "2"], 
    StyleBox["\[Beta]", "TI"], "-", 
    SuperscriptBox[
     StyleBox["\[Beta]", "TI"], "2"], 
    StyleBox["\[Alpha]", "TI"], "+", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Alpha]", "TI"], "\[CenterDot]", 
     StyleBox["\[Beta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Beta]", "TI"], "-", 
     StyleBox["\[Alpha]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ec6970a-919b-a5bd-14a0-9147f1d3aac1"],
 ", cubic in the momenta and zero when they are parallel: the order is \
recorded in the Lorentz factor that the product leaves behind. In ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a9eb33-c477-f93c-6e57-a891fdbd653b"],
 "-Minkowski spacetime the split is already quadratic, a spatial term \
proportional to ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "0"], 
   SubscriptBox[
    StyleBox["\[Beta]", "TI"], 
    StyleBox["j", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["j", "TI"]], 
   SubscriptBox[
    StyleBox["\[Beta]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "059f6aa3-2c23-a642-0bda-c66734aec6a2"],
 ". The exact ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64135170-29dc-6bb9-1df8-e8cddc60c890"],
 "-Minkowski sums sit on the fourth-order points; the exact Snyder sums begin \
to separate from theirs at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "0.6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77c43af5-e799-d53c-4404-0f521faebb80"],
 " and clearly leave them at the largest ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "758b4e57-914f-2fbc-70e2-88d4a2858200"],
 ", where the momenta approach ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db769e3-562c-06e6-3624-20700ef35faa"],
 " and the fifth-order term is no longer small. Grouping separates the two: \
adding three momenta in Snyder's spacetime depends on which pair is added \
first, because its momentum space is de Sitter space, a coset rather than a \
group, while in ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "778fc088-4cce-3b0c-74d8-988199773aed"],
 "-Minkowski spacetime the momenta form a group and the grouping does not \
matter."
}], "Text",
 CellID->1858156099,ExpressionUUID->"0686435d-272b-a932-161e-2578c417dc6e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->476358016,ExpressionUUID->"4f2fa2a1-e3a7-676c-2a3b-f06be7e10cd6"],

Cell["Determinant and trace rules proved at symbolic dimension", "Subsection",
 CellID->1540771155,ExpressionUUID->"3d16bd13-c936-b79f-509f-a2d3abf1c9bf"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13a9d81e-63b4-e557-758e-f98993a0394c"],
 " and ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49ca9e2e-1d78-f692-2a85-a028bd6253e0"],
 " are arbitrary complex ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Times]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2018a988-106c-2d70-738f-08d14a83f492"],
 " matrices, and ",
 Cell[BoxData[
  StyleBox["K", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106df773-7eda-d062-3f9a-99594ad0c41c"],
 " is an arbitrary ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "\[Times]", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43d7852f-9da8-b050-1599-7ef6f4966ece"],
 " matrix acting on a second system of ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65b365cc-ef27-021e-06c6-18f38f4014c1"],
 " levels; no entry and no value of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68b29c9a-861f-b2f3-03d5-42e96035c28c"],
 " or ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03339ca2-e824-16d6-2986-e64cec8feba1"],
 " is given. Which of the textbook determinant and trace rules can be proved \
for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a254310-0f89-0530-3715-4d2be16abb99"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b5b47eb-b34d-bf07-544f-2b9971ae13dd"],
 " at once?"
}], "Text",
 CellID->843688836,ExpressionUUID->"0943bc93-cfdb-2c3b-7fc4-e272f846d7ae"],

Cell["The candidates are", "Text",
 CellID->1628475048,ExpressionUUID->"6d9af88d-dfd0-adf3-7fb1-379a14bc617b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox[
     RowBox[{"A", "B"}], "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["A", "TI"], "\[ThinSpace]", 
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["B", "TI"]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["det",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["A", "TI"]]}], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["Tr",
       FontSlant->"Plain"], 
      StyleBox["A", "TI"]}]]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["Tr",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["B", "TI"], 
       StyleBox["A", "TI"], 
       SuperscriptBox[
        StyleBox["B", "TI"], 
        RowBox[{"-", "1"}]]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["A", "TI"]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox[
       RowBox[{"A", "B"}], "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["B", "TI"], 
      RowBox[{"-", "1"}]], 
     SuperscriptBox[
      StyleBox["A", "TI"], 
      RowBox[{"-", "1"}]]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   
   RowBox[{
    RowBox[{
     StyleBox["det",
      FontSlant->"Plain"], "\[ThinSpace]", 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["A", "TI"], "\[CircleTimes]", 
       StyleBox["K", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["det",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["A", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["m", "TI"]], 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["det",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["K", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["n", "TI"]]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["Tr",
      FontSlant->"Plain"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["A", "TI"], "\[CircleTimes]", 
       StyleBox["K", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["A", "TI"], "\[ThinSpace]", 
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["K", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1735747402,ExpressionUUID->"33885699-7b91-6b68-19ad-513e6a335c4f"],

Cell[TextData[{
 "and two rules that are false in general, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["A", "TI"], "+", 
    StyleBox["B", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["A", "TI"], "+", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["B", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444c6352-6a46-1448-0b9f-7e1aa2a81581"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["A", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["A", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48d73ff2-b865-2c26-0ae6-d5352450a9ab"],
 "."
}], "Text",
 CellID->1813316348,ExpressionUUID->"7959f344-e5f7-a879-1801-cf145de594c4"],

Cell[TextData[{
 "Each column tries to reduce the difference of the two sides to zero, with \
index symmetries only, then with the matrix-algebra identities by expansion \
and by simplification, all at general ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fa1c8c-96d2-62d7-3d58-6857f0cfd5dc"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c70342-3f85-367c-7868-87fbd6254880"],
 "; the last column substitutes random complex matrices for every ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "2"}], ",", 
   RowBox[{"3", ",", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12772ce2-be08-982a-0ecf-56fafe820ed3"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", "2"}], ",", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf23766-0f74-3a46-62f4-2f1d50b18df9"],
 ":"
}], "Text",
 CellID->104451779,ExpressionUUID->"1967047d-021b-da32-06f9-b4d7d3372d00"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"matIdDims", " ", "=", " ", 
   RowBox[{
    RowBox[{"matIdA", " ", "\[Element]", " ", 
     RowBox[{"Matrices", "[", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n"}], "}"}], "]"}]}], " ", "&&", " ", 
    RowBox[{"matIdB", " ", "\[Element]", " ", 
     RowBox[{"Matrices", "[", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n"}], "}"}], "]"}]}], " ", "&&", " ", 
    RowBox[{"matIdK", " ", "\[Element]", " ", 
     RowBox[{"Matrices", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "m"}], "}"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"matIdRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<det(AB) = det A det B\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{"matIdA", " ", ".", " ", "matIdB"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Det", "[", "matIdA", "]"}], " ", 
         RowBox[{"Det", "[", "matIdB", "]"}]}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<det exp(A) = exp(Tr A)\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{"MatrixExp", "[", "matIdA", "]"}], "]"}], " ", "-", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"Tr", "[", "matIdA", "]"}], "]"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Tr(B A \>\"", ",", " ", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<B\>\"", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}], ",", " ", "\"\<) = Tr A\>\""}], 
         "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"matIdB", " ", ".", " ", "matIdA", " ", ".", " ", 
          RowBox[{"Inverse", "[", "matIdB", "]"}]}], "]"}], " ", "-", " ", 
        RowBox[{"Tr", "[", "matIdA", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<(AB)\>\"", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<B\>\"", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}], ",", " ", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<A\>\"", ",", " ", 
            RowBox[{"-", "1"}]}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Inverse", "[", 
         RowBox[{"matIdA", " ", ".", " ", "matIdB"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Inverse", "[", "matIdB", "]"}], " ", ".", " ", 
         RowBox[{"Inverse", "[", "matIdA", "]"}]}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<det(A \[CircleTimes] K) = \>\"", ",", " ", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<(det A)\>\"", ",", " ", "\"\<m\>\""}], "]"}], ",", 
          " ", 
          RowBox[{"Superscript", "[", 
           RowBox[{"\"\<(det K)\>\"", ",", " ", "\"\<n\>\""}], "]"}]}], "}"}],
         "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"matIdA", ",", " ", "matIdK"}], "]"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", "matIdA", "]"}], "^", "m"}], " ", 
         RowBox[{
          RowBox[{"Det", "[", "matIdK", "]"}], "^", "n"}]}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Tr(A \[CircleTimes] K) = Tr A Tr K\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"matIdA", ",", " ", "matIdK"}], "]"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Tr", "[", "matIdA", "]"}], " ", 
         RowBox[{"Tr", "[", "matIdK", "]"}]}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<det(A + B) = det A + det B\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{"matIdA", " ", "+", " ", "matIdB"}], "]"}], " ", "-", " ", 
        RowBox[{"Det", "[", "matIdA", "]"}], " ", "-", " ", 
        RowBox[{"Det", "[", "matIdB", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Tr exp(A) = exp(Tr A)\>\"", ",", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"MatrixExp", "[", "matIdA", "]"}], "]"}], " ", "-", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"Tr", "[", "matIdA", "]"}], "]"}]}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"matIdZeroQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MatchQ", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"0", " ", "|", " ", "_SymbolicZerosArray"}]}], "]"}], ",", 
      " ", "\"\<0\>\"", ",", " ", "\"\<not 0\>\""}], "]"}], " ", "&"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"matIdNumericQ", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"expr", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n", " ", "->", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
              RowBox[{"m", " ", "->", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
              RowBox[{"matIdA", " ", "->", " ", 
               RowBox[{"RandomComplex", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "1"}], " ", "-", " ", "I"}], ",", " ", 
                   RowBox[{"1", " ", "+", " ", "I"}]}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
              " ", 
              RowBox[{"matIdB", " ", "->", " ", 
               RowBox[{"RandomComplex", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "1"}], " ", "-", " ", "I"}], ",", " ", 
                   RowBox[{"1", " ", "+", " ", "I"}]}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
              "\n", "          ", 
              RowBox[{"matIdK", " ", "->", " ", 
               RowBox[{"RandomComplex", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "1"}], " ", "-", " ", "I"}], ",", " ", 
                   RowBox[{"1", " ", "+", " ", "I"}]}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
             "}"}]}], "]"}], "]"}], " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], " ", "&"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"matIdZeroQ", "[", 
          RowBox[{"TensorReduce", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
            RowBox[{"Assumptions", " ", "->", " ", "matIdDims"}]}], "]"}], 
          "]"}], ",", " ", 
         RowBox[{"matIdZeroQ", "[", 
          RowBox[{"ArrayExpand", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", "matIdDims"}], "]"}], 
          "]"}], ",", "\n", "      ", 
         RowBox[{"matIdZeroQ", "[", 
          RowBox[{"ArraySimplify", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", "matIdDims"}], "]"}], 
          "]"}], ",", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"matIdNumericQ", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", " ", "\"\<holds\>\"",
            ",", " ", "\"\<fails\>\""}], "]"}]}], "}"}], " ", "&"}], " ", "/@",
       " ", "matIdRules"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<rule\>\"", ",", " ", "\"\<TensorReduce\>\"", ",", 
       " ", "\"\<ArrayExpand\>\"", ",", " ", "\"\<ArraySimplify\>\"", ",", 
       " ", "\"\<random matrices\>\""}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
      "Left", ",", " ", "Center", ",", " ", "Center", ",", " ", "Center", ",",
        " ", "Center"}], "}"}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}]}], ",", " ", 
   RowBox[{"BaseStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"14", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
     "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[147]:= ",
 CellID->649418927,ExpressionUUID->"373c79e6-c136-dd93-6d68-254a620156ec"],

Cell[TextData[{
 "Index symmetries alone settle only the trace of a Kronecker product, which \
is a pure index contraction. The matrix-algebra identities prove all six true \
rules for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a1bb9b-0f50-10cd-551f-8e9ef81058e3"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ef527b4-2490-7616-65b0-a5ec5a4c18b7"],
 ", and leave the two false rules standing, as the random matrices confirm."
}], "Text",
 CellID->860068542,ExpressionUUID->"1730673b-3097-44e6-7691-6aebfe860924"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->871533088,ExpressionUUID->"050667cd-e803-cf68-0f5e-5c265e9d1541"],

Cell["Energies of all-to-all exchange from Young diagrams", "Subsection",
 CellID->815336751,ExpressionUUID->"411f973c-b689-ffcb-0051-42e2883a9544"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34682a30-9b0b-27b2-4cc1-65c90d990db8"],
 " identical sites, each with ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bd33c83-00de-86a7-5ddd-f1acb3fd6112"],
 " levels, are coupled pairwise by the exchange ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["P", "TI"], "^"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02ac03f3-520c-2eb7-3a68-417870508c67"],
 ", which swaps the states of sites ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf4609c-9391-0517-0a3e-c8bf9aa88f61"],
 " and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7acf5d67-2a05-9ec1-7d2f-61f9c99e833e"],
 ", with one coupling ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f2c2411-86a4-bee1-1baa-7e9df93fc7da"],
 " for every pair; for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70c93268-b9cd-03cf-7c89-521a1dd6517e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     OverscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"], 
     StyleBox["i", "TI"]], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      OverscriptBox[
       StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11ec89ca-db25-1036-2419-c4faebdc0262"],
 " is the Heisenberg exchange. What are the energies and their degeneracies \
for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70c6db08-2937-2fe9-46f1-a78fcb7be502"],
 " and ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23bf07ac-cb9c-2bab-0e17-8a0d89f7c2e9"],
 "?"
}], "Text",
 CellID->866632833,ExpressionUUID->"56f8075f-c7b2-9651-35cb-816a16b67853"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    StyleBox["J", "TI"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->False], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["P", "TI"], "^"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "\[NonBreakingSpace]\[NonBreakingSpace]", 
    StyleBox["on",
     FontSlant->"Plain"], "\[NonBreakingSpace]\[NonBreakingSpace]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      SuperscriptBox["\:2102", 
       StyleBox["d", "TI"]], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{"\[CircleTimes]", 
      StyleBox["n", "TI"]}]], "=", 
    UnderscriptBox["\[CirclePlus]", 
     RowBox[{
      StyleBox["\[Lambda]", "TI"], "\[RightTee]", 
      StyleBox["n", "TI"]}],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["\[Lambda]", "TI"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["\[Lambda]", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["d", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->55903006,ExpressionUUID->"49ceb8e4-acc8-e47f-04ab-50c696dc5e5d"],

Cell[TextData[{
 "where the sum runs over Young diagrams ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "765d92ed-2070-951d-7f34-6cb61deb551c"],
 " with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68970ac4-1a80-2876-2453-784e5f41bfdb"],
 " boxes (Schur-Weyl duality): ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb8f286-af3f-eb82-0722-b78d20d76f67"],
 " carries the permutations of the sites, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["dim",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["\[Lambda]", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["\[Lambda]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45d573a8-3fe0-8cc0-36a9-fbfa07fea04f"],
 " standard tableaux, and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cdd179-c347-3b5a-56b0-f26e8e8700f6"],
 " the common unitaries ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["U", "TI"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "025fbd5a-e3b0-9209-1222-14791ddf0980"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["dim",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74617d60-e366-0bec-06f3-19fb6614d0a0"],
 ", a polynomial in ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "208dd328-c419-ae57-21be-1945be4fea57"],
 " that vanishes when ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "680bf17b-a4e0-bd68-09a7-f0b8ab66859a"],
 " has more than ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a5fc1cd-47bb-ee07-4790-e2fa17bdd95c"],
 " rows. The sum of all transpositions acts on block ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4943f4ef-c52c-ab58-0d5c-8b33be54520e"],
 " as its content sum, so"
}], "Text",
 CellID->314711024,ExpressionUUID->"553f9a7d-81f5-a1fa-2fd0-105b31a33485"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["\[Lambda]", "TI"]], "=", 
    StyleBox["J", "TI"], "\[ThinSpace]", 
    StyleBox["c", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Lambda]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["c", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Lambda]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["r", "TI"], ",", 
        StyleBox["k", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1], "\[Element]", 
       StyleBox["\[Lambda]", "TI"]}],
      LimitsPositioning->False], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["k", "TI"], "-", 
       StyleBox["r", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox[
     RowBox[{
     "block", "\[NonBreakingSpace]", "dimension", "\[NonBreakingSpace]"}],
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["\[Lambda]", "TI"]], 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["\[Lambda]", "TI"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["d", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1645444745,ExpressionUUID->"45a7d39e-39c3-5e38-6597-a25026196046"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], ",", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42beffae-e182-1db4-11df-38edfd9a0e5d"],
 " the row and column of each box. The degeneracy of a level ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], "=", 
   StyleBox["J", "TI"], 
   StyleBox["c", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30ff62f0-82a8-ff72-2fbf-744513e42288"],
 " is the sum of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef1d94c-d426-fc61-7689-55fa8d8f1b23"],
 " over all diagrams with content sum ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfb17b5-7717-49aa-6a37-c5bb4f740f5e"],
 "; up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "253a7c7c-ba3d-5fb5-3415-e37dcc377208"],
 " every diagram has its own content sum, and the first coincidences come at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f91da19-a12f-a4c2-68bf-de9ee29a9da8"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", ",", "1", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["c", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", ",", "3"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0930e3df-6502-26b2-1a55-cc35e7bed4c8"],
 " and, for the conjugate diagrams, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", ",", "1", ",", "1", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["c", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", ",", "2", ",", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72928984-1760-cbdc-4a97-c321b2aa164c"],
 "."
}], "Text",
 CellID->1405570184,ExpressionUUID->"3ddb35b4-68e1-19c9-6552-d7a364a3fbe2"],

Cell[TextData[{
 "The figure plots each predicted level, with degeneracy ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad17d14-2019-5040-403b-aadcb953574a"],
 ", against the eigenvalues of the ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["n", "TI"]], "\[Times]", 
   SuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40e256a6-b4cb-cc26-5f32-8bac3ff32010"],
 " matrix of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08fc461a-6993-ee16-553c-d9d21042cccf"],
 " built from qudit SWAPs, energies in units of ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0442cf12-448b-db32-0b51-2c137956917e"],
 ", with the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "318d1cb0-6c59-2810-7e10-b4d5ff307fe6"],
 " levels for general ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0db6ee-db57-7f8d-6516-15e602cb5013"],
 ":"
}], "Text",
 CellID->2074539045,ExpressionUUID->"2ad28808-ed48-9fb0-3e9a-2c0ca63881c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permSumContent", "[", "\[Lambda]_", "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"k", " ", "-", " ", "r"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"Length", "[", "\[Lambda]", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"\[Lambda]", "[", 
          RowBox[{"[", "r", "]"}], "]"}]}], "}"}]}], "]"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permSumLevels", "[", 
    RowBox[{"nn_", ",", " ", "dd_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"permSumContent", "[", "#", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"TableauDimension", "[", "#", "]"}], " ", 
          RowBox[{"SchurDimension", "[", 
           RowBox[{"#", ",", " ", "dd"}], "]"}]}]}], "}"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"IntegerPartitions", "[", "nn", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Last", "[", "#", "]"}], " ", ">", " ", "0"}], " ", "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permSumEigen", "[", 
    RowBox[{"nn_", ",", " ", "dd_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"permSumEigen", "[", 
     RowBox[{"nn", ",", " ", "dd"}], "]"}], " ", "=", " ", 
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"N", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{
             RowBox[{"\"\<SWAP\>\"", "[", "dd", "]"}], ",", " ", "#"}], "]"}],
            " ", "&"}], " ", "/@", " ", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"Range", "[", "nn", "]"}], ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "[", "\"\<Matrix\>\"", 
        "]"}], "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permSumNumeric", "[", 
    RowBox[{"nn_", ",", " ", "dd_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Tally", "[", 
    RowBox[{"Round", "[", 
     RowBox[{"permSumEigen", "[", 
      RowBox[{"nn", ",", " ", "dd"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permSumPanel", "[", 
    RowBox[{"dd_", ",", " ", "nn_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"permSumLevels", "[", 
        RowBox[{"nn", ",", " ", "dd"}], "]"}], ",", " ", 
       RowBox[{"permSumNumeric", "[", 
        RowBox[{"nn", ",", " ", "dd"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", " ", "->", " ", "Axis"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "9"}], "}"}], ",", " ", 
        
        RowBox[{"{", 
         RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "20"}], "}"}]}], "}"}]}],
      ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<J c(\[Lambda]), \>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<f\>\"", ",", " ", "\"\<\[Lambda]\>\""}], "]"}], ",", 
           " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<s\>\"", ",", " ", "\"\<\[Lambda]\>\""}], "]"}], ",", 
           " ", "\"\<(d)\>\""}], "}"}], "]"}], ",", 
        " ", "\"\<eigenvalues of H\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", "nn"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nn", " ", "-", " ", "1"}], ")"}], "/", "2"}]}], " ", "-",
            " ", "1"}], ",", " ", 
          RowBox[{
           RowBox[{"nn", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nn", " ", "-", " ", "1"}], ")"}], "/", "2"}]}], " ", "+",
            " ", "1"}]}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.06"}], ",", " ", "1.1"}], "}"}], " ", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"permSumLevels", "[", 
            RowBox[{"nn", ",", " ", "dd"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], "}"}]}], 
     ",", "\n", "   ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<E / J\>\"", ",", " ", "\"\<degeneracy\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<d = \>\"", ",", " ", "dd", ",", " ", "\"\<,   n = \>\"", 
         ",", " ", "nn"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"permSumPanels", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"permSumPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"permSumLabel", " ", "=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Lambda] = \>\"", ",", " ", "#", ",", 
             " ", "\"\<:   E = \>\"", ",", " ", 
             RowBox[{"permSumContent", "[", "#", "]"}], ",", 
             " ", "\"\< J,   degeneracy \>\"", ",", " ", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"Factor", "[", 
               RowBox[{
                RowBox[{"TableauDimension", "[", "#", "]"}], " ", 
                RowBox[{"SchurDimension", "[", 
                 RowBox[{"#", ",", " ", "d"}], "]"}]}], "]"}], "]"}]}], "}"}],
            "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"IntegerPartitions", "[", "4", "]"}]}], ",", "\n", "     ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<every eigenvalue within \>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"10", ",", " ", 
             RowBox[{"-", "8"}]}], "]"}], ",", 
           " ", "\"\< J of an integer: \>\"", ",", " ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#", " ", "-", " ", 
                 RowBox[{"Round", "[", "#", "]"}]}], "]"}], " ", "&"}], "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Outer", "[", 
                RowBox[{"permSumEigen", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "]"}],
                "]"}], "]"}], "]"}], " ", "<", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}]}], "}"}], "]"}]}], "]"}], "]"}], ",", " ",
      "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{"{", 
         RowBox[{"First", " ", "/@", " ", 
          RowBox[{"permSumPanels", "[", "dd", "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"legendBelow", "[", 
        RowBox[{"Last", "[", 
         RowBox[{
          RowBox[{"permSumPanels", "[", "2", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
     "permSumLabel", ",", " ", "Top"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dd", ",", " ", "3", ",", " ", "\"\<d\>\""}], "}"}], ",", " ", 
     RowBox[{"Keys", "[", "permSumPanels", "]"}], ",", " ", "SetterBar"}], 
    "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[148]:= ",
 CellID->1151659221,ExpressionUUID->"6c9a8480-0274-67e4-34f3-6ef6abcdeef3"],

Cell[TextData[{
 "Every eigenvalue of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ede44b0-7c83-9201-7412-f9ba5be317e5"],
 " sits on a predicted level with the predicted degeneracy, in every panel. A \
level exists only when its diagram fits in ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f6f1d2c-780b-de46-61fe-1b5671790720"],
 " rows, so the most negative energies appear one at a time as ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13bdacca-ed99-3355-0640-0413546df698"],
 " grows, the fully antisymmetric level ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["n", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3edb3939-4f68-9f15-68da-788101adc60f"],
 " only once ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[GreaterEqual]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46a73a6a-f90a-c20a-531f-a68742924c8d"],
 ". The degeneracy of a diagram with ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bcd4152-62ad-8305-36bc-e9774b97924c"],
 " rows carries the factors ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["d", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterEllipsis]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["d", "TI"], "-", 
    StyleBox["r", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e509b-4c96-583f-0175-7e28ef220cf9"],
 ", so it vanishes for every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "<", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c91b19-2d2c-bb23-5dd9-9dd0c92aa1f6"],
 "."
}], "Text",
 CellID->1678738166,ExpressionUUID->"65652417-f4a1-f526-59c2-69066d85d255"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1991278892,ExpressionUUID->"205c5b19-c392-ea13-0fd1-9290832af114"],

Cell["Pulses and hardware models", "Section",
 CellID->364515716,ExpressionUUID->"190b5b76-6259-99e3-226b-20fab75eac71"],

Cell["\<\
The examples in this section model superconducting qubits as hardware. A \
transmon is an anharmonic oscillator, so a fast \[Pi] pulse leaks into its \
third level unless a DRAG correction is added; two coupled transmons make a \
CZ gate; pulse area sets the rotation; the dispersive readout separates two \
pointer states; and the qubit frequency depends on the offset charge less and \
less as the Josephson energy grows. QF evolves the pulse Hamiltonians, the \
TransmonLab and QUALink paclets supply readout models and pulse programs, and \
WL's Mathieu functions give the exact transmon spectrum.\
\>", "Text",
 CellID->2122064086,ExpressionUUID->"00b73336-75e3-1006-3a68-b55982a8f9c3"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2006241611,ExpressionUUID->"6f430288-40f9-b26c-5c1e-52c3da4cefd8"],

Cell["Leakage of a fast \[Pi] pulse on a transmon", "Subsection",
 CellID->2022313249,ExpressionUUID->"2225b359-bab8-dba4-2b6f-50ff0440a6ac"],

Cell[TextData[{
 "A transmon is an anharmonic oscillator, frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46c1053b-a571-232f-5518-15d31d9b7e4a"],
 " and anharmonicity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3131def4-0e15-b55e-1c92-18f305599711"],
 ", so its ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"1"},
    "Ket"], "\[Rule]", 
   TemplateBox[{"2"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2844fbf6-1a1c-468e-4654-fa2868bf4763"],
 " transition sits only ",
 Cell[BoxData[GridBox[{
    {
     StyleBox["\[Alpha]", "TI"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59385738-20fc-91f3-288d-805c52146741"],
 " below the qubit transition. A \[Pi] pulse of length ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b8fb7c2-e1be-ba0f-6a75-526d9e390d7a"],
 ", detuned by ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48e1b293-62ce-dfeb-5fe4-69a0a81c70c6"],
 " from the qubit, is meant to flip ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ba04ccf-9e90-12e6-559f-dcba4de98a50"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bf88a30-6fec-62d8-2fbf-4571e6a8486e"],
 ", and a DRAG term of strength ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00562f47-de25-b250-5c41-0f2702fa76a2"],
 " adds a second quadrature that follows the slope of the envelope. Where \
does the population end up after the pulse: outside the qubit, or left in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e17776d-61a1-92d8-0e72-a387a2c8819b"],
 "?"
}], "Text",
 CellID->1489239007,ExpressionUUID->"04cc8b15-3d6b-ee9a-7731-f0a7de1e6339"],

Cell[TextData[{
 "With ",
