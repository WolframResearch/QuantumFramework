    FontSize->1.15 Inherited], 
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Omega]", "t"}], "TI"]], 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c6f7286-0dd7-1d0b-3f43-663de2f918d6"],
 ", the transform of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["I", "TI"], "."]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "673742fc-42a9-45ca-315a-0e75e03a926f"],
 " is ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["\[Omega]", "TI"], 
   OverscriptBox[
    StyleBox["I", "TI"], "~"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6092b21e-0587-607a-399f-d4ec08644390"],
 ", so the complex envelope has"
}], "Text",
 CellID->71717134,ExpressionUUID->"0ff75583-47b8-636d-2389-376b7e0bf5b2"],

Cell[BoxData[
