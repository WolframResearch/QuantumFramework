  StyleBox["u", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "637d0ca2-de27-548f-25de-eb6d7f772f5c"],
 " switched between its two values whenever the switching condition is met, \
against the constant drive ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f5bf764-d6a6-9bac-0357-e301b5ba4747"],
 " (dashed); time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65d63cc7-d551-dbc2-2d38-f2bd2c7e2c7d"],
 ":"
}], "Text",
 CellID->694469191,ExpressionUUID->"06033641-d74e-562a-0f20-200f4d01548f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"controlRun", "[", 
    RowBox[{
    "\[CapitalOmega]_", ",", " ", "\[CapitalDelta]_", ",", " ", "p_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"controlX", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[CapitalDelta]"}], " ", 
          RowBox[{"controlY", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"controlX", "[", "t", "]"}], "/", "2"}]}]}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"controlY", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", " ", 
          RowBox[{"controlX", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"controlY", "[", "t", "]"}], "/", "2"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"controlU", "[", "t", "]"}], " ", 
          RowBox[{"controlZ", "[", "t", "]"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"controlZ", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"controlU", "[", "t", "]"}], " ", 
          RowBox[{"controlY", "[", "t", "]"}]}], " ", "-", " ", "1", " ", "-",
          " ", 
         RowBox[{"controlZ", "[", "t", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"controlX", "[", "0", "]"}], " ", "==", " ", "0"}], ",", " ", 
       
       RowBox[{
        RowBox[{"controlY", "[", "0", "]"}], " ", "==", " ", "0"}], ",", " ", 
       
       RowBox[{
        RowBox[{"controlZ", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{
        RowBox[{"controlU", "[", "0", "]"}], " ", "==", " ", 
        "\[CapitalOmega]"}], ",", "\n", "    ", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"controlZ", "[", "t", "]"}]}], ")"}], "/", "2"}], " ", ">",
           " ", 
          RowBox[{"p", " ", "+", " ", "0.02"}]}], ",", " ", 
         RowBox[{
          RowBox[{"controlU", "[", "t", "]"}], " ", "->", " ", "0"}]}], "]"}],
        ",", " ", 
       RowBox[{"WhenEvent", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"controlZ", "[", "t", "]"}]}], ")"}], "/", "2"}], " ", "<",
           " ", 
          RowBox[{"p", " ", "-", " ", "0.02"}]}], ",", " ", 
         RowBox[{
          RowBox[{"controlU", "[", "t", "]"}], " ", "->", " ", 
          "\[CapitalOmega]"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
     "controlZ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"DiscreteVariables", " ", "->", " ", 
      RowBox[{"{", "controlU", "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"controlConstant", "[", 
    RowBox[{"\[CapitalOmega]_", ",", " ", "\[CapitalDelta]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Re", " ", "@", " ", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
           RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", 
          " ", 
          RowBox[{
           RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
           RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], "}"}], " ", "->",
           " ", 
          RowBox[{"{", "1", "}"}]}], ",", "\n", "    ", 
         RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
       "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"controlPanel", "[", 
    RowBox[{"\[CapitalOmega]_", ",", " ", "\[CapitalDelta]r_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ps", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0.6", ",", " ", "0.75", ",", " ", "0.9"}], "}"}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "+", " ", 
               RowBox[{
                RowBox[{"controlRun", "[", 
                 RowBox[{"\[CapitalOmega]", ",", " ", 
                  RowBox[{"\[CapitalDelta]r", " ", "\[CapitalOmega]"}], ",", 
                  " ", "#"}], "]"}], "[", "t", "]"}]}], ")"}], "/", "2"}], 
            " ", "&"}], " ", "/@", " ", "ps"}], ",", " ", 
          RowBox[{"controlConstant", "[", 
           RowBox[{"\[CapitalOmega]", ",", " ", 
            RowBox[{"\[CapitalDelta]r", " ", "\[CapitalOmega]"}]}], "]"}]}], 
         "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}], ",", "\n", 
       "      ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
          
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", " ", 
       
       RowBox[{"PlotPoints", " ", "->", " ", "400"}], ",", " ", 
       RowBox[{"MaxRecursion", " ", "->", " ", "0"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", "\n", "      ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<p = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
            "&"}], " ", "/@", " ", "ps"}], ",", 
          " ", "\"\<constant drive\>\""}], "]"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Gamma] t\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<P\>\"", ",", " ", "\"\<e\>\""}], "]"}]}], "}"}]}], ",",
        "\n", "      ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[CapitalDelta]/\[CapitalOmega] = \>\"", ",", " ", 
           "\[CapitalDelta]r"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"controlPanels", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "15", ",", " ", "40"}], "}"}], ",", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"controlPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "15", ",", " ", "40"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.5"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", 
         RowBox[{"controlPanels", "[", "\[CapitalOmega]", "]"}]}], "}"}], ",",
        " ", 
       RowBox[{"ImageSize", " ", "->", " ", "600"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{
        RowBox[{"controlPanels", "[", "5", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalOmega]", ",", " ", "15", ",", 
       " ", "\"\<\[CapitalOmega]/\[Gamma]\>\""}], "}"}], ",", " ", 
     RowBox[{"Keys", "[", "controlPanels", "]"}], ",", " ", "SetterBar"}], 
    "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[16]:= ",
 CellID->732065401,ExpressionUUID->"24cafb8a-8a75-ee0c-00da-511ffbed1584"],

Cell[TextData[{
 "Without detuning, a drive that overshoots the band is held inside it, above \
",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c57946b-f53e-03bb-4024-894862cb33a9"],
 ", for a time that shortens as the target rises, after which ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e6e6-28e4-9606-19ca-bfdc3d668f4a"],
 " oscillates about ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "307f71e8-a38e-5fc1-1852-44ce83f7691c"],
 " as under constant drive; a drive whose peak barely reaches the band is \
only clipped once, and one that never reaches it gives the constant-drive \
curve. With ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "/", "\[CapitalOmega]", "=", "0.5"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db69efd-27a5-9c5c-3aa8-d26de1c3c6c9"],
 " the tilted axis keeps ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fbb7796-bb70-3bbb-7c66-7cbeb347a467"],
 " below ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "+", 
    SuperscriptBox["\[CapitalDelta]", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ccd7ce5-5b2e-9518-33e1-8138dbffeba8"],
 "; the switching clips only the first peaks, then the oscillation decays \
below every band."
}], "Text",
 CellID->445277513,ExpressionUUID->"2cdd02d2-1931-950b-2016-1ce83f69dc5d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->724145374,ExpressionUUID->"0f3f454c-d01e-a6fd-5044-51f55add312f"],

Cell["A cavity mode thermalizes", "Subsection",
 CellID->1893161544,ExpressionUUID->"438bfc79-f262-d50f-67c9-3e0999141ae8"],

Cell[TextData[{
 "A cavity mode of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a90d4f6-c16a-5d57-5ced-44a2676b24c1"],
 " exchanges photons with a bath at temperature ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f5da9bd-a6fa-5d6c-5290-4792f5306c91"],
 ": it loses photons at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox[
      RowBox[{"t", "h"}], "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37459457-f2f1-2fcf-73bf-b540f40390ad"],
 " and gains them at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox[
     RowBox[{"t", "h"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40774a1a-e810-e030-0fff-a9deaabf8838"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox[
     RowBox[{"t", "h"}], "TI"]], "=", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"\[HBar]", 
      StyleBox["\[Omega]", "TI"], "/", 
      SubscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["B", "TI"]], 
      StyleBox["T", "TI"]}]], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b476539-d012-123b-4e45-25bb7ef5fe5d"],
 ". Does the bath fix only the mean photon number, or the whole state of the \
field?"
}], "Text",
 CellID->364502057,ExpressionUUID->"7f33d8fe-a26e-11bf-4b69-63700bcf4ec1"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f8b8ed0-2752-44f0-5f16-69ede144e433"],
 " the Hamiltonian is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417ef199-c730-1e84-1ee7-f51cbcdcb440"],
 ", and the Lindblad equation is"
}], "Text",
 CellID->245921084,ExpressionUUID->"33e32f60-cc74-af16-5a4a-eac9de577518"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["\[Omega]", "TI"], "\[ThinSpace]", 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], 
      OverscriptBox[
       StyleBox["a", "TI"], "^"]}], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["n", "TI"], 
      StyleBox[
       RowBox[{"t", "h"}], "TI"]], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox[
      RowBox[{"t", "h"}], "TI"]], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->912608870,ExpressionUUID->"0b5acb92-1560-f3e0-4c36-6bb85e6bb526"],

Cell[TextData[{
 "In the frame rotating at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dc7536f-ac0b-d9a5-0308-fbde709bb4f3"],
 " the Hamiltonian drops out and the two dissipators stay as they are. A \
steady state must balance the flow from ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42da3d16-184d-cf77-734e-e0d5329e6aba"],
 " down to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1332a694-04ac-b232-5332-40adfa349355"],
 " against the flow back up, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox[
      RowBox[{"t", "h"}], "TI"]], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["n", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], "=", 
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox[
     RowBox[{"t", "h"}], "TI"]], "\[ThinSpace]", 
   StyleBox["n", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    RowBox[{
     StyleBox["n", "TI"], "-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a047837-cf46-e1c4-111e-2c967ed49984"],
 ", which fixes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SubsuperscriptBox[
    StyleBox["n", "TI"], 
    StyleBox[
     RowBox[{"t", "h"}], "TI"], 
    StyleBox["n", "TI"]], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], 
       StyleBox[
        RowBox[{"t", "h"}], "TI"]], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07d1b1b9-f98c-9d04-0008-57ae5bec5387"],
 ". From the vacuum the mean grows as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox[
     RowBox[{"t", "h"}], "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["\[Kappa]", "TI"], 
      StyleBox["t", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bea6757-5515-d81d-2688-de101b18fe0f"],
 " and the distribution stays thermal at that mean."
}], "Text",
 CellID->1410349120,ExpressionUUID->"379f3620-e475-d0a0-654f-4465c5b5cebb"],

Cell[TextData[{
 "The figure starts the field in the vacuum ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17f205ca-94b0-32e7-6dda-b8e36cd3dda9"],
 ", the Fock state ",
 Cell[BoxData[
  TemplateBox[{"4"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519b3df1-4bd0-7fd2-160a-73e805b227c8"],
 " and the coherent state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Alpha]", "TI"], "=", "2"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "516c731b-9d85-c71c-74f6-480a884de942"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox[
     RowBox[{"t", "h"}], "TI"]], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4edd03e6-602f-9f1e-443e-12e7afc8147d"],
 " on 32 Fock levels. The top panel plots the trace distance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", 
   FractionBox["1", "2"], "\[ThinSpace]", GridBox[{
     {
      RowBox[{
       StyleBox["\[Rho]", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1], "-", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        StyleBox[
         RowBox[{"t", "h"}], "TI"]]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a80d946-cec9-e749-6907-2cc96752fe9d"],
 " to the thermal state, the largest difference any measurement could find \
between the two; the rows below show the Wigner function of each start at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], 
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a7947ce-db6b-573f-7029-621e5ec78748"],
 ", ",
 Cell[BoxData["0.5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6743d148-d770-68a0-6bc7-d02614e808e8"],
 ", ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d379dd1-37d1-0c2a-7468-1c0ce0b697e2"],
 " and ",
 Cell[BoxData["8"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24ec18a2-7730-0ac4-5fac-d9e33f5e688f"],
 ", red where it is positive and blue where it is negative:"
}], "Text",
 CellID->1167983258,ExpressionUUID->"44b13fc8-4889-107a-1b88-1ae26958ac5b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"thermLevels", ",", " ", "thermN", ",", " ", "thermTimes"}], 
    "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"32", ",", " ", "2", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.5", ",", " ", "2", ",", " ", "8"}], "}"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thermA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "thermLevels", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thermStarts", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<|0\[RightAngleBracket]\>\"", " ", "->", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{"0", ",", " ", "thermLevels"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<|4\[RightAngleBracket]\>\"", " ", "->", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{"4", ",", " ", "thermLevels"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<|\[Alpha] = 2\[RightAngleBracket]\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"CoherentState", "[", "thermLevels", "]"}], "[", "2.", 
       "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thermEvo", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"0", " ", 
        RowBox[{
         RowBox[{"SuperDagger", "[", "thermA", "]"}], " ", "@", " ", 
         "thermA"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"thermA", ",", " ", 
          RowBox[{"SuperDagger", "[", "thermA", "]"}]}], "}"}], " ", "->", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"thermN", " ", "+", " ", "1"}], ",", " ", "thermN"}], 
         "}"}]}], ",", " ", "#", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}], " ", 
     "&"}], " ", "/@", " ", "thermStarts"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thermRho", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"thermN", "^", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"thermLevels", " ", "-", " ", "1"}]}], "]"}]}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"thermN", " ", "+", " ", "1"}], ")"}], "^", 
      RowBox[{"Range", "[", "thermLevels", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"thermDistance", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]", " ", "+", " ", 
           RowBox[{"ConjugateTranspose", "[", "\[Rho]", "]"}]}], ")"}], "/", 
         "2"}], " ", "-", " ", "thermRho"}], "]"}], "]"}], "]"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thermDecay", " ", "=", " ", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"e", ",", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", ",", " ", 
            RowBox[{"thermDistance", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{
               RowBox[{"e", "[", "s", "]"}], "[", "\"\<DensityMatrix\>\"", 
               "]"}], "]"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "0", ",", " ", "8", ",", " ", "0.1"}], 
           "}"}]}], "]"}]}], "]"}], " ", "/@", " ", 
      RowBox[{"Values", "[", "thermEvo", "]"}]}], ",", "\n", "    ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "4"}]}], ",", " ", "1.2"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "0.8"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", "\n", "    ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Kappa] t\>\"", ",", 
        " ", "\"\<trace distance to \!\(\*SubscriptBox[\(\[Rho]\), \
\(th\)]\)\>\""}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<start \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
            "&"}], " ", "/@", " ", 
           RowBox[{"Keys", "[", "thermStarts", "]"}]}], ",", " ", 
          RowBox[{"LegendMarkerSize", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"14", ",", " ", "8"}], "}"}]}], ",", " ", 
          RowBox[{"LabelStyle", " ", "->", " ", "10"}], ",", " ", 
          RowBox[{"Spacings", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0.3", ",", " ", "0.1"}], "}"}]}], ",", "\n", "      ", 
          RowBox[{"LegendFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Framed", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
               RowBox[{"FrameStyle", " ", "->", " ", 
                RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
               RowBox[{"FrameMargins", " ", "->", " ", "2"}]}], "]"}], " ", 
             "&"}], ")"}]}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.03", ",", " ", "0.03"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"thermTile", "[", 
    RowBox[{"e_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"WignerFunction", "[", 
         RowBox[{
          RowBox[{"e", "[", "s", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "p"}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"DensityPlot", "[", 
      RowBox[{"w", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "5.01"}], ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "5.01"}], ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "40"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", "\n", 
       "      ", 
       RowBox[{"ColorFunction", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Blend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.2", ",", " ", "0.3", ",", " ", "0.8"}], "]"}], ",", 
              " ", "White", ",", " ", 
              RowBox[{"RGBColor", "[", 
               RowBox[{"0.85", ",", " ", "0.2", ",", " ", "0.15"}], "]"}]}], 
             "}"}], ",", " ", 
            RowBox[{"0.5", " ", "+", " ", 
             RowBox[{"0.5", " ", 
              RowBox[{"Sign", "[", "#", "]"}], " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"Min", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", "#", "]"}], "/", "0.32"}], ",", " ", 
                 "1"}], "]"}], "]"}]}]}]}], "]"}], " ", "&"}], ")"}]}], ",", 
       "\n", "      ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"FrameStyle", " ", "->", " ", 
        RowBox[{"GrayLevel", "[", "0.7", "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "90"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"thermDecay", ",", "\n", "   ", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{"Prepend", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"thermTile", "[", 
                 RowBox[{"e", ",", " ", "s"}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"e", ",", " ", 
                  RowBox[{"Values", "[", "thermEvo", "]"}]}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"s", ",", " ", "thermTimes"}], "}"}]}], "]"}], ",", 
              " ", 
              RowBox[{"Keys", "[", "thermStarts", "]"}]}], "}"}]}], "]"}], ",",
           "\n", "      ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<\[Kappa] t = \>\"", ",", " ", "#"}], "}"}], 
               "]"}], " ", "&"}], " ", "/@", " ", "thermTimes"}], ",", 
            " ", "\"\<\>\""}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"Spacings", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", " ", "0.5"}], "}"}]}]}], "]"}]}], "}"}], "}"}], 
   ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[17]:= ",
 CellID->371025263,ExpressionUUID->"244b94f0-5c02-d1a8-57d4-bb2de09649f6"],

Cell[TextData[{
 "Every start ends in the same thermal state: the trace distance falls \
exponentially toward zero, and every Wigner function becomes the same round \
Gaussian centered at the origin. The bath erases the whole initial state, not \
only its mean photon number. How fast depends on what must be erased: the \
vacuum and ",
 Cell[BoxData[
  TemplateBox[{"4"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf4ca0b-a024-b7d6-5633-7eea9e016ad5"],
 " differ from the thermal state only in their populations, which relax at \
rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c0b7f15-3a1e-228d-23ee-1a50b2c664b2"],
 ", while the coherent state also carries a displacement ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2104ec2e-4f49-8a45-69ff-920eb22d9cca"],
 ", which decays only as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Kappa]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a518eb6-4464-8f20-2078-26217455f4e3"],
 ", so its line falls at half the slope."
}], "Text",
 CellID->1970769953,ExpressionUUID->"043b2adc-5be9-e58a-3eb1-30380e8d70fb"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1458776515,ExpressionUUID->"0b15327f-f35e-37b6-3bae-c95997580236"],

Cell["A cat in a warm bath: Caldeira-Leggett decoherence", "Subsection",
 CellID->1284630344,ExpressionUUID->"4b546fc0-920f-cf78-4608-21520f62ca9f"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1451c2a1-f34c-7320-0b76-b461d8e20adc"],
 " in a trap of frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c6154f2-0481-32db-6ee5-5d8c3606ae80"],
 " couples to a bath at temperature ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425724da-6e7f-11d0-20bb-5a4f0d7ff26d"],
 " that damps its momentum at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21bb91c3-42e0-0b17-0c3f-133b093b0074"],
 ". It starts in a cat state, the superposition ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Alpha]", "TI"]},
    "Ket"], "+", 
   TemplateBox[{
     RowBox[{"-", 
       StyleBox["\[Alpha]", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71c98de5-9f69-8dd3-1b3b-629399056bd4"],
 " of two coherent states on either side of the trap. How fast does the bath \
turn it into a mixture of the two lobes?"
}], "Text",
 CellID->1097657070,ExpressionUUID->"52b38fc5-da66-6435-2076-a071454bcc8b"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5635d7cf-c382-3f97-122b-e2f2ddb8c8ff"],
 ", the high-temperature Caldeira-Leggett master equation is"
}], "Text",
 CellID->1763005307,ExpressionUUID->"47db946a-1a94-68db-6f3c-19a8510a2b33"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox[
        OverscriptBox[
         StyleBox["p", "TI"], "^"], "2"], 
       RowBox[{"2", 
        StyleBox["M", "TI"]}]], "+", 
      FractionBox["1", "2"], 
      StyleBox["M", "TI"], 
      SuperscriptBox["\[CapitalOmega]", "2"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["x", "TI"], "^"], "2"]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Gamma]", "TI"], "[", 
    RowBox[{
     OverscriptBox[
      StyleBox["x", "TI"], "^"], ",", 
     RowBox[{"{", 
      OverscriptBox[
       StyleBox["p", "TI"], "^"]}], ",", 
     RowBox[{
      StyleBox["\[Rho]", "TI"], "}"}]}], "]", "-", "2", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["M", "TI"], 
    SubscriptBox[
     StyleBox["k", "TI"], 
     StyleBox["B", "TI"]], 
    StyleBox["T", "TI"], "\[ThinSpace]", "[", 
    RowBox[{
     OverscriptBox[
      StyleBox["x", "TI"], "^"], ",", 
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["x", "TI"], "^"], ",", 
       StyleBox["\[Rho]", "TI"]}], 
      StyleBox["]",
       SpanMaxSize->1]}]}], "]", "-", 
    FractionBox[
     StyleBox["\[Gamma]", "TI"], 
     RowBox[{"8", 
      StyleBox["M", "TI"], 
      SubscriptBox[
       StyleBox["k", "TI"], 
       StyleBox["B", "TI"]], 
      StyleBox["T", "TI"]}]], "[", 
    RowBox[{
     OverscriptBox[
      StyleBox["p", "TI"], "^"], ",", 
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["p", "TI"], "^"], ",", 
       StyleBox["\[Rho]", "TI"]}], 
      StyleBox["]",
       SpanMaxSize->1]}]}], "]"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1115878925,ExpressionUUID->"30fdcaaa-0920-4a25-7cc3-0055aa306bec"],

Cell[TextData[{
 "where the last term, smaller than the others by a factor of order ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[CapitalOmega]", "/", 
     SubscriptBox[
      StyleBox["k", "TI"], 
      StyleBox["B", "TI"]], 
     StyleBox["T", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b01ae48-f0f5-4321-2256-9fb29d75b59e"],
 ", makes the generator a Lindblad generator. With jump operators ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a9227d-6d14-98e3-5519-da3c8965e4a2"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["p", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a78178f-4bdf-dc1d-3823-2b340d41d9c2"],
 " it takes the Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "+", 
    FractionBox[
     StyleBox["\[Gamma]", "TI"], "2"], "{", 
    OverscriptBox[
     StyleBox["x", "TI"], "^"]}], ",", 
   RowBox[{
    OverscriptBox[
     StyleBox["p", "TI"], "^"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0049fe35-1f8d-3a61-4f4d-c6481200a1f3"],
 " and the rate matrix ",
 Cell[BoxData[
  RowBox[{"(", GridBox[{
     {
      RowBox[{"4", 
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["M", "TI"], 
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["B", "TI"]], 
       StyleBox["T", "TI"]}], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["\[Gamma]", "TI"]}]},
     {
      StyleBox[
       RowBox[{"i", "\[Gamma]"}], "TI"], 
      RowBox[{
       StyleBox["\[Gamma]", "TI"], "/", "4", 
       StyleBox["M", "TI"], 
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["B", "TI"]], 
       StyleBox["T", "TI"]}]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21c9d47d-9b6d-2ac9-4feb-52730e201c80"],
 "."
}], "Text",
 CellID->2125569533,ExpressionUUID->"747df118-f769-c9b7-2bcc-4225708a752c"],

Cell[TextData[{
 "The equation is linear, so the difference between the cat and the mixture \
of its two lobes, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[CapitalDelta]", 
    StyleBox["\[Rho]", "TI"]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"c", "a", "t"}], "TI"]], "-", 
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"m", "i", "x"}], "TI"]]}], "\[Proportional]", 
    RowBox[{
     StyleBox["C", "TI"], "-", 
     RowBox[{
      StyleBox["s", "TI"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         TemplateBox[{
           StyleBox["\[Alpha]", "TI"]},
          "Ket"], 
         TemplateBox[{
           StyleBox["\[Alpha]", "TI"]},
          "Bra"]}], "+", 
        RowBox[{
         TemplateBox[{
           RowBox[{"-", 
             StyleBox["\[Alpha]", "TI"]}]},
          "Ket"], 
         TemplateBox[{
           RowBox[{"-", 
             StyleBox["\[Alpha]", "TI"]}]},
          "Bra"]}]}], ")"}]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd0aa9f-ee18-2f70-0db5-446363a91145"],
 ", with the cross term ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["\[Alpha]", "TI"]},
      "Ket"], 
     TemplateBox[{
       RowBox[{"-", 
         StyleBox["\[Alpha]", "TI"]}]},
      "Bra"]}], "+", 
    RowBox[{
     TemplateBox[{
       RowBox[{"-", 
         StyleBox["\[Alpha]", "TI"]}]},
      "Ket"], 
     TemplateBox[{
       StyleBox["\[Alpha]", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dbf7607-7d8f-3116-46ce-b5fcc7af445c"],
 " and the overlap ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", 
   RowBox[{
    TemplateBox[{
      RowBox[{"-", 
        StyleBox["\[Alpha]", "TI"]}], 
      StyleBox["\[Alpha]", "TI"]},
     "BraKet"], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", "2", 
      SuperscriptBox[
       StyleBox["\[Alpha]", "TI"], "2"]}]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d4d8ab3-8121-24a0-2b4f-038185589769"],
 ", evolves on its own. The coherence left at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ffa7364-29b0-d73e-64fd-63fa0eca6287"],
 " is its trace norm relative to the start,"
}], "Text",
 CellID->1120586436,ExpressionUUID->"3ad84f5c-13aa-8ce0-7579-4d35b3496d23"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["D", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     SubscriptBox[GridBox[{
        {GridBox[{
           {
            RowBox[{
             SubscriptBox["\[ScriptCapitalE]", 
              StyleBox["t", "TI"]], 
             StyleBox["(",
              SpanMaxSize->1], 
             RowBox[{"\[CapitalDelta]", 
              StyleBox["\[Rho]", "TI"]}], 
             StyleBox[")",
              SpanMaxSize->1]}]}
          },
          GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
          GridBoxSpacings->{"Columns" -> {{0.15}}}]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.22}}}], "1"], 
     SubscriptBox[GridBox[{
        {GridBox[{
           {
            RowBox[{"\[CapitalDelta]", 
             StyleBox["\[Rho]", "TI"]}]}
          },
          GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
          GridBoxSpacings->{"Columns" -> {{0.15}}}]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.22}}}], "1"]]}], ","}],
  Alignment->Center,
