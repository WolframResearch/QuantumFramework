Cell[TextData[{
 "which does not commute with itself at different times; the propagator \
solves ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", 
   OverscriptBox[
    StyleBox["H", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c27c97e-73e1-a633-243a-bfff3b945344"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35099ee4-e182-9883-251a-69af9104952f"],
 "."
}], "Text",
 CellID->324440207,ExpressionUUID->"611c049a-d5c8-6a64-595b-b07ea956c33a"],

