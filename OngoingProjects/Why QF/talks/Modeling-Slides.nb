   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["s", "TI"]], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47388c8d-54f4-9d36-22ba-6401cee72f35"],
 ", so it opens their crossing at zero field into a gap ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dee2d96-2fb7-4bd6-3167-30425847c414"],
 " but leaves the crossing of the lower level with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["s", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a83cda7-6558-5439-31c2-517e324a478e"],
 ", moved to a slightly lower field, intact. A tilted field mixes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["s", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "628369e9-023e-84b8-5c26-13322a6d2588"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["m", "TI"], 
    StyleBox["s", "TI"]], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15cf771a-8dde-6dd3-23a9-cd88ac239e40"],
 " and turns the crossing into an avoided one, with a gap that widens with \
the tilt."
}], "Text",
 CellID->612824734,ExpressionUUID->"1f7811c7-58bd-7825-67bb-6ef80bca91b5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->340520549,ExpressionUUID->"6ab0715c-d4ff-1d83-7f9d-660dc6881b7b"],

Cell["A five-site Heisenberg ring split into symmetry sectors", "Subsection",
 CellID->1689499583,ExpressionUUID->"5df2b74e-1b82-1624-0997-b03f7dc14271"],

Cell[TextData[{
 "Five spins ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bef5c57-3d38-40e1-4700-60712c30b073"],
 " sit on a ring with antiferromagnetic exchange ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37d700a9-3309-1b04-252c-0858e161ac33"],
 " between neighbors. The Hamiltonian commutes with the total magnetization \
",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["M", "TI"], "^"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "^"], 
    StyleBox["j", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b6a7f85-c232-18ba-7fea-449dd35f6f7e"],
 " and with the translation ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["T", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60ad4582-9de8-272b-7bf2-aa4bf2186e5c"],
 " that moves every spin one site along the ring, whose eigenvalues are ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "k"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326a255d-744d-38eb-1f2c-6e8ec855a2b1"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "2", "\[Pi]", 
   StyleBox["m", "TI"], "/", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cad05c-c953-b2a7-3699-e5549d6d70a9"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", "-", "2"}], ",", "\[Ellipsis]", ",", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "029fc0fb-a04e-5df9-2b7d-f1a9ff1bdd2c"],
 ". Which magnetization and momentum does the ground state carry?"
}], "Text",
 CellID->977080564,ExpressionUUID->"45013d93-ea79-a039-551b-00ab4f7e88ca"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["S",
      FontWeight->"Bold",
      FontSlant->"Plain"], "^"], 
    StyleBox["j", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox[
      StyleBox["\[Sigma]", "TI"],
      FontWeight->"Bold"], "^"], 
    StyleBox["j", "TI"]], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35fad8ec-887a-974f-1ecb-311255774796"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b7348-ab7a-8912-54bd-9522892b83aa"],
 " as spin up, and site 6 identified with site 1,"
}], "Text",
 CellID->1662440160,ExpressionUUID->"413e76d3-a4a4-baeb-6de4-638b4b94df45"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    StyleBox["J", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["j", "TI"], "=", "1"}], "5",
     LimitsPositioning->False], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S",
       FontWeight->"Bold",
       FontSlant->"Plain"], "^"], 
     StyleBox["j", "TI"]], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["S",
       FontWeight->"Bold",
       FontSlant->"Plain"], "^"], 
     RowBox[{
      StyleBox["j", "TI"], "+", "1"}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["[",
       SpanMaxSize->1], 
      RowBox[{
       OverscriptBox[
        StyleBox["H", "TI"], "^"], ",", 
       OverscriptBox[
        StyleBox["M", "TI"], "^"]}], 
      StyleBox["]",
       SpanMaxSize->1]}], "=", 
     RowBox[{
      RowBox[{
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["H", "TI"], "^"], ",", 
        OverscriptBox[
         StyleBox["T", "TI"], "^"]}], 
       StyleBox["]",
        SpanMaxSize->1]}], "=", 
      RowBox[{
       RowBox[{
        StyleBox["[",
         SpanMaxSize->1], 
        RowBox[{
         OverscriptBox[
          StyleBox["M", "TI"], "^"], ",", 
         OverscriptBox[
          StyleBox["T", "TI"], "^"]}], 
        StyleBox["]",
         SpanMaxSize->1]}], "=", "0"}]}]}], ";"}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1317817200,ExpressionUUID->"40dffe09-c81b-69bc-7934-34c64cff1fa3"],

Cell[TextData[{
 "flipping every spin commutes with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5182f21d-672a-c26d-5ed8-3a722914378c"],
 " and sends ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["M", "TI"], "^"], "\[Rule]", "-", 
   OverscriptBox[
    StyleBox["M", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05c74c9e-573a-36b5-5b23-5779cba8f9c8"],
 ", so the sectors with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a686279-5410-e109-2082-ba470a9eb875"],
 " repeat those with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6611ae1d-e3fe-668e-2312-028ad764ce57"],
 "."
}], "Text",
 CellID->1678433922,ExpressionUUID->"3bcf05d2-ec83-01df-4378-6e3bbeb4bd46"],

Cell[TextData[{
 "On the 32-dimensional space each joint eigenspace of ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["M", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5730fad8-92c1-b34a-3f79-d870ca4e3e49"],
 " and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["T", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e67a40-4e0e-9c53-6633-7ea173bdb86a"],
 " gets an exact orthonormal basis, and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5335f683-7c3c-ea6d-4978-5516167c11be"],
 " is diagonalized in each in closed form; the figure plots ",
 Cell[BoxData[GridBox[{
    {
     OverscriptBox[
      StyleBox["H", "TI"], "^"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79f02bff-1f2c-c6b5-2562-42a004bb1bfe"],
 " in the product basis, ",
 Cell[BoxData[GridBox[{
    {
     OverscriptBox[
      StyleBox["H", "TI"], "^"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dd82a29-d712-39de-041f-a233511ce3fa"],
 " in the basis sorted by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], ",", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16ddce25-febb-d7ef-2987-b098947f5e83"],
 ", and the energies of each sector, in units of ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a321759-1650-a523-6769-1ee4fddef68b"],
 ":"
}], "Text",
 CellID->585213338,ExpressionUUID->"2c039c11-1602-128d-705e-fff16a929c58"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ringPairs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"j", ",", " ", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"j", ",", " ", "5"}], "]"}], " ", "+", " ", "1"}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringH", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"QuantumOperator", " ", "@@@", " ", 
         RowBox[{"Tuples", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<XX\>\"", ",", " ", "\"\<YY\>\"", ",", 
              " ", "\"\<ZZ\>\""}], "}"}], ",", " ", "ringPairs"}], "}"}], 
          "]"}]}], "]"}], "/", "4"}], ")"}], "[", "\"\<Matrix\>\"", "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringT", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Permutation\>\"", "[", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{"2", ",", " ", "5"}], "]"}], ",", " ", 
        RowBox[{"Cycles", "[", 
         RowBox[{"{", 
          RowBox[{"Range", "[", "5", "]"}], "}"}], "]"}]}], "]"}], "]"}], 
     "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringM", " ", "=", " ", 
   RowBox[{"Diagonal", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{"\"\<Z\>\"", ",", " ", 
             RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"Range", "[", "5", "]"}]}], "]"}], "/", "2"}], ")"}], 
      "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ringBasis", "[", 
    RowBox[{"mm_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{"ComplexExpand", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "2"}], " ", "Pi", " ", "I", " ", "m", " ", 
                RowBox[{"#", "/", "5"}]}], "]"}], " ", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"ringT", ",", " ", "#"}], "]"}]}], " ", "&"}], " ", "/@",
             " ", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "4"}], "]"}]}], "]"}], "/", "5"}], "]"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Normalize", " ", "/@", " ", 
      RowBox[{"DeleteDuplicatesBy", "[", 
       RowBox[{
        RowBox[{"DeleteCases", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", "p", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"ringM", ",", " ", "mm"}], "]"}], "]"}], "]"}], "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"0", " ", ".."}], "}"}]}], "]"}], ",", " ", "Unitize"}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringSectors", " ", "=", " ", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ringBasis", " ", "@@", " ", "#"}], " ", "&"}], ",", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"5", "/", "2"}], ",", " ", 
            RowBox[{
             RowBox[{"-", "5"}], "/", "2"}], ",", " ", 
            RowBox[{"-", "1"}]}], "]"}], ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"-", "2"}], ",", " ", "2"}], "]"}]}], "}"}], "]"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringV", " ", "=", " ", 
   RowBox[{"Join", " ", "@@", " ", 
    RowBox[{"Values", "[", "ringSectors", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringE", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "#", "]"}], " ", ".", " ", "ringH", " ", ".",
         " ", 
        RowBox[{"Transpose", "[", "#", "]"}]}], "]"}], "]"}], " ", "&"}], " ",
     "/@", " ", "ringSectors"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ringMs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", " ", 
     RowBox[{"3", "/", "2"}], ",", " ", 
     RowBox[{"5", "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Row", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ArrayPlot", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "ringH", "]"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"FrameTicks", " ", "->", " ", "None"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", "\"\<product basis\>\""}], ",", 
         " ", 
         RowBox[{"ImageSize", " ", "->", " ", "220"}]}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"ArrayPlot", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "ringV", "]"}], " ", ".", " ", "ringH", 
            " ", ".", " ", 
            RowBox[{"Transpose", "[", "ringV", "]"}]}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
         RowBox[{"FrameTicks", " ", "->", " ", "None"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", "\"\<sorted by (M, k)\>\""}], ",",
          " ", 
         RowBox[{"ImageSize", " ", "->", " ", "220"}]}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Catenate", "[", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Thread", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Last", "[", "#1", "]"}], ",", " ", 
                  RowBox[{"N", "[", "#2", "]"}]}], "}"}], "]"}], " ", "&"}], ",",
               " ", 
              RowBox[{"KeySelect", "[", 
               RowBox[{"ringE", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"First", "[", "#", "]"}], " ", "==", " ", "mm"}], 
                 " ", "&"}]}], "]"}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"mm", ",", " ", "ringMs"}], "}"}]}], "]"}], ",", "\n", 
         "    ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "22"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "14"}], "}"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "7"}], "}"}]}], 
           "}"}]}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2.5"}], ",", " ", "2.5"}], "}"}], ",", " ", 
            "All"}], "}"}]}], ",", " ", 
         RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "    ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"HoldForm", "[", 
              RowBox[{"5", " ", 
               RowBox[{"k", "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "\[Pi]"}], ")"}]}]}], "]"}], "]"}], ",", 
            " ", "\"\<E / J\>\""}], "}"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<M = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
              "&"}], " ", "/@", " ", "ringMs"}], ",", " ", "Below"}], 
           "]"}]}]}], "]"}]}], "}"}], ",", " ", "\"\<   \>\""}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "ringSectors", "]"}], ",", 
        " ", "\"\< nonempty sectors;  ground-state energy \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"MinimalBy", "[", 
            RowBox[{
             RowBox[{"Catenate", "[", 
              RowBox[{"Values", "[", "ringE", "]"}], "]"}], ",", " ", "N"}], 
            "]"}], "]"}], " ", "J"}], "]"}]}], "}"}], "]"}], ",", " ", "13", ",",
      " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[64]:= ",
 CellID->1329986693,ExpressionUUID->"2ac04e2c-89e6-3d80-1061-c54320cfcc1f"],

Cell[TextData[{
 "The 32 levels fall into blocks no larger than ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5588fe90-64ae-bcf4-4842-16cb24b0798f"],
 ", one for each nonempty pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], ",", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f2398be-0d4a-8163-4e26-92db76424013"],
 ", so every energy is a root of a quadratic. The ground state sits at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", "\[PlusMinus]", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d5ae689-0a75-0b54-3cb4-44ef404ba2d5"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[PlusMinus]", "2", "\[Pi]", "/", "5"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33658957-a154-bc00-0a64-178542206b4a"],
 ", four degenerate states. Every level of a larger ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff569e4-7272-e306-7b15-d1fd9eec2e89"],
 " reappears at the same ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d3e1df6-66e6-1f12-6b8b-1f2edaed90f6"],
 " in each smaller ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "010de79e-c3df-fcec-0677-fc31214bc680"],
 ", as the total-spin multiplets of a rotation-invariant ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "179c30af-6054-b207-65af-c029f5682585"],
 " require."
}], "Text",
 CellID->1151717857,ExpressionUUID->"3b53d22f-538f-e7ee-0036-367ffd1d3021"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1577177967,ExpressionUUID->"1f04e79e-57a7-077a-5d64-fb88e0925ef5"],

Cell["A variational upper bound on the ground-state energy", "Subsection",
 CellID->858346782,ExpressionUUID->"4e8e80e1-81d9-ca4f-2de3-5b5f497a95db"],

Cell[TextData[{
 "Six spins on a ring have a ferromagnetic Ising coupling ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65f5d344-9840-7121-1344-3f14044d0906"],
 " along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68b325d1-6483-cb18-4f09-da0c5da331a3"],
 " and sit in a transverse field ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ba5af02-2c36-287f-5cdd-d166f2359e1b"],
 " along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70aa175b-8ce8-dfde-7210-0399ca5a0d6a"],
 ". The trial state tilts every spin by the same angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dabf382-5881-1b56-4183-4710bdc8dd54"],
 " from ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e042de0-01af-6d59-1059-812fb9d7f741"],
 " toward ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "130aaa67-3c9b-ee87-4e8e-4b018a691a57"],
 ", a product state with no entanglement. How close does the best such state \
come to the true ground-state energy ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dae8d61-a584-73b6-2c5f-abe746e65000"],
 "?"
}], "Text",
 CellID->893103051,ExpressionUUID->"55d652bc-e9a8-5c98-374c-b6e61d7fab3a"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "7"], "\[Congruent]", 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c226eba-2b42-c5ea-7545-03ee0e928327"],
 ", the Hamiltonian, the trial state and the Rayleigh-Ritz bound are"
}], "Text",
 CellID->651658897,ExpressionUUID->"2731e1a4-485f-0d93-3d47-e7cd9a8e50b3"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["J", "TI"]}], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["j", "TI"], "=", "1"}], "6",
        LimitsPositioning->False], 
       RowBox[{
        SubscriptBox[
         StyleBox["Z", "TI"], 
         StyleBox["j", "TI"]], 
        SubscriptBox[
         StyleBox["Z", "TI"], 
         RowBox[{
          StyleBox["j", "TI"], "+", "1"}]]}]}]}], "-", 
     RowBox[{
      StyleBox["h", "TI"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["j", "TI"], "=", "1"}], "6",
        LimitsPositioning->False], 
       SubscriptBox[
        StyleBox["X", "TI"], 
        StyleBox["j", "TI"]]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Theta]", "TI"]},
     "Ket"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        StyleBox["cos",
         FontSlant->"Plain"], 
        FractionBox[
         StyleBox["\[Theta]", "TI"], "2"], 
        TemplateBox[{"0"},
         "Ket"]}], "+", 
       RowBox[{
        StyleBox["sin",
         FontSlant->"Plain"], 
        FractionBox[
         StyleBox["\[Theta]", "TI"], "2"], 
        TemplateBox[{"1"},
         "Ket"]}]}], ")"}], 
     RowBox[{"\[CircleTimes]", "6"}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["E", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["\[Theta]", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      TemplateBox[{
        StyleBox["\[Theta]", "TI"]},
       "Bra"], 
      OverscriptBox[
       StyleBox["H", "TI"], "^"], 
      TemplateBox[{
        StyleBox["\[Theta]", "TI"]},
       "Ket"]}], "\[GreaterEqual]", 
     RowBox[{
      SubscriptBox[
       StyleBox["E", "TI"], "0"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1781613651,ExpressionUUID->"656d0805-f415-c856-0bb6-5c6045cf58b2"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Theta]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33a52f25-75d2-48f6-11c6-f93f47ee055b"],
 " for general ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aea930e-31a6-0951-5390-93a1f477c6d9"],
 ", ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f855a98-17b2-a84e-6ae5-a7f18ce8c2f3"],
 " and ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29e7d075-4e4d-7e3d-55f3-1c2a1671163e"],
 " and its minimum are in closed form (marked: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["\[Theta]", "TI"], "*"], "=", 
   StyleBox["h", "TI"], "/", "2", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c4394ed-d4cc-90c6-4fd9-3366e2881f52"],
 " below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "=", "2", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26aec206-6079-e0a7-63c6-0566be6a61a8"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Theta]", "TI"], "*"], "=", "\[Pi]", "/", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "784b2f92-9b46-8223-4ea1-354db725b7dc"],
 " above), against ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d1b676f-639b-1328-0019-621d863661b2"],
 " from the Jordan-Wigner closed form for the ring (dashed), both per spin in \
units of ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc175cc-a0bf-f14c-7c3f-9560280a0df0"],
 ":"
}], "Text",
 CellID->1460497615,ExpressionUUID->"53bf0b4d-657c-ca74-1b13-1b86b33c3bb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"isingH", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "isingJ"}], " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<ZZ\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"#", ",", " ", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"#", ",", " ", "6"}], "]"}], " ", "+", " ", "1"}]}], 
           "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"Range", "[", "6", "]"}]}], "]"}]}], " ", "-", " ", 
    RowBox[{"hx", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"\"\<X\>\"", ",", " ", 
          RowBox[{"{", "#", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"Range", "[", "6", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"isingTrial", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", " ", "@@", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"isingTheta", "/", "2"}], "]"}], ",", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"isingTheta", "/", "2"}], "]"}]}], "}"}], "]"}], ",", " ", 
      "6"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"isingE", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"isingTrial", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
         RowBox[{"isingH", " ", "@", " ", "isingTrial"}]}], ")"}], 
       "[", "\"\<Scalar\>\"", "]"}], "/", "6"}], ",", " ", 
     RowBox[{"isingTheta", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"isingStar", " ", "=", " ", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ArcSin", "[", 
         RowBox[{"hx", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "isingJ"}], ")"}]}], "]"}], ",", " ", 
        RowBox[{"hx", " ", "<", " ", 
         RowBox[{"2", " ", "isingJ"}]}]}], "}"}], "}"}], ",", " ", 
     RowBox[{"Pi", "/", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"isingEStar", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"isingE", " ", "/.", " ", 
      RowBox[{"isingTheta", " ", "->", " ", "isingStar"}]}], ",", " ", 
     RowBox[{
      RowBox[{"isingJ", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"hx", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"isingE0", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"isingJ", "^", "2"}], " ", "+", " ", 
          RowBox[{"hx", "^", "2"}], " ", "-", " ", 
          RowBox[{"2", " ", "isingJ", " ", "hx", " ", 
           RowBox[{"Cos", "[", "#", "]"}]}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"(", 
        RowBox[{"Pi", " ", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"-", "5"}], ",", " ", "5", ",", " ", "2"}], "]"}], "/", 
          "6"}]}], ")"}]}], "]"}]}], "/", "6"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"isingFields", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", " ", "1", ",", " ", "2", ",", " ", "4"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"isingE", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"isingJ", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"hx", " ", "->", " ", "#"}]}], "}"}]}], " ", "&"}], " ", "/@",
        " ", "isingFields"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"isingTheta", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", " ", 
     
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<h/J = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
         "&"}], " ", "/@", " ", "isingFields"}], ")"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"isingE0", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"isingJ", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"hx", " ", "->", " ", "#"}]}], "}"}]}], " ", "&"}], " ", "/@",
        " ", "isingFields"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"isingTheta", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", " ", 
     
     RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"isingStar", ",", " ", "isingEStar"}], "}"}], "}"}], " ", "/.",
         " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"isingJ", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"hx", " ", "->", " ", "#"}]}], "}"}]}], " ", "&"}], " ", "/@",
       " ", "isingFields"}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "10"}], "}"}]}]}], "]"}], ",", "\n", 
   " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "Pi"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "4.2"}], ",", " ", 
        RowBox[{"-", "0.4"}]}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<energy per spin / J\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", "\n", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pw", " ", "=", " ", 
          RowBox[{"isingEStar", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"isingJ", " ", "->", " ", "\"\<J\>\""}], ",", " ", 
             RowBox[{"hx", " ", "->", " ", "\"\<h\>\""}]}], "}"}]}]}], "}"}], 
        ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<best product state:  E(\[Theta]*)/6 = \>\"", ",", " ", 
           
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"pw", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], 
            "]"}], ",", "\n", "   ", "\"\< for h < 2J,   \>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"Last", "[", "pw", "]"}], "]"}], ",", 
           " ", "\"\< for h \[GreaterEqual] 2J\>\""}], "}"}], "]"}]}], "]"}], 
      ",", " ", "13", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[65]:= ",
 CellID->1960610012,ExpressionUUID->"594265df-c75d-d9e8-157b-f2cd2ae700b4"],

Cell[TextData[{
 "Each trial curve stays above its dashed line, as the bound requires, and \
its marked minimum is the best product state. That state turns fully along ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "252eca49-64e1-3405-5d94-ff6234c41bed"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "=", "2", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed87119-7099-2733-6227-1519a8770837"],
 ", twice the field ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "=", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10ac4a3a-00b0-03a7-6194-b93cd028fe1b"],
 " where the infinite chain changes phase. The gap at the minimum, the energy \
a product state cannot reach, is tiny at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "/", 
   StyleBox["J", "TI"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a0ddaf4-638c-139b-4b75-ed88aaddc0b0"],
 ", grows up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "/", 
   StyleBox["J", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c834315-f694-7eae-62a5-937e6859669f"],
 ", and shrinks again at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "/", 
   StyleBox["J", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0970b015-28f2-541a-4705-504164d20349"],
 "."
}], "Text",
 CellID->63571304,ExpressionUUID->"53fe32aa-c742-4644-0cac-e117a2a97c38"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->456540005,ExpressionUUID->"4314d5bc-3744-fbdd-582c-70f18443d02c"],

Cell["Fermi's golden rule from a level coupled to a band", "Subsection",
 CellID->1723436381,ExpressionUUID->"465059f7-4671-7c15-26ee-1e41d0190f5e"],

Cell[TextData[{
 "A discrete level ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["i", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b2b434e-2316-3ba5-5bcb-259aad4e2d31"],
 " at energy zero couples with the same matrix element ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c0f7855-7a35-ada7-5193-5e6b5551af5f"],
 " to each level ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["k", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee1612-3dbf-883c-3dfa-5285bc0aa3f4"],
 " of a band, levels spaced by ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3487b10d-69cd-767e-01c4-f4a5e61004e3"],
 " from ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["W", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d71e65f-0a06-a135-06fd-12bfd2079869"],
 " to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "723d0942-a779-3998-4a88-6b87b8076865"],
 ". First-order perturbation theory predicts that ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["i", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d3c78a-9d2c-c7ef-051a-908d5039d797"],
 " empties at the golden-rule rate ",
 Cell[BoxData["\[CapitalGamma]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f93c89f-7e6a-3654-33ee-b8dfa67660bd"],
 ". When does the exact population of ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["i", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09ab4ebf-b820-aaf7-5afd-6db6a3ab2959"],
 " follow ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[CapitalGamma]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0241d774-743d-2723-0183-7616a45fd23c"],
 "?"
}], "Text",
 CellID->1373802269,ExpressionUUID->"4e5e5bf6-f056-114c-25c1-020fca8df3f5"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "589f6354-5cb6-e001-21b3-dae0c156ae53"],
 " and ",
 Cell[BoxData[
  RowBox[{
