Cell[TextData[{
 "From ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22e1b76d-4c3a-92bf-004f-008a2c34375c"],
 " the population moves to ",
 Cell[BoxData[
  TemplateBox[{"02"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f0e1741-6730-5427-2fc0-b8168c554ce7"],
 " and back, while ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5885f460-9179-b155-02ae-8064e9851382"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "588da5d0-5091-434f-592b-481dcffcd6ec"],
 " stay where they are. The amplitude ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064a4b4d-4aea-847f-4283-e5e5ba3d0c57"],
 " stays real, passes through zero when the state is entirely in ",
 Cell[BoxData[
  TemplateBox[{"02"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40733145-47de-3c3c-2854-9fd01441c318"],
 ", and returns as ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14495758-5049-363c-52dd-d6f09757bf26"],
 ". When ",
 Cell[BoxData[GridBox[{
    {
     StyleBox["\[Alpha]", "TI"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ef291b3-cafa-a1e2-15f7-3ff752ed8dc4"],
 " is comparable to ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "762fe846-8bd4-349b-1533-d0a54d4d32db"],
 " this blurs: ",
 Cell[BoxData[
  TemplateBox[{"20"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76380d18-f44e-6108-68ca-9484a9986bb7"],
 " joins in, ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aab6eeb-6b97-4e2e-2480-edf847bf5896"],
 " does not fully return, and ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7885ff43-1915-9c7e-606a-1c0c2913858e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3328ce2c-b631-52b7-34b2-a5af7a3c26fc"],
 ", now close in energy, exchange population."
}], "Text",
 CellID->1691915908,ExpressionUUID->"3cc4a8d6-b488-3889-6bd2-1671f50624a8"],

Cell[TextData[{
 "Dropping ",
 Cell[BoxData[
  TemplateBox[{"20"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bfb8539-c89b-74fc-092c-9ade8c4f0bf7"],
 " leaves a two-level system on ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{"11"},
     "Ket"], ",", 
    TemplateBox[{"02"},
     "Ket"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f585b78-19d4-87b8-57c3-7bd6a7d904bb"],
 ", coupled by ",
 Cell[BoxData[
  RowBox[{
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a82f5b-7af2-44cc-4779-82ef95f860fd"],
 " and detuned by ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52800477-14d1-e066-742d-00fa773e75b5"],
 ". One full swap turns its Bloch vector once around, and a two-level system \
turned by ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b4098ec-aa39-5a07-7516-c3a4ba205fcc"],
 " returns with a factor ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13af4cdc-0f81-5477-099e-d8668f157706"],
 " for any ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f7f54f8-109a-60b8-79c7-3b8dadde8c05"],
 "; off resonance the energy offset of ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3768331d-7850-52b4-4f4f-e8ebb03977a0"],
 " adds a phase ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], 
   StyleBox["t", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "714996e8-e5c7-0f7d-7472-3ab5c1f6e753"],
 ", so after one swap"
}], "Text",
 CellID->1560498566,ExpressionUUID->"08ea5db6-6d7c-9efb-4877-7f9869d77d89"],

