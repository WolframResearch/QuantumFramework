Cell[TextData[{
 "On resonance ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e7318ad-f6be-c36a-5a7c-7346aae552fd"],
 " points along ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4abd99-063f-01a9-4ee0-cc844487603c"],
 " at every instant, so the propagator is the rotation by the area swept so \
far and a pulse with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23d45fd3-0e7c-4d15-2a9b-6e937ddfd1ed"],
 " is a full flip. Detuning tilts the rotation axis by an angle that changes \
along the pulse, so the same pulse moves less population: at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "\[CapitalDelta]", "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ca3cca-29fb-1d00-2b5f-bedb164b06bc"],
 " the ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ad4635b-981f-8ff1-1df1-375071f9bde0"],
 " pulse stops short of a full flip, and at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "\[CapitalDelta]", "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf5bccf-23e5-8cfd-68ca-3642e02a6878"],
 " the pulses leave almost nothing in ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4267b8-c909-5521-7b7b-d128dfd2b255"],
 " at the end."
}], "Text",
 CellID->793234618,ExpressionUUID->"7447abf7-a91d-9014-3891-821ced166f51"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
