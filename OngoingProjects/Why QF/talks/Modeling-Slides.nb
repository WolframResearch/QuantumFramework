Cell["Where a DRAG pulse puts no power", "Subsection",
 CellID->1615823538,ExpressionUUID->"35b56869-b86e-34b9-7fb8-6fa37835359a"],

Cell[TextData[{
 "A DRAG pulse has a Gaussian envelope ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["t", "TI"], "-", 
        SubscriptBox[
         StyleBox["t", "TI"], "0"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"], "/", "2", 
     SuperscriptBox[
      StyleBox["\[Sigma]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6741f429-0d29-b991-221e-b424182caa41"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Sigma]", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b0b4f1c-0202-c8e1-5261-0fc79502884d"],
 " ns, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], "0"], "=", "20"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a6aa21f-0d5b-94d3-41e4-8371d1155a72"],
 " ns, 40 ns long) and a quadrature ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["\[Beta]", "TI"], 
   OverscriptBox[
    StyleBox["I", "TI"], "."], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a12f8e0-ba07-3b91-0909-d38549647ff3"],
 ", with ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cb6a844-7cb9-c2dc-3040-9738b8fefa72"],
 " to be calibrated by a sweep; the controller plays 1 ns samples. Where in \
frequency does each compiled pulse put no power?"
}], "Text",
 CellID->1710565921,ExpressionUUID->"68e19ee7-ad1c-6c02-05c1-3afbae2db802"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c533dd6-bdb6-68b0-2541-4b640c40e20d"],
 " measured from the carrier and ",
