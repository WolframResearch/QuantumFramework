        " ", "\"\<Im k/\[CapitalOmega]\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "230"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rateA5", "[", 
    RowBox[{
     RowBox[{"\[CapitalDelta]v_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"kv_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Min", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Re", "[", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"liouA5", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[CapitalDelta]", " ", "->", " ", "\[CapitalDelta]v"}], 
             ",", " ", 
             RowBox[{"k", " ", "->", " ", "kv"}]}], "}"}]}], "]"}], "]"}], 
        "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"#", " ", ">", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}], " ", "&"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"freqA5", "[", 
    RowBox[{
     RowBox[{"\[CapitalDelta]v_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"kv_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Im", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"N", "[", 
        RowBox[{"liouA5", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\[CapitalDelta]", " ", "->", " ", "\[CapitalDelta]v"}], ",",
            " ", 
           RowBox[{"k", " ", "->", " ", "kv"}]}], "}"}]}], "]"}], "]"}], 
      "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ratePanelA5", "[", "\[CapitalDelta]v_", "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rateA5", "[", 
        RowBox[{"\[CapitalDelta]v", ",", " ", "kk"}], "]"}], ",", " ", 
       RowBox[{"freqA5", "[", 
        RowBox[{"\[CapitalDelta]v", ",", " ", "kk"}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"kk", ",", " ", "0.1", ",", " ", "1.7"}], "}"}], ",", " ", 
     RowBox[{"PlotPoints", " ", "->", " ", "200"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.06"}], ",", " ", "1.5"}], "}"}]}], ",", " ", "\n", 
     "   ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"markA5", "[", 
       RowBox[{"\[CapitalDelta]v", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.06"}], ",", " ", "1.5"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"y", ",", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{
                RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], 
               "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"y", ",", " ", "0.2", ",", " ", "1.4", ",", " ", "0.2"}],
              "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"GrayLevel", "[", "0.4", "]"}], "]"}]}], "}"}]}], 
         "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", 
      RowBox[{"1", "/", "2"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k/\[CapitalOmega]\>\"", ",", 
        " ", "\"\<rate / \[CapitalOmega]\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "230"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PlotGrid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"discPanelA5", " ", "/@", " ", "\[CapitalDelta]sA5"}], 
