 CellID->2097176062,ExpressionUUID->"18460f8d-b6bb-a7e4-214a-fc75e05f4aca"],

Cell["\<\
The first Bianchi identity from the Riemann tensor's Young diagram\
\>", "Subsection",
 CellID->944780905,ExpressionUUID->"51dc33eb-625b-054c-3dd5-2ac94faa40bc"],

Cell[TextData[{
 "The Riemann tensor ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox[
    RowBox[{"a", "b", "c", "d"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b6bdb5b-2834-d664-75e4-7db2bf40e027"],
 " in ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55834d65-2232-1098-6eec-5966db47d90c"],
 " dimensions has the pair symmetries ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], "=", "-", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"b", "a", "c", "d"}], "TI"]], "=", "-", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "d", "c"}], "TI"]], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"c", "d", "a", "b"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b8e6666-8bb3-98ff-6900-a46066105521"],
 " and the first Bianchi identity ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], "+", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "c", "d", "b"}], "TI"]], "+", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "d", "b", "c"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a640741-8bf8-021f-6e00-bcfa6642e16f"],
 ". Suppose only that ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46050834-254b-6cce-6625-e08735a707a6"],
 " lies in the image of the Young projector of shape ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16478dcd-299e-8345-717b-d00ff9f9f755"],
 ", which is one irreducible representation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], 
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12ce2da9-39e5-b2ac-4199-94e2caf4421c"],
 " inside the ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d0e9e25-6dce-ea16-1ba4-856c88d9716c"],
 " sector of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d2fadf4-b300-ef9f-00f8-7470658b8336"],
 " acting on the four slots. Does that projector alone impose the first \
Bianchi identity?"
}], "Text",
 CellID->258746161,ExpressionUUID->"2c3cd18c-e700-cee9-1a2a-797c0ccbcaef"],

Cell[TextData[{
 "For the tableau with rows ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"3", "}"}], ",", 
   RowBox[{"{", "2"}], ",", 
   RowBox[{"4", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aab0374-1caf-cbf9-57d6-969684186e90"],
 " the projector is"
}], "Text",
 CellID->1220068284,ExpressionUUID->"60c1c701-78cc-9450-36ef-570cd9cc9b43"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{
      RowBox[{"{", "2"}], ",", 
      RowBox[{"2", "}"}]}]], "\[ThinSpace]", 
    StyleBox["T", "TI"], "=", 
    FractionBox["2", 
     RowBox[{"4", "!"}]], "\[ThickSpace]", 
    SubscriptBox["\|01d49c", 
     RowBox[{
      RowBox[{"{", "1"}], ",", 
      RowBox[{"2", "}"}]}]], 
    SubscriptBox["\|01d49c", 
     RowBox[{
      RowBox[{"{", "3"}], ",", 
      RowBox[{"4", "}"}]}]], "\[ThinSpace]", 
    SubscriptBox["\|01d4ae", 
     RowBox[{
      RowBox[{"{", "1"}], ",", 
      RowBox[{"3", "}"}]}]], 
    SubscriptBox["\|01d4ae", 
     RowBox[{
      RowBox[{"{", "2"}], ",", 
      RowBox[{"4", "}"}]}]], "\[ThinSpace]", 
    StyleBox["T", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->968598249,ExpressionUUID->"4c5329ea-6fdb-5738-4c12-2ab24e1b6532"],

Cell[TextData[{
 "where ",
 Cell[BoxData["\|01d4ae"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ad659d1-ee18-438d-5828-d230d62e1177"],
 " sums over the permutations of a row of slots, ",
 Cell[BoxData["\|01d49c"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fbd4772-bbed-0223-1532-8400404054a6"],
 " sums over the permutations of a column with their signs, and ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01813187-50a2-98d8-0d80-ec4d329d45d0"],
 " is the dimension of the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bbb1872-fe71-63fe-089e-8215b249224e"],
 " representation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3103dee8-943d-89da-587e-fca3e5fa0c6a"],
 ". The pair symmetries alone make ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e2992ad-e1d5-8978-3eab-3cb5527b897a"],
 " a symmetric matrix on antisymmetric index pairs, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["N", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "261e9efd-ff32-ac3b-4ecd-9fea950f5111"],
 " components for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["d", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "530b7f92-3eef-da98-04c7-23adf06f8e8d"],
 "; the image of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   RowBox[{
    RowBox[{"{", "2"}], ",", 
    RowBox[{"2", "}"}]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63132125-dc0e-376d-4e16-8183a1841d43"],
 " has the dimension ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    RowBox[{
     RowBox[{"{", "2"}], ",", 
     RowBox[{"2", "}"}]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "265e2b3c-cd14-a6d9-782f-d7bd9482251e"],
 " of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["G", "TI"], 
   StyleBox["L", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72a3780c-6d0e-86de-591e-ebe43849ee77"],
 " representation."
}], "Text",
 CellID->502294042,ExpressionUUID->"35a2909e-3204-55cc-6e1c-ae86f7415c2f"],

Cell[TextData[{
 "The projector acts on a random integer tensor in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "788e48ea-25d8-1be8-1743-919dd237a630"],
 ", and the slot-permuted copies of the result are searched for three-term \
sums that vanish, with slot 1 fixed; the components are then counted for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "5"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53da80b9-2c92-1dcc-7586-eb8f6dba43a1"],
 " and the two counts compared at general ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30bf8e4e-c91c-2cd2-7ffb-6d2cc382999a"],
 ":"
}], "Text",
 CellID->415591171,ExpressionUUID->"1df40b52-485e-4c22-290b-d945a95f9851"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"riemannTableau", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"projectedT", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{"YoungProject", "[", 
      RowBox[{
       RowBox[{"RandomInteger", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}],
         "]"}], ",", " ", "riemannTableau"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"threeTermRelations", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Permutations", "[", 
          RowBox[{"Range", "[", "4", "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], " ", "==", " ", "1"}], " ", 
          "&"}]}], "]"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"projectedT", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
          " ", "#"}], "]"}], " ", "==", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}],
         "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"slotTerm", "[", "\[Sigma]_", "]"}], " ", ":=", " ", 
   RowBox[{"Subscript", "[", 
    RowBox[{"\"\<R\>\"", ",", " ", 
     RowBox[{"StringJoin", "[", 
      RowBox[{
       RowBox[{"Characters", "[", "\"\<abcd\>\"", "]"}], "[", 
       RowBox[{"[", "\[Sigma]", "]"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pairCount", "[", "dd_", "]"}], " ", ":=", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"SymmetrizedIndependentComponents", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dd", ",", " ", "dd", ",", " ", "dd", ",", " ", "dd"}], "}"}], 
      ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cycles", "[", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "]"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cycles", "[", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "4"}], "}"}], "}"}], "]"}], ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cycles", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", " ", 
          "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"projectorRank", "[", "dd_", "]"}], " ", ":=", " ", 
   RowBox[{"MatrixRank", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"YoungProject", "[", 
        RowBox[{
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"{", 
            RowBox[{"dd", ",", " ", "dd", ",", " ", "dd", ",", " ", "dd"}], 
            "}"}]}], "]"}], ",", " ", "riemannTableau"}], "]"}], "]"}], " ", 
      "&"}], " ", "/@", " ", 
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"dd", "^", "4"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"componentCounts", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dd", ",", " ", 
       RowBox[{"pairCount", "[", "dd", "]"}], ",", " ", 
       RowBox[{"projectorRank", "[", "dd", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"dd", ",", " ", "2", ",", " ", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"componentCounts", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"componentCounts", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<pair symmetries only\>\"", ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<rank of \>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<P\>\"", ",", " ", "\"\<{2,2}\>\""}], "]"}]}], "}"}], 
       "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<dimension d\>\"", ",", 
      " ", "\"\<independent components\>\""}], "}"}]}], ",", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"2", ",", " ", "5"}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "440"}], ",", "\n", "  ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<vanishing three-term sums:  \>\"", ",", " ", 
            RowBox[{"Column", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Row", "[", 
                   RowBox[{
                    RowBox[{"slotTerm", " ", "/@", " ", "#"}], ",", 
                    " ", "\"\< + \>\""}], "]"}], ",", " ", "\"\< = 0\>\""}], 
                 "}"}], "]"}], " ", "&"}], " ", "/@", " ", 
              "threeTermRelations"}], "]"}]}], "}"}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<rank = \>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<s\>\"", ",", " ", "\"\<{2,2}\>\""}], "]"}], ",", 
            " ", "\"\<(d) = \>\"", ",", " ", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"Factor", "[", 
              RowBox[{"SchurDimension", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "d"}], "]"}], 
              "]"}], "]"}], ",", " ", "\"\< at d = 2, ..., 5:  \>\"", ",", 
            "\n", "       ", 
            RowBox[{
             RowBox[{"componentCounts", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], " ", "===", " ", 
             
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"SchurDimension", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "#"}], 
                 "]"}], " ", "&"}], " ", "/@", " ", 
               RowBox[{"Range", "[", 
                RowBox[{"2", ",", " ", "5"}], "]"}]}], ")"}]}]}], "}"}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<pair count \[Minus] \>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<s\>\"", ",", " ", "\"\<{2,2}\>\""}], "]"}], ",", 
            " ", "\"\<(d) = \>\"", ",", " ", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"Factor", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"np", " ", "=", " ", 
                   RowBox[{"d", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"d", " ", "-", " ", "1"}], ")"}], "/", "2"}]}]}], 
                  "}"}], ",", " ", 
                 RowBox[{"np", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"np", " ", "+", " ", "1"}], ")"}], "/", "2"}]}]}],
                 "]"}], " ", "-", " ", 
               RowBox[{"SchurDimension", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "d"}], 
                "]"}]}], "]"}], "]"}]}], "}"}], "]"}]}], "}"}], "]"}], ",", 
      "\n", "    ", "13", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[140]:= ",
 CellID->2081341866,ExpressionUUID->"0f38d3b1-dfbc-f005-6616-4df88272e94f"],

Cell[TextData[{
 "The search returns only the cyclic sum over slots 2, 3, 4 (once with each \
sign), which is the first Bianchi identity; nothing beyond the projector was \
supplied. The rank of the projector is the textbook count of Riemann \
components, and the gap to the pair-symmetry count vanishes for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[LessEqual]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066f5a6a-0970-4e2c-206d-40fab14ef3c6"],
 ": only in four or more dimensions does Bianchi remove components."
}], "Text",
 CellID->546393094,ExpressionUUID->"111ec4a0-0319-e3a5-2d3c-d0ac67245353"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1520398177,ExpressionUUID->"4e46f5af-d33d-d70e-01a9-c68f50c3782f"],

Cell["Estimating a qubit's spectrum by Schur sampling", "Subsection",
 CellID->764810047,ExpressionUUID->"2671b79c-28fd-997f-186e-76e1d9db58b8"],

Cell[TextData[{
 "Take ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04b505e3-6c75-82f1-3318-38bc6cc3f567"],
 " copies of a qubit in an unknown state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "+", 
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f594cb-6a95-d59a-6561-ed27cba10b75"],
 " and measure only which Young diagram ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f4641dc-bd51-c082-735f-d768ac48d0ac"],
 ", that is which irreducible representation of the group ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394e6334-da79-76e5-646c-927214ffff5b"],
 " permuting the copies, the joint state occupies. What does the outcome \
reveal about ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40623d8f-9e0f-355a-214a-03b907234390"],
 "?"
}], "Text",
 CellID->1187920575,ExpressionUUID->"719ca73b-004d-0079-62d5-da43b5f1caa7"],

Cell["The outcome probabilities are", "Text",
 CellID->1214851736,ExpressionUUID->"3083ec64-6fe3-0544-01d5-607d687fb12b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["Pr",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Lambda]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["Tr",
     FontSlant->"Plain"], "\[NegativeThinSpace]", "[", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["P", "TI"], "^"], 
      StyleBox["\[Lambda]", "TI"]], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["\[Rho]", "TI"], 
      RowBox[{"\[CircleTimes]", 
       StyleBox["n", "TI"]}]]}], "]", "=", 
    SuperscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["\[Lambda]", "TI"]], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["\[Lambda]", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["y", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["s", "TI"], 
      RowBox[{
       RowBox[{"{", 
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], "1"]}], ",", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], "2"], "}"}]}]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["x", "TI"], ",", 
       StyleBox["y", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox[
        RowBox[{"x", "y"}], "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], "2"]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["k", "TI"], "=", "0"}], 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], "1"], "-", 
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], "2"]}],
       LimitsPositioning->False], 
      RowBox[{
       SuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["k", "TI"]], 
       SuperscriptBox[
        StyleBox["y", "TI"], 
        RowBox[{
         SubscriptBox[
          StyleBox["\[Lambda]", "TI"], "1"], "-", 
         SubscriptBox[
          StyleBox["\[Lambda]", "TI"], "2"], "-", 
         StyleBox["k", "TI"]}]]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   StyleBox["x", "TI"], ",", 
   RowBox[{
    StyleBox["y", "TI"], "=", 
    FractionBox["1", "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "\[PlusMinus]", GridBox[{
       {
        OverscriptBox[
         StyleBox["b", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->320570406,ExpressionUUID->"160565e4-9b71-8776-6990-c8be20c04587"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["P", "TI"], "^"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c11e8e0-0fe8-4744-0eb2-8bd7e02b91b9"],
 " is the orthogonal projector onto the ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecbce3f-8a61-ff5d-4658-29189e946847"],
 " block of ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    SuperscriptBox["\:2102", "2"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c7d198c-b4e1-8c0d-1368-be627aea1548"],
 ", ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59f0707c-95b2-7ac8-684a-bc541cb46e5f"],
 " counts the standard tableaux of shape ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d77affe-d04d-b5a4-6592-8a8309873469"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c345f0-70da-0bb8-1750-4c593035d730"],
 " is the Schur polynomial at the eigenvalues of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5aded3b8-b93d-a432-02ec-91772af462e9"],
 " (Schur-Weyl duality); for qubits only diagrams with at most two rows \
occur. The projector itself is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], 
    StyleBox["\[Lambda]", "TI"]], "=", 
   OverscriptBox[
    StyleBox["M", "TI"], "^"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["M", "TI"], "^"], "+"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "251e5871-c1dc-3135-2b28-98987b2a6bbc"],
 " with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["M", "TI"], "^"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["T", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["P", "TI"], "^"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a6ba62f-6a9f-15f9-4f74-f7895cbdd9cd"],
 ", the sum of the Young projectors of the standard tableaux ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fe5d49-6fab-a188-38e4-e4d99e9d7a10"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["M", "TI"], "^"], "+"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2187d9bd-30d8-7558-69c0-580c360bbf42"],
 " its pseudoinverse."
}], "Text",
 CellID->446092327,ExpressionUUID->"0043ab3b-9eac-9de3-57d0-1bb606da72bf"],

Cell[TextData[{
 "The closed form is checked against ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["P", "TI"], "^"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44cfcd53-65bf-0198-7e75-c15527ce40ae"],
 " built from the Young projectors at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28b75e59-9ab1-50b8-26a6-34c538ef84b4"],
 " for general ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53ece09b-99ef-729e-15b2-65910b77406a"],
 ", and the figure plots ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Pr",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Lambda]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24cb5cb8-c9cc-49f9-571a-581b2bc32b29"],
 " against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "1"], "-", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "104a4600-3897-cb97-47a0-ed4f73b73199"],
 ":"
}], "Text",
 CellID->1244861762,ExpressionUUID->"003187bb-12e0-dbb5-0bf1-17c3e97044e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"schurPr", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l1_", ",", " ", 
       RowBox[{"l2_", " ", ":", " ", "0"}]}], "}"}], ",", " ", "b_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "b"}], ")"}], "/", "2"}]}], ",", " ", 
       RowBox[{"y", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "b"}], ")"}], "/", "2"}]}]}], "}"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"TableauDimension", "[", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"l1", ",", " ", "l2"}], "}"}], ",", " ", "0"}], "]"}], 
       "]"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "y"}], ")"}], "^", "l2"}], " ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"x", "^", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"l1", " ", "-", " ", "l2"}]}], "]"}]}], " ", 
        RowBox[{"y", "^", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"l1", " ", "-", " ", "l2"}], ",", " ", "0", ",", " ", 
           RowBox[{"-", "1"}]}], "]"}]}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"schurProjector", "[", 
    RowBox[{"n_", ",", " ", "\[Lambda]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tableaux", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"YoungTableau", "[", 
            RowBox[{"TakeList", "[", 
             RowBox[{"#", ",", " ", "\[Lambda]"}], "]"}], "]"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"Permutations", "[", 
           RowBox[{"Range", "[", "n", "]"}], "]"}]}], ",", " ", 
         "StandardTableauQ"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"t", ",", " ", 
                 RowBox[{"YoungProject", "[", 
                  RowBox[{
                   RowBox[{"ArrayReshape", "[", 
                    RowBox[{"#", ",", " ", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"2", ",", " ", "n"}], "]"}]}], "]"}], ",", " ", 
                   "t"}], "]"}]}], "]"}], " ", "/@", " ", "tableaux"}], "]"}],
              "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{"2", "^", "n"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"m", " ", ".", " ", 
        RowBox[{"PseudoInverse", "[", "m", "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"schurRho", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{"bx", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
      RowBox[{"by", " ", 
       RowBox[{"PauliMatrix", "[", "2", "]"}]}], " ", "+", " ", 
      RowBox[{"bz", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"schurCheck", " ", "=", " ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"IntegerPartitions", "[", 
      RowBox[{"4", ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"schurProjector", "[", 
             RowBox[{"4", ",", " ", "#"}], "]"}], " ", 
            RowBox[{"Transpose", "[", 
             RowBox[{"KroneckerProduct", " ", "@@", " ", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"schurRho", ",", " ", "4"}], "]"}]}], "]"}]}], ",", 
           " ", "2"}], "]"}], " ", "-", "\n", "      ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{"schurPr", "[", 
             RowBox[{"#", ",", " ", "bLength"}], "]"}], "]"}], " ", "/.", " ", 
           RowBox[{"bLength", " ", "->", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"bx", "^", "2"}], " ", "+", " ", 
              RowBox[{"by", "^", "2"}], " ", "+", " ", 
              RowBox[{"bz", "^", "2"}]}], "]"}]}]}], ")"}]}], "]"}], " ", "===",
        " ", "0"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"schurPanel", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", " ", "-", " ", 
            RowBox[{"2", " ", "l2"}]}], ")"}], "/", "n"}], ",", " ", 
         RowBox[{"schurPr", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"n", " ", "-", " ", "l2"}], ",", " ", "l2"}], "}"}], ",",
            " ", "b"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "0.9"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"l2", ",", " ", "0", ",", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "   ", 
     RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.03"}], ",", " ", "1.03"}], "}"}], ",", " ", "All"}],
        "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"1", "/", "2"}], ",", " ", "0.9"}], "}"}], ",", " ", 
        "None"}], "}"}]}], ",", " ", 
     RowBox[{"GridLinesStyle", " ", "->", " ", "Dashed"}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<|b| = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
         "&"}], " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"1", "/", "2"}], ",", " ", "0.9"}], "}"}]}], ")"}]}], ",", 
     " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<(\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "1"}], "]"}], ",", 
           " ", "\"\< \[Minus] \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\<)/n\>\""}], "}"}], "]"}], ",", 
        " ", "\"\<Pr(\[Lambda])\>\""}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<n = \>\"", ",", " ", "n"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"schurPanels", " ", "=", " ", 
   RowBox[{"schurPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"6", ",", " ", "20", ",", " ", "60"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"First", " ", "/@", " ", "schurPanels"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "schurPanels", "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<n = 4:  Tr[\>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<P\>\"", ",", " ", "\"\<\[Lambda]\>\""}], "]"}], ",", 
        " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<\[Rho]\>\"", ",", " ", "\"\<\[CircleTimes]4\>\""}], 
         "]"}], ",", " ", "\"\<] = \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<f\>\"", ",", " ", "\"\<\[Lambda]\>\""}], "]"}], ",", 
        " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<s\>\"", ",", " ", "\"\<\[Lambda]\>\""}], "]"}], ",", 
        " ", "\"\<(x, y) for every \>\"", ",", " ", 
        RowBox[{"OverVector", "[", "\"\<b\>\"", "]"}], ",", " ", "\"\<:  \>\"",
         ",", " ", "schurCheck"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[141]:= ",
 CellID->1091410949,ExpressionUUID->"4445cbf7-98b7-54c0-5f50-418b4597cdea"],

Cell[TextData[{
 "Every probability depends on ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d7ea95-7e56-8979-5bed-f94e3f33d437"],
 " only through ",
 Cell[BoxData[GridBox[{
    {
     OverscriptBox[
      StyleBox["b", "TI"], "\[RightVector]"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c575638-4fd7-dfb8-0fdc-ee71e074139d"],
 ", so the diagram reveals the eigenvalues ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", GridBox[{
      {
       OverscriptBox[
        StyleBox["b", "TI"], "\[RightVector]"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "770425c9-1363-0806-7751-eb4cf13d8ed7"],
 " and nothing about the eigenbasis. As ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0386bcaf-e0eb-fd69-4ac3-2fd0b04cc307"],
 " grows the distribution of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "1"], "-", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bb47033-d9e2-240e-3b2c-768823d51862"],
 " narrows around ",
 Cell[BoxData[GridBox[{
    {
     OverscriptBox[
      StyleBox["b", "TI"], "\[RightVector]"]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200702b4-b24b-4481-4afe-155b6593d5ea"],
 " (dashed), but it stays biased toward longer first rows, most visibly for \
the maximally mixed state."
}], "Text",
 CellID->641794942,ExpressionUUID->"227548c8-954b-fbef-0206-3009e76ba414"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1022424828,ExpressionUUID->"2c198970-c70c-595b-20f2-4746597c8242"],

Cell["Snyder's Lorentz-covariant quantum spacetime", "Subsection",
 CellID->885711521,ExpressionUUID->"3d87a57b-d1bb-573e-6768-8f785fa0ef68"],

Cell[TextData[{
 "Snyder made the spacetime coordinates ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], 
   StyleBox["\[Mu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b0abe54-c641-525a-5534-7748063f25a8"],
 " noncommuting without breaking Lorentz symmetry: their commutator is a \
Lorentz generator ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["M", "TI"], 
   StyleBox[
    RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78d65b7d-75d1-f44f-3cea-2ae3512835a8"],
 " times the square of a fundamental length ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ea583a4-dcd0-2345-23ae-3666bacf626a"],
 ". Is there a quadratic combination of the ten generators that commutes with \
all of them?"
}], "Text",
 CellID->614263420,ExpressionUUID->"29037b2b-2ae5-5a01-1d0d-3325a24b1038"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}], ",", 
    RowBox[{"-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346a6c8b-f25d-30bd-2b60-1935e7b1eb1d"],
 ", the algebra is"
}], "Text",
 CellID->421207891,ExpressionUUID->"1d2be8e4-3f36-cd05-1706-2b7cd7782c64"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["\[Mu]", "TI"]], ",", 
     SuperscriptBox[
      StyleBox["x", "TI"], 
      StyleBox["\[Nu]", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], "=", 
    StyleBox["i", "TI"], 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox[
        RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], ",", 
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["\[Rho]", "TI"]]}], 
     StyleBox["]",
      SpanMaxSize->1]}], "=", 
    RowBox[{
     StyleBox["i", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Eta]", "TI"], 
        StyleBox[
         RowBox[{"\[Nu]", "\[Rho]"}], "TI"]], 
       SuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["\[Mu]", "TI"]], "-", 
       SuperscriptBox[
        StyleBox["\[Eta]", "TI"], 
        StyleBox[
         RowBox[{"\[Mu]", "\[Rho]"}], "TI"]], 
       SuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["\[Nu]", "TI"]]}], ")"}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox[
        RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], ",", 
      SuperscriptBox[
       StyleBox["M", "TI"], 
       StyleBox[
        RowBox[{"\[Rho]", "\[Sigma]"}], "TI"]]}], 
     StyleBox["]",
      SpanMaxSize->1]}], "=", 
    RowBox[{
     StyleBox["i", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Eta]", "TI"], 
        StyleBox[
         RowBox[{"\[Nu]", "\[Rho]"}], "TI"]], 
       SuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox[
         RowBox[{"\[Mu]", "\[Sigma]"}], "TI"]], "-", 
       SuperscriptBox[
        StyleBox["\[Eta]", "TI"], 
        StyleBox[
         RowBox[{"\[Nu]", "\[Sigma]"}], "TI"]], 
       SuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox[
         RowBox[{"\[Mu]", "\[Rho]"}], "TI"]], "-", 
       SuperscriptBox[
        StyleBox["\[Eta]", "TI"], 
        StyleBox[
         RowBox[{"\[Mu]", "\[Rho]"}], "TI"]], 
       SuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox[
         RowBox[{"\[Nu]", "\[Sigma]"}], "TI"]], "+", 
       SuperscriptBox[
        StyleBox["\[Eta]", "TI"], 
        StyleBox[
         RowBox[{"\[Mu]", "\[Sigma]"}], "TI"]], 
       SuperscriptBox[
        StyleBox["M", "TI"], 
        StyleBox[
         RowBox[{"\[Nu]", "\[Rho]"}], "TI"]]}], ")"}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->449138091,ExpressionUUID->"7c00e91a-e88b-1f13-4695-90fb7f3df012"],

Cell[TextData[{
 "and the ansatz is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   StyleBox["c", "TI"], "\[ThinSpace]", 
   FractionBox["1", "2"], 
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0accd615-e08e-5baf-1f33-065936b975ea"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "=", 
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Nu]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c052621-ed0b-61fd-6c5c-a4051ac8dd90"],
 " and the Lorentz Casimir ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "700d7f3d-af3a-05a8-30b2-31795ecf47fc"],
 "."
}], "Text",
 CellID->1857903468,ExpressionUUID->"10ab3a90-3918-e1ae-4260-3d66ed2db368"],

Cell[TextData[{
 "With commutators reduced to an ordered basis by the relations, the \
commutator with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4eba98-0546-604a-472c-6eeb8ff6b3cc"],
 " fixes ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67062f20-6e42-6988-593d-1f9379166bbb"],
 ", and each table entry says whether the reduced commutator with a generator \
is zero:"
}], "Text",
 CellID->1663161825,ExpressionUUID->"7fa1193f-43b9-ad17-4bf6-dacbd66bff3c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"snyderEta", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[Nu]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"\[Mu]", " ", "+", " ", "1"}], ",", " ", 
      RowBox[{"\[Nu]", " ", "+", " ", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lorentzM", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[Nu]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"\[Mu]", " ", "==", " ", "\[Nu]"}], ",", " ", "0", ",", " ", 
     RowBox[{"\[Mu]", " ", "<", " ", "\[Nu]"}], ",", " ", 
     RowBox[{"snyderM", "[", 
      RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "]"}], ",", " ", "True", ",", " ", 
     RowBox[{"-", 
      RowBox[{"snyderM", "[", 
       RowBox[{"\[Nu]", ",", " ", "\[Mu]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"lorentzPairs", " ", "=", " ", 
   RowBox[{"Subsets", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "3"}], "]"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"snyderGenerators", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"snyderX", " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "3"}], "]"}]}], ",", " ", 
     RowBox[{"snyderM", " ", "@@@", " ", "lorentzPairs"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"snyderAlgebra", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", "snyderGenerators", "}"}]}], ",", " ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"snyderA", ",", " ", "snyderC"}], "}"}]}], ",", "\n", "    ", 
      
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Commutator", "[", 
             RowBox[{
              RowBox[{"snyderX", "[", "#2", "]"}], ",", " ", 
              RowBox[{"snyderX", "[", "#1", "]"}]}], "]"}], " ", "+", " ", 
            RowBox[{"I", " ", 
             RowBox[{"snyderA", "^", "2"}], " ", 
             RowBox[{"snyderM", "[", 
              RowBox[{"#1", ",", " ", "#2"}], "]"}]}]}], " ", "&"}], " ", "@@@",
           " ", "lorentzPairs"}], ",", "\n", "      ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Commutator", "[", 
              RowBox[{
               RowBox[{"snyderM", "[", 
                RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "]"}], ",", " ", 
               RowBox[{"snyderX", "[", "\[Rho]", "]"}]}], "]"}], " ", "-", 
             " ", 
             RowBox[{"I", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"snyderEta", "[", 
                  RowBox[{"\[Nu]", ",", " ", "\[Rho]"}], "]"}], " ", 
                 RowBox[{"snyderX", "[", "\[Mu]", "]"}]}], " ", "-", " ", 
                RowBox[{
                 RowBox[{"snyderEta", "[", 
                  RowBox[{"\[Mu]", ",", " ", "\[Rho]"}], "]"}], " ", 
                 RowBox[{"snyderX", "[", "\[Nu]", "]"}]}]}], ")"}]}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\[Mu]", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Nu]", ",", " ", 
              RowBox[{"\[Mu]", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"\[Rho]", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}],
           "]"}], ",", "\n", "      ", 
         RowBox[{"Replace", "[", 
          RowBox[{
           RowBox[{"Subsets", "[", 
            RowBox[{"lorentzPairs", ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\[Mu]_", ",", " ", "\[Nu]_"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"\[Rho]_", ",", " ", "\[Sigma]_"}], "}"}]}], "}"}], 
            " ", ":>", " ", 
            RowBox[{
             RowBox[{"Commutator", "[", 
              RowBox[{
               RowBox[{"snyderM", "[", 
                RowBox[{"\[Rho]", ",", " ", "\[Sigma]"}], "]"}], ",", " ", 
               RowBox[{"snyderM", "[", 
                RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "]"}]}], "]"}], " ", "+",
              "\n", "         ", 
             RowBox[{"I", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"snyderEta", "[", 
                  RowBox[{"\[Nu]", ",", " ", "\[Rho]"}], "]"}], " ", 
                 RowBox[{"lorentzM", "[", 
                  RowBox[{"\[Mu]", ",", " ", "\[Sigma]"}], "]"}]}], " ", "-", 
                " ", 
                RowBox[{
                 RowBox[{"snyderEta", "[", 
                  RowBox[{"\[Nu]", ",", " ", "\[Sigma]"}], "]"}], " ", 
                 RowBox[{"lorentzM", "[", 
                  RowBox[{"\[Mu]", ",", " ", "\[Rho]"}], "]"}]}], " ", "-", 
                " ", 
                RowBox[{
                 RowBox[{"snyderEta", "[", 
                  RowBox[{"\[Mu]", ",", " ", "\[Rho]"}], "]"}], " ", 
                 RowBox[{"lorentzM", "[", 
                  RowBox[{"\[Nu]", ",", " ", "\[Sigma]"}], "]"}]}], " ", "+", 
                " ", 
                RowBox[{
                 RowBox[{"snyderEta", "[", 
                  RowBox[{"\[Mu]", ",", " ", "\[Sigma]"}], "]"}], " ", 
                 RowBox[{"lorentzM", "[", 
                  RowBox[{"\[Nu]", ",", " ", "\[Rho]"}], "]"}]}]}], 
               ")"}]}]}]}], ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}]}], "|>"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"xSquared", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"snyderEta", "[", 
       RowBox[{"\[Mu]", ",", " ", "\[Mu]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"snyderX", "[", "\[Mu]", "]"}], " ", "**", " ", 
       RowBox[{"snyderX", "[", "\[Mu]", "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"lorentzCasimir", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"snyderEta", "[", 
       RowBox[{"\[Mu]", ",", " ", "\[Mu]"}], "]"}], " ", 
      RowBox[{"snyderEta", "[", 
       RowBox[{"\[Nu]", ",", " ", "\[Nu]"}], "]"}], " ", 
      RowBox[{
       RowBox[{"snyderM", "[", 
        RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "]"}], " ", "**", " ", 
       RowBox[{"snyderM", "[", 
        RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Nu]", ",", " ", 
       RowBox[{"\[Mu]", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"snyderCoef", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"SolveValues", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"NonCommutativeExpand", "[", 
          RowBox[{
           RowBox[{"Commutator", "[", 
            RowBox[{
             RowBox[{"xSquared", " ", "+", " ", 
              RowBox[{"snyderC", " ", "lorentzCasimir"}]}], ",", " ", 
             RowBox[{"snyderX", "[", "1", "]"}]}], "]"}], ",", " ", 
           "snyderAlgebra"}], "]"}], ",", " ", 
         RowBox[{"snyderX", "[", "1", "]"}]}], "]"}], " ", "==", " ", "0"}], ",",
       " ", "snyderC"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"snyderCasimirLabel", " ", "=", " ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<\.bd \>\"", ",", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<M\>\"", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}], ",", " ", 
      RowBox[{"Superscript", "[", 
       RowBox[{"\"\<M\>\"", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Style", "[", 
  RowBox[{
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"Prepend", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Outer", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"NonCommutativeExpand", "[", 
                    RowBox[{
                    RowBox[{"Commutator", "[", 
                    RowBox[{"#1", ",", " ", "#2"}], "]"}], ",", " ", 
                    "snyderAlgebra"}], "]"}], " ", "===", " ", "0"}], ",", 
                  " ", "0", ",", " ", "\"\<\[NotEqual] 0\>\""}], "]"}], " ", 
                "&"}], ",", "\n", "       ", 
               RowBox[{"{", 
                RowBox[{"xSquared", ",", " ", "lorentzCasimir", ",", " ", 
                 RowBox[{"xSquared", " ", "+", " ", 
                  RowBox[{"snyderCoef", " ", "lorentzCasimir"}]}]}], "}"}], ",",
                " ", "snyderGenerators"}], "]"}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Superscript", "[", 
                RowBox[{"\"\<x\>\"", ",", " ", "2"}], "]"}], ",", " ", 
               "snyderCasimirLabel", ",", " ", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Superscript", "[", 
                   RowBox[{"\"\<x\>\"", ",", " ", "2"}], "]"}], ",", 
                  " ", "\"\< + (\>\"", ",", " ", 
                  RowBox[{"snyderCoef", " ", "/.", " ", 
                   RowBox[{"snyderA", " ", "->", " ", "\"\<a\>\""}]}], ",", 
                  " ", "\"\<) \>\"", ",", " ", "snyderCasimirLabel"}], "}"}], 
                "]"}]}], "}"}]}], "}"}]}], "]"}], ",", "\n", "    ", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"Replace", "[", 
            RowBox[{"snyderGenerators", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"snyderX", "[", "\[Mu]_", "]"}], " ", ":>", " ", 
                RowBox[{"Superscript", "[", 
                 RowBox[{"\"\<x\>\"", ",", " ", "\[Mu]"}], "]"}]}], ",", " ", 
               
               RowBox[{
                RowBox[{"snyderM", "[", 
                 RowBox[{"\[Mu]_", ",", " ", "\[Nu]_"}], "]"}], " ", ":>", 
                " ", 
                RowBox[{"Superscript", "[", 
                 RowBox[{"\"\<M\>\"", ",", " ", 
                  RowBox[{"Row", "[", 
                   RowBox[{"{", 
                    RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "}"}], "]"}]}], 
                 "]"}]}]}], "}"}], ",", " ", 
             RowBox[{"{", "1", "}"}]}], "]"}], ",", 
           " ", "\"\<commutator with\>\""}], "]"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", " ", "1"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<[\>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<x\>\"", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\< + c \>\"", ",", " ", "snyderCasimirLabel", ",", 
        " ", "\"\<, \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<x\>\"", ",", " ", "1"}], "]"}], ",", 
        " ", "\"\<] = 0  \[DoubleLongRightArrow]  c = \>\"", ",", " ", 
        RowBox[{"snyderCoef", " ", "/.", " ", 
         RowBox[{"snyderA", " ", "->", " ", "\"\<a\>\""}]}]}], "}"}], "]"}], ",",
      " ", "Top"}], "]"}], ",", "\n", "  ", "16", ",", " ", 
   RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[142]:= ",
 CellID->1104954544,ExpressionUUID->"4d9f2ea4-63d9-1a42-40df-4c26a765cfc6"],

Cell[TextData[{
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00f8a290-d00e-2ed2-7420-7b3bdf81c4ef"],
 " and the Lorentz Casimir each commute with every ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["M", "TI"], 
   StyleBox[
    RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3797b7f8-6e69-8db5-19db-0c3d932129e5"],
 ", as Lorentz scalars must, but neither commutes with the coordinates. \
Commuting with one coordinate fixes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", "-", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d5b3a7c-db99-dd89-1489-ac478a6dd00a"],
 ", and that combination then commutes with all ten generators: Snyder's \
spacetime keeps a central quadratic element, the Minkowski ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4883bd25-b111-6447-52dc-87f4fbcd610e"],
 " corrected at order ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["a", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f8a404d-0ae3-ceed-7328-9c55546d8ab7"],
 "."
}], "Text",
 CellID->798099038,ExpressionUUID->"0c713cbf-b334-c8e7-2990-85579cd79136"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->33730070,ExpressionUUID->"143dc792-46b1-98f6-66b2-9e6300d04629"],

Cell["Dirac matrices for a curved metric", "Subsection",
 CellID->388274630,ExpressionUUID->"5fb7a5b1-ad8d-a73c-4c47-1eb73d32a484"],

Cell[TextData[{
 "At one point of a curved spacetime the metric ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["g", "TI"], 
   StyleBox[
    RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37b42d5d-f505-02a0-0f9f-90858caa79d0"],
 " is a real symmetric matrix, in general not diagonal, with ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "432e4933-1b63-d6fe-214d-2157c043a1e2"],
 " positive and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "-", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b602a5f-48f4-7931-1716-262d4e59561e"],
 " negative eigenvalues. Does the vielbein construction give gamma matrices \
obeying the Clifford relation and the flat-space contraction identities for \
every such metric?"
}], "Text",
 CellID->1418154533,ExpressionUUID->"5bb735d2-1f0e-2c8a-5a0c-69c73192f358"],

Cell[TextData[{
 "The gamma matrices must satisfy the Clifford relation, and a vielbein ",
 Cell[BoxData[
  StyleBox["e", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2995b471-9d7a-110a-028c-eef6fc7350d2"],
 " reduces ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "389f0161-d0a9-bd4d-0d98-f19deab32183"],
 " to its signature ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[PlusMinus]", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d6bb995-b684-ddc5-50b7-6e63eec11e86"],
 ":"
}], "Text",
 CellID->1862890903,ExpressionUUID->"1132b88b-8c29-3536-5aac-dcfafd294a84"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]]}], ",", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Nu]", "TI"]], "}", "=", "2", 
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "\|01d7d9"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["g", "TI"], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["T", "TI"]], 
     StyleBox["\[Eta]", "TI"], "\[ThinSpace]", 
     StyleBox["e", "TI"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["a", "TI"]], 
     SubscriptBox["", 
      StyleBox["\[Mu]", "TI"]], "\[ThinSpace]", 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox["a", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1915991694,ExpressionUUID->"0a4f8c89-a9e5-0e39-620e-96d0dafe196d"],

Cell[TextData[{
 "where the flat ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ccb8aba-a0e2-edd2-0869-2679730cb5e0"],
 " are ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{
    StyleBox["\[LeftFloor]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["n", "TI"], "/", "2"}], 
    StyleBox["\[RightFloor]",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e3fa568-d412-4f1f-42ae-ed0b577c65e0"],
 "-dimensional tensor products of Pauli matrices (the Brauer-Weyl \
construction), multiplied by ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fc5ef78-0ce5-a348-0143-f9ec17697ea7"],
 " where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox[
     RowBox[{"a", "a"}], "TI"]], "=", "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "607f5b85-7f12-e993-0027-06d9fa3f5486"],
 ". Indices are raised with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["g", "TI"], 
   StyleBox[
    RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bc2a7c6-4922-1c7e-0714-f6ffb925abb4"],
 ". Any real symmetric nondegenerate ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "778978d4-2a22-d6e3-144b-9c87af732244"],
 " has a real vielbein (Sylvester's law of inertia), and then"
}], "Text",
 CellID->659089340,ExpressionUUID->"104cd160-8fcc-f60e-134f-cda536ec531e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       SubscriptBox[
        StyleBox["\[Gamma]", "TI"], 
        StyleBox["\[Mu]", "TI"]]}], ",", 
      SubscriptBox[
       StyleBox["\[Gamma]", "TI"], 
       StyleBox["\[Nu]", "TI"]]}], "}"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["a", "TI"]], 
      SubscriptBox["", 
       StyleBox["\[Mu]", "TI"]], 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       StyleBox["b", "TI"]], 
      SubscriptBox["", 
       StyleBox["\[Nu]", "TI"]], 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["\[CapitalGamma]", 
         StyleBox["a", "TI"]], ",", 
        SubscriptBox["\[CapitalGamma]", 
         StyleBox["b", "TI"]]}], "}"}]}], "=", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["a", "TI"]], 
       SubscriptBox["", 
        StyleBox["\[Mu]", "TI"]], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["b", "TI"]], 
       SubscriptBox["", 
        StyleBox["\[Nu]", "TI"]], 
       SubscriptBox[
        StyleBox["\[Eta]", "TI"], 
        StyleBox[
         RowBox[{"a", "b"}], "TI"]], "\|01d7d9"}], "=", 
      RowBox[{"2", 
       SubscriptBox[
        StyleBox["g", "TI"], 
        StyleBox[
         RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "\|01d7d9"}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1449401252,ExpressionUUID->"75627499-f4d4-bb77-5e6f-53978a3467e5"],

Cell[TextData[{
 "while ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]], 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Nu]", "TI"]], 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox["b", "TI"]], 
     SubscriptBox["", 
      StyleBox["\[Nu]", "TI"]], "\[ThinSpace]", 
     SuperscriptBox["\[CapitalGamma]", 
      StyleBox["a", "TI"]], 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox["b", "TI"]], 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox["a", "TI"]]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", "-", 
       StyleBox["n", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     SubscriptBox[
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["\[Nu]", "TI"]]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a2aa156-cc7e-d340-1a42-e77762f37ebb"],
 " carries over from flat space."
}], "Text",
 CellID->768442916,ExpressionUUID->"3e3102a1-02c3-cc6f-11d7-a5a15a99ad34"],

Cell[TextData[{
 "The construction is tested on one random non-diagonal machine-number metric \
per ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fb617d1-235f-0456-6a4f-3f14af08c8ba"],
 ", with eigenvalue magnitudes between ",
 Cell[BoxData["0.1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75e5f509-07d8-44b8-59d0-fe37a2b43369"],
 " and ",
 Cell[BoxData["10"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f101423-c732-dff6-477f-93f318d24359"],
 ", for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "8"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22e2b2e3-32d9-8ff1-7ec1-1db0fe546311"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["p", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a04fab8-26fb-c612-2275-9ec784ce5934"],
 ", and for one exact integer metric. On the left, the anticommutators for \
one random non-diagonal Lorentzian metric are drawn as a ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1867b077-d0f2-4777-2105-ff335622e95b"],
 " grid of ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cc71eb0-f96e-8445-54c2-f4335b20e831"],
 " blocks beside ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox[
    StyleBox["g", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42bec380-b11f-e6fd-23cd-ae82255cf9e1"],
 ", on one color scale; on the right, each cell gives the error of the \
Clifford relation, relative to the largest metric entry, for one signature ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54309b5d-aeb9-77e8-37d1-19e1fcbb41ef"],
 ":"
}], "Text",
 CellID->1039513757,ExpressionUUID->"2b1a0a11-cf22-1408-5e23-9e28ab38a145"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", 
   RowBox[{"\"\<WolframQuantumComputation`DiracMatrix`\>\"", ",", 
    " ", "\"\</Users/mohammadb/Nextcloud/Mads/Quantum/DiracMatrix/\
DiracMatrixPackage/Kernel/DiracMatrix.wl\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gammaErrors", "[", 
    RowBox[{"n_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"RandomCurvedMetric", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"n", " ", "-", " ", "p"}], ",", " ", "1", ",", " ", "1"}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Gamma]", " ", "=", " ", 
         RowBox[{"GammaMatrices", "[", "g", "]"}]}], "}"}], ",", "\n", "   ", 
       
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Outer", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
                 RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
               "\[Gamma]", ",", " ", "\[Gamma]", ",", " ", "1"}], "]"}], " ", 
             "-", " ", 
             RowBox[{"2", " ", 
              RowBox[{"TensorProduct", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"Length", "[", 
                  RowBox[{"First", "[", "\[Gamma]", "]"}], "]"}], "]"}]}], 
               "]"}]}]}], "]"}], "]"}], "/", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "g", "]"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"MapThread", "[", 
                  RowBox[{
                   RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"up", ",", " ", "dn"}], "}"}], ",", " ", 
                    RowBox[{"up", " ", ".", " ", "#", " ", ".", " ", "dn"}]}],
                     "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Inverse", "[", "g", "]"}], " ", ".", " ", 
                    "\[Gamma]"}], ",", " ", "\[Gamma]"}], "}"}]}], "]"}], 
                 "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"2", " ", "-", " ", "n"}], ")"}], " ", "#"}]}], 
               "]"}], "]"}], "/", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", "#", "]"}], "]"}]}], " ", "&"}], " ", "/@", 
           " ", "\[Gamma]"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaResults", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"gammaErrors", "[", 
        RowBox[{"n", ",", " ", "p"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "2", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaExactMetric", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"-", "3"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaLorentz", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
     RowBox[{"RandomCurvedMetric", "[", 
      RowBox[{"1", ",", " ", "3", ",", " ", "1", ",", " ", "1"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaShade", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "gammaLorentz", "]"}], "]"}]}]}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ColorData", "[", "\"\<RedBlueTones\>\"", "]"}], "[", 
       RowBox[{"Rescale", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", 
           RowBox[{"-", "m"}]}], "}"}]}], "]"}], "]"}], " ", "&"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaBlocks", " ", "=", " ", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ArrayPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"ArrayFlatten", "[", 
              RowBox[{"Outer", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
                  RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ",
                 "#", ",", " ", "#", ",", " ", "1"}], "]"}], "]"}], "]"}], 
            " ", "&"}], "[", 
           RowBox[{"GammaMatrices", "[", "gammaLorentz", "]"}], "]"}], ",", 
          " ", 
          RowBox[{"ColorFunction", " ", "->", " ", "gammaShade"}], ",", " ", 
          RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", 
          "\n", "     ", 
          RowBox[{"Mesh", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"4", ",", " ", "8", ",", " ", "12"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"4", ",", " ", "8", ",", " ", "12"}], "}"}]}], "}"}]}], 
          ",", " ", 
          RowBox[{"MeshStyle", " ", "->", " ", "Gray"}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "260"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<{\>\"", ",", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Mu]\>\""}], "]"}],
               ",", " ", "\"\<, \>\"", ",", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Nu]\>\""}], "]"}],
               ",", " ", "\"\<}: 4 \[Times] 4 blocks of 4 \[Times] 4\>\""}], 
             "}"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
        RowBox[{"ArrayPlot", "[", 
         RowBox[{
          RowBox[{"2", " ", "gammaLorentz"}], ",", " ", 
          RowBox[{"ColorFunction", " ", "->", " ", "gammaShade"}], ",", " ", 
          RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", " ", 
          RowBox[{"Mesh", " ", "->", " ", "All"}], ",", " ", 
          RowBox[{"MeshStyle", " ", "->", " ", "Gray"}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "150"}], ",", " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<2\>\"", ",", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<g\>\"", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}]}],
              "}"}], "]"}]}]}], "]"}]}], "}"}], "}"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gammaMap", " ", "=", " ", 
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"n", " ", "=", " ", 
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], " ", "+", " ", "1"}]}], ",",
                 " ", 
                RowBox[{"p", " ", "=", " ", 
                 RowBox[{
                  RowBox[{"Last", "[", "#2", "]"}], " ", "-", " ", "1"}]}], ",",
                 " ", 
                RowBox[{"e", " ", "=", " ", 
                 RowBox[{"Log10", "[", 
                  RowBox[{"First", "[", "#1", "]"}], "]"}]}]}], "}"}], ",", 
              "\n", "       ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], "[", 
                 RowBox[{"Rescale", "[", 
                  RowBox[{"e", ",", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "17"}], ",", " ", 
                    RowBox[{"-", "14"}]}], "}"}]}], "]"}], "]"}], ",", " ", 
                RowBox[{"Rectangle", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"p", " ", "-", " ", "0.5"}], ",", " ", 
                    RowBox[{"n", " ", "-", " ", "0.5"}]}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"p", " ", "+", " ", "0.5"}], ",", " ", 
                    RowBox[{"n", " ", "+", " ", "0.5"}]}], "}"}]}], "]"}], ",",
                 " ", "Black", ",", " ", 
                RowBox[{"Text", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"NumberForm", "[", 
                    RowBox[{"e", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
                    "10"}], "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"p", ",", " ", "n"}], "}"}]}], "]"}]}], "}"}]}], 
             "]"}], " ", "&"}], ",", " ", "gammaResults", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", "2"}], "]"}], ",", 
       "\n", "     ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<positive eigenvalues p\>\"", ",", 
          " ", "\"\<dimension n\>\""}], "}"}]}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", " ", "8"}], "]"}], ",", " ", "None"}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "8"}], "]"}], ",", " ", "None"}], "}"}]}],
          "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "340"}], ",", "\n", "     ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<log\>\"", ",", " ", "10"}], "]"}], ",", 
           " ", "\"\< of the Clifford error, every signature\>\""}], "}"}], 
         "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"BarLegend", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<TemperatureMap\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "17"}], ",", " ", 
          RowBox[{"-", "14"}]}], "}"}]}], "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"gammaBlocks", ",", " ", "gammaMap"}], "}"}], "}"}], ",", " ", 
     
     RowBox[{"Spacings", " ", "->", " ", "4"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<random Lorentzian metric (left):  every block of \
{\>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Mu]\>\""}], "]"}], ",",
             " ", "\"\<, \>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Nu]\>\""}], "]"}], ",",
             " ", "\"\<} is 2\>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<g\>\"", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}], ",",
             " ", "\"\< times the identity\>\""}], "}"}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Mu]\>\""}], "]"}], ",",
             " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Nu]\>\""}], "]"}], ",",
             " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Mu]\>\""}], "]"}], ",",
             " ", "\"\< = (2 \[Minus] n)\>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Nu]\>\""}], "]"}], ",",
             " ", "\"\<:  largest relative error over all signatures \>\"", ",",
             " ", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"gammaResults", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "All", ",", " ", "2"}], "]"}], 
                "]"}], "]"}], ",", " ", "1"}], "]"}]}], "}"}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<exact metric \>\"", ",", " ", 
            RowBox[{"MatrixForm", "[", "gammaExactMetric", "]"}], ",", 
            " ", "\"\<:  Clifford residual = \>\"", ",", "\n", "       ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"RootReduce", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Outer", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
                    RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", 
                    " ", "#", ",", " ", "#", ",", " ", "1"}], "]"}], " ", 
                  "&"}], "[", 
                 RowBox[{"GammaMatrices", "[", "gammaExactMetric", "]"}], 
                 "]"}], " ", "-", " ", 
                RowBox[{"2", " ", 
                 RowBox[{"TensorProduct", "[", 
                  RowBox[{"gammaExactMetric", ",", " ", 
                   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}]}], 
               "]"}], "]"}], "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
       "Center"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[143]:= ",
 CellID->1517533830,ExpressionUUID->"71fa154a-679b-e0f6-4124-136497185776"],

Cell[TextData[{
 "Both relations hold to rounding error in every dimension and signature \
tried, and exactly for the integer metric. The identity above already \
guarantees them for every metric, so the figure tests that the vielbein and \
the flat ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53fbba8f-c142-ae2f-3e29-8de8521baab8"],
 " are built correctly, including for indefinite, non-diagonal metrics."
}], "Text",
 CellID->150003319,ExpressionUUID->"7a9b9a5e-86de-3e47-4aca-8682302bd37e"],

