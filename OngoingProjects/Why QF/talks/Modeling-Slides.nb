Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nfactRows", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Catenate", " ", "@", " ", 
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"First", "[", "#2", "]"}], ",", " ", "#1"}], "]"}], " ", 
       "&"}], ",", " ", "t"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nfactInput", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"PadRight", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", " ", "n"}], "]"}], ",", " ", "6"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nfactDist", "[", 
    RowBox[{"w_", ",", " ", "n_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Permanent", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"nfactRows", "[", "t", "]"}], ",", " ", 
          RowBox[{"Range", "[", "n", "]"}]}], "]"}], "]"}], "]"}], "^", "2"}],
      "]"}], "/", 
    RowBox[{"Times", " ", "@@", " ", 
     RowBox[{"(", 
      RowBox[{"t", "!"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nfactNetwork", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "61", "]"}], ";", " ", 
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"\"\<Random\>\"", "[", "6", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nfactW", " ", "=", " ", 
   RowBox[{"nfactNetwork", "[", "\"\<Unitary\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nfactStrip", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "]"}], " ", "==", 
               " ", "n"}], ",", " ", 
              RowBox[{"#2", "/", 
               RowBox[{"nfactDist", "[", 
                RowBox[{"nfactW", ",", " ", "n", ",", " ", 
                 RowBox[{"#1", "[", "\"\<Name\>\"", "]"}]}], "]"}]}]}], "}"}],
             " ", "&"}], ",", " ", 
           RowBox[{"nfactNetwork", "[", 
            RowBox[{"\"\<Probabilities\>\"", ",", " ", 
             RowBox[{"nfactInput", "[", "n", "]"}]}], "]"}]}], "]"}], ",", 
         " ", "Last"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"First", "[", "#1", "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"#2", ",", " ", 
              RowBox[{"Last", "[", "#1", "]"}]}], "}"}]}], "}"}], " ", "&"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", 
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"n", " ", "-", " ", "0.3"}], ",", " ", 
             RowBox[{"n", " ", "+", " ", "0.3"}], ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "r", "]"}], " ", "-", " ", "1"}]}], 
            "]"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nfactStrips", " ", "=", " ", 
   RowBox[{"nfactStrip", " ", "/@", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"2", ",", " ", "6"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Catenate", "[", 
      RowBox[{"Lookup", "[", 
       RowBox[{"nfactStrips", ",", " ", "False"}], "]"}], "]"}], ",", " ", 
     RowBox[{"Catenate", "[", 
      RowBox[{"Lookup", "[", 
       RowBox[{"nfactStrips", ",", " ", "True"}], "]"}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"Catenate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", " ", "-", " ", "0.4"}], ",", " ", 
            RowBox[{"n", "!"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", " ", "+", " ", "0.4"}], ",", " ", 
            RowBox[{"n", "!"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", " ", "+", " ", "0.5"}], ",", " ", "None"}], "}"}]}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "2", ",", " ", "6"}], "}"}]}], "]"}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Joined", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"False", ",", " ", "False", ",", " ", "True"}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic", ",", " ", "Dashed"}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "11"}], "}"}], ",", " ", "None"}], 
     "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<other patterns\>\"", ",", 
      " ", "\"\<fully bunched patterns\>\"", ",", " ", "\"\<n!\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"2", ",", " ", "6"}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<photons n\>\"", ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<P\>\"", ",", " ", "\"\<B\>\""}], "]"}], ",", 
         " ", "\"\< / \>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<P\>\"", ",", " ", "\"\<D\>\""}], "]"}]}], "}"}], 
       "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}]}], "Input",
 CellLabel->"In[113]:= ",
 CellID->704583478,ExpressionUUID->"025b23dd-425e-d4e5-4989-72acb30c502b"],

Cell[TextData[{
 "In the sampled network every fully bunched pattern sits on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "!"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1594b102-38ee-46d4-0f12-32bf1e36f227"],
 ", and every other pattern lies below it, spread over orders of magnitude. \
Since every row of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "776bc54b-9188-4b09-1660-1bc133b89d29"],
 " is the same, the factor ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "!"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4968a3c8-4e7b-b0cf-5014-7f8c19493f2f"],
 " holds for every ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a9a0038-bbf4-bb24-0422-5c5746bb7087"],
 ", not only the sampled one."
}], "Text",
 CellID->1369476392,ExpressionUUID->"27527761-72d4-53ab-42aa-29e189a77731"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->277042867,ExpressionUUID->"2e7ff842-5fd2-b486-4216-8e4fce037ef1"],

Cell["How often identical photons share an output port", "Subsection",
 CellID->1536358513,ExpressionUUID->"7a140c85-4036-8123-2eec-2a93cca191b5"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d90d9a7-02c1-43c3-7aa1-850c02655197"],
 " identical photons enter ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10be6ecb-f9bc-4ffc-2859-1d1dfaca643c"],
 " of the ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "433ab220-6305-2341-3fa8-6dc9d480221f"],
 " ports of a lossless network drawn from the Haar measure on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["m", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31b56615-5728-985d-5cbc-9abce073f523"],
 ", one per port. Averaged over networks, how likely is it that some port \
receives two or more photons, as ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0165ad89-fe6b-b267-733d-7fa97557619c"],
 " grows with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5287c524-77e7-98c3-5e9d-17c9b58036e5"],
 "?"
}], "Text",
 CellID->319899349,ExpressionUUID->"14a2efce-6939-9497-1f96-3060b029d81d"],

Cell[TextData[{
 "The Haar average of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   TemplateBox[{
     StyleBox["S", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["S", "TI"]},
    "Bra"], 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b7dcbf-27ea-365a-7702-771f31c38146"],
 " commutes with every network, and the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6253afd4-869f-b3d3-51af-60fa4d8ddba2"],
 "-photon states, ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["n", "TI"], "+", 
      StyleBox["m", "TI"], "-", "1"}], 
    StyleBox["n", "TI"]},
   "Binomial"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112096fa-e0e3-5c11-0698-495454699219"],
 " of them, carry an irreducible representation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["m", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78822e23-00ce-16a5-0646-a727dde14cd8"],
 ", so by Schur's lemma the average is the identity over that dimension: \
every output pattern is equally likely. Only ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["m", "TI"], 
    StyleBox["n", "TI"]},
   "Binomial"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac4b8c3-616b-daa3-54d9-c6edf834ed57"],
 " patterns have at most one photon per port, so"
}], "Text",
 CellID->651667775,ExpressionUUID->"249fe037-adfc-93b0-6200-9b5a98955047"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["P", "TI"], "_"], 
     StyleBox[
      RowBox[{"b", "u", "n", "c", "h"}], "TI"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], ",", 
      StyleBox["m", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{"1", "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["m", "TI"], 
       StyleBox["n", "TI"]},
      "Binomial"], 
     StyleBox["/",
      SpanMinSize->1,
      SpanMaxSize->1,
      FontSize->1.8 Inherited], 
     RowBox[{
      TemplateBox[{
        RowBox[{
          StyleBox["n", "TI"], "+", 
          StyleBox["m", "TI"], "-", "1"}], 
        StyleBox["n", "TI"]},
       "Binomial"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1529459309,ExpressionUUID->"1b045b33-ad08-e4cf-0dd8-028b28b8e64e"],

Cell[TextData[{
 "The law is drawn for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cc8f95e-b140-8260-406c-66c5b8ac9036"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47366695-3cfd-90ac-2c62-bbbf665f4795"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "4", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12be9c5c-e603-4de2-4315-2604d8346638"],
 " (lines), with its limit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "159a02cf-7328-dabc-5675-da73d34d2141"],
 " in closed form for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30978456-6533-bb95-3fac-d3f531fea916"],
 " and for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["c", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "663aa665-c1c8-e531-6dfc-ba5f0479d446"],
 " (dashed), against the average of the exact output probabilities over 400 \
Haar-random networks (markers):"
}], "Text",
 CellID->506308606,ExpressionUUID->"6adb7374-053d-f6ff-5524-8278a7d9f3c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"haarBunchLaw", "[", 
    RowBox[{"n_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     RowBox[{"Binomial", "[", 
      RowBox[{"m", ",", " ", "n"}], "]"}], "/", 
     RowBox[{"Binomial", "[", 
      RowBox[{
       RowBox[{"n", " ", "+", " ", "m", " ", "-", " ", "1"}], ",", " ", "n"}],
       "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"haarBunchLimits", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"haarBunchLaw", "[", 
        RowBox[{"n", ",", " ", "n"}], "]"}], ",", " ", 
       RowBox[{"n", " ", "->", " ", "Infinity"}]}], "]"}], ",", " ", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"haarBunchLaw", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"c", " ", 
          RowBox[{"n", "^", "2"}]}]}], "]"}], ",", " ", 
       RowBox[{"n", " ", "->", " ", "Infinity"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"c", " ", ">", " ", "0"}]}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"haarBunchModes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"#", " ", "&"}], ",", " ", 
     RowBox[{
      RowBox[{"#", "^", "2"}], " ", "&"}], ",", " ", 
     RowBox[{
      RowBox[{"4", " ", 
       RowBox[{"#", "^", "2"}]}], " ", "&"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"haarBunchSample", "[", 
    RowBox[{"n_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", 
      RowBox[{
       RowBox[{"100", " ", "n"}], " ", "+", " ", "m"}], "]"}], ";", "\n", 
     "   ", 
     RowBox[{"Mean", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Total", " ", "@", " ", 
         RowBox[{"KeySelect", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QuantumInterferometer", "[", 
             RowBox[{"\"\<Random\>\"", "[", "m", "]"}], "]"}], "[", 
            RowBox[{"\"\<Probabilities\>\"", ",", " ", 
             RowBox[{"PadRight", "[", 
              RowBox[{
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", "n"}], "]"}], ",", " ", "m"}], "]"}]}],
             "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", "[", "\"\<Name\>\"", "]"}], "]"}], " ", ">=", " ", 
             "2"}], " ", "&"}]}], "]"}]}], ",", " ", "400"}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", " ", 
           RowBox[{"haarBunchLaw", "[", 
            RowBox[{"n", ",", " ", 
             RowBox[{"f", "[", "n", "]"}]}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"f", ",", " ", "haarBunchModes"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "2", ",", " ", "12"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<m = n\>\"", ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<m = \>\"", ",", " ", 
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}], ",",
           " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<m = 4\>\"", ",", " ", 
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}]}], 
         "}"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "l"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"12", ",", " ", "l"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"First", "[", "haarBunchLimits", "]"}], ",", " ", 
             RowBox[{
              RowBox[{"Last", "[", "haarBunchLimits", "]"}], " ", "/.", " ", 
              RowBox[{"c", " ", "->", " ", "1"}]}], ",", " ", 
             RowBox[{
              RowBox[{"Last", "[", "haarBunchLimits", "]"}], " ", "/.", " ", 
              RowBox[{"c", " ", "->", " ", "4"}]}]}], "}"}]}], "}"}]}], "]"}],
        ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"n", ",", " ", 
              RowBox[{"haarBunchSample", "[", 
               RowBox[{"n", ",", " ", 
                RowBox[{"#1", "[", "n", "]"}]}], "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", "2", ",", " ", "#2"}], "}"}]}], "]"}], 
          " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"haarBunchModes", ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "3", ",", " ", "2"}], "}"}]}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "11"}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1.6", ",", " ", "12.4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.02"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<photons n\>\"", ",", 
        " ", "\"\<Haar-averaged probability of a shared port\>\""}], "}"}]}], 
     ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<n \[Rule] \[Infinity]:   m = n gives \>\"", ",", " ", 
        RowBox[{"First", "[", "haarBunchLimits", "]"}], ",", 
        " ", "\"\<,   m = c \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\< gives \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"Last", "[", "haarBunchLimits", "]"}], "]"}]}], "}"}], "]"}],
      ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[114]:= ",
 CellID->804492801,ExpressionUUID->"65da46d5-c536-c090-0d6e-43d3140222aa"],

Cell[TextData[{
 "A shared port becomes certain when the ports grow only as fast as the \
photons, while with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["c", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c300ff6-9fe3-fc74-7b7e-f8e9f29e355e"],
 " the probability stays below 1 and falls as ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c1a4144-854c-5dfa-1429-a71dda99e195"],
 " grows, so a large multiple of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08daefa9-54ba-bebc-49e4-dcfe96f4f4c9"],
 " ports keeps most detection events free of collisions at every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bd0ce1f-698d-f6cc-1118-6346a8f47c19"],
 ". The Haar averages of the exact probabilities fall on the law."
}], "Text",
 CellID->743528343,ExpressionUUID->"50ee22fc-1014-533b-1fc8-d92e02f95fe4"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2085942039,ExpressionUUID->"58781177-e0db-7098-48b6-74f4c4b54480"],

Cell["Twin Fock states on a balanced beam splitter", "Subsection",
 CellID->1959819487,ExpressionUUID->"40b1f908-d5c9-f5f3-697a-70b156bf5d05"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0696e519-f8f6-b6a7-5e54-167b075c66aa"],
 " photons enter each port of a balanced beam splitter. What is the \
probability of finding ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c5a81c-cc86-5bf0-52f6-16f9de81aa5a"],
 " photons in the first output, for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5124f3b3-b086-19ee-67c7-7c60df571225"],
 "?"
}], "Text",
 CellID->1053858642,ExpressionUUID->"13179bba-8b8b-4e2d-129c-8172e1859c96"],

Cell[TextData[{
 "The splitter maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d2117f8-3ecf-4375-2d72-48542027778a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "-", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b36dc99-ff24-cecd-1f31-a6a3868ef601"],
 ", so each input pair becomes ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "\[Rule]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", 
     RowBox[{"\[Dagger]", "2"}]], "-", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", 
     RowBox[{"\[Dagger]", "2"}]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dde6e5a-5136-58e7-6eaf-658520202e7d"],
 " and"
}], "Text",
 CellID->813754887,ExpressionUUID->"556fc97b-cac2-e583-152c-75aa2269971a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["n", "TI"], ",", 
       StyleBox["n", "TI"]}]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["n", "TI"]], 
      RowBox[{
       StyleBox["n", "TI"], "!"}]], 
     TemplateBox[{"0,0"},
      "Ket"]}], "\[Rule]", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["a", "TI"], "^"], "2", 
          RowBox[{"\[Dagger]", "2"}]], "-", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["a", "TI"], "^"], "1", 
          RowBox[{"\[Dagger]", "2"}]]}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["n", "TI"]], 
      RowBox[{
       RowBox[{
        SuperscriptBox["2", 
         StyleBox["n", "TI"]], "\[ThinSpace]", 
        StyleBox["n", "TI"]}], "!"}]], 
     RowBox[{
      TemplateBox[{"0,0"},
       "Ket"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1540781254,ExpressionUUID->"5a45f9e1-2bb6-0ac4-30a3-00ca092fd653"],

Cell[TextData[{
 "Only even ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], "1"], "=", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23b8fa5f-5419-9adf-6dfe-cedf8b034cde"],
 " occur, and the binomial expansion gives"
}], "Text",
 CellID->1975357238,ExpressionUUID->"6ccfcc0b-c595-98a9-06c3-0647dc4d62e0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["P", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       StyleBox["k", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     TemplateBox[{
       RowBox[{"2", 
         StyleBox["k", "TI"]}], 
       StyleBox["k", "TI"]},
      "Binomial"], 
     RowBox[{
      TemplateBox[{
        RowBox[{"2", 
          StyleBox["n", "TI"], "-", "2", 
          StyleBox["k", "TI"]}], 
        RowBox[{
          StyleBox["n", "TI"], "-", 
          StyleBox["k", "TI"]}]},
       "Binomial"], 
      StyleBox["/",
       SpanMinSize->1,
       SpanMaxSize->1,
       FontSize->1.8 Inherited], 
      SuperscriptBox["4", 
       StyleBox["n", "TI"]]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["P", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       StyleBox["k", "TI"], "+", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"0", "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1066375057,ExpressionUUID->"1de71869-a3d0-0fa2-5aa9-8fbd8e96e614"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bcf61c4-f308-6b88-65d3-5f197ce91141"],
 " for general ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39566335-9969-0eec-6c09-506543fa754b"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65dcf5aa-aa8a-76b1-4580-ad4d97b53a48"],
 " comes out in closed form (solid line), against the law (dashed), the exact \
probabilities of every output ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], "1"], "=", "0"}], ",", "\[Ellipsis]", ",", 
   RowBox[{"2", 
    StyleBox["n", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "081020f4-aeb9-47d4-01fc-2abdd8c0bfa9"],
 " (markers), and the large-",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0260566d-e7e1-7df9-669c-6091c369024f"],
 " limit ",
 Cell[BoxData[
  RowBox[{"1", "/", "(", 
   RowBox[{"\[Pi]", 
    SqrtBox[
     RowBox[{
      StyleBox["k", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["n", "TI"], "-", 
       StyleBox["k", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}]]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dd4d580-4255-0147-7ecf-f7237eece40f"],
 " (dotted):"
}], "Text",
 CellID->2011553683,ExpressionUUID->"6ea93a3a-1d59-92aa-004d-7a889630670c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"twinFockLaw", "[", 
    RowBox[{"n_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Binomial", "[", 
     RowBox[{
      RowBox[{"2", " ", "k"}], ",", " ", "k"}], "]"}], " ", 
    RowBox[{
     RowBox[{"Binomial", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"n", " ", "-", " ", "k"}], ")"}]}], ",", " ", 
       RowBox[{"n", " ", "-", " ", "k"}]}], "]"}], "/", 
     RowBox[{"4", "^", "n"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"twinFockSplitter", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"\[Pi]", "/", "4"}], "]"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"twinFockQF", " ", "=", " ", 
   RowBox[{"twinFockSplitter", "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", " ", "k"}], ",", " ", 
        RowBox[{
         RowBox[{"2", " ", "n"}], " ", "-", " ", 
         RowBox[{"2", " ", "k"}]}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"twinFockPanel", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "]"}], ",", " ", 
            "#2"}], "}"}], " ", "&"}], ",", " ", 
         RowBox[{"twinFockSplitter", "[", 
          RowBox[{"\"\<Probabilities\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "m"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "j"}], ",", " ", 
           RowBox[{"twinFockQF", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n", " ", "->", " ", "m"}], ",", " ", 
              RowBox[{"k", " ", "->", " ", "j"}]}], "}"}]}]}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "m"}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "j"}], ",", " ", 
           RowBox[{"twinFockLaw", "[", 
            RowBox[{"m", ",", " ", "j"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", "m"}], "}"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u", ",", " ", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"\[Pi]", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{"u", "/", "2"}], " ", 
                RowBox[{"(", 
                 RowBox[{"m", " ", "-", " ", 
                  RowBox[{"u", "/", "2"}]}], ")"}]}], "]"}]}], ")"}]}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"u", ",", " ", 
           RowBox[{
            RowBox[{"Subdivide", "[", 
             RowBox[{"0.", ",", " ", 
              RowBox[{"2", " ", "m"}], ",", " ", "200"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", " ", ";;", " ", 
              RowBox[{"-", "2"}]}], "]"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"Joined", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "False", ",", " ", "True", ",", " ", "True", ",", " ", "True"}], 
       "}"}]}], ",", " ", 
     RowBox[{"Filling", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", " ", "->", " ", "Axis"}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "Automatic", ",", " ", "Automatic", ",", " ", "Dashed", ",", " ", 
        "Dotted"}], "}"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "9"}], "}"}], ",", " ", "None", ",", 
        " ", "None", ",", " ", "None"}], "}"}]}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<QF, every output\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<QF, symbolic n, at \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<t\>\"", ",", " ", "\"\<1\>\""}], "]"}], ",", 
           " ", "\"\< = 2k\>\""}], "}"}], "]"}], ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<law at \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<t\>\"", ",", " ", "\"\<1\>\""}], "]"}], ",", 
           " ", "\"\< = 2k\>\""}], "}"}], "]"}], ",", 
        " ", "\"\<large-n limit\>\""}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.5"}], ",", " ", 
          RowBox[{
           RowBox[{"2", " ", "m"}], " ", "+", " ", "0.5"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.012"}], ",", " ", 
          RowBox[{"1.15", " ", 
           RowBox[{"twinFockLaw", "[", 
            RowBox[{"m", ",", " ", "0"}], "]"}]}]}], "}"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "   ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<t\>\"", ",", " ", "\"\<1\>\""}], "]"}], ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<P(\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<t\>\"", ",", " ", "\"\<1\>\""}], "]"}], ",", 
           " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<n = \>\"", ",", " ", "m"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"twinFockPanels", " ", "=", " ", 
   RowBox[{"twinFockPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "5", ",", " ", "10"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"First", " ", "/@", " ", "twinFockPanels"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "twinFockPanels", "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<QF for symbolic n and k:   P(2k) = \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", "twinFockQF", "]"}]}], "}"}], "]"}], ",",
      " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[115]:= ",
 CellID->374286201,ExpressionUUID->"719d6503-4d1e-80e9-19c5-50ab928445e0"],

Cell[TextData[{
 "Every odd output is exactly zero, and the even outputs, for general ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574df9b1-7e2c-170a-1640-e013af1be9ed"],
 " and numeric, lie on the law for each ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c72f892-bd2f-2503-3c96-e18e38d6100c"],
 ". The distribution is largest at the edges and smallest near the middle, \
the shape of the limit it approaches as ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1231ca65-3cdb-8cf1-6c64-13c0566172d9"],
 " grows, so the likeliest outcome sends all ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e9ff0dc-6bde-1f24-3806-1be5dd6c9aed"],
 " photons out of one port."
}], "Text",
 CellID->198070893,ExpressionUUID->"77c397df-2552-1d7f-3396-3ae287d3ede8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1687877023,ExpressionUUID->"3591466d-7cc8-39f2-660c-f7f9a8a60c70"],

Cell["Exact beam-splitter settings for an exact interferometer", "Subsection",
 CellID->1427608515,ExpressionUUID->"5b55256e-91b6-7511-6813-444e122d4512"],

Cell[TextData[{
 "A lossless interferometer on ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54d91de1-5ae1-49b2-3767-d7e2642dd071"],
 " modes is fixed by its unitary transfer matrix ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c940ee3-24a6-26a8-656a-669a1f941e5f"],
 ", here the discrete Fourier matrices ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55b25243-5b01-081c-3754-ba54e4520a36"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200da0ac-49d9-f085-24dd-52e64fed0fba"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["m", "TI"]], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"2", "\[Pi]", 
     StyleBox["i", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["j", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["k", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1], "/", 
     StyleBox["m", "TI"]}]], "/", 
   SqrtBox[
    StyleBox["m", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c6a1ca4-dc9d-9c2d-103a-2f71d80a651b"],
 ". Any such ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "764c1288-6800-f712-549e-4c7feb889a04"],
 " can be built from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39429f34-7337-e521-720c-6767d894a415"],
 " beam splitters and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7284ecca-314d-5c34-1fa9-893860f15f05"],
 " phase shifters. When ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "381eb09b-dfbb-f737-52e3-0b0854284393"],
 " is known exactly, are the splitter settings exact numbers too?"
}], "Text",
 CellID->270741869,ExpressionUUID->"069cd45d-7098-84cb-3a80-0dba90893dcb"],

Cell[TextData[{
 "The network maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], "\[Rule]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["j", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c11d34-42bc-9b04-34b0-3bb8c69f3c1b"],
 ". A splitter on modes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], ",", 
   StyleBox["q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "577119ca-88ba-2784-3a61-6cdd4883f86d"],
 " acts there by the block"
}], "Text",
 CellID->1309142833,ExpressionUUID->"5245026e-a43b-7597-699c-58cb95b225a4"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["B", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
    StyleBox[")",
     SpanMaxSize->1], "=", "(", GridBox[{
      {
       RowBox[{
        StyleBox["cos",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"]}], 
       RowBox[{"-", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
          StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
        StyleBox["sin",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"]}]},
      {
       RowBox[{
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
        StyleBox["sin",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"]}], 
       RowBox[{
        StyleBox["cos",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"]}]}
     }], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->826383699,ExpressionUUID->"69144491-1100-a018-4491-04bbb1d10f24"],

Cell[TextData[{
 "and a phase shifter multiplies one mode by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "\[Alpha]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a70bfd9-7219-79d4-42fc-d58d51cac51b"],
 ". Each splitter of the mesh is chosen to null one entry of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4df6feed-18fa-f658-5516-24f251406148"],
 ", so its ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17d7e653-b409-6cd1-6622-684b7b9767f1"],
 " is an arctangent of a ratio of moduli of entries and its ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a401720-7322-cc2a-643c-7d42bff453e6"],
 " a difference of their arguments."
}], "Text",
 CellID->864172893,ExpressionUUID->"1e8c7472-878f-5a82-1086-2d556ba78c8e"],

Cell[TextData[{
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37e0600f-09de-75e1-3491-855e84c1eed1"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bec2657-d7f3-37c0-6f9a-dee13ca714c0"],
 " are decomposed into a Clements mesh, the settings reduced, and the rebuilt \
mesh compared with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a748eba-baf4-9f3a-149a-0759176b854e"],
 ":"
}], "Text",
 CellID->162276337,ExpressionUUID->"016b11b8-f80c-0718-0aa4-1a756fd31118"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"meshSettings", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"QuantumInterferometer", "[", 
         RowBox[{"FourierMatrix", "[", "m", "]"}], "]"}], 
        "[", "\"\<Elements\>\"", "]"}], "]"}], " ", "/.", " ", 
      RowBox[{
       RowBox[{"Arg", "[", "r_Root", "]"}], " ", ":>", " ", 
       RowBox[{"Arg", "[", 
        RowBox[{"ToRadicals", "[", 
         RowBox[{"RootReduce", "[", 
          RowBox[{"r", "/", 
           RowBox[{"Abs", "[", "r", "]"}]}], "]"}], "]"}], "]"}]}]}], "]"}], 
    " ", "/.", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"t_", ",", " ", "f_"}], "]"}], " ", ":>", " ", 
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{"f", ",", " ", 
           RowBox[{"2", " ", "\[Pi]"}]}], "]"}]}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<PS\>\"", "[", "f_", "]"}], " ", ":>", " ", 
       RowBox[{"\"\<PS\>\"", "[", 
        RowBox[{"Mod", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"2", " ", "\[Pi]"}]}], "]"}], "]"}]}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"meshRow", "[", 
    RowBox[{
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"t_", ",", " ", "f_"}], "]"}], " ", "->", " ", "q_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<splitter\>\"", ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"q", ",", " ", "\"\<, \>\""}], "]"}], ",", " ", 
     RowBox[{"TraditionalForm", "[", "t", "]"}], ",", " ", 
     RowBox[{"TraditionalForm", "[", "f", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"meshRow", "[", 
    RowBox[{
     RowBox[{"\"\<PS\>\"", "[", "f_", "]"}], " ", "->", " ", "q_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<phase\>\"", ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"q", ",", " ", "\"\<, \>\""}], "]"}], ",", " ", "\"\<\>\"", ",",
      " ", 
     RowBox[{"TraditionalForm", "[", "f", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"meshPanel", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"el", " ", "=", " ", 
       RowBox[{"meshSettings", "[", "m", "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mesh", " ", "=", " ", 
         RowBox[{"QuantumInterferometer", "[", 
          RowBox[{"el", ",", " ", "m"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"Labeled", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"mesh", "[", 
              RowBox[{"\"\<Diagram\>\"", ",", " ", 
               RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}], ",", 
             "\n", "      ", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Grid", "[", 
                RowBox[{
                 RowBox[{"Prepend", "[", 
                  RowBox[{
                   RowBox[{"meshRow", " ", "/@", " ", "el"}], ",", " ", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<element\>\"", ",", " ", "\"\<modes\>\"", ",",
                     " ", "\"\<\[Theta]\>\"", ",", 
                    " ", "\"\<\[CurlyPhi] or \[Alpha]\>\""}], "}"}]}], "]"}], 
                 ",", " ", 
                 RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
                 RowBox[{"Spacings", " ", "->", " ", 
                  RowBox[{"{", 
                   RowBox[{"1.5", ",", " ", "0.6"}], "}"}]}]}], "]"}], ",", 
               " ", "13", ",", " ", 
               RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
              "]"}]}], "}"}], ",", " ", "Center", ",", " ", 
           RowBox[{"Spacer", "[", "10", "]"}]}], "]"}], ",", "\n", "    ", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             
             RowBox[{"\"\<m = \>\"", ",", " ", "m", ",", 
              " ", "\"\<:   rebuilt mesh equals \>\"", ",", " ", 
              RowBox[{"Subscript", "[", 
               RowBox[{"\"\<F\>\"", ",", " ", "m"}], "]"}], ",", 
              " ", "\"\<:  \>\"", ",", " ", 
              RowBox[{"AllTrue", "[", 
               RowBox[{
                RowBox[{"Flatten", " ", "@", " ", 
                 RowBox[{"FullSimplify", "[", 
                  RowBox[{
                   RowBox[{"mesh", "[", "\"\<Unitary\>\"", "]"}], " ", "-", 
                   " ", 
                   RowBox[{"FourierMatrix", "[", "m", "]"}]}], "]"}]}], ",", 
                " ", 
                RowBox[{
                 RowBox[{"#", " ", "===", " ", "0"}], " ", "&"}]}], "]"}]}], 
             "}"}], "]"}], ",", " ", "13", ",", " ", 
           RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
          "]"}], ",", " ", "Top"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"meshPanel", "[", "3", "]"}], ",", " ", 
      RowBox[{"meshPanel", "[", "4", "]"}]}], "}"}], "}"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Center", ",", " ", "Top"}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "4"}]}], "]"}]}], "Input",
 CellLabel->"In[116]:= ",
 CellID->1877922966,ExpressionUUID->"1d5bd6dd-ba9f-b647-36ce-beaf194f9262"],

Cell[TextData[{
 "Every setting of both meshes comes out in closed form, the phases as \
rational multiples of ",
 Cell[BoxData["\[Pi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67694ab1-00f0-ace1-571c-a3f1c3a9c41e"],
 ", and the mesh rebuilt from them equals ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["m", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313b3d41-2249-7ffc-4320-b51e02d7bff6"],
 " exactly, so the decomposition is exact algebra, not a numerical fit."
}], "Text",
 CellID->18554549,ExpressionUUID->"0cd882ff-335d-12a0-2b7f-58283eb5ed5a"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1007398793,ExpressionUUID->"2ea46d9c-1373-c8fb-53f0-1b9c9134c444"],

Cell["\<\
A beam splitter in the ladder-operator algebra, with no photon cutoff\
\>", "Subsection",
 CellID->582675098,ExpressionUUID->"2eeecf76-03b9-a0a9-2d7b-20448cf1c8b0"],

Cell[TextData[{
 "Two modes with annihilation operators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1"], ",", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3732da22-0d92-10d2-3d5f-b0dbfc909dd0"],
 " meet on a beam splitter with mixing angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c1fdbc9-745c-3984-0715-c62b72d82038"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "171d237b-8c85-1f7e-7856-c0225860da7b"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b060e7d-95e9-abf5-4960-30dcffe72d9a"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13a8970c-6688-c396-766e-8685ca75c36b"],
 " photons enter. Without truncating the Fock space, what does the splitter \
do to the creation operators?"
}], "Text",
 CellID->141972239,ExpressionUUID->"5d5a0f51-b8e4-78ea-759d-82a365dadf65"],

Cell[TextData[{
 "The splitter is ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["B", "TI"], "^"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    OverscriptBox[
     StyleBox["G", "TI"], "^"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c01a074-e655-45d6-5397-6f3ccf881cea"],
 " with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["G", "TI"], "^"], "=", 
   StyleBox["\[Theta]", "TI"], "(", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1"], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "-", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d9ea68-0dab-f074-0dae-a3b9231711f4"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["j", "TI"]], ",", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["k", "TI"], "\[Dagger]"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["\[Delta]", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a743bc-dcf6-1363-3c98-0b7f2b237b9b"],
 ". By ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    OverscriptBox[
     StyleBox["G", "TI"], "^"]], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     OverscriptBox[
      StyleBox["G", "TI"], "^"]}]], "=", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], "+", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["G", "TI"], "^"], ",", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["k", "TI"], "\[Dagger]"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   FractionBox["1", 
    RowBox[{"2", "!"}]], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["G", "TI"], "^"], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["G", "TI"], "^"], ",", 
      SubsuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], 
       StyleBox["k", "TI"], "\[Dagger]"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", "\[Ellipsis]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68fe2471-b98f-4ccd-790f-825891574801"],
 ", if ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["G", "TI"], "^"], ",", "\[CenterDot]"}], "\[ThinSpace]", 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "757324b9-721e-f834-3037-5bc8043aee84"],
 " maps ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], ",", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2762c743-ae8f-a18e-7435-687b3faa5c65"],
 " linearly by a matrix ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "053d1bdf-4e78-b0c3-41db-06157472a8f3"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"], "\[Rule]", 
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    StyleBox["j", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b8847c9-0d10-b961-2c8a-66d030683f59"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["M", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156c7a08-8451-3c27-06b1-a5b52ea86cb6"],
 ". The vacuum stays put, so ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["n", "TI"], "2"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cbe6186-d307-5ccf-25c7-f9df9da9add7"],
 " leaves as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       RowBox[{
        StyleBox["j", "TI"], "1"}]], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SubscriptBox[
     StyleBox["n", "TI"], "1"]], 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        StyleBox["j", "TI"],
        LimitsPositioning->False], 
       SubscriptBox[
        StyleBox["W", "TI"], 
        RowBox[{
         StyleBox["j", "TI"], "2"}]], 
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["j", "TI"]]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     SubscriptBox[
      StyleBox["n", "TI"], "2"]], "/", 
    SqrtBox[
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], "1"], "!"}], "\[ThinSpace]", 
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], "2"], "!"}]}]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bbd3803-5fa7-c67e-3d5d-9231ee2327de"],
 " with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fe108fd-b0ef-8ff0-4701-c61bd5db66c7"],
 " standing for ",
 Cell[BoxData[
  SubsuperscriptBox[
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["j", "TI"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "430a400d-1936-2d86-0320-8a0099050cef"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["x", "TI"], "1", 
    SubscriptBox[
     StyleBox["t", "TI"], "1"]], 
   SubsuperscriptBox[
    StyleBox["x", "TI"], "2", 
    SubscriptBox[
     StyleBox["t", "TI"], "2"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29907563-f181-3fc5-5525-c875118dd12b"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], "1"], "!"}], "\[ThinSpace]", 
     RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], "2"], "!"}]}]], 
   TemplateBox[{
     RowBox[{
       SubscriptBox[
        StyleBox["t", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["t", "TI"], "2"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "338b8ce6-f0a0-7ae0-493d-2fe0ccfb45f3"],
 "."
}], "Text",
 CellID->1417091685,ExpressionUUID->"297e188f-95ee-1227-19ab-f6d5b55cb18b"],

Cell[TextData[{
 "The commutators for general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64748b46-e519-e51c-2fba-df6839d74d44"],
 " give ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox["M", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "016f489e-70c5-84a7-68dd-2aaf53f9a8ce"],
 ", compared with the network's transfer matrix; the curves are the \
probabilities of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55fb5c2c-5265-6623-679d-4625fadcd83a"],
 " photons in output 1 read off the polynomial, and the markers the \
Fock-space beam-splitter operator at ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05ea62ed-669e-b1bc-585d-de680c8b8362"],
 ":"
}], "Text",
 CellID->358457159,ExpressionUUID->"4791e55d-0ac2-25d6-0553-e6a77e08e7fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"algBSVars", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"FieldVariables", "[", "\[FormalA]", "]"}], ",", " ", 
     RowBox[{"FieldVariables", "[", "\[FormalB]", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"algBSGen", " ", "=", " ", 
   RowBox[{"\[Theta]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "\[CurlyPhi]"}], "]"}], " ", 
       RowBox[{
        RowBox[{"algBSVars", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "**", " ", 
        RowBox[{"algBSVars", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[CurlyPhi]"}], "]"}], " ", 
       RowBox[{
        RowBox[{"algBSVars", "[", 
         RowBox[{"[", "2", "]"}], "]"}], " ", "**", " ", 
        RowBox[{"algBSVars", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"algBSComm", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"BosonicNormalOrder", "[", 
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{"algBSGen", ",", " ", "#"}], "]"}], ",", " ", "algBSVars", ",",
        " ", 
       RowBox[{"\"\<Scalars\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "}"}]}]}], "]"}], " ",
      "&"}], " ", "/@", " ", 
    RowBox[{"algBSVars", "[", 
     RowBox[{"[", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"algBSW", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"algBSVars", "[", 
           RowBox[{"[", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "4"}], "}"}], "]"}], "]"}]}], "]"}], " ", 
        "&"}], " ", "/@", " ", "algBSComm"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"algBSProb", "[", 
    RowBox[{"{", 
     RowBox[{"n1_", ",", " ", "n2_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalX]", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"KeySort", " ", "@", " ", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"First", "[", "#1", "]"}], " ", "->", " ", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "#2", "]"}], "^", "2"}], " ", 
              RowBox[{
               RowBox[{"Times", " ", "@@", " ", 
                RowBox[{"(", 
                 RowBox[{"#1", "!"}], ")"}]}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"n1", "!"}], " ", 
                 RowBox[{"n2", "!"}]}], ")"}]}]}], ",", " ", 
             RowBox[{"Element", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "}"}], ",", 
               " ", "Reals"}], "]"}]}], "]"}]}], ")"}], " ", "&"}], " ", "@@@",
         "\n", "     ", 
        RowBox[{"CoefficientRules", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", ".", " ", 
               RowBox[{"algBSW", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ")"}], "^", 
             "n1"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", " ", ".", " ", 
               RowBox[{"algBSW", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ")"}], "^", 
             "n2"}]}], "]"}], ",", " ", "x"}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"algBSFock", "[", 
    RowBox[{"{", 
     RowBox[{"n1_", ",", " ", "n2_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"n1", " ", "+", " ", "n2", " ", "+", " ", "1"}]}], "}"}], ",", 
     " ", 
     RowBox[{"Transpose", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"pr", " ", "=", " ", 
            RowBox[{"ArrayReshape", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"BeamSplitterOperator", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"t", ",", " ", 
                    RowBox[{"\[Pi]", "/", "3"}]}], "}"}], ",", " ", "d"}], 
                 "]"}], "[", 
                RowBox[{"FockState", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"n1", ",", " ", "n2"}], "}"}], ",", " ", "d"}], 
                 "]"}], "]"}], "[", "\"\<ProbabilitiesList\>\"", "]"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "}"}], ",", 
          "\n", "      ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t", ",", " ", 
              RowBox[{"pr", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"j", " ", "+", " ", "1"}], ",", " ", 
                 RowBox[{
                 "n1", " ", "+", " ", "n2", " ", "-", " ", "j", " ", "+", " ",
                   "1"}]}], "]"}], "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "0", ",", " ", 
              RowBox[{"n1", " ", "+", " ", "n2"}]}], "}"}]}], "]"}]}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0.", ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"\[Pi]", "/", "2"}], "]"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"\[Pi]", "/", "16"}], "]"}]}], "}"}]}], "]"}]}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"algBSPanel", "[", "in_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Values", "[", 
         RowBox[{"algBSProb", "[", "in", "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
         RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<t\>\"", ",", " ", "1"}], "]"}], ",", 
             " ", "\"\< = \>\"", ",", " ", "j"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", 
            RowBox[{"Total", "[", "in", "]"}]}], "}"}]}], "]"}]}]}], "]"}], ",",
      "\n", "    ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"algBSFock", "[", "in", "]"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}], ",", 
     " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", " ", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"TraditionalForm", "[", "#", "]"}], ",", " ", 
                RowBox[{"FractionBoxOptions", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], 
               "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"\[Pi]", "/", "2"}], ",", " ", 
             RowBox[{"\[Pi]", "/", "8"}]}], "]"}]}], ",", " ", "None"}], 
         "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Theta]\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<P(\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<t\>\"", ",", " ", "1"}], "]"}], ",", 
           " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<input  |\>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<n\>\"", ",", " ", "1"}], "]"}], ",", " ", "\"\<, \>\"",
          ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<n\>\"", ",", " ", "2"}], "]"}], ",", 
         " ", "\"\<\:27e9 = |\>\"", ",", " ", 
         RowBox[{"in", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<, \>\"", ",", " ", 
         RowBox[{"in", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<\:27e9\>\""}], "}"}],
        "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"algBSPanels", " ", "=", " ", 
   RowBox[{"algBSPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"algBSCoef", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"MatchQ", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"Times", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "__"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Minus]\>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"-", "c"}], "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"TraditionalForm", "[", "c", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", "algBSPanels"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"Last", "[", "algBSPanels", "]"}], "]"}], "]"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<[G, \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<a\>\"", ",", " ", "1"}], "]"}], ",", 
          " ", "\"\<\[Dagger]\>\""}], "]"}], ",", " ", "\"\<] = \>\"", ",", 
        " ", 
        RowBox[{"algBSCoef", "[", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"algBSComm", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"algBSVars", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "]"}], "]"}], ",", 
        " ", "\"\< \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<a\>\"", ",", " ", "2"}], "]"}], ",", 
          " ", "\"\<\[Dagger]\>\""}], "]"}], ",", "\n", 
        "     ", "\"\<,   [G, \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<a\>\"", ",", " ", "2"}], "]"}], ",", 
          " ", "\"\<\[Dagger]\>\""}], "]"}], ",", " ", "\"\<] = \>\"", ",", 
        " ", 
        RowBox[{"algBSCoef", "[", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"algBSComm", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
           RowBox[{"algBSVars", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], ",", 
        " ", "\"\< \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<a\>\"", ",", " ", "1"}], "]"}], ",", 
          " ", "\"\<\[Dagger]\>\""}], "]"}], ",", "\n", 
        "     ", "\"\<,     \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<e\>\"", ",", " ", "\"\<M\>\""}], "]"}], ",", 
        " ", "\"\< = W of QuantumInterferometer:  \>\"", ",", " ", 
        RowBox[{"algBSW", " ", "===", " ", 
         RowBox[{
          RowBox[{"QuantumInterferometer", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<BS\>\"", "[", 
             RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], "}"}], 
           "]"}], "[", "\"\<Unitary\>\"", "]"}]}]}], "}"}], "]"}], ",", " ", 
     "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[117]:= ",
 CellID->1534041370,ExpressionUUID->"03f4b811-cfe4-902d-35cf-8e513a75d355"],

Cell[TextData[{
 "The commutator turns each creation operator into a multiple of the other, \
so the whole series sums to the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59e02925-12c7-1097-2366-d121eb2907eb"],
 " transfer matrix and the splitter simply rotates ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], ",", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51c408c9-c3ba-38b3-737b-4645d0bf099b"],
 ". The output amplitudes are then coefficients of a polynomial of degree ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1509322d-927c-899c-36f3-12c30ed8c3f3"],
 ", and their squares need no value of ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d74ee35-f470-529d-365b-9e2a9e5a918e"],
 " and sit on the Fock-space markers for each input shown, although no \
photon-number cutoff entered the algebra."
}], "Text",
 CellID->1456182760,ExpressionUUID->"25af38cb-ff8d-1656-0b3b-66b7fe1b43ff"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1554713878,ExpressionUUID->"4d65d272-c806-54ba-37ae-73f007bf890f"],

Cell["Heralding a state from one photon and coherent light", "Subsection",
 CellID->610389718,ExpressionUUID->"0c690b04-7028-f2f6-553b-e387a8612ae2"],

Cell[TextData[{
 "One photon enters port 1 of a beam splitter with mixing angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16dcc12e-3811-e5c8-1166-260c4ed68151"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75fb32e2-4c72-c2df-2b57-e1371bae3f7d"],
 ", and a coherent state ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["\[Beta]", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a586f02-ced9-1135-67f8-e74401dd5c76"],
 " with complex ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b7b86b-84b6-f967-5674-2b6539260cb5"],
 " enters port 2. A photon counter on output 1 registers exactly one photon. \
What state does that leave in output 2?"
}], "Text",
 CellID->215552757,ExpressionUUID->"35324d72-790e-f106-520c-64d94170be2c"],

Cell[TextData[{
 "The splitter maps ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "\[Rule]", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], "+", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "2", "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c27a9f-7a97-b519-64d5-c513d6715788"],
 " and splits the coherent amplitude into ",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   StyleBox["\[Beta]", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3899f52a-1c4f-e069-18a4-82a578ce45c8"],
 " in output 1 and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "222a0934-b954-2390-1b21-12da4611570a"],
 " in output 2. Projecting output 1 onto ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11c48253-aab7-5b52-2e80-909987a062ef"],
 " keeps two terms, the photon transmitted with the coherent part giving no \
photon, or the photon reflected with the coherent part giving one, so the \
unnormalized state of output 2 is"
}], "Text",
 CellID->467151286,ExpressionUUID->"24903417-e080-059f-3790-03a2ff895e49"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       SuperscriptBox[GridBox[{
          {
           StyleBox["\[Beta]", "TI"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
       SuperscriptBox[
        StyleBox["sin",
         FontSlant->"Plain"], "2"], "\[ThinSpace]", 
       StyleBox["\[Theta]", "TI"], "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        StyleBox["cos",
         FontSlant->"Plain"], 
        StyleBox["\[Theta]", "TI"]}], "-", 
       RowBox[{
        StyleBox["\[Beta]", "TI"], 
        SuperscriptBox[
         StyleBox["sin",
          FontSlant->"Plain"], "2"], 
        StyleBox["\[Theta]", "TI"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "\[Dagger]"]}]}], ")"}], 
     TemplateBox[{
       RowBox[{
         StyleBox["\[Beta]", "TI"], 
         StyleBox["cos", FontSlant -> "Plain"], 
         StyleBox["\[Theta]", "TI"]}]},
      "Ket"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->958921077,ExpressionUUID->"365f2cfb-e326-97f9-37e8-c4342f208475"],

Cell[TextData[{
 "with the phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25ac6feb-596f-4203-0f14-8740c8c9cd5f"],
 " cancelling between the two terms. Since ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    TemplateBox[{
      StyleBox["\[Gamma]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    OverscriptBox[
     StyleBox["D", "TI"], "^"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       OverscriptBox[
        StyleBox["a", "TI"], "^"], "\[Dagger]"], "+", 
      SuperscriptBox[
       StyleBox["\[Gamma]", "TI"], "*"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e137f99-bb3e-b46d-5a0b-4d9dd11c85f0"],
 ", this is a displaced superposition of ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18fd20db-4190-327e-7710-e451a2edb8a2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75fa020b-75d5-7950-7ff4-c865cf2a350e"],
 ","
}], "Text",
 CellID->405712611,ExpressionUUID->"234e5eaf-d6ce-716d-4b93-e501088b47bf"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "\[Proportional]", 
   RowBox[{
    OverscriptBox[
     StyleBox["D", "TI"], "^"], 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["\[Beta]", "TI"], 
        StyleBox["cos",
         FontSlant->"Plain"], 
        StyleBox["\[Theta]", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "[", 
      RowBox[{
       RowBox[{
        StyleBox["cos",
         FontSlant->"Plain"], 
        StyleBox["\[Theta]", "TI"], 
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"1", "-", 
          RowBox[{
           SuperscriptBox[GridBox[{
              {
               StyleBox["\[Beta]", "TI"]}
             },
             GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
             GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
           SuperscriptBox[
            StyleBox["sin",
             FontSlant->"Plain"], "2"], 
           StyleBox["\[Theta]", "TI"]}]}], 
         StyleBox[")",
          SpanMaxSize->1]}], 
        TemplateBox[{"0"},
         "Ket"]}], "-", 
       RowBox[{
        StyleBox["\[Beta]", "TI"], 
        SuperscriptBox[
         StyleBox["sin",
          FontSlant->"Plain"], "2"], 
        StyleBox["\[Theta]", "TI"], 
        TemplateBox[{"1"},
         "Ket"]}]}], "]"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1175096027,ExpressionUUID->"24f8e78c-fb9a-6293-2c87-96f3b4c2b71b"],

Cell[TextData[{
 "The amplitudes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{
     StyleBox["k", "TI"], GridBox[{
       {
        OverscriptBox[
         StyleBox["U", "TI"], "^"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "1"}], ",", 
    StyleBox["\[Beta]", "TI"]}], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ef42b0a-a04b-45ec-6452-ad24a971cc45"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[LessEqual]", "14"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59f93af1-be1c-c8fc-541e-fd7759f307d1"],
 " and general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]", ",", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "789219c7-b617-84b1-668b-42284c21cc74"],
 " are compared with ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["k", "TI"], 
    StyleBox["\[Psi]", "TI"]},
   "BraKet"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c17e3e1-e362-325c-496e-7aa6eecfc435"],
 "; the panels show ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbd9dba-939c-ce96-10b1-52cdbbe7c080"],
 " of the normalized state built from them, at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arg",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Beta]", "TI"], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574ef025-f272-8ba5-5cfa-7ced3486032e"],
 ", with quadratures ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], ",", 
   OverscriptBox[
    StyleBox["p", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3acd6f2b-42ae-f464-762d-97ef6b3604ee"],
 " defined by ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["x", "TI"], "^"], "+", 
    StyleBox["i", "TI"], 
    OverscriptBox[
     StyleBox["p", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa180bc-d46f-5256-5e83-4bc1787aafb7"],
 ", every panel on one color scale from ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60a91b72-bbca-3ef1-2e3a-b6a82ae30446"],
 " to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e246d18-38e6-8336-2415-413de11927d1"],
 ", the bounds of ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a808097-9363-9d67-6213-e67fb7939f74"],
 "; the white line encloses ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"], "<", "-", "0.01"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6239a76e-582c-e9b5-4749-54fec05ecc77"],
 ":"
}], "Text",
 CellID->1134404058,ExpressionUUID->"4f511ff2-c874-973a-7c93-a0f7f34ea77a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"heraldAmps", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumInterferometer", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], "}"}], "]"}], "[", 
      RowBox[{"\"\<Amplitude\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"\"\<Coherent\>\"", "[", "\[Beta]", "]"}]}], "}"}], " ", "->",
         " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "k"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "14"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"heraldModel", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"Abs", "[", "\[Beta]", "]"}], "^", "2"}]}], "/", "2"}], 
       "]"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Beta]", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "^", "k"}]}], 
         " ", "-", " ", 
         RowBox[{"k", " ", "\[Beta]", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Beta]", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"k", " ", "-", " ", "1"}], ")"}]}]}]}], ")"}], "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"k", "!"}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "14"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"heraldWigner", "[", 
    RowBox[{"t_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"heraldAmps", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Theta]", " ", "->", " ", "t"}], ",", " ", 
            RowBox[{"\[Beta]", " ", "->", " ", 
             RowBox[{"b", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", 
                RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}]}]}], "}"}]}], "]"}], ",",
         " ", "15"}], "]"}], "[", "\"\<Normalized\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4.5"}], ",", " ", "4.5"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4.5"}], ",", " ", "4.5"}], "}"}], ",", " ", 
     RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "121"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"heraldColors", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "#"}], ")"}], "/", "2"}], "]"}], " ", 
    "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"heraldPanel", "[", 
    RowBox[{"t_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"heraldWigner", "[", 
        RowBox[{"t", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"\[Pi]", " ", 
        RowBox[{"w", "[", 
         RowBox[{"x", ",", " ", "p"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "4.5"}], ",", " ", "4.5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"-", "4.5"}], ",", " ", "4.5"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"ColorFunction", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"heraldColors", "[", "#3", "]"}], " ", "&"}], ")"}]}], ",", 
       " ", 
       RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"PlotPoints", " ", "->", " ", "40"}], ",", " ", 
       RowBox[{"MaxRecursion", " ", "->", " ", "0"}], ",", "\n", "    ", 
       RowBox[{"MeshFunctions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"#3", " ", "&"}], "}"}]}], ",", " ", 
       RowBox[{"Mesh", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"-", "0.01"}], "}"}], "}"}]}], ",", " ", 
       RowBox[{"MeshStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", " ", "Thick"}], "]"}]}], ",", " ", 
       RowBox[{"BoxRatios", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "0.5"}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\"", ",", 
          " ", "\"\<\[Pi]W\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "t", ",", 
           " ", "\"\<,   |\[Beta]| = \>\"", ",", " ", "b"}], "}"}], "]"}]}], ",",
        " ", 
       RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"heraldPanels", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "8"}], ",", " ", 
       RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
       RowBox[{"3", " ", 
        RowBox[{"\[Pi]", "/", "8"}]}]}], "}"}], ",", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"heraldPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "8"}], ",", " ", 
         RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
         RowBox[{"3", " ", 
          RowBox[{"\[Pi]", "/", "8"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", " ", "1", ",", " ", "2"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"heraldLabel", " ", "=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<QF:  \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"heraldAmps", "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", "2"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Element", "[", 
            RowBox[{"\[Theta]", ",", " ", "Reals"}], "]"}]}], "]"}], "]"}], ",",
         " ", "\"\< for k = 0, 1;    all k \[LessEqual] 14 equal \:27e8k|\
\[Psi]\:27e9:  \>\"", ",", "\n", "     ", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"heraldAmps", " ", "-", " ", "heraldModel"}], ",", " ", 
           RowBox[{"Element", "[", 
            RowBox[{"\[Theta]", ",", " ", "Reals"}], "]"}]}], "]"}], " ", "===",
          " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", " ", "15"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
     "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Labeled", "[", 
    RowBox[{
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{"{", 
         RowBox[{"heraldPanels", "[", "\[Theta]v", "]"}], "}"}], "]"}], ",", 
       " ", 
       RowBox[{"BarLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"heraldColors", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"LegendLabel", " ", "->", " ", "\"\<\[Pi]W\>\""}]}], "]"}]}],
       "]"}], ",", " ", "heraldLabel", ",", " ", "Top"}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]v", ",", " ", 
       RowBox[{"\[Pi]", "/", "4"}], ",", " ", "\"\<\[Theta]\>\""}], "}"}], ",",
      " ", 
     RowBox[{"Keys", "[", "heraldPanels", "]"}], ",", " ", "SetterBar"}], 
    "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[118]:= ",
 CellID->686624904,ExpressionUUID->"103c72d3-a4ee-2de1-0e26-f2339c7045b5"],

Cell[TextData[{
 "Output 2 is a displaced superposition of ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28a161f6-f5d1-d186-4369-aa83c1aa2276"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bb27f12-929f-deab-455c-3802c3bcb59c"],
 ", so its Wigner function is negative somewhere whenever the reflected \
photon contributes; with weak light and a small ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44a1e210-b0a2-8e1e-536d-2fcb972cee4e"],
 " that negative region is too shallow to reach the white contour at ",
 Cell[BoxData[
  RowBox[{"\[Pi]", 
   StyleBox["W", "TI"], "=", "-", "0.01"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29d0553c-8117-f222-3700-822e5d8cbf6b"],
 ", and output 2 looks like the coherent bump ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Beta]", "TI"], 
      StyleBox["cos", FontSlant -> "Plain"], 
      StyleBox["\[Theta]", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3ef7a4-ddab-8e9a-1b2b-b5699afa5b0e"],
 ". A larger ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0913db9f-0a77-6eb5-6d67-1949a150b408"],
 " or a brighter ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b3f2ae5-7fee-378a-4c19-195c978d234a"],
 " deepens it, beside a crescent of positive ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ce387ff-b0ca-970a-7ff2-9fd1777c929c"],
 ", until ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[Beta]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dbf5660-7c45-3cca-3218-6e79032df191"],
 " reaches about 1, where the click heralds a displaced single photon; past \
that the vacuum part returns and the dip grows shallower again, as at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "3", "\[Pi]", "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "707f4725-88ab-1fed-6071-4d108fef97e2"],
 ", ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["\[Beta]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc7e070-acbc-c38e-5111-4ae6bca50d73"],
 "."
}], "Text",
 CellID->2028623725,ExpressionUUID->"369d66c9-7308-d2d1-1ca7-62b5211d0aa0"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->294694543,ExpressionUUID->"5bcf359f-6eae-d1a2-0f90-eab7fce6eb72"],

Cell["A Kerr medium in a Mach-Zehnder interferometer", "Subsection",
 CellID->1156436553,ExpressionUUID->"6ead3992-cb24-ca1f-4ede-a1ba558cf0b8"],

Cell[TextData[{
 "A beam splitter ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["B", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d48e2c-14c7-6202-6c64-6a7677ab0608"],
 " opens a Mach-Zehnder interferometer, arm 1 carries a linear phase ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38397970-07b1-3801-48f8-f1234b5b2b7f"],
 " and a Kerr medium with nonlinear phase ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5adf3f59-8ce6-1e79-54fa-cb0a8bead818"],
 ", and the inverse splitter ",
 Cell[BoxData[
  SuperscriptBox[
   OverscriptBox[
    StyleBox["B", "TI"], "^"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18d1eae2-a607-b3ef-2ba9-260ca5b7db1e"],
 " closes it. Either one photon enters port 1, or one photon enters each \
port. What does the Kerr phase change that the linear phase cannot?"
}], "Text",
 CellID->829323576,ExpressionUUID->"7e76d96e-25e9-0fd3-1baf-b2992706adce"],

Cell["The network is", "Text",
 CellID->6276230,ExpressionUUID->"7f4f0225-5628-3854-1f83-cd3ffa13de00"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["U", "TI"], "^"], "=", 
    OverscriptBox[
     StyleBox["B", "TI"], "^"], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[Dagger]"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["n", "TI"], "^"], "1"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["n", "TI"], "^"], "1"], "-", "1"}], 
      StyleBox[")",
       SpanMaxSize->1], "/", "2"}]], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", 
      SubscriptBox[
       OverscriptBox[
        StyleBox["n", "TI"], "^"], "1"]}]], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["B", "TI"], "^"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["B", "TI"], "^"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["\[Theta]", "TI"], "(", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "1"], 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "2", "\[Dagger]"], "-", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
       SubsuperscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["a", "TI"], "^"], "2"]}], ")"}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->325549569,ExpressionUUID->"5b11beec-5b84-1d80-2dd0-56d140c80274"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], "1"], "=", 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1", "\[Dagger]"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f14d311-5a32-8a3c-067c-e8966255bbaa"],
 "; the Kerr factor is 1 on zero or one photon in the arm. The two linear \
pieces become Fock-space circuits on three levels per mode, enough for two \
photons, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]", ",", 
   StyleBox["\[Alpha]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "017f3300-d250-e395-0350-015283c0095b"],
 " still general; the Kerr medium is a diagonal operator between them."
}], "Text",
 CellID->1384420794,ExpressionUUID->"5a96c36c-14d1-41f3-4987-0113f93caf81"],

Cell[TextData[{
 "The figure plots, for general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]", ",", 
   StyleBox["\[Alpha]", "TI"], ",", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d38e69b-e78b-d6ec-75a2-eadbefc8e031"],
 ", the probability that the input pattern comes back; the markers are the \
permanent formula for the linear network (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e3f1aaa-015d-0125-1acc-16a6e4616225"],
 ") at ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dc72cc-249b-6d1e-6d32-7c3944e6a87c"],
 ":"
}], "Text",
 CellID->1976575955,ExpressionUUID->"107f4074-ecf8-27de-511c-7a614932fca6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kerrMZIn", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<PS\>\"", "[", "\[Alpha]", "]"}], " ", "->", " ", "1"}]}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrMZOut", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], "}"}], "]"}], 
    "[", "\"\<Dagger\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrMZKerr", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"SparseArray", "[", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "\[Chi]", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "2"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", " ", "2"}], "]"}], " ", "-", " ", "1"}], ")"}],
           "/", "2"}]}], "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", "1", "}"}], ",", " ", "3"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrMZCircuit", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kerrMZIn", "[", 
       RowBox[{"\"\<CircuitOperator\>\"", ",", " ", "3"}], "]"}], ",", " ", 
      "kerrMZKerr", ",", " ", 
      RowBox[{"kerrMZOut", "[", 
       RowBox[{"\"\<CircuitOperator\>\"", ",", " ", "3"}], "]"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrMZReturn", "[", "in_", "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SuperDagger", "[", 
           RowBox[{"FockState", "[", 
            RowBox[{"in", ",", " ", "3"}], "]"}], "]"}], " ", "@", " ", 
          RowBox[{"kerrMZCircuit", "[", 
           RowBox[{"FockState", "[", 
            RowBox[{"in", ",", " ", "3"}], "]"}], "]"}]}], ")"}], 
        "[", "\"\<Scalar\>\"", "]"}], "]"}], "^", "2"}], ",", " ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Theta]", ",", " ", "\[CurlyPhi]", ",", " ", "\[Alpha]", ",", " ", 
         "\[Chi]"}], "}"}], ",", " ", "Reals"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"kerrMZ1", ",", " ", "kerrMZ2"}], "}"}], " ", "=", " ", 
   RowBox[{"kerrMZReturn", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrMZLinear", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"kerrMZOut", "[", "kerrMZIn", "]"}], "[", 
      RowBox[{"\"\<Probability\>\"", ",", " ", 
       RowBox[{"#", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrMZPanel", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"kerrMZ2", " ", "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[Theta]", " ", "->", " ", "t"}], ",", " ", 
               RowBox[{"\[Chi]", " ", "->", " ", "c"}]}], "}"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"c", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"\[Pi]", "/", "2"}], ",", " ", "\[Pi]"}], "}"}]}], 
             "}"}]}], "]"}], ",", " ", 
          RowBox[{"kerrMZ1", " ", "/.", " ", 
           RowBox[{"\[Theta]", " ", "->", " ", "t"}]}]}], "]"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", " ", "0", ",", " ", 
         RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Dashed", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
          "Automatic"}], "}"}]}], ",", "\n", "     ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<one photon |1, 0\:27e9\>\"", ",", 
          " ", "\"\<pair |1, 1\:27e9,  \[Chi] = 0\>\"", ",", 
          " ", "\"\<pair |1, 1\:27e9,  \[Chi] = \[Pi]/2\>\"", ",", 
          " ", "\"\<pair |1, 1\:27e9,  \[Chi] = \[Pi]\>\""}], "}"}]}]}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", 
             RowBox[{"#", " ", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Theta]", " ", "->", " ", "t"}], ",", " ", 
                RowBox[{"\[CurlyPhi]", " ", "->", " ", 
                 RowBox[{"\[Pi]", "/", "3"}]}], ",", " ", 
                RowBox[{"\[Alpha]", " ", "->", " ", "a"}]}], "}"}]}]}], "}"}],
            ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "0", ",", " ", 
             RowBox[{"2", " ", "\[Pi]"}], ",", " ", 
             RowBox[{"\[Pi]", "/", "8"}]}], "}"}]}], "]"}], " ", "&"}], " ", "/@",
         " ", "kerrMZLinear"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", " ", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"TraditionalForm", "[", "#", "]"}], ",", " ", 
                RowBox[{"FractionBoxOptions", " ", "->", " ", 
                 RowBox[{"{", 
                  RowBox[{"Beveled", " ", "->", " ", "True"}], "}"}]}]}], 
               "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "\[Pi]"}], ",", " ", 
             RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], ",", " ", "None"}], 
         "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Alpha]\>\"", ",", " ", "\"\<return probability\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "t"}], "}"}], "]"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrMZPanels", " ", "=", " ", 
   RowBox[{"kerrMZPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
      RowBox[{"\[Pi]", "/", "8"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", "kerrMZPanels"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "640"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "kerrMZPanels", "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<P(|1, 0\:27e9 \[RightArrow] |1, 0\:27e9) = \>\"", ",", 
           " ", 
           RowBox[{"TraditionalForm", "[", "kerrMZ1", "]"}]}], "}"}], "]"}], ",",
         " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<P(|1, 1\:27e9 \[RightArrow] |1, 1\:27e9) = \>\"", ",", 
           " ", 
           RowBox[{"TraditionalForm", "[", "kerrMZ2", "]"}]}], "}"}], "]"}]}],
        "}"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[119]:= ",
 CellID->330717673,ExpressionUUID->"58be9455-f303-e6a2-42f3-fd4fbdabf144"],

Cell[TextData[{
 "Neither return probability contains ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71ab3a96-a3e6-7e29-08f3-5bee09fb0e74"],
 ", and the one-photon fringe contains no ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f73b83c-9130-a617-1566-39c0a9b2cc00"],
 " either: a single photon in the arm picks up no Kerr phase, so the Kerr \
medium acts on photon pairs alone. On the balanced splitter the pair swings \
fully between returning and never returning, and ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75b1e48d-6b7c-fea6-6bbb-6d561dd59a37"],
 " only shifts that swing in ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c6309a1-1fe4-63ee-3218-6c17fe7c4ac1"],
 ". At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11b77663-33e0-536c-0e21-9cfaa01d4c41"],
 " the one-photon fringe no longer empties, and ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4777b76e-ccf2-9707-079c-5133a248dabc"],
 " changes the shape of the pair fringe as well as its position."
}], "Text",
 CellID->564035859,ExpressionUUID->"34719184-9604-c679-5054-d6091c69b8ff"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1115559812,ExpressionUUID->"7951c21c-7a50-b052-2942-f23188ea3e25"],

Cell["Entanglement, information and contextuality", "Section",
 CellID->1024318136,ExpressionUUID->"12226d83-c616-c5ee-40d4-bf4ee820b8ef"],

Cell["\<\
The examples in this section ask what quantum states can do as a resource. \
GHZ and W states are two inequivalent kinds of three-qubit entanglement, \
entanglement is monogamous, and Nielsen's majorization decides which pure \
states local operations can convert. Information comes next: the Holevo bound \
and the capacity of a noisy qubit channel. Then nonclassical correlations: \
Bell violations up to the Tsirelson bound, a qutrit that beats every \
noncontextual model, magic counted by negative discrete Wigner values, and \
Gleason's theorem. QF builds the states, channels and measurements, computes \
entropies, fidelities and partial transposes, and WL optimizes over the free \
parameters to find the bounds exactly.\
\>", "Text",
 CellID->1048015977,ExpressionUUID->"582b0ebb-dbb1-a7ba-05a6-acdf4cb74f67"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->464147346,ExpressionUUID->"52ec9995-9fcd-159c-30fc-56e17bb18afe"],

Cell["GHZ and W: two kinds of three-qubit entanglement", "Subsection",
 CellID->1683125706,ExpressionUUID->"37c7a8ea-796b-7840-527b-8670918d3c8f"],

Cell[TextData[{
 "Three qubits share ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["GHZ", FontSlant -> "Plain"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"000"},
       "Ket"], "+", 
      TemplateBox[{"111"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f180fb5-905b-9005-11ff-50a088058d4d"],
 " or ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["W", "TI"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"001"},
       "Ket"], "+", 
      TemplateBox[{"010"},
       "Ket"], "+", 
      TemplateBox[{"100"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["3"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0888ece1-662f-3658-0fdc-eafe1ed5f430"],
 ". Each party may apply any invertible local map ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bc3c8e1-16f5-3af9-0089-0aba1facc292"],
 ", ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74116bcd-c901-c930-5cc9-90cdcf6e9a18"],
 ", ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4abdc0d8-a20c-db47-6b78-079562f640e6"],
 ", even one that succeeds only with some probability. Can such maps turn GHZ \
into W?"
}], "Text",
 CellID->309421023,ExpressionUUID->"734aac4d-4cc5-f227-2715-49080c799adf"],

Cell[TextData[{
 "The maps act as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "\[Function]", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["A", "TI"], "\[CircleTimes]", 
      StyleBox["B", "TI"], "\[CircleTimes]", 
      StyleBox["C", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c599b91-9ee9-cfa4-32ad-beb1f5a0c455"],
 ", followed by normalization. Cut the amplitudes ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Psi]", "TI"], 
   StyleBox[
    RowBox[{"i", "j", "k"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d99167f-a3f1-fb37-1783-2e4f1612a67b"],
 " into the two ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "622e98c1-0aa7-bf5d-1a02-263e0cd089f3"],
 " slices ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox["i", "TI"]], "=", 
   SubscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox[
       RowBox[{"i", "j", "k"}], "TI"]], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57bd71f6-9d15-d8cd-0f20-b9d5e65efb11"],
 "; the Cayley hyperdeterminant ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Det",
    FontSlant->"Plain"], 
   StyleBox["\[Psi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0189376c-ff9d-d45e-08fd-417b7d9d49c7"],
 " is the discriminant of the quadratic ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["M", "TI"], "0"], "+", 
    StyleBox["x", "TI"], 
    SubscriptBox[
     StyleBox["M", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40f7662c-9411-766e-4b8f-6663fb8595a2"],
 ", and the three-tangle of a normalized state is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], "3"], "=", "4", GridBox[{
     {
      RowBox[{
       StyleBox["Det",
        FontSlant->"Plain"], 
       StyleBox["\[Psi]", "TI"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e9228e5-de7f-9011-4a02-2eafcfffc6bf"],
 ". The family"
}], "Text",
 CellID->226122477,ExpressionUUID->"0818c465-d5f7-31a1-698a-2f08cae8714c"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], "\[Epsilon]"]},
     "Ket"], "\[Proportional]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["A", "TI"], "\[Epsilon]", 
      RowBox[{"\[CircleTimes]", "3"}]], 
     TemplateBox[{
       StyleBox["GHZ", FontSlant -> "Plain"]},
      "Ket"]}], "\[Proportional]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{"0"},
         "Ket"], "+", 
        RowBox[{"\[Epsilon]", 
         TemplateBox[{"1"},
          "Ket"]}]}], ")"}], 
      RowBox[{"\[CircleTimes]", "3"}]], "-", 
     TemplateBox[{"000"},
      "Ket"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["A", "TI"], "\[Epsilon]"], "=", 
    RowBox[{"(", GridBox[{
       {"1", 
        RowBox[{"-", "1"}]},
       {"\[Epsilon]", "0"}
      }], ")"}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["det",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["A", "TI"], "\[Epsilon]"]}], "=", "\[Epsilon]"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1406067624,ExpressionUUID->"783f8e56-eda1-2e78-2a9a-97a4bc5b4c22"],

Cell[TextData[{
 "is GHZ moved by an invertible map for every ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b2fee2d-6ff2-512f-4d55-3f9c68542d6e"],
 "."
}], "Text",
 CellID->728643632,ExpressionUUID->"383c8a31-1624-0084-29bf-c0b828367ac9"],

Cell[TextData[{
 "Transforming both states with all twelve entries of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], ",", 
   StyleBox["B", "TI"], ",", 
   StyleBox["C", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb89968-d6d6-5c10-6f05-af153dc5a13e"],
 " general gives ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6407ec27-d8b5-8e31-3011-4af7be7c7bce"],
 " and the infidelity ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["W", "TI"], 
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], "\[Epsilon]"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5529cd5a-9698-7191-2e8b-4b2b1c97400f"],
 " in closed form:"
}], "Text",
 CellID->555956219,ExpressionUUID->"1b7e2e0a-7739-b4d7-7371-f3d573660d4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hyperdetSLOCC", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Normal", "[", "v", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{"Det", "[", 
            RowBox[{
             RowBox[{"m", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"\[FormalX]", " ", 
              RowBox[{"m", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ",", " ", 
           "\[FormalX]", ",", " ", "3"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{"c", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", 
         RowBox[{"c", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ghzSLOCC", ",", " ", "wSLOCC"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"#", "[", "3", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<GHZ\>\"", ",", " ", "\"\<W\>\""}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapSLOCC", " ", "=", " ", 
   RowBox[{"QuantumTensorProduct", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"Array", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"slA", ",", " ", "slB", ",", " ", "slC"}], "}"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"detsSLOCC", " ", "=", " ", 
   RowBox[{"Times", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"Array", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"slA", ",", " ", "slB", ",", " ", "slC"}], "}"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ghzMapSLOCC", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"mapSLOCC", "[", "ghzSLOCC", "]"}], "[", "\"\<StateVector\>\"", 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ghzRuleQ", ",", " ", "wRuleQ"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"hyperdetSLOCC", "[", "ghzMapSLOCC", "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"detsSLOCC", "^", "2"}], "/", "4"}]}], "]"}], " ", "===", 
      " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"hyperdetSLOCC", "[", 
        RowBox[{
         RowBox[{"mapSLOCC", "[", "wSLOCC", "]"}], "[", "\"\<StateVector\>\"",
          "]"}], "]"}], "]"}], " ", "===", " ", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vecSLOCC", " ", "=", " ", 
   RowBox[{"ghzMapSLOCC", " ", "/.", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Array", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}], " ", "->", 
         " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "\[Epsilon]", ",", " ", "0"}], 
          "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"slA", ",", " ", "slB", ",", " ", "slC"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tau3SLOCC", ",", " ", "infidSLOCC"}], "}"}], " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"4", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"hyperdetSLOCC", "[", "vecSLOCC", "]"}], "]"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"vecSLOCC", " ", ".", " ", "vecSLOCC"}], ")"}], "^", 
          "2"}]}]}], ",", " ", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Normal", "[", 
             RowBox[{"wSLOCC", "[", "\"\<StateVector\>\"", "]"}], "]"}], " ", 
            ".", " ", "vecSLOCC"}], ")"}], "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"vecSLOCC", " ", ".", " ", "vecSLOCC"}], ")"}]}]}]}], "}"}],
      ",", " ", 
     RowBox[{"\[Epsilon]", " ", ">", " ", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"LogLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tau3SLOCC", ",", " ", "infidSLOCC"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", ",", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "3"}]}], ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[Tau]\>\"", ",", " ", "3"}], "]"}], ",", 
      " ", "\"\<1 - \
|\[LeftAngleBracket]W|\[Psi]\[RightAngleBracket]|\.b2\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Epsilon]\>\"", ",", " ", "None"}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}], ",", "\n", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Det((A\[CircleTimes]B\[CircleTimes]C)GHZ) = (det A \
det B det C)\.b2/4: \>\"", ",", " ", "ghzRuleQ"}], "}"}], "]"}], ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Det((A\[CircleTimes]B\[CircleTimes]C)W) = 0: \>\"", ",",
             " ", "wRuleQ"}], "}"}], "]"}], ",", "\n", "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<\[Tau]\>\"", ",", " ", "3"}], "]"}], ",", 
            " ", "\"\< = \>\"", ",", " ", 
            RowBox[{"TraditionalForm", "[", "tau3SLOCC", "]"}], ",", 
            " ", "\"\<,   1 - \
|\[LeftAngleBracket]W|\[Psi]\[RightAngleBracket]|\.b2 = \>\"", ",", " ", 
            RowBox[{"TraditionalForm", "[", "infidSLOCC", "]"}]}], "}"}], 
          "]"}]}], "}"}], "]"}], ",", " ", "13", ",", " ", 
      RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
     "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[120]:= ",
 CellID->1397217190,ExpressionUUID->"7c87715e-3b60-07fe-0e27-a4cfb117dcf8"],

Cell[TextData[{
 "An invertible local map multiplies the hyperdeterminant by ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["det",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["A", "TI"], 
      StyleBox["det",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["B", "TI"], 
      StyleBox["det",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["C", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "\[NotEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7243e05a-eb41-8e3f-5490-56c49ad3b30f"],
 ", so ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e648f13-4a0d-51d9-1fe9-87a31ee6fd53"],
 " of W stays zero and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17e7080e-6a6f-84c1-7cc3-6ea941792adb"],
 " of GHZ stays positive, and no such map links the two in either direction. \
The family ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Psi]", "TI"], "\[Epsilon]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fb345c1-1f2e-b68f-4602-ab1f8d0a0c49"],
 " is GHZ-class at every ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "243ef620-2451-2b06-0367-2a7e05c5ce32"],
 ", yet its ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69c4828a-5642-de91-2a49-60d99efdd2ea"],
 " and its infidelity with W both vanish as ",
 Cell[BoxData[
  SuperscriptBox["\[Epsilon]", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e136aec-2869-1658-490b-22d02f1f5da5"],
 ": W sits on the boundary of the GHZ class, reachable only as a limit."
}], "Text",
 CellID->2076894841,ExpressionUUID->"4df4dca7-5e51-6e7a-4765-2c76ca2bdbab"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1171507862,ExpressionUUID->"405e56cd-9277-3e0c-342e-eeeabdd903a5"],

Cell["Monogamy of entanglement: the CKW inequality", "Subsection",
 CellID->1213467136,ExpressionUUID->"0bc0147f-9413-f808-42a1-843ba407822d"],

Cell[TextData[{
 "Three qubits ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7896ab0f-1855-a8ef-17d1-bb7b5a8ec96c"],
 ", ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c3e957c-b36c-0c12-67dd-9c7d49eb1e0a"],
 ", ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66112a69-3837-190b-30db-10a476ee59a3"],
 " share ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      RowBox[{
        StyleBox["p", "TI"], ",", 
        StyleBox["\[Phi]", "TI"]}]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      StyleBox["p", "TI"]], 
     TemplateBox[{
       StyleBox["GHZ", FontSlant -> "Plain"]},
      "Ket"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Phi]"}], "TI"]], 
     SqrtBox[
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}]], 
     TemplateBox[{
       StyleBox["W", "TI"]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03e49e29-0975-2639-6b2e-215cb9b7b301"],
 ", a superposition of the two orthogonal states ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"000"},
      "Ket"], "+", 
     TemplateBox[{"111"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763cdd82-c677-0fe9-6342-57967c26947f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"001"},
      "Ket"], "+", 
     TemplateBox[{"010"},
      "Ket"], "+", 
     TemplateBox[{"100"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab38951-1a60-47cf-5594-a5687d63af50"],
 ". How much of qubit ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d13e645-03ac-d748-504c-934937ab2dec"],
 "'s entanglement with the pair ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"B", "C"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79c61c08-3327-c60b-0920-de520ae68943"],
 " can it hold with ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5db8dcf6-da71-6d71-1dc6-a6b948a0d1c2"],
 " and with ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1507ff1d-326a-5359-2e42-7a359f360e76"],
 " separately?"
}], "Text",
 CellID->1461296476,ExpressionUUID->"26fcb781-6fbe-35d5-295a-263f49ce3682"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e37c47-8ad7-5d93-7fb3-1d065cdbf84e"],
 "'s entanglement with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"B", "C"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cf0a5b4-b539-fcf0-5de9-4ec66082c9e5"],
 " is the tangle ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    RowBox[{
     StyleBox["A", "TI"], 
     StyleBox["|",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"B", "C"}], "TI"]}]], "=", 
   SubsuperscriptBox[
    StyleBox["C", "TI"], 
    RowBox[{
     StyleBox["A", "TI"], 
     StyleBox["|",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"B", "C"}], "TI"]}], "2"], "=", "4", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["A", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "067142b4-b09d-8eca-1ff1-37f80255d2e3"],
 ". What it shares with ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b6458fa-a86b-2b4b-09e0-24e9206ee905"],
 " alone is the Wootters concurrence ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], 
   StyleBox[
    RowBox[{"A", "B"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68a43316-e85e-7e85-744c-55d72335328f"],
 " of the two-qubit state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox[
     RowBox[{"A", "B"}], "TI"]], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["Tr",
      FontSlant->"Plain"], 
     StyleBox["C", "TI"]], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ddfc898-07cf-1260-3f2d-7fb841bd9ab4"],
 ", and likewise ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["C", "TI"], 
   StyleBox[
    RowBox[{"A", "C"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e6af0a8-c70b-55ee-1a09-f2f2f4523ff6"],
 ". The Coffman-Kundu-Wootters inequality says"
}], "Text",
 CellID->2027598424,ExpressionUUID->"6198b022-ec85-8b1e-00dc-4c54e47477ed"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], 
     RowBox[{
      StyleBox["A", "TI"], 
      StyleBox["|",
       SpanMaxSize->1], 
      StyleBox[
       RowBox[{"B", "C"}], "TI"]}]], "\[ThickSpace]", "\[GreaterEqual]", 
    "\[ThickSpace]", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox[
      RowBox[{"A", "B"}], "TI"], "2"], "+", 
    SubsuperscriptBox[
     StyleBox["C", "TI"], 
     StyleBox[
      RowBox[{"A", "C"}], "TI"], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Tau]", "TI"], "3"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["\[Tau]", "TI"], 
       RowBox[{
        StyleBox["A", "TI"], 
        StyleBox["|",
         SpanMaxSize->1], 
        StyleBox[
         RowBox[{"B", "C"}], "TI"]}]], "-", 
      SubsuperscriptBox[
       StyleBox["C", "TI"], 
       StyleBox[
        RowBox[{"A", "B"}], "TI"], "2"], "-", 
      SubsuperscriptBox[
       StyleBox["C", "TI"], 
       StyleBox[
        RowBox[{"A", "C"}], "TI"], "2"]}], "\[GreaterEqual]", "0"}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2059689731,ExpressionUUID->"778c26ef-d1e2-2d39-42f8-a2af208ffb65"],

Cell[TextData[{
 "and for a pure state the residual is the three-tangle ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], "3"], "=", "4", GridBox[{
     {
      RowBox[{
       StyleBox["Det",
        FontSlant->"Plain"], 
       StyleBox["\[Psi]", "TI"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e4baf0-3670-dc94-4a16-f9ef72731410"],
 ", with ",
 Cell[BoxData[
  StyleBox["Det",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51155c14-b948-7e2e-4be1-856f9a75daa4"],
 " the Cayley hyperdeterminant of the amplitudes: the residual tangle that \
the pairwise concurrences do not account for."
}], "Text",
 CellID->135732636,ExpressionUUID->"56aa4b73-cba4-d4c6-6790-d04340c4b6b9"],

Cell[TextData[{
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   RowBox[{
    StyleBox["A", "TI"], 
    StyleBox["|",
     SpanMaxSize->1], 
    StyleBox[
     RowBox[{"B", "C"}], "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "393716e5-477a-da84-40a8-3c0c140eef2a"],
 " comes from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["A", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25fcc9b0-8959-dee8-2f56-01980878b883"],
 " in closed form, the pairwise concurrences are the markers, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dc7324-7bd2-5b79-4a3e-25900efd22a8"],
 " comes from the amplitudes:"
}], "Text",
 CellID->996291812,ExpressionUUID->"1bfd0e04-643b-42d0-0e8d-06b520fc6759"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ghzCKW", ",", " ", "wCKW"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{"#", "[", "3", "]"}], "]"}], "[", "\"\<StateVector\>\"", 
       "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<GHZ\>\"", ",", " ", "\"\<W\>\""}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vecCKW", "[", 
    RowBox[{"p_", ",", " ", "\[Phi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", "p", "]"}], " ", "ghzCKW"}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", " ", "-", " ", "p"}], "]"}], " ", "wCKW"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hyperdetCKW", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"v", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{"Det", "[", 
            RowBox[{
             RowBox[{"m", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
             RowBox[{"\[FormalX]", " ", 
              RowBox[{"m", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ",", " ", 
           "\[FormalX]", ",", " ", "3"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], " ", "-", " ", 
        RowBox[{"4", " ", 
         RowBox[{"c", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", 
         RowBox[{"c", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tangleCKW", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"4", " ", 
       RowBox[{"Det", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"QuantumPartialTrace", "[", 
           RowBox[{
            RowBox[{"QuantumState", "[", 
             RowBox[{
              RowBox[{"vecCKW", "[", 
               RowBox[{"\[FormalP]", ",", " ", "\[FormalPhi]"}], "]"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], 
          "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"0", " ", "<", " ", "\[FormalP]", " ", "<", " ", "1"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tau3CKW", " ", "=", " ", 
   RowBox[{"4", " ", 
    RowBox[{"Abs", "[", 
     RowBox[{"hyperdetCKW", "[", 
      RowBox[{"vecCKW", "[", 
       RowBox[{"\[FormalP]", ",", " ", "\[FormalPhi]"}], "]"}], "]"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pairsCKW", "[", 
    RowBox[{"p_", ",", " ", "\[Phi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumEntanglementMonotone", "[", 
        RowBox[{
         RowBox[{"QuantumPartialTrace", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", 
            RowBox[{
             RowBox[{"vecCKW", "[", 
              RowBox[{"p", ",", " ", "\[Phi]"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", "#", "}"}]}], "]"}], ",", 
         " ", "\"\<Concurrence\>\""}], "]"}], "^", "2"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelCKW", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tangleCKW", " ", "-", " ", "tau3CKW"}], ",", " ", 
           "tangleCKW", ",", " ", "tau3CKW"}], "}"}], " ", "/.", " ", 
         RowBox[{"\[FormalPhi]", " ", "->", " ", "\[Phi]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\[FormalP]", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", " ", "Automatic", ",", " ", "Dotted"}], 
         "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Subsuperscript", "[", 
              RowBox[{"\"\<C\>\"", ",", " ", "\"\<AB\>\"", ",", " ", "2"}], 
              "]"}], ",", " ", "\"\< + \>\"", ",", " ", 
             RowBox[{"Subsuperscript", "[", 
              RowBox[{"\"\<C\>\"", ",", " ", "\"\<AC\>\"", ",", " ", "2"}], 
              "]"}], ",", " ", "\"\<: QF (markers), \>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Tau]\>\"", ",", " ", "\"\<A|BC\>\""}], "]"}], ",",
              " ", "\"\< - \>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Tau]\>\"", ",", " ", "3"}], "]"}], ",", 
             " ", "\"\< (curve)\>\""}], "}"}], "]"}], ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<\[Tau]\>\"", ",", " ", "\"\<A|BC\>\""}], "]"}], ",", 
          " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Tau]\>\"", ",", " ", "3"}], "]"}], ",", 
             " ", "\"\< = 4|Det \[Psi]|\>\""}], "}"}], "]"}]}], "}"}]}]}], 
      "]"}], ",", "\n", "   ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", " ", 
           RowBox[{"pairsCKW", "[", 
            RowBox[{"p", ",", " ", "\[Phi]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "0.", ",", " ", "1.", ",", " ", "0.1"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[EmptyCircle]\>\"", ",", " ", "12"}], "}"}]}]}], "]"}],
      ",", "\n", "   ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", " ", "None"}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", " ", 
     RowBox[{"ImagePadding", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "30"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Phi] = \>\"", ",", " ", "\[Phi]"}], "}"}], "]"}], ",",
         " ", "13", ",", " ", 
        RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsCKW", " ", "=", " ", 
   RowBox[{"panelCKW", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Pi", "/", "2"}], ",", " ", "Pi"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "panelsCKW"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "panelsCKW", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[121]:= ",
 CellID->292322359,ExpressionUUID->"777860d4-6548-4e23-5e9b-71a06c5420f8"],

Cell[TextData[{
 "The pairwise sums fall on ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    RowBox[{
     StyleBox["A", "TI"], 
     StyleBox["|",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"B", "C"}], "TI"]}]], "-", 
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e367c21-a889-21bd-26c9-d4d43094ce9c"],
 " at every sampled weight and phase, below the tangle: ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2002ef1e-6979-eb99-710e-84681af4e87f"],
 " cannot hold more with ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4235d53c-e5a3-160c-2c9c-5728e083bbdd"],
 " and ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ad5b6e4-cb44-ac38-4eb3-316cc4afe061"],
 " one at a time than with the pair, and the shortfall is exactly the \
three-tangle. W (",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2be02a1c-be4b-6e96-10c2-51870ea0940f"],
 ") spends all of it on pairs and GHZ (",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22df2122-2111-1b59-04e6-451827bbaa81"],
 ") none. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Phi]", "TI"], "=", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "123edba0-b9f1-986b-228a-b7c1447b6c13"],
 " the three-tangle touches zero at one intermediate weight, a superposition \
whose three-tangle vanishes as W's does, although, like W, it is entangled \
across every cut."
}], "Text",
 CellID->2122588920,ExpressionUUID->"7270c0a6-6bad-8940-1c61-fe167094c3d8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1066374394,ExpressionUUID->"23a69c80-1d38-fbbb-1a53-85ab0f841b1d"],

Cell["Which pure states LOCC can convert: Nielsen's majorization", \
"Subsection",
 CellID->494436787,ExpressionUUID->"0e9d2f77-4bee-4e53-20c2-aa2528302a0d"],

Cell[TextData[{
 "Alice and Bob share a pure state and may use local operations and classical \
communication (LOCC). Two qutrit pairs have Schmidt weights ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["\[Psi]", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["1", "2"], ",", 
    FractionBox["3", "10"], ",", 
    FractionBox["1", "5"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07514cf8-35b1-bd79-0a85-05edbfba530b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["3", "5"], ",", 
    FractionBox["1", "5"], ",", 
    FractionBox["1", "5"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46d6968f-d7af-e226-7b79-09a6dc4f1a33"],
 ", and two ququart pairs have ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["\[Psi]", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["2", "5"], ",", 
    FractionBox["2", "5"], ",", 
    FractionBox["1", "10"], ",", 
    FractionBox["1", "10"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2204be-cc07-dc98-1e82-bee4fc8dba52"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["1", "2"], ",", 
    FractionBox["1", "4"], ",", 
    FractionBox["1", "4"], ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f54761b-3160-89a0-1de8-dd7d07856773"],
 "; a qubit pair ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f74a6b4-562c-c2a6-164b-6a6e3551b552"],
 " with weights ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["3", "5"], ",", 
    FractionBox["2", "5"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05856eca-7734-ace6-0a77-a0fcba72b863"],
 " can be borrowed and must be returned. Which conversions succeed with \
certainty?"
}], "Text",
 CellID->200255571,ExpressionUUID->"64972cd8-6722-2d94-1660-5da74cfa66f8"],

Cell[TextData[{
 "Write each state as ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SqrtBox[
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], 
       StyleBox["k", "TI"]]], 
     SubscriptBox[
      TemplateBox[{
        StyleBox["k", "TI"]},
       "Ket"], 
      StyleBox["A", "TI"]], 
     SubscriptBox[
      TemplateBox[{
        StyleBox["k", "TI"]},
       "Ket"], 
      StyleBox["B", "TI"]]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6472a0b9-1356-3b12-6b37-24960e90fc12"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "1"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "\[GreaterEqual]", "\[Ellipsis]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d562772-b5ed-58a9-16d4-bdb980905387"],
 ". Nielsen's theorem: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     StyleBox["\[Phi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09f4423a-5ea6-eb47-095c-65902fee4a21"],
 " by LOCC with certainty if and only if ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["\[Psi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804a944-d48c-097c-4cf5-224af9621227"],
 " is majorized by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2340a5ef-085c-7e81-24e8-ee9e6de140dd"],
 ","
}], "Text",
 CellID->129410451,ExpressionUUID->"42100334-bbb3-70dd-0aa1-1f780ffe3301"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["\[Psi]", "TI"]], "\[Precedes]", 
    SuperscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["\[Phi]", "TI"]], "\[DoubleLongLeftRightArrow]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "\[LessEqual]", 
      StyleBox["k", "TI"]}],
     LimitsPositioning->False], 
    SubsuperscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["i", "TI"], 
     StyleBox["\[Psi]", "TI"]], "\[LessEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "\[LessEqual]", 
      StyleBox["k", "TI"]}],
     LimitsPositioning->False], 
    SubsuperscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["i", "TI"], 
     StyleBox["\[Phi]", "TI"]], "\[NonBreakingSpace]\[NonBreakingSpace]", 
    StyleBox[
     RowBox[{"for", "\[NonBreakingSpace]", "every", "\[NonBreakingSpace]"}],
     FontSlant->"Plain"], 
    StyleBox["k", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->277094631,ExpressionUUID->"28253e44-2a52-48a0-1b18-1bab86807e2c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09f22e74-de66-52a9-26a1-0de9bd3d26b7"],
 " borrowed, the question is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Chi]", "TI"]},
     "Ket"]}], "\[Rule]", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Phi]", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Chi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2735cb35-bb4b-547c-7baf-9747cbae459b"],
 ", where Alice holds both first halves."
}], "Text",
 CellID->2146235468,ExpressionUUID->"0d3ce87e-2b22-2035-2fec-b2bfa4c8b4b6"],

Cell[TextData[{
 "Each state is prepared with the discrete Fourier transform on both sides, \
so its Schmidt basis is hidden; the weights come back exactly as the \
eigenvalues of Alice's reduced state. The first panel shows, for every \
ordered qutrit target ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"], ",", 
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "1"], "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "2"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5686049f-fc35-6cb4-25fc-d49acbda9022"],
 ", whether ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5df6f9ec-79ae-7c66-29d9-ee7eadf3fed1"],
 " converts to it or it converts to ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b426805-5800-3292-28bc-6a8a392b79fb"],
 "; the others plot the partial sums ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], "\[LessEqual]", 
     StyleBox["k", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641b2f70-942f-7a7b-3121-eff09cf06c0d"],
 " against ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "207a4636-df25-2e86-1582-4d5bb689fba4"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], "\[Rule]", 
   StyleBox["\[Phi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68f584f0-18e0-ae24-30a7-17d62c2c990b"],
 " when the curve of ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa36aad-c0f6-ca6f-2b19-1f33bdb6d66a"],
 " is never below that of ",
 Cell[BoxData[
  StyleBox["\[Psi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f7f7e2-d560-357a-1585-0cc60ecdfc81"],
 ":"
}], "Text",
 CellID->1654973870,ExpressionUUID->"1ced1206-4d81-5a71-1393-e86880eca3f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"schmidtNielsen", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<Fourier\>\"", "[", 
           RowBox[{"Length", "[", "w", "]"}], "]"}], "]"}], 
         "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"f", ",", " ", "f"}], "]"}], " ", ".", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Sqrt", "[", "w", "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], " ", 
        RowBox[{"Length", "[", "w", "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"aliceNielsen", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"ReverseSort", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"QuantumPartialTrace", "[", 
       RowBox[{"s", ",", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"s", "[", "\"\<Qudits\>\"", "]"}], ",", " ", "2"}], "]"}]}],
        "]"}], "[", "\"\<Eigenvalues\>\"", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"majorizedNielsen", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"Accumulate", "[", "x", "]"}], " ", "<=", " ", 
      RowBox[{"Accumulate", "[", "y", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"psiNielsen", ",", " ", "phiNielsen"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"aliceNielsen", "[", 
      RowBox[{"schmidtNielsen", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", " ", 
        RowBox[{"3", "/", "10"}], ",", " ", 
        RowBox[{"1", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"3", "/", "5"}], ",", " ", 
        RowBox[{"1", "/", "5"}], ",", " ", 
        RowBox[{"1", "/", "5"}]}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"regionNielsen", " ", "=", " ", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l1", " ", ">=", " ", "l2", " ", ">=", " ", 
           RowBox[{"1", " ", "-", " ", "l1", " ", "-", " ", "l2"}], " ", ">=",
            " ", "0"}], " ", "&&", " ", "#"}], ")"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"majorizedNielsen", "[", 
          RowBox[{"psiNielsen", ",", " ", 
           RowBox[{"{", 
            RowBox[{"l1", ",", " ", "l2", ",", " ", 
             RowBox[{"1", " ", "-", " ", "l1", " ", "-", " ", "l2"}]}], 
            "}"}]}], "]"}], ",", " ", 
         RowBox[{"majorizedNielsen", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l1", ",", " ", "l2", ",", " ", 
             RowBox[{"1", " ", "-", " ", "l1", " ", "-", " ", "l2"}]}], "}"}],
            ",", " ", "psiNielsen"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"l1", ",", " ", 
       RowBox[{"1", "/", "3"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"l2", ",", " ", "0", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Psi] \[RightArrow] target\>\"", ",", 
        " ", "\"\<target \[RightArrow] \[Psi]\>\""}], "}"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Black", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", " ", 
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "/", "3"}], ",", " ", 
               RowBox[{"1", "/", "3"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "/", "2"}], ",", " ", 
               RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "/", "3"}], ",", " ", 
               RowBox[{"1", "/", "3"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",",
         " ", 
        RowBox[{"PointSize", "[", "Large", "]"}], ",", " ", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"psiNielsen", "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", "2"}], "]"}], "]"}], ",", " ", 
           RowBox[{"phiNielsen", "[", 
            RowBox[{"[", 
             RowBox[{";;", " ", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",", " ", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<\[Psi]\>\"", ",", " ", "14"}], "]"}], ",", " ", 
          RowBox[{"psiNielsen", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", "2"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", " ", "0"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<\[Phi]\>\"", ",", " ", "14"}], "]"}], ",", " ", 
          RowBox[{"phiNielsen", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", "2"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}]}], ",",
      "\n", "   ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "2"}], "]"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
