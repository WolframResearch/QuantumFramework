 " count 7 is drawn in time order:"
}], "Text",
 CellID->114571269,ExpressionUUID->"7ff281ec-8aa4-3b75-5366-64986c6e95dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ctH", ",", " ", "ctS", ",", " ", "ctT"}], "}"}], " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"HadamardMatrix", "[", "2", "]"}], ",", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "I"}], "}"}], "]"}], ",", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", 
           RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}], "}"}], "]"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ctMatrix", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#2", " ", ".", " ", "#1"}], " ", "&"}], ",", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
     RowBox[{"w", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<H\>\"", " ", "->", " ", "ctH"}], ",", " ", 
        RowBox[{"\"\<S\>\"", " ", "->", " ", "ctS"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ctCliffords", " ", "=", " ", 
   RowBox[{"DeleteDuplicatesBy", "[", 
    RowBox[{
     RowBox[{"Catenate", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<H\>\"", ",", " ", "\"\<S\>\""}], "}"}], ",", " ", 
          "l"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"l", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"f", " ", "=", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{"ctMatrix", "[", "#", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{"f", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"Arg", "[", 
              RowBox[{"SelectFirst", "[", 
               RowBox[{"f", ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", "#", "]"}], " ", ">", " ", "0.1"}], " ",
                  "&"}]}], "]"}], "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "6"}]}]}], "]"}]}], "]"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ctLevels", " ", "=", " ", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "ctH", " ", ".", 
             " ", "ctT"}], ",", " ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<T\>\"", ",", " ", "\"\<H\>\""}], "}"}], ",", " ", 
              
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], " ", "&"}], 
         " ", "/@", " ", "#"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", "ctS", " ", ".", 
             " ", "ctH", " ", ".", " ", "ctT"}], ",", " ", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<T\>\"", ",", " ", "\"\<H\>\"", ",", 
                " ", "\"\<S\>\""}], "}"}], ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], " ", "&"}], 
         " ", "/@", " ", "#"}]}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
        RowBox[{"{", "}"}]}], "}"}], "}"}], ",", " ", "16"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ctForms", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"t", " ", "==", " ", "0"}], ",", " ", 
     RowBox[{"ctLevels", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ctLevels", "[", 
        RowBox[{"[", 
         RowBox[{"t", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ctT", " ", ".", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<T\>\""}], 
            "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"ctLevels", "[", 
         RowBox[{"[", "t", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ctOverlaps", "[", 
    RowBox[{"t_", ",", " ", "u_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", 
         RowBox[{
          RowBox[{"ctForms", "[", "t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "]"}], " ", ".", 
      " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"u", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"ctMatrix", "[", "#", "]"}], "]"}]}], "]"}], " ", "&"}], 
        " ", "/@", " ", "ctCliffords"}], "]"}]}], "]"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ctTargets", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<R\>\"", ",", " ", "\"\<x+z\>\""}], "]"}], ",", 
         " ", "\"\<(0.8)\>\""}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "0.4"}], " ", "I", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "1", "]"}], " ", "+", " ", 
           RowBox[{"PauliMatrix", "[", "3", "]"}]}], ")"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<R\>\"", ",", " ", "\"\<z\>\""}], "]"}], ",", 
         " ", "\"\<(0.3)\>\""}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "0.15"}], " ", "I", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<R\>\"", ",", " ", "\"\<x\>\""}], "]"}], ",", 
         " ", "\"\<(1)\>\""}], "}"}], "]"}], " ", "->", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "0.5"}], " ", "I", " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ctBestWord", "[", 
    RowBox[{"t_", ",", " ", "u_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pos", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"Position", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"Max", "[", "#", "]"}]}], "]"}], "]"}], " ", "&"}], "[", 
        RowBox[{"ctOverlaps", "[", 
         RowBox[{"t", ",", " ", "u"}], "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ctCliffords", "[", 
        RowBox[{"[", 
         RowBox[{"pos", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"ctForms", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"pos", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", "2"}], "]"}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"FoldList", "[", 
           RowBox[{"Max", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"ctOverlaps", "[", 
                RowBox[{"t", ",", " ", "#"}], "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"t", ",", " ", "0", ",", " ", "16"}], "}"}]}], "]"}]}],
            "]"}]}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Values", "[", "ctTargets", "]"}]}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "16"}], "}"}]}], ",", " ", 
       RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "    ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Keys", "[", "ctTargets", "]"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<T count\>\"", ",", 
          " ", "\"\<best error \[CurlyEpsilon]\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<normal forms over \>\"", ",", " ", 
           RowBox[{"Length", "[", "ctCliffords", "]"}], ",", 
           " ", "\"\< Cliffords\>\""}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{"ctBestWord", "[", 
        RowBox[{"7", ",", " ", 
         RowBox[{"ctTargets", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "[", 
      RowBox[{"\"\<Diagram\>\"", ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "650"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], "Input",
 CellLabel->"In[82]:= ",
 CellID->308854259,ExpressionUUID->"4996f283-2296-d6f6-0b39-20202a3e7062"],

Cell[TextData[{
 "The best error falls in steps: a target can sit far from every circuit of \
one ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf6ced5-7f5c-976b-6a8a-8a898a4e6ab1"],
 " count and close to one of the next. ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    RowBox[{
     StyleBox["x", "TI"], "+", 
     StyleBox["z", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0.8", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2459b1bd-2ecf-fc2e-56c6-8efa34048422"],
 " happens to lie close to a circuit with three ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6293959f-9863-01d4-43fe-ac66ca007b6f"],
 " gates that no circuit up to ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e4a44c7-9fd5-8434-176e-119746522f6f"],
 " count 16 improves on."
}], "Text",
 CellID->357632782,ExpressionUUID->"155f0b07-52ca-3697-4cdd-581bae795900"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1489858977,ExpressionUUID->"7f025e3f-8dd2-786d-25d6-4c30c1b82f02"],

Cell["Phase estimation: how many qubits resolve two eigenphases", "Subsection",
 CellID->1534406552,ExpressionUUID->"7492e72c-11e0-4609-2dd6-b7bda6d19c30"],

Cell[TextData[{
 "A one-qubit unitary has the eigenphases ",
 Cell[BoxData[
  SubscriptBox["\[CurlyPhi]", "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13077516-4592-a7a1-6893-e686ca55bef1"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", "2"], "=", 
   SubscriptBox["\[CurlyPhi]", "1"], "+", 
   StyleBox["\[Delta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68e64a28-18c0-ed0d-6783-a8384e2bdbe4"],
 ", and phase estimation is run with ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45942385-f652-7444-3d43-e9ed11632d23"],
 " control qubits on a target that is an equal superposition of the two \
eigenvectors. How many control qubits separate the two phases in the measured \
distribution?"
}], "Text",
 CellID->1746407786,ExpressionUUID->"2246d8b0-2f0c-6dc1-1d11-7c1c8d7bf67c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["U", "TI"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["k", "TI"]]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", "\[Pi]", 
      StyleBox["i", "TI"], 
      SubscriptBox["\[CurlyPhi]", 
       StyleBox["k", "TI"]]}]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["k", "TI"]]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "487aa3eb-9004-19e4-4577-54f071338377"],
 ", the controls in ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7a0175-413c-9997-377a-1e94c091011f"],
 " pick up the phases of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["U", "TI"], 
    SuperscriptBox["2", 
     RowBox[{
      StyleBox["t", "TI"], "-", "1"}]]], ",", "\[Ellipsis]", ",", 
   SuperscriptBox[
    StyleBox["U", "TI"], "2"], ",", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68949169-5951-cc5e-645b-da50f99c5b8e"],
 " and an inverse Fourier transform reads them out. Each eigenvector \
contributes with its weight, so the outcome ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6508609f-2657-47f2-130d-d616107dc17a"],
 " appears with probability"
}], "Text",
 CellID->1534727929,ExpressionUUID->"3fd5f0ad-6bf9-78be-4762-268d620bd400"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      RowBox[{
       StyleBox["k", "TI"], "=", "1"}], ",", "2"}],
     LimitsPositioning->False], 
    FractionBox[
     SuperscriptBox[GridBox[{
        {
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["k", "TI"]]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
     SuperscriptBox["4", 
      StyleBox["t", "TI"]]], 
    SuperscriptBox[GridBox[{
       {
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
           StyleBox["y", "TI"], "=", "0"}], 
          RowBox[{
           SuperscriptBox["2", 
            StyleBox["t", "TI"]], "-", "1"}],
          LimitsPositioning->False], 
         StyleBox["exp",
          FontSlant->"Plain"], "\[ThinSpace]", "(", 
         RowBox[{"2", "\[Pi]", 
          StyleBox["i", "TI"], "\[ThinSpace]", 
          StyleBox["y", "TI"], "(", 
          RowBox[{
           SubscriptBox["\[CurlyPhi]", 
            StyleBox["k", "TI"]], "-", 
           FractionBox[
            StyleBox["x", "TI"], 
            SuperscriptBox["2", 
             StyleBox["t", "TI"]]]}], ")"}], ")"}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SuperscriptBox[GridBox[{
       {
        SubscriptBox[
         StyleBox["c", "TI"], "1"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
    RowBox[{
     SuperscriptBox[GridBox[{
        {
         SubscriptBox[
          StyleBox["c", "TI"], "2"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
     FractionBox["1", "2"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->913221471,ExpressionUUID->"56e096b8-dcac-6fce-0f7f-f5dc610e10e5"],

Cell[TextData[{
 "a peak of width about ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"-", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a237062-ffc9-20e0-50cb-16122399badc"],
 " around each ",
 Cell[BoxData[
  SubscriptBox["\[CurlyPhi]", 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a6b4e8d-1d95-7f5a-722f-340942899c2b"],
 "."
}], "Text",
 CellID->1238257449,ExpressionUUID->"78a7a687-9bb8-c9aa-2bb9-e26273fb17fd"],

Cell[TextData[{
 "Phase estimation runs on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", "\[Pi]", 
      StyleBox["i", "TI"], 
      SubscriptBox["\[CurlyPhi]", "1"]}]], ",", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", "\[Pi]", 
      StyleBox["i", "TI"], 
      SubscriptBox["\[CurlyPhi]", "2"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "072d4b89-9089-8d36-0378-aa73f2fefbd5"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CurlyPhi]", "1"], "=", "0.17"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04303836-be8a-f62e-7bb5-f3417a13712f"],
 " and the target in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b41ff6f-b020-a248-74da-0338652c4b5f"],
 "; each row is the distribution for one number of control qubits, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["t", "TI"], "=", "3"}], ",", "\[Ellipsis]", ",", "9"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51120637-6c26-5240-5821-ba2a6846ea23"],
 ", with bars of width ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"-", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "120c049b-0495-020e-2ef1-dfcb82573744"],
 ", and dashed lines mark the two eigenphases:"
}], "Text",
 CellID->378398911,ExpressionUUID->"32229236-7993-25af-3dae-73f83b6759ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qpePhi1", " ", "=", " ", "0.17"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qpeProbs", "[", 
    RowBox[{"t_", ",", " ", "\[Delta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"QuantumCircuitOperator", "[", 
       RowBox[{"\"\<PhaseEstimation\>\"", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "\[Pi]", " ", "I", " ", 
             RowBox[{"{", 
              RowBox[{"qpePhi1", ",", " ", 
               RowBox[{"qpePhi1", " ", "+", " ", "\[Delta]"}]}], "}"}]}], 
            "]"}], "]"}], "]"}], ",", " ", "t"}], "]"}], "]"}], "]"}], "[", 
     "\n", "    ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{
       RowBox[{"StringRepeat", "[", 
        RowBox[{"\"\<0\>\"", ",", " ", "t"}], "]"}], " ", "<>", 
       " ", "\"\<+\>\""}], "]"}], "]"}], "[", "\"\<ProbabilitiesList\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qpePanel", "[", "\[Delta]_", "]"}], " ", ":=", " ", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"p", " ", "=", " ", 
             RowBox[{"qpeProbs", "[", 
              RowBox[{"t", ",", " ", "\[Delta]"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", 
             " ", 
             RowBox[{"MapIndexed", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Rectangle", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], " ", "-", " ", "1"}], 
                    ")"}], "/", 
                    RowBox[{"2", "^", "t"}]}], ",", " ", "t"}], "}"}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], "/", 
                    RowBox[{"2", "^", "t"}]}], ",", " ", 
                    RowBox[{"t", " ", "+", " ", 
                    RowBox[{"0.9", " ", "#1"}]}]}], "}"}]}], "]"}], " ", 
                "&"}], ",", " ", "p"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "3", ",", " ", "9"}], "}"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", " ", "Gray", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", " ", "2.8"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"#", ",", " ", "10"}], "}"}]}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"qpePhi1", ",", " ", 
            RowBox[{"qpePhi1", " ", "+", " ", "\[Delta]"}]}], "}"}]}]}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0.5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2.8", ",", " ", "10"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "0.9"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "   ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<measured phase x / \>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"2", ",", " ", "\"\<t\>\""}], "]"}]}], "}"}], "]"}], ",", 
        " ", "\"\<control qubits t\>\""}], "}"}]}], ",", " ", 
     RowBox[{"FrameTicks", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"3", ",", " ", "9"}], "]"}], ",", " ", "None"}], "}"}], ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "None"}], "}"}]}], "}"}]}], ",", "\n",
      "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Delta] = \>\"", ",", " ", "\[Delta]"}], "}"}], "]"}]}],
      ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "330"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumCircuitOperator", "[", 
         RowBox[{"\"\<PhaseEstimation\>\"", "[", 
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", "I", " ", 
               RowBox[{"{", 
                RowBox[{"qpePhi1", ",", " ", 
                 RowBox[{"qpePhi1", " ", "+", " ", "0.1"}]}], "}"}]}], "]"}], 
             "]"}], "]"}], ",", " ", "3"}], "]"}], "]"}], "[", 
        RowBox[{"\"\<Diagram\>\"", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",", " ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<phase estimation with t = 3 control qubits\>\"", ",", 
         " ", "13", ",", " ", 
         RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}],
        ",", " ", "Top"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{"{", 
         RowBox[{"qpePanel", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"0.1", ",", " ", "0.02"}], "}"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"legendBelow", "[", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"SwatchLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], "}"}], 
             ",", " ", 
             RowBox[{"{", "\"\<P(x): bar height in each row\>\"", "}"}]}], 
            "]"}], ",", " ", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Directive", "[", 
               RowBox[{"Gray", ",", " ", "Dashed"}], "]"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<eigenphases \>\"", ",", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<\[CurlyPhi]\>\"", ",", " ", "1"}], "]"}], ",", 
                 " ", "\"\<, \>\"", ",", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<\[CurlyPhi]\>\"", ",", " ", "2"}], "]"}]}], 
                "}"}], "]"}], "}"}]}], "]"}]}], "}"}], "]"}], "]"}]}], 
      "]"}]}], "}"}], ",", " ", "Center", ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "Input",
 CellLabel->"In[83]:= ",
 CellID->1565698175,ExpressionUUID->"03b9ddd5-761e-ac24-0b80-8e5f9d3a8339"],

Cell[TextData[{
 "While ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"-", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "625f4463-2bd9-b3e2-5027-712112e4dcc1"],
 " exceeds ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76b9124a-986d-b7a7-51fb-3711f3396375"],
 " both phases fall on the same few bars; once ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"-", 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "430fa0e0-2d2a-ef70-516c-1afad8067094"],
 " is a few times smaller than ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e5cd85-4aa7-2a75-2504-38ea8c2711a7"],
 " each phase has its own peak, so a smaller separation needs more control \
qubits. A phase that falls between grid points ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "/", 
   SuperscriptBox["2", 
    StyleBox["t", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "024a8225-9666-4783-2ca4-195f0877d6a3"],
 " spreads its probability over the nearest bars."
}], "Text",
 CellID->396303699,ExpressionUUID->"30094f9c-319b-dd16-4c60-9753cea74ea1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1973583314,ExpressionUUID->"48231938-6eaf-ce41-187d-622d12b779a6"],

Cell["Shor's algorithm factors 15 and 21", "Subsection",
 CellID->308498468,ExpressionUUID->"656adbb7-996a-bf55-790f-c0c9072d62e8"],

Cell[TextData[{
 "To factor ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17ef5554-4a33-e1cb-1295-18c183c900ed"],
 ", pick ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "206ed546-1414-d41b-7d52-56b6231b22a4"],
 " coprime to ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5058c651-9955-2213-0471-267132b17b1e"],
 " and find its order ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7598c56b-6d57-6db2-576c-1fa018824917"],
 ", the smallest ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27cfe934-28c1-5508-11e2-2b20d6a7906e"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["r", "TI"]], "\[Congruent]", "1", "(", 
   StyleBox["mod",
    FontSlant->"Plain"], " ", 
   StyleBox["N", "TI"], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "059a7bd0-e69f-f4b1-7a77-5ad1d557a6ea"],
 ". If ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d1235b7-c949-394f-7b47-82d3257f83af"],
 " is even and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], 
    RowBox[{
     StyleBox["r", "TI"], "/", "2"}]], "\[NotCongruent]", "-", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000c945e-92ec-937b-79d6-b7ae47b11b58"],
 ", then ",
 Cell[BoxData[
  RowBox[{
   StyleBox["gcd",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["a", "TI"], 
      RowBox[{
       StyleBox["r", "TI"], "/", "2"}]], "\[PlusMinus]", "1"}], ",", 
    StyleBox["N", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d8ddc9c-fcb5-befa-1854-75dde00d22ce"],
 " are factors. Can phase estimation find ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c025660-d4dc-716f-0971-4e48e158c7a9"],
 " from a single distribution?"
}], "Text",
 CellID->357903922,ExpressionUUID->"64a4b0c7-ed15-3df9-7b85-1b9d223b13a9"],

Cell[TextData[{
 "The work register holds ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["y", "TI"], "\[Element]", "{", "0"}], ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["N", "TI"], "-", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "088de0b7-c317-9d8a-35e4-1516e926c1e8"],
 " in as many qubits as ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28c81ec2-0980-4f28-5b7e-82626a559ee4"],
 " has bits, and the multiplier ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["U", "TI"], 
     StyleBox["a", "TI"]], 
    TemplateBox[{
      StyleBox["y", "TI"]},
     "Ket"]}], "=", 
   TemplateBox[{
     RowBox[{
       StyleBox["a", "TI"], 
       StyleBox["y", "TI"], 
       StyleBox["mod", FontSlant -> "Plain"], 
       StyleBox["N", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39367aed-a4ef-8b19-5ca1-dbafaee658f7"],
 " (identity on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["y", "TI"], "\[GreaterEqual]", 
   StyleBox["N", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01085101-6cc5-fb65-45aa-efc4237460cc"],
 ") is unitary because ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c1b0879-0708-2152-2338-f2f001155d84"],
 " is invertible mod ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56d2b29b-68b1-aa9b-5c97-f72166e1604e"],
 ". Starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"1"},
    "Ket"], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      StyleBox["r", "TI"]]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["k", "TI"], "=", "0"}], 
      RowBox[{
       StyleBox["r", "TI"], "-", "1"}],
      LimitsPositioning->False], 
     TemplateBox[{
       SubscriptBox[
        StyleBox["u", "TI"], 
        StyleBox["k", "TI"]]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "185ca029-3438-f352-094b-068142dd0ddb"],
 ", an equal superposition of eigenvectors with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["U", "TI"], 
     StyleBox["a", "TI"]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["k", "TI"]]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"2", "\[Pi]", 
      StyleBox["i", "TI"], 
      StyleBox["k", "TI"], "/", 
      StyleBox["r", "TI"]}]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["u", "TI"], 
       StyleBox["k", "TI"]]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20c6d520-75b9-b959-0d1f-655d899fbb24"],
 ", phase estimation with ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f817c8a-16cb-9c59-40f9-6b648dc36e84"],
 " control qubits returns ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d4a6170-840e-c2b2-4b6c-e18840fb6c5e"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "/", 
   SuperscriptBox["2", 
    StyleBox["t", "TI"]], "\[TildeTilde]", 
   StyleBox["k", "TI"], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f150728-3e05-b08c-08ad-103c5418b62b"],
 ", each ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06024c4c-aee4-93f9-5ed9-feab9b64f508"],
 " with probability ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40fcae53-2e48-2dd1-0bf3-2ad8f316fc97"],
 ". When ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31d5f625-3df3-aece-1724-24adaaf3c970"],
 " divides ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ccc686-9f57-b2e6-443e-96b23dea088f"],
 " the peaks are exact; otherwise each spreads over its neighbors. The \
outcome nearest ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46be8c43-bd6f-8184-60b3-12fcceff6dd1"],
 " lies within ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{"-", 
    StyleBox["t", "TI"], "-", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31b9e54d-4b02-4f8c-2b46-a85d3fd88d71"],
 " of it, and since ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    StyleBox["t", "TI"]], ">", 
   SuperscriptBox[
    StyleBox["N", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "219c27d6-8cab-e7f2-7a55-bbcd9204979e"],
 " its continued-fraction convergent with denominator below ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "438203e1-35ce-82ad-4549-0467be32961e"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55c8cfd9-6435-1a48-5884-f5463e34594a"],
 " in lowest terms, so ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "327a2b0f-4f97-7c45-452b-8ee5c438074a"],
 " is the least common multiple of those denominators; outcomes further out \
carry no such guarantee."
}], "Text",
 CellID->128315830,ExpressionUUID->"1675adc8-3cd6-1450-7c8c-7816abd8bc82"],

Cell[TextData[{
 "Phase estimation runs with its initial ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fbdc6b2-6fab-2b45-5627-498431839cad"],
 " gates removed and the work register in ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3781f3bb-c0e5-099d-1fff-ccf98f7058ca"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "241cc51d-ef3c-61d0-4ecb-c39a259ea17e"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "15"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43b5c8bf-6c5a-4d22-4f22-89f583c1262c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "9"}]], "InlineFormula",
