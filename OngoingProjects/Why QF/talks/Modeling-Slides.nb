     RowBox[{
      StyleBox["q", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], ")"}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->682077713,ExpressionUUID->"5faea229-48e0-111f-13ac-a10d9145d365"],

Cell[TextData[{
 "The solution for general ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b86632a-1640-86d3-434d-49d05d48194e"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7074dd-5d61-8c17-6fed-d12594acb36e"],
 " from three initial states gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b5795ac-d5cf-9ffd-64d4-64377acb33b9"],
 " on the ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18028e1a-2b02-a89a-19e9-5da4b1ca5f59"],
 " grid, shown at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26393077-f7d7-77ce-53ec-5ebb70de74e0"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "*"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76a912d9-e30f-972a-3b2c-a51336de7b32"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "*"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a9312a-7fcc-0617-1c05-ef50258cbcd0"],
 " and ",
 Cell[BoxData["\[Infinity]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2555cb1d-545a-edb0-238f-8c0a328c6232"],
 ", where ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["t", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf4858f-d61a-f980-2ec4-87abbccfa316"],
 " is the time at which the last negative entry reaches zero (at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"], "=", "0"}], ",", 
   RowBox[{"1", ",", "2"}], ",", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c2b53c0-c869-89b3-65ba-160e53c360a7"],
 " when no such time exists); every grid shares one color scale, and time is \
in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb09038-1e1f-6e24-0cc9-aea4b8922cd1"],
 ":"
}], "Text",
 CellID->1529757074,ExpressionUUID->"04fdccd1-2803-2b4b-406d-74296819635f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dephA7", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Z\>\"", "[", "3", "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<Z\>\"", "[", "3", "]"}], "]"}], " ", "@", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<Z\>\"", "[", "3", "]"}], "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerA7", "[", "\[Psi]_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumEvolve", "[", 
          RowBox[{
           RowBox[{"QuantumOperator", "[", 
            RowBox[{"0", " ", 
             RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], ",", " ", 
           RowBox[{"dephA7", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Gamma]", "/", "3"}], ",", " ", 
              RowBox[{"\[Gamma]", "/", "3"}]}], "}"}]}], ",", "\n", "       ", 
           RowBox[{"QuantumState", "[", "\[Psi]", "]"}], ",", " ", "t"}], 
          "]"}], "[", "\"\<PhaseSpace\>\"", "]"}], "]"}], "]"}], " ", "/.", 
      " ", 
      RowBox[{"\[Gamma]", " ", "->", " ", "1"}]}], ",", " ", 
     RowBox[{"t", " ", ">=", " ", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"deathA7", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Replace", "[", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "==", " ", "0"}], " ", "&&", " ", 
           RowBox[{"t", " ", ">", " ", "0"}]}], ",", " ", "t", ",", " ", 
          "Reals"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "}"}], " ", "->", " ", "\[Infinity]"}], ",", " ", 
          RowBox[{"sol_", " ", ":>", " ", 
           RowBox[{"(", 
            RowBox[{"t", " ", "/.", " ", 
             RowBox[{"First", "[", "sol", "]"}]}], ")"}]}]}], "}"}]}], "]"}], 
      " ", "&"}], " ", "/@", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", "w", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "/.", " ", 
           RowBox[{"t", " ", "->", " ", "0"}]}], ")"}], " ", "<", " ", "0"}], 
        " ", "&"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statesA7", " ", "=", " ", 
   RowBox[{"KeyMap", "[", 
    RowBox[{"TraditionalForm", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Divide", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Ket", "[", 
             RowBox[{"{", "1", "}"}], "]"}], " ", "-", " ", 
            RowBox[{"Ket", "[", 
             RowBox[{"{", "2", "}"}], "]"}]}], ",", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "]"}], " ", "->", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Divide", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Ket", "[", 
             RowBox[{"{", "0", "}"}], "]"}], " ", "+", " ", 
            RowBox[{"I", " ", 
             RowBox[{"Ket", "[", 
              RowBox[{"{", "1", "}"}], "]"}]}], " ", "-", " ", 
            RowBox[{"Ket", "[", 
             RowBox[{"{", "2", "}"}], "]"}]}], ",", " ", 
           RowBox[{"Sqrt", "[", "3", "]"}]}], "]"}], "]"}], " ", "->", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "I", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Divide", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Sqrt", "[", "2", "]"}], " ", 
             RowBox[{"Ket", "[", 
              RowBox[{"{", "0", "}"}], "]"}]}], " ", "+", " ", 
            RowBox[{"Ket", "[", 
             RowBox[{"{", "1", "}"}], "]"}], " ", "-", " ", 
            RowBox[{"Ket", "[", 
             RowBox[{"{", "2", "}"}], "]"}]}], ",", " ", "2"}], "]"}], "]"}], 
        " ", "->", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], ",", " ", "1", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], "/", "2"}]}]}], "|>"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"colorA7", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<ThermometerColors\>\"", "]"}], "[", 
     RowBox[{"Rescale", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "3"}], ",", " ", 
         RowBox[{"1", "/", "3"}]}], "}"}]}], "]"}], "]"}], " ", "&"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gridA7", "[", 
    RowBox[{"w_", ",", " ", "tv_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"Limit", "[", 
        RowBox[{"w", ",", " ", 
         RowBox[{"t", " ", "->", " ", "tv"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"MatrixPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "m", "]"}], ",", " ", 
       RowBox[{"ColorFunction", " ", "->", " ", "colorA7"}], ",", " ", 
       RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"DataReversed", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"Mesh", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"FrameTicks", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", 
            "None"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", 
            "None"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<q\>\"", ",", " ", "\"\<p\>\""}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"Epilog", " ", "->", " ", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"#1", " ", "==", " ", "0"}], ",", " ", "\"\<0\>\"", ",",
                  " ", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"N", "[", "#1", "]"}], ",", " ", "2"}], "]"}]}], 
                "]"}], ",", " ", "Black"}], "]"}], ",", " ", 
             RowBox[{"#2", " ", "-", " ", 
              RowBox[{"1", "/", "2"}]}]}], "]"}], " ", "&"}], ",", " ", "m", ",",
           " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Gamma] t = \>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", "tv", "]"}]}], "}"}], "]"}]}], ",",
        " ", 
       RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"rowsA7", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"\[Psi]", ",", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"w", " ", "=", " ", 
          RowBox[{"wignerA7", "[", "\[Psi]", "]"}]}], "}"}], ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ts", " ", "=", " ", 
            RowBox[{"deathA7", "[", "w", "]"}]}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"gridA7", "[", 
             RowBox[{"w", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"ts", " ", "===", " ", "\[Infinity]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
              "0", ",", " ", "1", ",", " ", "2", ",", " ", "\[Infinity]"}], 
              "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", 
               RowBox[{"ts", "/", "2"}], ",", " ", "ts", ",", " ", 
               "\[Infinity]"}], "}"}]}], "]"}]}]}], "]"}]}], "]"}]}], "]"}], 
    " ", "/@", " ", "statesA7"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Values", "[", "rowsA7", "]"}], "[", 
        RowBox[{"[", "s", "]"}], "]"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"BarLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"colorA7", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "/", "3"}], ",", " ", 
             RowBox[{"1", "/", "3"}]}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"LegendLabel", " ", "->", " ", "\"\<W\>\""}]}], "]"}], ",", 
       " ", "Right"}], "]"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"Length", "[", "rowsA7", "]"}], ",", " ", "\"\<state\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", "#2", "]"}], " ", "->", " ", "#1"}], " ", 
        "&"}], ",", " ", 
       RowBox[{"Keys", "[", "rowsA7", "]"}]}], "]"}], ",", " ", "SetterBar"}],
     "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[10]:= ",
 CellID->1701455113,ExpressionUUID->"7db5b423-1d92-0805-23f1-9017ea285c56"],

Cell[TextData[{
 "An entry that starts negative and whose limit ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], "\[Infinity]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126431b7-cd87-e0e1-429b-ea3fd687c6d5"],
 " is positive crosses zero at the exact time ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "*"], "=", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "(", 
   RowBox[{"1", "+", GridBox[{
      {
       SubscriptBox[
        StyleBox["W", "TI"], "0"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "/", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Infinity]"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4885014a-f7c7-269f-7b97-e48526774601"],
 ", and different phase-space points cross at different times. With no \
population in ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb227c3-670d-b794-25e7-c36e3645f716"],
 ", the single negative entry of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"1"},
      "Ket"], "-", 
     TemplateBox[{"2"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e46eb6a-0159-b5e0-5ed9-a633ce2acd0b"],
 " sits where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], "\[Infinity]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3590c876-fd83-3554-1133-46d577a83e45"],
 " is zero, so it only decays and the negativity never dies."
}], "Text",
 CellID->1263725061,ExpressionUUID->"2d42a09f-9211-65b3-6782-eb6a4432aa13"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1953622044,ExpressionUUID->"20c808a6-321e-6db8-38dd-3ae41ec48e78"],

Cell["A driven Kerr cavity: sub- or super-Poissonian steady light", \
"Subsection",
 CellID->789879331,ExpressionUUID->"62653187-3565-ebc9-6c16-06974f8b4e4b"],

Cell[TextData[{
 "A cavity mode of frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "748fb0eb-2d69-2e9f-11e1-e30c9f521e9b"],
 " with a Kerr nonlinearity ",
 Cell[BoxData[
  StyleBox["K", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f92c6ab-f457-86e2-70e3-e6d52f75a814"],
 " is driven at amplitude ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13a5e134-c28f-0496-779d-ba8f616e0ff9"],
 " and frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fabeb2d-f223-6406-659f-aaf85651b4c8"],
 ", and leaks photons at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71d17dc0-d3a1-dfdb-4f98-d1403bc30c88"],
 ". Drive and loss balance in a steady state. For which detuning, Kerr \
strength and drive is the steady light sub-Poissonian?"
}], "Text",
 CellID->500411642,ExpressionUUID->"5ceea9b7-e6ff-460f-75ec-2a7b6f565875"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e7c5dc-5c2e-8d09-3f81-125bf0bc2b30"],
 ", the Hamiltonian, and its form in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5644f1d1-2941-91bc-11d4-0175b788f57e"],
 ", are"
}], "Text",
 CellID->1708147932,ExpressionUUID->"3d864aaa-abe0-6f7a-66a8-e7cd36167072"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], "=", 
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["c", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox[
     StyleBox["K", "TI"], "2"], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     RowBox[{"\[Dagger]", "2"}]], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2"], "+", 
    StyleBox["F", "TI"], "(", 
    RowBox[{
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[ThinSpace]", 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{
       StyleBox["i", "TI"], 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["d", "TI"]], 
       StyleBox["t", "TI"]}]], "+", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], 
        StyleBox["d", "TI"]], 
       StyleBox["t", "TI"]}]]}], ")", "\[ThickSpace]", "\[LongRightArrow]", 
    "\[ThickSpace]", "-", "\[CapitalDelta]", "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox[
     StyleBox["K", "TI"], "2"], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     RowBox[{"\[Dagger]", "2"}]], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2"], "+", 
    StyleBox["F", "TI"], "(", 
    RowBox[{
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "+", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"]}], ")"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["d", "TI"]], "-", 
     SubscriptBox[
      StyleBox["\[Omega]", "TI"], 
      StyleBox["c", "TI"]]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->291071734,ExpressionUUID->"652f8140-6c08-57c6-2fca-4cb6f55980ca"],

Cell[TextData[{
 "and the loss enters through ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], "=", "\[ScriptCapitalL]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c78a486-4656-764b-0304-af61bc8c0285"],
 ". Light is sub-Poissonian, which no classical field is, when the Mandel \
parameter ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "2"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "-", 
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["n", "TI"], "^"], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"], "-", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05966a34-ab43-68bd-14ab-cfad1add60bc"],
 " is negative. The steady state is known in closed form (Drummond and \
Walls): with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["c", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Kappa]", "TI"], "-", "2", 
    StyleBox["i", "TI"], "\[CapitalDelta]"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"i", "K"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "792195d8-021f-ad00-5ac9-872cf3094503"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "2", 
   StyleBox["F", "TI"], "/", 
   StyleBox["K", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669b8daf-8687-ac42-2a1c-e90b385c41f9"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     RowBox[{"\[Dagger]", 
      StyleBox["j", "TI"]}]], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     StyleBox["j", "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["x", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], 
    RowBox[{"2", 
     StyleBox["j", "TI"]}]], 
   FractionBox[
    RowBox[{"\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["c", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["c", "TI"], "*"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["c", "TI"], "+", 
      StyleBox["j", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "\[CapitalGamma]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["c", "TI"], "*"], "+", 
      StyleBox["j", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SubscriptBox["", "0"], 
     SubscriptBox[
      StyleBox["F", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{";", 
      RowBox[{
       StyleBox["c", "TI"], "+", 
       StyleBox["j", "TI"]}], ",", 
      RowBox[{
       SuperscriptBox[
        StyleBox["c", "TI"], "*"], "+", 
       StyleBox["j", "TI"]}], ";", 
      RowBox[{"2", 
       SuperscriptBox[GridBox[{
          {
           StyleBox["x", "TI"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     SubscriptBox["", "0"], 
     SubscriptBox[
      StyleBox["F", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{";", 
      StyleBox["c", "TI"], ",", 
      SuperscriptBox[
       StyleBox["c", "TI"], "*"], ";", 
      RowBox[{"2", 
       SuperscriptBox[GridBox[{
          {
           StyleBox["x", "TI"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1301aa98-0246-7dc9-59ba-6c241a43d10e"],
 ". The smallest nonzero decay rate of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008297f7-7991-4003-52f3-2204f8084595"],
 ", the gap ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a71c0ad-ae8f-a4ef-59dd-a14074723c69"],
 ", sets how long the slowest transient lasts."
}], "Text",
 CellID->1086620463,ExpressionUUID->"28ef6821-141a-2c1e-79f8-ff9d0bac24b3"],

Cell[TextData[{
 "The vacuum evolves under the exponential of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "099e7280-59de-6f85-2052-d1392ad1357e"],
 ", and the gap (legends) comes from its spectrum; the closed-form steady ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b8eb580-7f46-8e74-2ddd-4bd0924bfaad"],
 " is dashed; rates are in units of ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da00aaf-9c0b-b501-0d63-7a9733859b72"],
 ", with 24 Fock levels:"
}], "Text",
 CellID->270036435,ExpressionUUID->"6c6beb28-90ae-24c2-005b-fb9f73d873f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"kerrLevels", ",", " ", "kerrTimes"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"24", ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.1", ",", " ", "20", ",", " ", "0.1"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "kerrLevels", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrH", "[", 
    RowBox[{"\[CapitalDelta]_", ",", " ", "K_", ",", " ", "F_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[CapitalDelta]"}], " ", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "kerrA", "]"}], " ", "@", " ", "kerrA"}]}], 
    " ", "+", " ", 
    RowBox[{
     RowBox[{"K", "/", "2"}], " ", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "kerrA", "]"}], " ", "@", " ", 
      RowBox[{
       RowBox[{"SuperDagger", "[", "kerrA", "]"}], " ", "@", " ", 
       RowBox[{"kerrA", " ", "@", " ", "kerrA"}]}]}]}], " ", "+", " ", 
    RowBox[{"F", " ", 
     RowBox[{"(", 
      RowBox[{"kerrA", " ", "+", " ", 
       RowBox[{"SuperDagger", "[", "kerrA", "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrQ", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"Diagonal", "[", "\[Rho]", "]"}], "/", 
          RowBox[{"Tr", "[", "\[Rho]", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"kerrLevels", " ", "-", " ", "1"}]}], "]"}]}]}], "}"}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"m", "^", "2"}], " ", ".", " ", "p"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", " ", ".", " ", "p"}], ")"}], "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"m", " ", ".", " ", "p"}], ")"}]}], " ", "-", " ", "1"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrMoment", "[", 
    RowBox[{
    "\[CapitalDelta]_", ",", " ", "K_", ",", " ", "F_", ",", " ", "j_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"2", " ", "I", " ", "\[CapitalDelta]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"I", " ", "K"}], ")"}]}], "]"}]}], ",", " ", 
       RowBox[{"x2", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"F", "/", "K"}]}], ")"}], "^", "2"}], "]"}]}]}], "}"}], ",",
      "\n", "    ", 
     RowBox[{
      RowBox[{"x2", "^", "j"}], " ", 
      RowBox[{"Gamma", "[", "c", "]"}], " ", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"Conjugate", "[", "c", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"c", " ", "+", " ", "j"}], "]"}], " ", 
         RowBox[{"Gamma", "[", 
          RowBox[{
           RowBox[{"Conjugate", "[", "c", "]"}], " ", "+", " ", "j"}], 
          "]"}]}], ")"}]}], " ", 
      RowBox[{
       RowBox[{"HypergeometricPFQ", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", " ", "+", " ", "j"}], ",", " ", 
           RowBox[{
            RowBox[{"Conjugate", "[", "c", "]"}], " ", "+", " ", "j"}]}], 
          "}"}], ",", " ", 
         RowBox[{"2", " ", "x2"}]}], "]"}], "/", 
       RowBox[{"HypergeometricPFQ", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"c", ",", " ", 
           RowBox[{"Conjugate", "[", "c", "]"}]}], "}"}], ",", " ", 
         RowBox[{"2", " ", "x2"}]}], "]"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrQss", "[", 
    RowBox[{"\[CapitalDelta]_", ",", " ", "K_", ",", " ", "F_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n1", " ", "=", " ", 
       RowBox[{"kerrMoment", "[", 
        RowBox[{
        "\[CapitalDelta]", ",", " ", "K", ",", " ", "F", ",", " ", "1"}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"kerrMoment", "[", 
          RowBox[{
          "\[CapitalDelta]", ",", " ", "K", ",", " ", "F", ",", " ", "2"}], 
          "]"}], " ", "-", " ", 
         RowBox[{"n1", "^", "2"}]}], ")"}], "/", "n1"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrSolve", "[", 
    RowBox[{"\[CapitalDelta]_", ",", " ", "K_", ",", " ", "F_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", " ", "=", " ", 
       RowBox[{"N", " ", "@", " ", 
        RowBox[{"Normal", " ", "@", " ", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"\"\<Liouvillian\>\"", "[", 
            RowBox[{
             RowBox[{"kerrH", "[", 
              RowBox[{"\[CapitalDelta]", ",", " ", "K", ",", " ", "F"}], 
              "]"}], ",", " ", 
             RowBox[{"{", "kerrA", "}"}], ",", " ", 
             RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "[", "\"\<Matrix\>\"", 
          "]"}]}]}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"step", " ", "=", " ", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"First", "[", "kerrTimes", "]"}], " ", "L"}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"kerrTimes", ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"kerrQ", "[", 
               RowBox[{"Partition", "[", 
                RowBox[{"#", ",", " ", "kerrLevels"}], "]"}], "]"}], " ", 
              "&"}], " ", "/@", " ", 
             RowBox[{"Rest", " ", "@", " ", 
              RowBox[{"NestList", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"step", " ", ".", " ", "#"}], " ", "&"}], ",", " ", 
                RowBox[{"UnitVector", "[", 
                 RowBox[{
                  RowBox[{"kerrLevels", "^", "2"}], ",", " ", "1"}], "]"}], ",",
                 " ", 
                RowBox[{"Length", "[", "kerrTimes", "]"}]}], "]"}]}]}]}], 
           "}"}], "]"}], ",", "\n", "     ", 
         RowBox[{"kerrQss", "[", 
          RowBox[{"\[CapitalDelta]", ",", " ", "K", ",", " ", "F"}], "]"}], ",",
          " ", 
         RowBox[{"Min", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Re", " ", "@", " ", 
              RowBox[{"Eigenvalues", "[", "L", "]"}]}]}], ",", " ", 
            RowBox[{
             RowBox[{"#", " ", ">", " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "8"}]}]}], " ", "&"}]}], "]"}]}]}], "}"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kerrPanel", "[", 
    RowBox[{"\[CapitalDelta]_", ",", " ", "K_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Fs", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", " ", "1.5", ",", " ", "3"}], "}"}]}], "}"}], ",", 
     " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ss", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"kerrSolve", "[", 
            RowBox[{"\[CapitalDelta]", ",", " ", "K", ",", " ", "#"}], "]"}], 
           " ", "&"}], " ", "/@", " ", "Fs"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"Show", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"ss", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", 
           "        ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<F/\[Kappa] = \>\"", ",", " ", "#1", ",", 
                  " ", "\"\<,   \[Lambda]/\[Kappa] = \>\"", ",", " ", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{"#2", ",", " ", "2"}], "]"}]}], "}"}], "]"}], " ", 
               "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Fs", ",", " ", 
                RowBox[{"ss", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "3"}], "]"}], "]"}]}], "}"}]}], 
             "]"}]}]}], "]"}], ",", "\n", "      ", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"ss", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", 
             RowBox[{"Last", "[", "kerrTimes", "]"}]}], "}"}], ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Thin", ",", " ", "Dashed"}], "]"}]}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[Kappa] t\>\"", ",", " ", "\"\<Mandel Q\>\""}], 
           "}"}]}], ",", "\n", "      ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[CapitalDelta]/\[Kappa] = \>\"", ",", " ", 
             "\[CapitalDelta]", ",", " ", "\"\<,   K/\[Kappa] = \>\"", ",", 
             " ", "K"}], "}"}], "]"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kerrPanels", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"kerrPanel", " ", "@@", " ", "#"}], " ", "&"}], ",", " ", 
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2.5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", "2.5", ",", " ", "10"}], "}"}]}], "}"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"kerrPanels", "[", 
    RowBox[{"{", 
     RowBox[{"d", ",", " ", "k"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", " ", "0", ",", " ", "\"\<\[CapitalDelta]/\[Kappa]\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2.5"}], "}"}], ",", " ", "SetterBar"}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0.5", ",", " ", "\"\<K/\[Kappa]\>\""}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "2.5", ",", " ", "10"}], "}"}], ",", " ", 
     "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[11]:= ",
 CellID->1642556927,ExpressionUUID->"213d13e7-241e-911d-1120-a220411c2928"],

Cell[TextData[{
 "Every transient but one settles on the closed-form steady value within \
twenty photon lifetimes. On resonance every steady state is sub-Poissonian, \
and the cavity reaches it within a few photon lifetimes, with gaps near the \
empty-cavity value ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70cd826d-334f-ae28-4024-b838c8b5c026"],
 ". Detuning makes the sign of ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a157b74-8e18-dd8f-5f99-593ecdae5849"],
 " depend on the drive and the Kerr strength: some steady states become \
super-Poissonian, and in one of them the gap nearly closes, so ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18c042de-f675-9b06-2df7-8a403499253d"],
 " is still far from its steady value after twenty photon lifetimes."
}], "Text",
 CellID->773882931,ExpressionUUID->"474d3373-0f51-5d08-01a6-2c95536def43"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->24404122,ExpressionUUID->"5289520b-ddc1-33ab-5c5f-d26d707e1f49"],

Cell["Photon loss and the Heisenberg advantage of a NOON state", "Subsection",
 CellID->1896186496,ExpressionUUID->"4b2b348b-032d-b21f-1595-c5bd8be46209"],

Cell[TextData[{
 "A NOON state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       RowBox[{
         StyleBox["n", "TI"], ",", "0"}]},
      "Ket"], "+", 
     TemplateBox[{
       RowBox[{"0", ",", 
         StyleBox["n", "TI"]}]},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c73bbf-f662-8e75-7f2e-5bb142ca5d21"],
 " enters the two arms of an interferometer; arm 2 carries an unknown phase \
",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77336237-6661-cea2-49ee-348213c002e1"],
 ", and arm ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a6488ed-54f7-cf83-429b-6ac50fa4a7ac"],
 " transmits each photon with probability ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Eta]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1698a84a-d57b-e173-299a-6dd961613ecd"],
 ". Any estimate of ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138b241f-7c7f-81a4-5ad6-9b56547431c3"],
 " has error at least ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["F", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a4f04b1-1bc4-7245-303d-111c7c740d84"],
 ", where ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c947ac-c05f-3c9d-65cc-f8164e3eb2ed"],
 " is the quantum Fisher information, and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a23a68b-2b18-9df6-3db0-39b4c00322cd"],
 " independent photons reach ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb20c24-705c-9fdf-4938-440597f142ac"],
 ", the shot-noise limit. Does the NOON advantage keep growing with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2587477b-91fa-bff4-4226-cda6ffdef601"],
 " once photons are lost?"
}], "Text",
 CellID->1177856204,ExpressionUUID->"4a0746c4-36e4-3800-615f-4ee25f3b41a0"],

Cell[TextData[{
 "The phase acts as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Theta]", "TI"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d13c79e-0de2-322b-68c7-02659005f446"],
 ", each arm loses photons through the beam-splitter loss channel of \
transmission ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Eta]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0225cd53-f5a9-0369-1677-44d72c605a78"],
 ", and for the lossy state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], 
      StyleBox["i", "TI"]], 
     TemplateBox[{
       StyleBox["i", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["i", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c92198-e19d-eb9c-6f5a-9a64796fbb0c"]
}], "Text",
 CellID->104431095,ExpressionUUID->"3594315e-57b0-40ef-2ff7-e8fdb9f45a7e"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["F", "TI"], "=", 
   RowBox[{"2", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Lambda]", "TI"], 
        StyleBox["i", "TI"]], "+", 
       SubscriptBox[
        StyleBox["\[Lambda]", "TI"], 
        StyleBox["j", "TI"]], ">", "0"}],
      LimitsPositioning->False], 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          SubscriptBox[
           StyleBox["\[Lambda]", "TI"], 
           StyleBox["i", "TI"]], "-", 
          SubscriptBox[
           StyleBox["\[Lambda]", "TI"], 
           StyleBox["j", "TI"]]}], 
         StyleBox[")",
          SpanMaxSize->1]}], "2"], 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], 
         StyleBox["i", "TI"]], "+", 
        SubscriptBox[
         StyleBox["\[Lambda]", "TI"], 
         StyleBox["j", "TI"]]}]], "\[ThinSpace]", 
      RowBox[{
       SuperscriptBox[GridBox[{
          {
           RowBox[{
            TemplateBox[{
              StyleBox["i", "TI"]},
             "Bra"], 
            SubscriptBox[
             OverscriptBox[
              StyleBox["n", "TI"], "^"], "2"], 
            TemplateBox[{
              StyleBox["j", "TI"]},
             "Ket"]}]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->497190960,ExpressionUUID->"71361715-986d-f22b-065a-be280519bc86"],

Cell[TextData[{
 "For symbolic ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5be1ea5d-76fc-b420-2ed8-ad6fa4ea8b4c"],
 " the interferometer gives the probability that all ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2101dd84-a9d2-44cc-719b-e6da68e2b737"],
 " photons survive each arm, ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["\[Eta]", "TI"], "1", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d9ae824-9389-648b-76e5-e69e5e9ac3a2"],
 " and ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["\[Eta]", "TI"], "2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b991a85-2f67-1572-6c8c-22cd05ba98cb"],
 ". The phase lives only in the coherence between ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["n", "TI"], ",", "0"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5389b352-98b5-d7fa-435c-352fab64526b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"0", ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604f80d2-a37c-42ca-16a6-bae9c97e6b64"],
 ", and only the branch in which no photon is lost keeps it; a single Kraus \
operator acts on that branch, so it stays pure and the coherence is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Eta]", "TI"], "1", 
      StyleBox["n", "TI"]], 
     SubsuperscriptBox[
      StyleBox["\[Eta]", "TI"], "2", 
      StyleBox["n", "TI"]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521c37cd-4db9-5c88-408e-467cf059da60"],
 ", which gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "=", "2", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   SubsuperscriptBox[
    StyleBox["\[Eta]", "TI"], "1", 
    StyleBox["n", "TI"]], 
   SubsuperscriptBox[
    StyleBox["\[Eta]", "TI"], "2", 
    StyleBox["n", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[Eta]", "TI"], "1", 
     StyleBox["n", "TI"]], "+", 
    SubsuperscriptBox[
     StyleBox["\[Eta]", "TI"], "2", 
     StyleBox["n", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5daebc21-1c7a-f60a-45d3-5d0b9ee6f2b9"],
 " for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66bc5df4-77dd-4ab2-0a5b-ee3ab6084e5c"],
 ". Curves are this ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac21376-ae81-61df-2c92-acbdb08be64f"],
 ", markers are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0091939a-14fb-2614-14c5-64d2f03bf370"],
 " from the eigenpairs of the full lossy state, and the gridline at 1 is shot \
noise:"
}], "Text",
 CellID->1702078563,ExpressionUUID->"26b0c182-5f17-8482-1ea5-cf00cf2211b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"noonState", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"FockState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"n", " ", "+", " ", "1"}]}], "]"}], " ", "+", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "n"}], "}"}], ",", " ", 
        RowBox[{"n", " ", "+", " ", "1"}]}], "]"}]}], ")"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"noonLoss", "[", 
    RowBox[{"\[Eta]1_", ",", " ", "\[Eta]2_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<Loss\>\"", "[", "\[Eta]1", "]"}], " ", "->", " ", "1"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"\"\<Loss\>\"", "[", "\[Eta]2", "]"}], " ", "->", " ", 
        "2"}]}], "}"}], ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"noonSurvival", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"noonLoss", "[", 
       RowBox[{"\[Eta]1", ",", " ", "\[Eta]2"}], "]"}], "[", 
      RowBox[{"\"\<Probability\>\"", ",", " ", 
       RowBox[{"#", " ", "->", " ", "#"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"n", " ", "\[Element]", " ", "PositiveIntegers"}]}]}], "]"}], 
     " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "n"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"noonFisher", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"n", "^", "2"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Times", " ", "@@", " ", "noonSurvival"}], ")"}], "/", 
     RowBox[{"Total", "[", "noonSurvival", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"noonQFI", "[", 
    RowBox[{"\[Rho]_", ",", " ", "G_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", "=", " ", 
          RowBox[{"Re", "[", 
           RowBox[{"First", "[", "#", "]"}], "]"}]}], ",", " ", 
         RowBox[{"v", " ", "=", " ", 
          RowBox[{"Last", "[", "#", "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"2", " ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Outer", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#1", " ", "+", " ", "#2"}], " ", ">", " ", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "10"}]}]}], ",", " ", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"#1", " ", "-", " ", "#2"}], ")"}], "^", "2"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"#1", " ", "+", " ", "#2"}], ")"}]}], ",", " ", 
                "0"}], "]"}], " ", "&"}], ",", " ", "\[Lambda]", ",", " ", 
             "\[Lambda]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "G", " ", ".",
               " ", 
              RowBox[{"Transpose", "[", "v", "]"}]}], "]"}], "^", "2"}]}], ",",
           " ", "2"}], "]"}]}]}], "]"}], " ", "&"}], " ", "@", " ", 
    RowBox[{"Eigensystem", "[", "\[Rho]", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"noonGain", "[", 
    RowBox[{"\[Eta]1v_", ",", " ", "\[Eta]2v_", ",", " ", "nv_"}], "]"}], " ",
    ":=", " ", 
   RowBox[{
    RowBox[{"noonQFI", "[", 
     RowBox[{
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"noonLoss", "[", 
          RowBox[{"\[Eta]1v", ",", " ", "\[Eta]2v"}], "]"}], "[", 
         RowBox[{"noonState", "[", "nv", "]"}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}]}], ",", " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"nv", " ", "+", " ", "1"}], "]"}], ",", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "nv"}], "]"}], "]"}]}], "]"}]}], "]"}], "/", 
    "nv"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"noonPanel", "[", "\[Eta]1v_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Eta]2s", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0.95", ",", " ", "0.9", ",", " ", "0.8"}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"Show", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"nv", ",", " ", 
             RowBox[{"noonGain", "[", 
              RowBox[{"\[Eta]1v", ",", " ", "\[Eta]2v", ",", " ", "nv"}], 
              "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[Eta]2v", ",", " ", "\[Eta]2s"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"nv", ",", " ", "20"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<\[Eta]\>\"", ",", " ", "2"}], "]"}], ",", 
                " ", "\"\< = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", "&"}],
             " ", "/@", " ", "\[Eta]2s"}], ")"}]}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "Small"}], "}"}]}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"noonFisher", "/", "n"}], " ", "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[Eta]1", " ", "->", " ", "\[Eta]1v"}], ",", " ", 
               RowBox[{"\[Eta]2", " ", "->", " ", "#"}]}], "}"}]}], " ", 
            "&"}], " ", "/@", " ", "\[Eta]2s"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "1", ",", " ", "20"}], "}"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "11"}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<n\>\"", ",", " ", "\"\<F/n\>\""}], "}"}]}], ",", " ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"None", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Eta]\>\"", ",", " ", "1"}], "]"}], ",", 
           " ", "\"\< = \>\"", ",", " ", "\[Eta]1v"}], "}"}], "]"}]}], ",", 
       " ", 
       RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"noonPanels", " ", "=", " ", 
   RowBox[{"noonPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.95", ",", " ", "0.9", ",", " ", "0.8"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", "noonPanels"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "660"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "noonPanels", "]"}], "]"}], "]"}]}], "]"}], ",", 
   "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sub", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Eta]1", " ", "->", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<\[Eta]\>\"", ",", " ", "1"}], "]"}]}], ",", " ", 
         RowBox[{"\[Eta]2", " ", "->", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<\[Eta]\>\"", ",", " ", "2"}], "]"}]}]}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<all \>\"", ",", " ", "n", ",", 
          " ", "\"\< photons survive:  \>\"", ",", " ", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"noonSurvival", " ", "/.", " ", "sub"}], "]"}], ",", 
          " ", "\"\<,     F = \>\"", ",", " ", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"noonFisher", " ", "/.", " ", "sub"}], "]"}]}], "}"}], 
        "]"}], ",", " ", "13", ",", " ", 
       RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}]}],
     "]"}], ",", " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[12]:= ",
 CellID->464502757,ExpressionUUID->"272d8e22-cd3f-0256-0e98-688b9425b57d"],

Cell[TextData[{
 "The markers sit on the curves, which for equal arms reduce to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "=", 
   SuperscriptBox[
    StyleBox["n", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d7a9b20-c294-620e-7513-772e8cbc7cf3"],
 ". Since ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], "1"], 
     SubscriptBox[
      StyleBox["\[Eta]", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c15e7f7-11c4-29a8-5a47-d1b07d3a0f24"],
 " eventually beats ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ad8e5fa-d850-dee6-0e5b-4a3c870e5171"],
 ", the gain peaks even if only one arm loses photons, and the more loss, the \
smaller the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22e71a03-1c32-867c-488f-8a1d1ec9a011"],
 " at which it peaks; with both arms at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "0.8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "488b5ecc-aeff-3761-1c6c-a1654737f0da"],
 " it falls back below shot noise within the plotted range."
}], "Text",
 CellID->499755699,ExpressionUUID->"449b8627-672c-c674-19e9-201ea0cb3ba3"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->231895782,ExpressionUUID->"50819089-9057-39f2-0e4f-5b9e543ff5aa"],

Cell["Collapse and revival of an atom in a coherent field", "Subsection",
 CellID->2139662887,ExpressionUUID->"1cd91990-093a-cd47-633c-fc440d628858"],

Cell[TextData[{
 "An excited two-level atom, frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60a37f48-2099-2a7a-63a7-b346f8b2f611"],
 ", enters a cavity of frequency ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "658fede7-1084-a3a2-2765-6c9cea71d000"],
 " that holds a coherent field with mean photon number ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b952bdc-0798-c6aa-6525-b14c656e093f"],
 ", and couples to it at strength ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "298c7de4-01d2-c0d1-05de-d999fe1b030e"],
 ". Does the atom's Rabi oscillation survive the spread of photon numbers in \
the field?"
}], "Text",
 CellID->1218094376,ExpressionUUID->"1d9795f9-c390-c94c-4218-77069dd52d79"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6105793e-8844-b35b-061f-6a7099f20d6f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21f8186d-e8ac-d71e-626d-2aaab5b150e8"],
 ", the Jaynes-Cummings Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], "+", 
   FractionBox[
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["a", "TI"]], "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "+"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0eec8b-2de7-0de2-5866-ec58bb707359"],
 " becomes ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "+"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6be9e3d9-9a84-ed03-22d2-4e5844d8ff6f"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["a", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "299dbe54-cf39-25d1-2e27-a9ffa98c251c"],
 ", in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73327f4c-ab16-847a-2542-e5d3aef83eee"],
 ". ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["H", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0534162c-27ad-69c5-1116-ad154127ba72"],
 " couples ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53221798-0331-f7ce-32fd-fb029317f2d1"],
 " only to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["n", "TI"], "+", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2590b32b-d97e-b954-3a8e-46e5dc05f56f"],
 ", so the propagator is a ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72d8364c-ba62-bf80-6e31-dc2028639619"],
 " block for each ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000835a8-d470-9140-589a-5a1ab371ddf9"],
 ", with off-diagonal element ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "469a2328-b781-8e81-3e0a-fd5076edec20"],
 ". Exponentiating the block for general ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0595f89b-744e-4ce8-3f1a-ae03e187178c"],
 ", ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08418af7-01f7-9169-3291-3dd234e2eb5f"],
 ", ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16a7c959-0eca-fd40-3ba5-e3834dd16ea0"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44ebeeff-9268-b4a1-1b64-ab8a7397f812"],
 " gives the inversion ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["w", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["e", "TI"]], "-", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["g", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0be05e-2015-62c8-2006-e710475141d5"],
 " from ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "439177e7-123a-55e2-6131-100667598107"],
 " in closed form, weighted with the Poisson distribution of the coherent \
field; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05cc8972-fb2c-6355-557c-6824a00d3649"],
 ":"
}], "Text",
 CellID->1367747305,ExpressionUUID->"70751d07-c4f1-f986-0f1d-42b807bb943c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"jcBlock", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "/", "2"}], ",", " ", 
       RowBox[{"g", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"n", " ", "+", " ", "1"}], "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"n", " ", "+", " ", "1"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "\[CapitalDelta]"}], "/", "2"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"jcU", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"MatrixExp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "t", " ", "jcBlock"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"g", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"n", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[CapitalDelta]", " ", "\[Element]", " ", "Reals"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jcInversion", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"jcU", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "^", "2"}], " ",
        "-", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"jcU", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}], "^", "2"}]}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"g", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"n", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"t", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[CapitalDelta]", " ", "\[Element]", " ", "Reals"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jcRecord", "[", 
    RowBox[{"nbar_", ",", " ", "\[CapitalDelta]v_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ms", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Ceiling", "[", 
          RowBox[{"nbar", " ", "+", " ", 
           RowBox[{"8", " ", 
            RowBox[{"Sqrt", "[", "nbar", "]"}]}], " ", "+", " ", "10"}], 
          "]"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"PoissonDistribution", "[", "nbar", "]"}], ",", " ", "ms"}], 
        "]"}], "]"}], " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{"jcInversion", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", " ", "->", " ", "ms"}], ",", " ", 
          RowBox[{"g", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\[CapitalDelta]", " ", "->", " ", "\[CapitalDelta]v"}]}], 
         "}"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jcPanel", "[", 
    RowBox[{"nbar_", ",", " ", "\[CapitalDelta]v_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"jcRecord", "[", 
       RowBox[{"nbar", ",", " ", "\[CapitalDelta]v"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "60"}], "}"}], ",", " ", 
     RowBox[{"PlotPoints", " ", "->", " ", "2500"}], ",", " ", 
     RowBox[{"MaxRecursion", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<g t\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<P\>\"", ",", " ", "\"\<e\>\""}], "]"}], ",", 
           " ", "\"\< - \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<P\>\"", ",", " ", "\"\<g\>\""}], "]"}]}], "}"}], 
         "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}], ",", " ", "\"\< = \>\"", 
         ",", " ", "nbar", ",", " ", "\"\<,   \[CapitalDelta]/g = \>\"", ",", 
         " ", "\[CapitalDelta]v"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "330"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jcPanels", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"jcPanel", " ", "@@", " ", "#"}], " ", "&"}], ",", " ", 
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "20"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "2", ",", " ", "4", ",", " ", "6"}], "}"}]}], 
       "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"formula", " ", "=", " ", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<w\>\"", ",", " ", "\"\<n\>\""}], "]"}], ",", 
          " ", "\"\<(t) = \>\"", ",", " ", 
          RowBox[{"TraditionalForm", "[", "jcInversion", "]"}]}], "}"}], 
        "]"}], ",", " ", "13", ",", " ", 
       RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"jcPanels", "[", 
      RowBox[{"{", 
       RowBox[{"nb", ",", " ", "d"}], "}"}], "]"}], ",", "\n", "    ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Control", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"nb", ",", " ", "20", ",", " ", 
                RowBox[{"OverBar", "[", "\"\<n\>\"", "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"5", ",", " ", "20"}], "}"}], ",", " ", "SetterBar"}], 
             "}"}], "]"}], ",", " ", 
           RowBox[{"Control", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "d", ",", " ", "0", ",", " ", "\"\<\[CapitalDelta]/g\>\""}], 
               "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "2", ",", " ", "4", ",", " ", "6"}], 
               "}"}], ",", " ", "SetterBar"}], "}"}], "]"}]}], "}"}], "]"}], ",",
         " ", 
        RowBox[{"Spacer", "[", "40", "]"}], ",", " ", "formula"}], "}"}], 
      "]"}], ",", "\n", "    ", 
     RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[13]:= ",
 CellID->471358270,ExpressionUUID->"4a394300-dad6-f564-61f0-f78097cc4faa"],

Cell[TextData[{
 "The oscillation does not survive at first: the photon numbers rotate the \
atom at different frequencies ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalDelta]", "2"], "+", "4", 
    SuperscriptBox[
     StyleBox["g", "TI"], "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "713f2d24-1f2b-fc1a-79f2-09a6911c31f7"],
 ", so the inversion collapses within a few ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f43a8b1-3ed2-76d2-3d16-a336a03568cc"],
 ", and it revives when their phases realign. On resonance the revivals stand \
apart cleanly only in the larger field. Detuning lifts the level around which \
the inversion oscillates, because each ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["w", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3235260e-a571-1294-1268-9b98e36e34c0"],
 " is pulled toward 1, and delays the revival; the larger the detuning, the \
closer the inversion stays to 1 and the less the atom emits."
}], "Text",
 CellID->86914683,ExpressionUUID->"62f400e0-c8c5-d895-3060-8ef59cd229cc"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1397423483,ExpressionUUID->"3f2a2694-4506-4d98-695b-a1669e4d7ec6"],

Cell["\<\
How much cavity Wigner negativity the atomic record certifies\
\>", "Subsection",
 CellID->553956863,ExpressionUUID->"52a4db9b-0b50-4f57-54eb-1bea9a1d5e09"],

Cell[TextData[{
 "An excited atom meets a cavity field, and after a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4794af98-0c4b-8906-2400-31cbbd86d096"],
 " only the atom's inversion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["e", "TI"]], "-", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["g", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23bdf769-a5f9-ae87-4b46-d057fce04101"],
 " is recorded. The cavity, coupled to the atom at strength ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3278d158-7132-72c5-2723-c9742f442ba0"],
 ", detuned by ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "474badda-81d5-7226-73d0-8db43c5e23a9"],
 " and leaking photons at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3612d717-61ff-04cb-574e-5c6760ba12ec"],
 ", can develop a Wigner function ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c9008a-b5ea-79bc-235a-dfa00639243b"],
 " with negative regions. Fields with the same photon-number distribution ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfa01c-0a64-8e00-06d0-bba435d54341"],
 " give the atom the same record; how much negative volume ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"-", 
     StyleBox["W", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bf6ff24-6843-0c63-48d2-ef76fe7d6cf9"],
 " do all of them share?"
}], "Text",
 CellID->116211384,ExpressionUUID->"04b036d2-4b0d-e93c-6e23-122ff1127bb0"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5086192f-f2b2-30af-0e16-ca1161d426e6"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e75c375-c897-4d0a-26eb-05cc726eeefc"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25ce0d58-8bc9-e722-26b1-86cb899f47ce"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19130701-e225-4b7e-1ea3-c35af5adeb18"],
 ", the atom and cavity, frequencies ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "343106ce-f8c2-9eb3-1ab2-8cac92a039dd"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70dd4c4b-c9e5-c2cd-38ed-f1b7a8a23136"],
 ", follow the Jaynes-Cummings Hamiltonian in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45467490-3889-b7bf-6d5a-320ecc899790"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["H", "TI"], "^"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "+", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "+"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40cf9b14-89b5-9628-4861-c03f351c3ea1"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["a", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "225f044f-5f06-0b89-0ced-f6c6f7b2ad9a"],
 ", and the loss enters through ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["H", "TI"], "^"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "036e6434-8fa8-f192-2603-a1cc7f2568df"],
 ". The coupling conserves the excitation number ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "+"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], "-"], "+", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54998406-ef0f-b213-21ab-3c3325947d13"],
 " and loss only lowers it, so an atom starting in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "670f0ae2-882d-d464-7a00-8e90ffcebd1b"],
 " writes into ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "505e4429-ccd7-d2c1-5ec8-e6305ef357e5"],
 " only the photon-number distribution ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008dcf5b-952c-bfc0-235f-3e43ce2f3ab8"],
 " of the field. Averaging the field over its phase keeps ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69ebe31b-1154-3dad-3f31-1863234a7855"],
 " and averages ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6834337b-3011-9ea2-69f8-245f30ac5fa8"],
 " over the angle, which can cancel negative regions but never create them; \
the averaged ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ce5f88c-9021-4437-7d9f-7574e101ff3a"],
 " depends only on the radius, so its negative volume is a radial integral."
}], "Text",
 CellID->2140780886,ExpressionUUID->"53a1641d-46fa-1619-7eff-23c8443dff94"],

Cell[TextData[{
 "For the phase-randomized field, with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f368234-d4d0-8adc-2199-daa0ebf5b723"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d5c8b2-6c0f-d44a-1224-d95897ec462f"],
 " the Laguerre polynomial, the negative volume follows from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f4bac16-d011-04bb-6dab-e892b4ed5e6f"],
 " alone:"
}], "Text",
 CellID->2364046,ExpressionUUID->"5230e357-9e52-4b0c-0c25-65d89e67f458"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["N", "TI"], "_"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"2", "\[Pi]", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
      RowBox[{
       StyleBox["r", "TI"], "\[ThinSpace]", 
       StyleBox["max",
        FontSlant->"Plain"], "\[ThinSpace]", 
       RowBox[{"(", 
        RowBox[{"0", ",", "\[ThinSpace]", 
         RowBox[{"-", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            StyleBox["n", "TI"],
            LimitsPositioning->False], 
           RowBox[{
            SubscriptBox[
             StyleBox["p", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{
             StyleBox["(",
              SpanMaxSize->1], 
             StyleBox["t", "TI"], 
             StyleBox[")",
              SpanMaxSize->1]}], "\[ThinSpace]", 
            SubscriptBox[
             StyleBox["W", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{
             StyleBox["(",
              SpanMaxSize->1], 
             StyleBox["r", "TI"], 
             StyleBox[")",
              SpanMaxSize->1]}]}]}]}]}], ")"}], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["r", "TI"]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["n", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["r", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", "1"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["n", "TI"]], "\[Pi]"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["n", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       SuperscriptBox[
        StyleBox["r", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[ThinSpace]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        SuperscriptBox[
         StyleBox["r", "TI"], "2"]}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1896005334,ExpressionUUID->"3bf2ec3d-ec6e-a989-4160-ff78ccbb633f"],

Cell[TextData[{
 "The atom starts in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61ac153d-5a77-562e-05f9-425f27338835"],
 " with a coherent field of mean photon number 4, and with its \
phase-randomized version ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->False], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["n", "TI"]], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52a0cddf-e3e1-54ea-0ce6-eec38729a3cc"],
 ". The left panel plots the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61f1fd5e-bf3a-146f-3f99-733d513b8c44"],
 "; the right panel plots the negative volume ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"-", 
     StyleBox["W", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e58830-b4fe-83e9-28eb-c1ce633433e1"],
 " of the coherent field (solid) and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["N", "TI"], "_"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24320408-6c20-5464-007b-63c11bf7e9a0"],
 " (dashed); time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c710a60-810c-5215-2043-1dc6ada8dfd4"],
 ":"
}], "Text",
 CellID->638836912,ExpressionUUID->"05833434-62a0-52e0-6a6f-50f826da6bd1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"negA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"20", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"negField", " ", "=", " ", 
   RowBox[{
    RowBox[{"CoherentState", "[", "20", "]"}], "[", "2.", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negH", "[", "\[CapitalDelta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], " ", "@", " ", 
     RowBox[{"SuperDagger", "[", "negA", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"SuperDagger", "[", 
      RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], "]"}], " ", "@", 
     " ", "negA"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negVolume", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Ramp", "[", 
      RowBox[{"-", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"WignerRepresentation", "[", 
          RowBox[{"\[Rho]", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5."}], ",", " ", "5."}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5."}], ",", " ", "5."}], "}"}], ",", " ", 
           RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "81"}]}], "]"}], 
         "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}]}], "]"}], "]"}], "/", 
    "64"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negRadii", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.005", ",", " ", "6", ",", " ", "0.01"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"negFock", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
      RowBox[{"LaguerreL", "[", 
       RowBox[{"m", ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"negRadii", "^", "2"}]}]}], "]"}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"negRadii", "^", "2"}]}], "]"}], "/", "\[Pi]"}]}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "19"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negRadial", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{"2", " ", "\[Pi]", " ", "0.01", " ", 
    RowBox[{"negRadii", " ", ".", " ", 
     RowBox[{"Ramp", "[", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Diagonal", "[", 
          RowBox[{"Normal", "[", 
           RowBox[{"\[Rho]", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], 
          "]"}], "]"}], " ", ".", " ", "negFock"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negRun", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Kappa]_", ",", " ", "\[CapitalDelta]_"}], "}"}], ",", " ", 
     "field_", ",", " ", "volume_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evo", " ", "=", " ", 
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{
         RowBox[{"negH", "[", "\[CapitalDelta]", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "negA", "}"}], " ", "->", " ", 
          RowBox[{"{", "\[Kappa]", "}"}]}], ",", " ", 
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
           "field"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "16"}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<record\>\"", ",", " ", "\"\<negativity\>\""}], "}"}], 
       " ", "->", " ", 
       RowBox[{"Transpose", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"s", ",", " ", 
              RowBox[{"Re", " ", "@", " ", 
               RowBox[{"Tr", "[", 
                RowBox[{
                 RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
                 RowBox[{"Normal", " ", "@", " ", 
                  RowBox[{
                   RowBox[{"QuantumPartialTrace", "[", 
                    RowBox[{
                    RowBox[{"evo", "[", "s", "]"}], ",", " ", 
                    RowBox[{"{", "2", "}"}]}], "]"}], 
                   "[", "\"\<DensityMatrix\>\"", "]"}]}]}], "]"}]}]}], "}"}], 
            ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"s", ",", " ", 
              RowBox[{"volume", "[", 
               RowBox[{"QuantumPartialTrace", "[", 
                RowBox[{
                 RowBox[{"evo", "[", "s", "]"}], ",", " ", 
                 RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "0", ",", " ", "16", ",", " ", "0.1"}], 
           "}"}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negCases", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", " ", "2"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negData", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Merge", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"negRun", "[", 
           RowBox[{"#", ",", " ", "negField", ",", " ", "negVolume"}], "]"}], 
          ",", " ", 
          RowBox[{"negRun", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"QuantumState", "[", 
             RowBox[{
              RowBox[{"DiagonalMatrix", "[", 
               RowBox[{"negField", "[", "\"\<ProbabilitiesList\>\"", "]"}], 
               "]"}], ",", " ", "20"}], "]"}], ",", " ", "negRadial"}], 
           "]"}]}], "}"}], ",", " ", "Identity"}], "]"}], " ", "&"}], ",", 
     " ", "negCases"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negAxes", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<record\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<z\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<negativity\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<negative volume\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0.4"}], "}"}]}], "}"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negPanel", "[", 
    RowBox[{"key_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Kappa]_", ",", " ", "\[CapitalDelta]_"}], "}"}]}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"negData", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Kappa]", ",", " ", "\[CapitalDelta]"}], "}"}], ",", " ", 
       "key"}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{
       RowBox[{"negAxes", "[", "key", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<coherent field\>\"", ",", 
        " ", "\"\<phase-randomized field\>\""}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<g t\>\"", ",", " ", 
        RowBox[{
         RowBox[{"negAxes", "[", "key", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negPanels", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"negPanel", "[", 
          RowBox[{"#", ",", " ", "c"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Keys", "[", "negAxes", "]"}]}]}], "]"}], ",", " ", 
     "negCases"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{"First", " ", "/@", " ", 
        RowBox[{"negPanels", "[", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "d"}], "}"}], "]"}]}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", 
        RowBox[{"negPanels", "[", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "d"}], "}"}], "]"}], "]"}], "]"}], "]"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "\"\<\[Kappa]/g\>\""}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.1"}], "}"}], ",", " ", "SetterBar"}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "0", ",", " ", "\"\<\[CapitalDelta]/g\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", "SetterBar"}], "}"}], ",",
    " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[14]:= ",
 CellID->430719822,ExpressionUUID->"104c6ddd-868a-924d-15b4-35e479e1fa29"],

Cell[TextData[{
 "The cavity's Wigner function shows what the two curves measure; red is \
positive and blue negative, on resonance and without loss, at four times in \
units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ef5af62-3f3f-b805-3872-144386719713"],
 ":"
}], "Text",
 CellID->1196179774,ExpressionUUID->"2fab34a0-17e2-02d8-4e6e-849dd6f8bb87"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"negTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "2", ",", " ", "6", ",", " ", "12"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"negColor", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{"w", ",", " ", 
     RowBox[{"Blend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.2", ",", " ", "0.3", ",", " ", "0.8"}], "]"}], ",", " ", 
         "White", ",", " ", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.85", ",", " ", "0.2", ",", " ", "0.15"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"0.5", " ", "+", " ", 
        RowBox[{"0.5", " ", 
         RowBox[{"Sign", "[", "w", "]"}], " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "w", "]"}], "/", "0.32"}], ",", " ", "1"}], 
           "]"}], "]"}]}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negEvo", "[", "field_", "]"}], " ", ":=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"negH", "[", "0", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", "negA", "}"}], " ", "->", " ", 
      RowBox[{"{", "0", "}"}]}], ",", " ", 
     RowBox[{"QuantumTensorProduct", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", "field"}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "16"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negTile", "[", 
    RowBox[{"evo_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"WignerRepresentation", "[", 
          RowBox[{
           RowBox[{"QuantumPartialTrace", "[", 
            RowBox[{
             RowBox[{"evo", "[", "s", "]"}], ",", " ", 
             RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4."}], ",", " ", "4."}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4."}], ",", " ", "4."}], "}"}], ",", " ", 
           RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "81"}]}], "]"}], 
         "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ListDensityPlot", "[", 
      RowBox[{"w", ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", "\n", 
       "    ", 
       RowBox[{"ColorFunction", " ", "->", " ", "negColor"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"FrameStyle", " ", "->", " ", 
        RowBox[{"GrayLevel", "[", "0.7", "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "110"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"negTile", "[", 
               RowBox[{
                RowBox[{"negEvo", "[", 
                 RowBox[{"Last", "[", "f", "]"}], "]"}], ",", " ", "#"}], 
               "]"}], " ", "&"}], " ", "/@", " ", "negTimes"}], ",", " ", 
            RowBox[{"First", "[", "f", "]"}]}], "]"}]}], "]"}], " ", "/@", 
        "\n", "    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<coherent field\>\"", " ", "->", " ", "negField"}], ",",
           " ", 
          RowBox[{"\"\<phase-randomized field\>\"", " ", "->", " ", 
           RowBox[{"QuantumState", "[", 
            RowBox[{
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"negField", "[", "\"\<ProbabilitiesList\>\"", "]"}], 
              "]"}], ",", " ", "20"}], "]"}]}]}], "}"}]}], ",", "\n", "   ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<g t = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", "negTimes"}], ",", " ", "\"\<\>\""}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", "0.5"}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"BarLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"negColor", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.32"}], ",", " ", "0.32"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"LegendLabel", " ", "->", " ", "\"\<W(x, p)\>\""}]}], "]"}], ",",
      " ", "Right"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[15]:= ",
 CellID->1547910459,ExpressionUUID->"625baf77-8f7e-424b-51f5-e954f1415688"],

Cell[TextData[{
 "The two records coincide in every panel, so the atom cannot tell the \
coherent field from its phase-randomized version; in phase space the coherent \
field carries strong negative stripes, while its phase-randomized twin keeps \
only a thin negative ring. Any field with the same ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bcaa953-2370-b3c7-21c5-0d77d1a99c20"],
 " has at least the dashed negative volume, and the phase-randomized field \
reaches it, so the dashed curve is what they all share; it wiggles because \
the atom keeps trading photons with the field and reshapes ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec3248b-7e9a-7f83-7dec-00f91ffcce2c"],
 " on the Rabi time scale. The rest, carried by coherences between photon \
numbers, is most of the negativity between collapse and revival, and with \
loss the guaranteed part is the first to vanish."
}], "Text",
 CellID->1041325139,ExpressionUUID->"4aacd4c3-0859-692e-0e16-c435377f41a2"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1219526466,ExpressionUUID->"11085de7-e2b9-6fb2-5261-fa664f9e28cc"],

Cell["Event-triggered control of a decaying qubit", "Subsection",
 CellID->585161887,ExpressionUUID->"45f722cd-77a0-68e6-26ce-fc5f84db71c1"],

Cell[TextData[{
 "A qubit decays from ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04a37261-17a2-fe42-6cb7-2a55ee69824c"],
 " at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03ccaa27-d5ef-3614-374b-c268ce9e9e3d"],
 " under a drive of Rabi frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "582413cc-d644-c4e9-50d5-8a73ecc86aad"],
 ", detuned by ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b64124-129f-1f69-5948-ac273fe532d5"],
 ". A controller that tracks the excited population ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a534153-c70e-4ae4-6e8c-44f4320c3ed1"],
 " from the model, without measuring the qubit, switches the drive off when \
",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e686a2b-3c2e-9e03-64f5-780114356ea6"],
 " rises above ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "+", "0.02"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7050c46e-3b34-d284-53a4-4f6bfb6da8a9"],
 " and back on when it falls below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "-", "0.02"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "750adbed-ed5e-85d2-3550-0fd16588277f"],
 ". A constant drive lets ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["P", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ba438d-11fb-f871-67c4-d555b06c6bf7"],
 " settle at or below ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a3b1d96-c773-bfc4-40ff-001acc55569d"],
 "; can the switching hold it at a target ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f41b9c2-4dec-0396-45cc-7519740ed0ce"],
 " above that?"
}], "Text",
 CellID->2053749851,ExpressionUUID->"5e950d68-089d-4844-5633-1e6defc22d1c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41814004-1bb1-cd4c-7317-8cd9090a81ec"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a761929-7f90-1b1b-51da-a49b2e7a7c17"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af13182-5b3d-2bb8-6d75-45072e4e859f"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ae2856-4b42-e6bc-0593-09b7fa81431e"],
 ", the driven qubit in the frame rotating at the drive frequency is"
}], "Text",
 CellID->594572180,ExpressionUUID->"203a0b5b-6349-ce51-137d-e8d129ee66d6"],

