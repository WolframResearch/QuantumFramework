  FontSize->0.9 Inherited,ExpressionUUID->
  "37c80b7d-965a-635e-5941-d97a8a28b698"],
 " is a dot:"
}], "Text",
 CellID->1554456642,ExpressionUUID->"11c7e308-5f62-06e0-12e9-ccbc4fa46754"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"icAD", " ", "=", " ", 
   RowBox[{"QuantityMagnitude", " ", "@", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"out", " ", "=", " ", 
          RowBox[{
           RowBox[{"QuantumChannel", "[", 
            RowBox[{
             RowBox[{"\"\<AmplitudeDamping\>\"", "[", "\[Gamma]", "]"}], ",", 
             " ", 
             RowBox[{"{", "1", "}"}]}], "]"}], "[", 
           RowBox[{
            RowBox[{"QuantumState", "[", 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", " ", "-", " ", "p"}], ",", " ", "p"}], "}"}], 
              "]"}], "]"}], "[", "\"\<Purify\>\"", "]"}], "]"}]}], "}"}], ",",
         "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"QuantumPartialTrace", "[", 
           RowBox[{"out", ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<VonNeumannEntropy\>\"",
           "]"}], " ", "-", " ", 
         RowBox[{"out", "[", "\"\<VonNeumannEntropy\>\"", "]"}]}]}], "]"}], ",",
       " ", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}], " ", "&&", " ", 
       
       RowBox[{"0", " ", "<", " ", "\[Gamma]", " ", "<", " ", "1"}]}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h2AD", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "x"}], " ", 
     RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
     RowBox[{"Log2", "[", 
      RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"icClosedQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"icAD", " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"h2AD", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "\[Gamma]"}], ")"}], " ", "p"}], 
          "]"}], " ", "-", " ", 
         RowBox[{"h2AD", "[", 
          RowBox[{"\[Gamma]", " ", "p"}], "]"}]}], ")"}]}], ",", " ", 
      RowBox[{
       RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}], " ", "&&", " ", 
       
       RowBox[{"0", " ", "<", " ", "\[Gamma]", " ", "<", " ", "1"}]}]}], 
     "]"}], " ", "===", " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]sAD", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "/", "10"}], ",", " ", 
     RowBox[{"1", "/", "4"}], ",", " ", 
     RowBox[{"1", "/", "3"}], ",", " ", 
     RowBox[{"1", "/", "2"}], ",", " ", 
     RowBox[{"3", "/", "4"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"belowHalfAD", " ", "=", " ", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"h2AD", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", "\[Gamma]"}], ")"}], " ", "p"}], 
             "]"}], " ", "-", " ", 
            RowBox[{"h2AD", "[", 
             RowBox[{"\[Gamma]", " ", "p"}], "]"}]}], ",", " ", "p"}], "]"}], 
         " ", "/.", " ", 
         RowBox[{"p", " ", "->", " ", 
          RowBox[{"1", "/", "2"}]}]}], ")"}], " ", ">=", " ", "0"}], " ", "&&",
       " ", 
      RowBox[{"0", " ", "<", " ", "\[Gamma]", " ", "<", " ", 
       RowBox[{"1", "/", "2"}]}]}], ",", " ", "\[Gamma]", ",", " ", "Reals"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bestAD", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Through", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ArgMax", ",", " ", "MaxValue"}], "}"}], "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"icAD", " ", "/.", " ", 
           RowBox[{"\[Gamma]", " ", "->", " ", "#"}]}], ",", " ", 
          RowBox[{"0", " ", "<=", " ", "p", " ", "<=", " ", "1"}]}], "}"}], ",",
         " ", "p"}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"\[Gamma]sAD", ",", " ", 
      RowBox[{
       RowBox[{"#", " ", "<", " ", 
        RowBox[{"1", "/", "2"}]}], " ", "&"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"icAD", " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "#"}]}], " ", "&"}], " ", "/@", 
       " ", "\[Gamma]sAD"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<\[Gamma] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
         "&"}], " ", "/@", " ", "\[Gamma]sAD"}], ")"}]}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"List", " ", "/@", " ", 
      RowBox[{"N", "[", "bestAD", "]"}]}], ",", " ", 
     RowBox[{"PlotMarkers", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "10"}], "}"}]}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<p\>\"", ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<I\>\"", ",", " ", "\"\<c\>\""}], "]"}], ",", 
         " ", "\"\< (bits)\>\""}], "}"}], "]"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<I\>\"", ",", " ", "\"\<c\>\""}], "]"}], ",", 
           " ", "\"\< = \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<h\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\<((1-\[Gamma])p) - \>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<h\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\<(\[Gamma]p):  \>\"", ",", " ", "icClosedQ"}], "}"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<slope at p = 1/2 \[GreaterEqual] 0 for some \[Gamma] < \
1/2:  \>\"", ",", " ", "belowHalfAD"}], "}"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[131]:= ",
 CellID->881338484,ExpressionUUID->"700d9367-260c-32ca-0e2e-0d081260c900"],

Cell[TextData[{
 "The output keeps the population ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30cd2948-267c-e971-1658-71190445c439"],
 " and the environment receives ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Gamma]", "p"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21ba2610-55bf-eeb1-2680-a8769349291a"],
 ". Below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66450b28-e3c4-a67a-3128-faef0d56f7bf"],
 " the slope at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62e7d837-d1b3-084e-0c73-7f3dbb1dff1e"],
 " is negative for every ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cfb52eb-176e-ec5f-6920-dcdf0f4f2b0b"],
 ", so the best input has ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "<", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f7d80d2-96a1-c547-474a-91b4257b9da1"],
 ", fewer excitations than the maximally mixed state. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3df3a0ce-5bdc-9411-658e-b3ca9ed88fef"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ef42d6c-242f-df9c-0106-914f505d9ab1"],
 " vanishes for every input, and at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "3", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d34eb07-ca1d-eb04-11b8-b67e8e5bf99c"],
 " no input gives a positive ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a73323-3ffd-c40b-6586-fd51ffd2b23b"],
 ": the environment then gets the larger share."
}], "Text",
 CellID->274226005,ExpressionUUID->"6374ae34-f258-9ae5-08a6-58d7f016cc94"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->89601119,ExpressionUUID->"6c0e70a1-02d5-1c2b-641a-a698c4a7c4f1"],

Cell["Data-processing inequality under named channels", "Subsection",
 CellID->1153931752,ExpressionUUID->"0167c052-9fde-37ac-0592-2fbcb8804c0e"],

Cell[TextData[{
 "Two qubit states ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "382ccd02-6096-5473-1e65-eb20863aca23"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c11d28-eeac-70d6-6076-5e1f84fb0289"],
 " have Bloch vectors of length ",
 Cell[BoxData[
  RowBox[{"3", "/", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29e5891b-81ec-db91-15c5-7e8188dcfc38"],
 " and ",
 Cell[BoxData[
  RowBox[{"4", "/", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6819a9d6-ec49-f735-5328-65b615bec13b"],
 " at an angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ceb39b9-4474-01fd-473a-1ebb593c9636"],
 ", so they do not commute. Both pass through the same channel at noise \
strength ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "129ab00d-7065-ae1d-5ad8-5871fb138b16"],
 ". Can any ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20c30137-044e-b113-1064-8a7034d9ec3d"],
 " make one of these pairs easier to tell apart?"
}], "Text",
 CellID->1737575534,ExpressionUUID->"5dbf2c03-a666-15b9-4a3c-593386af222f"],

Cell[TextData[{
 "Their distinguishability is the relative entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["log",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], "-", 
    SubscriptBox[
     StyleBox["log",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ca6c98f-734f-bd7d-2151-f5668f71617f"],
 ", and the data-processing inequality says ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\|01d4a9", 
     StyleBox["p", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[DoubleVerticalBar]", 
    SubscriptBox["\|01d4a9", 
     StyleBox["p", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Sigma]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57cef12d-0d39-a8e2-62c1-438d5051e517"],
 " for every channel ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\|01d4a9", 
    StyleBox["p", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "^"], 
    StyleBox["k", "TI"]], 
   StyleBox["\[Rho]", "TI"], 
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "^"], 
    StyleBox["k", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a618bb8-b818-9baa-4c0f-81a1dc33fece"],
 ". The four channels have Kraus operators"
}], "Text",
 CellID->2082411402,ExpressionUUID->"7b7bcab2-d91b-630e-7056-cf3aa9c2a17a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox[
     RowBox[{"depolarizing", ":", "\[NonBreakingSpace]"}],
     FontSlant->"Plain"], 
    SqrtBox[
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"3", 
        StyleBox["p", "TI"]}], "4"]}]], "\[ThinSpace]", 
    StyleBox["I", "TI"]}], ",", " ", 
   RowBox[{
    FractionBox[
     SqrtBox[
      StyleBox["p", "TI"]], "2"], 
    StyleBox["X", "TI"]}], ",", " ", 
   RowBox[{
    FractionBox[
     SqrtBox[
      StyleBox["p", "TI"]], "2"], 
    StyleBox["Y", "TI"]}], ",", " ", 
   RowBox[{
    RowBox[{
     FractionBox[
      SqrtBox[
       StyleBox["p", "TI"]], "2"], 
     StyleBox["Z", "TI"]}], ";", 
    "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
    RowBox[{
     StyleBox[
      RowBox[{"bit", "\[NonBreakingSpace]", 
       RowBox[{"flip", ":", "\[NonBreakingSpace]"}]}],
      FontSlant->"Plain"], 
     SqrtBox[
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}]], "\[ThinSpace]", 
     StyleBox["I", "TI"]}]}], ",", " ", 
   RowBox[{
    RowBox[{
     SqrtBox[
      StyleBox["p", "TI"]], "\[ThinSpace]", 
     StyleBox["X", "TI"]}], ";", 
    "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
    RowBox[{
     StyleBox[
      RowBox[{"phase", "\[NonBreakingSpace]", 
       RowBox[{"flip", ":", "\[NonBreakingSpace]"}]}],
      FontSlant->"Plain"], 
     SqrtBox[
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}]], "\[ThinSpace]", 
     StyleBox["I", "TI"]}]}], ",", " ", 
   RowBox[{
    RowBox[{
     SqrtBox[
      StyleBox["p", "TI"]], "\[ThinSpace]", 
     StyleBox["Z", "TI"]}], ";", 
    "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
    RowBox[{
     StyleBox[
      RowBox[{"phase", "\[NonBreakingSpace]", 
       RowBox[{"damping", ":", "\[NonBreakingSpace]"}]}],
      FontSlant->"Plain"], 
     RowBox[{"(", GridBox[{
        {"1", "0"},
        {"0", 
         SqrtBox[
          RowBox[{"1", "-", 
           StyleBox["p", "TI"]}]]}
       }], ")"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {"0", "0"},
       {"0", 
        SqrtBox[
         StyleBox["p", "TI"]]}
      }], ")"}], "."}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1415474432,ExpressionUUID->"35224a1f-56b5-d669-1d93-6a55fcb614aa"],

Cell[TextData[{
 "Bit flip and phase flip mix the identity with a unitary ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["U", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23c1f049-71c6-2289-5eb6-9dd65d99d2aa"],
 ", so joint convexity gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\|01d4a9", 
     StyleBox["p", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[DoubleVerticalBar]", 
    SubscriptBox["\|01d4a9", 
     StyleBox["p", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Sigma]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["p", "TI"], "\[ThinSpace]", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["U", "TI"], "^"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["U", "TI"], "^"], "\[Dagger]"], "\[DoubleVerticalBar]", 
    OverscriptBox[
     StyleBox["U", "TI"], "^"], 
    StyleBox["\[Sigma]", "TI"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["U", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2108f96d-30ec-a53f-0374-46fccd4d318b"],
 " for every ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e32014c-b1ee-71bb-0233-88ff723f8c07"],
 "."
}], "Text",
 CellID->1953366514,ExpressionUUID->"535b8961-6581-c2e6-747c-37b118b683b6"],

Cell[TextData[{
 "The processed relative entropy is a closed form in ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c71d78d-2440-002f-20a6-cdeedd5ddf84"],
 ", with ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19fb26f4-c5ab-a36e-7f20-167716a93e13"],
 " along ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33aec0c4-5f16-68a1-2a4e-6536d6422a59"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "282244fc-9f19-8ddd-536a-9e11c7852ea1"],
 " in the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14febc52-1244-b4b4-2434-20618986ec28"],
 " plane, and all of ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["p", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5addff-ad83-2b81-283e-e080d6f1f1de"],
 " is searched exactly for a depolarizing or phase-damping value above ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78364434-612b-efae-4688-5a21c5e12b4b"],
 " (dashed):"
}], "Text",
 CellID->1705730518,ExpressionUUID->"0e594cf6-640a-3527-67e6-5ed56c5bef4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"relEnt", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"QuantityMagnitude", " ", "@", " ", 
      RowBox[{"QuantumDistance", "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "\"\<RelativeEntropy\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"channelsDPI", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Depolarizing\>\"", ",", " ", "\"\<BitFlip\>\"", ",", 
     " ", "\"\<PhaseFlip\>\"", ",", " ", "\"\<PhaseDamping\>\""}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelDPI", "[", "\[Theta]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pair", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"QuantumState", "[", 
          RowBox[{"\"\<BlochVector\>\"", "[", "#", "]"}], "]"}], " ", "&"}], 
        " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", 
            RowBox[{"3", "/", "5"}]}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"4", "/", "5"}], " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], "}"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"before", " ", "=", " ", 
          RowBox[{"relEnt", " ", "@@", " ", "pair"}]}], ",", " ", 
         RowBox[{"after", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"relEnt", " ", "@@", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"QuantumChannel", "[", 
                RowBox[{"#", "[", "p", "]"}], "]"}], " ", "/@", " ", "pair"}],
               ")"}]}], " ", "&"}], " ", "/@", " ", "channelsDPI"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", "after", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "All"}], "}"}]}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", "channelsDPI"}], ",", " ", 
         RowBox[{"GridLines", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"None", ",", " ", 
            RowBox[{"{", "before", "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"GridLinesStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", " ", "Dashed"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<p\>\"", ",", 
            " ", "\"\<S(\[ScriptCapitalN](\[Rho])||\[ScriptCapitalN](\[Sigma])\
) (bits)\>\""}], "}"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", "\n", "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "\[Theta]", ",", 
             " ", "\"\<,   Reduce, p raising S: \>\"", ",", " ", 
             RowBox[{"Or", " ", "@@", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Reduce", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", " ", ">", " ", "before"}], " ", "&&", " ", 
                    RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], ",",
                    " ", "p", ",", " ", "Reals"}], "]"}], " ", "&"}], " ", "/@",
                 " ", 
                RowBox[{"after", "[", 
                 RowBox[{"[", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", " ", "4"}], "}"}], "]"}], "]"}]}], 
               ")"}]}]}], "}"}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsDPI", " ", "=", " ", 
   RowBox[{"panelDPI", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Pi", "/", "3"}], ",", " ", 
      RowBox[{"Pi", "/", "2"}], ",", " ", 
      RowBox[{"2", " ", 
       RowBox[{"Pi", "/", "3"}]}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Row", "[", 
    RowBox[{"First", " ", "/@", " ", "panelsDPI"}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "panelsDPI", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[132]:= ",
 CellID->1143554696,ExpressionUUID->"25e28e51-3317-640d-5e99-c9ac5db4a166"],

Cell[TextData[{
 "No noise strength raises the relative entropy, for any ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c97e1ae-ba74-69a3-3343-c837b7fbe950"],
 ", not only the points drawn. Depolarizing noise only lowers it, down to \
zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210e750a-354c-3820-0722-726867f73527"],
 " where both states become the maximally mixed state; phase damping only \
lowers it too. Bit flip and phase flip become the unitaries ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c42e559-32b9-4fa3-7b7d-507f6c819f24"],
 " and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ef69a00-4deb-556f-6707-855fe3390fc2"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e38f1ef-62e5-a376-7688-817a003cf16d"],
 ", so their curves climb back exactly to the dashed line there."
}], "Text",
 CellID->1625291223,ExpressionUUID->"4837b95c-a378-8b61-20de-e4496f82af77"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1569563527,ExpressionUUID->"1bb2426e-9b7d-f33d-0d1e-e1334c6cc0e3"],

Cell["Two qubits have no bound entanglement", "Subsection",
 CellID->731931159,ExpressionUUID->"3ba18646-41d7-9231-4065-a9437210ce38"],

Cell[TextData[{
 "A bound-entangled state is entangled, yet its partial transpose ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Rho]", "TI"], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["B", "TI"]]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bf5c9e1-d324-f12a-40f6-d182bc639701"],
 " is still positive, so no local protocol can distill a Bell pair from it. \
Can a two-qubit state be bound entangled?"
}], "Text",
 CellID->931072101,ExpressionUUID->"66519def-6a99-61e0-3ec1-c9a6c9836597"],

Cell[TextData[{
 "Write every two-qubit state as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     RowBox[{
      StyleBox["j", "TI"], "=", "0"}]}], "3",
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["i", "TI"]], "\[CircleTimes]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2390856e-0499-9877-565b-311f50fb8dee"],
 " with 16 real symbols ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "360998e9-9819-65e5-417a-0ebfeb0597f2"],
 ". Wootters' concurrence ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "1"], "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "2"], "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "3"], "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "4"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "299f8608-433c-53d3-5186-b8ba6d93886d"],
 " vanishes exactly on separable states, where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "1"], "\[GreaterEqual]", "\[Ellipsis]", "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55b73d70-4b82-81e6-3130-c3e0bd18be3b"],
 " are the square roots of the eigenvalues of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]], "\[CircleTimes]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "*"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]], "\[CircleTimes]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "481d027b-2564-7351-245b-e387d029792c"],
 ". Since ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubsuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"], "2"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "181d63a1-d141-3fa4-5d1d-0a70b9a45111"],
 ", ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubsuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"], "4"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["R", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10a9638d-0246-f962-3d6b-72a9633aa053"],
 " and ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Product]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"]], "=", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "797a7ab1-b775-97dc-539a-d2c98eef4afb"],
 ", the claim is"
}], "Text",
 CellID->304232147,ExpressionUUID->"3885ac8a-0798-2381-0fd9-8f722d008e65"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{"16", 
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["B", "TI"]]], "=", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["Tr",
        FontSlant->"Plain"], 
       StyleBox["R", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"], "-", "2", 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    SuperscriptBox[
     StyleBox["R", "TI"], "2"], "+", "8", 
    StyleBox["det",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], "=", 
    UnderoverscriptBox["\[Product]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "4",
     LimitsPositioning->False], "(", 
    RowBox[{"2", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], 
      StyleBox["k", "TI"]], "-", 
     UnderscriptBox["\[Sum]", 
      StyleBox["j", "TI"],
      LimitsPositioning->False], 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], 
      StyleBox["j", "TI"]]}], ")"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->777010665,ExpressionUUID->"5796c395-0b19-a2f0-57bd-f53ffa46c89a"],

Cell[TextData[{
 "and a nonnegative product forces ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "1"], "\[LessEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "+", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "3"], "+", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "437a71db-d954-861f-29fe-ee63b0ec8652"],
 ", that is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bc2e5fd-f0e4-3d4d-4194-5f6e9bec3a01"],
 "."
}], "Text",
 CellID->2011931457,ExpressionUUID->"4d92e220-0dc3-4c80-5081-33ecc3070dc1"],

Cell[TextData[{
 "The first equality is tested for general ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "761e4eda-385d-5203-43e0-7658367337ce"],
 ", all 16 of them, and the second for general ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "627347a2-0e2f-db00-5052-7fa975cfc014"],
 "; the second statement is decided over every ordered quadruple ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "1"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "3"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "4"], "\[GreaterEqual]", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31ac6d5c-8338-3175-7158-fdd7fef6eac2"],
 ", and the figure draws, in units of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79c57e45-de7d-245e-599c-732713ce059c"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "747f5221-6102-4e18-30e8-afd3bc50c79f"],
 " and where the product is nonnegative:"
}], "Text",
 CellID->294721005,ExpressionUUID->"1b4c9bc9-2188-0a1a-36b8-198adf327fcc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paulis2q", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
        "KroneckerProduct", ",", " ", "#", ",", " ", "#", ",", " ", "1"}], 
        "]"}], " ", "&"}], "[", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2", ",", " ", "3"}], "}"}], 
       "]"}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yyPPT", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "2", "]"}], ",", " ", 
     RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]2q", " ", "=", " ", 
   RowBox[{
    RowBox[{"Array", "[", 
     RowBox[{"c", ",", " ", "16"}], "]"}], " ", ".", " ", "paulis2q"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"r2q", " ", "=", " ", 
   RowBox[{"\[Rho]2q", " ", ".", " ", "yyPPT", " ", ".", " ", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Conjugate", "[", "\[Rho]2q", "]"}], "]"}], " ", ".", " ", 
    "yyPPT"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"detTB", " ", "=", " ", 
   RowBox[{"Det", "[", 
    RowBox[{"Normal", " ", "@", " ", 
     RowBox[{
      RowBox[{"QuantumPartialTranspose", "[", 
       RowBox[{
        RowBox[{"QuantumState", "[", 
         RowBox[{"\[Rho]2q", ",", " ", "2"}], "]"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]sPPT", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"l", ",", " ", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"identityQ", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"16", " ", "detTB"}], " ", "-", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Tr", "[", "r2q", "]"}], "^", "2"}], " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Tr", "[", 
           RowBox[{"r2q", " ", ".", " ", "r2q"}], "]"}]}], " ", "+", " ", 
         RowBox[{"8", " ", 
          RowBox[{"Det", "[", "\[Rho]2q", "]"}]}]}], ")"}]}], "]"}], " ", "===",
      " ", "0"}], " ", "&&", "\n", "   ", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"Times", " ", "@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "\[Lambda]sPPT"}], " ", "-", " ", 
          RowBox[{"Total", "[", "\[Lambda]sPPT", "]"}]}], ")"}]}], " ", "-", 
       " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"\[Lambda]sPPT", "^", "2"}], "]"}], "^", "2"}], " ", "-", 
         " ", 
         RowBox[{"2", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"\[Lambda]sPPT", "^", "4"}], "]"}]}], " ", "+", " ", 
         RowBox[{"8", " ", 
          RowBox[{"Times", " ", "@@", " ", "\[Lambda]sPPT"}]}]}], ")"}]}], 
      "]"}], " ", "===", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"noBoundQ", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Lambda]", " ", "=", " ", "\[Lambda]sPPT"}], "}"}], ",", " ", 
     
     RowBox[{"Resolve", "[", 
      RowBox[{
       RowBox[{"ForAll", "[", 
        RowBox[{"\[Lambda]", ",", " ", 
         RowBox[{
          RowBox[{"GreaterEqual", " ", "@@", " ", 
           RowBox[{"Append", "[", 
            RowBox[{"\[Lambda]", ",", " ", "0"}], "]"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Times", " ", "@@", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "\[Lambda]"}], " ", "-", " ", 
              RowBox[{"Total", "[", "\[Lambda]", "]"}]}], ")"}]}], " ", ">=", 
           " ", "0"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "\[Lambda]", "]"}], " ", "-", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"Rest", "[", "\[Lambda]", "]"}], "]"}]}], " ", "<=", " ", 
          "0"}]}], "]"}], ",", " ", "Reals"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelPPT", "[", "l4_", "]"}], " ", ":=", " ", 
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"v", " ", "<=", " ", "u"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{
         "1", " ", "-", " ", "u", " ", "-", " ", "v", " ", "-", " ", "l4"}], 
         " ", ">", " ", "0"}]}], ",", " ", 
       RowBox[{
        RowBox[{"v", " ", "<=", " ", "u"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Times", " ", "@@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "u", ",", " ", "v", ",", " ", "l4"}], 
              "}"}]}], " ", "-", " ", 
            RowBox[{"(", 
             RowBox[{
             "1", " ", "+", " ", "u", " ", "+", " ", "v", " ", "+", " ", 
              "l4"}], ")"}]}], ")"}]}], " ", ">=", " ", "0"}]}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "l4", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "l4", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<C > 0\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<16 det \>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<\[Rho]\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<T\>\"", ",", " ", "\"\<B\>\""}], "]"}]}], "]"}], ",",
            " ", "\"\< \[GreaterEqual] 0\>\""}], "}"}], "]"}]}], "}"}]}], ",",
      "\n", "   ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\</\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "1"}], "]"}]}], "}"}], 
         "]"}], ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "3"}], "]"}], ",", 
           " ", "\"\</\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "1"}], "]"}]}], "}"}], 
         "]"}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "4"}], "]"}], ",", 
         " ", "\"\</\>\"", ",", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "1"}], "]"}], ",", 
         " ", "\"\< = \>\"", ",", " ", "l4"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsPPT", " ", "=", " ", 
   RowBox[{"panelPPT", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"1", "/", "10"}], ",", " ", 
      RowBox[{"1", "/", "5"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"First", " ", "/@", " ", "panelsPPT"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "780"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "panelsPPT", "]"}], "]"}], "]"}]}], "]"}], ",", 
   " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<both identities: \>\"", ",", " ", "identityQ", ",", 
        " ", "\"\<,   Resolve: \>\"", ",", " ", "noBoundQ"}], "}"}], "]"}], ",",
      " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[133]:= ",
 CellID->903224774,ExpressionUUID->"5852a8cc-b1e4-b60b-2561-61a78f965137"],

Cell[TextData[{
 "The two regions never overlap and together fill the ordered triangle ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "3"], "\[LessEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f1f47b3-3ad7-0ad2-577b-dfbe806476b4"],
 " of every panel: wherever the determinant of the partial transpose is \
nonnegative, the concurrence is zero, and this is proved for every quadruple, \
not just the slices drawn. A positive partial transpose has a nonnegative \
determinant, so it forces ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106ebca1-854b-1adc-658e-19f72f870e24"],
 ", which is separability. A two-qubit state is either separable or has a \
negative partial transpose, and every two-qubit state with a negative partial \
transpose can be distilled (Horodecki 1997), so nothing is left to be bound."
}], "Text",
 CellID->1198738186,ExpressionUUID->"116740f4-d870-983f-1196-621f56e65508"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1020053952,ExpressionUUID->"38462570-731c-ef54-374e-6e190360996c"],

Cell["\<\
Robertson-Schr\[ODoubleDot]dinger slack for every qubit state and observable \
pair\
\>", "Subsection",
 CellID->463713168,ExpressionUUID->"1cc4184b-5da1-834f-7177-881f2da23297"],

Cell[TextData[{
 "Two observables ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["A", "TI"], "^"], "=", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "\[CenterDot]", 
   OverscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0be37866-b77e-1c44-7b90-2bc3b1d1b062"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["B", "TI"], "^"], "=", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "\[CenterDot]", 
   OverscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e0eac3-1c40-b249-73ef-47d23ca74885"],
 " act on a qubit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "298ff6bd-88e8-ef40-4647-6756827c03f0"],
 " with ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ca12aca-96ff-c22d-0ff8-9175a745f93e"],
 "; a multiple of the identity added to either drops out of every term below, \
so these are all qubit observables. How far above the bound does each state \
sit?"
}], "Text",
 CellID->1035906638,ExpressionUUID->"1fe8c440-0075-b3fb-2027-877f0af5adf2"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["O", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   OverscriptBox[
    StyleBox["O", "TI"], "^"], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09ea40f4-16a5-9401-06d6-b8a764e7688b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["O", "TI"], "2"], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["O", "TI"], "^"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["O", "TI"], "^"], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b440f30-a6b8-7cec-70c9-1b764dcd9d84"],
 ", the Robertson-Schr\[ODoubleDot]dinger relation is"
}], "Text",
 CellID->218599814,ExpressionUUID->"25926ee1-70d1-034d-19a9-02d7adb3a10d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["A", "TI"], "2"], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["B", "TI"], "2"], "\[ThickSpace]", "\[GreaterEqual]", 
    "\[ThickSpace]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        RowBox[{"{", 
         OverscriptBox[
          StyleBox["A", "TI"], "^"]}], ",", 
        RowBox[{
         OverscriptBox[
          StyleBox["B", "TI"], "^"], "}"}]}], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1], "-", 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["A", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       OverscriptBox[
        StyleBox["B", "TI"], "^"], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], ")"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", 
         StyleBox["i", "TI"]}]], 
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["[",
         SpanMaxSize->1], 
        RowBox[{
         OverscriptBox[
          StyleBox["A", "TI"], "^"], ",", 
         OverscriptBox[
          StyleBox["B", "TI"], "^"]}], 
        StyleBox["]",
         SpanMaxSize->1]}], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], ")"}], "2"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->2137626485,ExpressionUUID->"2b05e10e-0c98-ac86-7fa7-c8c14c974d7a"],

Cell[TextData[{
 "Both sides, for all nine parameters general, give a slack (left minus \
right) that factors; the figure puts unit ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3666ab2c-104f-7452-3c25-1dbaa75327ee"],
 " on ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03719435-832b-97ac-726f-757949f127d8"],
 ", unit ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22bb7f04-f078-1b99-414d-958fbeff5830"],
 " at angle ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ce6e1d5-0948-0dab-5c17-bfe86b5aa0b6"],
 ", and ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46d9e187-4a83-6352-3863-9bb2728dfc08"],
 " at angle ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02de1266-3109-4fc2-7d2a-5383abecf63b"],
 " in that plane (left side solid, right side dashed with dots):"
}], "Text",
 CellID->1344453453,ExpressionUUID->"67ff05b7-306c-e4fc-78fe-5b40b2e77b6b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rvRS", ",", " ", "avRS", ",", " ", "bvRS"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r1", ",", " ", "r2", ",", " ", "r3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a1", ",", " ", "a2", ",", " ", "a3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b1", ",", " ", "b2", ",", " ", "b3"}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lhsRS", ",", " ", "rhsRS"}], "}"}], " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Sigma]v", " ", "=", " ", 
       RowBox[{"PauliMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",",
      " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Rho]q", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
             RowBox[{"rvRS", " ", ".", " ", "\[Sigma]v"}]}], ")"}], "/", 
           "2"}]}], ",", " ", 
         RowBox[{"opA", " ", "=", " ", 
          RowBox[{"avRS", " ", ".", " ", "\[Sigma]v"}]}], ",", " ", 
         RowBox[{"opB", " ", "=", " ", 
          RowBox[{"bvRS", " ", ".", " ", "\[Sigma]v"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ev", " ", "=", " ", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{"#", " ", ".", " ", "\[Rho]q"}], "]"}], " ", "&"}]}], 
          "}"}], ",", " ", 
         RowBox[{"Expand", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ev", "[", 
                RowBox[{"opA", " ", ".", " ", "opA"}], "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"ev", "[", "opA", "]"}], "^", "2"}]}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ev", "[", 
                RowBox[{"opB", " ", ".", " ", "opB"}], "]"}], " ", "-", " ", 
               RowBox[{
                RowBox[{"ev", "[", "opB", "]"}], "^", "2"}]}], ")"}]}], ",", 
            "\n", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"ev", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"opA", " ", ".", " ", "opB"}], " ", "+", " ", 
                    RowBox[{"opB", " ", ".", " ", "opA"}]}], ")"}], "/", 
                  "2"}], "]"}], " ", "-", " ", 
                RowBox[{
                 RowBox[{"ev", "[", "opA", "]"}], " ", 
                 RowBox[{"ev", "[", "opB", "]"}]}]}], ")"}], "^", "2"}], " ", 
             "+", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"ev", "[", 
                 RowBox[{
                  RowBox[{"opA", " ", ".", " ", "opB"}], " ", "-", " ", 
                  RowBox[{"opB", " ", ".", " ", "opA"}]}], "]"}], "/", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "I"}], ")"}]}], ")"}], "^", "2"}]}]}], 
           "}"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"factorsQ", " ", "=", " ", 
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{"lhsRS", " ", "-", " ", "rhsRS", " ", "-", " ", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Cross", "[", 
          RowBox[{"avRS", ",", " ", "bvRS"}], "]"}], "^", "2"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"rvRS", " ", ".", " ", "rvRS"}]}], ")"}]}]}], "]"}], " ", "===",
     " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rLengthsRS", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", 
     RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelRS", "[", "\[Gamma]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sides", " ", "=", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lhsRS", ",", " ", "rhsRS"}], "}"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a1", " ", "->", " ", "0"}], ",", " ", 
          RowBox[{"a2", " ", "->", " ", "0"}], ",", " ", 
          RowBox[{"a3", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"b1", " ", "->", " ", 
           RowBox[{"Sin", "[", "\[Gamma]", "]"}]}], ",", " ", 
          RowBox[{"b2", " ", "->", " ", "0"}], ",", " ", 
          RowBox[{"b3", " ", "->", " ", 
           RowBox[{"Cos", "[", "\[Gamma]", "]"}]}]}], "}"}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"curves", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"sides", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"r1", " ", "->", " ", 
               RowBox[{"\[Rho]r", " ", 
                RowBox[{"Sin", "[", "\[Beta]", "]"}]}]}], ",", " ", 
              RowBox[{"r2", " ", "->", " ", "0"}], ",", " ", 
              RowBox[{"r3", " ", "->", " ", 
               RowBox[{"\[Rho]r", " ", 
                RowBox[{"Cos", "[", "\[Beta]", "]"}]}]}]}], "}"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[Rho]r", ",", " ", "rLengthsRS"}], "}"}]}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"curves", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", " ", "0", ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "}"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 RowBox[{"\"\<|r| = \>\"", ",", " ", "#"}], "}"}], "]"}], " ",
                "&"}], " ", "/@", " ", "rLengthsRS"}], ")"}]}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"curves", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", " ", "0", ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "}"}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}], ",", " ", 
           RowBox[{"Mesh", " ", "->", " ", "16"}], ",", " ", 
           RowBox[{"MeshStyle", " ", "->", " ", 
            RowBox[{"PointSize", "[", "0.018", "]"}]}]}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<\[Beta]\>\"", ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Superscript", "[", 
                RowBox[{
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<A\>\""}], "]"}], 
                 ",", " ", "2"}], "]"}], ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<B\>\""}], "]"}], 
                 ",", " ", "2"}], "]"}], ",", 
               " ", "\"\< (solid),  right side (dashed)\>\""}], "}"}], 
             "]"}]}], "}"}]}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Gamma] = \>\"", ",", " ", "\[Gamma]"}], "}"}], 
           "]"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsRS", " ", "=", " ", 
   RowBox[{"panelRS", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Pi", "/", "6"}], ",", " ", 
      RowBox[{"Pi", "/", "3"}], ",", " ", 
      RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"First", " ", "/@", " ", "panelsRS"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", "panelsRS", "]"}], "]"}], "]"}]}], "]"}], ",", 
   " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<slack = |a\[Times]b|\.b2(1 \[Minus] |r|\.b2): \>\"", ",", 
        " ", "factorsQ"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[134]:= ",
 CellID->286903539,ExpressionUUID->"5c6f20fd-65b3-bd59-021d-bccca6e21b0e"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "422e560f-1811-4990-4986-0cf4875562c0"],
 " both sides swing as the state turns, but the gap between them does not \
move: it depends on the state only through its mixedness ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[GridBox[{
      {
       OverscriptBox[
        StyleBox["r", "TI"], "\[RightVector]"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76643a45-13c8-bdf8-3d0a-61d5246f5f9e"],
 " and on the observables only through how far they are from commuting. That \
slack is never negative, so no state and no pair of observables violates the \
relation, and it closes for every pure state."
}], "Text",
 CellID->1244142220,ExpressionUUID->"5b51c394-20ff-37bc-54df-073668cdf6de"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->269589057,ExpressionUUID->"2f1445e1-b0c1-7e0e-660b-660093afa135"],

Cell["The Helstrom bound, minimized over every measurement", "Subsection",
 CellID->1083779504,ExpressionUUID->"47ac7311-40d0-fde8-7b53-c4a2468330ff"],

Cell[TextData[{
 "One of two qubit states arrives, ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2080750d-1a91-446e-5a2f-e1682b55c905"],
 " with prior ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05628638-e3df-ac16-161a-b2f44aa82905"],
 " or ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bcddf90-a145-4e58-4cfd-53dad91f1f93"],
 " with prior ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "139e2655-d56a-1839-39e9-59584a533d48"],
 "; their Bloch vectors have equal length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bb47bf4-e342-469b-2576-e9b6c0e05819"],
 " and meet at angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ce6051c-3913-253f-10d6-af74cd6d265e"],
 ". One two-outcome measurement ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], "1"]}], ",", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], "2"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "365d373a-356f-f92b-7f1d-7e7d96ab2fdc"],
 " must name it, with ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["E", "TI"], "^"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5abf6a33-6b5b-d96e-4e9a-5009faacbf0f"],
 " meaning \"it was ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd97ff5-a78a-5a5a-3d5b-cdefb3a13267"],
 "\". What is the smallest possible error?"
}], "Text",
 CellID->1871531504,ExpressionUUID->"544843b0-3f66-cf43-3fe1-11ca8f4c6d24"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"e", "r", "r"}], "TI"]], "=", 
    StyleBox["p", "TI"], 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "1"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], "2"], "+", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "2"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], "1"], "=", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["p", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    StyleBox["Tr",
     FontSlant->"Plain"], "\[CapitalLambda]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{"\[CapitalLambda]", "=", 
    RowBox[{
     RowBox[{
      StyleBox["p", "TI"], 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], "1"]}], "-", 
     RowBox[{
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        StyleBox["p", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], "2"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], "1"], "=", 
    RowBox[{
     StyleBox["I", "TI"], "-", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["E", "TI"], "^"], "2"]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{"0", "\[LessEqual]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["E", "TI"], "^"], "2"], "\[LessEqual]", 
    RowBox[{
     StyleBox["I", "TI"], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1344655285,ExpressionUUID->"07223a73-d798-06ab-2092-f74b6a2ddae8"],

Cell[TextData[{
 "A unitary maps the set of effects to itself, so in the eigenbasis of ",
 Cell[BoxData[
  RowBox[{"\[CapitalLambda]", "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["l", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["l", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52e384a5-620a-a669-4233-22e4ff7bd1eb"],
 " the most general effect is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], "2"], "=", "(", GridBox[{
     {
      StyleBox["a", "TI"], 
      RowBox[{
       StyleBox["b", "TI"], "+", 
       StyleBox["i", "TI"], 
       StyleBox["c", "TI"]}]},
     {
      RowBox[{
       StyleBox["b", "TI"], "-", 
       StyleBox["i", "TI"], 
       StyleBox["c", "TI"]}], 
      StyleBox["e", "TI"]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "272d3495-4d2c-50e1-54e9-a18f09d1ef0f"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], "2"], "\[GreaterEqual]", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e89af34-f374-28fb-2b30-091a9b20f2c9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "-", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], "2"], "\[GreaterEqual]", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2454af9d-b003-27d4-620a-674b783ad626"],
 "."
}], "Text",
 CellID->1406909636,ExpressionUUID->"7538b627-fe39-27f5-491b-fc935ed78c58"],

Cell[TextData[{
 "Every ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52864361-a3b2-32ee-666b-11e050826530"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], "\[CapitalLambda]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], "2"], "\[GreaterEqual]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6949c8b5-6c41-8e9d-6ec8-3770f7a43358"],
 " for all such effects is found exactly, giving the lowest error ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e7b6c55-ccb0-3fc9-7169-5a346167c292"],
 " (dashed, thinner for larger ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779eb577-fcb5-91bb-2150-eab43e9d50f2"],
 "), against the projective ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], "2"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["m", "TI"], "^"], "\[CenterDot]", 
    OverscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "\[RightVector]"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73c94eb6-8c2c-ccd9-7334-4688e7b713cf"],
 " with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["m", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "316d2dfd-092d-4906-606e-0d55351d7d9f"],
 " at angle ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1291bc60-e94f-1b77-0712-a4511b4adc22"],
 " from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45144cc3-497e-e3ab-7c7f-4a8c57fa6028"],
 "'s Bloch vector in their plane (solid):"
}], "Text",
 CellID->967951109,ExpressionUUID->"3832f652-ece6-849b-4fcb-fea37a9988b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"helstromK", " ", "=", " ", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{"ForAll", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ea", ",", " ", "eb", ",", " ", "ec", ",", " ", "ee"}], "}"}],
        ",", " ", 
       RowBox[{
        RowBox[{"0", " ", "<=", " ", "ea", " ", "<=", " ", "1"}], " ", "&&", 
        " ", 
        RowBox[{"0", " ", "<=", " ", "ee", " ", "<=", " ", "1"}], " ", "&&", 
        " ", 
        RowBox[{
         RowBox[{"ea", " ", "ee"}], " ", ">=", " ", 
         RowBox[{
          RowBox[{"eb", "^", "2"}], " ", "+", " ", 
          RowBox[{"ec", "^", "2"}]}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "ea"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "ee"}], ")"}]}], " ", ">=", " ", 
         RowBox[{
          RowBox[{"eb", "^", "2"}], " ", "+", " ", 
          RowBox[{"ec", "^", "2"}]}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"l1", ",", " ", "l2"}], "}"}], "]"}], " ", ".", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ea", ",", " ", 
              RowBox[{"eb", " ", "+", " ", 
               RowBox[{"I", " ", "ec"}]}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"eb", " ", "-", " ", 
               RowBox[{"I", " ", "ec"}]}], ",", " ", "ee"}], "}"}]}], "}"}]}],
          "]"}], " ", ">=", " ", "k"}]}], "]"}], ",", " ", "k", ",", " ", 
     "Reals"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"blochRho", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{"v", " ", ".", " ", 
       RowBox[{"PauliMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], ")"}],
     "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Theta]sHel", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pi", "/", "4"}], ",", " ", 
     RowBox[{"Pi", "/", "2"}], ",", " ", "Pi"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelHel", "[", 
    RowBox[{"r_", ",", " ", "pr_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]1", " ", "=", " ", 
        RowBox[{"blochRho", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "r"}], "}"}], "]"}]}], ",", 
       " ", 
       RowBox[{"\[Rho]2s", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"blochRho", "[", 
           RowBox[{"r", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", "#", "]"}], ",", " ", "0", ",", " ", 
              RowBox[{"Cos", "[", "#", "]"}]}], "}"}]}], "]"}], " ", "&"}], 
         " ", "/@", " ", "\[Theta]sHel"}]}], ",", " ", 
       RowBox[{"e2", " ", "=", " ", 
        RowBox[{"blochRho", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], ",", " ", "0", ",", " ", 
           
           RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}], "}"}], "]"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"pr", " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"\[Rho]1", " ", ".", " ", "e2"}], "]"}]}], " ", "+", 
             " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", "pr"}], ")"}], " ", 
              RowBox[{"Tr", "[", 
               RowBox[{"#", " ", ".", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "-", " ", 
                  "e2"}], ")"}]}], "]"}]}]}], " ", "&"}], " ", "/@", " ", 
           "\[Rho]2s"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Theta] = \>\"", ",", " ", "#"}], "}"}], "]"}], 
             " ", "&"}], " ", "/@", " ", "\[Theta]sHel"}], ")"}]}]}], "]"}], ",",
        "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "pr"}], ")"}], " ", "+", " ", 
             RowBox[{"MaxValue", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"helstromK", " ", "/.", " ", 
                  RowBox[{"Thread", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"l1", ",", " ", "l2"}], "}"}], " ", "->", " ", 
                    RowBox[{"Eigenvalues", "[", 
                    RowBox[{
                    RowBox[{"pr", " ", "\[Rho]1"}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "pr"}], ")"}], " ", "#"}]}], 
                    "]"}]}], "]"}]}]}], "}"}], ",", " ", "k"}], "]"}]}], " ", 
            "&"}], " ", "/@", " ", "\[Rho]2s"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Dashed", ",", " ", 
               RowBox[{"AbsoluteThickness", "[", "#", "]"}]}], "]"}], " ", 
             "&"}], " ", "/@", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "2.5", ",", " ", "1"}], "}"}]}], 
           ")"}]}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[CurlyPhi]\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<P\>\"", ",", " ", "\"\<err\>\""}], "]"}]}], "}"}]}], ",",
        " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<r = \>\"", ",", " ", "r", ",", " ", "\"\<,   p = \>\"",
            ",", " ", "pr"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"panelsHel", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"panelHel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{"3", "/", "4"}], ",", " ", 
       RowBox[{"9", "/", "10"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"Map", "[", 
       RowBox[{"First", ",", " ", "panelsHel", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"panelsHel", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], "]"}], ",",
    " ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Reduce: \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"helstromK", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"l1", " ", "->", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<l\>\"", ",", " ", "1"}], "]"}]}], ",", " ", 
            RowBox[{"l2", " ", "->", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<l\>\"", ",", " ", "2"}], "]"}]}]}], "}"}]}], 
         "]"}]}], "}"}], "]"}], ",", " ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[135]:= ",
 CellID->1327741869,ExpressionUUID->"084f2a31-7513-d0a4-1df2-84e52cfdd404"],

Cell[TextData[{
 "The largest ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54457b15-381f-fdf3-5e98-2ebf0f167a74"],
 " is the sum of the negative eigenvalues of ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0dfecd-aa29-7e67-5644-cce933127704"],
 ", so with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], "\[CapitalLambda]", "=", "2", 
   StyleBox["p", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "258be861-bf7b-fa49-3f5a-4cd1acb9e1f0"],
 " the lowest error is the Helstrom bound ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SubscriptBox[GridBox[{
       {GridBox[{
          {"\[CapitalLambda]"}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.22}}}], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f7090de-21e5-e12d-0d11-097759551a14"],
 ". When ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "796c7639-b842-2e89-7c56-38504876faf9"],
 " has one negative and one nonnegative eigenvalue, the best rank-one \
projector touches the bound; when both are negative, which needs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "<", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1288ac73-7016-8632-65c0-ecaa6e1e2fc9"],
 ", the optimum is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], "2"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09898231-79c7-d3bd-1e3e-6f4a1b6516c0"],
 " (always guess ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "477b72d4-17d1-4e12-0c74-be1352a268c0"],
 "). For mixed states with a strong prior ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7eb333ff-50c9-f920-0d70-c3780e1ede64"],
 " has no negative eigenvalue, the optimum is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["E", "TI"], "^"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2af6a924-1183-993f-3b75-abab935b7e23"],
 " (always guess ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49cef699-e335-87be-6cbe-5ed428e0df7e"],
 "), and a rank-one projector reaches it only when ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "520a0e61-3ca2-6a3b-0acf-48c6679ded3a"],
 " has a zero eigenvalue."
}], "Text",
 CellID->1827525375,ExpressionUUID->"018d4a21-bc64-d3bd-0667-d01568be1e9d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->586120843,ExpressionUUID->"0431fd74-32cf-7200-5cc2-5678163c69fe"],

Cell["The Werner-state entanglement threshold in every dimension", \
"Subsection",
 CellID->905541676,ExpressionUUID->"7cf35216-acdd-c1c0-4b7e-d966e12bc78c"],

Cell[TextData[{
 "Two qudits of dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "307f97c7-0505-b1f8-796f-d2b77621dbe4"],
 " share a Werner state: weight ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd3baa5-c138-99af-1781-aa6146d6dc59"],
 " on the symmetric subspace and ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d0e3147-8452-32ba-2e34-0fb0c4745002"],
 " on the antisymmetric one, each spread evenly. At which ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5088e670-c800-db3c-2085-2d9dd8ea34ae"],
 " does its partial transpose turn negative in each dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ca6e119-0ff9-5254-0eac-e192435444f4"],
 "?"
}], "Text",
 CellID->789239029,ExpressionUUID->"742bc3e9-7412-71d5-3e9c-09148b200104"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["F", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6643203a-f244-62c4-0f56-6a0e4e99052b"],
 " the swap of the two qudits,"
}], "Text",
 CellID->1063950235,ExpressionUUID->"5cdbc469-0410-f453-7eb4-d8e105b49ce9"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     StyleBox["W", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["p", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     StyleBox["p", "TI"], 
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["s", "TI"]]], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["s", "TI"]], "+", 
    FractionBox[
     RowBox[{"1", "-", 
      StyleBox["p", "TI"]}], 
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["a", "TI"]]], "\[ThinSpace]", 
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     StyleBox["a", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalPi]", "^"], 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["a", "TI"]}]], "=", 
    FractionBox[
     RowBox[{
      StyleBox["I", "TI"], "\[PlusMinus]", 
      OverscriptBox[
       StyleBox["F", "TI"], "^"]}], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["s", "TI"], ",", 
      StyleBox["a", "TI"]}]], "=", 
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["d", "TI"], "\[PlusMinus]", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->375965792,ExpressionUUID->"119e98f0-e01e-2ffa-3769-76f8f78d3444"],

Cell[TextData[{
 "so for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "797c46bb-6171-1acf-381f-9598a503fa42"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox["\[CapitalPi]", "^"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45972556-ae87-1d0f-2334-5d2e9f3b9d6f"],
 " is the singlet projector. A negative eigenvalue of the partial transpose \
",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["W", "TI"], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["B", "TI"]]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d7f9685-36fb-cf89-01d8-20b392b03304"],
 " proves the state entangled. Writing ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["W", "TI"]], "=", 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["I", "TI"], "+", 
   StyleBox["\[Beta]", "TI"], 
   OverscriptBox[
    StyleBox["F", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6034177e-88c7-6c05-4483-ff5c082f3025"],
 " and using ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["F", "TI"], "^"], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["B", "TI"]]], "=", 
   RowBox[{
    StyleBox["d", "TI"], 
    TemplateBox[{
      SuperscriptBox["\[CapitalPhi]", "+"]},
     "Ket"], 
    TemplateBox[{
      SuperscriptBox["\[CapitalPhi]", "+"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0c3404-209b-fffb-4ea9-876a5b78d576"],
 ", the eigenvalues of ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox["W", "TI"], 
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["B", "TI"]]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4771499c-b735-8b87-5731-c2346f850adf"],
 " are ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "275600b6-9ff2-278f-3113-aa1610ea0a2a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1372a3eb-3c1a-1ca7-60d6-78919c89d2b5"],
 " in every dimension."
}], "Text",
 CellID->650907031,ExpressionUUID->"7de522cd-72b3-1fce-38a5-c783c9c6b757"],

Cell[TextData[{
 "The region where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["\[Beta]", "TI"], "<", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40a62b90-c8e7-485c-5fc9-941d8a17f777"],
 " is found for general ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[GreaterEqual]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bc22005-5b89-f0f3-68c3-333f3b3e76ae"],
 " and checked against the partial-transpose eigenvalues at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], "=", "2"}], ",", 
   RowBox[{"3", ",", "4"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d960360-8550-e6cd-0235-35d8a01342ff"],
 "; the eigenvalue that can turn negative is drawn, with the entangled range \
shaded:"
}], "Text",
 CellID->175266811,ExpressionUUID->"1039a633-eb1b-d27f-2945-52dc509b7c88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ptEigenW", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Union", " ", "@", " ", 
       RowBox[{"Simplify", " ", "@", " ", 
        RowBox[{
         RowBox[{"QuantumPartialTranspose", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", 
            RowBox[{"\"\<Werner\>\"", "[", 
             RowBox[{"p", ",", " ", "#"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<Eigenvalues\>\"", 
         "]"}]}]}], " ", "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"entangledW", ",", " ", "tiedW", ",", " ", "lowFormW"}], "}"}], 
   " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]", " ", "=", " ", 
        RowBox[{
         RowBox[{"p", "/", 
          RowBox[{"(", 
           RowBox[{"d", " ", 
            RowBox[{"(", 
             RowBox[{"d", " ", "+", " ", "1"}], ")"}]}], ")"}]}], " ", "+", 
         " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "p"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"d", " ", 
            RowBox[{"(", 
             RowBox[{"d", " ", "-", " ", "1"}], ")"}]}], ")"}]}]}]}], ",", 
       " ", 
       RowBox[{"\[Beta]", " ", "=", " ", 
        RowBox[{
         RowBox[{"p", "/", 
          RowBox[{"(", 
           RowBox[{"d", " ", 
            RowBox[{"(", 
             RowBox[{"d", " ", "+", " ", "1"}], ")"}]}], ")"}]}], " ", "-", 
         " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "p"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"d", " ", 
            RowBox[{"(", 
             RowBox[{"d", " ", "-", " ", "1"}], ")"}]}], ")"}]}]}]}]}], "}"}],
      ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Reduce", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Alpha]", " ", "+", " ", 
            RowBox[{"d", " ", "\[Beta]"}]}], " ", "<", " ", "0"}], " ", "&&", 
          " ", 
          RowBox[{"0", " ", "<=", " ", "p", " ", "<=", " ", "1"}], " ", "&&", 
          " ", 
          RowBox[{"d", " ", ">=", " ", "2"}]}], ",", " ", "p", ",", " ", 
         "Reals"}], "]"}], ",", "\n", "    ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Keys", "[", "ptEigenW", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\[Alpha]", ",", " ", 
                  RowBox[{"\[Alpha]", " ", "+", " ", 
                   RowBox[{"d", " ", "\[Beta]"}]}]}], "}"}], " ", "/.", " ", 
                RowBox[{"d", " ", "->", " ", "#"}]}], ",", " ", 
               RowBox[{
                RowBox[{"#", " ", "/.", " ", 
                 RowBox[{"p", " ", "->", " ", "0"}]}], " ", "&"}]}], "]"}], 
             " ", "-", " ", 
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{"ptEigenW", "[", "#", "]"}], ",", " ", 
               RowBox[{
                RowBox[{"#", " ", "/.", " ", 
                 RowBox[{"p", " ", "->", " ", "0"}]}], " ", "&"}]}], "]"}]}], 
            "]"}], " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}]}], " ", "&"}]}], "]"}], ",", 
       " ", 
       RowBox[{"Factor", "[", 
        RowBox[{"\[Alpha]", " ", "+", " ", 
         RowBox[{"d", " ", "\[Beta]"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ptLowW", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"SortBy", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{
         RowBox[{"#", " ", "/.", " ", 
          RowBox[{"p", " ", "->", " ", "0"}]}], " ", "&"}]}], "]"}], "]"}], 
     " ", "&"}], " ", "/@", " ", 
    RowBox[{"Values", "[", "ptEigenW", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "ptLowW", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<d = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], 
      " ", "/@", " ", 
      RowBox[{"Keys", "[", "ptEigenW", "]"}]}], ")"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.55"}], ",", " ", "0.55"}], "}"}]}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"Prolog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Opacity", "[", "0.12", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"ColorData", "[", "97", "]"}], "[", "4", "]"}], ",", " ", 
      RowBox[{"Rectangle", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], "]"}]}], "}"}]}],
    ",", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"Text", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<entangled\>\"", ",", " ", "14", ",", " ", 
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "4", "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"0.25", ",", " ", "0.35"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
   
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<p\>\"", ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<eigenvalue \[Alpha] + d\[Beta] of \>\"", ",", " ", 
         RowBox[{"Superscript", "[", 
          RowBox[{"\"\<\[Rho]\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<T\>\"", ",", " ", "\"\<B\>\""}], "]"}]}], "]"}]}], 
        "}"}], "]"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Alpha] + d\[Beta] = \>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", "lowFormW", "]"}]}], "}"}], "]"}], 
        ",", "\n", "     ", 
        RowBox[{"If", "[", 
         RowBox[{"tiedW", ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<negative for \>\"", ",", " ", 
             RowBox[{"TraditionalForm", "[", "entangledW", "]"}]}], "}"}], 
           "]"}], ",", 
          " ", "\"\<QF eigenvalues differ from \[Alpha] + d\[Beta]\>\""}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[136]:= ",
 CellID->879832631,ExpressionUUID->"6aa93c30-4837-1f26-333f-78db285606a2"],

Cell[TextData[{
 "In every dimension the same eigenvalue crosses zero at the same weight, so \
the threshold does not depend on ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f2d1973-69bf-3011-7607-aee6a8df8412"],
 ". Below it the state is entangled. For Werner states a positive partial \
transpose means separable in every ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "731a0e4d-fefa-fc75-66c4-91934472cf4d"],
 " (Werner 1989), so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "<", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "533d45d5-1fa8-f0de-7664-f8f2d154f695"],
 " is exactly the entangled range for all ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18b55b4e-f1b2-9a31-5cef-e6b9e508a3f3"],
 "."
}], "Text",
 CellID->1368387108,ExpressionUUID->"625b2d5d-272f-6f1c-6c25-8520799890a5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->455143525,ExpressionUUID->"74a0634e-8eb8-46ec-74df-fbfb2bc2c9f7"],

Cell["\<\
Entropic uncertainty for a qubit in two mutually unbiased bases\
\>", "Subsection",
 CellID->1870331665,ExpressionUUID->"56352fcd-b64f-fcfb-04fa-854d75b6d491"],

Cell[TextData[{
 "A qubit with Bloch vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40036f1f-9c9e-d6eb-5e28-4c5cd8a1b89c"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["y", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eaf278-da5d-39ad-05a3-e6f0df06fe21"],
 ", is measured in the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47f61e41-fa86-70a3-2cc6-67b2c3b48b95"],
 " basis or in the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6db609cb-9ec3-bed4-056a-7a450d585869"],
 " basis. The two bases are mutually unbiased: every overlap ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{"\[PlusMinus]", "0"},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75fec209-3b00-d8ec-4eee-4ad14a0ad66d"],
 ", ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{"\[PlusMinus]", "1"},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ff0d507-f083-d15b-7c53-863e137d7f56"],
 " is ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6062804e-82d6-cff1-6345-0b79680ea004"],
 ". Can any state be sharp in both?"
}], "Text",
 CellID->495433622,ExpressionUUID->"45a47836-a686-a64d-7945-bb11e30ec9b5"],

Cell[TextData[{
 "The Maassen-Uffink relation bounds the Shannon entropies of the two outcome \
distributions for every state by the largest overlap ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["c", "TI"], "2"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fb83ab-16fb-77c7-1bee-6f4e467296c9"],
 ":"
}], "Text",
 CellID->1371603486,ExpressionUUID->"16154642-4a8d-d442-7c91-0a2909cbdab5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["H", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    StyleBox["H", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["Z", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThickSpace]", "\[GreaterEqual]", "\[ThickSpace]", "-", 
    SubscriptBox[
     StyleBox["log",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["c", "TI"], "2"], "=", "1", " ", 
    StyleBox["bit",
     FontSlant->"Plain"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["H", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["X", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     StyleBox["h", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["x", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["H", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["Z", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     StyleBox["h", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["z", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["h", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["u", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"1", "+", 
         StyleBox["u", "TI"]}], "2"]}], 
      SubscriptBox[
       StyleBox["log",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      FractionBox[
       RowBox[{"1", "+", 
        StyleBox["u", "TI"]}], "2"]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        StyleBox["u", "TI"]}], "2"], 
      SubscriptBox[
       StyleBox["log",
        FontSlant->"Plain"], "2"], "\[ThinSpace]", 
      RowBox[{
       FractionBox[
        RowBox[{"1", "-", 
         StyleBox["u", "TI"]}], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1883338960,ExpressionUUID->"214a2d2d-6702-5879-5afe-2f6be5e61755"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["u", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[GreaterEqual]", "1", "-", 
   SuperscriptBox[
    StyleBox["u", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18e13c97-0358-e74c-4bc6-86ed88cae715"],
 " on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e222521-596a-2ea5-3522-ac15f57c11db"],
 " (both sides are ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "415423bf-7a15-5dd8-2f42-7a78933be2db"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5838d65c-6d8d-ac3c-5fe0-0c5539e3f949"],
 "), ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[GreaterEqual]", "2", "-", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "-", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"], "\[GreaterEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78ae5b49-5279-b2a1-537c-aef70dd8c85f"],
 "."
}], "Text",
 CellID->29044953,ExpressionUUID->"34abcfb2-3830-e545-3fe1-851851433bfd"],

Cell[TextData[{
 "Both ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["u", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "<", "1", "-", 
   SuperscriptBox[
    StyleBox["u", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dbd7361-d27c-4a81-54c1-1d75d101052e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["u", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "-", 
   SuperscriptBox[
    StyleBox["u", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08bc6b39-2754-82f6-2498-e3beebb2b28f"],
 " are decided exactly on ",
 Cell[BoxData[
  RowBox[{"-", "1", "<", 
   StyleBox["u", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77999eda-737f-a6bf-5878-f88efd9e9b0c"],
 ", and the figure draws ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19ee7fff-f457-1308-0570-ed771ce01239"],
 " over every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b4d78cb-328b-ed5c-363f-9feadb9a287d"],
 " a state can have, with the four states on the bound marked:"
}], "Text",
 CellID->297022648,ExpressionUUID->"1f8ae689-a833-c3f0-213e-22451f720b22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hMU", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "u"}], ")"}]}], "/", "2"}], " ", 
     RowBox[{"Log2", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "u"}], ")"}], "/", "2"}], "]"}]}], " ", "-",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "u"}], ")"}], "/", "2"}], " ", 
     RowBox[{"Log2", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "u"}], ")"}], "/", "2"}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"stepMU", " ", "=", " ", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"hMU", "[", "u", "]"}], " ", "<", " ", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"u", "^", "2"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "<", " ", "u", " ", "<", " ", "1"}]}], ",", 
     " ", "u", ",", " ", "Reals"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eqMU", " ", "=", " ", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"hMU", "[", "u", "]"}], " ", "==", " ", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"u", "^", "2"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "<", " ", "u", " ", "<", " ", "1"}]}], ",", 
     " ", "u", ",", " ", "Reals"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hMU", "[", "u", "]"}], " ", "+", " ", 
      RowBox[{"hMU", "[", "w", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "w"}], "}"}], " ", "\[Element]", " ", 
      RowBox[{"Disk", "[", "]"}]}], ",", " ", 
     RowBox[{"Contours", " ", "->", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"1.1", ",", " ", "1.9", ",", " ", "0.1"}], "]"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}]}], "]"}], ",", "\n",
    "  ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"PointSize", "[", "0.025", "]"}]}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<z\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"PlotLabel", " ", "->", " ", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<H(X) + H(Z) in bits\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<on -1 < u < 1:   h(u) < 1 - \>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<u\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\<: \>\"", ",", " ", "stepMU", ",", 
           " ", "\"\<;   h(u) = 1 - \>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<u\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\<: \>\"", ",", " ", "eqMU"}], "}"}], "]"}]}], "}"}], ",", 
      " ", 
      RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]}], "Input",
 CellLabel->"In[137]:= ",
 CellID->408131547,ExpressionUUID->"13c24191-8215-8def-182a-7a9d6fa5adac"],

Cell[TextData[{
 "The sum never drops below one bit. Equality needs ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d269bd1-229f-d299-0516-e4e714f753cf"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], ",", 
   RowBox[{
    StyleBox["z", "TI"], "\[Element]", "{", "0"}], ",", 
   RowBox[{"\[PlusMinus]", "1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "625beab6-e938-1fa2-4475-2b37350eb4e3"],
 ", which are the four marked eigenstates of ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79a55053-19e0-18c5-64ac-0b70f7f3fcf5"],
 " and ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43a979a0-bc8d-ab70-3755-0422ff2bb68c"],
 ": a state sharp in one basis is completely uncertain in the other. Every \
mixed state, and every state with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["y", "TI"], "\[NotEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cae6384-ea95-ef4c-5366-2e81427c8c3f"],
 ", has ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["z", "TI"], "2"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36502a56-4046-0d72-34dc-7a627572dea9"],
 " and sits strictly above the bound."
}], "Text",
 CellID->1999964238,ExpressionUUID->"31e45be0-e9de-4d5a-0f9c-76fe70dc251b"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
