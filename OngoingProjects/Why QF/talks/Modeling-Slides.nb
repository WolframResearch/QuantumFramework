       {"0", 
        SqrtBox[
         StyleBox["\[Gamma]", "TI"]]},
       {"0", "0"}
      }], ")"}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["I", "TI"], 
     StyleBox["c", "TI"]], "=", 
    RowBox[{
     RowBox[{
      StyleBox["S", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["B", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}], "-", 
     RowBox[{
      StyleBox["S", "TI"], 
