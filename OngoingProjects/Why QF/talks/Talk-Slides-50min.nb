Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";", " ", 
  
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"nsMatrix", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"3", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"3", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "2", "]"}], " ", "-", " ", 
        RowBox[{"1", "/", "2"}]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nsGate", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", "nsMatrix", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"RootReduce", "[", 
     RowBox[{"nsMatrix", " ", ".", " ", 
      RowBox[{"Transpose", "[", "nsMatrix", "]"}]}], "]"}], " ", "==", " ", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", "\n", " ", 
   RowBox[{"RootReduce", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"nsGate", "[", 
       RowBox[{"\"\<Amplitude\>\"", ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
         
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "1", ",", " ", "0"}], "}"}]}]}], "]"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[24]:= ",
 CellID->811283638,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

