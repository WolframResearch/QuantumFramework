Cell["The Mollow triplet", "Subsection",
 CellID->807053435,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["\<\
Fluorescence of a resonantly driven atom by quantum regression: one linear \
solve per frequency on the same Liouvillian.\
\>", "Text",
 CellID->1633675818,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lower", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"X", " ", "-", " ", 
      RowBox[{"I", " ", "Y"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"steady", "[", 
    RowBox[{"H_", ",", " ", "leaks_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"First", "@", 
          RowBox[{"NullSpace", "[", 
           RowBox[{"liouvillian", "[", 
            RowBox[{"H", ",", " ", "leaks", ",", " ", "2"}], "]"}], "]"}]}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"v", "/", 
      RowBox[{"Tr", "[", "v", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resolventSpectrum", "[", 
    RowBox[{
    "big_", ",", " ", "seedMat_", ",", " ", "readout_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "big", "]"}]}], ",", " ", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "readout", "]"}]}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{"readout", " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "w", "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], ",", "\n", "       ", 
               RowBox[{"LeastSquares", "[", 
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"N", "[", 
                    RowBox[{"-", "big"}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"1.", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], 
                    "}"}]}], "]"}], ",", " ", 
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"Flatten", "[", "seedMat", "]"}], ",", " ", 
                   RowBox[{"{", "0.", "}"}]}], "]"}]}], "]"}], ",", "\n", 
               "       ", 
               RowBox[{"LinearSolve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"I", " ", "w", " ", 
                   RowBox[{"IdentityMatrix", "[", "n", "]"}]}], " ", "-", " ",
                   "big"}], ",", " ", 
                 RowBox[{"Flatten", "[", "seedMat", "]"}]}], "]"}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}]}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "tones"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input", "HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[11]:= ",
 CellID->1828793009,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mollow", "[", 
    RowBox[{"om_", ",", " ", "tones_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"big", " ", "=", " ", 
        RowBox[{"liouvillian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", "lower", "}"}], ",", " ", "2"}], "]"}]}], ",", " ", 
       RowBox[{"rss", " ", "=", " ", 
        RowBox[{"steady", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", "lower", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dm", " ", "=", " ", 
         RowBox[{"lower", " ", "-", " ", 
          RowBox[{
           RowBox[{"Tr", "[", 
            RowBox[{"lower", " ", ".", " ", "rss"}], "]"}], " ", "id2"}]}]}], 
        "}"}], ",", " ", 
       RowBox[{"resolventSpectrum", "[", 
        RowBox[{"big", ",", " ", 
         RowBox[{"dm", " ", ".", " ", "rss"}], ",", " ", 
         RowBox[{"ConjugateTranspose", "[", "dm", "]"}], ",", " ", "tones"}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tones", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "9"}], ",", " ", "9", ",", " ", "0.05"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"weak", ",", " ", "strong"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"mollow", "[", 
      RowBox[{"#", ",", " ", "tones"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.6", ",", " ", "6."}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"weak", "/", 
         RowBox[{"Max", "[", "weak", "]"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"strong", "/", 
         RowBox[{"Max", "[", "strong", "]"}]}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalOmega] = 0.6\[Gamma]\>\"", ",", 
      " ", "\"\<\[CapitalOmega] = 6\[Gamma]\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency - drive frequency\>\"", ",", 
      " ", "\"\<inelastic spectrum (scaled to peak)\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[12]:= ",
 CellID->1232986364,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "Strong driving dresses the atom and splits one line into three, with \
