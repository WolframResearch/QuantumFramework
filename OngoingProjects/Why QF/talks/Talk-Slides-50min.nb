Cell["Below the zero-point at every strength", "Subsection",
 CellID->1381425643,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[TextData[{
 "In ground-state units the position variance depends only on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 "; the cell proves it is below one for all ",
 Cell[BoxData[
  StyleBox["\[Mu]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " and finds both limits."
}], "Text",
 CellID->377280352,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sqRatio", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"u", "^", "2"}]}], "]"}], " ", "-", " ", "1"}], ")"}]}], 
     "]"}], "/", "u"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SxSS", "/", 
       RowBox[{"(", 
        RowBox[{"\[HBar]", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m", " ", "\[Omega]"}], ")"}]}], ")"}]}], " ", "==",
       " ", 
      RowBox[{"sqRatio", "[", 
       RowBox[{"2", " ", "\[HBar]", " ", 
        RowBox[{"\[Lambda]", "/", 
         RowBox[{"(", 
          RowBox[{"m", " ", 
           RowBox[{"\[Omega]", "^", "2"}]}], ")"}]}]}], "]"}]}], ",", " ", 
     "as"}], "]"}], ",", "\n", " ", 
   RowBox[{"Resolve", "[", 
    RowBox[{
     RowBox[{"ForAll", "[", 
      RowBox[{"u", ",", " ", 
       RowBox[{"u", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"sqRatio", "[", "u", "]"}], " ", "<", " ", "1"}]}], "]"}], ",",
      " ", "Reals"}], "]"}], ",", "\n", " ", 
   RowBox[{"Asymptotic", "[", 
    RowBox[{
     RowBox[{"sqRatio", "[", "u", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"u", " ", ">=", " ", "0"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Asymptotic", "[", 
    RowBox[{
     RowBox[{"sqRatio", "[", "u", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "Infinity", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"u", " ", ">=", " ", "0"}]}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[15]:= ",
 CellID->1717363484,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[TextData[{
 "Weak measurement squeezes as ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["\[Mu]", "TI"], "2"], "/", "8"}]], "InlineFormula",
