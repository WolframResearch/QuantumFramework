Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"measurementStep", "[", 
    RowBox[{
    "H_", ",", " ", "watched_", ",", " ", "effs_", ",", " ", "unwatched_", ",",
      " ", "dt_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"id", " ", "=", " ", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "H", "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"drift", " ", "=", " ", 
        RowBox[{
         RowBox[{"I", " ", "H"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "#", "]"}], " ", ".", " ", 
              "#"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"watched", ",", " ", "unwatched"}], "]"}]}], "]"}], "/", 
          "2"}]}]}], ",", "\n", "    ", 
       RowBox[{"corr", " ", "=", " ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", " ", 
              RowBox[{"(", 
               RowBox[{"#2", " ", ".", " ", "#2"}], ")"}]}], " ", "&"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"effs", ",", " ", "watched"}], "}"}]}], "]"}], "]"}], "/",
          "2"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rho", ",", " ", "dJ"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sig", " ", "=", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sqrt", "[", "#2", "]"}], " ", "#1", " ", "#3"}], " ",
                "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"dJ", ",", " ", "effs", ",", " ", "watched"}], "}"}]}],
              "]"}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"M", " ", "=", " ", 
             RowBox[{"id", " ", "-", " ", 
              RowBox[{"drift", " ", "dt"}], " ", "+", " ", "sig", " ", "+", 
              " ", 
              RowBox[{
               RowBox[{"sig", " ", ".", " ", "sig"}], "/", "2"}], " ", "-", 
              " ", 
              RowBox[{"corr", " ", "dt"}]}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"top", " ", "=", " ", 
               RowBox[{
                RowBox[{"M", " ", ".", " ", "rho", " ", ".", " ", 
                 RowBox[{"ConjugateTranspose", "[", "M", "]"}]}], " ", "+", 
                "\n", "          ", 
                RowBox[{"dt", " ", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", 
                    "&"}], " ", "/@", " ", "unwatched"}], "]"}]}], " ", "+", 
                "\n", "          ", 
                RowBox[{"dt", " ", 
                 RowBox[{"Total", "[", 
                  RowBox[{"MapThread", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "#2"}], ")"}], " ", 
                    RowBox[{"#1", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}]}], " ", 
                    "&"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"watched", ",", " ", "effs"}], "}"}]}], "]"}], 
                  "]"}]}]}]}], "}"}], ",", "\n", "       ", 
             RowBox[{"top", "/", 
              RowBox[{"Re", "@", 
               RowBox[{"Tr", "[", "top", "]"}]}]}]}], "]"}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementRecord", "[", 
    RowBox[{
    "rho_", ",", " ", "watched_", ",", " ", "effs_", ",", " ", "dt_", ",", 
     " ", "kick_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "#3", "]"}], " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#1", " ", "+", " ", 
             RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], " ", ".",
            " ", "rho"}], "]"}]}], " ", "dt"}], " ", "+", " ", "#2"}], " ", 
      "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"watched", ",", " ", "kick", ",", " ", "effs"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trajectory", "[", 
    RowBox[{
    "rho0_", ",", " ", "H_", ",", " ", "watched_", ",", " ", "effs_", ",", 
     " ", "unwatched_", ",", " ", "dt_", ",", " ", "tf_", ",", " ", "seed_"}],
     "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"step", " ", "=", " ", 
          RowBox[{"measurementStep", "[", 
           RowBox[{
           "H", ",", " ", "watched", ",", " ", "effs", ",", " ", "unwatched", 
            ",", " ", "dt"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"kicks", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
