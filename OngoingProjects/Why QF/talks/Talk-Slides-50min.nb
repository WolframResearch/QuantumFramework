 CellID->292747604,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell["\<\
Entanglement entropy across one qubit and across half the chain, with no \
state vector.\
\>", "Text",
 CellID->1553818268,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ghz", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "1000", "]"}], "[", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "q"}], "}"}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "2", ",", " ", "1000"}], "}"}]}], "]"}], ",", 
      " ", "\"\<H\>\""}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"ghz", "[", 
     RowBox[{"\"\<Entropy\>\"", ",", " ", 
      RowBox[{"{", "1", "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"ghz", "[", 
    RowBox[{"\"\<Entropy\>\"", ",", " ", 
     RowBox[{"Range", "[", "500", "]"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[29]:= ",
 CellID->1870754514,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

