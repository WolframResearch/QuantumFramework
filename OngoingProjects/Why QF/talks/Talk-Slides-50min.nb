 CellID->2118931930,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[TextData[{
 "The homodyne noise at zero frequency is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "+", "8", 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", 
    SuperscriptBox["\[CapitalOmega]", "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 "; minimize it over the drive."
}], "Text",
 CellID->1039057480,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[BoxData[
 RowBox[{"Minimize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"8", " ", 
       RowBox[{"\[CapitalOmega]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", " ", 
           RowBox[{"\[CapitalOmega]", "^", "2"}]}], " ", "-", " ", "1"}], 
         ")"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"2", " ", 
            RowBox[{"\[CapitalOmega]", "^", "2"}]}]}], ")"}], "^", 
         "3"}]}]}]}], ",", " ", 
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], "}"}], ",", " ", 
   "\[CapitalOmega]"}], "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->1411198270,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[TextData[{
 "Below the vacuum for every ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "<", 
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
