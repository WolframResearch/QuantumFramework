Cell["\<\
The five-qubit code: the syndrome of each of the fifteen single-qubit errors.\
\
\>", "Text",
 CellID->2099805207,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"code", " ", "=", " ", 
   RowBox[{"PauliStabilizer", "[", "\"\<5QubitCode\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"Most", "[", 
    RowBox[{"code", "[", "\"\<Stabilizers\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"syndrome", "[", "err_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"code", "[", "err", "]"}], "[", 
          RowBox[{"\"\<Expectation\>\"", ",", " ", "#"}], "]"}], " ", "&"}], 
        " ", "/@", " ", "checks"}], ")"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"errors", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "->", " ", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}],
           "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], ",", " ",
      "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{"syndrome", ",", " ", "errors"}], "]"}]}], "Input",
 CellLabel->"In[27]:= ",
 CellID->1402006442,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{"syndrome", " ", "/@", " ", "errors"}], "]"}], " ", "===", " ", 
  RowBox[{"Sort", "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1901179466,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

