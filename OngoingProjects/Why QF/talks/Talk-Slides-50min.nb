Cell["\<\
The full conditional wavefunction on a grid, against a quantum Kalman filter \
fed only the noisy readings.\
\>", "Text",
 CellID->305160771,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hbar", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"mass", " ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"grid", "[", 
    RowBox[{"n_", ",", " ", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dx", " ", "=", " ", 
       RowBox[{"l", "/", "n"}]}], "}"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", "n"}], ",", " ", 
       RowBox[{"\"\<x\>\"", " ", "->", " ", 
        RowBox[{"dx", " ", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "n"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"n", "/", "2"}], " ", "-", " ", "1"}]}], "]"}]}]}], ",", 
       "\n", "    ", 
       RowBox[{"\"\<p\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "Pi", " ", 
           RowBox[{"hbar", "/", "l"}]}], ")"}], " ", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "n"}], "/", "2"}], ",", " ", 
             RowBox[{
              RowBox[{"n", "/", "2"}], " ", "-", " ", "1"}]}], "]"}], ",", 
           " ", 
           RowBox[{"n", "/", "2"}]}], "]"}]}]}]}], "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ft", "[", "psi_", "]"}], " ", ":=", " ", 
   RowBox[{"Fourier", "[", 
    RowBox[{"psi", ",", " ", 
     RowBox[{"FourierParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ift", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{"InverseFourier", "[", 
    RowBox[{"c", ",", " ", 
     RowBox[{"FourierParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussian", "[", 
    RowBox[{"g_", ",", " ", "x0_", ",", " ", "p0_", ",", " ", "s_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"g", "[", "\"\<x\>\"", "]"}], " ", "-", " ", "x0"}], ")"}],
          "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", 
         RowBox[{"s", "^", "2"}]}], ")"}]}], " ", "+", " ", 
      RowBox[{"I", " ", "p0", " ", 
       RowBox[{
        RowBox[{"g", "[", "\"\<x\>\"", "]"}], "/", "hbar"}]}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xMean", "[", 
    RowBox[{"g_", ",", " ", "psi_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"g", "[", "\"\<x\>\"", "]"}], " ", ".", " ", 
    RowBox[{
     RowBox[{"Abs", "[", "psi", "]"}], "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"outcome", "[", 
     RowBox[{"g_", ",", " ", "lam_", ",", " ", "dt_"}], "]"}], "[", "psi_", 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"RandomChoice", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "psi", "]"}], "^", "2"}], " ", "->", " ", 
      RowBox[{"g", "[", "\"\<x\>\"", "]"}]}], "]"}], " ", "+", "\n", "   ", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"4", " ", "lam", " ", "dt"}], "]"}]}]}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measUpdate", "[", 
     RowBox[{"g_", ",", " ", "lam_", ",", " ", "dt_", ",", " ", "xb_"}], 
     "]"}], "[", "psi_", "]"}], " ", ":=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "lam"}], " ", "dt", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g", "[", "\"\<x\>\"", "]"}], " ", "-", " ", "xb"}], ")"}], 
        "^", "2"}]}], "]"}], " ", "psi"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"potentialStep", "[", 
     RowBox[{"g_", ",", " ", "V_", ",", " ", "dt_"}], "]"}], "[", "psi_", 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"V", "[", 
       RowBox[{"g", "[", "\"\<x\>\"", "]"}], "]"}], " ", 
      RowBox[{"dt", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "hbar"}], ")"}]}]}], "]"}], " ", "psi"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kineticStep", "[", 
     RowBox[{"g_", ",", " ", "dt_"}], "]"}], "[", "psi_", "]"}], " ", ":=", 
   " ", 
   RowBox[{"ift", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{
        RowBox[{"g", "[", "\"\<p\>\"", "]"}], "^", "2"}], " ", 
       RowBox[{"dt", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "mass", " ", "hbar"}], ")"}]}]}], "]"}], " ", 
     RowBox[{"ft", "[", "psi", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evolveStep", "[", 
    RowBox[{"g_", ",", " ", "V_", ",", " ", "dt_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"potentialStep", "[", 
     RowBox[{"g", ",", " ", "V", ",", " ", "dt"}], "]"}], " ", "@*", " ", 
    RowBox[{"kineticStep", "[", 
     RowBox[{"g", ",", " ", "dt"}], "]"}], " ", "@*", " ", 
    RowBox[{"potentialStep", "[", 
     RowBox[{"g", ",", " ", "V", ",", " ", "dt"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"trajectory", "[", 
     RowBox[{
     "g_", ",", " ", "V_", ",", " ", "lam_", ",", " ", "dt_", ",", " ", 
      "nt_"}], "]"}], "[", "psi0_", "]"}], " ", ":=", " ", 
   RowBox[{"NestList", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evolveStep", "[", 
        RowBox[{"g", ",", " ", "V", ",", " ", "dt"}], "]"}], "[", 
       RowBox[{
        RowBox[{"measUpdate", "[", 
         RowBox[{"g", ",", " ", "lam", ",", " ", "dt", ",", " ", 
          RowBox[{"Sow", "@", 
           RowBox[{
            RowBox[{"outcome", "[", 
             RowBox[{"g", ",", " ", "lam", ",", " ", "dt"}], "]"}], "[", "#", 
            "]"}]}]}], "]"}], "[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
     "psi0", ",", " ", "nt"}], "]"}]}], ";"}]}], "Input", "HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[17]:= ",
 CellID->1896945989,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wR", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"lamH", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"SxZP", " ", "=", " ", 
   RowBox[{"hbar", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "mass", " ", "wR"}], ")"}]}]}], ";", " ", 
  RowBox[{"SpZP", " ", "=", " ", 
   RowBox[{"hbar", " ", "mass", " ", 
    RowBox[{"wR", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gH", " ", "=", " ", 
   RowBox[{"grid", "[", 
    RowBox[{"256", ",", " ", "24."}], "]"}]}], ";", " ", 
  RowBox[{"dtH", " ", "=", " ", "0.002"}], ";", " ", 
  RowBox[{"ntH", " ", "=", " ", "1500"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"states", ",", " ", 
     RowBox[{"{", "outs", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "21", "]"}], ";", "\n", "   ", 
     RowBox[{"Reap", "[", 
      RowBox[{
       RowBox[{"trajectory", "[", 
        RowBox[{"gH", ",", " ", 
         RowBox[{
          RowBox[{"0.5", " ", "mass", " ", 
           RowBox[{"wR", "^", "2"}], " ", 
           RowBox[{"#", "^", "2"}]}], " ", "&"}], ",", " ", "lamH", ",", " ", 
         "dtH", ",", " ", "ntH"}], "]"}], "[", 
       RowBox[{"gaussian", "[", 
        RowBox[{"gH", ",", " ", "0.", ",", " ", "0.", ",", " ", 
         RowBox[{"Sqrt", "[", "SxZP", "]"}]}], "]"}], "]"}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"xGrid", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"xMean", "[", 
      RowBox[{"gH", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";"}]}], "Input", "HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[18]:= ",
 CellID->653417278,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"num", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[HBar]", " ", "->", " ", "hbar"}], ",", " ", 
     RowBox[{"m", " ", "->", " ", "mass"}], ",", " ", 
     RowBox[{"\[Omega]", " ", "->", " ", "wR"}], ",", " ", 
     RowBox[{"\[Lambda]", " ", "->", " ", "lamH"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"covDrift", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sx", ",", " ", "cc", ",", " ", "sp"}], "}"}], ",", " ", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"riccati", " ", "/.", " ", "num"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sx", " ", "->", " ", "sx"}], ",", " ", 
         RowBox[{"Cc", " ", "->", " ", "cc"}], ",", " ", 
         RowBox[{"Sp", " ", "->", " ", "sp"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"filterStep", "[", "dt_", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mx_", ",", " ", "mp_", ",", " ", "sx_", ",", " ", "cc_", ",", " ", 
       "sp_"}], "}"}], ",", " ", "dY_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dWf", " ", "=", " ", 
       RowBox[{"dY", " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "mx", " ", "dt"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mx", " ", "+", " ", 
          RowBox[{
           RowBox[{"mp", "/", "mass"}], " ", "dt"}], " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "sx", " ", "dWf"}]}], ",",
          " ", 
         RowBox[{"mp", " ", "-", " ", 
          RowBox[{"mass", " ", 
           RowBox[{"wR", "^", "2"}], " ", "mx", " ", "dt"}], " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "cc", " ", "dWf"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sx", ",", " ", "cc", ",", " ", "sp"}], "}"}], " ", "+", " ", 
        RowBox[{"dt", " ", 
         RowBox[{"covDrift", "[", 
          RowBox[{"sx", ",", " ", "cc", ",", " ", "sp"}], "]"}]}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mFilter", " ", "=", " ", 
   RowBox[{
    RowBox[{"FoldList", "[", 
     RowBox[{
      RowBox[{"filterStep", "[", "dtH", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "0.", ",", " ", "0.", ",", " ", "SxZP", ",", " ", "0.", ",", " ", 
        "SpZP"}], "}"}], ",", " ", 
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "dtH", " ", "outs"}]}], "]"}],
     "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xGrid", ",", " ", "mFilter"}], "}"}], ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"ntH", " ", "dtH"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Gray"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<grid (256 amplitudes)\>\"", ",", 
      " ", "\"\<Kalman filter (5 numbers)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]x\[RightAngleBracket]\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[19]:= ",
 CellID->1067269536,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

