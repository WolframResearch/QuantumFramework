Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wienerFun", "[", 
    RowBox[{"tf_", ",", " ", "h_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"0.", ",", " ", "tf", ",", " ", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"tf", "/", "h"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"grid", ",", " ", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Accumulate", "[", "\n", "         ", 
               RowBox[{"RandomVariate", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"grid", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
                 
                 RowBox[{
                  RowBox[{"Length", "[", "grid", "]"}], " ", "-", " ", 
                  "1"}]}], "]"}], "]"}], ",", " ", "0."}], "]"}]}], "}"}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"InterpolationOrder", " ", "->", " ", "3"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oneTraj", "[", 
    RowBox[{
    "r_", ",", " ", "init_", ",", " ", "tf_", ",", " ", "h_", ",", " ", 
     "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Wf", " ", "=", " ", 
        RowBox[{"wienerFun", "[", 
         RowBox[{"tf", ",", " ", "h", ",", " ", "seed"}], "]"}]}], ",", " ", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ"}], 
         "}"}]}], ",", " ", "t"}], "}"}], ",", "\n", "   ", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"Join", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Through", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Derivative", "[", "1", "]"}], " ", "/@", " ", "v"}], 
              ")"}], "[", "t", "]"}], "]"}], " ", "==", "\n", "       ", 
           RowBox[{
            RowBox[{"driftStrat", "[", 
             RowBox[{
              RowBox[{"Through", "[", 
               RowBox[{"v", "[", "t", "]"}], "]"}], ",", " ", "r"}], "]"}], 
            " ", "+", " ", 
            RowBox[{
             RowBox[{"diffStrat", "[", 
              RowBox[{
               RowBox[{"Through", "[", 
                RowBox[{"v", "[", "t", "]"}], "]"}], ",", " ", "r"}], "]"}], " ", 
             RowBox[{
              RowBox[{"Wf", "'"}], "[", "t", "]"}]}]}]}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Through", "[", 
            RowBox[{"v", "[", "0", "]"}], "]"}], " ", "==", " ", "init"}], 
          "]"}]}], "]"}], ",", " ", "v", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "tf"}], "}"}], ",", " ", 
       RowBox[{"MaxStepSize", " ", "->", " ", 
        RowBox[{"h", "/", "4"}]}]}], "]"}]}], "]"}]}], ";"}]}], "Input", \
"HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[46]:= ",
