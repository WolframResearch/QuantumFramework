Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"id2", ",", " ", "X", ",", " ", "Y", ",", " ", "Z"}], "}"}], " ", 
   "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"op3", "[", 
    RowBox[{"o_", ",", " ", "i_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"id2", ",", " ", "id2", ",", " ", "id2"}], "}"}], ",", " ", 
      RowBox[{"i", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ket", "[", "bits_", "]"}], " ", ":=", " ", 
   RowBox[{"Normal", "@", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{"bits", ",", " ", "2"}], "]"}], " ", "+", " ", "1"}], " ", "->",
        " ", "1"}], ",", " ", "8"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S1", " ", "=", " ", 
   RowBox[{
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "1"}], "]"}], " ", ".", " ", 
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "2"}], "]"}]}]}], ";", " ", 
  RowBox[{"S2", " ", "=", " ", 
   RowBox[{
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "2"}], "]"}], " ", ".", " ", 
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "3"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"signs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"proj", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
