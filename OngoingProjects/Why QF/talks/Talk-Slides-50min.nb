Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"magicState", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "n", "]"}], "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"i", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<T\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", "3"}]}], "}"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{
        RowBox[{"magicState", "[", "n", "]"}], "[", "\"\<Length\>\"", "]"}], ",",
        " ", 
       RowBox[{"2", "^", "n"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "10", ",", " ", "20"}], "}"}]}], "}"}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"PauliStabilizer", "[", "1", "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"\"\<H\>\"", ",", " ", "\"\<T\>\""}], "}"}], "]"}], "[", 
        RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<X\>\""}], "]"}]}], 
      ")"}], "/", "2"}], "]"}]}], "}"}]}], "Input",
