            RowBox[{"3", " ", 
             RowBox[{"x", "^", "2"}]}], " ", "+", " ", "a"}], ")"}], " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{
            RowBox[{"2", " ", "y"}], ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "p"}], "]"}]}], ",", " ", "p"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xr", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "2"}], " ", "-", " ", 
            RowBox[{"2", " ", "x"}]}], ",", " ", "p"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"xr", ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "xr"}], ")"}]}], " ", "-", " ", 
            "y"}], ",", " ", "p"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1_", ",", " ", "y1_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x2_", ",", " ", "y2_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{
            RowBox[{"x2", " ", "-", " ", "x1"}], ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "p"}], "]"}]}], ",", " ", "p"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xr", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "2"}], " ", "-", " ", "x1", " ", "-", " ", 
            "x2"}], ",", " ", "p"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"xr", ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{"x1", " ", "-", " ", "xr"}], ")"}]}], " ", "-", " ", 
            "y1"}], ",", " ", "p"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"_", ",", " ", "0"}], "]"}], " ", ":=", " ", "O"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"pt_", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"add", " ", "=", " ", 
       RowBox[{
        RowBox[{"EllipticCurve", "[", 
         RowBox[{"a", ",", " ", "b", ",", " ", "p"}], "]"}], 
        "[", "\"\<Add\>\"", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Fold", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"add", "[", 
             RowBox[{"#1", ",", " ", "#1"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#2", " ", "==", " ", "1"}], ",", " ", 
            RowBox[{"add", "[", 
             RowBox[{"d", ",", " ", "pt"}], "]"}], ",", " ", "d"}], "]"}]}], 
         "]"}], " ", "&"}], ",", " ", "O", ",", " ", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EllipticCurve", "[", 
     RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
    "[", "\"\<Points\>\"", "]"}], " ", ":=", " ", 
   RowBox[{"Catenate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rhs", " ", "=", " ", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "^", "3"}], " ", "+", " ", 
             RowBox[{"a", " ", "x"}], " ", "+", " ", "b"}], ",", " ", "p"}], 
           "]"}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"p", " ", "-", " ", "1"}]}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"#", "^", "2"}], ",", " ", "p"}], "]"}], " ", "==", 
               " ", "rhs"}], " ", "&"}]}], "]"}]}], "}"}], "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", 
        RowBox[{"p", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input", "HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[48]:= ",
 CellID->1108042358,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ec", " ", "=", " ", 
   RowBox[{"EllipticCurve", "[", 
    RowBox[{"1", ",", " ", "1", ",", " ", "23"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pts", " ", "=", " ", 
   RowBox[{"ec", "[", "\"\<Points\>\"", "]"}]}], ";", " ", 
  RowBox[{"r", " ", "=", " ", 
   RowBox[{
    RowBox[{"Length", "[", "pts", "]"}], " ", "+", " ", "1"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"pts", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
            RowBox[{"#", ",", " ", "k"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "0", ",", " ", 
             RowBox[{"r", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}]}], " ", "==",
        " ", "r"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Q", " ", "=", " ", 
   RowBox[{
    RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"G", ",", " ", "7"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"r", ",", " ", "G", ",", " ", "Q"}], "}"}]}], "Input", \
"HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[49]:= ",
 CellID->1009200201,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"elts", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{"pts", ",", " ", "O"}], "]"}]}], ";", " ", 
  RowBox[{"idx", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"elts", " ", "->", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"r", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t", " ", "=", " ", "7"}], ";", " ", 
  RowBox[{"nn", " ", "=", " ", 
   RowBox[{"2", "^", "t"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"idx", "[", 
      RowBox[{
       RowBox[{"ec", "[", "\"\<Add\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
         RowBox[{"G", ",", " ", "a"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
         RowBox[{"Q", ",", " ", "b"}], "]"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", 
       RowBox[{"nn", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", 
       RowBox[{"nn", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probs", " ", "=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Fourier", "[", 
          RowBox[{
           RowBox[{"Boole", "[", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", "==", " ", "w"}], " ", "&"}], ",", " ", "f", 
              ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"FourierParameters", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "]"}], "^", "2"}], ",", 
       "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "0", ",", " ", 
         RowBox[{"r", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}], "/", 
    RowBox[{"nn", "^", "2"}]}]}], ";"}]}], "Input", "HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[50]:= ",
 CellID->752465254,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"samples", " ", "=", " ", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", "probs", "]"}], " ", "->", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"nn", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}], 
       "]"}]}], ",", " ", "20"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"keyFrom", "[", 
    RowBox[{"{", 
     RowBox[{"c_", ",", " ", "d_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"j", " ", "=", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"r", " ", 
            RowBox[{"c", "/", "nn"}]}], "]"}], ",", " ", "r"}], "]"}]}], ",", 
       " ", 
       RowBox[{"l", " ", "=", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"r", " ", 
            RowBox[{"d", "/", "nn"}]}], "]"}], ",", " ", "r"}], "]"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"CoprimeQ", "[", 
        RowBox[{"j", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"l", " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{"j", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "r"}], "]"}]}], ",", " ", "r"}], 
        "]"}], ",", " ", 
       RowBox[{"Missing", "[", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cands", " ", "=", " ", 
   RowBox[{"keyFrom", " ", "/@", " ", "samples"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"cands", ",", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"DeleteMissing", "@", 
      RowBox[{"DeleteDuplicates", "[", "cands", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
        RowBox[{"G", ",", " ", "#"}], "]"}], " ", "===", " ", "Q"}], " ", 
      "&"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[51]:= ",
 CellID->891183881,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

