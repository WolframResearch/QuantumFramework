 CellID->1477609488,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell["3. Continuous Measurement: Squeezing in Closed Form", "Section",
 CellID->1030824397,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[TextData[{
 "A trapped particle whose position is watched continuously: the conditional \
covariances obey a Riccati equation, solved with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], ",", 
   StyleBox["\[Omega]", "TI"], ",", 
   StyleBox["m", "TI"], ",", "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 " symbolic."
}], "Text",
 CellID->100031176,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"riccati", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"Cc", "/", "m"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Lambda]", " ", 
       RowBox[{"Sx", "^", "2"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sp", "/", "m"}], " ", "-", " ", 
      RowBox[{"m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "Sx"}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Lambda]", " ", "Sx", " ", "Cc"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "Cc"}], " ", "+", " ", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"\[HBar]", "^", "2"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Lambda]", " ", 
       RowBox[{"Cc", "^", "2"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steady", " ", "=", " ", 
   RowBox[{
    RowBox[{"SolveValues", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"riccati", " ", "==", " ", "0"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Sx", ",", " ", "Cc", ",", " ", "Sp"}], "}"}]}], "]"}], " ", "//",
     " ", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"positiveQ", "[", "sol_", "]"}], " ", ":=", " ", 
   RowBox[{"TrueQ", "@", 
    RowBox[{"Resolve", "[", 
     RowBox[{
      RowBox[{"ForAll", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "m", ",", " ", "\[Lambda]", ",", " ", "\[Omega]", ",", " ", 
          "\[HBar]"}], "}"}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Omega]", " ", ">=", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[HBar]", " ", ">", " ", "0"}]}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "|", " ", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}], " ", "\[Element]", " ", 
          "Reals"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", ">", " ", "0"}]}]}], "]"}], ",",
       " ", "Reals"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"SxSS", ",", " ", "CcSS", ",", " ", "SpSS"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"steady", ",", " ", "positiveQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"as", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[Omega]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"m", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[HBar]", " ", ">", " ", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SxSS", " ", "SpSS"}], " ", "-", " ", 
    RowBox[{"CcSS", "^", "2"}]}], ",", " ", "as"}], "]"}]}], "Input",
 CellLabel->"In[14]:= ",
 CellID->144223354,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell["The steady conditional state is pure.", "Text",
 CellID->1443527617,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

