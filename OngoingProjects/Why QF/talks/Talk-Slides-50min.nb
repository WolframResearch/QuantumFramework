  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"modeList", "[", "occ_List", "]"}], " ", ":=", " ", 
   RowBox[{"Catenate", "@", 
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"First", "[", "#2", "]"}], ",", " ", "#1"}], "]"}], " ", 
       "&"}], ",", " ", "occ"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bosonProb", "[", 
    RowBox[{"w_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Permanent", "[", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"modeList", "[", "t", "]"}], ",", " ", 
          RowBox[{"modeList", "[", "s", "]"}]}], "]"}], "]"}], "]"}], "]"}], "^",
      "2"}], "/", 
    RowBox[{"Times", " ", "@@", " ", 
     RowBox[{"Factorial", "[", 
      RowBox[{"Join", "[", 
       RowBox[{"s", ",", " ", "t"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"distProb", "[", 
    RowBox[{"w_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Permanent", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", "w", "]"}], "^", "2"}], ")"}], "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"modeList", "[", "t", "]"}], ",", " ", 
        RowBox[{"modeList", "[", "s", "]"}]}], "]"}], "]"}], "]"}], "/", 
    RowBox[{"Times", " ", "@@", " ", 
     RowBox[{"Factorial", "[", "t", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fermionProb", "[", 
    RowBox[{"w_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"Det", "[", 
      RowBox[{"w", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"modeList", "[", "t", "]"}], ",", " ", 
         RowBox[{"modeList", "[", "s", "]"}]}], "]"}], "]"}], "]"}], "]"}], "^",
     "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Wbs", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{
      RowBox[{"{", 
