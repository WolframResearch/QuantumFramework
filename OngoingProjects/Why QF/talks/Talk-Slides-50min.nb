Cell[BoxData[{
 RowBox[{
  RowBox[{"fourBS", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fa", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fourBS", "[", 
      RowBox[{"\"\<Amplitude\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fa", " ", "==", " ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"6", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}], ",", " ", 
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"R", " ", "/.", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"6", " ", "R", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "R"}], ")"}]}]}], " ", "==", " ", 
        "0"}], " ", "&&", " ", 
       RowBox[{"0", " ", "<", " ", "R", " ", "<", " ", "1"}]}], ",", " ", "R",
       ",", " ", "Reals"}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[26]:= ",
 CellID->1055776787,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"1", "-", "6", 
   StyleBox["R", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["R", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 " vanishes at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", "\[PlusMinus]", 
    SqrtBox["3"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 ", two settings that are mirror images under ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "\[LeftRightArrow]", "1", "-", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 "."
}], "Text",
