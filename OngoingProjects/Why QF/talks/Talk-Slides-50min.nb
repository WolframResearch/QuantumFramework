Cell["What an imperfect detector costs", "Subsection",
 CellID->1621535814,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[TextData[{
 "A detector catching a fraction ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 " of the signal: steady purity, and the strength needed to squeeze."
}], "Text",
 CellID->1193935837,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"SxE", ",", " ", "CcE", ",", " ", "SpE"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"SxSS", ",", " ", "CcSS", ",", " ", "SpSS"}], "}"}], " ", "/.", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", " ", "->", " ", 
       RowBox[{"\[Eta]", " ", "\[Lambda]"}]}], ",", " ", 
      RowBox[{"\[HBar]", " ", "->", " ", 
       RowBox[{"\[HBar]", "/", 
        RowBox[{"Sqrt", "[", "\[Eta]", "]"}]}]}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"\[HBar]", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"SxE", " ", "SpE"}], " ", "-", " ", 
          RowBox[{"CcE", "^", "2"}]}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[HBar]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}], ",", " ", 
       
       RowBox[{"\[Lambda]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"\[Omega]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"m", " ", ">", " ", "0"}]}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Simplify", "@", 
    RowBox[{"Reduce", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sqRatio", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", "u"}], "]"}], "/", 
         RowBox[{"Sqrt", "[", "\[Eta]", "]"}]}], " ", "<=", " ", "1"}], " ", "&&",
        " ", 
       RowBox[{"u", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<", " ", "1"}]}], ",", " ",
       "u", ",", " ", "Reals"}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[16]:= ",
 CellID->105329933,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell[TextData[{
 "The purity is exactly ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " whatever the trap, mass or strength, and squeezing survives past a \
threshold that diverges as the detector fails."
}], "Text",
 CellID->1234416869,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

