Cell["1. Open Quantum Systems, Solved Once for Every Qubit", "Section",
 CellID->28909615,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["\<\
A driven qubit with relaxation and dephasing, every rate and every entry of \
the initial state a symbol.\
\>", "Text",
 CellID->193832008,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[CapitalOmega]", " ", "\[Element]", " ", "Reals"}], " ", "&&", 
    " ", 
    RowBox[{"t", " ", ">=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]m", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"Array", "[", 
     RowBox[{"\[Rho]", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]1", "]"}], " ", "\[Sigma]m"}], ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]\[Phi]", "]"}], " ", 
        RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], "}"}], ",", 
     " ", "\[Rho]0", ",", " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FullSimplify", " ", "/@", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"\[Rho]t", "[", "\"\<Computational\>\"", "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], " ", "//", " ", 
  "MatrixForm"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->684317082,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[TextData[{
 "Populations relax at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 "; coherences precess at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " and decay at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "/", "2", "+", "2", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 "."
}], "Text",
 CellID->528485616,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1392207227,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " as a theorem"
}], "Subsection",
 CellID->705466992,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[TextData[{
 "A statement about all admissible rates, decided by ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 "."
}], "Text",
 CellID->1350516518,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{"ForAll", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[Phi]"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Gamma]\[Phi]"}]}], ")"}]}], " ", "<=", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->907546795,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell["\<\
Derived from the solution, not quoted, with equality exactly when pure \
dephasing vanishes.\
\>", "Text",
 CellID->814772321,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1054628905,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell["A coherent error, with measurement records as wires", "Subsection",
 CellID->2043779557,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell["\<\
Encode, rotate qubit 2 by an arbitrary angle, measure two parities onto \
record wires, and correct by gates controlled on those records.\
\>", "Text",
 CellID->17830494,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"id2", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", " ", 
  RowBox[{"zz", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"syn", "[", 
    RowBox[{"q1_", ",", " ", "q2_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumMeasurementOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"id2", ",", " ", "id2"}], "]"}], " ", "+", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"id2", ",", " ", "id2"}], "]"}], " ", "-", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"enc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", 
       RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "}"}], ",", " ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Encode\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qec", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"enc", ",", " ", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", 
        RowBox[{"2", " ", "\[Theta]"}], "]"}], " ", "->", " ", "2"}], ",", 
      " ", 
      RowBox[{"syn", "[", 
       RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"syn", "[", 
       RowBox[{"2", ",", " ", "3"}], "]"}], ",", "\n", "    ", 
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{"\"\<X\>\"", ",", " ", 
        RowBox[{"{", "0", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"-", "1"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{
        RowBox[{"\"\<X\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", "}"}]}], "]"}], ",", " ", 
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{
        RowBox[{"\"\<X\>\"", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"-", "1"}], "}"}], ",", " ", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"coded", " ", "=", " ", 
   RowBox[{"qec", "[", 
    RowBox[{"QuantumTensorProduct", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
      RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input", "HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[3]:= ",
 CellID->1589986527,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[BoxData[
 RowBox[{"qec", "[", "\"\<Diagram\>\"", "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->943101875,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell["\<\
The classical record is part of the circuit, so the whole protocol is one \
object.\
\>", "Text",
 CellID->67888809,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1432876021,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell["The error is digitized and corrected exactly", "Subsection",
 CellID->876231958,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell["\<\
Syndrome distribution and final fidelity, for a symbolic data qubit and a \
symbolic error angle.\
\>", "Text",
 CellID->1020575516,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"as", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Alpha]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", "+", " ", 
       RowBox[{"\[Beta]", "^", "2"}]}], " ", "==", " ", "1"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Assuming", "[", 
  RowBox[{"as", ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", "\n", "   ", 
     RowBox[{"Diagonal", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumPartialTrace", "[", 
         RowBox[{"coded", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[5]:= ",
 CellID->1967685850,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{"as", ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{"coded", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"enc", "[", 
        RowBox[{"QuantumTensorProduct", "[", 
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
          RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}], ",",
        " ", "\"\<Fidelity\>\""}], "]"}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->1044562475,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 "The continuous rotation becomes \"no error\" with probability ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " or \"qubit 2 flipped\" with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 ", and the correction restores every input at every angle."
}], "Text",
 CellID->1653200050,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1384978530,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["2. The Quantum Zeno Crossover as an Exceptional Point", "Section",
 CellID->519689844,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[TextData[{
 "A qubit Rabi-driven at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " while ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " is watched at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 ": the full Liouvillian spectrum, symbolic."
}], "Text",
 CellID->1609367578,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"id2", ",", " ", "X", ",", " ", "Y", ",", " ", "Z"}], "}"}], " ", 
   "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"liouvillian", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", "d_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"id", " ", "=", " ", 
       RowBox[{"IdentityMatrix", "[", "d", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"H", ",", " ", "id"}], "]"}], " ", "-", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"id", ",", " ", 
           RowBox[{"Transpose", "[", "H", "]"}]}], "]"}]}], ")"}]}], " ", "+",
       "\n", "    ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Conjugate", "[", "c", "]"}]}], "]"}], " ", "-", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", " ",
                  "c"}], ",", " ", "id"}], "]"}], " ", "+", "\n", 
              "           ", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"id", ",", " ", 
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", 
                  " ", "c"}], "]"}]}], "]"}]}], ")"}], "/", "2"}]}]}], "]"}], 
        " ", "/@", " ", "leaks"}], "]"}]}]}], "]"}]}], ";"}]}], "Input", \
"HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[7]:= ",
 CellID->1541450781,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData[
 RowBox[{"Eigenvalues", "@", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"liouvillian", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "k", "]"}], " ", "Z"}], "}"}], ",", " ", "2"}], 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"k", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1657269721,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[BoxData[
 RowBox[{"Normal", "@", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "k"}], " ", "+", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"k", "^", "2"}], " ", "-", " ", 
       RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "Infinity", ",", " ", "1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1140508347,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[TextData[{
 "The oscillating pair coalesces at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " and splits into two real rates; the slow one is the Zeno freeze ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 "."
}], "Text",
 CellID->496109794,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

