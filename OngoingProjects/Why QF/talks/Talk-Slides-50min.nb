Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"occupations", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"PadRight", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"2", " ", "n"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<collision-free\>\"", " ", "->", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", " ", "n"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<pairs\>\"", " ", "->", " ", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"Quotient", "[", 
            RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"\"\<bunched\>\"", " ", "->", " ", 
       RowBox[{"{", "n", "}"}]}]}], "|>"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"randomInterferometer", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", 
      RowBox[{"1107", " ", "+", " ", 
       RowBox[{"1000", " ", "n"}]}], "]"}], ";", " ", 
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"\"\<Random\>\"", "[", 
       RowBox[{"2", " ", "n"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"timeAmplitude", "[", 
    RowBox[{"q_", ",", " ", "s_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", " ", "=", " ", 
       RowBox[{"RotateRight", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"Total", "[", "s", "]"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"ClearSystemCache", "[", "]"}], ";", " ", 
      RowBox[{"First", "@", 
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{"q", "[", 
         RowBox[{"\"\<Amplitude\>\"", ",", " ", 
          RowBox[{"s", " ", "->", " ", "t"}]}], "]"}], "]"}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{"Function", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"randomInterferometer", "[", "n", "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"timeAmplitude", "[", 
          RowBox[{"q", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"occupations", "[", "n", "]"}]}]}], "]"}]}], "]"}], ",", "\n",
    " ", 
   RowBox[{"{", 
    RowBox[{"6", ",", " ", "12", ",", " ", "18", ",", " ", "20"}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[37]:= ",
 CellID->544914423,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

