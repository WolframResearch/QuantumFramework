Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";", " ", 
  
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"envelope", " ", "=", " ", 
   RowBox[{"A", " ", 
    RowBox[{"(", 
     RowBox[{"Pi", "/", "\[Tau]"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"t", "/", "\[Tau]"}]}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hamiltonian", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
       RowBox[{
        RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
        RowBox[{"c", " ", "@", " ", "c"}]}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"\[Delta]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "c"}], 
      ")"}]}], " ", "+", "\n", "   ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"envelope", "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"c", " ", "+", " ", 
       RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}]}], ")"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"envelope", ",", " ", "t"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Alpha]"}], ")"}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "-", " ", "c"}], 
        ")"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"anharmonicity", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "Pi", " ", "0.2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"finalPopulations", "[", 
    RowBox[{"n_", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "amplitude_", ",", " ", "drag_", ",", " ", "detuning_", ",", " ", 
       "length_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEvolve", "[", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{
          RowBox[{"hamiltonian", "[", 
           RowBox[{"AnnihilationOperator", "[", "n", "]"}], "]"}], ",", " ", 
          RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
            "\[Alpha]", ",", " ", "A", ",", " ", "\[Lambda]", ",", " ", 
             "\[Delta]", ",", " ", "\[Tau]"}], "}"}]}]}], "]"}], "[", "\n", 
        "    ", 
        RowBox[{
        "anharmonicity", ",", " ", "amplitude", ",", " ", "drag", ",", " ", 
         "detuning", ",", " ", "length"}], "]"}], ",", "\n", "   ", 
       RowBox[{"FockState", "[", 
        RowBox[{"0", ",", " ", "n"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "length"}], "}"}], ",", " ", 
       RowBox[{"Method", " ", "->", " ", "\"\<ExplicitRungeKutta\>\""}], ",", 
       " ", 
       RowBox[{"PrecisionGoal", " ", "->", " ", "12"}], ",", " ", 
       RowBox[{"AccuracyGoal", " ", "->", " ", "14"}]}], "]"}], "[", "length",
      "]"}], "[", "\n", "  ", "\"\<ProbabilitiesList\>\"", "]"}]}], 
  ";"}]}], "Input", "HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[34]:= ",
 CellID->1207491739,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"finalPopulations", "[", 
           RowBox[{"5", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "drag", ",", " ", "0", ",", " ", "8"}], 
             "}"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
