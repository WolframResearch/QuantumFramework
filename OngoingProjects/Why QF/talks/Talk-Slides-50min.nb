Cell[TextData[{
 "Coordinates that do not commute, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Mu]", "TI"]], ",", 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Nu]", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 ", yet keep Lorentz symmetry. Declare the algebra once and test its \
Casimir."
}], "Text",
 CellID->793802945,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eta", "[", 
    RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"m", " ", "+", " ", "1"}], ",", " ", 
      RowBox[{"n", " ", "+", " ", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MGen", "[", 
    RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"m", " ", "==", " ", "n"}], ",", " ", "0", ",", " ", 
     RowBox[{"m", " ", "<", " ", "n"}], ",", " ", 
     RowBox[{"M", "[", 
      RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", "True", ",", " ", 
     RowBox[{"-", 
      RowBox[{"M", "[", 
       RowBox[{"n", ",", " ", "m"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gen", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"x", "[", "m", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"M", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", 
          RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xxRel", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"x", "[", "n", "]"}], ",", " ", 
         RowBox[{"x", "[", "m", "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"a", "^", "2"}], " ", 
        RowBox[{"M", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mxRel", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", 
         RowBox[{"x", "[", "r", "]"}]}], "]"}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"x", "[", "m", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"x", "[", "n", "]"}]}]}], ")"}]}]}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mmRel", " ", "=", " ", 
   RowBox[{"Replace", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "n"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", 
             RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
          "]"}], ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m_", ",", " ", "n_"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r_", ",", " ", "s_"}], "}"}]}], "}"}], " ", ":>", " ", 
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"r", ",", " ", "s"}], "]"}], ",", " ", 
         RowBox[{"M", "[", 
          RowBox[{"m", ",", " ", "n"}], "]"}]}], "]"}], " ", "+", "\n", 
       "     ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"m", ",", " ", "s"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "s"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"n", ",", " ", "s"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "s"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}]}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"alg", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", "gen", "}"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"xxRel", ",", " ", "mxRel", ",", " ", "mmRel"}], "]"}]}], ",",
       " ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"{", "a", "}"}]}]}], "|>"}], "]"}]}], ";"}]}], "Input", \
"HiddenMaterial",
 CellOpen->False,
 CellLabel->"In[31]:= ",
 CellID->631769182,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"C1", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "[", 
       RowBox[{"m", ",", " ", "m"}], "]"}], " ", 
      RowBox[{"eta", "[", 
       RowBox[{"n", ",", " ", "n"}], "]"}], " ", 
      RowBox[{
       RowBox[{"MGen", "[", 
        RowBox[{"m", ",", " ", "n"}], "]"}], " ", "**", " ", 
       RowBox[{"MGen", "[", 
        RowBox[{"m", ",", " ", "n"}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"xSq", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "[", 
       RowBox[{"m", ",", " ", "m"}], "]"}], " ", 
      RowBox[{
       RowBox[{"x", "[", "m", "]"}], " ", "**", " ", 
       RowBox[{"x", "[", "m", "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Union", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NonCommutativeExpand", "[", 
       RowBox[{
        RowBox[{"Commutator", "[", 
         RowBox[{
          RowBox[{"xSq", " ", "-", " ", 
           RowBox[{
            RowBox[{"a", "^", "2"}], " ", "C1"}]}], ",", " ", 
          RowBox[{"x", "[", "r", "]"}]}], "]"}], ",", " ", "alg"}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ",", 
   "\n", " ", 
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NonCommutativeExpand", "[", 
        RowBox[{
         RowBox[{"Commutator", "[", 
          RowBox[{
           RowBox[{"xSq", " ", "-", " ", 
            RowBox[{
             RowBox[{"a", "^", "2"}], " ", "C1"}]}], ",", " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"r", ",", " ", "s"}], "]"}]}], "]"}], ",", " ", "alg"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", 
         RowBox[{"r", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
      "]"}]}]}], ",", "\n", " ", 
   RowBox[{"NonCommutativeExpand", "[", 
    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"xSq", ",", " ", 
       RowBox[{"x", "[", "0", "]"}]}], "]"}], ",", " ", "alg"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[32]:= ",
 CellID->1873681340,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell[TextData[{
 Cell[BoxData[
