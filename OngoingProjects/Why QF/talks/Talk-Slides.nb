 CellTags->"SlideShowHeader",
 CellID->1859711813,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell["2.1 The crossover in one picture", "Subsection",
 CellID->1348896709,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell["\<\
Rabi frequency and slowest decay rate against measurement strength.\
\>", "Text",
 CellID->1427211115,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"r", "^", "2"}]}], "]"}]}], ",", " ", 
     RowBox[{"r", " ", "-", " ", 
      RowBox[{"Re", "@", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", "-", " ", "1"}], "]"}]}]}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "1", "}"}], ",", " ", "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Rabi frequency / \[CapitalOmega]\>\"", ",", 
      " ", "\"\<slowest decay rate / \[CapitalOmega]\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<k/\[CapitalOmega]\>\"", ",", 
      " ", "\"\<Liouvillian eigenvalue / \[CapitalOmega]\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->2099805207,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell[TextData[{
 "Watching harder speeds relaxation only up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc1606-c22d-409d-5f43-8863f7d812e7"],
 "; past it the qubit freezes."
}], "Text",
 CellID->1402006442,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1901179466,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell["Example 2.2: the Mollow triplet and squeezed fluorescence", "Subsection",
 CellID->210724908,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[TextData[{
 "Two-time correlations run on the same Liouvillian as the state, so a \
spectrum is one linear solve per frequency; at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 " the trace condition picks the physical branch."
}], "Text",
 CellID->1992790374,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lower", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"X", " ", "-", " ", 
      RowBox[{"I", " ", "Y"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"steady", "[", 
    RowBox[{"H_", ",", " ", "leaks_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"First", "@", 
          RowBox[{"NullSpace", "[", 
           RowBox[{"liouvillian", "[", 
            RowBox[{"H", ",", " ", "leaks", ",", " ", "2"}], "]"}], "]"}]}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"v", "/", 
      RowBox[{"Tr", "[", "v", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resolventSpectrum", "[", 
    RowBox[{
    "big_", ",", " ", "seedMat_", ",", " ", "readout_", ",", " ", "tones_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "big", "]"}]}], ",", " ", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "readout", "]"}]}]}], "}"}], ",", "\n", "   ", 
     
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{"readout", " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", "w", "]"}], " ", "<", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], ",", "\n", "       ", 
               RowBox[{"LeastSquares", "[", 
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"N", "[", 
                    RowBox[{"-", "big"}], "]"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"1.", " ", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], 
                    "}"}]}], "]"}], ",", " ", 
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"Flatten", "[", "seedMat", "]"}], ",", " ", 
                   RowBox[{"{", "0.", "}"}]}], "]"}]}], "]"}], ",", "\n", 
               "       ", 
               RowBox[{"LinearSolve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"I", " ", "w", " ", 
                   RowBox[{"IdentityMatrix", "[", "n", "]"}]}], " ", "-", " ",
                   "big"}], ",", " ", 
                 RowBox[{"Flatten", "[", "seedMat", "]"}]}], "]"}]}], "]"}], ",",
              " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}]}]}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "tones"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[14]:= ",
 CellID->292747604,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell["Steady state and spectrum come from the same generator.", "Text",
 CellID->1553818268,ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1870754514,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell["2.2 Weak against strong drive", "Subsection",
 CellID->1358728755,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell["\<\
The inelastic fluorescence spectrum of a resonantly driven atom.\
\>", "Text",
 CellID->935019337,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mollow", "[", 
    RowBox[{"om_", ",", " ", "tones_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"big", " ", "=", " ", 
        RowBox[{"liouvillian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", "lower", "}"}], ",", " ", "2"}], "]"}]}], ",", " ", 
       RowBox[{"rss", " ", "=", " ", 
        RowBox[{"steady", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", "lower", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dm", " ", "=", " ", 
         RowBox[{"lower", " ", "-", " ", 
          RowBox[{
           RowBox[{"Tr", "[", 
            RowBox[{"lower", " ", ".", " ", "rss"}], "]"}], " ", "id2"}]}]}], 
        "}"}], ",", " ", 
       RowBox[{"resolventSpectrum", "[", 
        RowBox[{"big", ",", " ", 
         RowBox[{"dm", " ", ".", " ", "rss"}], ",", " ", 
         RowBox[{"ConjugateTranspose", "[", "dm", "]"}], ",", " ", "tones"}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tones", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "9"}], ",", " ", "9", ",", " ", "0.05"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"weak", ",", " ", "strong"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"mollow", "[", 
      RowBox[{"#", ",", " ", "tones"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.6", ",", " ", "6."}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"weak", "/", 
         RowBox[{"Max", "[", "weak", "]"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"strong", "/", 
         RowBox[{"Max", "[", "strong", "]"}]}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalOmega] = 0.6\[Gamma]\>\"", ",", 
      " ", "\"\<\[CapitalOmega] = 6\[Gamma]\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency - drive frequency\>\"", ",", 
      " ", "\"\<inelastic spectrum (scaled to peak)\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[15]:= ",
 CellID->642744358,ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell[TextData[{
 "Strong driving dresses the atom and splits one line into three, with \
sidebands at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 "."
}], "Text",
 CellID->1478372881,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->124263719,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell["2.2 Homodyne noise at zero frequency", "Subsection",
 CellID->1310926461,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[TextData[{
 "Compare the numerical homodyne spectrum with the closed form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "+", "8", 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", 
    SuperscriptBox["\[CapitalOmega]", "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "+", "2", 
      SuperscriptBox["\[CapitalOmega]", "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 "."
}], "Text",
 CellID->1124211690,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"homodyneS0", "[", "om_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"big", " ", "=", " ", 
        RowBox[{"liouvillian", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", "lower", "}"}], ",", " ", "2"}], "]"}]}], ",", " ", 
       RowBox[{"rss", " ", "=", " ", 
        RowBox[{"steady", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"om", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
          RowBox[{"{", "lower", "}"}]}], "]"}]}], ",", " ", "cth", ",", " ", 
       "mq"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"cth", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "lower"}]}], ";", " ", 
      RowBox[{"mq", " ", "=", " ", 
       RowBox[{"cth", " ", "+", " ", 
        RowBox[{"ConjugateTranspose", "[", "cth", "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"First", "@", 
        RowBox[{"resolventSpectrum", "[", 
         RowBox[{"big", ",", " ", 
          RowBox[{
           RowBox[{"cth", " ", ".", " ", "rss"}], " ", "+", " ", 
           RowBox[{"rss", " ", ".", " ", 
            RowBox[{"ConjugateTranspose", "[", "cth", "]"}]}], " ", "-", " ", 
           
           RowBox[{
            RowBox[{"Re", "@", 
             RowBox[{"Tr", "[", 
              RowBox[{"mq", " ", ".", " ", "rss"}], "]"}]}], " ", "rss"}]}], ",",
           "\n", "      ", 
          RowBox[{"mq", " ", "-", " ", 
           RowBox[{
            RowBox[{"Re", "@", 
             RowBox[{"Tr", "[", 
              RowBox[{"mq", " ", ".", " ", "rss"}], "]"}]}], " ", "id2"}]}], ",",
           " ", 
          RowBox[{"{", "0.", "}"}]}], "]"}]}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"homodyneS0", "[", "om", "]"}], " ", "-", " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"8", " ", 
         RowBox[{"om", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", " ", 
             RowBox[{"om", "^", "2"}]}], " ", "-", " ", "1"}], ")"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{"om", "^", "2"}]}]}], ")"}], "^", "3"}]}]}]}], ")"}]}], 
     "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"om", ",", " ", "0.05", ",", " ", "1.2", ",", " ", "0.05"}], 
     "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[16]:= ",
 CellID->1335749844,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell["The two agree to machine precision.", "Text",
