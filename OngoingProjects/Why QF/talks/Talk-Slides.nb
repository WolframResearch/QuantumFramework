 CellID->1680570408,ExpressionUUID->"68379bed-79e9-22be-19cc-12b77f9c7084"],

Cell[TextData[{
 StyleBox["One isometry, three readings.",
  FontWeight->"Bold"],
 " The extra index of a Stinespring isometry can be kept, traced, or read."
}], "Item",
 CellID->475458560,ExpressionUUID->"460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],

