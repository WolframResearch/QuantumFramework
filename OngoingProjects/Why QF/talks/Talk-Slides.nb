Cell["3.1 Back to It\[OHat] form", "Subsection",
 CellID->1088734259,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell["\<\
Convert the Stratonovich process to It\[OHat] form and compare with the \
Lindblad drift plus the readout row.\
\>", "Text",
 CellID->476175344,ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"rs", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", ">=", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"rs", "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", ">=", " ", "0"}]}], "}"}], ",", 
   " ", 
   RowBox[{"FullSimplify", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"ItoProcess", "[", 
         RowBox[{"StratonovichProcess", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"driftStrat", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
                "}"}], ",", " ", "rs"}], "]"}], ",", " ", 
             RowBox[{"List", " ", "/@", " ", 
              RowBox[{"diffStrat", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
                 "}"}], ",", " ", "rs"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
              "}"}]}], "}"}], ",", "\n", "       ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], 
              "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"x0", ",", " ", "y0", ",", " ", "z0", ",", " ", "q0"}], 
              "}"}]}], "}"}], ",", " ", "t"}], "]"}], "]"}], 
        "[", "\"\<Drift\>\"", "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], " ", "->", " ", "x"}], ",", " ", 
         RowBox[{
          RowBox[{"y", "[", "t", "]"}], " ", "->", " ", "y"}], ",", " ", 
         RowBox[{
          RowBox[{"z", "[", "t", "]"}], " ", "->", " ", "z"}], ",", " ", 
         RowBox[{
          RowBox[{"q", "[", "t", "]"}], " ", "->", " ", "q"}]}], "}"}]}], 
      ")"}], "\n", "   ", "==", " ", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"driftIto", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
         "rs"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"rs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "z"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->201272189,ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
