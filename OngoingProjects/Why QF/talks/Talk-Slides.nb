Cell["3.2 State as a function of the record", "Subsection",
 CellID->15883883,ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell[TextData[{
 "Drive and relaxation off: test ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["arctanh",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["z", "TI"], "0"], "+", 
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
    StyleBox["Q", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 " along the path."
}], "Text",
 CellID->308842859,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rG", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.352", ",", " ", "0.", ",", " ", "0.176", ",", " ", "0.", ",", " ", 
       "0.", ",", " ", "0."}], "}"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"trG", " ", "=", " ", 
        RowBox[{"oneTraj", "[", 
         RowBox[{"rG", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "0.6", ",", " ", "0."}], 
           "}"}], ",", " ", "3.", ",", " ", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"40", " ", "0.352"}], ")"}]}], ",", " ", "11"}], "]"}]}], 
       ",", " ", 
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"0.", ",", " ", "3.", ",", " ", "1000"}], "]"}]}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"Max", "@", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"trG", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "[", "s", "]"}], " ", "-", " ", 
        RowBox[{"Tanh", "[", 
         RowBox[{
          RowBox[{"ArcTanh", "[", "0.6", "]"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"rG", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"trG", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "[", "s", "]"}]}]}], "]"}]}], 
       "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1108042358,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

