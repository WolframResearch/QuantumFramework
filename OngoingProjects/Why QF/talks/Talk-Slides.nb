 CellID->1950243504,ExpressionUUID->"4fe4a286-576e-fd11-759b-3be06218c47b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
