Cell["\<\
Example 2.1: the quantum Zeno crossover as an exceptional point\
\>", "Subsection",
 CellID->2099309037,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell["Pauli matrices and the Liouvillian of a Lindblad equation.", "Text",
 CellID->512383039,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"id2", ",", " ", "X", ",", " ", "Y", ",", " ", "Z"}], "}"}], " ", 
   "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"liouvillian", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", "d_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"id", " ", "=", " ", 
       RowBox[{"IdentityMatrix", "[", "d", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"H", ",", " ", "id"}], "]"}], " ", "-", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"id", ",", " ", 
           RowBox[{"Transpose", "[", "H", "]"}]}], "]"}]}], ")"}]}], " ", "+",
       "\n", "    ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Conjugate", "[", "c", "]"}]}], "]"}], " ", "-", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", " ",
                  "c"}], ",", " ", "id"}], "]"}], " ", "+", "\n", 
              "           ", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"id", ",", " ", 
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", 
                  " ", "c"}], "]"}]}], "]"}]}], ")"}], "/", "2"}]}]}], "]"}], 
        " ", "/@", " ", "leaks"}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[10]:= ",
 CellID->273308241,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["One function covers every example in this topic.", "Text",
 CellID->1809098798,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
