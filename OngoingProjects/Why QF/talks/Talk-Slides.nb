Cell["15.2 A channel and a measurement", "Subsection",
 CellID->1693391218,ExpressionUUID->"52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],

Cell["\<\
A list read as Kraus operators, and a list read as POVM effects.\
\>", "Text",
 CellID->819462336,ExpressionUUID->"133f88c9-4e43-c7a8-42c4-21936bf7adf2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ch", " ", "=", " ", 
   RowBox[{"QuantumChannel", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"3", "/", "4"}], "]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "/", "4"}], "]"}], " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "/", "4"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "4"}], ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Normal", "@", 
    RowBox[{
     RowBox[{"ch", "[", 
      RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}]}], ",", " ", 
   RowBox[{"ch", "[", "\"\<TracePreservingQ\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"m", "[", 
     RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "]"}], 
    "[", "\"\<ProbabilitiesList\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[90]:= ",
 CellID->1116629832,ExpressionUUID->"525bf512-066b-f79b-0278-ed5cb31fdde1"],

Cell["\<\
The same kind of data becomes a trace-preserving channel or a set of Born \
probabilities, depending on how it is read.\
\>", "Text",
 CellID->871366443,ExpressionUUID->"7020b0a8-e1ec-de26-21df-29f5979ea50c"],

