Cell[BoxData[{
 RowBox[{
  RowBox[{"algK", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"x", "[", "m", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
        "}"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Commutator", "[", 
             RowBox[{
              RowBox[{"x", "[", "i", "]"}], ",", " ", 
              RowBox[{"x", "[", "0", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"I", "/", "k"}], " ", 
             RowBox[{"x", "[", "i", "]"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Commutator", "[", 
             RowBox[{
              RowBox[{"x", "[", "j", "]"}], ",", " ", 
              RowBox[{"x", "[", "i", "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", 
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
           "]"}]}]}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "k", "}"}], ",", " ", "as", ",", " ", "bs"}], "]"}]}]}],
      "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"NonCommutativeExpand", "[", 
        RowBox[{
         RowBox[{"bch4", "[", 
          RowBox[{
           RowBox[{"I", " ", "ax"}], ",", " ", 
           RowBox[{"I", " ", "bx"}]}], "]"}], ",", " ", "algK"}], "]"}], ",", 
       " ", 
       RowBox[{"x", "[", "m", "]"}]}], "]"}], "/", "I"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "Input",\

 CellLabel->"In[60]:= ",
 CellID->600867794,ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell["\<\
Spatial momenta pick up a term that flips sign under exchange: two \
Lorentz-compatible deformations with different multi-particle physics.\
\>", "Text",
 CellID->570648126,ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1943045306,ExpressionUUID->"45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],

Cell["9.2 The minimal length", "Subsection",
 CellID->1695469705,ExpressionUUID->"70e98525-204e-6ba4-2096-1c8f51fb398e"],

Cell[TextData[{
 "The deformed uncertainty relation ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], "\[GreaterEqual]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "\[CapitalDelta]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", "\[CapitalDelta]", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 "."
}], "Text",
 CellID->808446663,ExpressionUUID->"7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"a", " ", ">", " ", "0"}], ",", " ", 
   RowBox[{
    RowBox[{"Minimize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"a", "^", "2"}], " ", 
            RowBox[{"dp", "^", "2"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "dp"}], ")"}]}], ",", " ", 
        RowBox[{"dp", " ", ">", " ", "0"}]}], "}"}], ",", " ", "dp"}], "]"}], 
    " ", "//", " ", "FullSimplify"}]}], "]"}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->843355028,ExpressionUUID->"62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["min",
     FontSlant->"Plain"]], "=", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 ": no event can be localized below the algebra's length."
}], "Text",
 CellID->2123001010,ExpressionUUID->"15938457-0322-a4d9-43a0-1e11b6d40e23"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1415208481,ExpressionUUID->"7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],

Cell["\<\
10. Breaking Elliptic-Curve Cryptography: Shor's Algorithm for secp256k1\
\>", "Section",
 CellID->80082845,ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell["\<\
How close is a quantum computer to stealing a Bitcoin key? Shor's \
discrete-log algorithm on a toy curve, then the resource arithmetic behind \
Google's 2026 estimates.\
\>", "Text",
 CellID->730828669,ExpressionUUID->"6e766a94-5ec6-6187-160d-83de5b7333ed"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->20229285,ExpressionUUID->"2eead67c-41e5-1519-56e9-c82677907c63"],

Cell["What to notice", "Subsection",
 CellID->865532999,ExpressionUUID->"23a655ec-dad2-e192-515e-4cc9df64b3f8"],

Cell[TextData[{
 StyleBox["Point addition is a permutation unitary,",
  FontWeight->"Bold"],
 " exactly like modular multiplication in factoring; the discrete log needs \
two registers, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["a", "TI"], 
   StyleBox["G", "TI"], "+", 
   StyleBox["b", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],
 "."
}], "Item",
 CellID->1719354248,ExpressionUUID->"7d6c313b-6800-4a9b-2b13-a96509b518e1"],

Cell[TextData[{
 StyleBox["Real cryptography in the same language.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"GenerateAsymmetricKeyPair", "[", "\"\<EllipticCurve\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 " uses secp256k1 by default."
}], "Item",
 CellID->803807756,ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

Cell[TextData[{
 StyleBox["Precision is a theorem.",
  FontWeight->"Bold"],
 " Continued fractions recover ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c3fefb-2ee6-8038-4df0-f7a54a90d302"],
 " only when ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    StyleBox["t", "TI"]], "\[GreaterEqual]", "2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d4995f-bb7f-b80c-10eb-11193e0b0b56"],
 "."
}], "Item",
 CellID->601042471,ExpressionUUID->"64608bbe-760c-8af3-0c1f-22f803bed8d9"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2038927162,ExpressionUUID->"09661063-a2cf-675e-3f1d-8a4cd77a4da4"],

Cell["What to notice (continued)", "Subsection",
 CellID->1188205371,ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell[TextData[{
 StyleBox["What Google optimized",
  FontWeight->"Bold"],
 " is the reversible point-addition circuit, not the algorithm: windowed \
arithmetic and measurement-based uncomputation."
}], "Item",
 CellID->1003860385,ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"],

Cell[TextData[{
 StyleBox["Two hardware roads.",
  FontWeight->"Bold"],
 " Superconducting qubits for minutes-long attacks on transactions in flight, \
or neutral atoms with qLDPC codes for days-long attacks on dormant wallets."
}], "Item",
 CellID->952137231,ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1052272830,ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell["Example 10.1: Shor's discrete log on a toy curve", "Subsection",
 CellID->775731387,ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell[TextData[{
 "Elliptic-curve arithmetic over GF(p), with ",
 Cell[BoxData["O"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3760e9-4a32-92b2-4acd-79b36fc4e098"],
 " the point at infinity, by pattern-matched dispatch."
}], "Text",
 CellID->975612517,ExpressionUUID->"14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{"O", ",", " ", "q_"}], "]"}], " ", ":=", " ", "q"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{"q_", ",", " ", "O"}], "]"}], " ", ":=", " ", "q"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"EllipticCurve", "[", 
       RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
      "[", "\"\<Add\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x_", ",", " ", "y1_"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x_", ",", " ", "y2_"}], "}"}]}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"y1", " ", "+", " ", "y2"}], ",", " ", "p"}], "]"}], " ", "==",
      " ", "0"}]}], " ", ":=", " ", "O"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"x", "^", "2"}]}], " ", "+", " ", "a"}], ")"}], " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{
            RowBox[{"2", " ", "y"}], ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "p"}], "]"}]}], ",", " ", "p"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xr", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "2"}], " ", "-", " ", 
            RowBox[{"2", " ", "x"}]}], ",", " ", "p"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"xr", ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "xr"}], ")"}]}], " ", "-", " ", 
            "y"}], ",", " ", "p"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1_", ",", " ", "y1_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x2_", ",", " ", "y2_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{
            RowBox[{"x2", " ", "-", " ", "x1"}], ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "p"}], "]"}]}], ",", " ", "p"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xr", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "2"}], " ", "-", " ", "x1", " ", "-", " ", 
            "x2"}], ",", " ", "p"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"xr", ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{"x1", " ", "-", " ", "xr"}], ")"}]}], " ", "-", " ", 
            "y1"}], ",", " ", "p"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"_", ",", " ", "0"}], "]"}], " ", ":=", " ", "O"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"pt_", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"add", " ", "=", " ", 
       RowBox[{
        RowBox[{"EllipticCurve", "[", 
         RowBox[{"a", ",", " ", "b", ",", " ", "p"}], "]"}], 
        "[", "\"\<Add\>\"", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Fold", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"add", "[", 
             RowBox[{"#1", ",", " ", "#1"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#2", " ", "==", " ", "1"}], ",", " ", 
            RowBox[{"add", "[", 
             RowBox[{"d", ",", " ", "pt"}], "]"}], ",", " ", "d"}], "]"}]}], 
         "]"}], " ", "&"}], ",", " ", "O", ",", " ", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EllipticCurve", "[", 
     RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
    "[", "\"\<Points\>\"", "]"}], " ", ":=", " ", 
   RowBox[{"Catenate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rhs", " ", "=", " ", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "^", "3"}], " ", "+", " ", 
             RowBox[{"a", " ", "x"}], " ", "+", " ", "b"}], ",", " ", "p"}], 
           "]"}]}], "}"}], ",", "\n", "     ", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"p", " ", "-", " ", "1"}]}], "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"#", "^", "2"}], ",", " ", "p"}], "]"}], " ", "==", 
               " ", "rhs"}], " ", "&"}]}], "]"}]}], "}"}], "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", 
        RowBox[{"p", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[62]:= ",
 CellID->105335494,ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"],

Cell["Addition, doubling and scalar multiplication in a few rules.", "Text",
 CellID->1276006902,ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->429330924,ExpressionUUID->"35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],

Cell["10.1 The curve and the public key", "Subsection",
 CellID->699653744,ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["y", "TI"], "2"], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], "+", 
   StyleBox["x", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00abf1cf-696b-3507-30a8-e8a9081f9c6d"],
 " over GF(23), a generator ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d898fe-d35a-9eef-31e7-11bbe6ece435"],
 ", its order ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03dda600-4b0b-c3af-31e2-386a6ebf91f5"],
 ", and a public key ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Q", "TI"], "=", "7", 
   StyleBox["G", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de38b79-ee67-8bee-7b90-23228b13d934"],
 "."
}], "Text",
 CellID->2118070064,ExpressionUUID->"347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ec", " ", "=", " ", 
   RowBox[{"EllipticCurve", "[", 
    RowBox[{"1", ",", " ", "1", ",", " ", "23"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pts", " ", "=", " ", 
   RowBox[{"ec", "[", "\"\<Points\>\"", "]"}]}], ";", " ", 
  RowBox[{"r", " ", "=", " ", 
   RowBox[{
    RowBox[{"Length", "[", "pts", "]"}], " ", "+", " ", "1"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"pts", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
            RowBox[{"#", ",", " ", "k"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "0", ",", " ", 
             RowBox[{"r", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}]}], " ", "==",
        " ", "r"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Q", " ", "=", " ", 
   RowBox[{
    RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"G", ",", " ", "7"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"r", ",", " ", "G", ",", " ", "Q"}], "}"}]}], "Input",
 CellLabel->"In[63]:= ",
 CellID->1744932242,ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],

Cell[TextData[{
 "The attacker knows ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 ", ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
