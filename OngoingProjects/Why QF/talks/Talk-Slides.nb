Cell["Example 14.2: squeezed pairs", "Subsection",
 CellID->1735539757,ExpressionUUID->"71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],

Cell[TextData[{
 "Opposite squeezers and a balanced splitter, with ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d94734f-f5fd-5b1e-3bac-6b2883882664"],
 " symbolic."
}], "Text",
 CellID->913947365,ExpressionUUID->"4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"symbolicPair", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "r", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", 
        RowBox[{"-", "r"}], "]"}], " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"Pi", "/", "4"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"symbolicPair", "[", 
        RowBox[{"\"\<Probability\>\"", ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"n", ",", " ", "n"}], "}"}]}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"r", " ", ">", " ", "0"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"symbolicPair", "[", 
      RowBox[{"\"\<Probability\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "0"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"r", " ", ">", " ", "0"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[84]:= ",
 CellID->33048482,ExpressionUUID->"08e3a6ae-198b-2f89-3890-3f08983e75d3"],

Cell[TextData[{
 "Photons come only in pairs, with the geometric law ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["r", "TI"], 
   SuperscriptBox[
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"2", 
     StyleBox["n", "TI"]}]], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ff9e3d-196e-b566-2d84-106798181c4c"],
 ": a two-mode squeezed vacuum."
}], "Text",
 CellID->1913442451,ExpressionUUID->"7611561e-6aa4-cbf1-1e2f-48580f5699db"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1066460469,ExpressionUUID->"6d91ad73-9dce-768e-1bae-453d147b5cd4"],

Cell["14.2 Tunable four-photon suppression", "Subsection",
 CellID->1552927865,ExpressionUUID->"6bff65fb-5d0a-196c-1985-7ca554bf6bb6"],

Cell[TextData[{
 "The return amplitude of ",
 Cell[BoxData[
  TemplateBox[{"2,2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e58ca76-8595-5ac4-0667-ec302c20282e"],
 " on a splitter of angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a91809-3406-7705-3856-9253bdb35a6f"],
 ", and the reflectivities that kill it."
}], "Text",
 CellID->262489656,ExpressionUUID->"47ee4125-d524-d464-6d96-588edcd6bf4e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fourBS", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fa", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fourBS", "[", 
      RowBox[{"\"\<Amplitude\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fa", " ", "==", " ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"6", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}], ",", " ", 
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}], ",", 
   "\n", " ", 
   RowBox[{"R", " ", "/.", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"6", " ", "R", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "R"}], ")"}]}]}], " ", "==", " ", 
        "0"}], " ", "&&", " ", 
       RowBox[{"0", " ", "<", " ", "R", " ", "<", " ", "1"}]}], ",", " ", "R",
       ",", " ", "Reals"}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[85]:= ",
 CellID->409171113,ExpressionUUID->"1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],

Cell[TextData[{
 "Zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", "\[PlusMinus]", 
    SqrtBox["3"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 ": unlike HOM, four-photon cancellation needs an unbalanced splitter."
}], "Text",
 CellID->189753264,ExpressionUUID->"230fc3bf-d3e5-5aa5-5134-daf8e590288f"],

