Cell["9.1 The Casimir", "Subsection",
 CellID->124530881,ExpressionUUID->"5e81d752-d9a7-cf7a-06be-cf1fd8539240"],

Cell[TextData[{
 "Commute ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "-", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   SubscriptBox[
    StyleBox["C", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 " with every coordinate and generator, and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647a9320-5a37-336f-0c19-0a8a5fc381b5"],
 " alone with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b40e76-1aa6-da65-7d4b-a0309f50a94f"],
 "."
}], "Text",
 CellID->1312473818,ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"C1", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "[", 
       RowBox[{"m", ",", " ", "m"}], "]"}], " ", 
      RowBox[{"eta", "[", 
       RowBox[{"n", ",", " ", "n"}], "]"}], " ", 
      RowBox[{
       RowBox[{"MGen", "[", 
        RowBox[{"m", ",", " ", "n"}], "]"}], " ", "**", " ", 
       RowBox[{"MGen", "[", 
        RowBox[{"m", ",", " ", "n"}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"xSq", " ", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "[", 
       RowBox[{"m", ",", " ", "m"}], "]"}], " ", 
      RowBox[{
       RowBox[{"x", "[", "m", "]"}], " ", "**", " ", 
       RowBox[{"x", "[", "m", "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Union", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NonCommutativeExpand", "[", 
       RowBox[{
        RowBox[{"Commutator", "[", 
         RowBox[{
          RowBox[{"xSq", " ", "-", " ", 
           RowBox[{
            RowBox[{"a", "^", "2"}], " ", "C1"}]}], ",", " ", 
          RowBox[{"x", "[", "r", "]"}]}], "]"}], ",", " ", "alg"}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ",", 
   "\n", " ", 
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NonCommutativeExpand", "[", 
        RowBox[{
         RowBox[{"Commutator", "[", 
          RowBox[{
           RowBox[{"xSq", " ", "-", " ", 
            RowBox[{
             RowBox[{"a", "^", "2"}], " ", "C1"}]}], ",", " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"r", ",", " ", "s"}], "]"}]}], "]"}], ",", " ", "alg"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", 
         RowBox[{"r", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
      "]"}]}]}], ",", "\n", " ", 
   RowBox[{"NonCommutativeExpand", "[", 
    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"xSq", ",", " ", 
       RowBox[{"x", "[", "0", "]"}]}], "]"}], ",", " ", "alg"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[58]:= ",
 CellID->1627779716,ExpressionUUID->"7c7345dd-208f-a284-2401-5c87513bf0ee"],

Cell[TextData[{
 "The Casimir is central; the nonzero last entry is exactly the residue the \
",
 Cell[BoxData[
  RowBox[{"-", 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   SubscriptBox[
    StyleBox["C", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0121a537-2575-8479-30de-3d714c01ef43"],
 " term cancels."
}], "Text",
 CellID->294107029,ExpressionUUID->"7f325126-465a-e19d-26c2-488073ecb3e7"],

