  RowBox[{
   TemplateBox[{"2,2"},
    "Ket"], "\[Rule]", 
   TemplateBox[{"2,2"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a015340-38cc-91ca-7a3f-4b2ab97ee310"],
 " vanishes at two unbalanced reflectivities."
}], "Item",
