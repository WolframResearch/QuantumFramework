Cell["12.1 Scanning the DRAG coefficient", "Subsection",
 CellID->538455469,ExpressionUUID->"70d9e217-b7c7-416b-20e6-0450c27213b1"],

Cell["Leakage and transfer error at 8 ns.", "Text",
 CellID->266517012,ExpressionUUID->"29221b72-bc55-8ef4-58d1-933c35e1d4de"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"finalPopulations", "[", 
           RowBox[{"5", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "drag", ",", " ", "0", ",", " ", "8"}], 
             "}"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"drag", ",", " ", 
            RowBox[{"Total", "[", 
             RowBox[{"p", "[", 
              RowBox[{"[", 
               RowBox[{"3", " ", ";;"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"drag", ",", " ", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "}"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"drag", ",", " ", "0", ",", " ", "2", ",", " ", "0.1"}], 
       "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<leakage\>\"", ",", " ", "\"\<transfer error\>\""}], "}"}]}],
    ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Lambda]\>\"", ",", " ", "\"\<population\>\""}], "}"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[75]:= ",
 CellID->1190814367,ExpressionUUID->"41172bde-c012-830e-772c-c29bf1a4ee54"],

