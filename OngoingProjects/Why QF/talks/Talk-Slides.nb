Cell["13.2 Squeezed light", "Subsection",
 CellID->2004841178,ExpressionUUID->"4c057904-8649-af2b-743b-716e33fdf271"],

Cell["\<\
Two squeezed vacua on a balanced splitter, and the photon statistics of one \
squeezed vacuum.\
\>", "Text",
 CellID->680262370,ExpressionUUID->"2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "x1", "]"}], " ", "->", " ", "1"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"\"\<S\>\"", "[", "x2", "]"}], " ", "->", " ", "2"}], ",", 
       " ", 
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "4"}], ",", " ", "0"}], "]"}]}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<S\>\"", "[", "xi", "]"}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Probabilities\>\"", ",", " ", 
     RowBox[{"{", "0", "}"}], ",", " ", 
     RowBox[{"\"\<Cutoff\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"xi", " ", ">", " ", "0"}]}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[82]:= ",
 CellID->2074260939,ExpressionUUID->"340e6ec8-e38f-b030-5c35-8795963b031a"],

Cell["\<\
Coincidences vanish for equal squeezing and peak for opposite squeezing; a \
squeezed vacuum populates only even photon numbers.\
\>", "Text",
 CellID->1484886568,ExpressionUUID->"64bff79f-1679-3ebc-0c44-eed9a30d8486"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
