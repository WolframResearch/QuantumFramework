Cell[TextData[{
 "Each branch has norm ",
 Cell[BoxData[
  SqrtBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["m", "TI"]]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28081ee1-9923-6846-5837-97cb18d63aac"],
 ": branch, probability and conditional state are three distinct objects."
}], "Text",
 CellID->183385376,ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1323839713,ExpressionUUID->"4f8fdcfc-c987-8804-75b4-d5b9e833db6e"],

Cell["16. Why Boson Sampling Is Hard", "Section",
 CellID->1299720858,ExpressionUUID->"4bb02784-750c-cc73-794f-beee7cbe9759"],

Cell["\<\
Three tasks kept apart, computing one amplitude, collecting every \
probability, and drawing one sample, because the hardness argument lives in \
the gap between them.\
\>", "Text",
 CellID->513341225,ExpressionUUID->"6368bf1a-89ab-f709-1117-3744285fda53"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2063978445,ExpressionUUID->"18aa8291-c565-6e81-48a9-1bdaec1034eb"],

Cell["What to notice", "Subsection",
 CellID->124947567,ExpressionUUID->"0fb37437-3ad9-e813-3541-6e71bf6dbb79"],

Cell[TextData[{
 StyleBox["Three particle statistics, one table.",
  FontWeight->"Bold"],
 " Bosons (permanent), distinguishable particles (permanent of ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["W", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c235d7-86a4-1a63-5ff1-ac9133516949"],
 ") and fermions (determinant) on one splitter."
}], "Item",
 CellID->307500845,ExpressionUUID->"7c4bd199-468e-1df0-2448-c8c3733b67da"],

Cell[TextData[{
 StyleBox["The permanent derived, not postulated.",
  FontWeight->"Bold"],
 " Output amplitudes are coefficients of ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Product]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["j", "TI"],
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox[
        RowBox[{"j", "k"}], "TI"]], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["k", "TI"]]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5faac466-18c1-c293-05a9-de40997590f9"],
 "."
}], "Item",
 CellID->971031069,ExpressionUUID->"0b2a52a2-44e1-aebb-392a-4b0c6c95f481"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->959838422,ExpressionUUID->"146756d1-ea39-ec02-3c1d-4f9a8fcdb768"],

Cell["What to notice (continued)", "Subsection",
 CellID->1887610507,ExpressionUUID->"1a7ee52b-d767-0389-4a05-fd74e21251d3"],

Cell[TextData[{
 StyleBox["Cost depends on occupation structure.",
  FontWeight->"Bold"],
 " Collision-free and paired amplitudes grow exponentially with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419fd7e1-c297-cbe2-77a4-cecaf72399c8"],
 "; a fully bunched one stays essentially free."
}], "Item",
 CellID->1384833740,ExpressionUUID->"7a33ac2f-4fb5-380e-2bc0-45896a418b54"],

Cell[TextData[{
 StyleBox["Hard to compute is not hard to sample.",
  FontWeight->"Bold"],
 " Distinguishable photons have permanent probabilities yet sample trivially; \
the Aaronson-Arkhipov argument is what turns amplitude cost into sampling \
hardness."
}], "Item",
 CellID->1880473289,ExpressionUUID->"3b56b9eb-04f6-5b17-696d-30b5ac83267d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->117881571,ExpressionUUID->"6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],

Cell["Example 16.1: bosons, classical particles and fermions", "Subsection",
 CellID->372521314,ExpressionUUID->"7db41629-8d3d-b9f9-2b4b-887324c90bc3"],

Cell["Three probability rules on one balanced beam splitter.", "Text",
 CellID->1020330751,ExpressionUUID->"3f51d24b-32fb-3155-656e-d415468f83bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";", " ", 
  
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"modeList", "[", "occ_List", "]"}], " ", ":=", " ", 
   RowBox[{"Catenate", "@", 
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"First", "[", "#2", "]"}], ",", " ", "#1"}], "]"}], " ", 
       "&"}], ",", " ", "occ"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bosonProb", "[", 
    RowBox[{"w_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Permanent", "[", 
       RowBox[{"w", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"modeList", "[", "t", "]"}], ",", " ", 
          RowBox[{"modeList", "[", "s", "]"}]}], "]"}], "]"}], "]"}], "]"}], "^",
      "2"}], "/", 
    RowBox[{"Times", " ", "@@", " ", 
     RowBox[{"Factorial", "[", 
      RowBox[{"Join", "[", 
       RowBox[{"s", ",", " ", "t"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"distProb", "[", 
    RowBox[{"w_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Permanent", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", "w", "]"}], "^", "2"}], ")"}], "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"modeList", "[", "t", "]"}], ",", " ", 
        RowBox[{"modeList", "[", "s", "]"}]}], "]"}], "]"}], "]"}], "/", 
    RowBox[{"Times", " ", "@@", " ", 
     RowBox[{"Factorial", "[", "t", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fermionProb", "[", 
    RowBox[{"w_", ",", " ", "s_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"Det", "[", 
      RowBox[{"w", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"modeList", "[", "t", "]"}], ",", " ", 
         RowBox[{"modeList", "[", "s", "]"}]}], "]"}], "]"}], "]"}], "]"}], "^",
     "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Wbs", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{
          RowBox[{"Pi", "/", "4"}], ",", " ", "0"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", "2"}], "]"}],
     "[", "\"\<TransferMatrix\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Through", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bosonProb", ",", " ", "distProb", ",", " ", "fermionProb"}], 
      "}"}], "[", 
     RowBox[{"Wbs", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "t"}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[92]:= ",
 CellID->339737350,ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell["\<\
Bosons bunch, classical particles split, fermions antibunch: the only \
difference is the sign attached to exchanging two histories.\
\>", "Text",
 CellID->967879197,ExpressionUUID->"0aa19f46-928a-afd4-3a5e-1720273cf53e"],

