Cell["2.1 A watched, driven qubit, fully symbolic", "Subsection",
 CellID->724760089,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[TextData[{
 "A qubit Rabi-driven at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6815cd54-0cd7-196f-182a-e51ea5626bb5"],
 " while ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519775d4-d545-25f2-07ad-6c91dcf18fd8"],
 " is watched at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 "."
}], "Text",
 CellID->168408080,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell[BoxData[
 RowBox[{"Eigenvalues", "@", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"liouvillian", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", "k", "]"}], " ", "Z"}], "}"}], ",", " ", "2"}], 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"k", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->811283638,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell[TextData[{
 "The Rabi pair ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " oscillates for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 ", coalesces at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 ", and splits into two real rates beyond it."
}], "Text",
 CellID->207978548,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->437474228,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell["2.1 The Zeno freeze", "Subsection",
 CellID->874582697,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell["The slow rate at strong measurement.", "Text",
 CellID->11631581,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[BoxData[
 RowBox[{"Normal", "@", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "k"}], " ", "+", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"k", "^", "2"}], " ", "-", " ", 
       RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "Infinity", ",", " ", "1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1933762060,ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[TextData[{
 "Watching harder slows the qubit as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 "."
}], "Text",
 CellID->1055776787,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

