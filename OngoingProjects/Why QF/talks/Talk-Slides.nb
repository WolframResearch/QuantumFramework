Cell[TextData[{
 StyleBox["The exact algebra is checked symbolically, with all six rates \
symbolic.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"ItoProcess", "[", 
   RowBox[{"StratonovichProcess", "[", "...", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 " lands exactly on the Lindblad drift."
}], "Item",
 CellID->1921351195,ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[TextData[{
 StyleBox["A positivity condition derived, not assumed.",
  FontWeight->"Bold"],
 " The trajectory stays a density matrix if and only if ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "\[LessEqual]", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 "."
}], "Item",
 CellID->1207491739,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[TextData[{
 StyleBox["The record is the noise.",
  FontWeight->"Bold"],
 " Subtracting the integrated signal from the record returns the Wiener path \
that kicked the state."
}], "Item",
 CellID->216741342,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

