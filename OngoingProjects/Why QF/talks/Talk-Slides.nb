Cell["Example 4.1: squeezing below the zero-point, in closed form", \
"Subsection",
 CellID->767788723,ExpressionUUID->"57868ed1-450c-c474-7dbd-279b6cbeaf5e"],

Cell["\<\
The Riccati flow for the conditional covariances in a harmonic trap, its \
physical fixed point, and its determinant.\
\>", "Text",
 CellID->494419947,ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"riccati", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"Cc", "/", "m"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Lambda]", " ", 
       RowBox[{"Sx", "^", "2"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sp", "/", "m"}], " ", "-", " ", 
      RowBox[{"m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "Sx"}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Lambda]", " ", "Sx", " ", "Cc"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "Cc"}], " ", "+", " ", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"\[HBar]", "^", "2"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Lambda]", " ", 
       RowBox[{"Cc", "^", "2"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steady", " ", "=", " ", 
   RowBox[{
    RowBox[{"SolveValues", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"riccati", " ", "==", " ", "0"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"Sx", ",", " ", "Cc", ",", " ", "Sp"}], "}"}]}], "]"}], " ", "//",
     " ", "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"positiveQ", "[", "sol_", "]"}], " ", ":=", " ", 
   RowBox[{"TrueQ", "@", 
    RowBox[{"Resolve", "[", 
     RowBox[{
      RowBox[{"ForAll", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "m", ",", " ", "\[Lambda]", ",", " ", "\[Omega]", ",", " ", 
          "\[HBar]"}], "}"}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Omega]", " ", ">=", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[HBar]", " ", ">", " ", "0"}]}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "|", " ", 
            RowBox[{"sol", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}], " ", "\[Element]", " ", 
          "Reals"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", ">", " ", "0"}]}]}], "]"}], ",",
       " ", "Reals"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"SxSS", ",", " ", "CcSS", ",", " ", "SpSS"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"steady", ",", " ", "positiveQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"as", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[Omega]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"m", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"\[HBar]", " ", ">", " ", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SxSS", " ", "SpSS"}], " ", "-", " ", 
    RowBox[{"CcSS", "^", "2"}]}], ",", " ", "as"}], "]"}]}], "Input",
 CellLabel->"In[25]:= ",
 CellID->1581507689,ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[HBar]", "2"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 ": the steady conditional state is pure."
}], "Text",
 CellID->2120100675,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

