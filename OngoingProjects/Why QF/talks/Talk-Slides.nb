Cell["11.2 After the feedforward", "Subsection",
 CellID->1835967532,ExpressionUUID->"60858f89-56d8-6615-10ba-26d3636d4d7f"],

Cell["Fidelity of the data qubits with the ideal codeword.", "Text",
 CellID->965277466,ExpressionUUID->"2e45545e-c429-efe4-567b-4e1bedddb5ce"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{"as", ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{"coded", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"enc", "[", 
        RowBox[{"QuantumTensorProduct", "[", 
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
          RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}], ",",
        " ", "\"\<Fidelity\>\""}], "]"}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[72]:= ",
 CellID->1405388586,ExpressionUUID->"24564246-a2b2-7a9b-4c6e-6423d74748e1"],

