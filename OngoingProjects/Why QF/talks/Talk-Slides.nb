Cell["1.1 Four numbers against eight dimensions", "Subsection",
 CellID->762269937,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell["\<\
Compare the filter with the sector populations of the full conditional state.\
\
\>", "Text",
 CellID->405213039,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{"pFilter", " ", "-", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"r", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "@", 
           RowBox[{"Tr", "[", 
            RowBox[{"#", " ", ".", " ", "r"}], "]"}]}], " ", "&"}], " ", "/@",
          " ", "proj"}]}], "]"}], ",", " ", 
      RowBox[{"run", "[", "\"\<states\>\"", "]"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->2118931930,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell["\<\
They agree up to the finite-step difference between two discretizations of \
one continuous filter.\
\>", "Text",
 CellID->1039057480,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1411198270,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell["Example 1.2: exact protection by Markovian feedback", "Subsection",
 CellID->1703453532,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell["The averaged dynamics needs only the Liouvillian.", "Text",
 CellID->1477609488,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"liouvillian", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", "d_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"id", " ", "=", " ", 
       RowBox[{"IdentityMatrix", "[", "d", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"H", ",", " ", "id"}], "]"}], " ", "-", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"id", ",", " ", 
           RowBox[{"Transpose", "[", "H", "]"}]}], "]"}]}], ")"}]}], " ", "+",
       "\n", "    ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Conjugate", "[", "c", "]"}]}], "]"}], " ", "-", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", " ",
                  "c"}], ",", " ", "id"}], "]"}], " ", "+", "\n", 
              "           ", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"id", ",", " ", 
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", 
                  " ", "c"}], "]"}]}], "]"}]}], ")"}], "/", "2"}]}]}], "]"}], 
        " ", "/@", " ", "leaks"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evolve", "[", 
    RowBox[{"H_", ",", " ", "leaks_", ",", " ", "rho0_", ",", " ", "t_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Length", "[", "rho0", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"liouvillian", "[", 
           RowBox[{"H", ",", " ", "leaks", ",", " ", "d"}], "]"}], " ", "t"}],
          "]"}], " ", ".", " ", 
        RowBox[{"Flatten", "[", "rho0", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[7]:= ",
 CellID->1030824397,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[TextData[{
 Cell[BoxData["evolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 " exponentiates it acting on the vectorized density matrix."
}], "Text",
 CellID->100031176,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->144223354,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell["1.2 The code space is invariant, for every rate", "Subsection",
 CellID->1443527617,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell["\<\
Keep the error rate symbolic, build the feedback operators from the code \
projector, and check the two identities.\
\>", "Text",
 CellID->311511756,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"codeProj", " ", "=", " ", 
   RowBox[{"First", "[", "proj", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cs", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"op3", "[", 
        RowBox[{"X", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Range", "[", "3", "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"codeProj", " ", ".", " ", "#"}], " ", "-", " ", 
        RowBox[{"#", " ", ".", " ", "codeProj"}]}], ")"}]}], " ", "&"}], " ", 
    "/@", " ", "cs"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Simplify", "@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
          RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cs", ",", " ", "F"}], "}"}]}], "]"}]}]}]}], ",", "\n", " ", 
   
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", " ", ".", " ", "codeProj"}], ")"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"(", 
        RowBox[{"cs", " ", "-", " ", 
         RowBox[{"I", " ", "F"}]}], ")"}]}], "]"}]}]}]}], "}"}]}], "Input",
 CellLabel->"In[8]:= ",
 CellID->1381425643,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[TextData[{
 "Both lists are ",
 Cell[BoxData[
  RowBox[{"{", "0", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 ": ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], "+", 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["i", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["i", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox["\[CapitalPi]", 
    StyleBox[
     RowBox[{"c", "o", "d", "e"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 " for every ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 "."
}], "Text",
 CellID->377280352,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1717363484,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell["1.2 The price of an imperfect detector", "Subsection",
 CellID->1781880651,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell[TextData[{
 "Code-space population at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "15"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " with and without feedback, across detector efficiencies."
}], "Text",
 CellID->1536527082,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"codePop", "[", "e_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"cs", " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "gamma"}]}]}], ",", " ", 
       RowBox[{"f", " ", "=", " ", 
        RowBox[{"F", " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "gamma"}]}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Re", "@", 
      RowBox[{"Tr", "[", 
       RowBox[{"codeProj", " ", ".", " ", 
        RowBox[{"evolve", "[", 
         RowBox[{
          RowBox[{"0", " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], ",", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"c", " ", "-", " ", 
             RowBox[{"I", " ", "f"}]}], ",", " ", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", "e"}], ")"}], "/", "e"}], "]"}], " ",
              "f"}]}], "]"}], ",", "\n", "       ", 
          RowBox[{
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"#", ",", " ", "#"}], "]"}], " ", "&"}], "@", 
           RowBox[{"ket", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}], ",",
           " ", "15."}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bare", " ", "=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{"Tr", "[", 
     RowBox[{"codeProj", " ", ".", " ", 
      RowBox[{"evolve", "[", 
       RowBox[{
        RowBox[{"0", " ", 
         RowBox[{"IdentityMatrix", "[", "8", "]"}]}], ",", " ", 
        RowBox[{"cs", " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "gamma"}]}], ",", "\n", "     ", 
        
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"#", ",", " ", "#"}], "]"}], " ", "&"}], "@", 
         RowBox[{"ket", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}], ",", 
        " ", "15."}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.01", ",", " ", "0.03", ",", " ", "0.1", ",", " ", "0.3", ",", " ", 
     "0.6", ",", " ", "1."}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", " ", 
         RowBox[{"codePop", "[", "e", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "etas"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", " ", "bare"}], "}"}], " ", "&"}], " ", "/@", " ", 
      "etas"}]}], "}"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Markovian feedback\>\"", ",", " ", "\"\<no feedback\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<detector efficiency \[Eta]\>\"", ",", 
      " ", "\"\<code-space population at t = 15\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[9]:= ",
 CellID->1621535814,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 " the code space is held exactly; at low efficiency the loop feeds amplified \
detector noise back onto the qubits and does worse than no loop at all."
}], "Text",
 CellID->1193935837,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

