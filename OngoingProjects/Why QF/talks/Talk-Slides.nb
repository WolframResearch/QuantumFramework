 CellID->406066173,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[TextData[{
 "Expand ",
 Cell[BoxData[
  RowBox[{
   StyleBox["log",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["\[Alpha]", "TI"], "\[CenterDot]", 
      StyleBox["x", "TI"]}]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["i", "TI"], 
      StyleBox["\[Beta]", "TI"], "\[CenterDot]", 
      StyleBox["x", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],
 " to fourth order in the BCH series."
}], "Text",
 CellID->783505316,ExpressionUUID->"3873a668-04d7-31ac-6800-3832ad6383f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"as", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"al", "[", "m", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"bs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"be", "[", "m", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"algE", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", "gen", "}"}]}], ",", " ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"xxRel", ",", " ", "mxRel", ",", " ", "mmRel"}], "]"}]}], ",",
       "\n", "    ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "a", "}"}], ",", " ", "as", ",", " ", "bs"}], "]"}]}]}],
      "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bch4", "[", 
    RowBox[{"X_", ",", " ", "Y_"}], "]"}], " ", ":=", " ", 
   RowBox[{"X", " ", "+", " ", "Y", " ", "+", " ", 
    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"X", ",", " ", "Y"}], "]"}], "/", "2"}], " ", "+", "\n", "   ", 
    
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{"X", ",", " ", 
         RowBox[{"Commutator", "[", 
          RowBox[{"X", ",", " ", "Y"}], "]"}]}], "]"}], " ", "-", " ", 
       RowBox[{"Commutator", "[", 
        RowBox[{"Y", ",", " ", 
         RowBox[{"Commutator", "[", 
          RowBox[{"X", ",", " ", "Y"}], "]"}]}], "]"}]}], ")"}], "/", "12"}], 
    " ", "-", "\n", "   ", 
    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"Y", ",", " ", 
       RowBox[{"Commutator", "[", 
        RowBox[{"X", ",", " ", 
         RowBox[{"Commutator", "[", 
          RowBox[{"X", ",", " ", "Y"}], "]"}]}], "]"}]}], "]"}], "/", 
     "24"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ax", " ", "=", " ", 
   RowBox[{"as", " ", ".", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"x", "[", "m", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", 
  " ", 
  RowBox[{"bx", " ", "=", " ", 
   RowBox[{"bs", " ", ".", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"x", "[", "m", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"oplus", " ", "=", " ", 
   RowBox[{"Simplify", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"NonCommutativeExpand", "[", 
          RowBox[{
           RowBox[{"bch4", "[", 
            RowBox[{
             RowBox[{"I", " ", "ax"}], ",", " ", 
             RowBox[{"I", " ", "bx"}]}], "]"}], ",", " ", "algE"}], "]"}], ",",
          " ", 
         RowBox[{"x", "[", "m", "]"}]}], "]"}], "/", "I"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"oplus", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"oplus", " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{"oplus", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"al", " ", "->", " ", "be"}], ",", " ", 
         RowBox[{"be", " ", "->", " ", "al"}]}], "}"}]}], ")"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[59]:= ",
 CellID->1838581182,ExpressionUUID->"4156c81a-8a68-59d7-776d-e2442f1d2b3d"],

Cell[TextData[{
 "Snyder's ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
