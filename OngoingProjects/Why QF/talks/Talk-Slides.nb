Cell["13.1 Two splitters in a chain", "Subsection",
 CellID->758245071,ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell["\<\
A held sum over the internal photon number, checked against the concrete \
query.\
\>", "Text",
 CellID->645457834,ExpressionUUID->"43090fa7-5002-8b65-7136-a60161b4d64f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"th1", ",", " ", "ph1"}], "]"}], ",", " ", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"th2", ",", " ", "ph2"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Activate", "[", 
    RowBox[{
     RowBox[{"chain", "[", 
      RowBox[{"\"\<Amplitude\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "0"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", 
          RowBox[{"n", " ", "-", " ", "t"}]}], "}"}]}]}], "]"}], " ", "/.", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"t", " ", "->", " ", "1"}]}], "}"}]}], "]"}], " ", "-", "\n", 
   "  ", 
   RowBox[{"chain", "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[80]:= ",
 CellID->1053805191,ExpressionUUID->"0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],

Cell["Activated, the symbolic sum agrees exactly.", "Text",
 CellID->1335228883,ExpressionUUID->"4ac87485-b214-a6e0-7ac8-6deec7a60cca"],

