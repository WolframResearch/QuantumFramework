  "7c22b8c2-70f4-0562-25d1-31ac00816c48"],
 " through the Lorentz algebra."
}], "Text",
 CellID->9883570,ExpressionUUID->"04fec585-b88c-469b-2c85-dcef39392ce1"],

Cell[BoxData[
 RowBox[{"Union", "@", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NonCommutativeExpand", "[", 
       RowBox[{
        RowBox[{"Commutator", "[", 
         RowBox[{
          RowBox[{"MGen", "[", 
           RowBox[{"r", ",", " ", "s"}], "]"}], ",", " ", 
          RowBox[{"Commutator", "[", 
           RowBox[{
            RowBox[{"x", "[", "m", "]"}], ",", " ", 
            RowBox[{"x", "[", "n", "]"}]}], "]"}]}], "]"}], ",", " ", "alg"}],
        "]"}], " ", "-", "\n", "    ", 
      RowBox[{"I", " ", 
       RowBox[{"a", "^", "2"}], " ", "I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"eta", "[", 
           RowBox[{"s", ",", " ", "m"}], "]"}], " ", 
          RowBox[{"MGen", "[", 
           RowBox[{"r", ",", " ", "n"}], "]"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"eta", "[", 
           RowBox[{"s", ",", " ", "n"}], "]"}], " ", 
          RowBox[{"MGen", "[", 
           RowBox[{"r", ",", " ", "m"}], "]"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"eta", "[", 
           RowBox[{"r", ",", " ", "m"}], "]"}], " ", 
          RowBox[{"MGen", "[", 
           RowBox[{"s", ",", " ", "n"}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"eta", "[", 
           RowBox[{"r", ",", " ", "n"}], "]"}], " ", 
          RowBox[{"MGen", "[", 
           RowBox[{"s", ",", " ", "m"}], "]"}]}]}], ")"}]}]}], ",", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"r", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[57]:= ",
 CellID->940978275,ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],

