Cell["Example 14.1: the KLM nonlinear sign gate, exactly", "Subsection",
 CellID->338384234,ExpressionUUID->"48b830c7-d270-6a57-7847-a9a0e70538bd"],

Cell[TextData[{
 "A three-mode real unitary with one auxiliary photon; success is heralded by \
the auxiliary pattern ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f1d7f5-6807-0c72-128e-cebf09b25758"],
 "."
}], "Text",
 CellID->455054057,ExpressionUUID->"1e2af966-75ba-f15e-4629-f1407c4cc3a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";", " ", 
  
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"nsMatrix", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"3", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
       RowBox[{"1", "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"3", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "2", "]"}], " ", "-", " ", 
        RowBox[{"1", "/", "2"}]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nsGate", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", "nsMatrix", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"RootReduce", "[", 
     RowBox[{"nsMatrix", " ", ".", " ", 
      RowBox[{"Transpose", "[", "nsMatrix", "]"}]}], "]"}], " ", "==", " ", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", "\n", " ", 
   RowBox[{"RootReduce", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"nsGate", "[", 
       RowBox[{"\"\<Amplitude\>\"", ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
         
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "1", ",", " ", "0"}], "}"}]}]}], "]"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[83]:= ",
 CellID->1632384583,ExpressionUUID->"7fcb302b-9e92-9019-25c8-aa751b24e363"],

Cell[TextData[{
 "Amplitudes ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], ",", 
   FractionBox["1", "2"], ",", 
   RowBox[{"-", 
    FractionBox["1", "2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "361ba0ac-b25b-03c3-5e38-3909c7ee5129"],
 " for 0, 1, 2 signal photons: a sign flip on ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c5768f-9366-0c29-5efb-6fe926135773"],
 " alone, which no phase shifter can do, and the three-photon amplitude shows \
where the gate stops working."
}], "Text",
 CellID->1806839179,ExpressionUUID->"43fcd6d4-594a-1482-7183-cf9e58ff7ee8"],

