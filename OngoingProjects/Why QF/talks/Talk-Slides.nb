Cell["1.1 Syndrome probabilities in time", "Subsection",
 CellID->176337227,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["The filter's four probabilities over the whole run.", "Text",
 CellID->807053435,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", "pFilter", "]"}], ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "40"}], "}"}]}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<code\>\"", ",", " ", "\"\<X1 flipped\>\"", ",", 
      " ", "\"\<X2 flipped\>\"", ",", " ", "\"\<X3 flipped\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", " ", "\"\<syndrome probability\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1633675818,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["Certainty passes from sector to sector as flips accumulate.", "Text",
 CellID->1828793009,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

