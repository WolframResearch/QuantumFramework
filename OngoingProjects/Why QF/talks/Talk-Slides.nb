Cell["11. What Makes QuantumFramework Unique", "Section",
 CellID->1811399761,ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell["\<\
Seven claims, each argued by executed code: symbolic first, one object model \
for channels, POVMs, Fock space and phase space, measurement records as \
wires, three engines, ordinary Wolfram Language expressions, and a path to \
hardware.\
\>", "Text",
 CellID->417262126,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1077936938,ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],

Cell["What to notice", "Subsection",
 CellID->181325614,ExpressionUUID->"25f1a39a-81e0-db80-538e-3ac4379aa9ea"],

Cell[TextData[{
 StyleBox["Time-ordered propagators in closed form,",
  FontWeight->"Bold"],
 " including a Landau-Zener sweep in parabolic-cylinder functions."
}], "Item",
 CellID->2020910698,ExpressionUUID->"35466be2-b7a8-26dc-637d-82cfc2428c26"],

Cell[TextData[{
 StyleBox["Exact variational landscapes.",
  FontWeight->"Bold"],
 " QAOA on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bdea72-0ba3-5f4c-0842-0c3cae562596"],
 " gives a closed-form energy surface with a certified maximum."
}], "Item",
 CellID->661155756,ExpressionUUID->"6e8cef58-e908-949c-16b3-070588a2fee6"],

Cell[TextData[{
 StyleBox["One master-equation solution for every qubit,",
  FontWeight->"Bold"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abc4047-6c7b-4886-3a44-5a21050e1aec"],
 " as a theorem."
}], "Item",
 CellID->1040242161,ExpressionUUID->"24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->758481243,ExpressionUUID->"348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],

Cell["What to notice (continued)", "Subsection",
 CellID->607101385,ExpressionUUID->"2161c865-0900-0907-571e-e24fa8b5586d"],

Cell[TextData[{
 StyleBox["Breadth in one object model.",
  FontWeight->"Bold"],
 " Channels, SIC-POVMs, coherent states, ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["g", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], "2", 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 ", Wigner against Husimi, multiport interference, tomography."
}], "Item",
 CellID->718676885,ExpressionUUID->"31169419-f57b-983b-672d-0e42fc0feb01"],

Cell[TextData[{
 StyleBox["Measurement without collapse.",
  FontWeight->"Bold"],
 " A coherent error digitized into syndromes and corrected at fidelity \
exactly 1."
}], "Item",
 CellID->1099629263,ExpressionUUID->"40aa99e8-53bd-499c-70a9-10b266481be6"],

Cell[TextData[{
 StyleBox["Three engines, exact interconversion.",
  FontWeight->"Bold"],
 " State vector, tensor network and stabilizer tableau agreeing under ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d165407-aaf3-867b-0b2e-4e60ce87ed41"],
 "."
}], "Item",
 CellID->2120979663,ExpressionUUID->"75cb8946-a0dc-0da7-23c8-2123d169578d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->123468129,ExpressionUUID->"63688a50-35e7-99e6-1117-2c1a4393ebcc"],

Cell["What to notice (continued)", "Subsection",
 CellID->513893082,ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

Cell[TextData[{
 StyleBox["Language-level operators.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"],
 ", ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],
 ", ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "656925a1-dac3-d209-1316-bc0adf77a153"],
 " act on quantum objects; ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09e13884-5cc5-f650-3f9e-b1ee5571dcba"],
 " gives the Werner threshold ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "<", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29829495-262a-abaa-5fb1-0ddf53dcf9f0"],
 "."
}], "Item",
 CellID->1710240506,ExpressionUUID->"136212ad-a4c2-b9f3-4111-8bf6cd740bd9"],

Cell[TextData[{
 StyleBox["Out to hardware.",
  FontWeight->"Bold"],
 " OpenQASM 3 with exact angles, transpilation, and a GHZ run on IBM hardware."
}], "Item",
 CellID->1971880122,ExpressionUUID->"67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],

Cell[TextData[{
 StyleBox["An honest boundary.",
  FontWeight->"Bold"],
 " Where spectra are not solvable in radicals, QF returns ",
 Cell[BoxData["Root"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],
 " objects."
}], "Item",
 CellID->482876923,ExpressionUUID->"7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->257955902,ExpressionUUID->"2673b224-f5d9-a24c-4e00-2b81fc6df096"],

Cell["Example 11.1: the master equation solved once", "Subsection",
 CellID->1595709984,ExpressionUUID->"27388ee6-22a7-f122-4ec7-27c05753c008"],

Cell["\<\
A symbolic density matrix, symbolic relaxation and dephasing rates, and a \
symbolic drive.\
\>", "Text",
 CellID->1806165637,ExpressionUUID->"51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[CapitalOmega]", " ", "\[Element]", " ", "Reals"}], " ", "&&", 
    " ", 
    RowBox[{"t", " ", ">=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]m", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"Array", "[", 
     RowBox[{"\[Rho]", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", "\n", "   ", 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]1", "]"}], " ", "\[Sigma]m"}], ",", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Gamma]\[Phi]", "]"}], " ", 
        RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], "}"}], ",", 
     " ", "\[Rho]0", ",", " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FullSimplify", " ", "/@", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"\[Rho]t", "[", "\"\<Computational\>\"", "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], " ", "//", " ", 
  "MatrixForm"}]}], "Input",
 CellLabel->"In[68]:= ",
 CellID->1730622717,ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell[TextData[{
 "Populations relax at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7641b941-63e8-8619-1e7e-312b1582ed63"],
 "; coherences precess at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],
 " and decay at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "/", "2", "+", "2", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],
 "."
}], "Text",
 CellID->694790404,ExpressionUUID->"473593be-64fb-e664-6eca-0af80c8fcd4e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1833306836,ExpressionUUID->"79a8e286-b760-8808-2f57-fbe3c21adb52"],

Cell[TextData[{
 "11.1 ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
 " as a theorem"
}], "Subsection",
 CellID->1703418593,ExpressionUUID->"7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],

Cell["A statement about all admissible rates.", "Text",
 CellID->1263998950,ExpressionUUID->"36bb0aa4-099e-3511-5e58-a30ea8289c7b"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{"ForAll", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[Phi]"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}]}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Gamma]\[Phi]"}]}], ")"}]}], " ", "<=", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[69]:= ",
 CellID->1096868287,ExpressionUUID->"6fab4322-7f5b-c123-15a9-5a8c7aef9009"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559c0528-76f1-864e-03a3-9d720285ec94"],
 ", with equality exactly when pure dephasing vanishes."
}], "Text",
 CellID->152289512,ExpressionUUID->"4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
