Cell[BoxData[{
 RowBox[{
  RowBox[{"mx", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumMeasurementOperator", "[", "\"\<X\>\"", "]"}], "[", 
    RowBox[{"R", "[", 
     RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], "]"}], "]"}]}], ";"}], "\n", 
