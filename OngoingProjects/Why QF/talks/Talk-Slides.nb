Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1876092091,ExpressionUUID->"029948d8-232c-2201-32a7-618256d9716b"],

Cell["Example 12.2: calibrating the 8 ns pulse", "Subsection",
 CellID->652142632,ExpressionUUID->"4b1b5b6f-b43d-594b-7939-53493dc82b91"],

Cell["\<\
Minimize the transfer error over amplitude and detuning, then over the DRAG \
coefficient as well. This search takes about five minutes.\
\>", "Text",
 CellID->330963574,ExpressionUUID->"32f703b9-71e1-95eb-628c-9ae30795ff31"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"err", "[", 
    RowBox[{
     RowBox[{"a_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"l_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"d_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "-", " ", 
    RowBox[{
     RowBox[{"finalPopulations", "[", 
      RowBox[{"5", ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "l", ",", " ", "d", ",", " ", "8"}], "}"}]}], 
      "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"NMinimize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"err", "[", 
        RowBox[{"a", ",", " ", "0", ",", " ", "d"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"0", " ", "<", " ", "a", " ", "<", " ", "2"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"-", "0.5"}], " ", "<=", " ", "d", " ", "<=", " ", 
         "0.5"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0.8", ",", " ", "1.2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", 
         RowBox[{"-", "0.1"}], ",", " ", "0.1"}], "}"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Method", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DifferentialEvolution\>\"", ",", " ", 
        RowBox[{"\"\<SearchPoints\>\"", " ", "->", " ", "10"}], ",", " ", 
        RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "0"}]}], "}"}]}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"NMinimize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"err", "[", 
        RowBox[{"a", ",", " ", "l", ",", " ", "d"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"0", " ", "<", " ", "a", " ", "<", " ", "2"}], " ", "&&", " ", 
        RowBox[{"0", " ", "<=", " ", "l", " ", "<=", " ", "3"}], " ", "&&", 
        " ", 
        RowBox[{
         RowBox[{"-", "0.5"}], " ", "<=", " ", "d", " ", "<=", " ", 
         "0.5"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "0.8", ",", " ", "1.2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", 
         RowBox[{"-", "0.1"}], ",", " ", "0.1"}], "}"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Method", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<DifferentialEvolution\>\"", ",", " ", 
        RowBox[{"\"\<SearchPoints\>\"", " ", "->", " ", "10"}], ",", " ", 
        RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "0"}]}], "}"}]}]}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[77]:= ",
 CellID->1389046362,ExpressionUUID->"0c860bbc-8d1f-f590-34bd-a2e624abdffa"],

Cell["\<\
Without DRAG the short pulse stalls at a percent-level error; with it the \
error drops several-fold, with a nonzero detuning compensating the \
drive-induced shift.\
\>", "Text",
 CellID->1332526183,ExpressionUUID->"1bab88a0-6539-d521-49a8-210a0ccdbc0b"],

