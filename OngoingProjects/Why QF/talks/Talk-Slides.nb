 CellID->29625565,ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["x", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 " through the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 " relations against ",
 Cell[BoxData[
