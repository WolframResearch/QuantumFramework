Cell[BoxData[
 RowBox[{"Minimize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"8", " ", 
       RowBox[{"\[CapitalOmega]", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", " ", 
           RowBox[{"\[CapitalOmega]", "^", "2"}]}], " ", "-", " ", "1"}], 
         ")"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"2", " ", 
            RowBox[{"\[CapitalOmega]", "^", "2"}]}]}], ")"}], "^", 
         "3"}]}]}]}], ",", " ", 
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], "}"}], ",", " ", 
   "\[CapitalOmega]"}], "]"}]], "Input",
 CellLabel->"In[17]:= ",
