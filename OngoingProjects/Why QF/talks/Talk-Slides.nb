Cell["10.1 Twenty shots", "Subsection",
 CellID->885403737,ExpressionUUID->"69698b1d-3dc2-3628-1f16-2347b4749d72"],

Cell[TextData[{
 "Whenever ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "701e1eb7-eeba-61c8-2025-97f08b4f3312"],
 " is invertible mod ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e322415-281a-3695-37c1-be5f49ac9cff"],
 ", the key is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["l", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{"-", "1"}]], 
   StyleBox["mod",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 "."
}], "Text",
 CellID->299015440,ExpressionUUID->"5e8a6a96-06b4-6465-0689-83d0b3414f4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"samples", " ", "=", " ", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", "probs", "]"}], " ", "->", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"nn", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}], 
       "]"}]}], ",", " ", "20"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"keyFrom", "[", 
    RowBox[{"{", 
     RowBox[{"c_", ",", " ", "d_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"j", " ", "=", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"r", " ", 
            RowBox[{"c", "/", "nn"}]}], "]"}], ",", " ", "r"}], "]"}]}], ",", 
       " ", 
       RowBox[{"l", " ", "=", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"r", " ", 
            RowBox[{"d", "/", "nn"}]}], "]"}], ",", " ", "r"}], "]"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"CoprimeQ", "[", 
        RowBox[{"j", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"l", " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{"j", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "r"}], "]"}]}], ",", " ", "r"}], 
        "]"}], ",", " ", 
       RowBox[{"Missing", "[", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cands", " ", "=", " ", 
   RowBox[{"keyFrom", " ", "/@", " ", "samples"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"cands", ",", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"DeleteMissing", "@", 
      RowBox[{"DeleteDuplicates", "[", "cands", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
        RowBox[{"G", ",", " ", "#"}], "]"}], " ", "===", " ", "Q"}], " ", 
      "&"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[65]:= ",
 CellID->59570862,ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"],

Cell[TextData[{
 "Every usable shot returns the key: it comes out of the interference \
pattern, never from scanning multiples of ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a2ca13-da2c-324e-0151-ec5cdfde8094"],
 "."
}], "Text",
 CellID->1364978316,ExpressionUUID->"5930221d-821b-4026-08cf-c44737ae130c"],

