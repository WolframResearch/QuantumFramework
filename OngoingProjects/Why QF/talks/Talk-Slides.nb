Cell["12. DRAG: Fast Gates on a Transmon", "Section",
 CellID->1994518302,ExpressionUUID->"46be6341-4be3-06d9-6e46-7b2b6d966c23"],

Cell[TextData[{
 "How short can a \[Pi] pulse on a transmon be? A short, strong pulse leaks \
into ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "352b8971-1d3f-d4c9-6328-213b94cbbe13"],
 " and shifts the transition; a long one suffers ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "227c7e4b-1c68-aac8-5204-70159502f812"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],
 ". Five levels, a DRAG term, and calibration under the Lindblad equation."
}], "Text",
 CellID->1562654637,ExpressionUUID->"4becebe3-5bfe-fac0-7993-02cd5d88c82a"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1372112522,ExpressionUUID->"312d182f-c6c7-5e1e-60d2-9188f3722564"],

Cell["What to notice", "Subsection",
 CellID->638348404,ExpressionUUID->"1449d45f-8382-90b9-3c76-ce193634e283"],

Cell[TextData[{
 StyleBox["Leakage seen directly.",
  FontWeight->"Bold"],
 " A short uncalibrated \[Pi] pulse leaves a sizable population above the \
qubit; a long one leaves the flip incomplete."
}], "Item",
 CellID->907289993,ExpressionUUID->"444f09dd-766a-dba7-6c74-a087031ca98d"],

Cell[TextData[{
 StyleBox["DRAG alone is not the answer.",
  FontWeight->"Bold"],
 " Leakage is smallest near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[TildeTilde]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e9b65a-67eb-1624-2f96-2804119e7d0e"],
 ", but transfer error is smallest well below it, so amplitude, detuning and ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],
 " must be calibrated together."
}], "Item",
 CellID->1480220716,ExpressionUUID->"5d3de1d4-e864-19c9-04c2-f89189116b13"],

Cell[TextData[{
 StyleBox["The speed limit is set by decoherence, not leakage.",
  FontWeight->"Bold"],
 " DRAG wins by allowing a shorter pulse."
}], "Item",
 CellID->1004075994,ExpressionUUID->"1adc8861-0296-99d3-4ae3-224bb720eb39"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->592936352,ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell["What to notice (continued)", "Subsection",
 CellID->792862978,ExpressionUUID->"02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],

Cell[TextData[{
 StyleBox["The model checks itself.",
  FontWeight->"Bold"],
 " The averaged gate error tracks the transfer error, and three levels \
underestimate leakage while five and six agree."
}], "Item",
 CellID->573477382,ExpressionUUID->"7cc1833e-1ead-5711-24fe-1b789b583a7b"],

Cell[TextData[{
 StyleBox["All in one object.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData["AnnihilationOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb4236e-91b2-9328-644b-bb482044fe72"],
 ", a parametrized ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631da35c-735e-7e3b-1122-3b0606eb4501"],
 ", and ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b7daea-ed84-b50e-6c4c-d3b784361c54"],
 " for Schrodinger and Lindblad dynamics."
}], "Item",
 CellID->2124988169,ExpressionUUID->"39f2334d-24de-3dcb-6f81-ab174d688711"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->534961831,ExpressionUUID->"1ec600b7-0050-8550-46fd-99f1b1eaefba"],

Cell["Example 12.1: leakage, and what DRAG does to it", "Subsection",
 CellID->998016997,ExpressionUUID->"33bfe66e-cd59-d601-6144-f84be4edbd6b"],

Cell["\<\
The driven anharmonic oscillator with a DRAG term, and final populations \
after a pulse.\
\>", "Text",
 CellID->1107607024,ExpressionUUID->"6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";", " ", 
  
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"envelope", " ", "=", " ", 
   RowBox[{"A", " ", 
    RowBox[{"(", 
     RowBox[{"Pi", "/", "\[Tau]"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"t", "/", "\[Tau]"}]}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hamiltonian", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
       RowBox[{
        RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", 
        RowBox[{"c", " ", "@", " ", "c"}]}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"\[Delta]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "c"}], 
      ")"}]}], " ", "+", "\n", "   ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"envelope", "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"c", " ", "+", " ", 
       RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}]}], ")"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"envelope", ",", " ", "t"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Alpha]"}], ")"}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", "[", "\"\<Dagger\>\"", "]"}], " ", "-", " ", "c"}], 
        ")"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"anharmonicity", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "Pi", " ", "0.2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"finalPopulations", "[", 
    RowBox[{"n_", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "amplitude_", ",", " ", "drag_", ",", " ", "detuning_", ",", " ", 
       "length_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumEvolve", "[", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{
          RowBox[{"hamiltonian", "[", 
           RowBox[{"AnnihilationOperator", "[", "n", "]"}], "]"}], ",", " ", 
          RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
            "\[Alpha]", ",", " ", "A", ",", " ", "\[Lambda]", ",", " ", 
             "\[Delta]", ",", " ", "\[Tau]"}], "}"}]}]}], "]"}], "[", "\n", 
        "    ", 
        RowBox[{
        "anharmonicity", ",", " ", "amplitude", ",", " ", "drag", ",", " ", 
         "detuning", ",", " ", "length"}], "]"}], ",", "\n", "   ", 
       RowBox[{"FockState", "[", 
        RowBox[{"0", ",", " ", "n"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "length"}], "}"}], ",", " ", 
       RowBox[{"Method", " ", "->", " ", "\"\<ExplicitRungeKutta\>\""}], ",", 
       " ", 
       RowBox[{"PrecisionGoal", " ", "->", " ", "12"}], ",", " ", 
       RowBox[{"AccuracyGoal", " ", "->", " ", "14"}]}], "]"}], "[", "length",
      "]"}], "[", "\n", "  ", "\"\<ProbabilitiesList\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[73]:= ",
 CellID->1668318198,ExpressionUUID->"33885b0f-111a-0c54-6188-5369a0af56be"],

