Cell["\<\
What the Wolfram Language and QuantumFramework Do for Physicists\
\>", "Title",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["Sixteen topics, each with a computation you can run live", "Subtitle",
 CellID->1699946459,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["Mohammad Bahrami, Wolfram Research", "Subsubtitle",
 CellID->1535504786,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1208482393,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["\<\
1. Continuous Quantum Error Correction: Syndrome Estimation and Feedback\
\>", "Section",
 CellID->28909615,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["\<\
The three-qubit bit-flip code protected in continuous time: two stabilizers \
measured weakly, a classical controller turning the noisy records into an \
estimate, and the estimate driving corrective pulses.\
\>", "Text",
 CellID->193832008,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->684317082,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["What to notice", "Subsection",
 CellID->528485616,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[TextData[{
 StyleBox["The syndrome is readable even though each sample is useless.",
  FontWeight->"Bold"],
 " The stabilizer signal sits well below the shot noise per step, yet four \
syndrome probabilities track every flip, through an exact Bayes update \
checked against the full stochastic master equation."
}], "Item",
 CellID->1392207227,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[TextData[{
 StyleBox["Feedback breaks the four-number description.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox[
     RowBox[{"f", "b"}], "TI"]], "=", 
   StyleBox["\[Lambda]", "TI"], 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " on, populations couple to coherences, so the controller must carry the \
full ",
 Cell[BoxData[
  RowBox[{"8", "\[Times]", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " estimate."
}], "Item",
 CellID->705466992,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 StyleBox["The controller does not need the logical state.",
  FontWeight->"Bold"],
 " Correction acts on syndromes, not on the logical amplitudes."
}], "Item",
 CellID->1350516518,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->907546795,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell["What to notice (continued)", "Subsection",
 CellID->814772321,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 StyleBox["A wrong detector-efficiency model costs protection,",
  FontWeight->"Bold"],
 " and paired runs on identical noise separate the estimation gap from the \
physical loss."
}], "Item",
 CellID->1054628905,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[TextData[{
 StyleBox["Staying in the code space is not keeping the qubit.",
  FontWeight->"Bold"],
 " The residual loss splits exactly into leakage plus population in ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["1", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 ", which no stabilizer can see."
}], "Item",
 CellID->2043779557,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[TextData[{
 StyleBox["Feedback that protects the code space exactly.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], "=", 
   RowBox[{
    StyleBox["i", "TI"], 
    SqrtBox[
     StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 ", every encoded state is a fixed point at unit efficiency; below it, a ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{"1", "-", 
     StyleBox["\[Eta]", "TI"]}], 
    StyleBox["\[Eta]", "TI"]], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " term appears."
}], "Item",
 CellID->17830494,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1589986527,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["Example 1.1: tracking bit flips from two noisy records", "Subsection",
 CellID->943101875,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "Pauli matrices, the stabilizers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 ", and the four sector projectors."
}], "Text",
 CellID->67888809,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"id2", ",", " ", "X", ",", " ", "Y", ",", " ", "Z"}], "}"}], " ", 
   "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"op3", "[", 
    RowBox[{"o_", ",", " ", "i_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"id2", ",", " ", "id2", ",", " ", "id2"}], "}"}], ",", " ", 
      RowBox[{"i", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ket", "[", "bits_", "]"}], " ", ":=", " ", 
   RowBox[{"Normal", "@", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{"bits", ",", " ", "2"}], "]"}], " ", "+", " ", "1"}], " ", "->",
        " ", "1"}], ",", " ", "8"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S1", " ", "=", " ", 
   RowBox[{
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "1"}], "]"}], " ", ".", " ", 
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "2"}], "]"}]}]}], ";", " ", 
  RowBox[{"S2", " ", "=", " ", 
   RowBox[{
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "2"}], "]"}], " ", ".", " ", 
    RowBox[{"op3", "[", 
     RowBox[{"Z", ",", " ", "3"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"signs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"proj", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "S1"}]}], ")"}], " ", ".", 
       " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "S2"}]}], ")"}]}], "/", "4"}],
      " ", "&"}], " ", "/@", " ", "signs"}]}], ";"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1432876021,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[TextData[{
 "Everything below is built from plain ",
 Cell[BoxData[
  RowBox[{"8", "\[Times]", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " matrices."
}], "Text",
 CellID->876231958,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1020575516,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell["1.1 The measurement step and the trajectory", "Subsection",
 CellID->1967685850,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell["\<\
The positivity-preserving step of Rouchon and Ralph (2015), plus a trajectory \
generator that returns both the states and the record.\
\>", "Text",
 CellID->1044562475,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"measurementStep", "[", 
    RowBox[{
    "H_", ",", " ", "watched_", ",", " ", "effs_", ",", " ", "unwatched_", ",",
      " ", "dt_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"id", " ", "=", " ", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "H", "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"drift", " ", "=", " ", 
        RowBox[{
         RowBox[{"I", " ", "H"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "#", "]"}], " ", ".", " ", 
              "#"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"watched", ",", " ", "unwatched"}], "]"}]}], "]"}], "/", 
          "2"}]}]}], ",", "\n", "    ", 
       RowBox[{"corr", " ", "=", " ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", " ", 
              RowBox[{"(", 
               RowBox[{"#2", " ", ".", " ", "#2"}], ")"}]}], " ", "&"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"effs", ",", " ", "watched"}], "}"}]}], "]"}], "]"}], "/",
          "2"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rho", ",", " ", "dJ"}], "}"}], ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sig", " ", "=", " ", 
           RowBox[{"Total", "[", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sqrt", "[", "#2", "]"}], " ", "#1", " ", "#3"}], " ",
                "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"dJ", ",", " ", "effs", ",", " ", "watched"}], "}"}]}],
              "]"}], "]"}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"M", " ", "=", " ", 
             RowBox[{"id", " ", "-", " ", 
              RowBox[{"drift", " ", "dt"}], " ", "+", " ", "sig", " ", "+", 
              " ", 
              RowBox[{
               RowBox[{"sig", " ", ".", " ", "sig"}], "/", "2"}], " ", "-", 
              " ", 
              RowBox[{"corr", " ", "dt"}]}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"top", " ", "=", " ", 
               RowBox[{
                RowBox[{"M", " ", ".", " ", "rho", " ", ".", " ", 
                 RowBox[{"ConjugateTranspose", "[", "M", "]"}]}], " ", "+", 
                "\n", "          ", 
                RowBox[{"dt", " ", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", 
                    "&"}], " ", "/@", " ", "unwatched"}], "]"}]}], " ", "+", 
                "\n", "          ", 
                RowBox[{"dt", " ", 
                 RowBox[{"Total", "[", 
                  RowBox[{"MapThread", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "#2"}], ")"}], " ", 
                    RowBox[{"#1", " ", ".", " ", "rho", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}]}], " ", 
                    "&"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"watched", ",", " ", "effs"}], "}"}]}], "]"}], 
                  "]"}]}]}]}], "}"}], ",", "\n", "       ", 
             RowBox[{"top", "/", 
              RowBox[{"Re", "@", 
               RowBox[{"Tr", "[", "top", "]"}]}]}]}], "]"}]}], "]"}]}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementRecord", "[", 
    RowBox[{
    "rho_", ",", " ", "watched_", ",", " ", "effs_", ",", " ", "dt_", ",", 
     " ", "kick_"}], "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", "#3", "]"}], " ", 
        RowBox[{"Re", "@", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#1", " ", "+", " ", 
             RowBox[{"ConjugateTranspose", "[", "#1", "]"}]}], ")"}], " ", ".",
            " ", "rho"}], "]"}]}], " ", "dt"}], " ", "+", " ", "#2"}], " ", 
      "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"watched", ",", " ", "kick", ",", " ", "effs"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trajectory", "[", 
    RowBox[{
    "rho0_", ",", " ", "H_", ",", " ", "watched_", ",", " ", "effs_", ",", 
     " ", "unwatched_", ",", " ", "dt_", ",", " ", "tf_", ",", " ", "seed_"}],
     "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"step", " ", "=", " ", 
          RowBox[{"measurementStep", "[", 
           RowBox[{
           "H", ",", " ", "watched", ",", " ", "effs", ",", " ", "unwatched", 
            ",", " ", "dt"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"kicks", " ", "=", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Round", "[", 
               RowBox[{"tf", "/", "dt"}], "]"}], ",", " ", 
              RowBox[{"Length", "[", "watched", "]"}]}], "}"}]}], "]"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"states", " ", "=", " ", 
           RowBox[{"FoldList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"step", "[", 
               RowBox[{"#1", ",", " ", 
                RowBox[{"measurementRecord", "[", 
                 RowBox[{
                 "#1", ",", " ", "watched", ",", " ", "effs", ",", " ", "dt", 
                  ",", " ", "#2"}], "]"}]}], "]"}], " ", "&"}], ",", " ", 
             "rho0", ",", " ", "kicks"}], "]"}]}], "}"}], ",", "\n", "     ", 
         
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<states\>\"", " ", "->", " ", "states"}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<record\>\"", " ", "->", " ", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"measurementRecord", "[", 
                RowBox[{
                "#1", ",", " ", "watched", ",", " ", "effs", ",", " ", "dt", ",",
                  " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Most", "[", "states", "]"}], ",", " ", "kicks"}], 
               "}"}]}], "]"}]}]}], "|>"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->1653200050,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["\<\
Each step conditions the state on one record increment without ever leaving \
the set of valid states.\
\>", "Text",
 CellID->1384978530,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->519689844,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell["1.1 One monitored run", "Subsection",
 CellID->1609367578,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[TextData[{
 "Start in ",
 Cell[BoxData[
  TemplateBox[{"000"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 ", let each qubit flip at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 ", watch both stabilizers, and keep only the record."
}], "Text",
 CellID->1541450781,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kappa", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"eta", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"gamma", " ", "=", " ", "0.05"}], ";", " ", 
  RowBox[{"dt", " ", "=", " ", "0.004"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"run", " ", "=", " ", 
   RowBox[{"trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"#", ",", " ", "#"}], "]"}], " ", "&"}], "@", 
      RowBox[{"ket", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"0", " ", 
      RowBox[{"IdentityMatrix", "[", "8", "]"}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "kappa", "]"}], " ", 
      RowBox[{"{", 
       RowBox[{"S1", ",", " ", "S2"}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"eta", ",", " ", "eta"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "gamma", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"op3", "[", 
          RowBox[{"X", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Range", "[", "3", "]"}]}], ")"}]}], ",", " ", "dt", ",", " ",
      "40.", ",", " ", "3"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[3]:= ",
 CellID->1657269721,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell["\<\
The run holds the true conditional state and the noisy record it produced.\
\>", "Text",
 CellID->1140508347,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

