Cell["3.1 The drift is the master equation", "Subsection",
 CellID->41202278,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell["\<\
Build the Lindbladian with drive, relaxation and dephasing, project on the \
Pauli matrices, subtract.\
\>", "Text",
 CellID->1124146653,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sx", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], ",", " ", 
     RowBox[{"sy", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], ",", " ", 
     RowBox[{"sz", " ", "=", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], ",", " ", 
     RowBox[{"sm", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}]}], "}"}], ",", "\n", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rho", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
          RowBox[{"x", " ", "sx"}], " ", "+", " ", 
          RowBox[{"y", " ", "sy"}], " ", "+", " ", 
          RowBox[{"z", " ", "sz"}]}], ")"}], "/", "2"}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"diss", " ", "=", " ", 
         RowBox[{"Function", "[", 
          RowBox[{"L", ",", " ", 
           RowBox[{
            RowBox[{"L", " ", ".", " ", "rho", " ", ".", " ", 
             RowBox[{"ConjugateTranspose", "[", "L", "]"}]}], " ", "-", "\n", 
            "       ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "L", "]"}], " ", ".", " ", 
                "L", " ", ".", " ", "rho"}], " ", "+", " ", 
               RowBox[{"rho", " ", ".", " ", 
                RowBox[{"ConjugateTranspose", "[", "L", "]"}], " ", ".", " ", 
                "L"}]}], ")"}], "/", "2"}]}]}], "]"}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "I"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"rs", "[", 
                    RowBox[{"[", "6", "]"}], "]"}], "/", "2"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"sx", " ", ".", " ", "rho"}], " ", "-", " ", 
                   RowBox[{"rho", " ", ".", " ", "sx"}]}], ")"}]}], " ", "+", 
                " ", 
                RowBox[{
                 RowBox[{"rs", "[", 
                  RowBox[{"[", "5", "]"}], "]"}], " ", 
                 RowBox[{"diss", "[", "sm", "]"}]}], " ", "+", "\n", 
                "          ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"rs", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], " ", "+", " ", 
                    RowBox[{"rs", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}], 
                  ")"}], " ", 
                 RowBox[{"diss", "[", "sz", "]"}]}]}], ")"}], " ", ".", " ", 
              "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"sx", ",", " ", "sy", ",", " ", "sz"}], "}"}]}], ")"}], 
         " ", "-", " ", 
         RowBox[{"driftIto", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
           "rs"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->1232284935,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 ": the affine drift is the master equation."
}], "Text",
 CellID->2082395230,ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

