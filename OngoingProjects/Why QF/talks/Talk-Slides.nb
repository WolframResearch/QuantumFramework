A driven, relaxing, quantum-limited readout starting in the ground state.\
\>", "Text",
 CellID->1391655620,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tr", " ", "=", " ", 
   RowBox[{"oneTraj", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "0.252", ",", " ", "0.1", ",", " ", "0.176", ",", " ", "1.", ",", " ", 
       "1.", ",", " ", "3."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "0.", ",", " ", "1.", ",", " ", "0."}], "}"}], ",",
      " ", "3.", ",", " ", 
     RowBox[{"1", "/", "120."}], ",", " ", "7"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"tr", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "[", "t", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"tr", "[", 
       RowBox[{"[", "4", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<z(t)\>\"", ",", " ", "\"\<Q(t)\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[23]:= ",
 CellID->861714746,ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

