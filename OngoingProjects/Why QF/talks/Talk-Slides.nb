Cell["\<\
Example 4.2: five numbers recover what 256 amplitudes compute\
\>", "Subsection",
 CellID->853117843,ExpressionUUID->"621761a3-d300-b412-122d-780ce6ba1f78"],

Cell[TextData[{
 "A periodic grid, a Gaussian packet, the Bayesian measurement step and a \
Strang split-operator step (",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 ")."
}], "Text",
 CellID->623836386,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hbar", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"mass", " ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"grid", "[", 
    RowBox[{"n_", ",", " ", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dx", " ", "=", " ", 
       RowBox[{"l", "/", "n"}]}], "}"}], ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<n\>\"", " ", "->", " ", "n"}], ",", " ", 
       RowBox[{"\"\<x\>\"", " ", "->", " ", 
        RowBox[{"dx", " ", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "n"}], "/", "2"}], ",", " ", 
           RowBox[{
            RowBox[{"n", "/", "2"}], " ", "-", " ", "1"}]}], "]"}]}]}], ",", 
       "\n", "    ", 
       RowBox[{"\"\<p\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "Pi", " ", 
           RowBox[{"hbar", "/", "l"}]}], ")"}], " ", 
         RowBox[{"RotateLeft", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "n"}], "/", "2"}], ",", " ", 
             RowBox[{
              RowBox[{"n", "/", "2"}], " ", "-", " ", "1"}]}], "]"}], ",", 
           " ", 
           RowBox[{"n", "/", "2"}]}], "]"}]}]}]}], "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ft", "[", "psi_", "]"}], " ", ":=", " ", 
   RowBox[{"Fourier", "[", 
    RowBox[{"psi", ",", " ", 
     RowBox[{"FourierParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ift", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{"InverseFourier", "[", 
    RowBox[{"c", ",", " ", 
     RowBox[{"FourierParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussian", "[", 
    RowBox[{"g_", ",", " ", "x0_", ",", " ", "p0_", ",", " ", "s_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"g", "[", "\"\<x\>\"", "]"}], " ", "-", " ", "x0"}], ")"}],
          "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", 
         RowBox[{"s", "^", "2"}]}], ")"}]}], " ", "+", " ", 
      RowBox[{"I", " ", "p0", " ", 
       RowBox[{
        RowBox[{"g", "[", "\"\<x\>\"", "]"}], "/", "hbar"}]}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xMean", "[", 
    RowBox[{"g_", ",", " ", "psi_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"g", "[", "\"\<x\>\"", "]"}], " ", ".", " ", 
    RowBox[{
     RowBox[{"Abs", "[", "psi", "]"}], "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"outcome", "[", 
     RowBox[{"g_", ",", " ", "lam_", ",", " ", "dt_"}], "]"}], "[", "psi_", 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"RandomChoice", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "psi", "]"}], "^", "2"}], " ", "->", " ", 
      RowBox[{"g", "[", "\"\<x\>\"", "]"}]}], "]"}], " ", "+", "\n", "   ", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"4", " ", "lam", " ", "dt"}], "]"}]}]}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measUpdate", "[", 
     RowBox[{"g_", ",", " ", "lam_", ",", " ", "dt_", ",", " ", "xb_"}], 
     "]"}], "[", "psi_", "]"}], " ", ":=", " ", 
   RowBox[{"Normalize", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "lam"}], " ", "dt", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g", "[", "\"\<x\>\"", "]"}], " ", "-", " ", "xb"}], ")"}], 
        "^", "2"}]}], "]"}], " ", "psi"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"potentialStep", "[", 
     RowBox[{"g_", ",", " ", "V_", ",", " ", "dt_"}], "]"}], "[", "psi_", 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"V", "[", 
       RowBox[{"g", "[", "\"\<x\>\"", "]"}], "]"}], " ", 
      RowBox[{"dt", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "hbar"}], ")"}]}]}], "]"}], " ", "psi"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kineticStep", "[", 
     RowBox[{"g_", ",", " ", "dt_"}], "]"}], "[", "psi_", "]"}], " ", ":=", 
   " ", 
   RowBox[{"ift", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{
        RowBox[{"g", "[", "\"\<p\>\"", "]"}], "^", "2"}], " ", 
       RowBox[{"dt", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "mass", " ", "hbar"}], ")"}]}]}], "]"}], " ", 
     RowBox[{"ft", "[", "psi", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evolveStep", "[", 
    RowBox[{"g_", ",", " ", "V_", ",", " ", "dt_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"potentialStep", "[", 
     RowBox[{"g", ",", " ", "V", ",", " ", "dt"}], "]"}], " ", "@*", " ", 
    RowBox[{"kineticStep", "[", 
     RowBox[{"g", ",", " ", "dt"}], "]"}], " ", "@*", " ", 
    RowBox[{"potentialStep", "[", 
     RowBox[{"g", ",", " ", "V", ",", " ", "dt"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"trajectory", "[", 
     RowBox[{
     "g_", ",", " ", "V_", ",", " ", "lam_", ",", " ", "dt_", ",", " ", 
      "nt_"}], "]"}], "[", "psi0_", "]"}], " ", ":=", " ", 
   RowBox[{"NestList", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"evolveStep", "[", 
        RowBox[{"g", ",", " ", "V", ",", " ", "dt"}], "]"}], "[", 
       RowBox[{
        RowBox[{"measUpdate", "[", 
         RowBox[{"g", ",", " ", "lam", ",", " ", "dt", ",", " ", 
          RowBox[{"Sow", "@", 
           RowBox[{
            RowBox[{"outcome", "[", 
             RowBox[{"g", ",", " ", "lam", ",", " ", "dt"}], "]"}], "[", "#", 
            "]"}]}]}], "]"}], "[", "#", "]"}], "]"}], " ", "&"}], ",", " ", 
     "psi0", ",", " ", "nt"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[28]:= ",
 CellID->564394165,ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell[TextData[{
 "The measurement half never sees the Hamiltonian, so any ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494d6e39-7750-b6eb-7f72-806302ea1c31"],
 " costs one pointwise phase."
}], "Text",
 CellID->2048244887,ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1432457359,ExpressionUUID->"4f6d713e-2461-11c8-7513-69784d146312"],

Cell["4.2 A watched particle in a trap", "Subsection",
 CellID->200346680,ExpressionUUID->"14ad582f-66ff-93eb-3c53-5189128be131"],

Cell["\<\
Keep both the conditional wavefunction and the stream of readings.\
\>", "Text",
 CellID->447384324,ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wR", " ", "=", " ", "1."}], ";", " ", 
  RowBox[{"lamH", " ", "=", " ", "2."}], ";", " ", 
  RowBox[{"SxZP", " ", "=", " ", 
   RowBox[{"hbar", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "mass", " ", "wR"}], ")"}]}]}], ";", " ", 
  RowBox[{"SpZP", " ", "=", " ", 
   RowBox[{"hbar", " ", "mass", " ", 
    RowBox[{"wR", "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gH", " ", "=", " ", 
   RowBox[{"grid", "[", 
    RowBox[{"256", ",", " ", "24."}], "]"}]}], ";", " ", 
  RowBox[{"dtH", " ", "=", " ", "0.002"}], ";", " ", 
  RowBox[{"ntH", " ", "=", " ", "1500"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"states", ",", " ", 
     RowBox[{"{", "outs", "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "21", "]"}], ";", "\n", "   ", 
     RowBox[{"Reap", "[", 
      RowBox[{
       RowBox[{"trajectory", "[", 
        RowBox[{"gH", ",", " ", 
         RowBox[{
          RowBox[{"0.5", " ", "mass", " ", 
           RowBox[{"wR", "^", "2"}], " ", 
           RowBox[{"#", "^", "2"}]}], " ", "&"}], ",", " ", "lamH", ",", " ", 
         "dtH", ",", " ", "ntH"}], "]"}], "[", 
       RowBox[{"gaussian", "[", 
        RowBox[{"gH", ",", " ", "0.", ",", " ", "0.", ",", " ", 
         RowBox[{"Sqrt", "[", "SxZP", "]"}]}], "]"}], "]"}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"xGrid", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"xMean", "[", 
      RowBox[{"gH", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "states"}]}], ";"}]}], "Input",
 CellLabel->"In[29]:= ",
 CellID->1438124241,ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell["The readings are the only thing an experimenter would have.", "Text",
 CellID->2000382747,ExpressionUUID->"06d00634-a672-f252-2eef-9871d304c0b8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->902867877,ExpressionUUID->"05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],

Cell["4.2 The quantum Kalman filter", "Subsection",
 CellID->1315202099,ExpressionUUID->"583a98af-415b-100e-09d9-110970ee6354"],

Cell["\<\
Two means nudged by the surprise in each reading, three covariances following \
the Riccati flow of Example 4.1.\
\>", "Text",
 CellID->376763343,ExpressionUUID->"07beae85-a317-6bf9-2d45-47eed6a239c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"num", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[HBar]", " ", "->", " ", "hbar"}], ",", " ", 
     RowBox[{"m", " ", "->", " ", "mass"}], ",", " ", 
     RowBox[{"\[Omega]", " ", "->", " ", "wR"}], ",", " ", 
     RowBox[{"\[Lambda]", " ", "->", " ", "lamH"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"covDrift", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sx", ",", " ", "cc", ",", " ", "sp"}], "}"}], ",", " ", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"riccati", " ", "/.", " ", "num"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sx", " ", "->", " ", "sx"}], ",", " ", 
         RowBox[{"Cc", " ", "->", " ", "cc"}], ",", " ", 
         RowBox[{"Sp", " ", "->", " ", "sp"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"filterStep", "[", "dt_", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mx_", ",", " ", "mp_", ",", " ", "sx_", ",", " ", "cc_", ",", " ", 
       "sp_"}], "}"}], ",", " ", "dY_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dWf", " ", "=", " ", 
       RowBox[{"dY", " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "mx", " ", "dt"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mx", " ", "+", " ", 
          RowBox[{
           RowBox[{"mp", "/", "mass"}], " ", "dt"}], " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "sx", " ", "dWf"}]}], ",",
          " ", 
         RowBox[{"mp", " ", "-", " ", 
          RowBox[{"mass", " ", 
           RowBox[{"wR", "^", "2"}], " ", "mx", " ", "dt"}], " ", "+", " ", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "cc", " ", "dWf"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sx", ",", " ", "cc", ",", " ", "sp"}], "}"}], " ", "+", " ", 
        RowBox[{"dt", " ", 
         RowBox[{"covDrift", "[", 
          RowBox[{"sx", ",", " ", "cc", ",", " ", "sp"}], "]"}]}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mFilter", " ", "=", " ", 
   RowBox[{
    RowBox[{"FoldList", "[", 
     RowBox[{
      RowBox[{"filterStep", "[", "dtH", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "0.", ",", " ", "0.", ",", " ", "SxZP", ",", " ", "0.", ",", " ", 
        "SpZP"}], "}"}], ",", " ", 
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", "lamH", "]"}], " ", "dtH", " ", "outs"}]}], "]"}],
     "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xGrid", ",", " ", "mFilter"}], "}"}], ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"ntH", " ", "dtH"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Gray"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<grid (256 amplitudes)\>\"", ",", 
      " ", "\"\<Kalman filter (5 numbers)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]x\[RightAngleBracket]\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[30]:= ",
 CellID->126027414,ExpressionUUID->"503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],

Cell["\<\
The filter, fed nothing but the readings, sits on the conditional mean of the \
full wavefunction.\
\>", "Text",
 CellID->570920987,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

