Cell["10.1 The quantum part, simulated exactly", "Subsection",
 CellID->1646424406,ExpressionUUID->"06c25578-1780-b25e-2ef2-4d22a23a00a4"],

Cell[TextData[{
 "Query ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["a", "TI"], 
   StyleBox["G", "TI"], "+", 
   StyleBox["b", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f70617e-b140-9f95-0500-793bc0fae5ff"],
 " on two registers, measure the point register, Fourier-transform both \
inputs."
}], "Text",
 CellID->2053055694,ExpressionUUID->"79d0371a-30a6-04e5-2fef-af4441536ecf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"elts", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{"pts", ",", " ", "O"}], "]"}]}], ";", " ", 
  RowBox[{"idx", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"elts", " ", "->", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"r", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t", " ", "=", " ", "7"}], ";", " ", 
  RowBox[{"nn", " ", "=", " ", 
   RowBox[{"2", "^", "t"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"idx", "[", 
      RowBox[{
       RowBox[{"ec", "[", "\"\<Add\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
         RowBox[{"G", ",", " ", "a"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
         RowBox[{"Q", ",", " ", "b"}], "]"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", 
       RowBox[{"nn", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", 
       RowBox[{"nn", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probs", " ", "=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Fourier", "[", 
          RowBox[{
           RowBox[{"Boole", "[", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", "==", " ", "w"}], " ", "&"}], ",", " ", "f", 
              ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"FourierParameters", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "]"}], "^", "2"}], ",", 
       "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "0", ",", " ", 
         RowBox[{"r", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}], "/", 
    RowBox[{"nn", "^", "2"}]}]}], ";"}]}], "Input",
 CellLabel->"In[64]:= ",
 CellID->2132198261,ExpressionUUID->"7d950d76-dd18-2b24-2baa-a533d4ad760e"],

Cell[TextData[{
 "The output distribution peaks near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], ",", 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   SuperscriptBox["2", 
    StyleBox["t", "TI"]], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7234a9f4-3232-6781-23cb-40be47c74deb"],
 "."
}], "Text",
 CellID->1954495564,ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
