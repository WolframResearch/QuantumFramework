 CellID->462592558,ExpressionUUID->"6e1a2d6a-d2ad-c32a-1639-c537e759ae70"],

Cell[TextData[{
 "13.1 Hong-Ou-Mandel for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb5612b-2266-f0f1-164b-79755710c2db"]
}], "Subsection",
 CellID->621689956,ExpressionUUID->"1f4b4965-e043-b514-4549-614e91f71c7e"],

Cell[TextData[{
 "A balanced splitter with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf36e21-2d79-2b6f-0980-878b440c79b5"],
 " photons in each port."
}], "Text",
 CellID->912512294,ExpressionUUID->"6fe9f85b-1ce6-27f0-1596-f20594908dda"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hom", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], ",", " ", "0"}], "]"}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", 
        RowBox[{
         RowBox[{"2", " ", "n"}], " ", "-", " ", "k"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"hom", ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"hom", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", " ", "->", " ", "m"}], ",", " ", 
        RowBox[{"k", " ", "->", " ", "j"}]}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "1", ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "m"}], " ", "-", " ", "1"}], ",", " ", "2"}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"hom", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"k", " ", "->", " ", "j"}]}], "}"}]}], "]"}], "^", "2"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[79]:= ",
 CellID->159314101,ExpressionUUID->"3eadea9f-7d43-757d-6652-03d974f65c47"],

Cell[TextData[{
 "One formula for all ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68be2dd2-eea3-f2cb-1845-c49f8b57c011"],
 "; every odd split is exactly zero, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],
 " is the HOM dip."
}], "Text",
 CellID->2072053663,ExpressionUUID->"6afb4307-9f81-9d1b-1a99-5b611a35e461"],

