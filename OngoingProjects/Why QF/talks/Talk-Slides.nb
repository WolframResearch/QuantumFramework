Cell["Example 3.2: NDSolve integrating a monitored qubit", "Subsection",
 CellID->2124519200,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell[TextData[{
 "Interpolate a sampled Wiener path with a cubic and give its derivative to \
",
 Cell[BoxData["NDSolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 " as a classical forcing."
}], "Text",
 CellID->617350884,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wienerFun", "[", 
    RowBox[{"tf_", ",", " ", "h_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grid", " ", "=", " ", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"0.", ",", " ", "tf", ",", " ", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"tf", "/", "h"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"grid", ",", " ", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Accumulate", "[", "\n", "         ", 
               RowBox[{"RandomVariate", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"grid", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
                 
                 RowBox[{
                  RowBox[{"Length", "[", "grid", "]"}], " ", "-", " ", 
                  "1"}]}], "]"}], "]"}], ",", " ", "0."}], "]"}]}], "}"}], 
          "]"}], ",", "\n", "     ", 
         RowBox[{"InterpolationOrder", " ", "->", " ", "3"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"oneTraj", "[", 
    RowBox[{
    "r_", ",", " ", "init_", ",", " ", "tf_", ",", " ", "h_", ",", " ", 
     "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Wf", " ", "=", " ", 
        RowBox[{"wienerFun", "[", 
         RowBox[{"tf", ",", " ", "h", ",", " ", "seed"}], "]"}]}], ",", " ", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"xx", ",", " ", "yy", ",", " ", "zz", ",", " ", "QQ"}], 
         "}"}]}], ",", " ", "t"}], "}"}], ",", "\n", "   ", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"Join", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Through", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Derivative", "[", "1", "]"}], " ", "/@", " ", "v"}], 
              ")"}], "[", "t", "]"}], "]"}], " ", "==", "\n", "       ", 
           RowBox[{
            RowBox[{"driftStrat", "[", 
             RowBox[{
              RowBox[{"Through", "[", 
               RowBox[{"v", "[", "t", "]"}], "]"}], ",", " ", "r"}], "]"}], 
            " ", "+", " ", 
            RowBox[{
             RowBox[{"diffStrat", "[", 
              RowBox[{
               RowBox[{"Through", "[", 
                RowBox[{"v", "[", "t", "]"}], "]"}], ",", " ", "r"}], "]"}], " ", 
             RowBox[{
              RowBox[{"Wf", "'"}], "[", "t", "]"}]}]}]}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Through", "[", 
            RowBox[{"v", "[", "0", "]"}], "]"}], " ", "==", " ", "init"}], 
          "]"}]}], "]"}], ",", " ", "v", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "tf"}], "}"}], ",", " ", 
       RowBox[{"MaxStepSize", " ", "->", " ", 
        RowBox[{"h", "/", "4"}]}]}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[22]:= ",
 CellID->1357963930,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell["\<\
The stochastic equation becomes an ordinary one, path by path.\
\>", "Text",
 CellID->1626918454,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

