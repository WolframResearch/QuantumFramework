Cell["4.1 One function of one strength", "Subsection",
 CellID->1689126594,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[TextData[{
 "In ground-state units the position variance depends only on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 "."
}], "Text",
 CellID->1490757098,ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sqRatio", "[", "u_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"u", "^", "2"}]}], "]"}], " ", "-", " ", "1"}], ")"}]}], 
     "]"}], "/", "u"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SxSS", "/", 
       RowBox[{"(", 
        RowBox[{"\[HBar]", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m", " ", "\[Omega]"}], ")"}]}], ")"}]}], " ", "==",
       " ", 
      RowBox[{"sqRatio", "[", 
       RowBox[{"2", " ", "\[HBar]", " ", 
        RowBox[{"\[Lambda]", "/", 
         RowBox[{"(", 
          RowBox[{"m", " ", 
           RowBox[{"\[Omega]", "^", "2"}]}], ")"}]}]}], "]"}]}], ",", " ", 
     "as"}], "]"}], ",", "\n", " ", 
   RowBox[{"Resolve", "[", 
    RowBox[{
     RowBox[{"ForAll", "[", 
      RowBox[{"u", ",", " ", 
       RowBox[{"u", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"sqRatio", "[", "u", "]"}], " ", "<", " ", "1"}]}], "]"}], ",",
      " ", "Reals"}], "]"}], ",", "\n", " ", 
   RowBox[{"Asymptotic", "[", 
    RowBox[{
     RowBox[{"sqRatio", "[", "u", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"u", " ", ">=", " ", "0"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Asymptotic", "[", 
    RowBox[{
     RowBox[{"sqRatio", "[", "u", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "Infinity", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"u", " ", ">=", " ", "0"}]}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[26]:= ",
 CellID->148290444,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

Cell[TextData[{
 "Squeezed below the zero-point for every strength, weakly as ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["\[Mu]", "TI"], "2"], "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 " and strongly as ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "/", 
    StyleBox["\[Mu]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 "."
}], "Text",
 CellID->1707667820,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
