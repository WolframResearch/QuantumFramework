Example 3.1: It\[OHat]-Stratonovich, Lindblad and positivity, all symbolic\
\>", "Subsection",
 CellID->1906087345,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[TextData[{
 "The Stratonovich drift, the diffusion and the It\[OHat] drift on a symbolic \
rate vector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]}], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], ",", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], ",", 
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     StyleBox["x", "TI"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 "."
}], "Text",
 CellID->354048744,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"driftStrat", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_", ",", " ", "q_"}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{
      "gCI_", ",", " ", "gBA_", ",", " ", "gd_", ",", " ", "gphi_", ",", " ", 
       "g1_", ",", " ", "om_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g2", " ", "=", " ", 
       RowBox[{
        RowBox[{"g1", "/", "2"}], " ", "+", " ", "gphi", " ", "+", " ", 
        "gd"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"gBA", " ", "+", " ", "gCI"}], ")"}], "/", "2"}], " ", "-",
            " ", "g2", " ", "-", " ", 
           RowBox[{"gCI", " ", 
            RowBox[{"z", "^", "2"}]}]}], ")"}], " ", "x"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"gBA", " ", "gCI"}], "]"}], " ", "y", " ", "z"}]}], ",", 
       "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"gBA", " ", "+", " ", "gCI"}], ")"}], "/", "2"}], " ", "-",
            " ", "g2", " ", "-", " ", 
           RowBox[{"gCI", " ", 
            RowBox[{"z", "^", "2"}]}]}], ")"}], " ", "y"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"gBA", " ", "gCI"}], "]"}], " ", "x", " ", "z"}], " ", "-", 
        " ", 
        RowBox[{"om", " ", "z"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"g1", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "z"}], ")"}]}], " ", "+", " ", 
        RowBox[{"gCI", " ", "z", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"z", "^", "2"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{"om", " ", "y"}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "gCI", "]"}], " ", "z"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"diffStrat", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_", ",", " ", "q_"}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"gCI_", ",", " ", "gBA_", ",", " ", "__"}], "}"}]}], "]"}], " ",
    ":=", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sqrt", "[", "gCI", "]"}]}], " ", "x", " ", "z"}], " ", "-", 
      " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", "gBA", "]"}], " ", "y"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sqrt", "[", "gCI", "]"}]}], " ", "y", " ", "z"}], " ", "+", 
      " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", "gBA", "]"}], " ", "x"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "gCI", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"z", "^", "2"}]}], ")"}]}], ",", " ", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"driftIto", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "_", ",", " ", "_", ",", " ", "gd_", ",", " ", "gphi_", ",", " ", "g1_",
        ",", " ", "om_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g2", " ", "=", " ", 
       RowBox[{
        RowBox[{"g1", "/", "2"}], " ", "+", " ", "gphi", " ", "+", " ", 
        "gd"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "g2"}], " ", "x"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "g2"}], " ", "y"}], " ", "-", " ", 
        RowBox[{"om", " ", "z"}]}], ",", " ", 
       RowBox[{
        RowBox[{"g1", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "z"}], ")"}]}], " ", "+", " ", 
        RowBox[{"om", " ", "y"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalGamma]", ",", " ", "\"\<CI\>\""}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalGamma]", ",", " ", "\"\<BA\>\""}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalGamma]", ",", " ", "\"\<d\>\""}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Gamma]", ",", " ", "\"\<\[Phi]\>\""}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Gamma]", ",", " ", "\"\<1\>\""}], "]"}], ",", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[CapitalOmega]", ",", " ", "\"\<x\>\""}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[18]:= ",
 CellID->786710823,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[TextData[{
 "Four components: three Bloch coordinates and the detector's accumulated \
readout ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 "."
