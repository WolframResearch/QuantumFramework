 CellTags->"SlideShowHeader",
 CellID->197217751,ExpressionUUID->"74b37722-3fdc-1a4f-1c41-6e8cba696895"],

Cell["13. QuantumInterferometer: Symbolic Behaviour", "Section",
 CellID->880034747,ExpressionUUID->"31781dc2-1028-33d4-6707-94aca1c2813e"],

Cell["\<\
QuantumFramework's linear-optics object, with beam splitters, phase shifters, \
squeezers and loss, when the inputs are symbols: angles, amplitudes, \
squeezing, loss rates, and above all photon numbers.\
\>", "Text",
 CellID->1800574979,ExpressionUUID->"2148b02c-d62e-5336-5777-2989e3db3e1c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1078219960,ExpressionUUID->"183293a6-0d60-7813-49c1-0a00a4154b79"],

Cell["What to notice", "Subsection",
 CellID->2033801793,ExpressionUUID->"61e1f3c1-eae0-3799-179e-eaaa8e9a9de3"],

Cell[TextData[{
 StyleBox["Symbolic photon numbers.",
  FontWeight->"Bold"],
 " A beam splitter's amplitude comes back as a Wigner ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bddc2d-650e-8031-5042-d6770cb8d31b"],
 "-function, the Schwinger realization of SU(2)."
}], "Item",
 CellID->1670899349,ExpressionUUID->"7a437910-f355-55ba-2a71-715d86e03f80"],

Cell[TextData[{
 StyleBox["Hong-Ou-Mandel for every ",
  FontWeight->"Bold"],
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"49429438-4a3e-974e-7f71-0e626fc8fd94"],
 StyleBox[".",
  FontWeight->"Bold"],
 " On a balanced splitter ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["n", "TI"], ",", 
       StyleBox["n", "TI"]}]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     RowBox[{
       StyleBox["k", "TI"], ",", "2", 
       StyleBox["n", "TI"], "-", 
       StyleBox["k", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07e2168c-1726-1a27-2d91-8fd6a2d3690d"],
 " is ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    RowBox[{"0", ",", 
     RowBox[{
      StyleBox["k", "TI"], "-", 
      StyleBox["n", "TI"]}]}], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3540c51c-f580-c338-637f-dd59fc3aae02"],
 ", and every odd split vanishes."
}], "Item",
 CellID->975439503,ExpressionUUID->"684f0173-fe99-1571-1874-993cfb2c7c5b"],

Cell[TextData[{
 StyleBox["Coherent, squeezed and lossy light, exactly,",
  FontWeight->"Bold"],
 " including the binomial loss law for symbolic ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],
 "."
}], "Item",
 CellID->351741581,ExpressionUUID->"607492e2-157b-ba0c-100b-0bcc9c0f0956"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->984679481,ExpressionUUID->"7781757c-388d-abb9-1dbf-6d26b939f983"],

Cell["What to notice (continued)", "Subsection",
 CellID->412548195,ExpressionUUID->"566e7348-207a-dc95-7e16-6b12510ca6ff"],

Cell[TextData[{
 StyleBox["A physical-domain contract.",
  FontWeight->"Bold"],
 " Photon numbers are nonnegative integers, angles real, ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39672ae7-82f4-b353-6f1c-c3c1368601b9"],
 "; results carry no conditions restating that domain."
}], "Item",
 CellID->167190678,ExpressionUUID->"0c48aba4-6f27-6a39-3477-420e0ad23903"],

Cell[TextData[{
 StyleBox["Stated limits.",
  FontWeight->"Bold"],
 " What is not supported symbolically is listed explicitly."
}], "Item",
 CellID->132154406,ExpressionUUID->"2f62374d-f3df-131c-5511-af16866a7e66"],

