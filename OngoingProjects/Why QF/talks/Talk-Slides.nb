Cell["What to notice (continued)", "Subsection",
 CellID->1367217003,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[TextData[{
 StyleBox["A closed law tying state to record.",
  FontWeight->"Bold"],
 " With drive and relaxation off, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["arctanh",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["z", "TI"], "0"], "+", 
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
    StyleBox["Q", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],
 " on every path."
}], "Item",
 CellID->1372538143,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[TextData[{
 StyleBox["Honest numerics.",
  FontWeight->"Bold"],
 " Means against the closed-form Lindblad solution, spreads against the \
built-in order-3/2 integrator, and the noise grid shown to be the step that \
matters."
}], "Item",
 CellID->485911656,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

