Cell["Example 13.1: a beam splitter with symbolic photon numbers", \
"Subsection",
 CellID->1881657070,ExpressionUUID->"1f0fb95c-030e-c889-4534-3106b6b89ad3"],

Cell[TextData[{
 "The amplitude from ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["n", "TI"], "2"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16268eae-a572-7912-3fdd-270bcc074878"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["n", "TI"], "1"], "+", 
      SubscriptBox[
       StyleBox["n", "TI"], "2"], "-", 
      SubscriptBox[
       StyleBox["t", "TI"], "1"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346a0e1a-2221-987e-5c69-a04457d5eb44"],
 "."
}], "Text",
 CellID->1506900826,ExpressionUUID->"366be24c-537a-43bb-5e68-0416660f1181"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";", " ", 
  
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"bs", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"th", ",", " ", "ph"}], "]"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", 
      RowBox[{"n1", " ", "+", " ", "n2", " ", "-", " ", "t1"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[78]:= ",
 CellID->637363640,ExpressionUUID->"501b1457-1a1d-907b-0038-8e119fa9e341"],

Cell[TextData[{
 "A two-mode beam splitter is a rotation of a spin of size ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["n", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "291c68e0-f532-6cdd-5f23-81cdfcc73627"],
 ", and the photon numbers are its magnetic quantum numbers."
}], "Text",
 CellID->658697144,ExpressionUUID->"5c29c458-c353-7b98-05d6-de05f6e649e2"],

