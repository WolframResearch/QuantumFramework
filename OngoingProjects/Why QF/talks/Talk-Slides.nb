Cell["Example 11.2: a coherent error, digitized and corrected", "Subsection",
 CellID->1927064331,ExpressionUUID->"6aa15cf4-f328-f435-1a5f-55b186c2df1f"],

Cell["\<\
Parity measurements whose outcomes land on record wires 0 and -1, and \
corrections controlled on those records.\
\>", "Text",
 CellID->177111739,ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"id2", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";", " ", 
  RowBox[{"zz", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"syn", "[", 
    RowBox[{"q1_", ",", " ", "q2_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumMeasurementOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"id2", ",", " ", "id2"}], "]"}], " ", "+", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"id2", ",", " ", "id2"}], "]"}], " ", "-", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"enc", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<CNOT\>\"", ",", " ", 
       RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "}"}], ",", " ", 
     RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Encode\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qec", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{"enc", ",", " ", 
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", 
        RowBox[{"2", " ", "\[Theta]"}], "]"}], " ", "->", " ", "2"}], ",", 
      " ", 
      RowBox[{"syn", "[", 
       RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"syn", "[", 
       RowBox[{"2", ",", " ", "3"}], "]"}], ",", "\n", "    ", 
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{"\"\<X\>\"", ",", " ", 
        RowBox[{"{", "0", "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"-", "1"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{
        RowBox[{"\"\<X\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", "}"}]}], "]"}], ",", " ", 
      RowBox[{"\"\<C\>\"", "[", 
       RowBox[{
        RowBox[{"\"\<X\>\"", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"-", "1"}], "}"}], ",", " ", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"coded", " ", "=", " ", 
   RowBox[{"qec", "[", 
    RowBox[{"QuantumTensorProduct", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
      RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[70]:= ",
 CellID->115596948,ExpressionUUID->"33c53063-afff-c489-61fa-aa4cc98baed3"],

Cell["The classical record is part of the circuit.", "Text",
 CellID->1114128274,ExpressionUUID->"08d8bcb3-70a4-55b3-38e7-35fd01513f99"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
