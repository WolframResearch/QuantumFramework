Cell[TextData[{
 "3.1 The flux of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " through the Bloch sphere"
}], "Subsection",
 CellID->25123057,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell["\<\
The quantity whose sign decides whether a trajectory can leave the set of \
density matrices.\
\>", "Text",
 CellID->371825621,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"Most", "@", 
      RowBox[{"diffStrat", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}], ",",
         " ", "rs"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", ".", " ", 
         RowBox[{"driftIto", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
           "rs"}], "]"}]}]}], " ", "+", " ", 
       RowBox[{"b", " ", ".", " ", "b"}]}], ")"}], " ", "/.", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", " ", "->", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"z", "^", "2"}]}], "]"}], " ", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", " ", 
       RowBox[{"y", " ", "->", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"z", "^", "2"}]}], "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1439628390,ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[TextData[{
 "The flux points inward everywhere exactly when ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "\[LessEqual]", "2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]], "+", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 ": a detector cannot extract more information than the dephasing it causes \
pays for."
}], "Text",
 CellID->497245720,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
