Cell["Example 13.2: loss and coherent light", "Subsection",
 CellID->745178489,ExpressionUUID->"2e41722a-1026-02f0-567f-7474a1d350da"],

Cell[TextData[{
 "Loss on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aacec8a-85e6-bbaa-1a53-05d4339009f0"],
 " photons with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c51a735-fee5-6802-446e-3f7efa903b68"],
 " symbolic, and a coherent pair through a general splitter."
}], "Text",
 CellID->64377810,ExpressionUUID->"5e54a15d-ecde-9aa9-066b-39068568e8f3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Loss\>\"", "[", "eta", "]"}], "}"}], "]"}], "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", "n", "}"}], " ", "->", " ", 
      RowBox[{"{", "k", "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"bs", "[", 
    RowBox[{"\"\<Coherent\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[81]:= ",
 CellID->1276099438,ExpressionUUID->"27fb6428-ecec-27d4-4d99-7e75849e8d3e"],

Cell["\<\
The binomial loss law, and a coherent state that stays coherent with \
amplitudes rotated by the transfer matrix.\
\>", "Text",
 CellID->1651008988,ExpressionUUID->"51f5ca74-88a2-9d2c-078a-ec3e2954e476"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
