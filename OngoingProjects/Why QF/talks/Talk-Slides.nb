Cell["4.2 How close", "Subsection",
 CellID->1671903560,ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell["The largest gap, relative to the range the mean covers.", "Text",
 CellID->1307059254,ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "@", 
   RowBox[{"Abs", "[", 
    RowBox[{"mFilter", " ", "-", " ", "xGrid"}], "]"}]}], "/", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Max", "@", "xGrid"}], " ", "-", " ", 
    RowBox[{"Min", "@", "xGrid"}]}], ")"}]}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->538512558,ExpressionUUID->"2dc22b63-32d1-862f-5bf1-c34d4765ed75"],

Cell["\<\
In a quadratic potential the conditional state is a Gaussian whose center \
follows the record, so the wavefunction is never needed.\
\>", "Text",
 CellID->824717693,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

