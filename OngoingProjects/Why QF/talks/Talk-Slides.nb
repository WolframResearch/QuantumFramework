Cell["10.2 Racing the next block", "Subsection",
 CellID->263464368,ExpressionUUID->"47b49f91-c3c7-4deb-6d4b-16daf6721731"],

Cell[TextData[{
 "Blocks arrive as a Poisson process, so a 9-minute attack beats the next \
block with probability ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "9", "/", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"b", "l", "o", "c", "k"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064e3005-d89e-7c03-2e75-aa6ed92b4769"],
 ", for Bitcoin, Litecoin, Zcash and Dogecoin."
}], "Text",
 CellID->519276129,ExpressionUUID->"76c2caed-aea0-13a2-1ef1-e3b6cb556188"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "9"}], "/", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
  " ", 
  RowBox[{"{", 
   RowBox[{"10", ",", " ", "2.5", ",", " ", "1.25", ",", " ", "1"}], 
   "}"}]}]], "Input",
 CellLabel->"In[67]:= ",
 CellID->1441306302,ExpressionUUID->"260c3025-1fa9-9acd-4e33-a98f9a5de817"],

Cell["\<\
A real threat to Bitcoin transactions in flight, and negligible for the fast \
chains.\
\>", "Text",
 CellID->370920483,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

