Cell["Example 16.2: what one amplitude costs", "Subsection",
 CellID->2119433676,ExpressionUUID->"08371d00-4cf7-24ac-39cc-956a64838ef6"],

Cell[TextData[{
 "Collision-free, paired and fully bunched inputs in random networks with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "2", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e555e8f-0ad0-492d-166b-57e9af651877"],
 " modes, one amplitude each."
}], "Text",
 CellID->1666150564,ExpressionUUID->"348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"occupations", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"PadRight", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"2", " ", "n"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<collision-free\>\"", " ", "->", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", " ", "n"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<pairs\>\"", " ", "->", " ", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"Quotient", "[", 
            RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"\"\<bunched\>\"", " ", "->", " ", 
       RowBox[{"{", "n", "}"}]}]}], "|>"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"randomInterferometer", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", 
      RowBox[{"1107", " ", "+", " ", 
       RowBox[{"1000", " ", "n"}]}], "]"}], ";", " ", 
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"\"\<Random\>\"", "[", 
       RowBox[{"2", " ", "n"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"timeAmplitude", "[", 
    RowBox[{"q_", ",", " ", "s_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", " ", "=", " ", 
       RowBox[{"RotateRight", "[", 
        RowBox[{"s", ",", " ", 
         RowBox[{"Total", "[", "s", "]"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"ClearSystemCache", "[", "]"}], ";", " ", 
      RowBox[{"First", "@", 
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{"q", "[", 
         RowBox[{"\"\<Amplitude\>\"", ",", " ", 
          RowBox[{"s", " ", "->", " ", "t"}]}], "]"}], "]"}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{"Function", "[", 
    RowBox[{"n", ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", " ", "=", " ", 
         RowBox[{"randomInterferometer", "[", "n", "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"timeAmplitude", "[", 
          RowBox[{"q", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"occupations", "[", "n", "]"}]}]}], "]"}]}], "]"}], ",", "\n",
    " ", 
   RowBox[{"{", 
    RowBox[{"6", ",", " ", "12", ",", " ", "18", ",", " ", "20"}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[93]:= ",
 CellID->664696531,ExpressionUUID->"5c065349-950a-8738-043e-4b131cbcea02"],

Cell["\<\
Generic amplitudes pay the exponential cost of Ryser and Glynn while \
structured ones do not, which is why the hardness argument needs random \
networks.\
\>", "Text",
 CellID->79098559,ExpressionUUID->"4ff276a9-5e86-52e3-7582-6ff35b3320c9"]
},
