Cell["4.1 Detector efficiency", "Subsection",
 CellID->955179929,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "A detector catching a fraction ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 " rescales ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[Rule]", 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["\[Lambda]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "\[Rule]", "\[HBar]", "/", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 " in the information terms only."
}], "Text",
 CellID->775067320,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"SxE", ",", " ", "CcE", ",", " ", "SpE"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"SxSS", ",", " ", "CcSS", ",", " ", "SpSS"}], "}"}], " ", "/.", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", " ", "->", " ", 
       RowBox[{"\[Eta]", " ", "\[Lambda]"}]}], ",", " ", 
      RowBox[{"\[HBar]", " ", "->", " ", 
       RowBox[{"\[HBar]", "/", 
        RowBox[{"Sqrt", "[", "\[Eta]", "]"}]}]}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"\[HBar]", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"SxE", " ", "SpE"}], " ", "-", " ", 
          RowBox[{"CcE", "^", "2"}]}], "]"}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[HBar]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}], ",", " ", 
       
       RowBox[{"\[Lambda]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"\[Omega]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"m", " ", ">", " ", "0"}]}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Simplify", "@", 
    RowBox[{"Reduce", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sqRatio", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", "u"}], "]"}], "/", 
         RowBox[{"Sqrt", "[", "\[Eta]", "]"}]}], " ", "<=", " ", "1"}], " ", "&&",
        " ", 
       RowBox[{"u", " ", ">", " ", "0"}], " ", "&&", " ", 
       RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<", " ", "1"}]}], ",", " ",
       "u", ",", " ", "Reals"}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[27]:= ",
 CellID->72268088,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell[TextData[{
 "The steady purity is exactly ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325c8f47-cd85-89da-6263-2720e431db20"],
 ", and squeezing remains possible past a threshold ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Mu]", "TI"], "*"], "=", "2", 
   SqrtBox[
    RowBox[{"1", "-", 
     StyleBox["\[Eta]", "TI"]}]], "/", 
   SuperscriptBox[
    StyleBox["\[Eta]", "TI"], 
    RowBox[{"3", "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcea2e-12ab-c026-7183-0388a75f930c"],
 " that diverges as the detector fails."
}], "Text",
 CellID->546416532,ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
