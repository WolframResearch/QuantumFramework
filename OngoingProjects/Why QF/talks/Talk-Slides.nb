Cell[TextData[{
 StyleBox["Exact zeros are the signal.",
  FontWeight->"Bold"],
 " A Fourier tritter forbids whole families of patterns, which floating point \
would blur."
}], "Item",
 CellID->1450235700,ExpressionUUID->"5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],

Cell[TextData[{
 StyleBox["Laws for every photon number.",
  FontWeight->"Bold"],
 " Twin-Fock inputs never give odd outputs, with the distribution closed in \
binomials for all ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],
 "."
}], "Item",
