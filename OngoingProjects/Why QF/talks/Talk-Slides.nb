Cell["What to notice", "Subsection",
 CellID->1122889797,ExpressionUUID->"5640583a-c911-1fe8-7e70-5267e8a46532"],

Cell[TextData[{
 StyleBox["Numbers versus maps.",
  FontWeight->"Bold"],
 " Six numbers can be a qudit, a qubit and a qutrit, or a ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6944803a-8297-e066-1f7b-1a643723b34c"],
 " map; stored ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9e495e-a796-7cd0-26a6-611bd223463a"],
 " and represented ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534f7e63-03c8-ee33-0175-704db662b519"],
 " satisfy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox[
     RowBox[{"o", "u", "t"}], "TI"]], 
   StyleBox["C", "TI"], 
   SubsuperscriptBox[
    StyleBox["F", "TI"], 
    StyleBox[
     RowBox[{"i", "n"}], "TI"], 
    RowBox[{"-", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b07ad27-9e6a-154b-693c-44811b1f7f91"],
 "."
}], "Item",
 CellID->1606600295,ExpressionUUID->"1c7a415c-3e53-b7cb-441a-5906bbe71d11"],

Cell[TextData[{
 StyleBox["Bases are reconciled before composing.",
  FontWeight->"Bold"],
 " Contracting stored numbers can give the wrong operator."
}], "Item",
 CellID->215661095,ExpressionUUID->"417aec05-2fbb-8238-7719-066f4a4fd102"],

Cell[TextData[{
 StyleBox["One operator-space model",
