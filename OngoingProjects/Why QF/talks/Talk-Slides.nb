Cell["11.2 The syndrome distribution", "Subsection",
 CellID->532797841,ExpressionUUID->"160727ef-d1b8-0069-3e3c-bec8e04d52b3"],

Cell["For a symbolic data qubit and a symbolic error angle.", "Text",
 CellID->827514810,ExpressionUUID->"261df1b1-b81e-57af-4e22-e8fb39ab3df5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"as", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Alpha]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", "+", " ", 
       RowBox[{"\[Beta]", "^", "2"}]}], " ", "==", " ", "1"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Assuming", "[", 
  RowBox[{"as", ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", "\n", "   ", 
     RowBox[{"Diagonal", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumPartialTrace", "[", 
         RowBox[{"coded", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[71]:= ",
 CellID->1310126569,ExpressionUUID->"00ba9d2f-c328-50fc-3059-1488f6dd22c6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}], ",", 
   RowBox[{"0", ",", "0"}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["sin",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02964792-f196-8b6e-32ae-5edf8020d9b4"],
 ": the continuous rotation becomes \"no error\" or \"qubit 2 flipped\", \
independent of the data."
}], "Text",
 CellID->1253347759,ExpressionUUID->"166d4e5f-4333-9385-3e13-601976c7e1ef"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
