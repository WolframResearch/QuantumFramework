Cell["1.1 The four-number filter", "Subsection",
 CellID->108435171,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[TextData[{
 "Relax each sector toward ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " under the flips, multiply by the likelihood of the new pair of record \
increments, renormalize."
}], "Text",
 CellID->829388421,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"syndromeFilter", "[", 
    RowBox[{"p0_", ",", " ", "record_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"eta", " ", "kappa"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"FoldList", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"w", " ", "=", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"1", "/", "4"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "4"}], " ", "gamma", " ", "dt"}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{"#1", " ", "-", " ", 
                  RowBox[{"1", "/", "4"}]}], ")"}]}]}], ")"}], " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"c", " ", 
               RowBox[{"signs", " ", ".", " ", "#2"}]}], "]"}]}]}], "}"}], ",",
           " ", 
          RowBox[{"w", "/", 
           RowBox[{"Total", "[", "w", "]"}]}]}], "]"}], " ", "&"}], ",", "\n",
        "    ", "p0", ",", " ", "record"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pFilter", " ", "=", " ", 
   RowBox[{"syndromeFilter", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "0.", ",", " ", "0.", ",", " ", "0."}], "}"}], ",",
      " ", 
     RowBox[{"run", "[", "\"\<record\>\"", "]"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[4]:= ",
 CellID->203008389,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell["The filter sees nothing but the record.", "Text",
 CellID->1090263105,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
