Cell["\<\
4. Continuous Quantum Measurement, from Bayes' Rule to the Quantum Kalman \
Filter\
\>", "Section",
 CellID->891183881,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell["\<\
A particle whose position is weakly and continuously measured, in any \
potential: each step takes one noisy reading, updates the wavefunction by \
Bayes' rule, then evolves by a split-operator step.\
\>", "Text",
 CellID->741634648,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->359589406,ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell["What to notice", "Subsection",
 CellID->533832725,ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[TextData[{
 StyleBox["Measurement is literally Bayes' rule.",
  FontWeight->"Bold"],
 " The amplitude update and \"likelihood times prior\" agree to machine \
precision."
}], "Item",
 CellID->739917449,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

Cell[TextData[{
 StyleBox["Free particle: localization and heating.",
  FontWeight->"Bold"],
 " The packet narrows to a steady width while the averaged momentum variance \
grows as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 "."
}], "Item",
 CellID->473762610,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell[TextData[{
 StyleBox["A cat collapses, and the readings alone tell which way.",
  FontWeight->"Bold"],
 " A running log-odds from the outcomes tracks the hidden lobe mass."
}], "Item",
 CellID->1751712322,ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1390140890,ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell["What to notice (continued)", "Subsection",
 CellID->1031105928,ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[TextData[{
 StyleBox["Squeezing below the zero-point at any strength.",
  FontWeight->"Bold"],
 " The conditional covariances solve a Riccati equation in closed form, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], ",", 
   StyleBox["\[Omega]", "TI"], ",", 
   StyleBox["m", "TI"], ",", "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e490f1-5bc8-e939-619b-09bb5e62b803"],
 " symbolic."
}], "Item",
 CellID->1410588720,ExpressionUUID->"794a4309-908b-2549-2f4a-5b53213f8f93"],

Cell[TextData[{
 StyleBox["The quantum Kalman filter.",
  FontWeight->"Bold"],
 " Five numbers fed by the readings reproduce the conditional mean of the \
full wavefunction."
}], "Item",
 CellID->1051974278,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[TextData[{
 StyleBox["The price of an imperfect detector, in closed form.",
  FontWeight->"Bold"],
 " The steady purity is exactly ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 ", independent of trap, mass and strength."
}], "Item",
 CellID->1989924844,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

