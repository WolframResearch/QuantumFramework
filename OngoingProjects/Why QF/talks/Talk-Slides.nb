 CellID->2000873505,ExpressionUUID->"14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"finalPopulations", "[", 
        RowBox[{"n", ",", " ", 
