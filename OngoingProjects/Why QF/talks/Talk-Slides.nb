Cell["2. A Computational Guide to Open Quantum Systems", "Section",
 CellID->1234416869,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["\<\
Twenty open-system problems built from about ten shared functions on plain \
matrices, each stating its equation, computing, and checking itself against a \
closed form or a second method.\
\>", "Text",
 CellID->240380995,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1771870337,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell["What to notice", "Subsection",
 CellID->305160771,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[TextData[{
 StyleBox["Decoherence is the price of discarding the record.",
  FontWeight->"Bold"],
 " Conditioned trajectories stay pure while the ensemble average mixes."
}], "Item",
 CellID->1896945989,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[TextData[{
 StyleBox["The naive stochastic master equation fails.",
  FontWeight->"Bold"],
 " One large noise kick gives a negative eigenvalue; the Kraus-form step \
lands on the boundary of state space instead."
}], "Item",
 CellID->653417278,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[TextData[{
 StyleBox["Cats.",
  FontWeight->"Bold"],
 " Coherence dies at a rate set by the square of the separation, checked \
against the exact Kraus solution of photon loss."
}], "Item",
 CellID->1067269536,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[TextData[{
 StyleBox["Quantum Brownian motion.",
  FontWeight->"Bold"],
 " High-temperature Caldeira-Leggett is not of Lindblad form, so the \
uncertainty bound is watched directly."
}], "Item",
 CellID->49659130,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->464508221,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell["What to notice (continued)", "Subsection",
 CellID->1361313038,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[TextData[{
 StyleBox["One leak, three unravellings.",
  FontWeight->"Bold"],
 " Counting, homodyne and heterodyne give different histories with the same \
average."
}], "Item",
 CellID->1907680634,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[TextData[{
 StyleBox["Two thresholds where one is expected.",
  FontWeight->"Bold"],
 " A watched, driven qubit has an exceptional point at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 " and a Zeno freeze rate ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 "."
}], "Item",
 CellID->483148123,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[TextData[{
 StyleBox["Born's rule as a martingale.",
  FontWeight->"Bold"],
 " Every run tends to a pole while the mean stays fixed, which forces ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], "\[PlusMinus]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 "."
}], "Item",
 CellID->1195452142,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell[TextData[{
 StyleBox["Quantum Kalman filter.",
  FontWeight->"Bold"],
 " The steady conditional state sits at the Heisenberg floor for every \
measurement strength."
}], "Item",
 CellID->1521685512,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

