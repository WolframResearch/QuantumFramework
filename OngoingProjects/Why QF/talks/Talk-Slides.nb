Cell["Example 10.2: the resource arithmetic", "Subsection",
 CellID->1520041768,ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell[TextData[{
 "Google's Toffoli count at window size ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4962c-805e-a216-4e8b-087631e8f17c"],
 ", and the window that minimizes it."
}], "Text",
 CellID->862412655,ExpressionUUID->"313d5a7b-7caf-7acc-60c3-5c25755a4816"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", 
    RowBox[{"w_", ",", " ", "n_", ",", " ", "tpa_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"tpa", " ", "+", " ", 
      RowBox[{"3", " ", 
       RowBox[{"2", "^", "w"}]}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"n", "/", "w"}]}], " ", "-", " ", "4"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"T", "[", 
    RowBox[{"16", ",", " ", "256", ",", " ", "2700000"}], "]"}], ",", " ", 
   RowBox[{"First", "@", 
    RowBox[{"MinimalBy", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"4", ",", " ", "24"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"T", "[", 
        RowBox[{"#", ",", " ", "256", ",", " ", "2700000"}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[66]:= ",
 CellID->426217663,ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"],

Cell["\<\
The formula reproduces the reported bound, and the optimum sits where the \
lookup-table cost starts to rival the point addition.\
\>", "Text",
 CellID->128954499,ExpressionUUID->"39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],

