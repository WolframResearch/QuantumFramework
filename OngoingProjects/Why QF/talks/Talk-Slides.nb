Cell["5. Transmon cQED: Wolfram and Qolab", "Section",
 CellID->2009363188,ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell["\<\
The demo shown at APS 2026 with Qolab: from the transmon circuit Hamiltonian \
to a prepared qubit state, down to single-shot (I, Q) points at the \
digitizer, and the same analysis on real hardware data.\
\>", "Text",
 CellID->55669068,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1753574084,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell["What to notice", "Subsection",
 CellID->2038359728,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[TextData[{
 StyleBox["From circuit to qubit.",
  FontWeight->"Bold"],
 " The Cooper-pair-box Hamiltonian ",
 Cell[BoxData[
  RowBox[{"4", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["n", "TI"], "^"], "-", 
      SubscriptBox[
       StyleBox["n", "TI"], 
       StyleBox["g", "TI"]]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["\[Phi]", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 ", and the spectrum flattening against offset charge as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["J", "TI"]], "/", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["C", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 " grows."
}], "Item",
 CellID->1525364821,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[TextData[{
 StyleBox["Any state with two hardware operations.",
  FontWeight->"Bold"],
 " A virtual Z followed by one calibrated pulse reaches any ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 "."
}], "Item",
 CellID->1535108406,ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell[TextData[{
 StyleBox["Measurement is a cavity, not a projector.",
  FontWeight->"Bold"],
 " The readout resonator rings up along two qubit-dependent spirals whose \
separation sets the signal-to-noise."
}], "Item",
 CellID->1528788962,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1505774531,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell["What to notice (continued)", "Subsection",
 CellID->535490749,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[TextData[{
 StyleBox["The whole chain, both directions.",
  FontWeight->"Bold"],
 " Simulated single-shot IQ records, then Gaussian-mixture fitting, \
assignment errors and maximum-likelihood tomography."
}], "Item",
 CellID->1238905205,ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell[TextData[{
 StyleBox["Real hardware in the same pipeline.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData["QolabExperiment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13db9173-5387-1c16-41f8-093d6632677c"],
 " returns IQ data from a Qolab qubit, analyzed by the identical code."
}], "Item",
 CellID->2125008310,ExpressionUUID->"6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],

Cell[TextData[{
 StyleBox["Decoherence and DRAG,",
  FontWeight->"Bold"],
 " with leakage to ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 " in a three-level simulation."
}], "Item",
 CellID->1684656716,ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2057792111,ExpressionUUID->"070f3e08-556d-9d60-2d34-b0525c19e44a"],

Cell["Example 5.1: arbitrary state preparation from the pulse area", \
"Subsection",
 CellID->408837332,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell["\<\
Load TransmonLab, define the device, a Gaussian drive pulse and a flat-top \
readout pulse.\
\>", "Text",
 CellID->1068510841,ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/mbahram/TransmonLab/\
TransmonLab/\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<TransmonLab`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sys", " ", "=", " ", 
   RowBox[{"TransmonSystem", "[", 
    RowBox[{
     RowBox[{"\"\<QubitFrequency\>\"", " ", "->", " ", 
      RowBox[{"5.10", "*", 
       RowBox[{"10", "^", "9"}]}]}], ",", " ", 
     RowBox[{"\"\<ResonatorFrequency\>\"", " ", "->", " ", 
      RowBox[{"6.00", "*", 
       RowBox[{"10", "^", "9"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Anharmonicity\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"-", "220"}], "*", 
       RowBox[{"10", "^", "6"}]}]}], ",", " ", 
     RowBox[{"\"\<Coupling\>\"", " ", "->", " ", 
      RowBox[{"100", "*", 
       RowBox[{"10", "^", "6"}]}]}], ",", " ", 
     RowBox[{"\"\<CavityLinewidth\>\"", " ", "->", " ", 
      RowBox[{"1", "*", 
       RowBox[{"10", "^", "6"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<T1\>\"", " ", "->", " ", 
      RowBox[{"50", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], ",", " ", 
     RowBox[{"\"\<T2\>\"", " ", "->", " ", 
      RowBox[{"30", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], ",", " ", 
     RowBox[{"\"\<OmegaMax\>\"", " ", "->", " ", 
      RowBox[{"2", " ", "Pi", "*", "42", "*", 
       RowBox[{"10", "^", "6"}]}]}], ",", " ", 
     RowBox[{"\"\<EpsilonMax\>\"", " ", "->", " ", 
      RowBox[{"2", " ", "Pi", "*", "5", "*", 
       RowBox[{"10", "^", "6"}]}]}], ",", " ", 
     RowBox[{"\"\<NMax\>\"", " ", "->", " ", "5"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gaussPulse", " ", "=", " ", 
   RowBox[{"Pulse", "[", 
    RowBox[{"\"\<Gaussian\>\"", ",", " ", "50"}], "]"}]}], ";", " ", 
  RowBox[{"readoutPulse", " ", "=", " ", 
   RowBox[{"Pulse", "[", 
    RowBox[{"\"\<FlatTop\>\"", ",", " ", "500", ",", " ", 
     RowBox[{"\"\<RiseTime\>\"", " ", "->", " ", "10"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[32]:= ",
 CellID->1027032549,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell["The device is a list of named physical parameters.", "Text",
 CellID->171792661,ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->574949478,ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],

Cell["5.1 Calibration from the pulse area", "Subsection",
 CellID->1664775781,ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"],

Cell[TextData[{
 "On resonance only the pulse area matters: rotation angle per unit amplitude \
is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["max",
     FontSlant->"Plain"]], 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],
 "."
}], "Text",
 CellID->884697794,ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"thetaPerA", " ", "=", " ", 
   RowBox[{
    RowBox[{"sys", "[", "\"\<OmegaMax\>\"", "]"}], " ", 
    RowBox[{"gaussPulse", "[", "\"\<EnvelopeArea\>\"", "]"}], " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "9"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->784201795,ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"],

Cell["One number calibrates every rotation.", "Text",
 CellID->1193259712,ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1084903799,ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"],

Cell[TextData[{
 "5.1 Prepare ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "\[Pi]", "/", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04469009-6b02-dcc3-2c7d-0a530eb4a629"]
}], "Subsection",
 CellID->964492758,ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell["\<\
One frame rotation, one scaled pulse, then readout; compare the simulated \
Bloch vector with the target.\
\>", "Text",
 CellID->242210635,ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"thT", ",", " ", "phT"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pi", "/", "3"}], ",", " ", 
     RowBox[{"Pi", "/", "6"}]}], "}"}]}], ";", " ", 
  RowBox[{"aT", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"thT", "/", "thetaPerA"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"seq", " ", "=", " ", 
   RowBox[{"PulseSequence", "[", 
    RowBox[{
     RowBox[{"FrameRotation", "[", 
      RowBox[{"\"\<Qubit\>\"", ",", " ", 
       RowBox[{"phT", " ", "+", " ", 
        RowBox[{"Pi", "/", "2"}]}]}], "]"}], ",", " ", 
     RowBox[{"Drive", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Amplitude", "[", "aT", "]"}], "@", "gaussPulse"}], ",", 
       " ", "\"\<Qubit\>\""}], "]"}], ",", "\n", "   ", 
     RowBox[{"Sync", "[", 
      RowBox[{"\"\<Qubit\>\"", ",", " ", "\"\<Resonator\>\""}], "]"}], ",", 
     " ", 
     RowBox[{"Readout", "[", 
      RowBox[{
      "readoutPulse", ",", " ", "\"\<Resonator\>\"", ",", " ", "500"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"res", " ", "=", " ", 
   RowBox[{"TransmonPhysics", "[", 
    RowBox[{"sys", ",", " ", "seq", ",", " ", 
     RowBox[{"\"\<Model\>\"", " ", "->", " ", "\"\<QubitOnly\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bz", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{
       RowBox[{"gaussPulse", "[", "\"\<Duration\>\"", "]"}], " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{"res", "[", "\"\<BlochTrajectories\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"bz", ",", " ", 
   RowBox[{"N", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "thT", "]"}], " ", 
       RowBox[{"Cos", "[", "phT", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "thT", "]"}], " ", 
       RowBox[{"Sin", "[", "phT", "]"}]}], ",", " ", 
      RowBox[{"Cos", "[", "thT", "]"}]}], "}"}]}]}], "}"}]}], "Input",
 CellLabel->"In[34]:= ",
 CellID->360816480,ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell["\<\
The simulated state lands on the analytic target to the accuracy the \
truncated Gaussian envelope allows.\
\>", "Text",
 CellID->1505759259,ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1384053022,ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"],

Cell["5.1 The same constant as a Power Rabi sweep", "Subsection",
 CellID->1395659232,ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell["Sweep the drive amplitude.", "Text",
 CellID->874592789,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TransmonPhysics", "[", 
   RowBox[{"sys", ",", " ", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"Drive", "[", 
       RowBox[{"gaussPulse", ",", " ", "\"\<Qubit\>\""}], "]"}], ",", " ", 
      RowBox[{"Sync", "[", 
       RowBox[{"\"\<Qubit\>\"", ",", " ", "\"\<Resonator\>\""}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"Readout", "[", 
       RowBox[{
       "readoutPulse", ",", " ", "\"\<Resonator\>\"", ",", " ", "500"}], 
       "]"}]}], "]"}], ",", " ", 
    RowBox[{"Sweep", "[", 
     RowBox[{"\"\<Amplitude\>\"", ",", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", "1", ",", " ", "0.02"}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"\"\<Model\>\"", " ", "->", " ", "\"\<QubitOnly\>\""}]}], "]"}], 
  "[", "\"\<Plot\>\"", "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->1596157938,ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell["\<\
The calibration constant appears experimentally as the period of the Rabi \
oscillation.\
\>", "Text",
 CellID->1496122589,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1956327387,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

Cell["Example 5.2: from the digitizer back to the Bloch vector", "Subsection",
 CellID->1131177628,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell["The cavity pointer states, one spiral per qubit state.", "Text",
 CellID->611195905,ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dr", " ", "=", " ", 
   RowBox[{"DispersiveReadout", "[", 
    RowBox[{"sys", ",", " ", "readoutPulse"}], "]"}]}], ";"}], "\n", 
 RowBox[{"IQPlot", "[", "dr", "]"}]}], "Input",
 CellLabel->"In[36]:= ",
 CellID->1202919897,ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell["Their separation is what the readout can distinguish.", "Text",
 CellID->1334651244,ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->185339758,ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell["5.2 Single shots in three bases", "Subsection",
 CellID->1677030473,ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[TextData[{
 "Prepare the target rotated into each tomography basis and simulate 200 \
noisy shots per basis. ",
 Cell[BoxData["IQAnalysis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 " warns that the linear-inversion estimate is unphysical."
}], "Text",
 CellID->134345938,ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bv", " ", "=", " ", 
   RowBox[{"BlochVector", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"thT", "/", "2"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "phT"}], "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"thT", "/", "2"}], "]"}]}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"thX", ",", " ", "phX"}], "}"}], " ", "=", " ", 
   RowBox[{"N", "@", 
    RowBox[{"Rest", "@", 
     RowBox[{"ToSphericalCoordinates", "[", 
      RowBox[{
       RowBox[{"RotationMatrix", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}]}], "]"}], " ", ".",
        " ", "bv"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"thY", ",", " ", "phY"}], "}"}], " ", "=", " ", 
   RowBox[{"N", "@", 
    RowBox[{"Rest", "@", 
     RowBox[{"ToSphericalCoordinates", "[", 
      RowBox[{
       RowBox[{"RotationMatrix", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}], " ", ".",
        " ", "bv"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"iqt", " ", "=", " ", 
   RowBox[{"IQTrajectory", "[", 
    RowBox[{"sys", ",", " ", "dr", ",", " ", 
     RowBox[{"\"\<Bases\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\"", ",", " ", "\"\<z\>\""}], 
       "}"}]}], ",", " ", 
     RowBox[{"\"\<NShots\>\"", " ", "->", " ", "200"}], ",", "\n", "   ", 
     RowBox[{"\"\<InitialStates\>\"", " ", "->", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<z\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1.0", ",", " ", "thT", ",", " ", "phT"}], "}"}]}], ",", 
        " ", 
        RowBox[{"\"\<x\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1.0", ",", " ", "thX", ",", " ", "phX"}], "}"}]}], ",", 
        " ", 
        RowBox[{"\"\<y\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1.0", ",", " ", "thY", ",", " ", "phY"}], "}"}]}]}], 
       "|>"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<Seed\>\"", " ", "->", " ", "123"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"iqa", " ", "=", " ", 
   RowBox[{"IQAnalysis", "[", 
    RowBox[{"iqt", "[", "\"\<MeasurementData\>\"", "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[37]:= ",
 CellID->350820043,ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell["The analysis sees only clouds of (I, Q) points.", "Text",
 CellID->456450236,ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1767337052,ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell["5.2 Maximum-likelihood reconstruction", "Subsection",
 CellID->1422053341,ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell["\<\
Reconstruct inside the Bloch ball and compare with the target.\
\>", "Text",
 CellID->603286833,ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"target", " ", "=", " ", 
   RowBox[{"N", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "thT", "]"}], " ", 
       RowBox[{"Cos", "[", "phT", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "thT", "]"}], " ", 
       RowBox[{"Sin", "[", "phT", "]"}]}], ",", " ", 
      RowBox[{"Cos", "[", "thT", "]"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mleB", " ", "=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"iqa", "[", "\"\<DensityMatrixMLE\>\"", "]"}], " ", ".", " ", 
        "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"(", 
      RowBox[{"PauliMatrix", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], ")"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"mleB", ",", " ", 
   RowBox[{"Norm", "[", 
    RowBox[{"mleB", " ", "-", " ", "target"}], "]"}], ",", " ", 
   RowBox[{"iqa", "[", "\"\<BlochVectorAround\>\"", "]"}]}], "}"}]}], "Input",\

 CellLabel->"In[38]:= ",
 CellID->1349832744,ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

Cell[TextData[{
 "The reconstructed Bloch vector lands near the prepared one; swapping in the \
table from ",
 Cell[BoxData["QolabExperiment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 " runs the identical analysis on hardware."
}], "Text",
 CellID->16034565,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->344152329,ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell["6. The Gravitational Soliton", "Section",
 CellID->622383932,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell["\<\
Can a quantum particle be held together by its own gravity? In the \
Schrodinger-Newton equation the wavefunction moves in the potential sourced \
by its own mass density, and quantum spreading balances self-gravity in a \
stationary soliton.\
\>", "Text",
 CellID->2102744249,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->565659401,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell["What to notice", "Subsection",
 CellID->561487989,ExpressionUUID->"4670f053-f537-0b3f-6e0f-ea1cfcc25605"],

Cell[TextData[{
 StyleBox["The scale in one line.",
  FontWeight->"Bold"],
 " Minimizing ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[HBar]", "2"], "/", 
   StyleBox["m", "TI"], 
   SuperscriptBox["\[ScriptL]", "2"], "-", 
   StyleBox["G", "TI"], 
   SuperscriptBox[
    StyleBox["m", "TI"], "2"], "/", "\[ScriptL]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptL]", "\[FivePointedStar]"], "=", 
   SuperscriptBox["\[HBar]", "2"], "/", 
   StyleBox["G", "TI"], 
   SuperscriptBox[
    StyleBox["m", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 ": astronomical for an electron, laboratory-sized for a heavy nanoparticle."
}], "Item",
 CellID->2021628840,ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"],

Cell[TextData[{
 StyleBox["A self-consistent loop.",
  FontWeight->"Bold"],
 " Newton's equation and a radial Schrodinger eigenproblem on a \
finite-element mesh alternate until the energy stops changing."
}], "Item",
 CellID->41425461,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell[TextData[{
 StyleBox["The box is removed, not ignored.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"\[CapitalPhi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["R", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 " shifts the energy by ",
 Cell[BoxData[
  RowBox[{"+", "1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 "; a fit over six boxes recovers the Moroz-Penrose-Tod energy."
}], "Item",
 CellID->1208764476,ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1584634344,ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell["What to notice (continued)", "Subsection",
 CellID->35679398,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell[TextData[{
 StyleBox["A check the solver never saw.",
  FontWeight->"Bold"],
 " The virial identity ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["T", "TI"], "+", 
   StyleBox["W", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 " forces ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", 
   StyleBox["E", "TI"], "=", "-", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 "; the raw solution misses it by exactly the boundary shift."
}], "Item",
 CellID->1113372800,ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[TextData[{
 StyleBox["Excited solitons.",
  FontWeight->"Bold"],
 " The first three bound states have zero, one and two radial nodes, each in \
its own ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 "-tailed potential."
}], "Item",
 CellID->969867355,ExpressionUUID->"2207e002-80f7-0285-523c-fa6c308250ef"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1210037699,ExpressionUUID->"440467ae-8db5-79b4-6c3c-7e0824404b9e"],

Cell["Example 6.1: the natural length scale", "Subsection",
 CellID->1239892393,ExpressionUUID->"141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],

Cell["Balance kinetic against gravitational energy.", "Text",
 CellID->1498748757,ExpressionUUID->"3d27d006-86b8-9131-64dc-ca603332e01b"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[HBar]", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"m", " ", 
          RowBox[{"l", "^", "2"}]}], ")"}]}], " ", "-", " ", 
       RowBox[{"G", " ", 
        RowBox[{
         RowBox[{"m", "^", "2"}], "/", "l"}]}]}], ",", " ", "l"}], "]"}], " ",
     "==", " ", "0"}], ",", " ", "l"}], "]"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->1701544389,ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\[ScriptL]", "=", 
   SuperscriptBox["\[HBar]", "2"], "/", 
   StyleBox["G", "TI"], 
   SuperscriptBox[
    StyleBox["m", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"],
 ": the only length the problem has."
}], "Text",
 CellID->1682415361,ExpressionUUID->"1287d3f9-6500-de4e-42bc-caa30cbaa494"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1697357464,ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell["6.1 One solver for each half of the loop", "Subsection",
 CellID->1540797058,ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"],

Cell["\<\
The radial Newton operator, the Schrodinger component, and solvers for each.\
\>", "Text",
 CellID->768596373,ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"newtonOp", " ", "=", " ", 
   RowBox[{"Laplacian", "[", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "r", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], ",", 
     " ", "\"\<Spherical\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hamiltonianOp", " ", "=", " ", 
   RowBox[{"SchrodingerPDEComponent", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "[", "r", "]"}], ",", " ", 
       RowBox[{"{", "r", "}"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ReducedPlanckConstant\>\"", " ", "->", " ", "1"}], ",", 
       " ", 
       RowBox[{"\"\<SchrodingerPotential\>\"", " ", "->", " ", 
        RowBox[{"\[CapitalPhi]", "[", "r", "]"}]}]}], "|>"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sortStates", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", "s", "]"}], ",", " ", "Re"}], "]"}], " ", "//",
     " ", "Transpose"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solveNewton", "[", 
    RowBox[{"uFunc_", ",", " ", "mesh_"}], "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"newtonOp", " ", "==", " ", 
        RowBox[{
         RowBox[{"uFunc", "^", "2"}], "/", 
         RowBox[{"r", "^", "2"}]}]}], ",", "\n", "    ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalPhi]", "[", "r", "]"}], " ", "==", " ", "0"}], ",",
          " ", 
         RowBox[{"r", " ", "==", " ", 
          RowBox[{
           RowBox[{"mesh", "[", "\"\<Bounds\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "]"}]}], "}"}], ",",
      " ", "\[CapitalPhi]", ",", " ", 
     RowBox[{
      RowBox[{"{", "r", "}"}], " ", "\[Element]", " ", "mesh"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solveSchrodinger", "[", 
    RowBox[{"PhiIn_", ",", " ", "mesh_"}], "]"}], " ", ":=", " ", 
   RowBox[{"sortStates", "@", 
    RowBox[{"NDEigensystem", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"hamiltonianOp", " ", "/.", " ", 
         RowBox[{"\[CapitalPhi]", " ", "->", " ", "PhiIn"}]}], ",", " ", 
        RowBox[{"DirichletCondition", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "r", "]"}], " ", "==", " ", "0"}], ",", " ", 
          "True"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"u", "[", "r", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", "r", "}"}], " ", "\[Element]", " ", "mesh"}], ",", " ", 
      "3", ",", "\n", "   ", 
      RowBox[{"Method", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<Eigensystem\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Arnoldi\>\"", ",", " ", 
            RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "3000"}], ",", 
            " ", 
            RowBox[{"\"\<BasisSize\>\"", " ", "->", " ", "50"}], ",", " ", 
            RowBox[{"\"\<Shift\>\"", " ", "->", " ", 
             RowBox[{"-", "10"}]}]}], "}"}]}], ",", "\n", "     ", 
         RowBox[{"\"\<Interpolation\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<ExtrapolationHandler\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", " ", 
              RowBox[{"\"\<WarningMessage\>\"", " ", "->", " ", "False"}]}], 
             "}"}]}], "}"}]}]}], "}"}]}]}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[40]:= ",
 CellID->1985169054,ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell["Each half is an ordinary finite-element problem.", "Text",
 CellID->770675313,ExpressionUUID->"13ecd9ee-6506-67bb-4193-d0c80cb34d81"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->846554368,ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell["6.1 Iterate to self-consistency, in six boxes", "Subsection",
 CellID->1952818843,ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

Cell[TextData[{
 "Start from a normalized Gaussian and iterate until the eigenvalue settles, \
then fit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["R", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], "\[Infinity]"], "+", 
   StyleBox["C", "TI"], "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 ". This cell takes several minutes."
}], "Text",
 CellID->599175116,ExpressionUUID->"696f5b1d-d56b-3a26-1f15-5346dc1f890c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"solveSN", "[", 
    RowBox[{"Rval_", ",", " ", "nEl_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mesh", ",", " ", 
       RowBox[{"s", " ", "=", " ", "3"}], ",", " ", "uk", ",", " ", "phik", ",",
        " ", "ek", ",", " ", 
       RowBox[{"eOld", " ", "=", " ", "Infinity"}], ",", " ", 
       RowBox[{"iter", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"mesh", " ", "=", " ", 
       RowBox[{"ToGradedMesh", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", " ", 
             RowBox[{"{", "Rval", "}"}]}], "}"}], "]"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Alignment\>\"", " ", "->", " ", "\"\<Left\>\""}], ",",
             " ", 
            RowBox[{"\"\<ElementCount\>\"", " ", "->", " ", "nEl"}]}], 
           "|>"}]}], "}"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"uk", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"(", 
           RowBox[{"7", "/", "4"}], ")"}]}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"s", "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}], " ", 
           RowBox[{"Pi", "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "4"}], ")"}]}]}], ")"}]}], " ", "r", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"r", "^", "2"}]}], "/", 
          RowBox[{"s", "^", "2"}]}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"phik", " ", "=", " ", 
       RowBox[{"solveNewton", "[", 
        RowBox[{"uk", ",", " ", "mesh"}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ek", ",", " ", "uk"}], "}"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "}"}], " ", "&"}], 
        "@", 
        RowBox[{"solveSchrodinger", "[", 
         RowBox[{"phik", ",", " ", "mesh"}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"ek", " ", "-", " ", "eOld"}], "]"}], " ", ">", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}]}], " ", "&&", " ", 
         RowBox[{"iter", " ", "<", " ", "120"}]}], ",", " ", 
        RowBox[{
         RowBox[{"eOld", " ", "=", " ", "ek"}], ";", " ", 
         RowBox[{"phik", " ", "=", " ", 
          RowBox[{"solveNewton", "[", 
           RowBox[{"uk", ",", " ", "mesh"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ek", ",", " ", "uk"}], "}"}], " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "}"}], " ", 
            "&"}], "@", 
           RowBox[{"solveSchrodinger", "[", 
            RowBox[{"phik", ",", " ", "mesh"}], "]"}]}]}], ";", " ", 
         RowBox[{"iter", "++"}]}]}], "]"}], ";", "\n", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<R\>\"", " ", "->", " ", "Rval"}], ",", " ", 
        RowBox[{"\"\<Energy\>\"", " ", "->", " ", "ek"}], ",", " ", 
        RowBox[{"\"\<Iterations\>\"", " ", "->", " ", "iter"}], ",", " ", 
        RowBox[{"\"\<u\>\"", " ", "->", " ", 
         RowBox[{"Head", "[", "uk", "]"}]}], ",", " ", 
        RowBox[{"\"\<Phi\>\"", " ", "->", " ", "phik"}]}], "|>"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"results", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"solveSN", "[", 
      RowBox[{"Rv", ",", " ", "8000"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Rv", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "20", ",", " ", "40", ",", " ", "60", ",", " ", "100", ",", " ", 
         "200", ",", " ", "300"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"fit", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#R", ",", " ", "#Energy"}], "}"}], " ", "&"}], " ", "/@", " ",
      "results"}], ",", " ", 
    RowBox[{"e", " ", "+", " ", 
     RowBox[{"c", "/", "rr"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"e", ",", " ", "c"}], "}"}], ",", " ", "rr"}], "]"}]}]}], "Input",\

 CellLabel->"In[41]:= ",
 CellID->1234886004,ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[TextData[{
 "The fit recovers the literature ground-state energy and ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640353f1-ff8e-e9b3-0c31-4abafa38bb99"],
 " at the predicted value one: the whole finite-box error is the missing ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37161f66-4600-a3a8-5d2d-974073baf1f2"],
 " tail."
}], "Text",
 CellID->1955603644,ExpressionUUID->"2e44757e-c407-f813-567c-6d3bedb3cb79"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->529524776,ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell["6.1 Every box on one line", "Subsection",
 CellID->186212144,ExpressionUUID->"539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],

Cell[TextData[{
 "Raw energies and energies with ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " removed."
}], "Text",
 CellID->284725946,ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#R", ",", " ", "#Energy"}], "}"}], " ", "&"}], " ", "/@", 
      " ", "results"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#R", ",", " ", 
         RowBox[{"#Energy", " ", "-", " ", 
          RowBox[{"1", "/", "#R"}]}]}], "}"}], " ", "&"}], " ", "/@", " ", 
      "results"}]}], "}"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<E(R)\>\"", ",", " ", "\"\<E(R) - 1/R\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<R\>\"", ",", " ", "\"\<E\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", "Dashed", ",", " ", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"e", " ", "/.", " ", "fit"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->1006536905,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell["\<\
Subtracting the boundary shift collapses every box onto the infinite-box \
value.\
\>", "Text",
 CellID->207506748,ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1146295856,ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

Cell["Example 6.2: the virial identity as an independent check", "Subsection",
 CellID->438365529,ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],

Cell["\<\
Kinetic and potential energy of the largest-box ground state.\
\>", "Text",
 CellID->174000849,ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", " ", "=", " ", 
   RowBox[{"Last", "[", "results", "]"}]}], ";", " ", 
  RowBox[{"u0", " ", "=", " ", 
   RowBox[{"sol", "[", "\"\<u\>\"", "]"}]}], ";", " ", 
  RowBox[{"Phi0", " ", "=", " ", 
   RowBox[{"sol", "[", "\"\<Phi\>\"", "]"}]}], ";", " ", 
  RowBox[{"e0", " ", "=", " ", 
   RowBox[{"sol", "[", "\"\<Energy\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u0", "[", "r", "]"}], ",", " ", "r"}], "]"}], "^", "2"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "300"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"v", " ", "=", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi0", "[", "r", "]"}], " ", 
      RowBox[{
       RowBox[{"u0", "[", "r", "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "300"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"t", " ", "+", " ", "v", " ", "-", " ", "e0"}], ",", " ", 
   RowBox[{"t", "/", "e0"}], ",", " ", 
   RowBox[{"t", "/", 
    RowBox[{"(", 
     RowBox[{"e0", " ", "-", " ", 
      RowBox[{"1", "/", "300"}]}], ")"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], " ", "t"}], " ", "-", " ", "e0"}], ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "300."}]}], "}"}]}], "}"}]}], "Input",
 CellLabel->"In[43]:= ",
 CellID->766726627,ExpressionUUID->"41c6bfc6-0792-5005-77fd-36a0b227236f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "+", 
   StyleBox["V", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 " reproduces the eigenvalue; the raw ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 " misses ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 " by exactly the boundary shift, and removing it restores the virial value."
}], "Text",
 CellID->1506609767,ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->281363281,ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell["7. The Stabilizer Formalism by Computation", "Section",
 CellID->1615544595,ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[TextData[{
 "A state named by the Pauli operators that fix it: ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 " generators replace ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 " amplitudes, Clifford gates become bit rewrites of a tableau, and one \
object carries the reader from one qubit to a thousand, then to codes, magic \
and noise."
}], "Text",
 CellID->1805673747,ExpressionUUID->"67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1547520620,ExpressionUUID->"233ecb8e-17f3-8d32-52c5-e2e8a187d418"],

Cell["What to notice", "Subsection",
 CellID->858350929,ExpressionUUID->"7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],

Cell[TextData[{
 StyleBox["Why Paulis, precisely.",
  FontWeight->"Bold"],
 " Every state is fixed by some operator; four properties of the Pauli group \
make the description pay."
}], "Item",
 CellID->2138894257,ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

Cell[TextData[{
 StyleBox["Schrodinger and Heisenberg meet.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 " stays one Pauli string, while ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], 
   StyleBox["X", "TI"], 
   SuperscriptBox[
    StyleBox["T", "TI"], "\[Dagger]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], "+", 
    StyleBox["Y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 " shows where the method breaks."
}], "Item",
 CellID->1941039383,ExpressionUUID->"7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],

Cell[TextData[{
 StyleBox["Stabilizer states are flat.",
  FontWeight->"Bold"],
 " A uniform superposition over an affine subspace of ",
 Cell[BoxData[
  SubsuperscriptBox["\|01d53d", "2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 "."
}], "Item",
 CellID->1670620029,ExpressionUUID->"1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],

Cell[TextData[{
 StyleBox["Entanglement is a rank.",
  FontWeight->"Bold"],
 " Entropy across a cut is an ",
 Cell[BoxData[
  SubscriptBox["\|01d53d", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c80315-d7de-7125-4ff7-9b5ee26b400f"],
 " rank, fast even for a thousand qubits."
}], "Item",
 CellID->588214459,ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1759496502,ExpressionUUID->"7a87483f-bfa4-2eb6-2abd-62793a51749c"],

Cell["What to notice (continued)", "Subsection",
 CellID->1641757231,ExpressionUUID->"09b26917-59e6-8729-3f41-81515f90ea73"],

Cell[TextData[{
 StyleBox["Measurement without branching.",
  FontWeight->"Bold"],
 " Each random outcome is carried as a formal bit, so correlations come out \
as Boolean relations."
}], "Item",
 CellID->896279625,ExpressionUUID->"521ad179-838d-ce9b-0239-c923363994e1"],

Cell[TextData[{
 StyleBox["Codes.",
  FontWeight->"Bold"],
 " The five-qubit code's fifteen single-qubit errors map one-to-one onto the \
fifteen nonzero syndromes."
}], "Item",
 CellID->1264190945,ExpressionUUID->"136d7364-bcfb-8461-4113-6b4e348fef4b"],

Cell[TextData[{
 StyleBox["Past the Clifford edge.",
  FontWeight->"Bold"],
 " Stabilizer rank grows as ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],
 " T gates, independent of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 "."
}], "Item",
 CellID->1806910998,ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell[TextData[{
 StyleBox["An honest benchmark",
  FontWeight->"Bold"],
 " against Stim and QuantumClifford.jl, stating where QF is behind and what \
it offers instead."
}], "Item",
 CellID->962064851,ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1660212291,ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

Cell["Example 7.1: the perfect code's syndrome table", "Subsection",
 CellID->1553450743,ExpressionUUID->"66ca9132-7812-8248-0ec9-097c79a4d092"],

Cell["\<\
The five-qubit code, its four checks, and the syndrome of each single-qubit \
error.\
\>", "Text",
 CellID->376345483,ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"code", " ", "=", " ", 
   RowBox[{"PauliStabilizer", "[", "\"\<5QubitCode\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"Most", "[", 
    RowBox[{"code", "[", "\"\<Stabilizers\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"syndrome", "[", "err_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"code", "[", "err", "]"}], "[", 
          RowBox[{"\"\<Expectation\>\"", ",", " ", "#"}], "]"}], " ", "&"}], 
        " ", "/@", " ", "checks"}], ")"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"errors", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "->", " ", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}],
           "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], ",", " ",
      "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{"syndrome", ",", " ", "errors"}], "]"}]}], "Input",
 CellLabel->"In[44]:= ",
 CellID->1917523023,ExpressionUUID->"29a4f364-fd74-7ca4-5f5b-eb41f401468e"],

Cell["\<\
Each of the fifteen errors flips a different pattern of the four checks.\
\>", "Text",
 CellID->225924774,ExpressionUUID->"47740231-7fc8-4299-6d0b-a47b7a7d10e3"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1508526016,ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"],

Cell["7.1 What \"perfect\" means", "Subsection",
 CellID->1653333794,ExpressionUUID->"2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],

Cell["\<\
Are the patterns exactly the fifteen nonzero four-bit strings?\
\>", "Text",
 CellID->2117504204,ExpressionUUID->"5782d92f-a790-094a-7db1-d088d2255b90"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{"syndrome", " ", "/@", " ", "errors"}], "]"}], " ", "===", " ", 
  RowBox[{"Sort", "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->201091240,ExpressionUUID->"05d48452-325d-a277-33eb-1e1c47e9f15d"],

Cell["None missing and none repeated.", "Text",
 CellID->667003370,ExpressionUUID->"087ffcf6-194e-431e-3804-f5b098fb2e64"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->526043023,ExpressionUUID->"615fadf7-df9a-5675-1764-44b0da2f3d5f"],

Cell["7.1 A thousand-qubit GHZ state", "Subsection",
 CellID->1120596176,ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell["\<\
Entanglement entropy across one qubit and across half the chain, without a \
state vector.\
\>", "Text",
 CellID->64105026,ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ghz", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "1000", "]"}], "[", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "q"}], "}"}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "2", ",", " ", "1000"}], "}"}]}], "]"}], ",", 
      " ", "\"\<H\>\""}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"ghz", "[", 
     RowBox[{"\"\<Entropy\>\"", ",", " ", 
      RowBox[{"{", "1", "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"ghz", "[", 
    RowBox[{"\"\<Entropy\>\"", ",", " ", 
     RowBox[{"Range", "[", "500", "]"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[46]:= ",
 CellID->1373525465,ExpressionUUID->"519a4e0d-3467-bfb9-07ba-6057bd130583"],

Cell["\<\
One bit either way: GHZ entanglement is a single shared parity, however the \
chain is cut.\
\>", "Text",
 CellID->1964307623,ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->39040159,ExpressionUUID->"0dbacffa-31b0-43f6-3b59-e6a4404511dc"],

Cell["Example 7.2: measurement outcomes as algebra", "Subsection",
 CellID->1242473813,ExpressionUUID->"196a859c-b643-c1b3-4f69-1cd9c3f79399"],

Cell["\<\
Copy the parity of two random qubits onto a third, then measure all three \
symbolically.\
\>", "Text",
 CellID->290269587,ExpressionUUID->"48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parityCheck", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "3", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"smPar", " ", "=", " ", 
   RowBox[{"parityCheck", "[", 
    RowBox[{"\"\<SymbolicMeasure\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"smPar", "[", "\"\<Stabilizers\>\"", "]"}]}], "Input",
 CellLabel->"In[47]:= ",
 CellID->471335900,ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"],

Cell[TextData[{
 "Only two fresh outcome bits appear, because the conserved ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "Z", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3597ba8d-914b-928f-63ac-33d720ffe0d5"],
 " fixes the third."
}], "Text",
 CellID->1843091513,ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1978684664,ExpressionUUID->"383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],

Cell["7.2 Reading outcomes by substitution", "Subsection",
 CellID->2064137570,ExpressionUUID->"7b649e79-a2e1-7610-291b-1022d6945d7a"],

Cell["\<\
Substitute the free bits over all assignments, then draw a thousand samples \
by substitution alone.\
\>", "Text",
 CellID->1265784226,ExpressionUUID->"09cb884c-5fc8-b209-3fc8-22165a620153"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"readBits", "[", "ps_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "@", 
    RowBox[{"Keys", "@", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"ps", "[", "\"\<Qubits\>\"", "]"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{"ps", "[", "\"\<State\>\"", "]"}], 
           "[", "\"\<StateVector\>\"", "]"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", " ", "!=", " ", "0"}], " ", "&"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"free", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"smPar", "[", "\"\<Phase\>\"", "]"}], ",", " ", 
      RowBox[{"\[FormalS]", "[", "_", "]"}], ",", " ", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"readBits", "[", 
      RowBox[{"smPar", "[", 
       RowBox[{"\"\<SubstituteOutcomes\>\"", ",", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"free", " ", "->", " ", "#"}], "]"}]}], "]"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"Length", "[", "free", "]"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
    RowBox[{"Counts", "[", 
     RowBox[{"readBits", " ", "/@", " ", 
      RowBox[{"smPar", "[", 
       RowBox[{"\"\<SampleOutcomes\>\"", ",", " ", "1000"}], "]"}]}], 
     "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[48]:= ",
 CellID->872599864,ExpressionUUID->"376c6589-bcca-29e8-5d14-7cd3357f7b32"],

Cell["\<\
The third outcome is the XOR of the other two, and no sample leaves the \
even-parity sector.\
\>", "Text",
 CellID->2056057710,ExpressionUUID->"667bb688-7420-22c7-0e18-2fd27dd5702d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1360523735,ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"],

Cell["7.2 The price of magic", "Subsection",
 CellID->676766013,ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"],

Cell[TextData[{
 "Three T gates on a GHZ backbone at growing width, and a single T on ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "721e71e5-9ca7-ded5-2226-68cf1553a43f"],
 "."
}], "Text",
 CellID->1428640414,ExpressionUUID->"0a84e7eb-55e0-1894-3abb-feb563956afe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"magicState", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "n", "]"}], "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"i", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<T\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", "3"}]}], "}"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{
        RowBox[{"magicState", "[", "n", "]"}], "[", "\"\<Length\>\"", "]"}], ",",
        " ", 
       RowBox[{"2", "^", "n"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "10", ",", " ", "20"}], "}"}]}], "}"}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"PauliStabilizer", "[", "1", "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"\"\<H\>\"", ",", " ", "\"\<T\>\""}], "}"}], "]"}], "[", 
        RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<X\>\""}], "]"}]}], 
      ")"}], "/", "2"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[49]:= ",
 CellID->1143649234,ExpressionUUID->"3261920b-7b77-02d6-621e-14557e02503c"],

Cell[TextData[{
 "The frame size is set by the number of T gates, not qubits, and the Born \
probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "+", 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],
 " comes straight from a two-term frame."
}], "Text",
 CellID->1571962290,ExpressionUUID->"7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2091585593,ExpressionUUID->"41d92934-9aba-8299-77e6-c17e1f4cd0e3"],

Cell["8. Dirac Matrices in a Curved Spacetime", "Section",
 CellID->30157833,ExpressionUUID->"5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],

Cell[TextData[{
 "Gamma matrices satisfying ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SuperscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Nu]", "TI"]], "}", "=", "2", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "\|01d7d9"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 " for any real symmetric metric, any signature and any dimension, built from \
the Brauer-Weyl construction and a vielbein ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["e", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 "."
}], "Text",
 CellID->1715653387,ExpressionUUID->"22235db8-54be-42b7-53d1-54e25d4b109d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1904268993,ExpressionUUID->"0976d5ae-737d-f257-3f0d-cc080609c0bd"],

Cell["What to notice", "Subsection",
 CellID->1610510011,ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"],

Cell[TextData[{
 StyleBox["One function, every signature and dimension.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"GammaMatrices", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 " for Euclidean, Minkowski, split signature, Schwarzschild at a point, or a \
random non-diagonal metric."
}], "Item",
 CellID->1363210520,ExpressionUUID->"2f6c0922-6605-ed68-5513-a08c13b1b7b2"],

Cell[TextData[{
 StyleBox["The textbook identities as tests.",
  FontWeight->"Bold"],
 " Traces, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2caab86a-2af9-b1b1-54a9-32344e8d039b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Nu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "-", 
    StyleBox["n", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Nu]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f56169e-4783-4dbb-256d-8fd872361781"],
 " and chirality, each one ",
 Cell[BoxData["Table"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b84d4d6-858d-5842-09bb-cd902c382aa8"],
 " over all signatures."
}], "Item",
 CellID->751311520,ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1811324800,ExpressionUUID->"1072dc7c-f7d5-c74e-4001-d6398261ad94"],

Cell["What to notice (continued)", "Subsection",
 CellID->1255352889,ExpressionUUID->"3462f0a3-098c-f6b3-5c11-e90da83edc99"],

Cell[TextData[{
 StyleBox["Representations on demand.",
  FontWeight->"Bold"],
 " Brauer-Weyl, Dirac and Weyl bases by explicit similarity transforms, odd \
dimensions included."
}], "Item",
 CellID->1056550259,ExpressionUUID->"04cac1af-436c-9192-2cc9-d809761ee3f8"],

Cell[TextData[{
 StyleBox["The graded Clifford basis.",
  FontWeight->"Bold"],
 " All ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63be94f2-239e-9b81-1145-0dbc5628e9eb"],
 " antisymmetrized products, the operator basis behind Fierz identities."
}], "Item",
 CellID->1554899303,ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1285549060,ExpressionUUID->"3a0f2024-2f71-09ca-6a34-b98e4a045b10"],

Cell["Example 8.1: gamma matrices for Schwarzschild", "Subsection",
 CellID->1616846310,ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"],

Cell["Load the DiracMatrix paclet.", "Text",
 CellID->1706199142,ExpressionUUID->"178a6a52-23e4-1142-3d89-8c1c559163a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Nextcloud/Mads/Quantum/DiracMatrix/\
DiracMatrixPackage\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<DiracMatrix`\>\"", "]"}], ";"}]}], "Input",
 CellLabel->"In[50]:= ",
 CellID->848974671,ExpressionUUID->"52ddf811-e480-8137-02e2-f25a8d3ad01d"],

Cell["Every function below comes from it.", "Text",
 CellID->1375299215,ExpressionUUID->"719ae17a-c654-ed44-27b9-f927f3e6b7ae"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1656178105,ExpressionUUID->"62c8f42b-c628-388a-12f7-ee74f3c28ad0"],

Cell[TextData[{
 "8.1 The equator at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "3", 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e5ffeb-8179-694d-5e9a-f6b5300c3b97"]
}], "Subsection",
 CellID->2128368636,ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[TextData[{
 "The Schwarzschild metric there is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1", "/", "3"}], ",", 
    RowBox[{"3", ",", "9", ",", "9"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 "."
}], "Text",
 CellID->471452856,ExpressionUUID->"7aafc905-908a-67da-2a54-e16f213f4d20"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "3"}], ",", " ", "3", ",", " ", "9", ",", " ",
       "9"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gs", " ", "=", " ", 
   RowBox[{"GammaMatrices", "[", "g", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Outer", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
        RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", "Gs", ",",
       " ", "Gs", ",", " ", "1"}], "]"}], " ", "==", " ", 
    RowBox[{"2", " ", 
     RowBox[{"TensorProduct", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Gs", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[51]:= ",
 CellID->1993504316,ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"],

Cell["Its gamma matrices obey the Clifford relation exactly.", "Text",
 CellID->1944276818,ExpressionUUID->"0e7c794a-82c2-56e7-3604-711437773ccd"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->524220529,ExpressionUUID->"30f601cf-5001-fb68-608d-98a961b5c9b2"],

Cell["8.1 A random curved metric and its vielbein", "Subsection",
 CellID->950216136,ExpressionUUID->"04bc0f0b-f02f-243d-2c43-a75481db8f07"],

Cell["\<\
Draw a non-diagonal Lorentzian metric and rebuild it from its vielbein.\
\>", "Text",
 CellID->338647958,ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
  RowBox[{"gr", " ", "=", " ", 
   RowBox[{"RandomCurvedMetric", "[", 
    RowBox[{"1", ",", " ", "3", ",", " ", "1", ",", " ", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sig", ",", " ", "e"}], "}"}], " ", "=", " ", 
   RowBox[{"MetricVielbein", "[", "gr", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Diagonal", "[", "sig", "]"}], ",", " ", 
   RowBox[{"NumericZeroQ", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Transpose", "[", "e", "]"}], " ", ".", " ", "sig", " ", ".", 
      " ", "e"}], " ", "-", " ", "gr"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[52]:= ",
 CellID->961910044,ExpressionUUID->"705e212e-f5a4-7717-2065-b88bfc515a7d"],

Cell["\<\
The signature is read off the metric itself, and the vielbein reproduces the \
metric to numerical tolerance.\
\>", "Text",
 CellID->1465513701,ExpressionUUID->"5c2f5325-a3f6-c048-05d5-4a8ed5809292"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1779278278,ExpressionUUID->"211ecaf2-61ee-418f-5725-e3bc179b13d5"],

Cell["Example 8.2: the identities on every signature", "Subsection",
 CellID->332869652,ExpressionUUID->"51e4dffc-d38f-5703-079b-d6b9e63a3a69"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "6"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " and every signature, a random non-diagonal metric: the Clifford relation, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 " and the four-gamma trace."
}], "Text",
 CellID->870462011,ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "12345", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"eta", " ", "=", " ", 
          RowBox[{"RandomCurvedMetric", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"n", " ", "-", " ", "p"}], ",", " ", "0.5", ",", " ", 
            "1"}], "]"}]}], ",", " ", "G", ",", " ", "A"}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{
        RowBox[{"G", " ", "=", " ", 
         RowBox[{"GammaMatrices", "[", "eta", "]"}]}], ";", " ", 
        RowBox[{"A", " ", "=", " ", 
         RowBox[{"TensorProduct", "[", 
          RowBox[{"eta", ",", " ", "eta"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NumericZeroQ", "[", 
           RowBox[{
            RowBox[{"Outer", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
                RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
              "G", ",", " ", "G", ",", " ", "1"}], "]"}], " ", "-", " ", 
            RowBox[{"2", " ", 
             RowBox[{"TensorProduct", "[", 
              RowBox[{"eta", ",", " ", 
               RowBox[{"IdentityMatrix", "[", 
                RowBox[{"2", "^", 
                 RowBox[{"Floor", "[", 
                  RowBox[{"n", "/", "2"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}],
           ",", "\n", "    ", 
          RowBox[{"NumericZeroQ", "[", 
           RowBox[{
            RowBox[{"Total", "@", 
             RowBox[{"MapThread", "[", 
              RowBox[{"Dot", ",", " ", 
               RowBox[{"{", 
                RowBox[{"G", ",", " ", 
                 RowBox[{
                  RowBox[{"Inverse", "[", "eta", "]"}], " ", ".", " ", 
                  "G"}]}], "}"}]}], "]"}]}], " ", "-", " ", 
            RowBox[{"n", " ", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"2", "^", 
               RowBox[{"Floor", "[", 
                RowBox[{"n", "/", "2"}], "]"}]}], "]"}]}]}], "]"}], ",", "\n",
           "    ", 
          RowBox[{"NumericZeroQ", "[", 
           RowBox[{
            RowBox[{"Outer", "[", 
             RowBox[{
              RowBox[{"Tr", "@*", "Dot"}], ",", " ", "G", ",", " ", "G", ",", 
              " ", "G", ",", " ", "G", ",", " ", "1"}], "]"}], " ", "-", "\n",
             "      ", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"Floor", "[", 
               RowBox[{"n", "/", "2"}], "]"}]}], " ", 
             RowBox[{"(", 
              RowBox[{"A", " ", "-", " ", 
               RowBox[{"Transpose", "[", 
                RowBox[{"A", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "3", ",", " ", "2", ",", " ", "4"}], 
                  "}"}]}], "]"}], " ", "+", " ", 
               RowBox[{"Transpose", "[", 
                RowBox[{"A", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], 
                  "}"}]}], "]"}]}], ")"}]}]}], "]"}]}], "}"}]}]}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], " ", "//", " ", 
   "Flatten"}], " ", "//", " ", 
  RowBox[{"Apply", "[", "And", "]"}]}]}], "Input",
 CellLabel->"In[53]:= ",
 CellID->770594293,ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 ": the identities a QFT course derives by hand for Minkowski space hold for \
every metric in the sweep."
}], "Text",
 CellID->416617480,ExpressionUUID->"7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->468951994,ExpressionUUID->"26ff5c08-e081-ff27-4e85-56559135c20d"],

Cell["8.2 Representations by one call", "Subsection",
 CellID->1802328397,ExpressionUUID->"07c988c4-3ef2-8066-2df6-21aeba84d34c"],

Cell["The Weyl basis in Minkowski space.", "Text",
 CellID->328865975,ExpressionUUID->"4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{"ToWeylBasis", "[", 
   RowBox[{"GammaMatrices", "[", 
    RowBox[{"FlatMetric", "[", 
     RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->1270006433,ExpressionUUID->"7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],

Cell["The chiral blocks appear directly.", "Text",
 CellID->34003199,ExpressionUUID->"3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1596250240,ExpressionUUID->"7ab8b877-e011-189c-2a47-323091a46ae6"],

Cell["9. Snyder's Lorentz-Covariant Quantum Spacetime", "Section",
 CellID->1572158672,ExpressionUUID->"35eb0178-2238-e094-63e8-992257b2b2fe"],

Cell[TextData[{
 "Snyder (1947) made spacetime coordinates noncommuting without breaking \
Lorentz symmetry, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Mu]", "TI"]], ",", 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Nu]", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 "; the algebra is declared once and the noncommutative-algebra engine does \
what is error-prone by hand."
}], "Text",
 CellID->1137775047,ExpressionUUID->"462f64f6-435d-c7dd-6fd5-7db076e9ad27"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->573363004,ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"],

Cell["What to notice", "Subsection",
 CellID->1565937439,ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell[TextData[{
 StyleBox["Consistency first.",
  FontWeight->"Bold"],
 " All Jacobi identities vanish, and Lorentz covariance of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09347675-9fce-c17b-38cc-683f1a789041"],
 " comes out as a theorem."
}], "Item",
 CellID->1825661031,ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell[TextData[{
 StyleBox["Orderings no one does by hand.",
  FontWeight->"Bold"],
 " A quartic word in the coordinates reduces to the ordered basis \
automatically."
}], "Item",
 CellID->1952919625,ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[TextData[{
 StyleBox["The deformed center.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "2"], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], 
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3801b6-8b23-0df3-74c7-98f02ed657d9"],
 " commutes with everything, while ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 " alone does not."
}], "Item",
 CellID->162062935,ExpressionUUID->"35ec423d-cde2-7917-6394-6466eb97487d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1483832353,ExpressionUUID->"05e0e9bc-56b1-1bf2-339f-00e6634469d8"],

Cell["What to notice (continued)", "Subsection",
 CellID->421271511,ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[TextData[{
 StyleBox["Noncommutativity is orbital angular momentum.",
  FontWeight->"Bold"],
 " Jacobi closure forces ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["\[Nu]", "TI"]], "-", 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Nu]", "TI"]], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["\[Mu]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40213c85-9219-7c2b-71de-b5ef27ac4771"],
 "."
}], "Item",
 CellID->971430162,ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[TextData[{
 StyleBox["Physics in one stroke.",
  FontWeight->"Bold"],
 " Deformed momentum addition from the BCH series, Snyder against \
\[Kappa]-Minkowski, and a minimal length ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["min",
     FontSlant->"Plain"]], "=", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3cac94-919f-f08d-6ac3-45de202bc2d7"],
 "."
}], "Item",
 CellID->411794565,ExpressionUUID->"634a1270-2707-566e-1149-943a52b23cb4"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->211393631,ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell["Example 9.1: Snyder's algebra", "Subsection",
 CellID->485898233,ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell["\<\
Ten generators, the three families of commutation relations, and the algebra.\
\
\>", "Text",
 CellID->300459616,ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eta", "[", 
    RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"m", " ", "+", " ", "1"}], ",", " ", 
      RowBox[{"n", " ", "+", " ", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MGen", "[", 
    RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"m", " ", "==", " ", "n"}], ",", " ", "0", ",", " ", 
     RowBox[{"m", " ", "<", " ", "n"}], ",", " ", 
     RowBox[{"M", "[", 
      RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", "True", ",", " ", 
     RowBox[{"-", 
      RowBox[{"M", "[", 
       RowBox[{"n", ",", " ", "m"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gen", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"x", "[", "m", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"M", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", 
          RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xxRel", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"x", "[", "n", "]"}], ",", " ", 
         RowBox[{"x", "[", "m", "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"a", "^", "2"}], " ", 
        RowBox[{"M", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mxRel", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", 
         RowBox[{"x", "[", "r", "]"}]}], "]"}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"x", "[", "m", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"x", "[", "n", "]"}]}]}], ")"}]}]}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mmRel", " ", "=", " ", 
   RowBox[{"Replace", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "n"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", 
             RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
          "]"}], ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m_", ",", " ", "n_"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r_", ",", " ", "s_"}], "}"}]}], "}"}], " ", ":>", " ", 
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"r", ",", " ", "s"}], "]"}], ",", " ", 
         RowBox[{"M", "[", 
          RowBox[{"m", ",", " ", "n"}], "]"}]}], "]"}], " ", "+", "\n", 
       "     ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"m", ",", " ", "s"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "s"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"n", ",", " ", "s"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "s"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}]}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"alg", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", "gen", "}"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"xxRel", ",", " ", "mxRel", ",", " ", "mmRel"}], "]"}]}], ",",
       " ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"{", "a", "}"}]}]}], "|>"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[55]:= ",
 CellID->1400905077,ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"],

Cell["The whole model is this one declaration.", "Text",
 CellID->900992407,ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1909490419,ExpressionUUID->"6d34e655-b983-17e8-14cb-f81f38367d32"],

Cell["9.1 Jacobi identities", "Subsection",
 CellID->809304935,ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell["\<\
Three coordinates, and two coordinates with a Lorentz generator, over every \
index choice.\
\>", "Text",
 CellID->1060035609,ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"jac", "[", 
    RowBox[{"X_", ",", " ", "Y_", ",", " ", "Z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Commutator", "[", 
     RowBox[{"X", ",", " ", 
      RowBox[{"Commutator", "[", 
       RowBox[{"Y", ",", " ", "Z"}], "]"}]}], "]"}], " ", "+", " ", 
    RowBox[{"Commutator", "[", 
     RowBox[{"Y", ",", " ", 
      RowBox[{"Commutator", "[", 
       RowBox[{"Z", ",", " ", "X"}], "]"}]}], "]"}], " ", "+", "\n", "   ", 
    RowBox[{"Commutator", "[", 
     RowBox[{"Z", ",", " ", 
      RowBox[{"Commutator", "[", 
       RowBox[{"X", ",", " ", "Y"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NonCommutativeExpand", "[", 
        RowBox[{
         RowBox[{"jac", "[", 
          RowBox[{
           RowBox[{"x", "[", "m", "]"}], ",", " ", 
           RowBox[{"x", "[", "n", "]"}], ",", " ", 
           RowBox[{"x", "[", "r", "]"}]}], "]"}], ",", " ", "alg"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], ",", 
   "\n", " ", 
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NonCommutativeExpand", "[", 
        RowBox[{
         RowBox[{"jac", "[", 
          RowBox[{
           RowBox[{"x", "[", "m", "]"}], ",", " ", 
           RowBox[{"x", "[", "n", "]"}], ",", " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"r", ",", " ", "s"}], "]"}]}], "]"}], ",", " ", "alg"}], 
        "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[56]:= ",
 CellID->960351252,ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

