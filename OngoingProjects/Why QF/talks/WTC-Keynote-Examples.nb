Cell[TextData[{
 "Most never occur, and they come out as exact zeros, not small numbers that \
floating point would blur into noise. With output modes labelled ",
 Cell[BoxData[
  RowBox[{"0", ",", "\[Ellipsis]", ",", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268bef87-edf5-f26f-7a1c-96125e1fa582"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "310d3b24-9453-eaf6-5b83-71c4a6abe0b8"],
 " photons in mode ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008107b7-740c-9f15-7e10-dca55e5a1cc9"],
 ", a pattern is forbidden unless ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], 
   StyleBox["j", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["t", "TI"], 
    StyleBox["j", "TI"]], "\[Congruent]", "0", "(", 
   StyleBox["mod",
    FontSlant->"Plain"], " ", "4", ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5618099f-8ad4-f9f7-1e23-40636bd4809d"],
 ", the suppression law of Fourier multiports:"
}], "Text",
 CellID->594572180,ExpressionUUID->"2969cfed-bd09-6ddf-6e4a-b1cedefe2951"],

