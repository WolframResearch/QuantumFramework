      FontColor->GrayLevel[0.4]], {0.15, -2}, NCache[
     ImageScaled[{1, Rational[1, 2]}], ImageScaled[{1, 0.5}]]]}},
  ImageSize->122.,
  PlotRange->{{-0.2, 2.85}, {-2.5, -0.4}}]], "Output",
 CellChangeTimes->{4.0026450956326942`*^9},
