Cell[TextData[{
 "The coincidence amplitude, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"0", "\[Rule]", "1"}], ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   SqrtBox[
    RowBox[{
     StyleBox["sech",
      FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
       {
        SubscriptBox[
         StyleBox["x", "TI"], "1"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     StyleBox["sech",
      FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
       {
        SubscriptBox[
         StyleBox["x", "TI"], "2"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["arg",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["x", "TI"], "2"]}]], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      SubscriptBox[
       StyleBox["x", "TI"], "2"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["arg",
      FontSlant->"Plain"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["x", "TI"], "1"]}]], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      SubscriptBox[
       StyleBox["x", "TI"], "1"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "546528c8-d709-dda5-5113-6209e8a7a3b9"],
 ", vanishes for equal squeezing:"
}], "Text",
 CellID->1893161544,ExpressionUUID->"5f5dc93a-3b89-8b85-2ec7-f3ead9609050"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bs4", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[63]:=",
 CellID->364502057,ExpressionUUID->"0c8b25dd-dac4-6798-1977-601a8d81c852"],

Cell[BoxData[
 RowBox[{
  SqrtBox[
   RowBox[{
    RowBox[{"Sech", "[", 
     RowBox[{"Abs", "[", "x1", "]"}], "]"}], " ", 
    RowBox[{"Sech", "[", 
     RowBox[{"Abs", "[", "x2", "]"}], "]"}]}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Arg", "[", "x1", "]"}]}]], " ", 
     RowBox[{"Tanh", "[", 
      RowBox[{"Abs", "[", "x1", "]"}], "]"}]}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Arg", "[", "x2", "]"}]}]], " ", 
     RowBox[{"Tanh", "[", 
      RowBox[{"Abs", "[", "x2", "]"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{4.002645095569045*^9},
 CellLabel->"Out[63]=",ExpressionUUID->"5564b027-7eaf-4f91-9aea-416cac2840a2"]
}, Open  ]]
}, Open  ]],

