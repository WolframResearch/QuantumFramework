Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"l2", "[", 
  RowBox[{"\"\<Probabilities\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[66]:=",
 CellID->1458776515,ExpressionUUID->"02022ee5-ded7-b107-1ea3-2e9ff2bb7204"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    InterpretationBox[
     StyleBox[
      TemplateBox[{
        RowBox[{"0", "\[InvisibleSpace]", "0"}]},
       "Ket"],
      FontWeight->"Plain"],
     Wolfram`QuantumFramework`QuditName[{0, 0}, "Dual" -> False]], "\[Rule]", 
    
    RowBox[{
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], "-", 
     RowBox[{"\[Eta]", " ", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ",", 
   RowBox[{
    InterpretationBox[
     StyleBox[
      TemplateBox[{
        RowBox[{"1", "\[InvisibleSpace]", "0"}]},
       "Ket"],
      FontWeight->"Plain"],
     Wolfram`QuantumFramework`QuditName[{1, 0}, "Dual" -> False]], "\[Rule]", 
    
    RowBox[{
     RowBox[{"\[Eta]", " ", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Theta]2", "]"}], "2"]}], "-", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[CurlyPhi]", "-", "\[CurlyPhi]2"}], ")"}]}]], " ", 
      SqrtBox["\[Eta]"], " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Cos", "[", "\[Theta]2", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]2", "]"}]}], "-", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "\[CurlyPhi]"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[CurlyPhi]2"}]}]], " ", 
      SqrtBox["\[Eta]"], " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Cos", "[", "\[Theta]2", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]2", "]"}]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]2", "]"}], "2"]}]}]}], ",", 
   RowBox[{
    InterpretationBox[
     StyleBox[
      TemplateBox[{
        RowBox[{"0", "\[InvisibleSpace]", "1"}]},
       "Ket"],
      FontWeight->"Plain"],
     Wolfram`QuantumFramework`QuditName[{0, 1}, "Dual" -> False]], "\[Rule]", 
    
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Theta]2", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[CurlyPhi]", "-", "\[CurlyPhi]2"}], ")"}]}]], " ", 
      SqrtBox["\[Eta]"], " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Cos", "[", "\[Theta]2", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]2", "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "\[CurlyPhi]"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "\[CurlyPhi]2"}]}]], " ", 
      SqrtBox["\[Eta]"], " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Cos", "[", "\[Theta]2", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]2", "]"}]}], "+", 
     RowBox[{"\[Eta]", " ", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]2", "]"}], "2"]}]}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.00264509564431*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"fde0e9e8-6797-4edc-8f1c-3f9f4857e702"]
}, Open  ]],

Cell["\<\
Probability is conserved exactly for any angles and loss, proved symbolically \
rather than checked at sample points:\
\>", "Text",
 CellID->1284630344,ExpressionUUID->"4f6e2037-ac6d-6ae6-79e5-7bc1bb895ebd"],

