Cell[TextData[{
 "Still exact: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["T", "TI"], "^"], 
    OverscriptBox[
     StyleBox["H", "TI"], "^"], 
    TemplateBox[{"0"},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      FontSize->1.2 Inherited], 
     RowBox[{
      TemplateBox[{"0"},
       "Ket"], "+", 
      RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
         StyleBox["i", "TI"], "\[Pi]", "/", "4"}]], 
       TemplateBox[{"1"},
        "Ket"]}]}], 
     StyleBox[")",
      FontSize->1.2 Inherited]}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16fc5fc2-664a-bb55-29b0-59cf839b1c51"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "\[Pi]", "/", "4"}]], "/", 
   SqrtBox["2"], "=", 
   FractionBox["1", "2"], "+", 
   FractionBox[
    StyleBox["i", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1362d513-07b5-d236-3f26-cfb374b2d250"],
 ":"
}], "Text",
 CellID->1620417510,ExpressionUUID->"67c70cb6-1b45-aa62-544f-1ed746e749a2"],

