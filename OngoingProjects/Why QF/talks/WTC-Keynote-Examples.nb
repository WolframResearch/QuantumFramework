Cell[TextData[{
 "With ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18aec436-eceb-9b3f-2c9a-7568db74ab83"],
 " photons in, for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b042fb9-7d38-a187-3a73-94a93fdf349d"],
 ", the amplitude is an exact sum over the unseen photon number ",
 Cell[BoxData[
  StyleBox["K", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1184f576-568e-add5-7960-afc2b8bcbea4"],
 " between the splitters, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], ",", 
      RowBox[{"0", "\[Rule]", 
       StyleBox["t", "TI"]}], ",", 
      RowBox[{
       StyleBox["n", "TI"], "-", 
       StyleBox["t", "TI"]}]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["K", "TI"], "=", "0"}], 
     StyleBox["n", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["D", "TI"], 
      RowBox[{
       FractionBox[
        StyleBox["n", "TI"], "2"], ",", "\[ThinSpace]", 
       RowBox[{
        StyleBox["K", "TI"], "-", 
        FractionBox[
         StyleBox["n", "TI"], "2"]}]}], 
      FractionBox[
       StyleBox["n", "TI"], "2"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox["\[CurlyPhi]", "1"], ",", 
       RowBox[{"2", 
        SubscriptBox[
         StyleBox["\[Theta]", "TI"], "1"]}], ",", 
       RowBox[{"-", 
        SubscriptBox["\[CurlyPhi]", "1"]}]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[ThinSpace]", 
     SubsuperscriptBox[
      StyleBox["D", "TI"], 
      RowBox[{
       RowBox[{
        StyleBox["K", "TI"], "-", 
        FractionBox[
         StyleBox["n", "TI"], "2"]}], ",", "\[ThinSpace]", 
       RowBox[{
        StyleBox["t", "TI"], "-", 
        FractionBox[
         StyleBox["n", "TI"], "2"]}]}], 
      FractionBox[
       StyleBox["n", "TI"], "2"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SubscriptBox["\[CurlyPhi]", "2"], ",", 
       RowBox[{"2", 
        SubscriptBox[
         StyleBox["\[Theta]", "TI"], "2"]}], ",", 
       RowBox[{"-", 
        SubscriptBox["\[CurlyPhi]", "2"]}]}], 
      StyleBox[")",
       SpanMaxSize->1]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b56e2bb-b1cc-c1d6-1293-0f879e0646c4"],
 ":"
}], "Text",
 CellID->2139662887,ExpressionUUID->"592a630a-2485-663b-2b64-d08771940efe"],

