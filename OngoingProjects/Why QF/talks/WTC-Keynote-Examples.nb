Cell[TextData[{
 "Its generators are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "^"], 
    StyleBox["v", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "^"], 
    StyleBox["v", "TI"]], 
   UnderscriptBox["\[Product]", 
    RowBox[{
     StyleBox["w", "TI"], "\[Tilde]", 
     StyleBox["v", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], 
    StyleBox["w", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ce0c850-4146-4e30-7aa7-5f10cbda20a0"],
 ", one per site:"
}], "Text",
 CellID->96606702,ExpressionUUID->"170c367e-0186-4080-053f-8d2a2228f011"],

