Cell[CellGroupData[{

Cell["QuantumInterferometer", "Section",
 CellID->746866756,ExpressionUUID->"4d8c64f7-b1f9-2f8e-540c-53e535e02115"],

Cell[TextData[{
 "Linear optics with exact photon-counting amplitudes: permanents, hafnians \
and Wigner D-functions in closed form, with angles and photon numbers that \
can stay symbolic. Below, ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["D", "TI"], 
    RowBox[{
     StyleBox["m", "TI"], 
     SuperscriptBox[
      StyleBox["m", "TI"], "\[Prime]"]}], 
    StyleBox["j", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], ",", 
    StyleBox["\[Beta]", "TI"], ",", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4994a442-5c78-28c3-76e9-1593c8132489"],
 " is the Wigner D-function, ",
 Cell[BoxData[
  RowBox[{"WignerD", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"j", ",", " ", "m", ",", " ", 
      RowBox[{"m", "'"}]}], "}"}], ",", " ", "\[Alpha]", ",", " ", "\[Beta]", 
    ",", " ", "\[Gamma]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3faebca9-451b-6822-02eb-51eda09a1c4d"],
 "."
}], "Text",
 CellID->1224287971,ExpressionUUID->"2f14137f-52ff-5831-0c6f-67e0f67b2a9a"],

