Cell[TextData[{
 "The amplitude for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d64d34-151b-17b6-022a-57d617d2a7fe"],
 " photons in and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55628adf-9976-862f-060b-93bddbc4e975"],
 " out, every number symbolic, so one result covers every photon-number case, \
is a conservation delta times one Wigner D-function, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Delta]", "TI"], 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], "1"], "+", 
       SubscriptBox[
        StyleBox["n", "TI"], "2"]}], ",", "\[ThinSpace]", 
      RowBox[{
       SubscriptBox[
        StyleBox["t", "TI"], "1"], "+", 
       SubscriptBox[
        StyleBox["t", "TI"], "2"]}]}]], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox[
         StyleBox["n", "TI"], "1"], "-", 
        SubscriptBox[
         StyleBox["n", "TI"], "2"]}], "2"], ",", "\[ThickSpace]", 
      RowBox[{
       SubscriptBox[
        StyleBox["t", "TI"], "1"], "-", 
       FractionBox[
        RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["n", "TI"], "2"]}], "2"]}]}], 
     FractionBox[
      RowBox[{
       SubscriptBox[
        StyleBox["n", "TI"], "1"], "+", 
       SubscriptBox[
        StyleBox["n", "TI"], "2"]}], "2"]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", ",", 
      RowBox[{"2", 
       StyleBox["\[Theta]", "TI"]}], ",", 
      RowBox[{"-", "\[CurlyPhi]"}]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39f2cad1-2d28-be8b-738e-2331e08b221d"],
 ":"
}], "Text",
 CellID->2057835071,ExpressionUUID->"29e15c43-7f2a-65e6-784c-1973ea0e2d66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[37]:=",
 CellID->1757108918,ExpressionUUID->"008a9969-fafa-548f-4950-d7bbcb815086"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{
    RowBox[{
      RowBox[{"n1", "+", "n2"}], ",", 
      RowBox[{"t1", "+", "t2"}]}]},
   "KroneckerDeltaSeq"], " ", 
  RowBox[{"WignerD", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{"n1", "+", "n2"}], "2"], ",", 
      FractionBox[
       RowBox[{"n1", "-", "n2"}], "2"], ",", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "n1"}], "-", "n2", "+", 
         RowBox[{"2", " ", "t1"}]}], ")"}]}]}], "}"}], ",", "\[CurlyPhi]", ",", 
    RowBox[{"2", " ", "\[Theta]"}], ",", 
    RowBox[{"-", "\[CurlyPhi]"}]}], "]"}]}]], "Output",
 CellChangeTimes->{4.002645095178463*^9},
 CellLabel->"Out[37]=",ExpressionUUID->"6969ca76-1ef8-43f8-8a10-dbfbb4f6bfd4"]
}, Open  ]],

