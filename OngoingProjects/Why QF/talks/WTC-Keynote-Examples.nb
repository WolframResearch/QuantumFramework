}, Open  ]],

Cell[TextData[{
 "One photon in. Loss enters the exact probabilities: the photon is lost with \
probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["\[Eta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34135665-3563-a73c-3019-4d0b3874f09f"],
 ", and the fringe term scales with ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c9d90f0-4d92-6f78-61ab-ee3b74f7e6da"],
 ":"
}], "Text",
 CellID->371025263,ExpressionUUID->"63597f46-d7fb-21ba-135f-81b1ff6c5c8a"],

