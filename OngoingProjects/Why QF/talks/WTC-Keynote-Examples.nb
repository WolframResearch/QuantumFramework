Cell[TextData[{
 "Its overlap with any coherent state ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["\[Gamma]", "TI"], ",", 
      StyleBox["\[Delta]", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69b23402-99c5-da95-5dc1-37e48235bcda"],
 " is a closed-form Gaussian in their distance, not a sum over truncated Fock \
states, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], "-", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Gamma]", "TI"], "-", 
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["cos",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"], "+", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
          StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
        StyleBox["\[Beta]", "TI"], 
        StyleBox["sin",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "-", 
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        StyleBox["\[Delta]", "TI"], "-", 
        StyleBox["\[Beta]", "TI"], 
        StyleBox["cos",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"], "-", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
          StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
        StyleBox["\[Alpha]", "TI"], 
        StyleBox["sin",
         FontSlant->"Plain"], "\[ThinSpace]", 
        StyleBox["\[Theta]", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e0a56f0-3ce5-65a0-07f2-8d84062efd12"],
 ":"
}], "Text",
 CellID->1708147932,ExpressionUUID->"1a954723-5789-a39a-7b2f-de9e2c615325"],

