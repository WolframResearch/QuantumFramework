Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd805e3-13f3-f806-25bc-179555cf9a36"],
 " photons enter each port. For every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64dc62d1-bcfe-30de-1c69-e48f850b9eff"],
 " at once, the amplitude for ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b557d11-8ee5-a080-7484-4d5ac4fbb4bd"],
 " out of the first is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], ",", 
      RowBox[{
       StyleBox["n", "TI"], "\[Rule]", 
       StyleBox["k", "TI"]}], ",", 
      RowBox[{"2", 
       StyleBox["n", "TI"], "-", 
       StyleBox["k", "TI"]}]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     RowBox[{"0", ",", "\[ThickSpace]", 
      RowBox[{
       StyleBox["k", "TI"], "-", 
       StyleBox["n", "TI"]}]}], 
     RowBox[{"\[ThinSpace]", 
      StyleBox["n", "TI"]}]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"0", ",", 
      RowBox[{"\[Pi]", "/", "2"}], ",", "0"}], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "554879f6-fe09-4335-6c8a-5257c390f718"],
 ", which vanishes for every odd ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4154fbf8-6e15-3e70-1d8e-6613456e3988"],
 ": the Hong-Ou-Mandel effect, generalized to any photon number:"
}], "Text",
 CellID->1896186496,ExpressionUUID->"0d5d5e05-a30a-c65a-33d6-54f945523deb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bs2", "[", 
