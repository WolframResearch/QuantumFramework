          BaselinePosition -> {1, 1}]}, 
       Dynamic[Typeset`open$$], ImageSize -> Automatic]},
     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  Wolfram`QuantumFramework`SecondQuantization`QuantumInterferometer[<|
   "Unitary" -> {{
      Cos[$CellContext`a1] Cos[$CellContext`a3] - 
       E^(Complex[0, 1] $CellContext`b1 + Complex[0, -1] $CellContext`b3) 
       Cos[$CellContext`a2] Sin[$CellContext`a1] 
       Sin[$CellContext`a3], -E^(Complex[0, -1] $CellContext`b1) 
        Cos[$CellContext`a3] Sin[$CellContext`a1] - 
