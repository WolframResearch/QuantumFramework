Cell[CellGroupData[{

Cell["Bosonic algebra", "Section",
 CellID->574432246,ExpressionUUID->"47cb90dd-6142-a18e-5e92-ac3b622d625c"],

Cell[TextData[{
 "Operators of light and oscillators, ordered and disentangled exactly. The \
field variables are the formal symbols ",
 Cell[BoxData[
  StyleBox["\[FormalA]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37b592a8-6a8e-790b-3396-990789286d60"],
 " and ",
 Cell[BoxData[
  StyleBox["\[FormalB]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30cf53e1-f393-d878-6f80-784a7d41cbc1"],
 "; their creation operators are ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[FormalA]", "TI"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56995dc1-470e-9e77-7d85-62f13fbca634"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[FormalB]", "TI"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c22c29d-aac8-8f8c-56e4-b5748eb3a543"],
 ". Every result is an operator identity, valid at every photon number, with \
no Fock-space cutoff."
}], "Text",
 CellID->633444251,ExpressionUUID->"20991ed6-8dbb-80cb-25cb-af92b3f67f1d"],

Cell[CellGroupData[{

Cell["1. Squeezing, factored", "Subsection",
 CellID->2094125215,ExpressionUUID->"7e17f7fb-ccf4-77a7-4831-e238c364207b"],

Cell[TextData[{
 "The squeeze operator ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["S", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Xi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["[",
    FontSize->1.2 Inherited], 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Xi]", "TI"], "*"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "2"], "-", 
    StyleBox["\[Xi]", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], 
     RowBox[{"\[Dagger]", "2"}]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["]",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "263e1f2c-fb2c-f982-5d72-d96c97d1322e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Xi]", "TI"], "=", 
   StyleBox["r", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox[
     RowBox[{"i", "\[Theta]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46252257-b0f5-c4ed-644c-249c331dd400"],
 ". One call returns its exact factorization into creation, number and \
annihilation parts, the identity squeezed-light calculations rest on, for \
every ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60836150-e167-22fe-3618-eb959ed55545"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c805f55-2ffd-dd4a-5708-fdd11c577972"],
 ":"
}], "Text",
 CellID->44134596,ExpressionUUID->"41f7b98d-6461-d82c-0bba-b84963e3b46d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   OverscriptBox[
    StyleBox["S", "TI"], "^"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Xi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     FractionBox["1", "2"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Theta]"}], "TI"]], 
     StyleBox["tanh",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["r", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "\[ThinSpace]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      RowBox[{"\[Dagger]", "2"}]]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["sech",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["r", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "+", 
     FractionBox["1", "2"]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["\[Theta]", "TI"]}]], 
     StyleBox["tanh",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["r", "TI"], 
     StyleBox[")",
      SpanMaxSize->1], "\[ThinSpace]", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "2"]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1307007571,ExpressionUUID->"11ab515c-f195-1c0f-4426-e281f13e40fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpOrder", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", "r", " ", 
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[Theta]"}], ")"}]}], " ", 
      RowBox[{"\[FormalA]", "**", "\[FormalA]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", "r", " ", 
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{"I", " ", "\[Theta]"}], ")"}]}], " ", 
      RowBox[{
       RowBox[{"SuperDagger", "[", "\[FormalA]", "]"}], "**", 
