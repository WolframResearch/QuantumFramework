Cell[TextData[{
 "Expanded, the tableau gives exactly, not approximately, the state the \
default engine computes, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", 
      SqrtBox["2"]}]], 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       RowBox[{
        StyleBox["x", "TI"], "\[Element]", "{", "0"}], ",", 
       RowBox[{"1", 
        SuperscriptBox["}", "3"]}]}],
      LimitsPositioning->False], 
     RowBox[{
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", "1"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       RowBox[{
        SubscriptBox[
         StyleBox["x", "TI"], "1"], 
        SubscriptBox[
         StyleBox["x", "TI"], "2"], "+", 
        SubscriptBox[
         StyleBox["x", "TI"], "2"], 
        SubscriptBox[
         StyleBox["x", "TI"], "3"]}]], 
      TemplateBox[{
        RowBox[{
          SubscriptBox[
           StyleBox["x", "TI"], "1"], 
          SubscriptBox[
           StyleBox["x", "TI"], "2"], 
          SubscriptBox[
           StyleBox["x", "TI"], "3"]}]},
       "Ket"]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49803dd5-17c8-783c-147e-e36c46dd18f7"],
 ":"
}], "Text",
 CellID->64637481,ExpressionUUID->"01f0bd29-2a33-e33a-4ff3-c6974cca5bee"],

