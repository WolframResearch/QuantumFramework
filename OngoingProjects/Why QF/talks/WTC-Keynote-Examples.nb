Cell[TextData[{
 "Photon numbers can be expressions; ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66091024-4d8c-c18f-237e-cb7454dc813c"],
 " photons in one port, ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca52c19-d065-a7a6-3922-a9cb95cda10a"],
 " out of each: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["A", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      RowBox[{"2", 
       StyleBox["n", "TI"]}], ",", 
      RowBox[{"0", "\[Rule]", 
       StyleBox["n", "TI"]}], ",", 
      StyleBox["n", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     RowBox[{
      StyleBox["n", "TI"], ",", "\[ThinSpace]", "0"}], 
     RowBox[{"\[ThinSpace]", 
      StyleBox["n", "TI"]}]], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[CurlyPhi]", ",", 
      RowBox[{"2", 
       StyleBox["\[Theta]", "TI"]}], ",", 
      RowBox[{"-", "\[CurlyPhi]"}]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
