Cell[TextData[{
 "Its tableau: the generators are ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "^"], 
    StyleBox["v", "TI"]], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], 
    RowBox[{
     StyleBox["v", "TI"], "-", "1"}]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "^"], 
    StyleBox["v", "TI"]], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z", "TI"], "^"], 
    RowBox[{
     StyleBox["v", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1052be48-b6ab-5c0f-5c42-c3f271ff7413"],
 " around the ring, so the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e67c588-a37b-b49d-2635-8b9e7a17ce0c"],
 " block is the adjacency matrix of the cycle:"
}], "Text",
 CellID->434933389,ExpressionUUID->"1f800fe0-b0ec-3442-3238-1401708852ae"],

