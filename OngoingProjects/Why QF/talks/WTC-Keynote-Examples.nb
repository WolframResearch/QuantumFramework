Cell["A three-qubit cluster circuit:", "Text",
 CellID->422269520,ExpressionUUID->"7a51875e-82a1-1afd-128f-db4ed6748038"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cluster3", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "3", "]"}]}], ",", " ", "\"\<CZ\>\"", ",", " ", 
      RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}], 
