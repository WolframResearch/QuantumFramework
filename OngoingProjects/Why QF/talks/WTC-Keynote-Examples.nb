 CellID->451134304,ExpressionUUID->"53628cd7-bbb3-b200-2d7b-8e69c7073564"],

Cell[TextData[{
 "Mode mixing ",
 Cell[BoxData[
  RowBox[{
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "\[ThinSpace]", 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "\[Dagger]"], "+", 
    StyleBox["\[Beta]", "TI"], "\[ThinSpace]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["b", "TI"], "^"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598336ec-1f33-0025-7495-d36520478711"],
 " with arbitrary complex ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], ",", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d4daab5-75de-aba9-5649-cf094f07972b"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", 
   SqrtBox[
    StyleBox[
     RowBox[{"\[Alpha]", "\[Beta]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05551317-1ef8-9ce7-0bcc-2ecc68283667"],
 ": one exact operator identity covers every photon number:"
}], "Text",
 CellID->844157360,ExpressionUUID->"5d10e1fe-8299-2300-54dd-839647c9731e"],

