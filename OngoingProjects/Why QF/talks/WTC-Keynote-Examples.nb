Cell[TextData[{
 "Boson sampling, where each exact probability is a permanent and the full \
table grows explosively: a random ",
 Cell[BoxData[
  RowBox[{"12", "\[Times]", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22ffd434-118a-af1a-4acb-69b4f38fa947"],
 " unitary,"
}], "Text",
