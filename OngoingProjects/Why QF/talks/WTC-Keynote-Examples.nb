Cell[TextData[{
 "Expectation values come straight from the generators, exactly and with no \
state vector: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["K", "TI"], "^"], "1"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "421c5cb9-2fe1-10c9-4576-0f1651bbc0b6"],
 ", while ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "^"], "1"], 
   SubscriptBox[
    OverscriptBox[
     StyleBox["X", "TI"], "^"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec887f1-8bc1-2035-466f-6cc9ad0d78b5"],
 ", which anticommutes with ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["K", "TI"], "^"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12ac60b9-2693-1844-7902-9458a423ecb6"],
 ", averages to zero:"
}], "Text",
 CellID->2121435355,ExpressionUUID->"65ed1f94-be77-8198-68ae-b23dc06bc9c7"],

