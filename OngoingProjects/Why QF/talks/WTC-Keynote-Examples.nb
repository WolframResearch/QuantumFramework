Cell[TextData[{
 "Laser light stays laser light: a coherent state goes to a coherent state, \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], ",", 
       StyleBox["\[Beta]", "TI"]}]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["cos", FontSlant -> "Plain"], 
       StyleBox["\[Theta]", "TI"], "-", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
       StyleBox["\[Beta]", "TI"], 
       StyleBox["sin", FontSlant -> "Plain"], 
       StyleBox["\[Theta]", "TI"], ",", 
       StyleBox["\[Beta]", "TI"], 
       StyleBox["cos", FontSlant -> "Plain"], 
       StyleBox["\[Theta]", "TI"], "+", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
       StyleBox["\[Alpha]", "TI"], 
       StyleBox["sin", FontSlant -> "Plain"], 
       StyleBox["\[Theta]", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bae7bf8-264d-d9f8-26ee-0bbcb7d823e5"],
 ":"
}], "Text",
 CellID->789879331,ExpressionUUID->"7684963b-5340-9feb-012b-640977cc8ad3"],

