Cell[CellGroupData[{

Cell["18. Loss and sampling", "Subsection",
 CellID->1763005307,ExpressionUUID->"19f00f60-745c-592c-2e93-3831e9bb34f7"],

Cell[TextData[{
 "Of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28eaa47d-6e68-975b-3048-86a975e28f0d"],
 " photons sent through a lossy channel, ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a56ee2a-5732-bd53-0496-e88775cd6eac"],
 " survive with the binomial law ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["P", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], "\[Rule]", 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["n", "TI"], 
      StyleBox["k", "TI"]},
     "Binomial"], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["\[Eta]", "TI"], 
     StyleBox["k", "TI"]], 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", "-", 
       StyleBox["\[Eta]", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}]]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75f2c7eb-c400-c9c8-254c-1f990ab26b89"],
 ", derived with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c5260f9-4bf4-48fb-26ff-eeb2d7706f9d"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518d00c9-a009-47c9-1646-3f9163636b95"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f487097-51d4-5cbb-5b99-0f957d7c13c1"],
 " all symbolic:"
}], "Text",
 CellID->1115878925,ExpressionUUID->"75f1ff15-bfa3-6e4c-3b7d-9f7b27b378fa"],

