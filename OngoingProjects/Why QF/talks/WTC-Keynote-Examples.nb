                   RowBox[{"2", " ", 
                    RowBox[{"K", "[", "1", "]"}]}]}], ")"}]}], ",", 
             RowBox[{
               FractionBox["1", "2"], " ", 
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{"-", "n"}], "+", 
                   RowBox[{"2", " ", "t"}]}], ")"}]}]}], "}"}], ",", 
         "\[CurlyPhi]2", ",", 
         RowBox[{"2", " ", "\[Theta]2"}], ",", 
         RowBox[{"-", "\[CurlyPhi]2"}]}], "]"}]}], 
   RowBox[{"K", "[", "1", "]"}], "0", "n"},
  "InactiveSum",
  DisplayFunction->(RowBox[{
     UnderoverscriptBox[
      StyleBox["\[Sum]", "Inactive"], 
