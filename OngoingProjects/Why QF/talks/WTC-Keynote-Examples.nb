Cell["10. Beyond Clifford", "Subsection",
 CellID->597877820,ExpressionUUID->"476da040-ccec-38f3-0339-347eb14ea7f0"],

Cell["\<\
A T gate leaves the stabilizer group. Instead of failing or approximating, \
the engine switches to a superposition of stabilizer states:\
\>", "Text",
 CellID->540230488,ExpressionUUID->"23815da9-7b4b-7462-2dab-b8a707c45bcd"],

Cell[CellGroupData[{

Cell[BoxData[
