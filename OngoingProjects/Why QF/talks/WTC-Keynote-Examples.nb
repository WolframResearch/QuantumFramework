   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", "\[Rule]", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["sech",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["\[Xi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["tanh",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["\[Xi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "252c11bb-1734-31cf-0d3c-09619754f1fe"],
 ":"
}], "Text",
 CellID->1816486678,ExpressionUUID->"3438e129-4cef-f8ac-2950-033e5045a04f"],

