Cell["A seeded random stream of Hadamard, CNOT and phase gates:", "Text",
 CellID->440008987,ExpressionUUID->"2c04ef03-8d8d-7f96-54d7-8e253b60fb66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nq", " ", "=", " ", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gates", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<H\>\"", " ", "->", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "nq"}], "}"}], "]"}]}], ",", " ", 
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"Range", "[", "nq", "]"}], ",", " ", "2"}], "]"}]}], ",", 
        " ", 
        RowBox[{"\"\<S\>\"", " ", "->", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "nq"}], "}"}], "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", "6666", "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Length", "@", "gates"}]}], "Input",
 CellLabel->"In[16]:=",
 CellID->2121350252,ExpressionUUID->"62a820d1-5e34-b13b-3a5d-e506777c57f2"],

