Cell[CellGroupData[{

Cell["5. Reordering a product", "Subsection",
 CellID->1825142838,ExpressionUUID->"602bec11-d739-7372-293e-79500ca8092e"],

Cell[TextData[{
 "Reordering ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["k", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "2"]}]], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["m", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      RowBox[{"\[Dagger]", "2"}]]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2612c84a-0155-f77b-4002-84d84b7fafaa"],
 " into normal order, a page of commutator algebra by hand, in one call:"
}], "Text",
 CellID->990404510,ExpressionUUID->"4a364f71-f913-e67b-3ca8-4db33e4a448d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["k", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "2"]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["m", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      RowBox[{"\[Dagger]", "2"}]]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited], "=", 
   FractionBox["1", 
    SqrtBox[
     RowBox[{"1", "-", "4", 
      StyleBox["k", "TI"], 
      StyleBox["m", "TI"]}]]], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     FractionBox[
      StyleBox["m", "TI"], 
      RowBox[{"1", "-", "4", 
       StyleBox["k", "TI"], 
       StyleBox["m", "TI"]}]], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], 
      RowBox[{"\[Dagger]", "2"}]]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", "4", 
      StyleBox["k", "TI"], 
      StyleBox["m", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{"-", 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.8 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     FractionBox[
      StyleBox["k", "TI"], 
      RowBox[{"1", "-", "4", 
       StyleBox["k", "TI"], 
       StyleBox["m", "TI"]}]], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "2"]}]], 
   StyleBox[")",
    FontSize->1.8 Inherited]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->977444660,ExpressionUUID->"592aa7c2-bd88-a161-09e3-6f65f656eb71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpOrder", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{"k", " ", 
     RowBox[{"\[FormalA]", "**", "\[FormalA]"}]}], "]"}], "**", 
   RowBox[{"Exp", "[", 
    RowBox[{"m", " ", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "\[FormalA]", "]"}], "**", 
      RowBox[{"SuperDagger", "[", "\[FormalA]", "]"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->1245419701,ExpressionUUID->"0f193539-a824-d95b-75e6-64eea0a73392"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    FractionBox[
     RowBox[{"m", " ", 
      TemplateBox[{"NonCommutativeMultiply", 
        RowBox[{"(", 
          SuperscriptBox["\[FormalA]", "\[Dagger]"], ")"}], "2", "**"},
       "GeneralizedPower"]}], 
     RowBox[{"1", "-", 
      RowBox[{"4", " ", "k", " ", "m"}]}]]], "**", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"4", " ", "k", " ", "m"}]}], ")"}], 
    RowBox[{"-", 
     RowBox[{
      SuperscriptBox["\[FormalA]", "\[Dagger]"], "**", "\[FormalA]"}]}]], "**", 
   SuperscriptBox["\[ExponentialE]", 
    FractionBox[
     RowBox[{"k", " ", 
      TemplateBox[{"NonCommutativeMultiply", "\[FormalA]", "2", "**"},
       "GeneralizedPower"]}], 
     RowBox[{"1", "-", 
      RowBox[{"4", " ", "k", " ", "m"}]}]]]}], 
  SqrtBox[
   RowBox[{"1", "-", 
    RowBox[{"4", " ", "k", " ", "m"}]}]]]], "Output",
 CellChangeTimes->{4.002645088106537*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"a695f3f7-8f91-4a45-a69e-68a5b92afbde"]
}, Open  ]],

Cell[TextData[{
 "and a displacement into anti-normal order, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Lambda]", "TI"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "+", 
     StyleBox["\[Beta]", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"]}]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["\[Lambda]", "TI"], "/", "2"}]], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Lambda]", "TI"], 
     OverscriptBox[
      StyleBox["a", "TI"], "^"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited], "\[ThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["\[Beta]", "TI"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["a", "TI"], "^"], "\[Dagger]"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1a0760-88d8-53f0-0ca5-7f933cf971d3"],
 ", the ordering behind the Husimi ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49b4a1fc-b1dc-05a6-677c-fdfebaa8dfe2"],
 " function:"
}], "Text",
 CellID->365704094,ExpressionUUID->"616f94af-e2aa-f291-6179-349920126942"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BosonicExpOrder", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", "\[FormalA]"}], " ", "+", " ", 
     RowBox[{"\[Beta]", " ", 
      RowBox[{"SuperDagger", "[", "\[FormalA]", "]"}]}]}], "]"}], ",", " ", 
   RowBox[{"\"\<Ordering\>\"", " ", "->", " ", "\"\<Antinormal\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1750990038,ExpressionUUID->"51e72314-6dd6-cfe6-18de-96aeab6a43a9"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"\[Beta]", " ", "\[Lambda]"}], "2"]}]], " ", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[FormalA]", " ", "\[Lambda]"}]], "**", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Beta]", " ", 
     SuperscriptBox["\[FormalA]", "\[Dagger]"]}]]}]}]], "Output",
 CellChangeTimes->{4.0026450881108017`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"f117fc2c-4222-4548-8b1b-62e339aaa6f8"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stabilizer formalism", "Section",
 CellID->84727264,ExpressionUUID->"502f453a-dc39-6e6f-37d6-08f0987a583f"],

Cell[TextData[{
 "A Clifford state stored as the group of Pauli operators that fix it, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["P", "TI"], "^"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "=", 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323cb63d-6ef8-3e89-3933-6861221f87ac"],
 ": ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440c7fc0-cd6d-ce8c-55a5-35094f574156"],
 " generators instead of ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45af5c39-d746-32a0-6888-bd5d3249d1e1"],
 " amplitudes, so the cost grows polynomially in the number of qubits, not \
exponentially."
}], "Text",
 CellID->728999986,ExpressionUUID->"4cd55275-352d-b42b-2807-1513b7b12c47"],

Cell[CellGroupData[{

Cell["6. Same circuit, different engine", "Subsection",
 CellID->1180044206,ExpressionUUID->"67f17767-a12d-36cb-1f52-d2c8b4afd427"],

Cell["\<\
A five-qubit cluster-state circuit: Hadamards, then controlled-Z gates down \
the chain:\
\>", "Text",
 CellID->378596892,ExpressionUUID->"4fbe7708-eab8-ce16-6e2f-ae6d332b3838"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cluster5", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", 
        RowBox[{"Range", "[", "5", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], ",", " ", 
        RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "5"}], "}"}]}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"cluster5", "[", "\"\<Diagram\>\"", "]"}]}], "Input",
 CellLabel->"In[11]:=",
 CellID->1324119915,ExpressionUUID->"71104ab2-abaa-aacc-34c0-edbeec463974"],

