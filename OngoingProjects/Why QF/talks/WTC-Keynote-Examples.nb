Cell["\<\
The half-chain entropy, an exact integer rather than a sampled estimate:\
\>", "Text",
 CellID->1307459721,ExpressionUUID->"68f1c271-bb45-23e6-4bc4-30cadad953d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"big", "[", 
  RowBox[{"\"\<Entropy\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"nq", "/", "2"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[21]:=",
 CellID->246421316,ExpressionUUID->"609a486f-563c-a7d4-0bbb-6ff914b5d74b"],

Cell[BoxData["496"], "Output",
 CellChangeTimes->{4.002645089475456*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"2a0f013d-8b2b-409c-967b-a1fb639891e4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. An 800-qubit GHZ state", "Subsection",
 CellID->1060885634,ExpressionUUID->"384bc1c8-7cd3-e104-73ac-be13856d296d"],

Cell[TextData[{
 "The state ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["GHZ", FontSlant -> "Plain"]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      FontSize->1.2 Inherited], 
     RowBox[{
      SuperscriptBox[
       TemplateBox[{"0"},
        "Ket"], 
       RowBox[{"\[CircleTimes]", "800"}]], "+", 
      SuperscriptBox[
       TemplateBox[{"1"},
        "Ket"], 
       RowBox[{"\[CircleTimes]", "800"}]]}], 
     StyleBox[")",
      FontSize->1.2 Inherited]}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d09eda0-2225-eefc-0523-4e6e47ecc51e"],
 ", built straight from its circuit name; a dense simulator would need ",
 Cell[BoxData[
  SuperscriptBox["2", "800"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e5f148d-142a-1c87-2fed-83741d372738"],
 " amplitudes:"
}], "Text",
 CellID->1894213956,ExpressionUUID->"1996ec9a-a45d-c0b1-6f7d-ecf577ffd9ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"PauliStabilizer", "[", 
   RowBox[{"\"\<GHZ\>\"", "[", "800", "]"}], "]"}]}]], "Input",
 CellLabel->"In[22]:=",
 CellID->1517395904,ExpressionUUID->"02d9412e-128c-3f57-4f36-b6ff82a4b653"],

