     RowBox[{"\"\<Probabilities\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Theta]", ",", " ", "\[CurlyPhi]", ",", " ", "\[Theta]2", ",", " ", 
        "\[CurlyPhi]2"}], "}"}], ",", " ", "Reals"}], "]"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<=", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], 
  "]"}]], "Input",
