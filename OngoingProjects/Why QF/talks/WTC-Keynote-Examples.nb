Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", 
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dca1517-27e5-ef8c-1a0b-7c6c19cd47df"],
 " photons in and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   SubscriptBox[
    StyleBox["t", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25444a9d-2d86-1b53-683b-1ce7d419c6e0"],
 ", the amplitude for arbitrary photon numbers is one conservation delta and \
a single sum whose upper limit, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["min",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["N", "TI"], ",", 
    StyleBox["T", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74c84243-311d-793c-13e1-342369e1383f"],
 ", follows where photons can flow:"
}], "Text",
 CellID->2140780886,ExpressionUUID->"0ff1467d-ce24-4306-229f-202ded5efbf2"],

