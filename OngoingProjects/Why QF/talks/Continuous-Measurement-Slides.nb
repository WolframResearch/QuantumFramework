      "r", ",", " ", "0.6", ",", 
       " ", "\"\<cavity linewidth over dispersive shift \
\[Kappa]/2|\[Chi]|\>\""}], "}"}], ",", " ", "pointerRs", ",", " ", 
     "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
