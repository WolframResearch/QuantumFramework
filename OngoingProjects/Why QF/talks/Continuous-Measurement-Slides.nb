Cell[BoxData[{
 RowBox[{
  RowBox[{"xpAlgebra", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"xo", ",", " ", "po"}], "}"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"po", " ", "**", " ", "xo"}], " ", "-", " ", 
         RowBox[{"xo", " ", "**", " ", "po"}], " ", "+", " ", 
         RowBox[{"I", " ", "\[HBar]"}]}], "}"}]}]}], "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussMean", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mgf", " ", "=", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"\[Alpha]", " ", "mx"}], " ", "+", " ", 
            RowBox[{"\[Beta]", " ", "mp"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Alpha]", "^", "2"}], " ", "\[CapitalSigma]x"}], 
               " ", "+", " ", 
               RowBox[{"2", " ", "\[Alpha]", " ", "\[Beta]", " ", "Cxp"}], 
               " ", "+", " ", 
               RowBox[{
                RowBox[{"\[Beta]", "^", "2"}], " ", "\[CapitalSigma]p"}]}], 
              ")"}], "/", "2"}], " ", "+", " ", 
            RowBox[{"I", " ", "\[HBar]", " ", "\[Alpha]", " ", 
             RowBox[{"\[Beta]", "/", "2"}]}]}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"q", " ", "=", " ", 
          RowBox[{
           RowBox[{"NonCommutativeExpand", "[", 
            RowBox[{"o", ",", " ", "xpAlgebra"}], "]"}], " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"GeneralizedPower", "[", 
               RowBox[{
               "NonCommutativeMultiply", ",", " ", "g_", ",", " ", "k_"}], 
               "]"}], " ", ":>", " ", 
              RowBox[{"g", "^", "k"}]}], ",", " ", 
             RowBox[{"NonCommutativeMultiply", " ", "->", " ", "Times"}]}], 
            "}"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#2", " ", 
             RowBox[{"D", "[", 
              RowBox[{"mgf", ",", " ", 
               RowBox[{"{", 
                RowBox[{"\[Alpha]", ",", " ", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"\[Beta]", ",", " ", 
                 RowBox[{"#1", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], " ", "/.",
             " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Alpha]", " ", "->", " ", "0"}], ",", " ", 
              RowBox[{"\[Beta]", " ", "->", " ", "0"}]}], "}"}]}], ")"}], " ",
           "&"}], " ", "@@@", " ", 
         RowBox[{"CoefficientRules", "[", 
          RowBox[{"q", ",", " ", 
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "po"}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussDrift", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{"gaussMean", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"I", "/", "\[HBar]"}], " ", 
      RowBox[{"Commutator", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"po", " ", "**", " ", "po"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "m"}], ")"}]}], " ", "+", " ", 
         RowBox[{"m", " ", 
          RowBox[{"\[Omega]", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"xo", " ", "**", " ", "xo"}], "/", "2"}]}]}], ",", " ", 
        "o"}], "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"\[Lambda]", "/", "2"}], " ", 
      RowBox[{"Commutator", "[", 
       RowBox[{"xo", ",", " ", 
        RowBox[{"Commutator", "[", 
         RowBox[{"xo", ",", " ", "o"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussNoise", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Eta]", " ", "\[Lambda]"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"gaussMean", "[", 
       RowBox[{"Anticommutator", "[", 
        RowBox[{"xo", ",", " ", "o"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{"2", " ", "mx", " ", 
       RowBox[{"gaussMean", "[", "o", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussCov", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a_", ",", " ", "ma_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b_", ",", " ", "mb_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ab", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", " ", "**", " ", "b"}], " ", "+", " ", 
          RowBox[{"b", " ", "**", " ", "a"}]}], ")"}], "/", "2"}]}], "}"}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"gaussDrift", "[", "ab", "]"}], " ", "-", " ", 
        RowBox[{"ma", " ", 
         RowBox[{"gaussDrift", "[", "b", "]"}]}], " ", "-", " ", 
        RowBox[{"mb", " ", 
         RowBox[{"gaussDrift", "[", "a", "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"gaussNoise", "[", "a", "]"}], " ", 
         RowBox[{"gaussNoise", "[", "b", "]"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"gaussNoise", "[", "ab", "]"}], " ", "-", " ", 
        RowBox[{"ma", " ", 
         RowBox[{"gaussNoise", "[", "b", "]"}]}], " ", "-", " ", 
        RowBox[{"mb", " ", 
         RowBox[{"gaussNoise", "[", "a", "]"}]}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gaussEqs", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"gaussDrift", "[", "#", "]"}], ",", " ", 
          RowBox[{"gaussNoise", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"{", 
        RowBox[{"xo", ",", " ", "po"}], "}"}]}], ",", " ", 
      RowBox[{"gaussCov", " ", "@@@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "mx"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "mx"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xo", ",", " ", "mx"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"po", ",", " ", "mp"}], "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"po", ",", " ", "mp"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"po", ",", " ", "mp"}], "}"}]}], "}"}]}], "}"}]}]}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gaussShow", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mx", " ", "->", " ", 
      RowBox[{"AngleBracket", "[", "\"\<x\>\"", "]"}]}], ",", " ", 
     RowBox[{"mp", " ", "->", " ", 
      RowBox[{"AngleBracket", "[", "\"\<p\>\"", "]"}]}], ",", " ", 
     RowBox[{"\[CapitalSigma]x", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[CapitalSigma]\>\"", ",", " ", "\"\<x\>\""}], "]"}]}], ",",
      " ", 
     RowBox[{"\[CapitalSigma]p", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[CapitalSigma]\>\"", ",", " ", "\"\<p\>\""}], "]"}]}], ",",
      " ", 
     RowBox[{"Cxp", " ", "->", " ", "\"\<C\>\""}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gaussSteadyPurity", " ", "=", " ", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[HBar]", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"\[CapitalSigma]x", " ", "\[CapitalSigma]p"}], " ", "-",
               " ", 
              RowBox[{"Cxp", "^", "2"}]}], "]"}]}], ")"}]}], " ", "/.", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "\[CapitalSigma]x", ",", " ", "Cxp", ",", " ", 
             "\[CapitalSigma]p"}], "}"}], " ", "->", " ", "#"}], "]"}]}], ",",
         " ", 
        RowBox[{
         RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], 
       "]"}], " ", "&"}], " ", "/@", "\n", "    ", 
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"gaussEqs", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"3", " ", ";;"}], ",", " ", "1"}], "]"}], "]"}], " ", "==",
          " ", "0"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "\[CapitalSigma]x", ",", " ", "Cxp", ",", " ", "\[CapitalSigma]p"}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Style", "[", 
  RowBox[{
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"TraditionalForm", "[", "#1", "]"}], ",", " ", 
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{"#2", " ", "/.", " ", "gaussShow"}], "]"}], ",", " ", 
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{"#3", " ", "/.", " ", "gaussShow"}], "]"}]}], "}"}], 
              " ", "&"}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                
                RowBox[{"\"\<\:27e8x\:27e9\>\"", ",", 
                 " ", "\"\<\:27e8p\:27e9\>\"", ",", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<\[CapitalSigma]\>\"", ",", " ", "\"\<x\>\""}], 
                  "]"}], ",", " ", "\"\<C\>\"", ",", " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"\"\<\[CapitalSigma]\>\"", ",", " ", "\"\<p\>\""}], 
                  "]"}]}], "}"}], ",", " ", 
               RowBox[{"gaussEqs", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"gaussEqs", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "}"}]}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\>\"", ",", " ", "\"\<drift (dt)\>\"", ",", 
             " ", "\"\<noise (dW)\>\""}], "}"}]}], "]"}], ",", "\n", "    ", 
         RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
         RowBox[{"Spacings", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0.8"}], "}"}]}]}], "]"}], ",", " ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<every steady state of the drift column: purity = \>\"", 
          ",", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"Riffle", "[", 
            RowBox[{
             RowBox[{"TraditionalForm", " ", "/@", " ", "gaussSteadyPurity"}],
              ",", " ", "\"\<, \>\""}], "]"}], "]"}]}], "}"}], "]"}]}], "}"}],
      ",", " ", "Center"}], "]"}], ",", "\n", "   ", "14", ",", " ", 
   RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[18]:= ",
 CellID->1547910459,ExpressionUUID->"505e4429-ccd7-d2c1-5ec8-e6305ef357e5"],

Cell[TextData[{
 "The two columns define an It\[OHat] process, sampled four times per panel \
from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008dcf5b-952c-bfc0-235f-3e43ce2f3ab8"],
 " and three times the zero-point variances, with ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69ebe31b-1154-3dad-3f31-1863234a7855"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], 
    SuperscriptBox[
     StyleBox["\[Omega]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6834337b-3011-9ea2-69f8-245f30ac5fa8"],
 ", time in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ce5f88c-9021-4437-7d9f-7574e101ff3a"],
 " and ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a1641d-46fa-1619-7eff-23c8443dff94"],
 " dashed:"
}], "Text",
 CellID->1041325139,ExpressionUUID->"3f368234-d4d0-8adc-2199-daa0ebf5b723"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaussRuns", "[", "\[Eta]0_", "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "4", "]"}], ";", " ", 
     RowBox[{
      RowBox[{"RandomFunction", "[", 
       RowBox[{
        RowBox[{"ItoProcess", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"gaussEqs", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
              RowBox[{"List", " ", "/@", " ", 
               RowBox[{"gaussEqs", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], " ",
             "/.", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "mx", ",", " ", "mp", ",", " ", "\[CapitalSigma]x", ",", " ", 
                "Cxp", ",", " ", "\[CapitalSigma]p"}], "}"}], " ", "->", " ", 
              
              RowBox[{"Through", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "mx", ",", " ", "mp", ",", " ", "\[CapitalSigma]x", ",", " ",
                   "Cxp", ",", " ", "\[CapitalSigma]p"}], "}"}], "[", "t", 
                "]"}], "]"}]}], "]"}]}], " ", "/.", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"m", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Omega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[HBar]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Lambda]", " ", "->", " ", "2"}], ",", " ", 
             RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}]}], "}"}]}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "mx", ",", " ", "mp", ",", " ", "\[CapitalSigma]x", ",", " ", 
              "Cxp", ",", " ", "\[CapitalSigma]p"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "0", ",", " ", 
              RowBox[{"3", "/", "2"}], ",", " ", "0", ",", " ", 
              RowBox[{"3", "/", "2"}]}], "}"}]}], "}"}], ",", " ", "t"}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.", ",", " ", "6.", ",", " ", "0.001"}], "}"}], ",", " ", 
        "4"}], "]"}], "[", "\"\<Paths\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaussPanel", "[", 
    RowBox[{"\[Eta]0_", ",", " ", "runs_", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "label_", ",", " ", "f_", ",", " ", "range_", ",", " ", "grid_", ",", 
       " ", "legend_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"f", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
       " ", "runs", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "range"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"label", " ", "===", " ", "\"\<purity\>\""}], ",", " ", 
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "[", "4", "]"}], ",", " ", 
        "Automatic"}], "]"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", "\n", "    ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"grid", " ", "===", " ", "None"}], ",", " ", "Automatic", ",",
           " ", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"y", ",", " ", 
                RowBox[{"Directive", "[", 
                 RowBox[{
                  RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", 
                  "Dashed"}], "]"}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"y", ",", " ", "0.2", ",", " ", "1", ",", " ", "0.2"}],
                "}"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "grid", "]"}], ",", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{"Gray", ",", " ", "Dashed", ",", " ", 
                RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], 
             "}"}]}], "]"}]}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"GridLinesStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], "]"}]}],
      ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Omega] t\>\"", ",", " ", "label"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]0", ",", 
         " ", "\"\<,   \[Mu] = 4\>\""}], "}"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"If", "[", 
       RowBox[{"legend", ",", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "4", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<run \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
              "&"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "4", "]"}]}], ",", " ", 
            RowBox[{"LegendMarkerSize", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"12", ",", " ", "8"}], "}"}]}], ",", " ", 
            RowBox[{"LabelStyle", " ", "->", " ", "9"}], ",", " ", 
            RowBox[{"Spacings", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"0.3", ",", " ", "0.1"}], "}"}]}], ",", " ", 
            RowBox[{"LegendFunction", " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Framed", "[", 
                RowBox[{"#", ",", " ", 
                 RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
                 RowBox[{"FrameStyle", " ", "->", " ", 
                  RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", " ", 
                 RowBox[{"FrameMargins", " ", "->", " ", "1"}]}], "]"}], " ", 
               "&"}], ")"}]}]}], "]"}], ",", " ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.02", ",", " ", "0.02"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Left", ",", " ", "Bottom"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rows", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"\[Eta]0", ",", " ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"runs", " ", "=", " ", 
             RowBox[{"gaussRuns", "[", "\[Eta]0", "]"}]}], "}"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"gaussPanel", "[", 
              RowBox[{"\[Eta]0", ",", " ", "runs", ",", " ", "#"}], "]"}], 
             " ", "&"}], " ", "/@", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<\:27e8x\:27e9\>\"", ",", " ", "First", ",", " ", 
                "All", ",", " ", "None", ",", " ", 
                RowBox[{"\[Eta]0", " ", "==", " ", 
                 RowBox[{"1", "/", "5"}]}]}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<purity\>\"", ",", " ", 
                RowBox[{
                 RowBox[{"1", "/", 
                  RowBox[{"(", 
                   RowBox[{"2", " ", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "5", "]"}], "]"}]}], " ", "-", " ", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}], "]"}]}], 
                   ")"}]}], " ", "&"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "1.05"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"Sqrt", "[", "\[Eta]0", "]"}], "}"}], ",", " ", 
                "False"}], "}"}]}], "}"}]}]}], "]"}]}], "]"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "5"}], ",", " ", "1"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PlotGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"First", "[", "rows", "]"}], "}"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "650"}]}], "]"}], ",", " ", 
       RowBox[{"PlotGrid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Show", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"AspectRatio", " ", "->", " ", 
               RowBox[{"1", "/", "2"}]}]}], "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Last", "[", "rows", "]"}]}], "}"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "650"}]}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"Spacings", " ", "->", " ", "0"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[19]:= ",
 CellID->1219526466,ExpressionUUID->"00d5c8b2-6c0f-d44a-1224-d95897ec462f"],

Cell[TextData[{
 "The noise of all three widths is zero for every parameter: the four runs \
put the packet in four places, so the means fan out, but they give it the \
same widths at the same time, and the purity curves fall on one line. The \
widths obey the Riccati equation in the drift column, where the efficiency \
scales the information terms ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Eta]", "\[Lambda]"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f4bac16-d011-04bb-6dab-e892b4ed5e6f"],
 " but not the heating ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5230e357-9e52-4b0c-0c25-65d89e67f458"],
 ", and every steady state of that equation has purity ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf2ec3d-ec6e-a989-4160-ff78ccbb633f"],
 "."
}], "Text",
 CellID->585161887,ExpressionUUID->"61ac153d-5a77-562e-05f9-425f27338835"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2053749851,ExpressionUUID->"52a0cddf-e3e1-54ea-0ce6-eec38729a3cc"],

Cell["\<\
The quantum Kalman filter: five numbers against a wavefunction\
\>", "Subsection",
 CellID->594572180,ExpressionUUID->"61f1fd5e-bf3a-146f-3f99-733d513b8c44"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e58830-b4fe-83e9-28eb-c1ce633433e1"],
 " sits in the potential ",
 Cell[BoxData[
  RowBox[{
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   StyleBox["\[CurlyEpsilon]", "TI"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24320408-6c20-5464-007b-63c11bf7e9a0"],
 ", and a perfect detector reads its position continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c710a60-810c-5215-2043-1dc6ada8dfd4"],
 ". Can five numbers, updated from the readings alone, follow the mean \
position that the full conditional wavefunction carries?"
}], "Text",
 CellID->1535497137,ExpressionUUID->"05833434-62a0-52e0-6a6f-50f826da6bd1"],

Cell[TextData[{
 "In a step ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "t"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "104c6ddd-868a-924d-15b4-35e479e1fa29"],
 " the detector returns a reading ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["x", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ef5af62-3f3f-b805-3872-144386719713"],
 ", distributed as ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fab34a0-17e2-02d8-4e6e-849dd6f8bb87"],
 " blurred by a Gaussian of variance ",
 Cell[BoxData[
  FractionBox["1", 
   RowBox[{"4", 
    StyleBox["\[Lambda]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "625baf77-8f7e-424b-51f5-e954f1415688"],
 ". Bayes' rule updates the wavefunction, and the Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], "/", "2", 
   StyleBox["m", "TI"], "+", 
   StyleBox["V", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bcaa953-2370-b3c7-21c5-0d77d1a99c20"],
 " moves it (",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ec3248b-7e9a-7f83-7dec-00f91ffcce2c"],
 "):"
}], "Text",
 CellID->87369187,ExpressionUUID->"4aacd4c3-0859-692e-0e16-c435377f41a2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Psi]", "TI"], "\[ThickSpace]", "\[Rule]", "\[ThickSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["H", "TI"], "\[ThinSpace]", 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}]], "\[ThinSpace]", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["\[Lambda]", "TI"], 
        StyleBox["d", "TI"], 
        StyleBox["t", "TI"], "\[ThinSpace]", 
        SuperscriptBox[
         RowBox[{
          StyleBox["(",
           SpanMaxSize->1], 
          RowBox[{
           StyleBox["x", "TI"], "-", 
           OverscriptBox[
            StyleBox["x", "TI"], "_"]}], 
          StyleBox[")",
           SpanMaxSize->1]}], "2"]}]], 
      StyleBox["\[Psi]", "TI"]}], GridBox[{
       {GridBox[{
          {
           RowBox[{
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{"-", 
              StyleBox["\[Lambda]", "TI"], 
              StyleBox["d", "TI"], 
              StyleBox["t", "TI"], "\[ThinSpace]", 
              SuperscriptBox[
               RowBox[{
                StyleBox["(",
                 SpanMaxSize->1], 
                RowBox[{
                 StyleBox["x", "TI"], "-", 
                 OverscriptBox[
                  StyleBox["x", "TI"], "_"]}], 
                StyleBox[")",
                 SpanMaxSize->1]}], "2"]}]], 
            StyleBox["\[Psi]", "TI"]}]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.22}}}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1816486678,ExpressionUUID->"11085de7-e2b9-6fb2-5261-fa664f9e28cc"],

Cell[TextData[{
 "The Kalman filter assumes a Gaussian state in the harmonic trap, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[CurlyEpsilon]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f722cd-77a0-68e6-26ce-fc5f84db71c1"],
 ", and carries only its means and covariances, corrected by the innovation \
",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "_"], "-", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04a37261-17a2-fe42-6cb7-2a55ee69824c"],
 ", the reading minus the predicted mean:"
}], "Text",
 CellID->694469191,ExpressionUUID->"03ccaa27-d5ef-3614-374b-c268ce9e9e3d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "=", 
    FractionBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["p", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["m", "TI"]], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", "4", 
    StyleBox["\[Lambda]", "TI"], 
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["x", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["x", "TI"], "_"], "-", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["p", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       StyleBox["m", "TI"]}], 
      SuperscriptBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       StyleBox["x", "TI"], "\[VeryThinSpace]", 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}], "+", 
     RowBox[{"4", 
      StyleBox["\[Lambda]", "TI"], 
      StyleBox["C", "TI"], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        OverscriptBox[
         StyleBox["x", "TI"], "_"], "-", 
        StyleBox["\[LeftAngleBracket]",
         SpanMaxSize->1], 
        StyleBox["x", "TI"], "\[VeryThinSpace]", 
        StyleBox["\[RightAngleBracket]",
         SpanMaxSize->1]}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["d", "TI"], 
      StyleBox["t", "TI"]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->732065401,ExpressionUUID->"582413cc-d644-c4e9-50d5-8a73ecc86aad"],

Cell[TextData[{
 "and its covariances ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b64124-129f-1f69-5948-ac273fe532d5"],
 ", ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a534153-c70e-4ae4-6e8c-44f4320c3ed1"],
 ", ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e686a2b-3c2e-9e03-64f5-780114356ea6"],
 " obey the Riccati equations of the trapped-particle slide at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7050c46e-3b34-d284-53a4-4f6bfb6da8a9"],
 ", with ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "750adbed-ed5e-85d2-3550-0fd16588277f"],
 "."
}], "Text",
 CellID->445277513,ExpressionUUID->"72ba438d-11fb-f871-67c4-d555b06c6bf7"],

Cell[TextData[{
 "The wavefunction runs on 256 grid points with a split-operator step, from a \
coherent state displaced to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a3b1d96-c773-bfc4-40ff-001acc55569d"],
 ", and the filter receives the same readings. Lengths are in units of ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"\[HBar]", "/", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox[
     RowBox[{"m", "\[Omega]"}], "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f41b9c2-4dec-0396-45cc-7519740ed0ce"],
 ", time in ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e950d68-089d-4844-5633-1e6defc22d1c"],
 ", the strength is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], 
    SuperscriptBox[
     StyleBox["\[Omega]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41814004-1bb1-cd4c-7317-8cd9090a81ec"],
 " and ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a761929-7f90-1b1b-51da-a49b2e7a7c17"],
 " is in units of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["m", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "3"], "/", "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af13182-5b3d-2bb8-6d75-45072e4e859f"],
 ":"
}], "Text",
 CellID->724145374,ExpressionUUID->"36ae2856-4b42-e6bc-0593-09b7fa81431e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kalmanX", " ", "=", " ", 
   RowBox[{"24.", " ", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "128"}], ",", " ", "127"}], "]"}], "/", "256"}]}]}], ";", 
  " ", 
  RowBox[{"kalmanP", " ", "=", " ", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{
     RowBox[{"RotateLeft", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "128"}], ",", " ", "127"}], "]"}], ",", " ", "128"}], 
      "]"}], "/", "24."}]}]}], ";", " ", 
  RowBox[{"kalmanDt", " ", "=", " ", "0.002"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kalmanGrid", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[CurlyEpsilon]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]0", " ", "=", " ", 
        RowBox[{"\[Mu]", "/", "2"}]}], ",", " ", 
       RowBox[{"half", " ", "=", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"kalmanX", "^", "2"}], "/", "2"}], " ", "+", " ", 
            RowBox[{"\[CurlyEpsilon]", " ", 
             RowBox[{"kalmanX", "^", "4"}]}]}], ")"}], " ", 
          RowBox[{"kalmanDt", "/", "2"}]}], "]"}]}], ",", " ", 
       RowBox[{"kin", " ", "=", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"kalmanP", "^", "2"}], " ", 
          RowBox[{"kalmanDt", "/", "2"}]}], "]"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Reap", "[", 
      RowBox[{"NestList", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"xb", " ", "=", " ", 
             RowBox[{
              RowBox[{"RandomChoice", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], " ", "->", " ", 
                "kalmanX"}], "]"}], " ", "+", " ", 
              RowBox[{"RandomVariate", "[", 
               RowBox[{"NormalDistribution", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"1", "/", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"4", " ", "\[Lambda]0", " ", "kalmanDt"}], 
                   "]"}]}]}], "]"}], "]"}]}]}], "}"}], ",", "\n", "       ", 
           RowBox[{"half", " ", 
            RowBox[{"InverseFourier", "[", 
             RowBox[{"kin", " ", 
              RowBox[{"Fourier", "[", 
               RowBox[{"half", " ", 
                RowBox[{"Normalize", "[", 
                 RowBox[{
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "\[Lambda]0"}], " ", "kalmanDt", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"kalmanX", " ", "-", " ", 
                    RowBox[{"Sow", "[", "xb", "]"}]}], ")"}], "^", "2"}]}], 
                   "]"}], " ", "#"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], " ",
          "&"}], ",", " ", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"kalmanX", " ", "-", " ", "3"}], ")"}], "^", "2"}]}], "/",
            "2"}], "]"}], "]"}], ",", " ", "5000"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kalmanFilter", "[", 
    RowBox[{"\[Mu]_", ",", " ", "readings_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Lambda]0", " ", "=", " ", 
       RowBox[{"\[Mu]", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"FoldList", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "xb"}], "}"}], ",", " ", 
          RowBox[{"v", " ", "/.", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "mx_", ",", " ", "mp_", ",", " ", "vx_", ",", " ", "c_", ",", 
              " ", "vp_"}], "}"}], " ", ":>", " ", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"g", " ", "=", " ", 
                RowBox[{"4", " ", "\[Lambda]0", " ", 
                 RowBox[{"(", 
                  RowBox[{"xb", " ", "-", " ", "mx"}], ")"}], " ", 
                 "kalmanDt"}]}], "}"}], ",", "\n", "       ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "mx", ",", " ", "mp", ",", " ", "vx", ",", " ", "c", ",", " ",
                  "vp"}], "}"}], " ", "+", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"mp", " ", "kalmanDt"}], " ", "+", " ", 
                  RowBox[{"g", " ", "vx"}]}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "mx"}], " ", "kalmanDt"}], " ", "+", " ", 
                  RowBox[{"g", " ", "c"}]}], ",", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"2", " ", "c"}], " ", "-", " ", 
                    RowBox[{"4", " ", "\[Lambda]0", " ", 
                    RowBox[{"vx", "^", "2"}]}]}], ")"}], " ", "kalmanDt"}], ",",
                  " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"vp", " ", "-", " ", "vx", " ", "-", " ", 
                    RowBox[{"4", " ", "\[Lambda]0", " ", "vx", " ", "c"}]}], 
                   ")"}], " ", "kalmanDt"}], ",", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "2"}], " ", "c"}], " ", "+", " ", 
                    "\[Lambda]0", " ", "-", " ", 
                    RowBox[{"4", " ", "\[Lambda]0", " ", 
                    RowBox[{"c", "^", "2"}]}]}], ")"}], " ", "kalmanDt"}]}], 
                "}"}]}]}], "]"}]}]}]}], "]"}], ",", "\n", "     ", 
        RowBox[{"{", 
         RowBox[{
         "3.", ",", " ", "0.", ",", " ", "0.5", ",", " ", "0.", ",", " ", 
          "0.5"}], "}"}], ",", " ", "readings"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kalmanPanel", "[", 
    RowBox[{"\[Mu]_", ",", " ", "\[CurlyEpsilon]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
         RowBox[{"kalmanGrid", "[", 
          RowBox[{"\[Mu]", ",", " ", "\[CurlyEpsilon]"}], "]"}]}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], " ", ".", " ", 
            "kalmanX"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"First", "[", "run", "]"}]}], ",", " ", 
         RowBox[{"kalmanFilter", "[", 
          RowBox[{"\[Mu]", ",", " ", 
           RowBox[{"run", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",",
        " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "10"}], "}"}]}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", 
       "     ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Omega] t\>\"", ",", " ", "\"\<\:27e8x\:27e9\>\""}], 
         "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[Mu] = \>\"", ",", " ", "\[Mu]", ",", 
           " ", "\"\<,   \[CurlyEpsilon] = \>\"", ",", " ", 
           "\[CurlyEpsilon]"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", "\n", "     ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<wavefunction, 256 amplitudes\>\"", ",", 
          " ", "\"\<Kalman filter, 5 numbers\>\""}], "}"}]}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kalmanPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"kalmanPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "10"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.01", ",", " ", "0.05"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "kalmanPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"kalmanPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[20]:= ",
 CellID->1893161544,ExpressionUUID->"203a0b5b-6349-ce51-137d-e8d129ee66d6"],

Cell[TextData[{
 "In the harmonic trap the filter lies on the wavefunction's mean at both \
strengths: the conditional state stays Gaussian, so the 256 amplitudes carry \
nothing the five numbers miss. A quartic term makes the state non-Gaussian \
and the filter's harmonic model wrong. It drifts away under gentle watching. \
Under strong watching each reading pulls it back, and it falls visibly behind \
the faster true oscillation only at the larger ",
 Cell[BoxData[
  StyleBox["\[CurlyEpsilon]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dbb70b5-fc62-d10c-67dc-db38b61ed90f"],
 "."
}], "Text",
 CellID->364502057,ExpressionUUID->"3563bc16-b421-9b42-51d6-0024e73deebe"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->245921084,ExpressionUUID->"3c426765-4de9-65cf-3f64-48b2016bb994"],

Cell["\<\
How much cavity Wigner negativity the atomic record certifies\
\>", "Subsection",
 CellID->912608870,ExpressionUUID->"19fe91a0-c9b5-5838-2df8-9ba521a5d9d1"],

Cell[TextData[{
 "An excited atom meets a cavity field, and after a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69c41ecb-dcfb-e1ff-4221-d75601397338"],
 " only the atom's inversion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["e", "TI"]], "-", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["g", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "020c4ac1-c437-e585-4180-fa3211d41c40"],
 " is recorded. The cavity, coupled to the atom at strength ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10350667-1c33-7a03-23fc-5e1ad413a82a"],
 ", detuned by ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "637d0ca2-de27-548f-25de-eb6d7f772f5c"],
 " and leaking photons at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f5bf764-d6a6-9bac-0357-e301b5ba4747"],
 ", can develop a Wigner function ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65d63cc7-d551-dbc2-2d38-f2bd2c7e2c7d"],
 " with negative regions. Fields with the same photon-number distribution ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06033641-d74e-562a-0f20-200f4d01548f"],
 " give the atom the same record; how much negative volume ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"-", 
     StyleBox["W", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24cafb8a-8a75-ee0c-00da-511ffbed1584"],
 " do all of them share?"
}], "Text",
 CellID->1410349120,ExpressionUUID->"6c57946b-f53e-03bb-4024-894862cb33a9"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e6e6-28e4-9606-19ca-bfdc3d668f4a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["e", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "307f71e8-a38e-5fc1-1852-44ce83f7691c"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["g", "TI"]},
    "Ket"], "=", 
   TemplateBox[{"1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4db69efd-27a5-9c5c-3aa8-d26de1c3c6c9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Bra"]}], "-", 
    RowBox[{
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fbb7796-bb70-3bbb-7c66-7cbeb347a467"],
 ", the atom and cavity, frequencies ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["a", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ccd7ce5-5b2e-9518-33e1-8138dbffeba8"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cdd02d2-1931-950b-2016-1ce83f69dc5d"],
 ", follow the Jaynes-Cummings Hamiltonian in the frame rotating at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f3f454c-d01e-a6fd-5044-51f55add312f"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], "+", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "-"], 
    SuperscriptBox[
     StyleBox["a", "TI"], "\[Dagger]"], "+", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "+"], 
    StyleBox["a", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "438bfc79-f262-d50f-67c9-3e0999141ae8"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["a", "TI"]], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], 
    StyleBox["c", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a90d4f6-c16a-5d57-5ced-44a2676b24c1"],
 ", and the loss enters through ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["H", "TI"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["a", "TI"], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f5da9bd-a6fa-5d6c-5290-4792f5306c91"],
 ". The coupling conserves the excitation number ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "+"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "-"], "+", 
   SuperscriptBox[
    StyleBox["a", "TI"], "\[Dagger]"], 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37459457-f2f1-2fcf-73bf-b540f40390ad"],
 " and loss only lowers it, so an atom starting in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40774a1a-e810-e030-0fff-a9deaabf8838"],
 " writes into ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b476539-d012-123b-4e45-25bb7ef5fe5d"],
 " only the photon-number distribution ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f33d8fe-a26e-11bf-4b69-63700bcf4ec1"],
 " of the field. Averaging the field over its phase keeps ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f8b8ed0-2752-44f0-5f16-69ede144e433"],
 " and averages ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417ef199-c730-1e84-1ee7-f51cbcdcb440"],
 " over the angle, which can cancel negative regions but never create them; \
the averaged ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e32f60-cc74-af16-5a4a-eac9de577518"],
 " depends only on the radius, so its negative volume is a radial integral."
}], "Text",
 CellID->1167983258,ExpressionUUID->"0b5acb92-1560-f3e0-4c36-6bb85e6bb526"],

Cell[TextData[{
 "For the phase-randomized field, with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dc7536f-ac0b-d9a5-0308-fbde709bb4f3"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42da3d16-184d-cf77-734e-e0d5329e6aba"],
 " the Laguerre polynomial, the negative volume follows from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1332a694-04ac-b232-5332-40adfa349355"],
 " alone:"
}], "Text",
 CellID->371025263,ExpressionUUID->"0a047837-cf46-e1c4-111e-2c967ed49984"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["N", "TI"], "_"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{"2", "\[Pi]", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
      RowBox[{
       StyleBox["r", "TI"], "\[ThinSpace]", 
       StyleBox["max",
        FontSlant->"Plain"], "\[ThinSpace]", 
       RowBox[{"(", 
        RowBox[{"0", ",", "\[ThinSpace]", 
         RowBox[{"-", 
          RowBox[{
           UnderscriptBox["\[Sum]", 
            StyleBox["n", "TI"],
            LimitsPositioning->False], 
           RowBox[{
            SubscriptBox[
             StyleBox["p", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{
             StyleBox["(",
              SpanMaxSize->1], 
             StyleBox["t", "TI"], 
             StyleBox[")",
              SpanMaxSize->1]}], "\[ThinSpace]", 
            SubscriptBox[
             StyleBox["W", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{
             StyleBox["(",
              SpanMaxSize->1], 
             StyleBox["r", "TI"], 
             StyleBox[")",
              SpanMaxSize->1]}]}]}]}]}], ")"}], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["r", "TI"]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["n", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["r", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"-", "1"}], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       StyleBox["n", "TI"]], "\[Pi]"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["L", "TI"], 
      StyleBox["n", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"2", 
       SuperscriptBox[
        StyleBox["r", "TI"], "2"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "\[ThinSpace]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        SuperscriptBox[
         StyleBox["r", "TI"], "2"]}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1970769953,ExpressionUUID->"07d1b1b9-f98c-9d04-0008-57ae5bec5387"],

Cell[TextData[{
 "The atom starts in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bea6757-5515-d81d-2688-de101b18fe0f"],
 " with a coherent field of mean photon number 4, and with its \
phase-randomized version ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["n", "TI"],
    LimitsPositioning->False], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["n", "TI"]], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "379f3620-e475-d0a0-654f-4465c5b5cebb"],
 ". The left panel plots the record ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17f205ca-94b0-32e7-6dda-b8e36cd3dda9"],
 "; the right panel plots the negative volume ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"-", 
     StyleBox["W", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519b3df1-4bd0-7fd2-160a-73e805b227c8"],
 " of the coherent field (solid) and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["N", "TI"], "_"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "516c731b-9d85-c71c-74f6-480a884de942"],
 " (dashed); time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
