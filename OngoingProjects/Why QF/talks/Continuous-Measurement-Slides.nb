  FontSize->0.9 Inherited,ExpressionUUID->
  "4edd03e6-602f-9f1e-443e-12e7afc8147d"],
 ":"
}], "Text",
 CellID->1458776515,ExpressionUUID->"3a80d946-cec9-e749-6907-2cc96752fe9d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"negA", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", 
    RowBox[{"20", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"negField", " ", "=", " ", 
   RowBox[{
    RowBox[{"CoherentState", "[", "20", "]"}], "[", "2.", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negH", "[", "\[CapitalDelta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
     RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], " ", "@", " ", 
     RowBox[{"SuperDagger", "[", "negA", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"SuperDagger", "[", 
      RowBox[{"QuantumOperator", "[", "\"\<-\>\"", "]"}], "]"}], " ", "@", 
     " ", "negA"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negVolume", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Ramp", "[", 
      RowBox[{"-", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"WignerRepresentation", "[", 
          RowBox[{"\[Rho]", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5."}], ",", " ", "5."}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5."}], ",", " ", "5."}], "}"}], ",", " ", 
           RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "81"}]}], "]"}], 
         "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}]}], "]"}], "]"}], "/", 
    "64"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negRadii", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0.005", ",", " ", "6", ",", " ", "0.01"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"negFock", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "m"}], " ", 
      RowBox[{"LaguerreL", "[", 
       RowBox[{"m", ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"negRadii", "^", "2"}]}]}], "]"}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"negRadii", "^", "2"}]}], "]"}], "/", "\[Pi]"}]}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "19"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negRadial", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{"2", " ", "\[Pi]", " ", "0.01", " ", 
    RowBox[{"negRadii", " ", ".", " ", 
     RowBox[{"Ramp", "[", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Diagonal", "[", 
          RowBox[{"Normal", "[", 
           RowBox[{"\[Rho]", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], 
          "]"}], "]"}], " ", ".", " ", "negFock"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negRun", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Kappa]_", ",", " ", "\[CapitalDelta]_"}], "}"}], ",", " ", 
     "field_", ",", " ", "volume_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"evo", " ", "=", " ", 
       RowBox[{"QuantumEvolve", "[", 
        RowBox[{
         RowBox[{"negH", "[", "\[CapitalDelta]", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"{", "negA", "}"}], " ", "->", " ", 
          RowBox[{"{", "\[Kappa]", "}"}]}], ",", " ", 
         RowBox[{"QuantumTensorProduct", "[", 
          RowBox[{
           RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
           "field"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", "0", ",", " ", "16"}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<record\>\"", ",", " ", "\"\<negativity\>\""}], "}"}], 
       " ", "->", " ", 
       RowBox[{"Transpose", " ", "@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"s", ",", " ", 
              RowBox[{"Re", " ", "@", " ", 
               RowBox[{"Tr", "[", 
                RowBox[{
                 RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
                 RowBox[{"Normal", " ", "@", " ", 
                  RowBox[{
                   RowBox[{"QuantumPartialTrace", "[", 
                    RowBox[{
                    RowBox[{"evo", "[", "s", "]"}], ",", " ", 
                    RowBox[{"{", "2", "}"}]}], "]"}], 
                   "[", "\"\<DensityMatrix\>\"", "]"}]}]}], "]"}]}]}], "}"}], 
            ",", "\n", "       ", 
            RowBox[{"{", 
             RowBox[{"s", ",", " ", 
              RowBox[{"volume", "[", 
               RowBox[{"QuantumPartialTrace", "[", 
                RowBox[{
                 RowBox[{"evo", "[", "s", "]"}], ",", " ", 
                 RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "0", ",", " ", "16", ",", " ", "0.1"}], 
           "}"}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negCases", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", " ", "2"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negData", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Merge", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"negRun", "[", 
           RowBox[{"#", ",", " ", "negField", ",", " ", "negVolume"}], "]"}], 
          ",", " ", 
          RowBox[{"negRun", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"QuantumState", "[", 
             RowBox[{
              RowBox[{"DiagonalMatrix", "[", 
               RowBox[{"negField", "[", "\"\<ProbabilitiesList\>\"", "]"}], 
               "]"}], ",", " ", "20"}], "]"}], ",", " ", "negRadial"}], 
           "]"}]}], "}"}], ",", " ", "Identity"}], "]"}], " ", "&"}], ",", 
     " ", "negCases"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negAxes", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<record\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[LeftAngleBracket]\>\"", ",", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[Sigma]\>\"", ",", " ", "\"\<z\>\""}], "]"}], ",", 
           " ", "\"\<\[RightAngleBracket]\>\""}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"\"\<negativity\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<negative volume\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0.4"}], "}"}]}], "}"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negPanel", "[", 
    RowBox[{"key_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Kappa]_", ",", " ", "\[CapitalDelta]_"}], "}"}]}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"negData", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Kappa]", ",", " ", "\[CapitalDelta]"}], "}"}], ",", " ", 
       "key"}], "]"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{
       RowBox[{"negAxes", "[", "key", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<coherent field\>\"", ",", 
        " ", "\"\<phase-randomized field\>\""}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<g t\>\"", ",", " ", 
        RowBox[{
         RowBox[{"negAxes", "[", "key", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"negPanels", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"negPanel", "[", 
          RowBox[{"#", ",", " ", "c"}], "]"}], " ", "&"}], " ", "/@", " ", 
        RowBox[{"Keys", "[", "negAxes", "]"}]}]}], "]"}], ",", " ", 
     "negCases"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{"First", " ", "/@", " ", 
        RowBox[{"negPanels", "[", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "d"}], "}"}], "]"}]}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"First", "[", 
        RowBox[{"negPanels", "[", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "d"}], "}"}], "]"}], "]"}], "]"}], "]"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "\"\<\[Kappa]/g\>\""}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.1"}], "}"}], ",", " ", "SetterBar"}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "0", ",", " ", "\"\<\[CapitalDelta]/g\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "2"}], "}"}], ",", " ", "SetterBar"}], "}"}], ",",
    " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[21]:= ",
 CellID->1284630344,ExpressionUUID->"7a7947ce-db6b-573f-7029-621e5ec78748"],

Cell[TextData[{
 "The cavity's Wigner function shows what the two curves measure; red is \
positive and blue negative, on resonance and without loss, at four times in \
units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6743d148-d770-68a0-6bc7-d02614e808e8"],
 ":"
}], "Text",
 CellID->1097657070,ExpressionUUID->"5d379dd1-37d1-0c2a-7468-1c0ce0b697e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"negTimes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "2", ",", " ", "6", ",", " ", "12"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"negColor", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{"w", ",", " ", 
     RowBox[{"Blend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.2", ",", " ", "0.3", ",", " ", "0.8"}], "]"}], ",", " ", 
         "White", ",", " ", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.85", ",", " ", "0.2", ",", " ", "0.15"}], "]"}]}], "}"}],
        ",", " ", 
       RowBox[{"0.5", " ", "+", " ", 
        RowBox[{"0.5", " ", 
         RowBox[{"Sign", "[", "w", "]"}], " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "w", "]"}], "/", "0.32"}], ",", " ", "1"}], 
           "]"}], "]"}]}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negEvo", "[", "field_", "]"}], " ", ":=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"negH", "[", "0", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", "negA", "}"}], " ", "->", " ", 
      RowBox[{"{", "0", "}"}]}], ",", " ", 
     RowBox[{"QuantumTensorProduct", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", "field"}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "16"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"negTile", "[", 
    RowBox[{"evo_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"WignerRepresentation", "[", 
          RowBox[{
           RowBox[{"QuantumPartialTrace", "[", 
            RowBox[{
             RowBox[{"evo", "[", "s", "]"}], ",", " ", 
             RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4."}], ",", " ", "4."}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4."}], ",", " ", "4."}], "}"}], ",", " ", 
           RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "81"}]}], "]"}], 
         "[", "\"\<ValuesOnGrid\>\"", "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ListDensityPlot", "[", 
      RowBox[{"w", ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "4"}], ",", " ", "4"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", "\n", 
       "    ", 
       RowBox[{"ColorFunction", " ", "->", " ", "negColor"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameTicks", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"FrameStyle", " ", "->", " ", 
        RowBox[{"GrayLevel", "[", "0.7", "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "110"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"f", ",", " ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"negTile", "[", 
               RowBox[{
                RowBox[{"negEvo", "[", 
                 RowBox[{"Last", "[", "f", "]"}], "]"}], ",", " ", "#"}], 
               "]"}], " ", "&"}], " ", "/@", " ", "negTimes"}], ",", " ", 
            RowBox[{"First", "[", "f", "]"}]}], "]"}]}], "]"}], " ", "/@", 
        "\n", "    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<coherent field\>\"", " ", "->", " ", "negField"}], ",",
           " ", 
          RowBox[{"\"\<phase-randomized field\>\"", " ", "->", " ", 
           RowBox[{"QuantumState", "[", 
            RowBox[{
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"negField", "[", "\"\<ProbabilitiesList\>\"", "]"}], 
              "]"}], ",", " ", "20"}], "]"}]}]}], "}"}]}], ",", "\n", "   ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<g t = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", "negTimes"}], ",", " ", "\"\<\>\""}], 
        "]"}]}], "]"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", "0.5"}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"BarLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"negColor", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.32"}], ",", " ", "0.32"}], "}"}]}], "}"}], ",", 
       " ", 
       RowBox[{"LegendLabel", " ", "->", " ", "\"\<W(x, p)\>\""}]}], "]"}], ",",
      " ", "Right"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[22]:= ",
 CellID->1763005307,ExpressionUUID->"24ec18a2-7730-0ac4-5fac-d9e33f5e688f"],

Cell[TextData[{
 "The two records coincide in every panel, so the atom cannot tell the \
coherent field from its phase-randomized version; in phase space the coherent \
field carries strong negative stripes, while its phase-randomized twin keeps \
only a thin negative ring. Any field with the same ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b13fc8-4889-107a-1b88-1ae26958ac5b"],
 " has at least the dashed negative volume, and the phase-randomized field \
reaches it, so the dashed curve is what they all share; it wiggles because \
the atom keeps trading photons with the field and reshapes ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "244b94f0-5c02-d1a8-57d4-bb2de09649f6"],
 " on the Rabi time scale. The rest, carried by coherences between photon \
numbers, is most of the negativity between collapse and revival, and with \
loss the guaranteed part is the first to vanish."
}], "Text",
 CellID->1115878925,ExpressionUUID->"6cf4ca0b-a024-b7d6-5633-7eea9e016ad5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2125569533,ExpressionUUID->"0c0b7f15-3a1e-228d-23ee-1a50b2c664b2"],

Cell["Two qubits entangled by a measurement alone", "Subsection",
 CellID->1120586436,ExpressionUUID->"2104ec2e-4f49-8a45-69ff-920eb22d9cca"],

Cell[TextData[{
 "Two qubits that never interact are read by one probe, a half-parity meter: \
its output ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a518eb6-4464-8f20-2078-26217455f4e3"],
 ", averaged over a window ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "043b2adc-5be9-e58a-3eb1-30380e8d70fb"],
 ", is Gaussian about ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b15327f-f35e-37b6-3bae-c95997580236"],
 " for ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b546fc0-920f-cf78-4608-21520f62ca9f"],
 ", ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1451c2a1-f34c-7320-0b76-b461d8e20adc"],
 " for ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c6154f2-0481-32db-6ee5-5d8c3606ae80"],
 " and ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425724da-6e7f-11d0-20bb-5a4f0d7ff26d"],
 " for both ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21bb91c3-42e0-0b17-0c3f-133b093b0074"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71c98de5-9f69-8dd3-1b3b-629399056bd4"],
 ", with white noise of spectral density ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52b38fc5-da66-6435-2076-a071454bcc8b"],
 ", and the meter also dephases the odd pair at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5635d7cf-c382-3f97-122b-e2f2ddb8c8ff"],
 ". Starting from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], 
   TemplateBox[{"+"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47db946a-1a94-68db-6f3c-19a8510a2b33"],
 ", can the record alone entangle the pair?"
}], "Text",
 CellID->25958871,ExpressionUUID->"30fdcaaa-0920-4a25-7cc3-0055aa306bec"],

Cell[TextData[{
 "A window leaves a reading of variance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", 
   StyleBox["s", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[CapitalDelta]", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b01ae48-f0f5-4321-2256-9fb29d75b59e"],
 ". Coherences between states the meter tells apart are assumed to dephase \
fast, so the state keeps five numbers ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"00", ",", "00"}]], ",", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"01", ",", "01"}]], ",", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"10", ",", "10"}]], ",", 
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"11", ",", "11"}]], ",", GridBox[{
      {
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], 
        RowBox[{"01", ",", "10"}]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a9227d-6d14-98e3-5519-da3c8965e4a2"],
 ", and Korotkov's quantum Bayes rule updates them for each reading:"
}], "Text",
 CellID->1462357393,ExpressionUUID->"4a78178f-4bdf-dc1d-3823-2b340d41d9c2"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["i", "TI"]], "\[Rule]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["i", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["j", "TI"], "=", "1"}], "4",
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]], 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["j", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]], " ", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["i", "TI"], "\[LessEqual]", "4"}], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "5"], "\[Rule]", 
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["x", "TI"], "5"], 
      SubscriptBox[
       StyleBox["P", "TI"], "2"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1], "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"-", 
        StyleBox["\[Gamma]", "TI"], "\[CapitalDelta]", 
        StyleBox["t", "TI"]}]]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        StyleBox["j", "TI"], "=", "1"}], "4",
       LimitsPositioning->False], 
      SubscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["j", "TI"]], 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["j", "TI"]], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["i", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["V", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["V", "TI"], "-", 
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["i", "TI"]]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "2"], "/", "2", 
      StyleBox["D", "TI"]}]]}], ",", "\[NonBreakingSpace]\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["v", "TI"], "=", 
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       RowBox[{"-", 
        StyleBox["\[Delta]", "TI"], 
        StyleBox["v", "TI"]}], ",", "0", ",", "0", ",", 
       StyleBox[
        RowBox[{"\[Delta]", "v"}], "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->572246452,ExpressionUUID->"0049fe35-1f8d-3a61-4f4d-c6481200a1f3"],

Cell[TextData[{
 "On the states this rule produces, the Wootters concurrence is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", 
   RowBox[{"2", 
    StyleBox["max",
     FontSlant->"Plain"], "\[ThinSpace]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "\[ThinSpace]", 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], "5"], "-", 
       SqrtBox[
        RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], 
         SubscriptBox[
          StyleBox["x", "TI"], "4"]}]]}]}], ")"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21c9d47d-9b6d-2ac9-4feb-52730e201c80"],
 ". Gaussian likelihoods multiply, so from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], 
   TemplateBox[{"+"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "747df118-f769-c9b7-2bcc-4225708a752c"],
 " a record enters only through its running mean ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["V", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd0aa9f-ee18-2f70-0db5-446363a91145"],
 ", and after a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dbf7607-7d8f-3116-46ce-b5fcc7af445c"]
}], "Text",
 CellID->351728041,ExpressionUUID->"4d4d8ab3-8121-24a0-2b4f-038185589769"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["C", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      OverscriptBox[
       StyleBox["V", "TI"], "_"], ",", 
      StyleBox["t", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    StyleBox["max",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0", ",", " ", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Gamma]", "TI"], 
           StyleBox["t", "TI"]}]], "-", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Delta]", "TI"], 
           SuperscriptBox[
            StyleBox["v", "TI"], "2"], 
           StyleBox["t", "TI"], "/", 
           StyleBox["s", "TI"]}]]}], 
        RowBox[{"1", "+", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
           StyleBox["\[Delta]", "TI"], 
           SuperscriptBox[
            StyleBox["v", "TI"], "2"], 
           StyleBox["t", "TI"], "/", 
           StyleBox["s", "TI"]}]], 
         StyleBox["cosh",
          FontSlant->"Plain"], "\[ThinSpace]", 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{"2", 
          StyleBox["\[Delta]", "TI"], 
          StyleBox["v", "TI"], "\[ThinSpace]", 
          OverscriptBox[
           StyleBox["V", "TI"], "_"], 
          StyleBox["t", "TI"], "/", 
          StyleBox["s", "TI"]}], 
         StyleBox[")",
          SpanMaxSize->1]}]]}], ")"}], "."}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1224652745,ExpressionUUID->"7ffa7364-29b0-d73e-64fd-63fa0eca6287"],

Cell[TextData[{
 "Five records per panel follow the update rule (lines), with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["V", "TI"], "_"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad84f5c-13aa-8ce0-7579-4d35b3496d23"],
 " marked at each record's own ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["V", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af9e95a-6ef4-bc19-08e5-f2ea694e5b9e"],
 " (markers) and its ceiling ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65c0e04e-1e41-0455-1f3b-df910e0b1bd4"],
 " dashed; time is in units of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "/", 
   StyleBox["\[Delta]", "TI"], 
   SuperscriptBox[
    StyleBox["v", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e8a4f29-7908-26c3-5974-4084b8384e27"],
 ":"
}], "Text",
 CellID->1289919228,ExpressionUUID->"34dc2e9d-3dbb-7267-40c8-42f55a36ca80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hpmUpdate", "[", 
    RowBox[{
    "x_", ",", " ", "v_", ",", " ", "dv_", ",", " ", "var_", ",", " ", 
     "gdt_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "dv"}], ",", " ", "0", ",", " ", "0", ",", " ", 
               "dv"}], "}"}], " ", "-", " ", "v"}], ")"}], "^", "2"}]}], "/", 
         
         RowBox[{"(", 
          RowBox[{"2", " ", "var"}], ")"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"x", ",", " ", "4"}], "]"}], " ", "p"}], ",", " ", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", "5", "]"}], "]"}], " ", 
         RowBox[{"p", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "gdt"}], "]"}]}]}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"x", ",", " ", "4"}], "]"}], " ", ".", " ", "p"}], ")"}]}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmConc", "[", 
    RowBox[{"vb_", ",", " ", "\[Tau]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], " ", "\[Tau]"}], "]"}], " ", "-", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Delta]v", "^", "2"}]}], " ", 
        RowBox[{"\[Tau]", "/", "s"}]}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[Delta]v", "^", "2"}]}], " ", 
         RowBox[{"\[Tau]", "/", "s"}]}], "]"}], " ", 
       RowBox[{"Cosh", "[", 
        RowBox[{"2", " ", "\[Delta]v", " ", "vb", " ", 
         RowBox[{"\[Tau]", "/", "s"}]}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmC", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Ramp", "[", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "5", "]"}], "]"}], " ", "-", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", 
        RowBox[{"x", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hpmDt", " ", "=", " ", "0.01"}], ";", " ", 
  RowBox[{"hpmVar", " ", "=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "hpmDt"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmRun", "[", 
    RowBox[{"gs_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", " ", "=", " ", 
            RowBox[{
             RowBox[{"RandomChoice", "[", 
              RowBox[{
               RowBox[{"Take", "[", 
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], ",", " ", "4"}], "]"}], 
               " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1."}], ",", " ", "0.", ",", " ", "0.", ",", 
                 " ", "1."}], "}"}]}], "]"}], " ", "+", " ", 
             RowBox[{"RandomVariate", "[", 
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"Sqrt", "[", "hpmVar", "]"}]}], "]"}], "]"}]}]}], 
           "}"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"hpmUpdate", "[", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], ",", " ", "v", ",", " ", "1.",
               ",", " ", "hpmVar", ",", " ", 
              RowBox[{"gs", " ", "hpmDt"}]}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], " ", "+", " ", "v"}]}], "}"}]}],
          "]"}], " ", "&"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.25", ",", " ", "5"}], "]"}], ",", " ", "0."}], "}"}], ",",
        " ", 
       RowBox[{"Round", "[", 
        RowBox[{"5", "/", "hpmDt"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hpmPanel", "[", "gs_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"runs", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"hpmRun", "[", 
           RowBox[{"gs", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Range", "[", "5", "]"}]}]}], ",", " ", 
       RowBox[{"conc", " ", "=", " ", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vb", ",", " ", "\[Tau]"}], "}"}], ",", " ", 
          RowBox[{"Ramp", "[", 
           RowBox[{
            RowBox[{"hpmConc", "[", 
             RowBox[{"vb", ",", " ", "\[Tau]"}], "]"}], " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Delta]v", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"s", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"\[Gamma]", " ", "->", " ", "gs"}]}], "}"}]}], "]"}]}], 
         "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"hpmC", " ", "/@", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], " ", "&"}], " ",
           "/@", " ", "runs"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"k", " ", "hpmDt"}], ",", " ", 
               RowBox[{"conc", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"k", " ", "+", " ", "1"}], ",", " ", "2"}], "]"}],
                    "]"}], "/", "k"}], ",", " ", 
                 RowBox[{"k", " ", "hpmDt"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "25", ",", " ", 
               RowBox[{"Round", "[", 
                RowBox[{"5", "/", "hpmDt"}], "]"}], ",", " ", "25"}], "}"}]}],
             "]"}], " ", "&"}], " ", "/@", " ", "runs"}], ",", " ", 
         RowBox[{"PlotMarkers", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "9"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"conc", "[", 
          RowBox[{"0", ",", " ", "\[Tau]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", " ", "Dashed", ",", " ", "Thick"}], "]"}]}], ",",
          " ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Superscript", "[", 
              RowBox[{"\"\<\[Delta]v\>\"", ",", " ", "2"}], "]"}], ",", 
             " ", "\"\<t/s\>\""}], "}"}], "]"}], ",", 
          " ", "\"\<concurrence C\>\""}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<\[Gamma] s/\>\"", ",", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<\[Delta]v\>\"", ",", " ", "2"}], "]"}], ",", 
           " ", "\"\< = \>\"", ",", " ", "gs"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"hpmPanel", " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0.3", ",", " ", "1.5"}], "}"}]}], "}"}], ",",
        " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<each color: one record\>\"", ",", "\n", "    ", 
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"{", "Gray", "}"}], ",", " ", 
           RowBox[{"{", "\"\<concurrence from the update rule\>\"", "}"}]}], 
          "]"}], ",", " ", 
         RowBox[{"PointLegend", "[", 
          RowBox[{
           RowBox[{"{", "Gray", "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<C(\>\"", ",", " ", 
               RowBox[{"OverBar", "[", "\"\<V\>\"", "]"}], ",", 
               " ", "\"\<, t) at the record's running mean\>\""}], "}"}], 
             "]"}], "}"}], ",", " ", 
           RowBox[{"LegendMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "9"}], "}"}]}]}], 
          "]"}], ",", "\n", "    ", 
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed", ",", " ", "Thick"}], "]"}], 
            "}"}], ",", " ", 
           RowBox[{"{", "\"\<ceiling C(0, t)\>\"", "}"}]}], "]"}]}], "}"}], 
       "]"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<ceiling:  \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{
          RowBox[{"hpmConc", "[", 
           RowBox[{"0", ",", " ", "t"}], "]"}], " ", "/.", " ", 
          RowBox[{
           RowBox[{"Exp", "[", "e_", "]"}], " ", ":>", " ", 
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<e\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<-\>\"", ",", " ", 
                RowBox[{"-", "e"}]}], "}"}], "]"}]}], "]"}]}]}], "]"}], ",", 
        " ", "\"\<  =  \>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"hpmConc", "[", 
             RowBox[{"0", ",", " ", "t"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"t", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], 
          "]"}], "]"}], ",", " ", "\"\< + O(\>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<t\>\"", ",", " ", "2"}], "]"}], ",", " ", "\"\<)\>\""}],
        "}"}], "]"}], ",", "\n", "   ", "13", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[23]:= ",
 CellID->1169389055,ExpressionUUID->"1dfdb8fe-02d1-611a-0a48-8dbee1a7050e"],

Cell[TextData[{
 "Each record's concurrence lands on the closed form at its own running mean: \
records that settle near ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["V", "TI"], "_"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b10fb60-aa16-9aad-2741-35a8030e4184"],
 " press against the dashed ceiling, while records pushed toward ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["\[Delta]", "TI"], 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a48a6c5-00a6-6da2-7700-c34e540a1da5"],
 " lose their concurrence. The ceiling starts with slope ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Delta]", "TI"], 
    SuperscriptBox[
     StyleBox["v", "TI"], "2"], "-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["s", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dc4b4fe-c08a-750b-05a8-ca4e268ddeb6"],
 ": without dephasing it climbs toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "068fe480-ff08-603a-393a-038fe4838292"],
 ", with weak dephasing it peaks and falls, and once ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["s", "TI"], ">", 
   StyleBox["\[Delta]", "TI"], 
   SuperscriptBox[
    StyleBox["v", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bdc0995-fdc2-211d-3061-5984219166cf"],
 " its numerator stays negative and no record entangles the pair."
}], "Text",
 CellID->1710318553,ExpressionUUID->"6d5f80c4-a2a2-37d0-09ee-fc47a98954ec"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->543569477,ExpressionUUID->"2b5f68d9-3ad3-da0c-567b-60a3057c6a7c"],

Cell["\<\
Continuous syndrome tracking: four numbers follow the records\
\>", "Subsection",
 CellID->524241718,ExpressionUUID->"3aadbcc9-3a03-d5f3-11f8-c40c0c800df0"],

Cell[TextData[{
 "Three qubits carry the bit-flip code, and each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55aef23f-b1d2-8392-334c-98d60fa972b5"],
 ". The stabilizers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02d80c58-2519-d584-6556-a1816ff7d1e9"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], "2"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23729e0d-94b5-a98d-4f71-4f7dd7d9a110"],
 " are measured weakly and continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f1fd37b-bc02-9f4f-1db7-3bff800ee1e0"],
 " by detectors of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc6b9b8-2f29-e5dd-3325-6f8180af5ad7"],
 ". Can four numbers, fed only these two noisy records, track the syndrome?"
}], "Text",
 CellID->674005596,ExpressionUUID->"2266b3e2-f4ba-b413-5388-b8a1c18d6080"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["c", "TI"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["c", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     StyleBox["c", "TI"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     StyleBox["c", "TI"], "\[Dagger]"], 
    StyleBox["c", "TI"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02ba11ca-ae5d-88d6-2388-2d4eb076c7ce"],
 ", the three-qubit state conditioned on the records ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["k", "TI"]], "=", "2", 
   SqrtBox[
    StyleBox[
     RowBox[{"\[Eta]", "\[Kappa]"}], "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["k", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c688d09-aa5e-1854-6aca-d1b1bae4f623"],
 " obeys"
}], "Text",
 CellID->1067394268,ExpressionUUID->"034d1377-6f9b-dea0-17c0-dba9376ceb70"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["\[Gamma]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["\[Kappa]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "2",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox[
      RowBox[{"\[Eta]", "\[Kappa]"}], "TI"]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "2",
     LimitsPositioning->False], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["k", "TI"]], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], ")", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["k", "TI"]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->662938664,ExpressionUUID->"5667734c-b3a0-720e-161b-f5acef409605"],

Cell[TextData[{
 "The four syndrome sectors, with projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    StyleBox["s", "TI"]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "1"], 
    SubscriptBox[
     StyleBox["S", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "2"], 
    SubscriptBox[
     StyleBox["S", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee3fa71-078e-4095-2f03-65c3ff0777cf"],
 ", have probabilities ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["s", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "752fc0a3-cc58-6190-4e61-1073a5900e51"],
 ". The filter relaxes them toward ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c702543-53a2-b43e-3858-0a480036e9bf"],
 " under the flips and multiplies each by the likelihood of the new pair of \
readings:"
}], "Text",
 CellID->244926620,ExpressionUUID->"60e3345a-648f-61ec-1f77-c1f01a370970"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["s", "TI"]], "\[ThickSpace]", "\[Rule]", "\[ThickSpace]", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "4"], "+", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", "4", 
         StyleBox["\[Gamma]", "TI"], 
         StyleBox["d", "TI"], 
         StyleBox["t", "TI"]}]], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        SubscriptBox[
         StyleBox["p", "TI"], 
         StyleBox["s", "TI"]], "-", 
        FractionBox["1", "4"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], ")", "\[ThinSpace]", 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"2", 
        SqrtBox[
         StyleBox[
          RowBox[{"\[Eta]", "\[Kappa]"}], "TI"]], "\[ThinSpace]", 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], "1"], 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["J", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["J", "TI"], "2"]}], 
        StyleBox[")",
         SpanMaxSize->1]}]]}], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       SuperscriptBox[
        StyleBox["s", "TI"], "\[Prime]"],
       LimitsPositioning->False], 
      StyleBox["(",
       SpanMaxSize->1], "\[CenterEllipsis]", 
      StyleBox[")",
       SpanMaxSize->1]}]]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->356162114,ExpressionUUID->"135d4a9e-dcf5-3430-3898-c971c59f1b3a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"8", "\[Times]", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6257dd06-f247-e98b-6116-766816ea62f9"],
 " equation is integrated from ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"000"},
      "Ket"], "+", 
     RowBox[{
      StyleBox["i", "TI"], 
      TemplateBox[{"100"},
       "Ket"]}]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4265d19b-016e-f298-5a5e-224f204ec446"],
 ", a superposition of two sectors, with the positivity-preserving step of \
Rouchon and Ralph, at two time steps on the same noise, and the filter runs \
on each record and is compared with the sector populations ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", 
     StyleBox["s", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f46d704-d826-e4bd-1ced-99823f297592"],
 " of the full state through their largest gap; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5995c5ba-5a06-e8e5-7908-7b412d7eb421"],
 ":"
}], "Text",
 CellID->1968701164,ExpressionUUID->"21469327-1d8c-05aa-2cf0-f8f0fc0e6f68"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qecOp", "[", 
    RowBox[{"o_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "3"}], "]"}], ",",
       " ", 
      RowBox[{"k", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecStabs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "1"}], "]"}], " ", ".",
       " ", 
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "2"}], "]"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "2"}], "]"}], " ", ".",
       " ", 
      RowBox[{"qecOp", "[", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", "3"}], "]"}]}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecFlips", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"qecOp", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "#"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecSigns", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecProj", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", 
          RowBox[{"qecStabs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", 
          RowBox[{"qecStabs", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "4"}], " ", 
     "&"}], " ", "/@", " ", "qecSigns"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qecStep", "[", 
     RowBox[{"\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_"}], "]"}], "[", 
    
    RowBox[{"\[Rho]_", ",", " ", "dJ_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Sigma]", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", 
        RowBox[{"dJ", " ", ".", " ", "qecStabs"}]}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"M", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"2", " ", "+", " ", 
                RowBox[{"3", " ", "\[Gamma]"}]}], ")"}], " ", 
              RowBox[{"dt", "/", "2"}]}], " ", "-", " ", 
             RowBox[{"\[Eta]", " ", "dt"}]}], ")"}], " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], " ", "+", " ", 
          "\[Sigma]", " ", "+", " ", 
          RowBox[{
           RowBox[{"\[Sigma]", " ", ".", " ", "\[Sigma]"}], "/", "2"}]}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "/", 
          RowBox[{"Tr", "[", "#", "]"}]}], " ", "&"}], "[", 
        RowBox[{
         RowBox[{"M", " ", ".", " ", "\[Rho]", " ", ".", " ", "M"}], " ", "+",
          " ", 
         RowBox[{"\[Gamma]", " ", "dt", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", ".", " ", "\[Rho]", " ", ".", " ", "#"}], " ", 
             "&"}], " ", "/@", " ", "qecFlips"}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "\[Eta]"}], ")"}], " ", "dt", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", " ", ".", " ", "\[Rho]", " ", ".", " ", "#"}], " ", 
             "&"}], " ", "/@", " ", "qecStabs"}], "]"}]}]}], "]"}]}], "]"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecRun", "[", 
    RowBox[{
    "\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_", ",", " ", "kicks_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Rest", " ", "@", " ", 
    RowBox[{"FoldList", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"state", ",", " ", "kick"}], "}"}], ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dJ", " ", "=", " ", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", 
              RowBox[{"Re", "[", 
               RowBox[{"Tr", " ", "/@", " ", 
                RowBox[{"(", 
                 RowBox[{"qecStabs", " ", ".", " ", 
                  RowBox[{"First", "[", "state", "]"}]}], ")"}]}], "]"}], " ",
               "dt"}], " ", "+", " ", "kick"}]}], "}"}], ",", "\n", "      ", 
          
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"qecStep", "[", 
              RowBox[{"\[Gamma]", ",", " ", "\[Eta]", ",", " ", "dt"}], "]"}],
              "[", 
             RowBox[{
              RowBox[{"First", "[", "state", "]"}], ",", " ", "dJ"}], "]"}], ",",
             " ", "dJ"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", " ", "#", ",", " ", 
            RowBox[{"Conjugate", "[", "#", "]"}]}], "]"}], " ", "&"}], "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{"8", ",", " ", "1"}], "]"}], " ", "+", " ", 
            RowBox[{"I", " ", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"8", ",", " ", "5"}], "]"}]}]}], ")"}], "/", 
          RowBox[{"Sqrt", "[", "2.", "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.", ",", " ", "0."}], "}"}]}], "}"}], ",", " ", "kicks"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecFilter", "[", 
    RowBox[{
    "\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_", ",", " ", "record_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "/", 
         RowBox[{"Total", "[", "#", "]"}]}], " ", "&"}], "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", "4"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "4"}], " ", "\[Gamma]", " ", "dt"}], "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"#1", " ", "-", " ", 
             RowBox[{"1", "/", "4"}]}], ")"}]}]}], ")"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", 
          RowBox[{"qecSigns", " ", ".", " ", "#2"}]}], "]"}]}], "]"}], " ", 
      "&"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", " ", "0.5", ",", " ", "0.", ",", " ", "0."}], "}"}],
      ",", " ", "record"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecTrack", "[", 
    RowBox[{
    "\[Gamma]_", ",", " ", "\[Eta]_", ",", " ", "dt_", ",", " ", "kicks_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"run", " ", "=", " ", 
       RowBox[{"qecRun", "[", 
        RowBox[{
        "\[Gamma]", ",", " ", "\[Eta]", ",", " ", "dt", ",", " ", "kicks"}], 
        "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"filter", " ", "=", " ", 
         RowBox[{"qecFilter", "[", 
          RowBox[{"\[Gamma]", ",", " ", "\[Eta]", ",", " ", "dt", ",", " ", 
           RowBox[{"run", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"filter", ",", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Rest", "[", "filter", "]"}], " ", "-", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Re", "[", 
                RowBox[{"Tr", " ", "/@", " ", 
                 RowBox[{"(", 
                  RowBox[{"qecProj", " ", ".", " ", 
                   RowBox[{"First", "[", "#", "]"}]}], ")"}]}], "]"}], " ", 
               "&"}], " ", "/@", " ", "run"}], ")"}]}], "]"}], "]"}]}], 
        "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qecPanel", "[", 
    RowBox[{"\[Eta]_", ",", " ", "\[Gamma]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kicks", " ", "=", " ", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"Sqrt", "[", "0.005", "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"8000", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", "\n",
      "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fine", " ", "=", " ", 
          RowBox[{"qecTrack", "[", 
           RowBox[{
           "\[Gamma]", ",", " ", "\[Eta]", ",", " ", "0.005", ",", " ", 
            "kicks"}], "]"}]}], ",", " ", 
         RowBox[{"coarse", " ", "=", " ", 
          RowBox[{"qecTrack", "[", 
           RowBox[{"\[Gamma]", ",", " ", "\[Eta]", ",", " ", "0.01", ",", " ", 
            RowBox[{"Total", " ", "/@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{"kicks", ",", " ", "2"}], "]"}]}]}], "]"}]}]}], "}"}], ",",
        "\n", "    ", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"First", "[", "fine", "]"}], "]"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "40"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\[Kappa] t\>\"", ",", 
            " ", "\"\<syndrome probability\>\""}], "}"}]}], ",", "\n", 
         "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]", ",", 
                 " ", "\"\<,   \[Gamma]/\[Kappa] = \>\"", ",", " ", 
                 "\[Gamma]"}], "}"}], "]"}], ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                
                RowBox[{"\"\<largest gap at \[Kappa] dt = 0.01, 0.005: \>\"", 
                 ",", " ", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"Last", "[", "coarse", "]"}], ",", " ", "2"}], 
                  "]"}], ",", " ", "\"\<, \>\"", ",", " ", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"Last", "[", "fine", "]"}], ",", " ", "2"}], 
                  "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", "Center"}], 
           "]"}]}], ",", "\n", "     ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<(\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<S\>\"", ",", " ", "\"\<1\>\""}], "]"}], ",", 
                " ", "\"\<, \>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<S\>\"", ",", " ", "\"\<2\>\""}], "]"}], ",", 
                " ", "\"\<) = (\>\"", ",", " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<, \>\"", ",", 
                " ", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<)\>\""}], 
               "}"}], "]"}], " ", "&"}], " ", "/@", " ", "qecSigns"}], 
           ")"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qecPanels", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"qecPanel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0.2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.01", ",", " ", "0.05", ",", " ", "0.2"}], "}"}]}], "]"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "qecPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"qecPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[24]:= ",
 CellID->1848903766,ExpressionUUID->"7dccc349-a3d8-d6b5-0c67-30a4248b2f16"],

Cell["\<\
The gap roughly halves with the time step, so it is the integration's error: \
the four probabilities follow the full state, coherences included, and need \
nothing else from it. With a perfect detector and rare flips the filter jumps \
cleanly from sector to sector as each flip happens. With a poor detector and \
frequent flips it rarely settles before the next flip.\
\>", "Text",
 CellID->2043314122,ExpressionUUID->"6d9fdc5e-ac98-1f2b-2a77-e8f96f870705"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1823573859,ExpressionUUID->"5993d494-9204-f341-7931-3573f712bd7a"],

Cell["The noise term in the syndrome equation of a watched code", "Subsection",
 CellID->801822598,ExpressionUUID->"1bc11ca8-8317-fe57-1998-b713884db8f4"],

Cell[TextData[{
 "Three qubits carry the bit-flip code, each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60641dd5-5d75-532b-4773-ed9a76389fc5"],
 ", and the stabilizers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "483e62ed-06cb-613b-495e-53c066a056ca"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["S", "TI"], "2"], "=", 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22d25c61-df3b-9f4d-1380-093627f8e845"],
 " are measured continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "163f5981-2d42-3f3d-07f7-aac37f11b4a2"],
 " by detectors of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38ca6fed-3f24-79bd-43bb-23b4a2337cbe"],
 ". The four syndrome sectors ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e164543-0a81-d4fb-1da2-5c62c2e88119"],
 ", with signs ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b0e7efe-d851-eb1b-195e-b30557c7a10e"],
 " and projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    StyleBox["j", "TI"]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], 
     RowBox[{
      StyleBox["j", "TI"], "1"}]], 
    SubscriptBox[
     StyleBox["S", "TI"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], 
     RowBox[{
      StyleBox["j", "TI"], "2"}]], 
    SubscriptBox[
     StyleBox["S", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73a1cf77-43c0-a974-56c5-e4a9bc2035b2"],
 ", have probabilities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", 
     StyleBox["j", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65149050-f53f-387a-284c-79162298128e"],
 ". Which term does the measurement record add to the equation for the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07b53b87-6513-8bda-59e5-00c3b5580145"],
 "?"
}], "Text",
 CellID->1331179845,ExpressionUUID->"28ac372b-a6fc-4ffe-7913-669fa26a1da6"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["c", "TI"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["c", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     StyleBox["c", "TI"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     StyleBox["c", "TI"], "\[Dagger]"], 
    StyleBox["c", "TI"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e307079-6096-a4b0-14d6-40db033f05c1"],
 ", records ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["k", "TI"]], "=", "2", 
   SqrtBox[
    StyleBox[
     RowBox[{"\[Eta]", "\[Kappa]"}], "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["k", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e96255-5caf-5995-6ddf-13ad1af50e5d"],
 " and Wiener increments ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["W", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1682ead8-474f-7551-1238-709427d78ad7"],
 ", the state conditioned on the records obeys"
}], "Text",
 CellID->700675467,ExpressionUUID->"365c28bc-b038-8749-0166-5064fd349e2b"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["\[Gamma]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    StyleBox["\[Kappa]", "TI"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "2",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox[
      RowBox[{"\[Eta]", "\[Kappa]"}], "TI"]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "=", "1"}], "2",
     LimitsPositioning->False], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[Rho]", "TI"], "+", 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["k", "TI"]], "-", "2", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     SubscriptBox[
      StyleBox["S", "TI"], 
      StyleBox["k", "TI"]], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["\[Rho]", "TI"]}], ")", 
    StyleBox["d", "TI"], 
    SubscriptBox[
     StyleBox["W", "TI"], 
     StyleBox["k", "TI"]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->817607514,ExpressionUUID->"2ba5da5f-7c52-9e90-5cbd-64777975f3de"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", 
     StyleBox["j", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "482b4c3f-6e4e-c178-7fc8-5c288f3a37ba"],
 "."
}], "Text",
 CellID->722614850,ExpressionUUID->"692646bc-6534-2f95-609d-d70959f39cb1"],

Cell[TextData[{
 "No matrix is ever built: ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60038416-996c-0feb-2b0f-1126b8c1318e"],
 " is the most general element of the Pauli algebra, with 64 free \
coefficients, and requiring the identity for every coefficient turns the \
trace of ",
 Cell[BoxData[
  SubscriptBox["\[CapitalPi]", 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34b45a9d-4a83-ca22-1d12-45eacbcf5a7c"],
 " against each term into a combination of the ",
 Cell[BoxData[
  SubscriptBox[
