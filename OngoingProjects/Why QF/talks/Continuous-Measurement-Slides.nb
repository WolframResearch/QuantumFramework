Cell[BoxData[{
 RowBox[{
  RowBox[{"wsyGens", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "wsyX1", ",", " ", "wsyZ1", ",", " ", "wsyX2", ",", " ", "wsyZ2", ",", 
     " ", "wsyX3", ",", " ", "wsyZ3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyAlg", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
