             RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "**", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"Partition", "[", 
          RowBox[{"wsyGens", ",", " ", "2"}], "]"}]}], ")"}]}], ",", "\n", 
      "    ", 
      RowBox[{"\"\<Relations\>\"", " ", "->", " ", 
