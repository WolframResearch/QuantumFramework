Cell[TextData[{
 "The four-number equation is integrated from the code sector, three runs and \
the mean of 1000 against the mean from the flip term alone; time is in units \
of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b48d6-4aca-376f-1041-f5eb26b20cf0"],
 ":"
}], "Text",
 CellID->1603817993,ExpressionUUID->"7230cf54-88d3-da30-73d2-cc8d9874cf18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wsyRun", "[", 
    RowBox[{"e_", ",", " ", "g_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
     RowBox[{"NestList", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Nest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"dW", " ", "=", " ", 
               RowBox[{"RandomVariate", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", 
                  RowBox[{"0", ",", " ", 
                   RowBox[{"Sqrt", "[", "0.001", "]"}]}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"m", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
             "\n", "        ", 
             RowBox[{"#", " ", "+", " ", 
              RowBox[{"g", " ", 
               RowBox[{"#", " ", ".", " ", 
                RowBox[{"Transpose", "[", "wsyFlipM", "]"}]}], " ", "0.001"}],
               " ", "+", " ", 
              RowBox[{"2", " ", 
               RowBox[{"Sqrt", "[", "e", "]"}], " ", "#", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"dW", " ", ".", " ", 
                  RowBox[{"Transpose", "[", "wsySigns", "]"}]}], " ", "-", 
                 " ", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"#", " ", ".", " ", "wsySigns"}], ")"}], " ", 
                    "dW"}], ",", " ", 
                   RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}]}]}], "]"}], 
           " ", "&"}], ",", " ", "#", ",", " ", "50"}], "]"}], " ", "&"}], ",",
        "\n", "     ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1.", ",", " ", "0.", ",", " ", "0.", ",", " ", "0."}], 
          "}"}], ",", " ", "m"}], "]"}], ",", " ", "400"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wsyPanel", "[", 
    RowBox[{"e_", ",", " ", "g_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"run", " ", "=", " ", 
        RowBox[{
         RowBox[{"wsyRun", "[", 
          RowBox[{"e", ",", " ", "g", ",", " ", "1000"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "All", ",", " ", "1"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"flipsOnly", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"MatrixExp", "[", 
            RowBox[{"g", " ", "wsyFlipM", " ", "#"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "&"}], " ", "/@",
          " ", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"0", ",", " ", "20", ",", " ", "400"}], "]"}]}]}]}], "}"}], 
     ",", "\n", "   ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"run", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"1", " ", ";;", " ", "3"}]}], "]"}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Mean", " ", "/@", " ", "run"}], ",", " ", "flipsOnly"}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"DataRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "Thin", ",", " ", "Thin", ",", " ", "Thin", ",", " ", "Thick", ",", 
          " ", "Dashed"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<run 1\>\"", ",", " ", "\"\<run 2\>\"", ",", 
          " ", "\"\<run 3\>\"", ",", " ", "\"\<mean of 1000 runs\>\"", ",", 
          " ", "\"\<mean from the flip term alone\>\""}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "20"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.02"}], ",", " ", "1.02"}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Kappa] t\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<p\>\"", ",", " ", "\"\<code\>\""}], "]"}]}], "}"}]}], 
       ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "e", ",", 
           " ", "\"\<,   \[Gamma]/\[Kappa] = \>\"", ",", " ", "g"}], "}"}], 
         "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyPanels", " ", "=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"wsyPanel", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0.2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "0.1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"First", ",", " ", "wsyPanels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "700"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"wsyPanels", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[26]:= ",
 CellID->56159645,ExpressionUUID->"0ae78344-43f3-0bae-652f-a5c733982d3b"],

Cell["\<\
Each sector is pushed by its own probability times how far its signs sit from \
the running means, so the four probabilities form a closed equation, and the \
averaged back-action of the stabilizer measurement moves no probability. \
Conditioned on its record, each run jumps between near 0 and near 1, more \
sharply for the efficient detector, while the mean over runs follows the \
relaxation set by the flips alone, because the noise term has zero mean.\
\>", "Text",
 CellID->2129249547,ExpressionUUID->"73a8fb0c-143f-303f-470c-9225dfe517e5"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1214005476,ExpressionUUID->"1cdf15ee-362a-4295-00cc-5cad9fabf3c8"],

Cell["\<\
Markovian feedback that protects the code space, and what the detector costs\
\>", "Subsection",
 CellID->520476813,ExpressionUUID->"660d0adf-0288-dd9f-21aa-2a6f13e4ce9e"],

Cell[TextData[{
 "Three qubits carry the bit-flip code, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox["0", 
      StyleBox["L", "TI"]]},
    "Ket"], "=", 
   TemplateBox[{"000"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09c81b69-0b5a-7756-131c-10e9df046ff6"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox["1", 
      StyleBox["L", "TI"]]},
    "Ket"], "=", 
   TemplateBox[{"111"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22eabe25-9bdc-eba0-396f-f7bd500e898e"],
 ", and each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "453bc8ca-bf85-c840-638e-efb18120a7e7"],
 " through the channel ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["i", "TI"]], "=", 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d9401a5-f06a-4535-6567-b48e5688949d"],
 ". Each channel is monitored by homodyne detection of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3773e782-42c8-4776-15ad-2daf32d089ac"],
 ", and its current ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e1024c2-5ef3-2098-00ad-6145175236b6"],
 " drives the qubits at once through the Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f879d5c-5cf0-38b1-377f-9bb349939a53"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["i", "TI"], 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", 
     StyleBox[
      RowBox[{"c", "o", "d", "e"}], "TI"]], ",", 
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39221c93-66fd-698d-2507-d7ace268b227"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    StyleBox[
     RowBox[{"c", "o", "d", "e"}], "TI"]], "=", 
   RowBox[{
    RowBox[{
     TemplateBox[{"000"},
      "Ket"], 
     TemplateBox[{"000"},
      "Bra"]}], "+", 
    RowBox[{
     TemplateBox[{"111"},
      "Ket"], 
     TemplateBox[{"111"},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f948a7-0f93-4d6f-3e25-2461b7600276"],
 ". How well does this loop hold an encoded state?"
}], "Text",
 CellID->2054782259,ExpressionUUID->"12b9de2c-5f9f-db34-7721-8db99fb47fad"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26de0e7d-130b-68f6-7256-879a54481e6a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["c", "TI"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["c", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    SuperscriptBox[
     StyleBox["c", "TI"], "\[Dagger]"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     StyleBox["c", "TI"], "\[Dagger]"], 
    StyleBox["c", "TI"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd71c4a-607f-c2bb-370c-4cbce619e16a"],
 ", the Wiseman-Milburn feedback master equation is"
}], "Text",
 CellID->979452493,ExpressionUUID->"13512771-5692-7257-6ef8-42f517c37bf0"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "-", 
    FractionBox[
     StyleBox["i", "TI"], "2"], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "[", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["i", "TI"], "\[Dagger]"], 
      SubscriptBox[
       StyleBox["F", "TI"], 
       StyleBox["i", "TI"]], "+", 
      SubscriptBox[
       StyleBox["F", "TI"], 
       StyleBox["i", "TI"]], 
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["i", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], 
      StyleBox["i", "TI"]], "-", 
     StyleBox["i", "TI"], 
     SubscriptBox[
      StyleBox["F", "TI"], 
      StyleBox["i", "TI"]]}], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "+", 
    FractionBox[
     RowBox[{"1", "-", 
      StyleBox["\[Eta]", "TI"]}], 
     StyleBox["\[Eta]", "TI"]], 
    UnderoverscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "=", "1"}], "3",
     LimitsPositioning->False], "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["i", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1297583400,ExpressionUUID->"4c5ca88b-f084-e3e0-1b5f-78b6844b2237"],

Cell[TextData[{
 "The two identities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], "+", 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["i", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2adaadfd-4b56-69c8-124f-047df5b34511"],
 ", which removes the Hamiltonian term, and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["i", "TI"]], "-", 
    StyleBox["i", "TI"], 
    SubscriptBox[
     StyleBox["F", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox["\[CapitalPi]", 
    StyleBox[
     RowBox[{"c", "o", "d", "e"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56fe5e8e-2555-8971-5340-351ff77b49d9"],
 " both hold exactly. The master equation evolves from ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "236fdd98-78c7-5c6b-77f1-ac8bd6b7b82c"],
 " and from ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SubscriptBox["+", 
      StyleBox["L", "TI"]]},
    "Ket"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"000"},
       "Ket"], "+", 
      TemplateBox[{"111"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c891171-e830-4bae-54f3-275182744cf6"],
 ", with ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44926db0-e90d-f596-27ed-9baca71f0527"],
 " alone as the case without feedback; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c4cf4ce-bdd3-c6b5-3203-85000c7afb1b"],
 ":"
}], "Text",
 CellID->204814040,ExpressionUUID->"0965de78-1c8c-6664-34af-a1f2e1d7a8ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fbOp", "[", 
    RowBox[{"o_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "3"}], "]"}], ",",
       " ", 
      RowBox[{"k", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbFlips", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"fbOp", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "1", "]"}], ",", " ", "#"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Range", "[", "3", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbCode", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"UnitVector", "[", 
      RowBox[{"8", ",", " ", "1"}], "]"}], " ", "+", " ", 
     RowBox[{"UnitVector", "[", 
      RowBox[{"8", ",", " ", "8"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbF", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fbCode", " ", ".", " ", "#"}], " ", "-", " ", 
        RowBox[{"#", " ", ".", " ", "fbCode"}]}], ")"}]}], " ", "&"}], " ", "/@",
     " ", "fbFlips"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbChecks", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
           RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"fbFlips", ",", " ", "fbF"}], "}"}]}], "]"}], "]"}], "]"}], 
     ",", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", ".", " ", "fbCode"}], ")"}], " ", "&"}], " ", "/@",
         " ", 
        RowBox[{"(", 
         RowBox[{"fbFlips", " ", "-", " ", 
          RowBox[{"I", " ", "fbF"}]}], ")"}]}], "]"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fbRho", "[", 
    RowBox[{"ops_", ",", " ", "rates_", ",", " ", "\[Psi]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"QuantumOperator", " ", "/@", " ", "ops"}], " ", "->", " ", 
        "rates"}], ",", " ", 
       RowBox[{"QuantumState", "[", "\[Psi]", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbEtas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", 
     RowBox[{"1", "/", "2"}], ",", " ", 
     RowBox[{"1", "/", "10"}], ",", " ", 
     RowBox[{"1", "/", "50"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbStarts", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<|\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<0\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
          " ", "\"\<\:27e9\>\""}], "}"}], "]"}], ",", " ", 
       RowBox[{"UnitVector", "[", 
        RowBox[{"8", ",", " ", "1"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<|\>\"", ",", " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\"\<+\>\"", ",", " ", "\"\<L\>\""}], "]"}], ",", 
          " ", "\"\<\:27e9\>\""}], "}"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"UnitVector", "[", 
           RowBox[{"8", ",", " ", "1"}], "]"}], " ", "+", " ", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"8", ",", " ", "8"}], "]"}]}], ")"}], "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fbCurves", "[", "\[Psi]_", "]"}], " ", ":=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"\[Eta]", ",", " ", 
        RowBox[{"fbRho", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"fbFlips", " ", "-", " ", 
             RowBox[{"I", " ", "fbF"}]}], ",", " ", "fbF"}], "]"}], ",", " ", 
          
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", "\[Eta]"}], ")"}], "/", 
               "\[Eta]"}], ",", " ", "3"}], "]"}]}], "]"}], ",", " ", 
          "\[Psi]"}], "]"}]}], "]"}], " ", "/@", " ", "fbEtas"}], ",", " ", 
     RowBox[{"fbRho", "[", 
      RowBox[{"fbFlips", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
       "\[Psi]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbObs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"fbCode", " ", ".", " ", "#1"}], "]"}], "]"}], " ", "&"}], ",",
        " ", "\"\<code-space population\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", "#2", "]"}], " ", ".", " ", "#1", " ", ".",
           " ", "#2"}], "]"}], " ", "&"}], ",", 
       " ", "\"\<fidelity with the start\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fbPanel", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name_", ",", " ", "\[Psi]_"}], "}"}], ",", " ", "\[Rho]s_", ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"obs_", ",", " ", "label_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"obs", "[", 
         RowBox[{"#", ",", " ", "\[Psi]"}], "]"}], " ", "&"}], " ", "/@", " ",
        "\[Rho]s"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.02"}], "}"}]}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Gamma] t\>\"", ",", " ", "label"}], "}"}]}], ",", "\n", 
     "   ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<start \>\"", ",", " ", "name"}], "}"}], "]"}]}], ",", 
     " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
        "Automatic", ",", " ", "Dashed"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
          "&"}], " ", "/@", " ", "fbEtas"}], ",", 
        " ", "\"\<no feedback\>\""}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fbPanels", " ", "=", " ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"start", ",", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]s", " ", "=", " ", 
          RowBox[{"fbCurves", "[", 
           RowBox[{"Last", "[", "start", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"fbPanel", "[", 
           RowBox[{"start", ",", " ", "\[Rho]s", ",", " ", "#"}], "]"}], " ", 
          "&"}], " ", "/@", " ", "fbObs"}]}], "]"}]}], "]"}], " ", "/@", " ", 
    "fbStarts"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Map", "[", 
         RowBox[{"First", ",", " ", "fbPanels", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "700"}]}], "]"}], ",", " ", 
     RowBox[{"legendBelow", "[", 
      RowBox[{"Last", "[", 
       RowBox[{"fbPanels", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<c\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<F\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\< + \>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<F\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<c\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\< = \>\"", ",", " ", 
        RowBox[{"fbChecks", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<   and   (\>\"", ",", 
        "\n", "     ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<c\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\< - i \>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<F\>\"", ",", " ", "\"\<i\>\""}], "]"}], ",", 
        " ", "\"\<)\>\"", ",", " ", 
        RowBox[{"Subscript", "[", 
         RowBox[{"\"\<\[CapitalPi]\>\"", ",", " ", "\"\<code\>\""}], "]"}], ",",
         " ", "\"\< = \>\"", ",", " ", 
        RowBox[{"fbChecks", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<   for every i\>\""}],
        "}"}], "]"}], ",", " ", "14", ",", " ", 
     RowBox[{"FontFamily", " ", "->", " ", "\"\<Helvetica\>\""}]}], "]"}], ",",
    " ", "Top"}], "]"}]}], "Input",
 CellLabel->"In[27]:= ",
 CellID->1228994069,ExpressionUUID->"68cf647b-7ddd-8133-7a5c-190f12ada9c1"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7110d5a3-374d-e340-311a-c0657bc823ee"],
 " the two identities make every encoded state a fixed point, for ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae97428-42e1-5e9d-260a-a163435887f2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["+", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b74e8b1-68c5-2a90-568a-56e8d374a040"],
 " alike. Below unit efficiency the ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "544c79bc-b51f-1b92-1c57-946f99362f16"],
 " term feeds detector noise back onto the qubits: the plateau falls with ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4af576d1-a754-d142-5852-e217206952f5"],
 ", and at low efficiency the loop empties the code space faster than no \
feedback. From ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070d423a-8241-47ed-2c0b-ed15506d7c01"],
 " the fidelity falls below the code-space population while from ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["+", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b5031-8ac9-8485-5cd1-c7286fdb82be"],
 " the two agree: the noisy loop also flips ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["0", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f2cadc6-7745-f4c1-286f-2c194cde8e10"],
 " into ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox["1", 
     StyleBox["L", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ce605f7-78d4-0a4b-4513-f4c7c3754877"],
 ", which no stabilizer sees."
}], "Text",
 CellID->441742289,ExpressionUUID->"75e65f9c-a6ea-c9cf-3792-f23bc9c56d81"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->372137377,ExpressionUUID->"094e4f7f-504c-3116-394c-65202ee33021"],

Cell["Concluding remarks", "Subsection",
 CellID->1139778579,ExpressionUUID->"7797bb49-d98c-2768-085e-452c40490dd6"],

Cell[TextData[{
 StyleBox["A single record shows what the average hides.",
  FontWeight->"Bold"],
 " The Lindblad equation is the mean over all detector records. Individual \
runs freeze and jump under strong watching, and collapse to a pole with \
Born's probabilities, while the average only decays smoothly."
}], "Item",
 CellID->691814770,ExpressionUUID->"14e1eac9-5187-6487-76f4-a4069bd0c43e"],

Cell[TextData[{
 StyleBox["Measurement informs and disturbs, and the efficiency sets the \
balance.",
  FontWeight->"Bold"],
 " A perfect detector purifies the state; a lossy one leaves it mixed. The \
same trade-off fixes the bound that keeps every run inside the Bloch ball, \
the purity ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3586a490-62d2-6187-52ac-a1fe63e24775"],
 " of a watched Gaussian, the threshold for squeezing below the zero-point, \
and the cost of feedback."
}], "Item",
 CellID->663911044,ExpressionUUID->"54c46459-6372-c61e-29ee-1a0bd464ceee"],

Cell[TextData[{
 StyleBox["The record can be enough.",
  FontWeight->"Bold"],
 " When the conditioned state stays in a small family, a few numbers updated \
from the readings follow it exactly: the population from the integrated \
readout, five Gaussian moments in the Kalman filter, four syndrome \
probabilities for a watched code."
}], "Item",
 CellID->2105419012,ExpressionUUID->"2566b678-ba55-70c0-0b5c-8de08352e561"],

Cell[TextData[{
 StyleBox["Watching changes the dynamics sharply.",
  FontWeight->"Bold"],
 " The crossover from Rabi oscillation to Zeno freezing is an exceptional \
point. There the qubit is critically damped and relaxes fastest, and detuning \
splits that point and then removes it from the reachable measurement \
strengths."
}], "Item",
 CellID->1004868130,ExpressionUUID->"46918177-025e-a82e-3be6-0fa5d6a6a925"],

Cell[TextData[{
 StyleBox["The record is a resource.",
  FontWeight->"Bold"],
 " It entangles qubits that never interact, and fed back as a drive it holds \
an encoded state in its code space."
}], "Item",
 CellID->610416584,ExpressionUUID->"0ab58725-52d1-4819-3fb8-12a61faeee18"],

Cell["\<\
Each of these results was reached the same way: the model written once, \
solved exactly where possible, sampled where not, and the two checked against \
each other.\
\>", "Text",
 CellID->2115927446,ExpressionUUID->"75435605-e35f-d6ef-069f-ee197ea1df8e"],

