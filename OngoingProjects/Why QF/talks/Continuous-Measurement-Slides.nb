              "}"}]}], "]"}], ",", "\n", "     ", 
           RowBox[{"{", 
            RowBox[{"\"\<sector j\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<(\>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<s\>\"", ",", " ", "\"\<j1\>\""}], "]"}], ",", 
