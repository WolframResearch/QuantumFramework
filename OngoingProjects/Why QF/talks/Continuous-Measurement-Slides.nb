Cell["\<\
The cavity rings up along a different spiral for each qubit state and settles \
on its steady state; a narrower cavity spirals more and ends with the two \
states farther apart inside. The output separation is not ordered the same \
way: it settles soonest in the widest cavity, but ends largest at the \
intermediate linewidth.\
\>", "Text",
 CellID->689611250,ExpressionUUID->"12655c9a-f9fd-87ea-797f-e1376069dc72"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1287491687,ExpressionUUID->"3c6ed46d-2e5b-345b-4536-9d1766033091"],

Cell[TextData[{
 "Born's rule as a martingale: runs collapse to the poles with probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268bef87-edf5-f26f-7a1c-96125e1fa582"]
}], "Subsection",
 CellID->976980945,ExpressionUUID->"310d3b24-9453-eaf6-5b83-71c4a6abe0b8"],

Cell[TextData[{
 "A qubit, Rabi-driven at frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008107b7-740c-9f15-7e10-dca55e5a1cc9"],
 ", starts in the pure state with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   SubscriptBox[
    StyleBox["z", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5618099f-8ad4-f9f7-1e23-40636bd4809d"],
 ", and a perfect detector measures ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2969cfed-bd09-6ddf-6e4a-b1cedefe2951"],
 " continuously at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04420d68-7afb-202e-654d-5d953c16485a"],
 ". Without a drive, each run ends at a pole; with what probability does it \
end at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "176642e1-5d43-5a58-3430-9c01995151be"],
 "?"
}], "Text",
 CellID->422269520,ExpressionUUID->"60d8e320-9244-8549-548a-c27c7deea9eb"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "252c11bb-1734-31cf-0d3c-09619754f1fe"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox["\[CapitalOmega]", "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3438e129-4cef-f8ac-2950-033e5045a04f"],
 ", the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "661b01fc-a01c-9112-2ce9-a5813ac2e19e"],
 " component of the conditioned state obeys the It\[OHat] equation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["z", "TI"], "=", "\[CapitalOmega]", 
   StyleBox["y", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "243debfd-d49a-f73d-1c50-bdcbd5fea316"],
 ", and the detector records ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["Y", "TI"], "=", "2", 
   SqrtBox[
    StyleBox["k", "TI"]], "\[ThinSpace]", 
   StyleBox["z", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b1e4129-2654-ff51-281c-ce56b2b44535"],
 ". In each step the record multiplies the amplitudes of ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "524555ae-c802-2bab-17e6-c9dafdfbf0c5"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "546528c8-d709-dda5-5113-6209e8a7a3b9"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[PlusMinus]", 
    SqrtBox[
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["Y", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f5dc93a-3b89-8b85-2ec7-f3ead9609050"],
 " and the drive rotates them."
}], "Text",
 CellID->1078859116,ExpressionUUID->"0c8b25dd-dac4-6798-1977-601a8d81c852"],

Cell[TextData[{
 "The record is sampled as 400 runs for each start. The left panel takes \
seven starting values ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1d02d0-fd90-c6c4-1e23-9d8c993be093"],
 " without a drive and plots the fraction of runs that end above ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8b6ccd-6d35-bc8e-360d-bffbc55035e4"],
 ", with its standard error, against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cc5d5fe-daa1-44cd-180d-a74dd22fc85e"],
 "; the right panel follows four runs and the mean of all 400 for the chosen \
start and drive. Time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01813612-e95f-ec31-5aed-943eec8f1a23"],
 ":"
}], "Text",
 CellID->1580990759,ExpressionUUID->"350960f0-0412-b2b6-5348-c2f9876a1225"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bornRunsZ", "[", 
    RowBox[{"\[CapitalOmega]_", ",", " ", "z0_", ",", " ", 
     RowBox[{"dt_", " ", ":", " ", "0.005"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", " ", "=", " ", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[CapitalOmega]", " ", 
         RowBox[{"dt", "/", "2"}], " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "#", "]"}], "^", "2"}], " ", ".", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], ")"}], " ", "&"}], " ", "/@", " ", 
       
       RowBox[{"FoldList", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"amp", ",", " ", "dw"}], "}"}], ",", " ", 
           RowBox[{"Normalize", " ", "/@", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"amp", " ", 
                RowBox[{"Exp", "[", 
                 RowBox[{"Outer", "[", 
                  RowBox[{"Times", ",", " ", 
                   RowBox[{
                    RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Abs", "[", "amp", "]"}], "^", "2"}], " ", ".", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], ")"}], " ", "dt"}], " ", "+",
                     " ", "dw"}], ",", " ", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ")"}], " ",
               ".", " ", "u"}], ")"}]}]}], "]"}], ",", "\n", "     ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", " ", "+", " ", "z0"}], ",", " ", 
                RowBox[{"1", " ", "-", " ", "z0"}]}], "}"}], "/", "2"}], 
             "]"}], "]"}], ",", " ", "400"}], "]"}], ",", " ", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"Sqrt", "[", "dt", "]"}]}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"800", ",", " ", "400"}], "}"}]}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornStarts", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.5"}], ",", " ", "0.2", ",", " ", "0.8"}], "}"}]}], ";", 
  " ", 
  RowBox[{"bornDrives", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornFractions", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"z0", ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"f", " ", "=", " ", 
            RowBox[{"Mean", "[", 
             RowBox[{"UnitStep", "[", 
              RowBox[{
               RowBox[{"bornRunsZ", "[", 
                RowBox[{"0", ",", " ", "z0"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", " ", 
                 RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}]}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"z0", ",", " ", 
            RowBox[{"Around", "[", 
             RowBox[{"f", ",", " ", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"f", " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "-", " ", "f"}], ")"}], "/", "400"}]}], 
               "]"}]}], "]"}]}], "}"}]}], "]"}]}], "]"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.8"}], ",", " ", 
        RowBox[{"-", "0.5"}], ",", " ", 
        RowBox[{"-", "0.2"}], ",", " ", "0", ",", " ", "0.2", ",", " ", "0.5",
         ",", " ", "0.8"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bornLawPanel", "[", "z0_", "]"}], " ", ":=", " ", 
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "     ", 
