Cell["\<\
A trapped particle watched continuously: squeezing below the zero-point\
\>", "Subsection",
 CellID->499755699,ExpressionUUID->"6be9e3d9-9a84-ed03-22d2-4e5844d8ff6f"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "299dbe54-cf39-25d1-2e27-a9ffa98c251c"],
 " in a harmonic trap of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73327f4c-ab16-847a-2542-e5d3aef83eee"],
 " has its position measured continuously at rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0534162c-27ad-69c5-1116-ad154127ba72"],
 " by a detector that catches a fraction ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53221798-0331-f7ce-32fd-fb029317f2d1"],
 " of the signal. Can watching make it narrower in position than its ground \
state?"
}], "Text",
 CellID->231895782,ExpressionUUID->"2590b32b-d97e-b954-3a8e-46e5dc05f56f"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox[
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], 
    RowBox[{"2", 
     StyleBox["m", "TI"]}]], "+", 
   FractionBox[
    RowBox[{
     StyleBox["m", "TI"], 
     SuperscriptBox[
      StyleBox["\[Omega]", "TI"], "2"], 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72d8364c-ba62-bf80-6e31-dc2028639619"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], "=", 
    StyleBox["x", "TI"], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox["x", "TI"], "-", 
    FractionBox["1", "2"], "{", 
    SuperscriptBox[
     StyleBox["x", "TI"], "2"]}], ",", 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "000835a8-d470-9140-589a-5a1ab371ddf9"],
 ", the state conditioned on the record obeys"
}], "Text",
 CellID->2139662887,ExpressionUUID->"469a2328-b781-8e81-3e0a-fd5076edec20"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    FractionBox[
     StyleBox["i", "TI"], "\[HBar]"], 
