Cell[TextData[{
 "A Gaussian state stays Gaussian, and its covariances ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08418af7-01f7-9169-3291-3dd234e2eb5f"],
 ", ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16a7c959-0eca-fd40-3ba5-e3834dd16ea0"],
 ", ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44ebeeff-9268-b4a1-1b64-ab8a7397f812"],
 " obey a Riccati equation with no noise in it:"
}], "Text",
 CellID->1367747305,ExpressionUUID->"6c0be05e-2015-62c8-2006-e710475141d5"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["x", "TI"]], "=", 
    FractionBox[
     RowBox[{"2", 
      StyleBox["C", "TI"]}], 
     StyleBox["m", "TI"]], "-", "4", 
    StyleBox["\[Eta]", "TI"], 
    StyleBox["\[Lambda]", "TI"], 
    SubsuperscriptBox["\[CapitalSigma]", 
     StyleBox["x", "TI"], "2"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    OverscriptBox[
     StyleBox["C", "TI"], "."], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["p", "TI"]], 
      StyleBox["m", "TI"]], "-", 
     RowBox[{
      StyleBox["m", "TI"], 
      SuperscriptBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]]}], "-", 
     RowBox[{"4", 
      StyleBox["\[Eta]", "TI"], 
      StyleBox["\[Lambda]", "TI"], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]], 
      StyleBox["C", "TI"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[CapitalSigma]", "."], 
     StyleBox["p", "TI"]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      StyleBox["m", "TI"], 
      SuperscriptBox[
       StyleBox["\[Omega]", "TI"], "2"], 
      StyleBox["C", "TI"]}], "+", 
     RowBox[{
      StyleBox["\[Lambda]", "TI"], 
      SuperscriptBox["\[HBar]", "2"]}], "-", 
     RowBox[{"4", 
      StyleBox["\[Eta]", "TI"], 
      StyleBox["\[Lambda]", "TI"], 
      RowBox[{
       SuperscriptBox[
        StyleBox["C", "TI"], "2"], "."}]}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->471358270,ExpressionUUID->"439177e7-123a-55e2-6131-100667598107"],

Cell[TextData[{
 "The steady state is in closed form, keeping the root proved positive, and \
so is the squeezing condition; the curves integrate the flow from the ground \
state, dashed lines are the closed form, ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05cc8972-fb2c-6355-557c-6824a00d3649"],
 " is in units of the zero-point variance ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["m", "TI"], 
    StyleBox["\[Omega]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70751d07-c4f1-f986-0f1d-42b807bb943c"],
 ", the strength is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], 
    SuperscriptBox[
     StyleBox["\[Omega]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a394300-dad6-f564-61f0-f78097cc4faa"],
 " and time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "713f2d24-1f2b-fc1a-79f2-09a6911c31f7"],
 ":"
}], "Text",
 CellID->86914683,ExpressionUUID->"6f43a8b1-3ed2-76d2-3d16-a336a03568cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"trapRiccati", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"cxp", "/", "m"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", 
       RowBox[{"vx", "^", "2"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"vp", "/", "m"}], " ", "-", " ", 
      RowBox[{"m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "vx"}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", "vx", " ", "cxp"}]}],
      ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "cxp"}], " ", "+", " ", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"\[HBar]", "^", "2"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", 
       RowBox[{"cxp", "^", "2"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapDomain", " ", "=", " ", 
   RowBox[{
    RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapSteady", " ", "=", " ", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"trapRiccati", " ", "==", " ", "0"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"vx", ",", " ", "cxp", ",", " ", "vp"}], "}"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"Resolve", "[", 
       RowBox[{
        RowBox[{"ForAll", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "m", ",", " ", "\[Lambda]", ",", " ", "\[Omega]", ",", " ", 
            "\[HBar]", ",", " ", "\[Eta]"}], "}"}], ",", " ", "trapDomain", ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "|", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], ")"}], " ", "\[Element]", 
            " ", "Reals"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], " ", ">", " ", "0"}]}]}], "]"}], 
        ",", " ", "Reals"}], "]"}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapRatio", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"trapSteady", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"\[HBar]", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m", " ", "\[Omega]"}], ")"}]}], ")"}]}], " ", "/.",
       " ", 
      RowBox[{"\[Lambda]", " ", "->", " ", 
       RowBox[{"\[Mu]", " ", "m", " ", 
        RowBox[{
         RowBox[{"\[Omega]", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "\[HBar]"}], ")"}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Mu]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trapFlow", "[", 
    RowBox[{"\[Eta]0_", ",", " ", "\[Mu]0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"vxT", "'"}], "[", "t", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"cT", "'"}], "[", "t", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"vpT", "'"}], "[", "t", "]"}]}], "}"}], " ", "==", " ", 
         RowBox[{"(", 
          RowBox[{"trapRiccati", " ", "/.", "\n", "       ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"vx", " ", "->", " ", 
              RowBox[{"vxT", "[", "t", "]"}]}], ",", " ", 
             RowBox[{"cxp", " ", "->", " ", 
              RowBox[{"cT", "[", "t", "]"}]}], ",", " ", 
             RowBox[{"vp", " ", "->", " ", 
              RowBox[{"vpT", "[", "t", "]"}]}], ",", " ", 
             RowBox[{"m", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Omega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[HBar]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[Lambda]", " ", "->", " ", 
              RowBox[{"\[Mu]0", "/", "2"}]}], ",", " ", 
             RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}]}], "}"}]}], 
          ")"}]}], "]"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"vxT", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"1", "/", "2"}]}], ",", " ", 
       RowBox[{
        RowBox[{"cT", "[", "0", "]"}], " ", "==", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"vpT", "[", "0", "]"}], " ", "==", " ", 
        RowBox[{"1", "/", "2"}]}]}], "}"}], ",", " ", "vxT", ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trapPanel", "[", "\[Eta]0_", "]"}], " ", ":=", " ", 
   RowBox[{"Show", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"trapFlow", "[", 
             RowBox[{"\[Eta]0", ",", " ", "#"}], "]"}], "[", "t", "]"}]}], 
          " ", "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "5", ",", " ", "50"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<\[Mu] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
           "&"}], " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "2"}], ",", " ", "5", ",", " ", "50"}], "}"}]}],
          ")"}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"trapRatio", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}], ",", " ", 
             RowBox[{"\[Mu]", " ", "->", " ", "#"}]}], "}"}]}], " ", "&"}], 
         " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", " ", "5", ",", " ", "50"}], "}"}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "20"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Dashed"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "2.5"}], "}"}]}], ",", " ", 
     RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Omega] t\>\"", ",", 
        " ", "\"\<\[CapitalSigma]x / zero-point variance\>\""}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]0", ",", 
         " ", "\"\<,   squeezed for \>\"", ",", " ", 
         RowBox[{"Reduce", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"trapRatio", " ", "<", " ", "1"}], " ", "&&", " ", 
             RowBox[{"\[Mu]", " ", ">", " ", "0"}]}], " ", "/.", " ", 
            RowBox[{"\[Eta]", " ", "->", " ", "\[Eta]0"}]}], ",", " ", 
           "\[Mu]", ",", " ", "Reals"}], "]"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trapPanels", " ", "=", " ", 
   RowBox[{"trapPanel", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", 
      RowBox[{"1", "/", "2"}], ",", " ", 
      RowBox[{"1", "/", "5"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"First", " ", "/@", " ", "trapPanels"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}], ",", " ", 
   RowBox[{"legendBelow", "[", 
    RowBox[{"Last", "[", 
     RowBox[{"First", "[", "trapPanels", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[17]:= ",
 CellID->1397423483,ExpressionUUID->"3235260e-a571-1294-1268-9b98e36e34c0"],

Cell[TextData[{
 "A perfect detector squeezes the position below the zero-point at every \
strength. An imperfect one squeezes only above a threshold strength that \
grows as ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f400e0-c8c5-d895-3060-8ef59cd229cc"],
 " falls; below it, watching leaves the particle wider than its ground \
state."
}], "Text",
 CellID->553956863,ExpressionUUID->"3f2a2694-4506-4d98-695b-a1669e4d7ec6"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->116211384,ExpressionUUID->"52a4db9b-0b50-4f57-54eb-1bea9a1d5e09"],

Cell["A watched Gaussian: the center wanders, the widths do not", "Subsection",
 CellID->2140780886,ExpressionUUID->"4794af98-0c4b-8906-2400-31cbbd86d096"],

Cell[TextData[{
 "A particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23bdf769-a5f9-ae87-4b46-d057fce04101"],
 " in a harmonic trap of frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3278d158-7132-72c5-2723-c9742f442ba0"],
 " is watched in position at rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "474badda-81d5-7226-73d0-8db43c5e23a9"],
 " by a detector of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3612d717-61ff-04cb-574e-5c6760ba12ec"],
 ", and its conditional state is a Gaussian with means ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["p", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c9008a-b5ea-79bc-235a-dfa00639243b"],
 ", variances ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfa01c-0a64-8e00-06d0-bba435d54341"],
 " and covariance ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bf6ff24-6843-0c63-48d2-ef76fe7d6cf9"],
 ". Every run moves the packet's center at random. Do the widths of a watched \
Gaussian wander too?"
}], "Text",
 CellID->2364046,ExpressionUUID->"04b036d2-4b0d-e93c-6e23-122ff1127bb0"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox[
    SuperscriptBox[
     StyleBox["p", "TI"], "2"], 
    RowBox[{"2", 
     StyleBox["m", "TI"]}]], "+", 
   FractionBox[
    RowBox[{
     StyleBox["m", "TI"], 
     SuperscriptBox[
      StyleBox["\[Omega]", "TI"], "2"], 
     SuperscriptBox[
      StyleBox["x", "TI"], "2"]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5086192f-f2b2-30af-0e16-ca1161d426e6"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e75c375-c897-4d0a-26eb-05cc726eeefc"],
 ", the conditional mean of any observable ",
 Cell[BoxData[
  StyleBox["O", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25ce0d58-8bc9-e722-26b1-86cb899f47ce"],
 " obeys"
}], "Text",
 CellID->1896005334,ExpressionUUID->"19130701-e225-4b7e-1ea3-c35af5adeb18"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["O", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "=", "\[LeftAngleBracket]", 
    RowBox[{
     FractionBox[
      StyleBox["i", "TI"], "\[HBar]"], 
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["H", "TI"], ",", 
      StyleBox["O", "TI"]}], 
     StyleBox["]",
      SpanMaxSize->1], "-", 
     FractionBox[
      StyleBox["\[Lambda]", "TI"], "2"], "[", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      RowBox[{
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["x", "TI"], ",", 
        StyleBox["O", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}]}], "]"}], "\[RightAngleBracket]", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"], "+", 
    SqrtBox[
     StyleBox[
      RowBox[{"\[Eta]", "\[Lambda]"}], "TI"]], "\[ThinSpace]", "\[LeftAngleBracket]", 
    RowBox[{
     RowBox[{"{", 
      StyleBox["x", "TI"], "-", 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["x", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], ",", 
     RowBox[{
      StyleBox["O", "TI"], "}"}]}], "\[RightAngleBracket]", "\[ThinSpace]", 
    StyleBox["d", "TI"], 
    StyleBox["W", "TI"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->638836912,ExpressionUUID->"343106ce-f8c2-9eb3-1ab2-8cac92a039dd"],

Cell[TextData[{
 "and the second moments pick up the It\[OHat] correction, e.g. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]], "=", 
   StyleBox["d", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", "2", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["d", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["d", "TI"], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["x", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70dd4c4b-c9e5-c2cd-38ed-f1b7a8a23136"],
 ". The Gaussian has the ordered generating function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"\[Alpha]", "x"}], "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"\[Beta]", "p"}], "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", "(", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["p", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], "+", 
    FractionBox["1", "2"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Alpha]", "TI"], "2"], 
     SubscriptBox["\[CapitalSigma]", 
      StyleBox["x", "TI"]], "+", "2", 
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["\[Beta]", "TI"], 
     StyleBox["C", "TI"], "+", 
     SuperscriptBox[
      StyleBox["\[Beta]", "TI"], "2"], 
     SubscriptBox["\[CapitalSigma]", 
      StyleBox["p", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "+", 
    FractionBox[
     RowBox[{
      StyleBox["i", "TI"], "\[HBar]"}], "2"], 
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["\[Beta]", "TI"]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45467490-3889-b7bf-6d5a-320ecc899790"],
 ", and its purity is ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     RowBox[{
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["p", "TI"]], "-", 
      SuperscriptBox[
       StyleBox["C", "TI"], "2"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40cf9b14-89b5-9628-4861-c03f351c3ea1"],
 "."
}], "Text",
 CellID->430719822,ExpressionUUID->"225f044f-5f06-0b89-0ced-f6c6f7b2ad9a"],

Cell[TextData[{
 "Ordering every product with ",
 Cell[BoxData[
