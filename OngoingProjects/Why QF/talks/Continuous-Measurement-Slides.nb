         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", " ", 
            RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}]}]}], "]"}], 
       ",", "\n", "     ", 
