Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "."], "=", "\[ScriptCapitalL]", 
    StyleBox["\[Rho]", "TI"], "=", "-", 
    StyleBox["i", "TI"], "[", 
    RowBox[{
     RowBox[{
      FractionBox["\[Epsilon]", "2"], 
      SubscriptBox[
       StyleBox["\[Sigma]", "TI"], 
       StyleBox["z", "TI"]], "+", 
      FractionBox["\[CapitalOmega]", "2"], 
      SubscriptBox[
       StyleBox["\[Sigma]", "TI"], 
       StyleBox["x", "TI"]]}], ",", 
     StyleBox["\[Rho]", "TI"]}], "]", "+", 
    StyleBox["\[Kappa]", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["L", "TI"]], 
    StyleBox["]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["k", "TI"], "=", 
    RowBox[{
     StyleBox["\[Kappa]", "TI"], "/", "4"}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1721132978,ExpressionUUID->"39f2cad1-2d28-be8b-738e-2331e08b221d"],

Cell[TextData[{
 "since ",
 Cell[BoxData[
  RowBox[{"\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["n", "TI"], 
    StyleBox["L", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   FractionBox["1", "4"], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29e15c43-7f2a-65e6-784c-1973ea0e2d66"],
 ", the watched-qubit Liouvillian of the Zeno crossover with ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008a9969-fafa-548f-4950-d7bbcb815086"],
 " for ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e45858b-f417-109f-5c66-e640756095cd"],
 ". By quantum regression, the symmetrized spectrum is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", "\[ThinSpace]", 
   StyleBox["Re",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["Tr",
    FontSlant->"Plain"], "[", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["z", "TI"]], "\[ThinSpace]", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["i", "TI"], 
        StyleBox["\[Omega]", "TI"], "-", "\[ScriptCapitalL]"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{"-", "1"}]], 
     FractionBox["1", "2"], "{", 
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["z", "TI"]], "-", 
     SubscriptBox[
      RowBox[{
       StyleBox["\[LeftAngleBracket]",
        SpanMaxSize->1], 
       SubscriptBox[
        StyleBox["\[Sigma]", "TI"], 
        StyleBox["z", "TI"]], 
       StyleBox["\[RightAngleBracket]",
        SpanMaxSize->1]}], 
      StyleBox[
       RowBox[{"s", "s"}], "TI"]]}], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"s", "s"}], "TI"]], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61cf67e9-78a0-794f-441c-132dcfb78a2c"],
 " with steady state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"s", "s"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66091024-4d8c-c18f-237e-cb7454dc813c"],
 ". A side peak exists when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["S", "TI"], "/", 
   StyleBox["d", "TI"], 
   StyleBox["\[Omega]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca52c19-d065-a7a6-3922-a9cb95cda10a"],
 " has a root at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21baade4-7c78-a882-1381-9bda6a5b3838"],
 "; an exceptional point is a ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59d23b1d-9357-84e4-6f3f-56218ae201f7"],
 " where two nonzero eigenvalues of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ff3fc88-ec7d-8662-5c52-03d93b9e019e"],
 " coincide."
}], "Text",
 CellID->2121435355,ExpressionUUID->"49a718a6-82e8-5bf7-6e42-7ce8bd5bca7f"],

Cell[TextData[{
 "Inverting ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bae7bf8-264d-d9f8-26ee-0bbcb7d823e5"],
 " for general ",
 Cell[BoxData["\[Epsilon]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7684963b-5340-9feb-012b-640977cc8ad3"],
 ", ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b72da4-c507-7a86-2980-70ecbf7c55b7"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69b23402-99c5-da95-5dc1-37e48235bcda"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e0a56f0-3ce5-65a0-07f2-8d84062efd12"],
 " in closed form, with the largest ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a954723-5789-a39a-7b2f-de9e2c615325"],
 " that keeps side peaks and the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b598168-22ce-7f7c-32c3-14becd5ee445"],
 " where the discriminant of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38e161a1-c5ad-4ae6-663b-cc7b00b52f58"],
 "'s characteristic polynomial vanishes; on resonance these are:"
}], "Text",
 CellID->1035562367,ExpressionUUID->"44f7e541-86a6-f789-34d7-8ff415a67e7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qpcL", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Liouvillian\>\"", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[CurlyEpsilon]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}], "}"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"4", " ", "k"}], "}"}]}], "]"}], "]"}], "[", "\"\<Matrix\>\"",
      "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcSS", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", " ", "=", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"First", "[", 
          RowBox[{"NullSpace", "[", "qpcL", "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"v", "/", 
      RowBox[{"Tr", "[", "v", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcSpec", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dz", " ", "=", " ", 
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "qpcSS"}], 
          "]"}], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"2", " ", 
       RowBox[{"ComplexExpand", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"LinearSolve", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"I", " ", "\[Omega]", " ", 
                 RowBox[{"IdentityMatrix", "[", "4", "]"}]}], " ", "-", " ", 
                "qpcL"}], ",", " ", 
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"dz", " ", ".", " ", "qpcSS"}], " ", "+", " ", 
                   RowBox[{"qpcSS", " ", ".", " ", "dz"}]}], ")"}], "/", 
                 "2"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}], "]"}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qpcSideEdge", "[", "\[CurlyEpsilon]v_", "]"}], " ", ":=", " ", 
   RowBox[{"MaxValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"Reduce", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exists", "[", 
           RowBox[{"u", ",", " ", 
            RowBox[{
             RowBox[{"u", " ", ">", " ", "0"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Numerator", "[", 
               RowBox[{"Together", "[", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"qpcSpec", " ", "/.", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\[Omega]", " ", "->", " ", 
                    RowBox[{"Sqrt", "[", "u", "]"}]}], ",", " ", 
                    RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", 
                    " ", 
                    RowBox[{
                    "\[CurlyEpsilon]", " ", "->", " ", "\[CurlyEpsilon]v"}]}],
                     "}"}]}], ",", " ", "u"}], "]"}], "]"}], "]"}], " ", "==",
               " ", "0"}]}]}], "]"}], " ", "&&", " ", 
          RowBox[{"k", " ", ">", " ", "0"}]}], ",", " ", "k"}], "]"}]}], 
      "}"}], ",", " ", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qpcDisc", " ", "=", " ", 
   RowBox[{"Discriminant", "[", 
    RowBox[{
     RowBox[{"Cancel", "[", 
      RowBox[{
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{"qpcL", ",", " ", "\[Lambda]"}], "]"}], "/", "\[Lambda]"}], 
      "]"}], ",", " ", "\[Lambda]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qpcEP", "[", "\[CurlyEpsilon]v_", "]"}], " ", ":=", " ", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"qpcDisc", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{
             "\[CurlyEpsilon]", " ", "->", " ", "\[CurlyEpsilon]v"}]}], 
            "}"}]}], ")"}], " ", "==", " ", "0"}], " ", "&&", " ", 
        RowBox[{"k", " ", ">", " ", "0"}]}], ",", " ", "k", ",", " ", 
       "Reals"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", " ", "->", " ", "v_"}], "}"}], " ", ":>", " ", "v"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<S(\[Omega])\>\"", " ", "->", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"qpcSpec", " ", "/.", " ", 
      RowBox[{"\[CurlyEpsilon]", " ", "->", " ", "0"}]}], "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<side peaks\>\"", " ", "->", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"Reduce", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"SeriesCoefficient", "[", 
           RowBox[{
            RowBox[{"qpcSpec", " ", "/.", " ", 
             RowBox[{"\[CurlyEpsilon]", " ", "->", " ", "0"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Omega]", ",", " ", "0", ",", " ", "2"}], "}"}]}], 
           "]"}], " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
         RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], ",", " ", "k"}], 
       "]"}], ",", " ", 
      RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<exceptional point\>\"", " ", "->", " ", 
    RowBox[{"k", " ", "==", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"k", " ", "/.", " ", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"qpcDisc", " ", "/.", " ", 
              RowBox[{"\[CurlyEpsilon]", " ", "->", " ", "0"}]}], ")"}], " ", 
            "==", " ", "0"}], " ", "&&", " ", 
           RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}]}], ",", " ", "k"}],
          "]"}], "]"}]}], "]"}]}]}]}], "|>"}]}], "Input",
 CellLabel->"In[4]:= ",
 CellID->1623037933,ExpressionUUID->"3b7fe7d0-8566-2a10-690f-2fdd6ef274fc"],

Cell[TextData[{
 "Each panel plots ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d71981-ee63-897f-19d2-9af1566c8ec9"],
 " for three measurement strengths, then for the largest ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad158dc-db46-8d0e-4fce-3be85f8bb3ea"],
 " that keeps side peaks and, where one exists, for the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15c55c24-a64e-8660-65f6-a656c0807634"],
 " of each exceptional point; the gray lines mark the bare Rabi frequencies \
",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "+", 
     SuperscriptBox["\[Epsilon]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd805e3-13f3-f806-25bc-179555cf9a36"],
 ", and frequencies and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64dc62d1-bcfe-30de-1c69-e48f850b9eff"],
 " are in units of ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b557d11-8ee5-a080-7484-4d5ac4fbb4bd"],
 ":"
}], "Text",
 CellID->1723954199,ExpressionUUID->"554879f6-fe09-4335-6c8a-5257c390f718"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qpcKs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.25", ",", " ", "0.5", ",", " ", "1.5"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qpcPanel", "[", "\[CurlyEpsilon]v_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ks", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"qpcKs", ",", " ", 
          RowBox[{"{", 
           RowBox[{"N", "[", 
            RowBox[{"qpcSideEdge", "[", 
             RowBox[{"Rationalize", "[", "\[CurlyEpsilon]v", "]"}], "]"}], 
            "]"}], "}"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"qpcEP", "[", 
            RowBox[{"Rationalize", "[", "\[CurlyEpsilon]v", "]"}], "]"}], 
           "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"w", " ", "=", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"\[CurlyEpsilon]v", "^", "2"}]}], "]"}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"qpcSpec", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
             RowBox[{"\[CurlyEpsilon]", " ", "->", " ", "\[CurlyEpsilon]v"}], 
             ",", " ", 
             RowBox[{"k", " ", "->", " ", "#"}]}], "}"}]}], " ", "&"}], " ", "/@",
          " ", "ks"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", " ", 
         RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "w"}], ",", " ", "w"}], "}"}], ",", " ", "None"}], 
         "}"}]}], ",", " ", 
       RowBox[{"GridLinesStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Omega]/\[CapitalOmega]\>\"", ",", 
          " ", "\"\<\[CapitalOmega] S(\[Omega])\>\""}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<k/\[CapitalOmega] = \>\"", ",", " ", 
                 RowBox[{
                  RowBox[{"Round", "[", 
                   RowBox[{"#", ",", " ", "0.01"}], "]"}], " ", "/.", " ", 
                  RowBox[{
                   RowBox[{"x_Real", " ", "/;", " ", 
                    RowBox[{"x", " ", "==", " ", 
                    RowBox[{"Round", "[", "x", "]"}]}]}], " ", ":>", " ", 
                   RowBox[{"Round", "[", "x", "]"}]}]}]}], "}"}], "]"}], " ", 
              "&"}], " ", "/@", " ", "ks"}], ",", " ", 
            RowBox[{"LegendLayout", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<Row\>\"", ",", " ", "2"}], "}"}]}]}], "]"}], ",", 
          " ", "Below"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\[CurlyEpsilon]/\[CapitalOmega] = \>\"", ",", " ", 
           "\[CurlyEpsilon]v"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"PlotGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qpcPanel", " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.3", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "900"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:= ",
 CellID->76814079,ExpressionUUID->"4154fbf8-6e15-3e70-1d8e-6613456e3988"],

Cell[TextData[{
 "On resonance the two peaks slide inward and meet at zero frequency at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]", "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d5d5e05-a30a-c65a-33d6-54f945523deb"],
 ", while the eigenvectors of ",
 Cell[BoxData["\[ScriptCapitalL]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0794453b-b1fb-9ba3-30ac-c625b0b4a180"],
 " coalesce only at the exceptional point ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5edb409d-091c-dccf-06c9-5e0ff7b90352"],
 ", where the spectrum has long shown one central peak. An offset raises the \
center of the spectrum and removes the side peaks at a smaller ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d81c886-4353-b7e5-7d20-d6c92a69ae2f"],
 "; at ",
 Cell[BoxData[
  RowBox[{"\[Epsilon]", "/", "\[CapitalOmega]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6da49da4-598d-4d4e-054c-f2afa3f7eab8"],
 " they vanish although no exceptional point exists at all, so the merging of \
the peaks is a property of the line shape, not of eigenvector coalescence."
}], "Text",
 CellID->440008987,ExpressionUUID->"7846e2d4-f64f-3163-1d41-b45454f03838"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2121350252,ExpressionUUID->"5cdb73ba-a715-3779-2df3-a30830466d71"],

Cell["Dispersive readout pointer states", "Subsection",
 CellID->751547568,ExpressionUUID->"253567ba-d8cf-b3b2-3aa6-8832699698c1"],

Cell[TextData[{
 "A readout cavity of linewidth ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18aec436-eceb-9b3f-2c9a-7568db74ab83"],
 ", coupled to a transmon, has its frequency pulled by ",
 Cell[BoxData[
  RowBox[{"+", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b042fb9-7d38-a187-3a73-94a93fdf349d"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1184f576-568e-add5-7960-afc2b8bcbea4"],
 " depending on the qubit state, and is driven by a readout pulse ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Epsilon]", 
    StyleBox["r", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b56e2bb-b1cc-c1d6-1293-0f879e0646c4"],
 " of peak amplitude ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[CurlyEpsilon]", "TI"], 
   StyleBox["max",
    FontSlant->"Plain"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "592a630a-2485-663b-2b64-d08771940efe"],
 ". How does the cavity field separate for the two qubit states as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", "2", GridBox[{
     {
      StyleBox["\[Chi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1681f44d-2c3f-de71-50c1-e89afd18e4a3"],
 " changes?"
}], "Text",
 CellID->1805299078,ExpressionUUID->"162ff05a-6489-545f-60f1-2d9726bda5ed"],

Cell["\<\
The circuit and its Hamiltonian at three levels of approximation; hovering \
over a part of the circuit highlights its term, and Level 2 is the dispersive \
Hamiltonian used below:\
\>", "Text",
 CellID->1307459721,ExpressionUUID->"2f1dc953-04ad-6949-7306-adbd850d2c28"],

Cell[BoxData[
 RowBox[{"TransmonCircuitPlot", "[", "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->246421316,ExpressionUUID->"2262515e-f02d-be5e-1eb6-5f400f1cb9bd"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d93277f-dd22-edbf-0447-d6ada2cb208a"],
 ", in the frame of the readout drive, the cavity holds a coherent state ",
 Cell[BoxData[
  TemplateBox[{
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["j", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b4c7237-2d15-9d6c-34e0-e46c0a7c669f"],
 " for qubit state ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7daa4556-751a-ba77-1163-3680b38a4a74"],
 ", with"
}], "Text",
 CellID->1060885634,ExpressionUUID->"057b95be-e81e-1eb3-3148-0f16ca0b667a"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Alpha]", "TI"], "."], "0"], "=", "-", "(", 
    RowBox[{
     FractionBox[
      StyleBox["\[Kappa]", "TI"], "2"], "+", 
     StyleBox["i", "TI"], 
     StyleBox["\[Chi]", "TI"]}], ")", 
    SubscriptBox[
     StyleBox["\[Alpha]", "TI"], "0"], "-", 
    FractionBox[
     StyleBox["i", "TI"], "2"], 
    SubscriptBox[
     StyleBox["\[CurlyEpsilon]", "TI"], 
     StyleBox["max",
      FontSlant->"Plain"]], 
    SubscriptBox["\[Epsilon]", 
     StyleBox["r", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Alpha]", "TI"], "."], "1"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          StyleBox["\[Kappa]", "TI"], "2"], "-", 
         StyleBox["i", "TI"], 
         StyleBox["\[Chi]", "TI"]}], ")"}]}], 
      SubscriptBox[
       StyleBox["\[Alpha]", "TI"], "1"]}], "-", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], 
      SubscriptBox[
       StyleBox["\[CurlyEpsilon]", "TI"], 
       StyleBox["max",
        FontSlant->"Plain"]], 
      SubscriptBox["\[Epsilon]", 
       StyleBox["r", "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["t", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1894213956,ExpressionUUID->"48058b58-86ff-f9ab-3178-cc1d9d70d799"],

Cell[TextData[{
 "so under a constant drive ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dca1517-27e5-ef8c-1a0b-7c6c19cd47df"],
 " settles at ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox["max",
     FontSlant->"Plain"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Kappa]", "TI"], "\[PlusMinus]", "2", 
    StyleBox["i", "TI"], 
    StyleBox["\[Chi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25444a9d-2d86-1b53-683b-1ce7d419c6e0"],
 ". The field leaking out of the cavity, which the measurement records, is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74c84243-311d-793c-13e1-342369e1383f"],
 "."
}], "Text",
 CellID->1517395904,ExpressionUUID->"0ff1467d-ce24-4306-229f-202ded5efbf2"],

Cell[TextData[{
 "For a 4 \[Mu]s flat-top readout the figure plots, up to the fall of the \
drive, the intracavity field ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["j", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1180dcd9-4e91-4d56-39c6-3c4f471015fc"],
 " with its steady states as points, and the output separation ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Kappa]", "TI"]], "\[ThinSpace]", GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], "0"], "-", 
       SubscriptBox[
        StyleBox["\[Alpha]", "TI"], "1"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d84189b-da87-835f-0be3-583e064a0b9b"],
 " in units of ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", GridBox[{
      {
       StyleBox["\[Chi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b174d95-327e-c344-7587-60e6352769c1"],
 ". The transmon has qubit-cavity coupling 50 MHz and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d0ec827-43cf-f2ef-78b9-3a443cbdfdf8"],
 " \[Mu]s, so ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d8ac7bd-faff-723f-3a78-1d299205173d"],
 " comes from the dispersive formula and the drive is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[CurlyEpsilon]", "TI"], 
    StyleBox["max",
     FontSlant->"Plain"]], "\[TildeTilde]", "9", GridBox[{
     {
      StyleBox["\[Chi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "639560ae-eaa0-5e08-0af9-485277356060"],
 ":"
}], "Text",
 CellID->1223813556,ExpressionUUID->"53753557-9dad-942d-0663-5866754ee3bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pointerSystem", "[", "\[Kappa]Hz_", "]"}], " ", ":=", " ", 
   RowBox[{"TransmonSystem", "[", 
    RowBox[{
     RowBox[{"\"\<Coupling\>\"", " ", "->", " ", "50*^6"}], ",", " ", 
     RowBox[{"\"\<CavityLinewidth\>\"", " ", "->", " ", "\[Kappa]Hz"}], ",", 
     " ", 
     RowBox[{"\"\<T1\>\"", " ", "->", " ", "10.*^-6"}], ",", " ", 
     RowBox[{"\"\<T2\>\"", " ", "->", " ", "10.*^-6"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerChiHz", " ", "=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"TransmonSystem", "[", 
      RowBox[{"\"\<Coupling\>\"", " ", "->", " ", "50*^6"}], "]"}], 
     "[", "\"\<Chi\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerRs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.3", ",", " ", "0.6", ",", " ", "2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerDR", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DispersiveReadout", "[", 
       RowBox[{
        RowBox[{"pointerSystem", "[", 
         RowBox[{"2", " ", "#", " ", "pointerChiHz"}], "]"}], ",", " ", 
        RowBox[{"Pulse", "[", 
         RowBox[{"\"\<FlatTop\>\"", ",", " ", "4000", ",", " ", 
          RowBox[{"\"\<RiseTime\>\"", " ", "->", " ", "50"}]}], "]"}]}], 
       "]"}], " ", "&"}], ",", " ", "pointerRs"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerEnd", " ", "=", " ", 
   RowBox[{"4000*^-9", " ", "-", " ", "50*^-9"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pointerSep", "[", 
    RowBox[{"r_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "r", "]"}], " ", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"pointerDR", "[", "r", "]"}], "[", "\"\<Alpha0\>\"", "]"}], "[", 
       RowBox[{"x", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi", " ", "pointerChiHz"}], ")"}]}], "]"}], " ", "-",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"pointerDR", "[", "r", "]"}], "[", "\"\<Alpha1\>\"", "]"}], "[", 
       RowBox[{"x", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi", " ", "pointerChiHz"}], ")"}]}], "]"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerXEnd", " ", "=", " ", 
   RowBox[{"2", " ", "Pi", " ", "pointerChiHz", " ", "pointerEnd"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerIQ", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ReIm", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"pointerDR", "[", "r", "]"}], "[", "\"\<Alpha0\>\"", 
            "]"}], "[", "s", "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"pointerDR", "[", "r", "]"}], "[", "\"\<Alpha1\>\"", 
            "]"}], "[", "s", "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "pointerRs"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "0", ",", " ", "pointerEnd", ",", " ", 
         RowBox[{"pointerEnd", "/", "400"}]}], "}"}]}], "]"}], ",", " ", 
     "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerRange", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Min", "[", "#", "]"}], ",", " ", 
         RowBox[{"Max", "[", "#", "]"}]}], "}"}], " ", "&"}], "[", 
      RowBox[{"pointerIQ", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Min", "[", "#", "]"}], ",", " ", 
         RowBox[{"Max", "[", "#", "]"}]}], "}"}], " ", "&"}], "[", 
      RowBox[{"pointerIQ", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerSepMax", " ", "=", " ", 
   RowBox[{"1.05", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"pointerSep", "[", 
        RowBox[{"r", ",", " ", "x"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "pointerRs"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "pointerXEnd", ",", " ", 
         RowBox[{"pointerXEnd", "/", "400"}]}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pointerPanel", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dr", " ", "=", " ", 
       RowBox[{"pointerDR", "[", "r", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"ReIm", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"dr", "[", "\"\<Alpha0\>\"", "]"}], "[", "s", "]"}], ",",
              " ", 
             RowBox[{
              RowBox[{"dr", "[", "\"\<Alpha1\>\"", "]"}], "[", "s", "]"}]}], 
            "}"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "0", ",", " ", "pointerEnd"}], "}"}], ",", 
         "\n", "     ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<qubit in |0\:27e9\>\"", ",", 
                " ", "\"\<qubit in |1\:27e9\>\""}], "}"}], ",", " ", 
              RowBox[{"LegendMarkerSize", " ", "->", " ", "15"}], ",", " ", 
              RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], 
             "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.5", ",", " ", "0.02"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0.5", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}]}]}], 
        "]"}], ",", " ", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"ReIm", "[", 
           RowBox[{"Values", "[", 
            RowBox[{"dr", "[", "\"\<SteadyState\>\"", "]"}], "]"}], "]"}]}], ",",
          " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"PointSize", "[", "Large", "]"}]}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"GridLinesStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], 
         "]"}]}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", "pointerRange"}], ",", " ", 
       RowBox[{"PlotRangePadding", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Scaled", "[", "0.04", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Scaled", "[", "0.14", "]"}], ",", " ", 
            RowBox[{"Scaled", "[", "0.04", "]"}]}], "}"}]}], "}"}]}], ",", 
       " ", 
       RowBox[{"Axes", " ", "->", " ", "False"}], ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Re \[Alpha]\>\"", ",", " ", "\"\<Im \[Alpha]\>\""}], 
         "}"}]}], ",", " ", 
       RowBox[{"ImagePadding", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"60", ",", " ", "10"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"45", ",", " ", "10"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pointerOutput", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"pointerSep", "[", 
      RowBox[{"r", ",", " ", "x"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "pointerXEnd"}], "}"}], ",", " ", 
     
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{
       RowBox[{"ColorData", "[", "97", "]"}], "[", "3", "]"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "pointerSepMax"}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"GridLinesStyle", " ", "->", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], "]"}]}],
      ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "   ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<|\[Chi]| t\>\"", ",", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<output separation / \>\"", ",", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "\"\<|\[Chi]|\>\""}], "}"}], "]"}], 
            "]"}]}], "}"}], "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImagePadding", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"60", ",", " ", "10"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"45", ",", " ", "10"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pointerPanels", " ", "=", " ", 
