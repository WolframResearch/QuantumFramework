            RowBox[{"{", 
             RowBox[{"Directive", "[", 
              RowBox[{"Red", ",", " ", 
               RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], "}"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<(1 + \>\"", ",", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"\"\<z\>\"", ",", " ", "0"}], "]"}], ",", 
                " ", "\"\<)/2\>\""}], "}"}], "]"}], "}"}]}], "]"}]}], "}"}], 
        "]"}], ",", " ", "Below"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornRunStyle", " ", "=", " ", 
