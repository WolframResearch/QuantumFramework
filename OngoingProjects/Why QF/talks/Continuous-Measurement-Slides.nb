             RowBox[{
              RowBox[{"{", 
               RowBox[{"Directive", "[", 
                RowBox[{"Red", ",", " ", "Dashed"}], "]"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<z\>\"", ",", " ", "0"}], "]"}], "}"}]}], "]"}]}],
            "}"}], "]"}], ",", " ", "Below"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"bornRuns", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "8", "]"}], ";", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{"bornRunsPanel", ",", " ", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{"bornDrives", ",", " ", "bornStarts"}], "}"}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bornLaw", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"bornLawPanel", ",", " ", "bornStarts"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bornLaw", "[", "bornZ0", "]"}], ",", " ", 
        RowBox[{"bornRuns", "[", 
         RowBox[{"{", 
          RowBox[{"bornOmega", ",", " ", "bornZ0"}], "}"}], "]"}]}], "}"}], 
      "}"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Top"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "3"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bornZ0", ",", " ", "0.2", ",", " ", 
       RowBox[{"Subscript", "[", 
        RowBox[{"\"\<z\>\"", ",", " ", "0"}], "]"}]}], "}"}], ",", " ", 
     "bornStarts", ",", " ", "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "bornOmega", ",", " ", "0", ",", " ", "\"\<\[CapitalOmega]/k\>\""}], 
      "}"}], ",", " ", "bornDrives", ",", " ", "SetterBar"}], "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[8]:= ",
 CellID->395337628,ExpressionUUID->"34135665-3563-a73c-3019-4d0b3874f09f"],

Cell[TextData[{
 "Without a drive the drift of ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c9d90f0-4d92-6f78-61ab-ee3b74f7e6da"],
 " is zero: every run heads for a pole while the mean stays on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63597f46-d7fb-21ba-135f-81b1ff6c5c8a"],
 ". A bounded process with constant mean that ends at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634f358c-947b-f2bf-539b-8668e95c67f2"],
 " must end at ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02022ee5-ded7-b107-1ea3-2e9ff2bb7204"],
 " with probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["z", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6e2037-ac6d-6ae6-79e5-7bc1bb895ebd"],
 ", and the fraction of runs ending above zero matches it within its standard \
error. A drive adds the drift ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ebb8fe8-00c6-c12a-603d-ca2f8cbcb543"],
 ": the mean leaves ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["z", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19f00f60-745c-592c-2e93-3831e9bb34f7"],
 " and the runs keep jumping instead of settling."
}], "Text",
 CellID->64637481,ExpressionUUID->"28eaa47d-6e68-975b-3048-86a975e28f0d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2093271564,ExpressionUUID->"3a56ee2a-5732-bd53-0496-e88775cd6eac"],

Cell[TextData[{
 "Quantum Bayesian update: each reading divides the mixedness by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["w", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75f2c7eb-c400-c9c8-254c-1f990ab26b89"]
}], "Subsection",
 CellID->124093734,ExpressionUUID->"7c5260f9-4bf4-48fb-26ff-eeb2d7706f9d"],

Cell[TextData[{
 "A detector reads a Pauli observable ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518d00c9-a009-47c9-1646-3f9163636b95"],
 " of a qubit over a short window and returns a noisy reading ",
 Cell[BoxData[
  StyleBox["I", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f487097-51d4-5cbb-5b99-0f957d7c13c1"],
 ". Two detectors take turns, one reading ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75f1ff15-bfa3-6e4c-3b7d-9f7b27b378fa"],
 " and one reading ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[CurlyTheta]"], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyTheta]", "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyTheta]", "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1758d342-9662-37ee-2b98-3f5c5313663a"],
 ". How does the mixedness ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22ffd434-118a-af1a-4acb-69b4f38fa947"],
 " of the state change with each reading?"
}], "Text",
 CellID->129568409,ExpressionUUID->"15f80b96-7ed7-8643-65d3-a42a3b4ab316"],

Cell["\<\
Each reading updates the state by Bayes' rule, written as a Kraus operator \
(Korotkov):\
\>", "Text",
 CellID->597877820,ExpressionUUID->"437e6475-3e3e-a866-5d64-0b126ba79604"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[ThickSpace]", "\[LongRightArrow]", 
    "\[ThickSpace]", 
    FractionBox[
     StyleBox[
      RowBox[{"M", "\[Rho]", "M"}], "TI"], 
     StyleBox["w", "TI"]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     StyleBox["M", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["I", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["I", "TI"], 
      StyleBox["A", "TI"], "/", "2", 
      StyleBox["D", "TI"]}]]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["w", "TI"], "=", 
    RowBox[{
     StyleBox["Tr",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["M", "TI"], 
     StyleBox["\[Rho]", "TI"], 
     StyleBox["M", "TI"]}]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->540230488,ExpressionUUID->"39a9f652-79b4-ba93-5948-04ccb7905204"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  StyleBox["I", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f48d68b-527c-64d8-00cf-172e36605814"],
 " is drawn from a Gaussian of variance ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51ad84e8-c192-e61b-2e8a-8920fc408ca3"],
 " centered on ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f577d8e-9969-8d1d-4959-51e3b361ad02"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d07e210-61d0-aa2d-2ace-e14bc26c4381"],
 " with the Born probabilities of ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "496a0896-4910-8cf0-2894-7c64cfff9ac9"],
 ". ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f7bfbbc-6bf5-9234-13ec-8004e4d3bdcc"],
 ", for every reading and every ",
 Cell[BoxData["\[CurlyTheta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ddf2f94-bdc0-b503-75d0-42df4cc31a36"],
 ", is:"
}], "Text",
 CellID->2106617707,ExpressionUUID->"4e081f22-97ce-6f06-13c7-60d06891485a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"krausGauss", "[", 
    RowBox[{"i_", ",", " ", "A_", ",", " ", "d_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"i", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "d"}], ")"}]}], " ", "A"}], "]"}]}], ";"}], "\n", 
 RowBox[{"detKraus", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Det", "[", 
     RowBox[{"krausGauss", "[", 
      RowBox[{"iRead", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[CurlyTheta]", "]"}], " ", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[CurlyTheta]", "]"}], " ", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ",", " ", "dVar"}], 
      "]"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"iRead", ",", " ", "\[CurlyTheta]"}], "}"}], " ", "\[Element]",
       " ", "Reals"}], " ", "&&", " ", 
     RowBox[{"dVar", " ", ">", " ", "0"}]}]}], "]"}]}]}], "Input",
 CellLabel->"In[9]:= ",
 CellID->1620417510,ExpressionUUID->"0284121f-1f42-be10-5514-0deef4817ef3"],

Cell[TextData[{
 "A run of 20 readings starts from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.3", ",", "0", ",", "0.4"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee7c61f-7bfc-c570-78e5-877c66016723"],
 ", alternating the two detectors. The left panel takes every reading of ten \
runs at each ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141e9c46-8205-73db-7cd7-ef5d449ba8a8"],
 " and ",
 Cell[BoxData["\[CurlyTheta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c51f242-6454-8036-04df-f3c0b9087725"],
 " and plots how much it changed the mixedness ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "=", "4", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70ba62d3-2be1-25e0-5b15-f6fb466822b9"],
 " against ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["w", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26047790-6a10-b024-4f98-c93deca91194"],
 "; the right panel shows five runs at each detector noise ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "656dbe62-248b-1243-4d50-46ff6ddd14f7"],
 ":"
}], "Text",
 CellID->724417869,ExpressionUUID->"61367e13-ad99-4610-0b2e-daee97f24e75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bayesStep", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]_", ",", " ", "_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"A_", ",", " ", "d_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"\[Rho]", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", "A"}], 
            ")"}]}], "/", "2"}], "]"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mk", " ", "=", " ", 
         RowBox[{"krausGauss", "[", 
          RowBox[{
           RowBox[{"RandomVariate", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{
              RowBox[{"RandomChoice", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"p", ",", " ", 
                  RowBox[{"1", " ", "-", " ", "p"}]}], "}"}], " ", "->", " ", 
                
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", 
                  RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", " ", 
              RowBox[{"Sqrt", "[", "d", "]"}]}], "]"}], "]"}], ",", " ", "A", 
           ",", " ", "d"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"w", " ", "=", " ", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"mk", " ", ".", " ", "\[Rho]", " ", ".", " ", "mk"}], 
             "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"mk", " ", ".", " ", "\[Rho]", " ", ".", " ", "mk"}], "/",
             "w"}], ",", " ", "w"}], "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bayesMixedness", "[", "\[Rho]_", "]"}], " ", ":=", " ", 
   RowBox[{"4", " ", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesRho0", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{"0.3", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
      RowBox[{"0.4", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bayesRun", "[", 
    RowBox[{"d_", ",", " ", "\[CurlyTheta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{"FoldList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bayesStep", "[", 
       RowBox[{"#1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"#2", ",", " ", "d"}], "}"}]}], "]"}], " ", "&"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"bayesRho0", ",", " ", "1."}], "}"}], ",", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Cos", "[", "\[CurlyTheta]", "]"}], " ", 
             RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"Sin", "[", "\[CurlyTheta]", "]"}], " ", 
             RowBox[{"PauliMatrix", "[", "1", "]"}]}]}]}], "}"}], ",", " ", 
         "10"}], "]"}], ",", " ", "1"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bayesSteps", "[", "run_", "]"}], " ", ":=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{
          RowBox[{"Last", "[", "#2", "]"}], "^", "2"}]}], ",", " ", 
        RowBox[{
         RowBox[{"bayesMixedness", "[", 
          RowBox[{"First", "[", "#2", "]"}], "]"}], "/", 
         RowBox[{"bayesMixedness", "[", 
          RowBox[{"First", "[", "#1", "]"}], "]"}]}]}], "}"}], " ", "&"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Most", "[", "run", "]"}], ",", " ", 
       RowBox[{"Rest", "[", "run", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesThetas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", 
     RowBox[{"\[Pi]", "/", "4"}], ",", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesLawPanel", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pts", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "6", "]"}], ";", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Catenate", "[", 
            RowBox[{"Catenate", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"bayesSteps", "[", 
                RowBox[{"bayesRun", "[", 
                 RowBox[{"d", ",", " ", "\[CurlyTheta]"}], "]"}], "]"}], ",", 
               " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"2", ",", " ", "8"}], "}"}]}], "}"}], ",", " ", 
               RowBox[{"{", "10", "}"}]}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\[CurlyTheta]", ",", " ", "bayesThetas"}], "}"}]}], 
          "]"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Show", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"ListLogLogPlot", "[", 
          RowBox[{"pts", ",", " ", 
           RowBox[{"PlotMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "8"}], "}"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "9"}], "}"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Times]\>\"", ",", " ", "9"}], "}"}]}], "}"}]}], 
           ",", " ", 
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
             RowBox[{"Range", "[", "3", "]"}]}]}]}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"LogLogPlot", "[", 
          RowBox[{"x", ",", " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "0.05", ",", " ", "50"}], "}"}], ",", " ", 
           
           RowBox[{"PlotStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<1/\>\"", ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{"\"\<w\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}], ",",
             " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<det \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[Rho]\>\"", ",", " ", "\"\<after\>\""}], "]"}], 
               ",", " ", "\"\< / det \>\"", ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[Rho]\>\"", ",", " ", "\"\<before\>\""}], 
                "]"}]}], "}"}], "]"}]}], "}"}]}], ",", "\n", "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", "\"\<every reading\>\""}], ",", 
         " ", 
         RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
         RowBox[{"GridLinesStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], 
           "]"}]}], ",", " ", 
         RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"PointLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<\[CurlyTheta] = \>\"", ",", " ", "#"}], "}"}], 
              "]"}], " ", "&"}], " ", "/@", " ", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", " ", "\"\<\[Pi]/4\>\"", ",", " ", "\"\<\[Pi]/2\>\""}], 
             "}"}]}], ",", " ", 
           RowBox[{"LegendMarkers", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", " ", "8"}], "}"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[EmptySquare]\>\"", ",", " ", "9"}], "}"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"\"\<\[Times]\>\"", ",", " ", "9"}], "}"}]}], "}"}]}], 
           ",", " ", 
           RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
          " ", "Below"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bayesNoisePanel", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"runs", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"bayesMixedness", "[", 
              RowBox[{"First", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
            " ", 
            RowBox[{"bayesRun", "[", 
             RowBox[{"d", ",", " ", 
              RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "8"}], "}"}]}], "}"}], ",", " ", 
           RowBox[{"{", "5", "}"}]}], "]"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Legended", "[", 
      RowBox[{
       RowBox[{"Show", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ListLogPlot", "[", 
             RowBox[{"#1", ",", " ", 
              RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
              RowBox[{"DataRange", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", " ", 
              RowBox[{"PlotStyle", " ", "->", " ", 
               RowBox[{"Directive", "[", 
                RowBox[{"#2", ",", " ", 
                 RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}]}], 
             "]"}], " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"runs", ",", " ", 
             RowBox[{
              RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
              RowBox[{"{", 
               RowBox[{"4", ",", " ", "5"}], "}"}]}]}], "}"}]}], "]"}], ",", 
         "\n", "     ", 
         RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<reading number\>\"", ",", " ", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<1 \[Minus] \>\"", ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{"\"\<r\>\"", ",", " ", "2"}], "]"}]}], "}"}], "]"}]}],
            "}"}]}], ",", " ", 
         RowBox[{
         "PlotLabel", " ", "->", 
          " ", "\"\<five runs each, \[CurlyTheta] = \[Pi]/4\>\""}], ",", " ", 
         
         RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
         RowBox[{"GridLinesStyle", " ", "->", " ", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"GrayLevel", "[", "0.8", "]"}], ",", " ", "Dashed"}], 
           "]"}]}], ",", " ", 
         RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "5"}], "}"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<D = 2\>\"", ",", " ", "\"\<D = 8\>\""}], "}"}], ",", 
           " ", 
           RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
          " ", "Below"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"bayesLawPanel", ",", " ", "bayesNoisePanel"}], "}"}], "}"}], ",",
    " ", 
   RowBox[{"Alignment", " ", "->", " ", "Top"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "3"}]}], "]"}]}], "Input",
 CellLabel->"In[10]:= ",
 CellID->1160720061,ExpressionUUID->"4ff378d7-ebe8-6834-65ea-b4a3521b448b"],

Cell[TextData[{
 "Every Kraus operator has unit determinant, for every reading and every ",
 Cell[BoxData["\[CurlyTheta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aa409f8-afdd-03f6-43ca-40ca02b1d367"],
 ", so each update multiplies ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f96e29f-be41-62ec-62ba-894ec4dbaeae"],
 ", and with it the mixedness, by ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SuperscriptBox[
    StyleBox["w", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01cde54c-ff7b-b7a4-3986-d56bc7088464"],
 ": every reading lands on the diagonal, the unlikely ones that raise the \
mixedness (above 1) as well as the likely ones that lower it. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12963c46-8dd7-d009-5ad0-950f7d83d7bf"],
 " the mixedness falls by orders of magnitude along every run. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["D", "TI"], "=", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6ca0c2-e870-8b29-54bb-6ab5d4d67817"],
 " one reading carries little information, and twenty readings purify the \
state only partly."
}], "Text",
 CellID->1120081650,ExpressionUUID->"5de37e8e-5b1a-4a28-2413-8901d2664888"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->434933389,ExpressionUUID->"2cb7979e-0888-9d54-5095-4dab1459da2c"],

Cell["\<\
Measurement purifies a qubit: It\[OHat]'s lemma in spherical coordinates\
\>", "Subsection",
 CellID->1366089870,ExpressionUUID->"5f1d34c2-b251-a750-5ef8-862d95de6ed8"],

Cell[TextData[{
 "A qubit with Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox["\[CapitalDelta]", "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fcca72b-df26-8664-528c-6d6bf9e331c6"],
 " is measured continuously along ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c56d238-b0cc-2596-3f5a-519a1fe990c9"],
 " at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c826ec-96e7-6112-21f5-7e6f4f671de4"],
 " by a detector of efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fb9b61-c0dc-bc9e-2987-0efe1f5153d1"],
 ". Along one run, does watching it purify its state, as measured by the \
length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3222a5a0-f44b-82b2-4f71-3048b20e6207"],
 " of its Bloch vector, and what does an imperfect detector take away?"
}], "Text",
 CellID->746866756,ExpressionUUID->"3de05b27-fe84-b21d-2c28-e1832fa873d4"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f685399-ce3a-5099-7459-2e49e1835e0c"],
 ", the state conditioned on the record follows the It\[OHat] stochastic \
master equation of a ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f52524d-2521-b420-3c6e-13f3f3d22636"],
 " measurement: ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e3f236f-f0eb-6066-59cd-9b1e86fbfc3e"],
 " rotates it, the term ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[ThinSpace]", "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1], 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eaf81e2-cbea-bf9f-5223-c4be38c50738"],
 " dephases it, and the record kicks it through ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox[
     RowBox[{"\[Eta]", "k"}], "TI"]], "(", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], "-", "2", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ")", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b8e9e1f-d9f2-a8bf-51db-0c193db45825"],
 "."
}], "Text",
 CellID->1224287971,ExpressionUUID->"2a372683-304d-edf6-6fd9-951bcbf84a45"],

Cell[TextData[{
 "As an It\[OHat] process for the Bloch vector, It\[OHat]'s lemma for ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a70221c-142f-b720-025a-5b9981e65bf4"],
 " in spherical coordinates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], ",", 
    StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "222c30f1-4d93-dee6-7e1d-ccdeb0c37821"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   StyleBox["r", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb6e1fe-5693-f6ab-5936-9bd806b33585"],
 ", gives the stochastic equation for ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d7a007e-11ba-e2cb-5c39-a2a85b5bd14c"],
 ":"
}], "Text",
 CellID->601390417,ExpressionUUID->"7c4e45e8-1279-8b68-50b0-e1d2d6dae397"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"blochOfPurify", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"m", " ", ".", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"PauliMatrix", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"blochSME", "[", 
    RowBox[{
    "\[CapitalDelta]_", ",", " ", "\[CapitalOmega]_", ",", " ", "k_", ",", 
     " ", "\[Eta]_", ",", " ", "v0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]v", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], ",", " ", 
              RowBox[{"y", "[", "t", "]"}], ",", " ", 
              RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", ".", " ", 
            RowBox[{"PauliMatrix", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
          ")"}], "/", "2"}]}], ",", " ", 
       RowBox[{"hv", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
          RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
          RowBox[{"PauliMatrix", "[", "1", "]"}]}]}]}], ",", " ", 
       RowBox[{"sz", " ", "=", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ItoProcess", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"blochOfPurify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"hv", " ", ".", " ", "\[Rho]v"}], " ", "-", " ", 
              RowBox[{"\[Rho]v", " ", ".", " ", "hv"}]}], ")"}]}], " ", "+", 
           " ", 
           RowBox[{"k", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sz", " ", ".", " ", "\[Rho]v", " ", ".", " ", "sz"}], 
              " ", "-", " ", "\[Rho]v"}], ")"}]}]}], "]"}], ",", "\n", 
         "     ", 
         RowBox[{"List", " ", "/@", " ", 
          RowBox[{"blochOfPurify", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"\[Eta]", " ", "k"}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sz", " ", ".", " ", "\[Rho]v"}], " ", "+", " ", 
              RowBox[{"\[Rho]v", " ", ".", " ", "sz"}], " ", "-", " ", 
              RowBox[{"2", " ", 
               RowBox[{"z", "[", "t", "]"}], " ", "\[Rho]v"}]}], ")"}]}], 
           "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
         "v0"}], "}"}], ",", " ", "t"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"drSph", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"blochSME", "[", 
        RowBox[{
        "\[CapitalDelta]", ",", " ", "\[CapitalOmega]", ",", " ", "k", ",", 
         " ", "\[Eta]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "]"}], "[", 
       RowBox[{"\"\<Derivative\>\"", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], "]"}]}], "]"}], " ", "/.",
       "\n", "    ", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], ",", " ", 
          RowBox[{"y", "[", "t", "]"}], ",", " ", 
          RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", "->", " ", 
        RowBox[{"r", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], "]"}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "\[Pi]"}], " ", "&&",
       " ", 
      RowBox[{"k", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<=", " ", "\[Eta]", " ", "<=", " ", "1"}], " ", "&&",
       " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", " ", "\[CapitalOmega]"}], "}"}], " ", 
       "\[Element]", " ", "Reals"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<dr = \>\"", ",", " ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"drSph", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", 
    " ", "\"\< dt + \>\"", ",", " ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{
      RowBox[{"drSph", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], " ", "/.", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], " ", "+", " ", 
        RowBox[{"r", "^", "2"}]}], " ", "->", " ", 
       RowBox[{"-", 
        RowBox[{"HoldForm", "[", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"r", "^", "2"}]}], "]"}]}]}]}], "]"}], ",", 
    " ", "\"\< dW\>\""}], "}"}], "]"}]}], "Input",
 CellLabel->"In[11]:= ",
 CellID->809048352,ExpressionUUID->"30de7724-b0ac-db78-7d13-9c1ca5d18161"],

Cell[TextData[{
 "For each detector efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d882081-235b-2a01-2e3b-47438ecaf04d"],
 ", three runs start from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.3", ",", "0", ",", "0.4"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5faea229-48e0-111f-13ac-a10d9145d365"],
 " under a resonant drive of strength ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "/", 
   StyleBox["k", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b86632a-1640-86d3-434d-49d05d48194e"],
 ", ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7074dd-5d61-8c17-6fed-d12594acb36e"],
 " and ",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b5795ac-d5cf-9ffd-64d4-64377acb33b9"],
 "; the dashed line marks ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18028e1a-2b02-a89a-19e9-5da4b1ca5f59"],
 ", where the drift changes sign, and time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26393077-f7d7-77ce-53ec-5ebb70de74e0"],
 ":"
}], "Text",
 CellID->1424578159,ExpressionUUID->"76a912d9-e30f-972a-3b2c-a51336de7b32"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"panelPurify", "[", 
    RowBox[{"\[Eta]v_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[CapitalOmega]v_", ",", " ", "\[CapitalDelta]v_"}], "}"}], ",",
      " ", "label_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
       "\n", "     ", 
       RowBox[{
        RowBox[{"RandomFunction", "[", 
         RowBox[{
          RowBox[{"blochSME", "[", 
           RowBox[{
           "\[CapitalDelta]v", ",", " ", "\[CapitalOmega]v", ",", " ", "1", ",",
             " ", "\[Eta]v", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0.3", ",", " ", "0", ",", " ", "0.4"}], "}"}]}], "]"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "4.", ",", " ", "0.001"}], "}"}], ",", " ",
           "3", ",", " ", 
          RowBox[{
          "Method", " ", "->", 
           " ", "\"\<StochasticRungeKuttaScalarNoise\>\""}]}], "]"}], 
        "[", "\"\<Paths\>\"", "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", " ", "Dashed"}], 
             "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"y", ",", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{
                RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", " ", "Dashed"}],
                "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"y", ",", " ", "0.2", ",", " ", "1", ",", " ", "0.2"}], 
             "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[Eta]v", "]"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Gray", ",", " ", "Dashed", ",", " ", 
              RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], 
           "}"}]}], "]"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k t\>\"", ",", " ", "\"\<r\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "label"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"purifyDrives", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", 
       " ", "\"\<\[CapitalOmega]/k = 0\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", 
       " ", "\"\<\[CapitalOmega]/k = 1\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "0"}], "}"}], ",", 
       " ", "\"\<\[CapitalOmega]/k = 5\>\""}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"purifyPanels", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"\[Eta]v", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"panelPurify", "[", 
            RowBox[{"\[Eta]v", ",", " ", "##"}], "]"}], " ", "&"}], " ", "@@@",
           " ", "purifyDrives"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", " ", "0.8", ",", " ", "1"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Legended", "[", 
    RowBox[{
     RowBox[{"PlotGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"purifyPanels", "[", "purifyEta", "]"}], "}"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
            RowBox[{"Range", "[", "3", "]"}]}], ",", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<run 1\>\"", ",", " ", "\"\<run 2\>\"", ",", 
           " ", "\"\<run 3\>\"", ",", " ", 
           RowBox[{"TraditionalForm", "[", 
            RowBox[{"HoldForm", "[", 
             RowBox[{"r", " ", "==", " ", 
              RowBox[{"Sqrt", "[", "\[Eta]", "]"}]}], "]"}], "]"}]}], "}"}], ",",
          " ", 
         RowBox[{"LegendLayout", " ", "->", " ", "\"\<Row\>\""}]}], "]"}], ",",
        " ", "Below"}], "]"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"purifyEta", ",", " ", "1", ",", " ", "\"\<\[Eta]\>\""}], "}"}],
      ",", " ", 
     RowBox[{"Keys", "[", "purifyPanels", "]"}], ",", " ", "SetterBar"}], 
    "}"}], ",", " ", 
   RowBox[{"SaveDefinitions", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[12]:= ",
 CellID->1939109630,ExpressionUUID->"47a9312a-7fcc-0617-1c05-ef50258cbcd0"],

Cell[TextData[{
 "Neither term contains ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2555cb1d-545a-edb0-238f-8c0a328c6232"],
 " or ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bf4858f-d61a-f980-2ec4-87abbccfa316"],
 ": the Hamiltonian only rotates the Bloch vector. The drift is positive \
inside ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c2b53c0-c869-89b3-65ba-160e53c360a7"],
 " and the noise vanishes at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5eb09038-1e1f-6e24-0cc9-aea4b8922cd1"],
 ", so at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fdccd1-2803-2b4b-406d-74296819635f"],
 " every run climbs to the surface and stays there: a mixed state purifies \
and a pure state stays pure. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db5b423-1d92-0805-23f1-9017ea285c56"],
 " the drift at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126431b7-cd87-e0e1-429b-ea3fd687c6d5"],
 " is negative except at the poles, so without a drive the runs purify by \
reaching a pole, a drive comparable to ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4885014a-f7c7-269f-7b97-e48526774601"],
 " lets them reach the poles only part of the time, and a strong drive keeps \
them off the poles and below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb227c3-670d-b794-25e7-c36e3645f716"],
 "."
}], "Text",
 CellID->2057835071,ExpressionUUID->"7e46eb6a-0159-b5e0-5ed9-a633ce2acd0b"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1757108918,ExpressionUUID->"3590c876-fd83-3554-1133-46d577a83e45"],

Cell["\<\
A monitored qubit stays in the Bloch ball: It\[OHat]'s lemma on the sphere\
\>", "Subsection",
 CellID->682077713,ExpressionUUID->"2d42a09f-9211-65b3-6782-eb6a4432aa13"],

Cell[TextData[{
 "A qubit is Rabi-driven at frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20c808a6-321e-6db8-38dd-3ae41ec48e78"],
 ", relaxes toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62653187-3565-ebc9-6c16-06974f8b4e4b"],
 " at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "748fb0eb-2d69-2e9f-11e1-e30c9f521e9b"],
 ", dephases at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f92c6ab-f457-86e2-70e3-e6d52f75a814"],
 ", and is read out along ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13a5e134-c28f-0496-779d-ba8f616e0ff9"],
 " by a detector that dephases it at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fabeb2d-f223-6406-659f-aaf85651b4c8"],
 " and whose noise enters ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71d17dc0-d3a1-dfdb-4f98-d1403bc30c88"],
 " at the informational rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ceea9b7-e6ff-460f-75ec-2a7b6f565875"],
 " and rotates the phase at the back-action rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e7c5dc-5c2e-8d09-3f81-125bf0bc2b30"],
 "; its efficiency is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]], "+", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox["d", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5644f1d1-2941-91bc-11d4-0175b788f57e"],
 ". Does every run stay a density matrix, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d864aaa-abe0-6f7a-66a8-e7cd36167072"],
 ", for every choice of rates?"
}], "Text",
 CellID->1529757074,ExpressionUUID->"652f8140-6c08-57c6-2fca-4cb6f55980ca"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c78a486-4656-764b-0304-af61bc8c0285"],
 " and one Wiener noise ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05966a34-ab43-68bd-14ab-cfad1add60bc"],
 ", the Bloch vector obeys the It\[OHat] equations"
}], "Text",
 CellID->1701455113,ExpressionUUID->"792195d8-021f-ad00-5ac9-872cf3094503"],

Cell[BoxData[
 PaneBox[GridBox[{
    {
     StyleBox[
      RowBox[{"d", "x"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"-", "(", 
       RowBox[{
        FractionBox[
         SubscriptBox[
          StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", 
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], 
         StyleBox["\[Phi]", "TI"]], "+", 
        SubscriptBox["\[CapitalGamma]", 
         StyleBox["d", "TI"]]}], ")", 
       StyleBox["x", "TI"], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "-", "(", 
       RowBox[{
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["x", "TI"], 
        StyleBox["z", "TI"], "+", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"B", "A"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["y", "TI"]}], ")", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]},
    {
     StyleBox[
      RowBox[{"d", "y"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"[", 
       RowBox[{"-", "(", 
        RowBox[{
         FractionBox[
          SubscriptBox[
           StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", 
         SubscriptBox[
          StyleBox["\[Gamma]", "TI"], 
          StyleBox["\[Phi]", "TI"]], "+", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["d", "TI"]]}], ")", 
        StyleBox["y", "TI"], "-", "\[CapitalOmega]", 
        StyleBox["z", "TI"]}], "]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "-", "(", 
       RowBox[{
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["y", "TI"], 
        StyleBox["z", "TI"], "-", 
        SqrtBox[
         SubscriptBox["\[CapitalGamma]", 
          StyleBox[
           RowBox[{"B", "A"}], "TI"]]], "\[ThinSpace]", 
        StyleBox["x", "TI"]}], ")", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]},
    {
     StyleBox[
      RowBox[{"d", "z"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], "1"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         StyleBox["z", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1], "+", "\[CapitalOmega]", 
        StyleBox["y", "TI"]}], "]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "+", 
       SqrtBox[
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["z", "TI"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], "."}]}
   },
   GridBoxAlignment->{"Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1263725061,ExpressionUUID->"669b8daf-8687-ac42-2a1c-e90b385c41f9"],

Cell[TextData[{
 "It\[OHat]'s lemma for ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1301aa98-0246-7dc9-59ba-6c241a43d10e"],
 " on the sphere ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "008297f7-7991-4003-52f3-2204f8084595"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox[
      StyleBox["z", "TI"], "2"]}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}], ",", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "\[CurlyPhi]"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a71c0ad-ae8f-a4ef-59dd-a14074723c69"],
 ", gives the noise of ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28ef6821-141a-2c1e-79f8-ff9d0bac24b3"],
 " there and the efficiencies for which its drift points outward somewhere:"
}], "Text",
 CellID->1953622044,ExpressionUUID->"099e7280-59de-6f85-2052-d1392ad1357e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"monitoredQubit", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
             "\[Gamma]\[CurlyPhi]", " ", "+", " ", "\[CapitalGamma]d"}], 
            ")"}]}], " ", 
          RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
              "\[Gamma]\[CurlyPhi]", " ", "+", " ", "\[CapitalGamma]d"}], 
             ")"}]}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"z", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"x", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"y", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"y", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"x", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], ")"}]}], "}"}]}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "}"}], ",", 
     " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r2Drift", ",", " ", "r2Noise"}], "}"}], " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"monitoredQubit", "[", 
        RowBox[{"\"\<Derivative\>\"", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"z", "[", "t", "]"}], "^", "2"}]}]}], "]"}], "]"}], " ", "/.",
       "\n", "     ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"z", "^", "2"}]}], "]"}], " ", 
          RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], " ", "->", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"z", "^", "2"}]}], "]"}], " ", 
          RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"z", "[", "t", "]"}], " ", "->", " ", "z"}], ",", " ", 
        RowBox[{"\[CapitalGamma]BA", " ", "->", " ", 
         RowBox[{
          RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]d"}], " ", "-", 
          " ", "\[CapitalGamma]CI"}]}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ballOutwardCondition", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Reduce", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exists", "[", 
         RowBox[{"z", ",", " ", 
          RowBox[{
           RowBox[{"-", "1"}], " ", "<", " ", "z", " ", "<", " ", "1"}], ",", 
          " ", 
          RowBox[{"r2Drift", " ", ">", " ", "0"}]}], "]"}], " ", "&&", " ", 
        RowBox[{"\[CapitalGamma]d", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
        
        RowBox[{"\[Gamma]1", " ", ">=", " ", "0"}]}], ",", " ", "\[Eta]", ",",
        " ", "Reals"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalGamma]d", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
      RowBox[{"\[Gamma]1", " ", ">=", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TraditionalForm", "[", 
  RowBox[{
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<noise of r\.b2 on the sphere\>\"", " ", "->", " ", 
      "r2Noise"}], ",", " ", 
     RowBox[{"\"\<drift outward somewhere\>\"", " ", "->", " ", 
      "ballOutwardCondition"}]}], "|>"}], " ", "/.", "\n", "   ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalGamma]d", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[CapitalGamma]", ",", " ", "\"\<d\>\""}], "]"}]}], ",", " ", 
     
     RowBox[{"\[Gamma]\[CurlyPhi]", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Gamma]", ",", " ", "\"\<\[CurlyPhi]\>\""}], "]"}]}], ",", 
     " ", 
     RowBox[{"\[Gamma]1", " ", "->", " ", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Gamma]", ",", " ", "1"}], "]"}]}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[13]:= ",
 CellID->789879331,ExpressionUUID->"6b8eb580-7f46-8e74-2ddd-4bd0924bfaad"],

Cell[TextData[{
 "Three runs start from the mixed state ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.3", ",", "0", ",", "0.3"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da00aaf-9c0b-b501-0d63-7a9733859b72"],
 ", with ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c6beb28-90ae-24c2-005b-fb9f73d873f3"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "0.2", "\[ThinSpace]", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "213d13e7-241e-911d-1120-a220411c2928"],
 ", no extra dephasing, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70cd826d-334f-ae28-4024-b838c8b5c026"],
 ", and the detector noise split equally, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "=", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "=", 
   StyleBox["\[Eta]", "TI"], 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a157b74-8e18-dd8f-5f99-593ecdae5849"],
 ". Each panel plots the Bloch vector length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18c042de-f675-9b06-2df7-8a403499253d"],
 " for one efficiency, with the region ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], ">", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "474d3373-0f51-5d08-01a6-2c95536def43"],
 ", where ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5289520b-ddc1-33ab-5c5f-d26d707e1f49"],
 " is not a density matrix, shaded; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b2b348b-032d-b21f-1595-c5bd8be46209"],
 ":"
}], "Text",
 CellID->500411642,ExpressionUUID->"08c73bbf-f662-8e75-7f2e-5bb142ca5d21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ballEtas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", " ", "1", ",", " ", "3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ballRun", "[", "\[Eta]v_", "]"}], " ", ":=", " ", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], " ", "&"}], ",", 
       "\n", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomFunction", "[", 
          RowBox[{
           RowBox[{"monitoredQubit", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Gamma]1", " ", "->", " ", "0.2"}], ",", " ", 
              RowBox[{"\[Gamma]\[CurlyPhi]", " ", "->", " ", "0"}], ",", " ", 
              
              RowBox[{"\[CapitalGamma]d", " ", "->", " ", "1"}], ",", " ", 
              RowBox[{"\[CapitalOmega]", " ", "->", " ", "2"}], ",", " ", 
              RowBox[{"\[CapitalGamma]CI", " ", "->", " ", "\[Eta]v"}], ",", 
              " ", 
              RowBox[{"\[CapitalGamma]BA", " ", "->", " ", "\[Eta]v"}], ",", 
              " ", 
              RowBox[{"x0", " ", "->", " ", "0.3"}], ",", " ", 
              RowBox[{"y0", " ", "->", " ", "0"}], ",", " ", 
              RowBox[{"z0", " ", "->", " ", "0.3"}]}], "}"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0.", ",", " ", "5.", ",", " ", "0.001"}], "}"}], ",", 
           " ", "3", ",", "\n", "       ", 
           RowBox[{
           "Method", " ", "->", 
            " ", "\"\<StochasticRungeKuttaScalarNoise\>\""}]}], "]"}], 
         "[", "\"\<Paths\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{";;", " ", ";;", " ", "5"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.6"}], "}"}]}], ",", " ", 
     RowBox[{"Prolog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.88", "]"}], ",", " ", 
        RowBox[{"Rectangle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "1.6"}], "}"}]}], "]"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"GridLines", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", "1", "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<not a density matrix\>\"", ",", " ", "Gray", ",", " ",
             "11"}], "]"}], ",", " ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.95"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Eta] = \>\"", ",", " ", "\[Eta]v"}], "}"}], "]"}], 
          ",", " ", 
          RowBox[{"Scaled", "[", 
           RowBox[{"{", 
            RowBox[{"0.97", ",", " ", "0.06"}], "}"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"Right", ",", " ", "Bottom"}], "}"}]}], "]"}]}], "}"}]}], ",",
      "\n", "    ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], "]"}],
            ",", " ", "\"\< t\>\""}], "}"}], "]"}], ",", 
        " ", "\"\<Bloch vector length r\>\""}], "}"}]}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ballRun", " ", "/@", " ", "ballEtas"}], "}"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]}], "]"}]}], "Input",\

 CellLabel->"In[14]:= ",
 CellID->1708147932,ExpressionUUID->"77336237-6661-cea2-49ee-348213c002e1"],

Cell[TextData[{
 "The measurement does two things to the Bloch vector: it dephases the qubit \
at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a6488ed-54f7-cf83-429b-6ac50fa4a7ac"],
 ", which pulls the state inward, and each update from the record pushes it \
toward purity, at a rate set by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1698a84a-d57b-e173-299a-6dd961613ecd"],
 ". On the sphere the kicks only slide the state along it, so the drift \
decides, and it points outward somewhere exactly when the information outruns \
the disturbance, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], ">", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138b241f-7c7f-81a4-5ad6-9b56547431c3"],
 ", whatever the drive and the relaxation. A real detector has ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a4f04b1-1bc4-7245-303d-111c7c740d84"],
 ", so the runs at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c947ac-c05f-3c9d-65cc-f8164e3eb2ed"],
 " and ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a23a68b-2b18-9df6-3db0-39b4c00322cd"],
 " stay in the ball, while ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb20c24-705c-9fdf-4938-440597f142ac"],
 ", a detector that would learn more than it disturbs, drives them out. Extra \
dephasing ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2587477b-91fa-bff4-4226-cda6ffdef601"],
 " disturbs without informing, so it only widens the margin."
}], "Text",
 CellID->291071734,ExpressionUUID->"4a0746c4-36e4-3800-615f-4ee25f3b41a0"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1086620463,ExpressionUUID->"6d13c79e-0de2-322b-68c7-02659005f446"],

Cell["When the readout record fixes the population", "Subsection",
 CellID->270036435,ExpressionUUID->"0225cd53-f5a9-0369-1677-44d72c605a78"],

Cell[TextData[{
 "A qubit, Rabi-driven at frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c92198-e19d-eb9c-6f5a-9a64796fbb0c"],
 " and relaxing toward ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3594315e-57b0-40ef-2ff7-e8fdb9f45a7e"],
 " at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71361715-986d-f22b-065a-be280519bc86"],
 ", is read out along ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5be1ea5d-76fc-b420-2ed8-ad6fa4ea8b4c"],
 "; the detector dephases it at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2101dd84-a9d2-44cc-719b-e6da68e2b737"],
 ", its noise moves ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d9ae824-9389-648b-76e5-e69e5e9ac3a2"],
 " at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b991a85-2f67-1572-6c8c-22cd05ba98cb"],
 " and the phase at rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5389b352-98b5-d7fa-435c-352fab64526b"],
 ", and ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604f80d2-a37c-42ca-16a6-bae9c97e6b64"],
 " is the integrated readout. Is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", "(", 
   RowBox[{
    StyleBox["arctanh",
     FontSlant->"Plain"], 
    SubscriptBox[
     StyleBox["z", "TI"], "0"], "+", 
    SqrtBox[
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
    StyleBox["Q", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521c37cd-4db9-5c88-408e-467cf059da60"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["z", "TI"], "0"], "=", 
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5daebc21-1c7a-f60a-45d3-5d0b9ee6f2b9"],
 ", on every run?"
}], "Text",
 CellID->1642556927,ExpressionUUID->"66bc5df4-77dd-4ab2-0a5b-ee3ab6084e5c"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac21376-ae81-61df-2c92-acbdb08be64f"],
 ", the population and the readout obey the It\[OHat] equations, driven by \
one Wiener noise ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0091939a-14fb-2614-14c5-64d2f03bf370"],
 ","
}], "Text",
 CellID->773882931,ExpressionUUID->"26b0c182-5f17-8482-1ea5-cf00cf2211b6"],

Cell[BoxData[
 PaneBox[GridBox[{
    {
     StyleBox[
      RowBox[{"d", "z"}], "TI"], 
     RowBox[{"=", 
      RowBox[{"[", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Gamma]", "TI"], "1"], 
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{"1", "-", 
         StyleBox["z", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1], "+", "\[CapitalOmega]", 
        StyleBox["y", "TI"]}], "]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "+", 
       SqrtBox[
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["z", "TI"], "2"]}], 
       StyleBox[")",
        SpanMaxSize->1], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]},
    {
     StyleBox[
      RowBox[{"d", "Q"}], "TI"], 
     RowBox[{"=", 
      RowBox[{
       SqrtBox[
        SubscriptBox["\[CapitalGamma]", 
         StyleBox[
          RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
       StyleBox["z", "TI"], "\[ThinSpace]", 
       StyleBox["d", "TI"], 
       StyleBox["t", "TI"], "+", 
       StyleBox["d", "TI"], 
       StyleBox["W", "TI"]}], ","}]}
   },
   GridBoxAlignment->{"Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->24404122,ExpressionUUID->"272d8e22-cd3f-0256-0e98-688b9425b57d"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d7a9b20-c294-620e-7513-772e8cbc7cf3"],
 ", ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c15e7f7-11c4-29a8-5a47-d1b07d3a0f24"],
 " follow the Bloch equations. The It\[OHat] derivative of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arctanh",
    FontSlant->"Plain"], 
   StyleBox["z", "TI"], "-", 
   SqrtBox[
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]]], "\[ThinSpace]", 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ad8e5fa-d850-dee6-0e5b-4a3c870e5171"],
 ", for general rates, is:"
}], "Text",
 CellID->1896186496,ExpressionUUID->"22e71a03-1c32-867c-488f-8a1d1ec9a011"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"readoutV0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.8", ",", " ", "0", ",", " ", 
     RowBox[{"-", "0.6"}], ",", " ", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readoutIto", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
             "\[CapitalGamma]d"}], ")"}]}], " ", 
          RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
              "\[CapitalGamma]d"}], ")"}]}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"z", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
          RowBox[{"z", "[", "t", "]"}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"x", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"y", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"y", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"x", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], ")"}]}], "}"}], ",",
          " ", 
         RowBox[{"{", "1", "}"}]}], "}"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "q"}], "}"}], ",",
        " ", "readoutV0"}], "}"}], ",", " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readoutStrat", " ", "=", " ", 
   RowBox[{"StratonovichProcess", "[", "readoutIto", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"readoutGap", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"readoutIto", "[", 
      RowBox[{"\"\<Derivative\>\"", ",", " ", 
       RowBox[{
        RowBox[{"ArcTanh", "[", 
         RowBox[{"z", "[", "t", "]"}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
         RowBox[{"q", "[", "t", "]"}]}]}]}], "]"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], " ", "->", " ", "x"}], ",", " ", 
       RowBox[{
        RowBox[{"y", "[", "t", "]"}], " ", "->", " ", "y"}], ",", " ", 
       RowBox[{
        RowBox[{"z", "[", "t", "]"}], " ", "->", " ", "z"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<d(arctanh z \[Minus] \>\"", ",", " ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<CI\>\""}], "]"}], 
      "]"}], "]"}], ",", " ", "\"\< Q) = (\>\"", ",", "\n", "   ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"readoutGap", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]1", ",", " ", "\[CapitalOmega]"}], "}"}], ",", " ", 
        "Simplify"}], "]"}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Gamma]1", " ", "->", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}]}], ",", " ", 
        RowBox[{"\[CapitalGamma]d", " ", "->", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
          "]"}]}]}], "}"}]}], "]"}], ",", " ", "\"\<) dt + \>\"", ",", "\n", 
    "   ", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"readoutGap", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", 
    " ", "\"\< dW\>\""}], "}"}], "]"}]}], "Input",
 CellLabel->"In[15]:= ",
 CellID->1177856204,ExpressionUUID->"488b5ecc-aeff-3761-1c6c-a1654737f0da"],

Cell[TextData[{
 "Integration along a smooth path converges to the Stratonovich solution, so \
all four equations are put in Stratonovich form and integrated on one cubic \
interpolant of a sampled Wiener path, the same in every panel, from ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0.8", ",", "0", ",", 
    RowBox[{"-", "0.6"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "449b8627-672c-c674-19e9-201ea0cb3ba3"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"C", "I"}], "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "=", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     RowBox[{"B", "A"}], "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50819089-9057-39f2-0e4f-5b9e543ff5aa"],
 ". Each panel compares ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd91990-093a-cd47-633c-fc440d628858"],
 " with the formula built from the record; time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60a37f48-2099-2a7a-63a7-b346f8b2f611"],
 ":"
}], "Text",
 CellID->104431095,ExpressionUUID->"658fede7-1084-a3a2-2765-6c9cea71d000"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"smoothWiener", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "5", "]"}], ";", " ", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subdivide", "[", 
           RowBox[{"0.", ",", " ", "4.", ",", " ", "400"}], "]"}], ",", "\n", 
          "      ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Accumulate", "[", 
             RowBox[{"RandomVariate", "[", 
              RowBox[{
               RowBox[{"NormalDistribution", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{"Sqrt", "[", "0.01", "]"}]}], "]"}], ",", " ", 
               "400"}], "]"}], "]"}], ",", " ", "0."}], "]"}]}], "}"}], "]"}],
        ",", " ", 
       RowBox[{"InterpolationOrder", " ", "->", " ", "3"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelTanh", "[", 
    RowBox[{"\[CapitalOmega]v_", ",", " ", "g1_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rates", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[CapitalGamma]d", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\[CapitalGamma]CI", " ", "->", " ", "0.5"}], ",", " ", 
         RowBox[{"\[CapitalGamma]BA", " ", "->", " ", "0.5"}], ",", " ", 
         RowBox[{"\[CapitalOmega]", " ", "->", " ", "\[CapitalOmega]v"}], ",",
          " ", 
         RowBox[{"\[Gamma]1", " ", "->", " ", "g1"}]}], "}"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", " ", "=", " ", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", "[", "t", "]"}], ",", " ", 
                   RowBox[{"y", "[", "t", "]"}], ",", " ", 
                   RowBox[{"z", "[", "t", "]"}], ",", " ", 
                   RowBox[{"q", "[", "t", "]"}]}], "}"}], ",", " ", "t"}], 
                "]"}], " ", "==", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"readoutStrat", "[", "\"\<Drift\>\"", "]"}], " ", "+",
                   " ", 
                  RowBox[{
                   RowBox[{"Flatten", "[", 
                    RowBox[{"readoutStrat", "[", "\"\<Diffusion\>\"", "]"}], 
                    "]"}], " ", 
                   RowBox[{
                    RowBox[{"smoothWiener", "'"}], "[", "t", "]"}]}]}], " ", "/.",
                  " ", "rates"}], ")"}]}], "]"}], ",", "\n", "        ", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", "[", "0", "]"}], ",", " ", 
                 RowBox[{"y", "[", "0", "]"}], ",", " ", 
                 RowBox[{"z", "[", "0", "]"}], ",", " ", 
                 RowBox[{"q", "[", "0", "]"}]}], "}"}], " ", "==", " ", 
               "readoutV0"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"z", ",", " ", "q"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
           RowBox[{"MaxStepSize", " ", "->", " ", "0.0025"}]}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"sol", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", "s", "]"}], ",", " ", 
             RowBox[{"Tanh", "[", 
              RowBox[{
               RowBox[{"ArcTanh", "[", 
                RowBox[{"readoutV0", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
                RowBox[{
                 RowBox[{"sol", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", "s", "]"}]}]}], 
              "]"}]}], "}"}], " ", "/.", " ", "rates"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], ",", "\n", "     ", 
         
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
                "]"}], ",", " ", "\"\< t\>\""}], "}"}], "]"}], ",", 
            " ", "\"\<z\>\""}], "}"}]}], ",", "\n", "     ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[CapitalOmega]/\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
              "]"}], ",", " ", "\"\< = \>\"", ",", " ", "\[CapitalOmega]v", ",",
              " ", "\"\<,   \>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "1"}], "]"}], ",", 
             " ", "\"\</\>\"", ",", " ", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<d\>\""}], 
              "]"}], ",", " ", "\"\< = \>\"", ",", " ", "g1"}], "}"}], 
           "]"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Legended", "[", 
  RowBox[{
   RowBox[{"PlotGrid", "[", 
    RowBox[{
     RowBox[{"Outer", "[", 
      RowBox[{"panelTanh", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0.5"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "500"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"LineLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}], ",", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "[", "2", "]"}], ",", " ", 
           "Dashed"}], "]"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"\"\<z(t)\>\"", ",", " ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<tanh(arctanh \>\"", ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\"\<z\>\"", ",", " ", "\"\<0\>\""}], "]"}], ",", 
            " ", "\"\< + \>\"", ",", " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"Subscript", "[", 
              RowBox[{"\"\<\[CapitalGamma]\>\"", ",", " ", "\"\<CI\>\""}], 
              "]"}], "]"}], ",", " ", "\"\< Q(t))\>\""}], "}"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"LegendLayout", " ", "->", " ", "\"\<Column\>\""}]}], "]"}], ",",
      " ", "Right"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[16]:= ",
 CellID->497190960,ExpressionUUID->"4b952bdc-0798-c6aa-6525-b14c656e093f"],

Cell[TextData[{
 "The noise term is zero for every rate, and the drift vanishes when ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "298c7de4-01d2-c0d1-05de-d999fe1b030e"],
 ": then the record alone fixes ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d9795f9-c390-c94c-4218-77069dd52d79"],
 " on every run, and the two curves coincide. A drive or relaxation moves ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6105793e-8844-b35b-061f-6a7099f20d6f"],
 " without writing it into the record, and the curves part."
}], "Text",
 CellID->1702078563,ExpressionUUID->"21f8186d-e8ac-d71e-626d-2aaab5b150e8"],

