        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "**", " ", "#"}], " ", "-", " ", "1"}], " ", 
          "&"}], " ", "/@", " ", "wsyGens"}], ")"}]}]}], "|>"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"wsyStab", " ", "=", " ", 
