          RowBox[{"{", "z0", "}"}], ",", " ", "None"}], "}"}]}], ",", " ", 
       RowBox[{"GridLinesStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", " ", "Dashed"}], "]"}]}], ",", " ", 
