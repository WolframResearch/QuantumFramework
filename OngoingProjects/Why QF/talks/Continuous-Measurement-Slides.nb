                " ", "\"\<)\>\""}], "}"}], "]"}]}], "}"}]}], "]"}], ",", "\n",
          "    ", 
         RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"FrameStyle", " ", "->", " ", 
