 RowBox[{
  RowBox[{
   RowBox[{"wsyTr", "[", "w_", "]"}], " ", ":=", " ", 
   RowBox[{"8", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"NonCommutativeExpand", "[", 
