Cell[TextData[{
 "The quantum part queries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["a", "TI"], 
   StyleBox["G", "TI"], "+", 
   StyleBox["b", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " on two ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 "-qubit registers, measures the point register, and Fourier-transforms both \
input registers. Simulate it exactly: one indicator array per curve point, a \
2D Fourier transform of each, probabilities summed over points:"
}], "Text",
 CellID->1208764476,ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"elts", " ", "=", " ", 
   RowBox[{"Prepend", "[", 
    RowBox[{"pts", ",", " ", "O"}], "]"}]}], ";", " ", 
  RowBox[{"idx", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"elts", " ", "->", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"r", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t", " ", "=", " ", "7"}], ";", " ", 
  RowBox[{"nn", " ", "=", " ", 
   RowBox[{"2", "^", "t"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"idx", "[", 
      RowBox[{
       RowBox[{"ec", "[", "\"\<Add\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
         RowBox[{"G", ",", " ", "a"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
         RowBox[{"Q", ",", " ", "b"}], "]"}]}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", 
       RowBox[{"nn", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", 
       RowBox[{"nn", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probs", " ", "=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Fourier", "[", 
          RowBox[{
           RowBox[{"Boole", "[", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", "==", " ", "w"}], " ", "&"}], ",", " ", "f", 
              ",", " ", 
              RowBox[{"{", "2", "}"}]}], "]"}], "]"}], ",", " ", 
           RowBox[{"FourierParameters", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "]"}], "^", "2"}], ",", 
       "\n", "      ", 
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "0", ",", " ", 
         RowBox[{"r", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}], "/", 
    RowBox[{"nn", "^", "2"}]}]}], ";"}]}], "Input",
 CellLabel->"In[64]:= ",
 CellID->1584634344,ExpressionUUID->"6e766a94-5ec6-6187-160d-83de5b7333ed"],

Cell[TextData[{
 "Each measured pair ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eead67c-41e5-1519-56e9-c82677907c63"],
 " sits near ",
