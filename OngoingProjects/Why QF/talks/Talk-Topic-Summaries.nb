Cell[BoxData[{
 RowBox[{
  RowBox[{"codeProj", " ", "=", " ", 
   RowBox[{"First", "[", "proj", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cs", " ", "=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"op3", "[", 
        RowBox[{"X", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Range", "[", "3", "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"codeProj", " ", ".", " ", "#"}], " ", "-", " ", 
        RowBox[{"#", " ", ".", " ", "codeProj"}]}], ")"}]}], " ", "&"}], " ", 
    "/@", " ", "cs"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Simplify", "@", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
          RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cs", ",", " ", "F"}], "}"}]}], "]"}]}]}]}], ",", "\n", " ", 
   
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", " ", ".", " ", "codeProj"}], ")"}], " ", "&"}], " ", "/@",
        " ", 
       RowBox[{"(", 
        RowBox[{"cs", " ", "-", " ", 
         RowBox[{"I", " ", "F"}]}], ")"}]}], "]"}]}]}]}], "}"}]}], "Input",
 CellLabel->"In[8]:= ",
 CellID->1541450781,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

