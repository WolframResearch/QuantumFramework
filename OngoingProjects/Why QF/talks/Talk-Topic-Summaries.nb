                RowBox[{
                 RowBox[{"#", "^", "2"}], ",", " ", "p"}], "]"}], " ", "==", 
               " ", "rhs"}], " ", "&"}]}], "]"}]}], "}"}], "]"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
