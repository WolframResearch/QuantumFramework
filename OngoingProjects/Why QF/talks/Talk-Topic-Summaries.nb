    StyleBox["j", "TI"], ",", 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   SuperscriptBox["2", 
    StyleBox["t", "TI"]], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a655ec-dad2-e192-515e-4cc9df64b3f8"],
 ", so whenever ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],
 " is invertible mod ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 " the key is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["l", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{"-", "1"}]], 
   StyleBox["mod",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 ". Twenty shots:"
}], "Text",
 CellID->35679398,ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"samples", " ", "=", " ", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", "probs", "]"}], " ", "->", " ", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"nn", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}], 
       "]"}]}], ",", " ", "20"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"keyFrom", "[", 
    RowBox[{"{", 
     RowBox[{"c_", ",", " ", "d_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"j", " ", "=", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"r", " ", 
            RowBox[{"c", "/", "nn"}]}], "]"}], ",", " ", "r"}], "]"}]}], ",", 
       " ", 
       RowBox[{"l", " ", "=", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"r", " ", 
            RowBox[{"d", "/", "nn"}]}], "]"}], ",", " ", "r"}], "]"}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"CoprimeQ", "[", 
        RowBox[{"j", ",", " ", "r"}], "]"}], ",", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"l", " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{"j", ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "r"}], "]"}]}], ",", " ", "r"}], 
        "]"}], ",", " ", 
       RowBox[{"Missing", "[", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cands", " ", "=", " ", 
   RowBox[{"keyFrom", " ", "/@", " ", "samples"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"cands", ",", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"DeleteMissing", "@", 
      RowBox[{"DeleteDuplicates", "[", "cands", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ec", "[", "\"\<Mult\>\"", "]"}], "[", 
        RowBox[{"G", ",", " ", "#"}], "]"}], " ", "===", " ", "Q"}], " ", 
      "&"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[65]:= ",
 CellID->1113372800,ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[TextData[{
 "Every usable shot returns 7 and none returns a wrong key: the secret comes \
out of the interference pattern, using ",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d4995f-bb7f-b80c-10eb-11193e0b0b56"],
 " only as a point and never scanning multiples of ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 ". That is the step whose cost Google's circuits bring down to about a \
thousand logical qubits at 256 bits."
}], "Text",
 CellID->969867355,ExpressionUUID->"09661063-a2cf-675e-3f1d-8a4cd77a4da4"],

Cell["\<\
Example 10.2: the resource arithmetic behind the headline numbers\
\>", "Subsection",
 CellID->1210037699,ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell[TextData[{
 "Google's appendix formula for the total Toffoli count at window size ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea91e8-e80e-a1ed-35e9-08b589b8f337"],
 ", with the low-qubit point-addition cost, and the window that minimizes it \
at fixed ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], 
   StyleBox[
    RowBox[{"P", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37725419-c8bf-c4cd-5d02-4e42e94bae17"],
 ":"
}], "Text",
 CellID->1239892393,ExpressionUUID->"6eee5857-8f9d-bf63-1696-52112a290249"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"T", "[", 
    RowBox[{"w_", ",", " ", "n_", ",", " ", "tpa_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"tpa", " ", "+", " ", 
      RowBox[{"3", " ", 
       RowBox[{"2", "^", "w"}]}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"n", "/", "w"}]}], " ", "-", " ", "4"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"T", "[", 
    RowBox[{"16", ",", " ", "256", ",", " ", "2700000"}], "]"}], ",", " ", 
   RowBox[{"First", "@", 
    RowBox[{"MinimalBy", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"4", ",", " ", "24"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"T", "[", 
        RowBox[{"#", ",", " ", "256", ",", " ", "2700000"}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[66]:= ",
 CellID->1498748757,ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell[TextData[{
 "About 81 million Toffolis at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], "=", "16"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3760e9-4a32-92b2-4acd-79b36fc4e098"],
 ", against the reported bound of 90 million, and the optimum window sits at \
17, where the lookup-table cost ",
 Cell[BoxData[
  RowBox[{"3", "\[CenterDot]", 
   SuperscriptBox["2", 
    StyleBox["w", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 " starts to rival the point addition. Blocks arrive as a Poisson process, so \
the chance an on-spend attack of 9 minutes beats the next block is ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "9", "/", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"b", "l", "o", "c", "k"}], "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cf5d11-52cc-ddbb-47f5-555b677ea781"],
 " for Bitcoin, Litecoin, Zcash and Dogecoin:"
}], "Text",
 CellID->1701544389,ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "9"}], "/", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
  " ", 
  RowBox[{"{", 
   RowBox[{"10", ",", " ", "2.5", ",", " ", "1.25", ",", " ", "1"}], 
   "}"}]}]], "Input",
 CellLabel->"In[67]:= ",
