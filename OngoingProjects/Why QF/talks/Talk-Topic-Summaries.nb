    RowBox[{
     RowBox[{"Commutator", "[", 
      RowBox[{"Y", ",", " ", 
       RowBox[{"Commutator", "[", 
        RowBox[{"X", ",", " ", 
         RowBox[{"Commutator", "[", 
          RowBox[{"X", ",", " ", "Y"}], "]"}]}], "]"}]}], "]"}], "/", 
     "24"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ax", " ", "=", " ", 
   RowBox[{"as", " ", ".", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"x", "[", "m", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], ";", 
  " ", 
  RowBox[{"bx", " ", "=", " ", 
   RowBox[{"bs", " ", ".", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"x", "[", "m", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"oplus", " ", "=", " ", 
   RowBox[{"Simplify", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"NonCommutativeExpand", "[", 
          RowBox[{
           RowBox[{"bch4", "[", 
            RowBox[{
             RowBox[{"I", " ", "ax"}], ",", " ", 
             RowBox[{"I", " ", "bx"}]}], "]"}], ",", " ", "algE"}], "]"}], ",",
          " ", 
         RowBox[{"x", "[", "m", "]"}]}], "]"}], "/", "I"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"oplus", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"oplus", " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{"oplus", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"al", " ", "->", " ", "be"}], ",", " ", 
         RowBox[{"be", " ", "->", " ", "al"}]}], "}"}]}], ")"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[59]:= ",
 CellID->1956327387,ExpressionUUID->"46408f14-a324-388b-6e7f-2751d6d68ad1"],

Cell[TextData[{
 "Snyder's sum ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[CirclePlus]", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40213c85-9219-7c2b-71de-b5ef27ac4771"],
 " picks up ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["a", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678faed4-2cca-f411-0db4-479e457cdf7b"],
 " corrections but stays symmetric under ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[LeftRightArrow]", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3cac94-919f-f08d-6ac3-45de202bc2d7"],
 ". The same driver on \[Kappa]-Minkowski, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], "0"], ",", 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["i", "TI"]], "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634a1270-2707-566e-1149-943a52b23cb4"],
 ":"
}], "Text",
 CellID->1131177628,ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"algK", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"x", "[", "m", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
        "}"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Commutator", "[", 
             RowBox[{
              RowBox[{"x", "[", "i", "]"}], ",", " ", 
              RowBox[{"x", "[", "0", "]"}]}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"I", "/", "k"}], " ", 
             RowBox[{"x", "[", "i", "]"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], ",", 
         "\n", "      ", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Commutator", "[", 
             RowBox[{
              RowBox[{"x", "[", "j", "]"}], ",", " ", 
              RowBox[{"x", "[", "i", "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", 
              RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
           "]"}]}]}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "k", "}"}], ",", " ", "as", ",", " ", "bs"}], "]"}]}]}],
      "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"NonCommutativeExpand", "[", 
        RowBox[{
         RowBox[{"bch4", "[", 
          RowBox[{
           RowBox[{"I", " ", "ax"}], ",", " ", 
           RowBox[{"I", " ", "bx"}]}], "]"}], ",", " ", "algK"}], "]"}], ",", 
       " ", 
       RowBox[{"x", "[", "m", "]"}]}], "]"}], "/", "I"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], "Input",\

 CellLabel->"In[60]:= ",
 CellID->611195905,ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell[TextData[{
 "Here time momenta add undeformed but spatial momenta pick up ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Alpha]", "TI"], "0"], 
    SuperscriptBox[
     StyleBox["\[Beta]", "TI"], 
     StyleBox["i", "TI"]], "-", 
    SuperscriptBox[
     StyleBox["\[Alpha]", "TI"], 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     StyleBox["\[Beta]", "TI"], "0"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e8dec7-14b1-519a-7c97-d7a19d4423e0"],
 ", which flips sign under exchange: two Lorentz-compatible deformations with \
different multi-particle physics. Finally the deformed uncertainty relation \
",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["x", "TI"], "\[GreaterEqual]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "\[CapitalDelta]", 
    SuperscriptBox[
     StyleBox["p", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", "\[CapitalDelta]", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f5c72f-3423-741a-538a-de89bdd65f60"],
 " has a floor:"
}], "Text",
 CellID->1202919897,ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"a", " ", ">", " ", "0"}], ",", " ", 
   RowBox[{
    RowBox[{"Minimize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"a", "^", "2"}], " ", 
            RowBox[{"dp", "^", "2"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "dp"}], ")"}]}], ",", " ", 
        RowBox[{"dp", " ", ">", " ", "0"}]}], "}"}], ",", " ", "dp"}], "]"}], 
    " ", "//", " ", "FullSimplify"}]}], "]"}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->1334651244,ExpressionUUID->"6d34e655-b983-17e8-14cb-f81f38367d32"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["min",
     FontSlant->"Plain"]], "=", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],
 " at ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["p", "TI"], "=", "1", "/", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21714cd0-c04e-e57a-570f-659df1f8cc40"],
 ": the algebra's parameter is a length below which no event can be localized."
}], "Text",
 CellID->185339758,ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell["\<\
10. Breaking Elliptic Curve Crypto: Quantum Oracles and Phase Estimation for \
secp256k1\
\>", "Section",
 CellID->1677030473,ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

Cell[TextData[{
 "Source: no ",
 Cell[".md", "InlineCode",ExpressionUUID->
  "7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],
 " for the computation exists. The notebook ",
 Cell["\<\
/Users/mohammadb/Nextcloud/Mads/Quantum/Shor-Google-Security/ShorECDLP-\
Google2026-v4.nb\
\>", "InlineCode",ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"],
 " (2026-04-30, the newest of v1 to v4) was read through an ",
 Cell["nb-reader", "InlineCode",ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 " conversion. The markdown with the matching title, ",
 Cell["\<\
/Users/mohammadb/Nextcloud/Mads/Quantum/Shor-Google-Security/google-quantum-\
crypto-report.md\
\>", "InlineCode",ExpressionUUID->"69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 ", is a guide to Google's paper rather than this computation and was not \
used for the examples."
}], "Text",
 CellID->134345938,ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell[TextData[{
 "Notes for review: ",
 StyleBox["the notebook's quantum step does not solve the discrete logarithm.",
  FontWeight->"Bold"],
 " Its phase-estimation circuit uses only the oracle ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["i", "TI"]},
    "Ket"], "\[Rule]", 
   TemplateBox[{
     RowBox[{
       StyleBox["i", "TI"], "+", 
       StyleBox["G", "TI"]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fec585-b88c-469b-2c85-dcef39392ce1"],
 ", so it recovers the order of ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],
 "; the secret ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e86e5c8-d785-1389-06bd-fc95e23061d3"],
 " is then found by a classical scan over ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"k", "G"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3582ea65-851b-2569-63b1-0c4f2caf8fb3"],
 ". But the order of the secp256k1 generator is published in the standard, so \
this step gives an attacker nothing, and the scan is exactly the hard \
problem. The summary's \"Phase estimation on 15 qubits recovered the secret \
key ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "7"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
 "\" is therefore not what the code does, and the \"Pattern That Carries Over\
\" section's claim that only the group changes between factoring and ECDLP \
needs the two-register correction. Shor's ECDLP algorithm queries ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["a", "TI"], 
   StyleBox["G", "TI"], "+", 
   StyleBox["b", "TI"], 
   StyleBox["Q", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 " on two registers; Fourier sampling returns pairs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[TildeTilde]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], ",", 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CenterDot]", 
   SuperscriptBox["2", 
    StyleBox["t", "TI"]], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647a9320-5a37-336f-0c19-0a8a5fc381b5"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   StyleBox["l", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["j", "TI"], 
    RowBox[{"-", "1"}]], 
   StyleBox["mod",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b40e76-1aa6-da65-7d4b-a0309f50a94f"],
 " follows without ever scanning. Example 10.1 implements that version and \
recovers ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "575b10e3-003a-b957-7d78-89cdb1cc0bbd"],
 " directly. The resource-estimate half of the notebook (Google 2026, \
Oratomic/Caltech, on-spend race) is unaffected; the numbers checked below \
match."
}], "Text",
 CellID->350820043,ExpressionUUID->"7c7345dd-208f-a284-2401-5c87513bf0ee"],

Cell["Summary", "Subsection",
 CellID->456450236,ExpressionUUID->"0121a537-2575-8479-30de-3d714c01ef43"],

Cell["\<\
How close is a quantum computer to stealing a Bitcoin key? The notebook walks \
Shor's algorithm from factoring 15 to the elliptic-curve discrete logarithm \
on a toy curve over GF(23), then reads Google's March 2026 resource estimates \
for secp256k1 and the Oratomic/Caltech neutral-atom compilation.\
\>", "Text",
 CellID->1767337052,ExpressionUUID->"7f325126-465a-e19d-26c2-488073ecb3e7"],

Cell["What should catch a physicist's attention:", "Text",
 CellID->1422053341,ExpressionUUID->"739af998-c5c1-31b3-21b9-f0c5ec758399"],

Cell[TextData[{
 StyleBox["The group is the only thing that changes.",
  FontWeight->"Bold"],
 " Elliptic-curve point addition, defined from scratch with pattern-matched \
dispatch, gives a permutation unitary exactly like modular multiplication in \
factoring; its eigenphases are the 28th roots of unity of the cyclic group of \
order 28."
}], "Item",
 CellID->603286833,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[TextData[{
 StyleBox["Real cryptography in the same language.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"GenerateAsymmetricKeyPair", "[", "\"\<EllipticCurve\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],
 " uses secp256k1 by default, and a signature over the Bitcoin genesis-block \
headline verifies, so the object under attack is the real one."
}], "Item",
 CellID->1349832744,ExpressionUUID->"3873a668-04d7-31ac-6800-3832ad6383f6"],

Cell[TextData[{
 StyleBox["Precision is a theorem, not a tuning knob.",
  FontWeight->"Bold"],
 " Continued fractions recover ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 " only when ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["2", 
    StyleBox["t", "TI"]], "\[GreaterEqual]", "2", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 " (Legendre); in the notebook's exercise, 6 control qubits fail in all 50 \
samples while 10 succeed because favored shots land on the right \
convergents."
}], "Item",
 CellID->16034565,ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell[TextData[{
 StyleBox["What Google actually optimized.",
  FontWeight->"Bold"],
 " Not the algorithm but the reversible point-addition circuit: windowed \
arithmetic and measurement-based uncomputation. The appendix formula ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"P", "A"}], "TI"]], "+", "3", "\[CenterDot]", 
    SuperscriptBox["2", 
     StyleBox["w", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["n", "TI"], "/", 
    StyleBox["w", "TI"], "-", "4"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],
 " reproduces about 81 million Toffolis against the reported 90 million at \
most."
}], "Item",
 CellID->344152329,ExpressionUUID->"0aaecb0d-dff0-cd78-3a55-e356d98a9442"],

Cell[TextData[{
 StyleBox["Two hardware roads.",
  FontWeight->"Bold"],
 " Under half a million superconducting qubits for minutes-long attacks, or \
about 10,000 to 26,000 neutral atoms with high-rate qLDPC codes for days-long \
ones; the first threatens transactions in flight (about 41% success against a \
Bitcoin block at a 9-minute attack), the second dormant wallets."
}], "Item",
 CellID->622383932,ExpressionUUID->"4fe4a286-576e-fd11-759b-3be06218c47b"],

Cell["\<\
Example 10.1: Shor's discrete-log algorithm on a toy curve, recovering the \
key from the public point alone\
\>", "Subsection",
 CellID->2102744249,ExpressionUUID->"07179650-9fbb-2bc1-2d2c-081a1a4e792b"],

Cell[TextData[{
 "Elliptic-curve arithmetic over GF(p) from the notebook, with ",
 Cell[BoxData["O"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 " the point at infinity:"
}], "Text",
 CellID->565659401,ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{"O", ",", " ", "q_"}], "]"}], " ", ":=", " ", "q"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{"q_", ",", " ", "O"}], "]"}], " ", ":=", " ", "q"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"EllipticCurve", "[", 
       RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
      "[", "\"\<Add\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x_", ",", " ", "y1_"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x_", ",", " ", "y2_"}], "}"}]}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"y1", " ", "+", " ", "y2"}], ",", " ", "p"}], "]"}], " ", "==",
      " ", "0"}]}], " ", ":=", " ", "O"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"3", " ", 
             RowBox[{"x", "^", "2"}]}], " ", "+", " ", "a"}], ")"}], " ", 
          RowBox[{"PowerMod", "[", 
           RowBox[{
            RowBox[{"2", " ", "y"}], ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "p"}], "]"}]}], ",", " ", "p"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xr", " ", "=", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "2"}], " ", "-", " ", 
            RowBox[{"2", " ", "x"}]}], ",", " ", "p"}], "]"}]}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"xr", ",", " ", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{"x", " ", "-", " ", "xr"}], ")"}]}], " ", "-", " ", 
            "y"}], ",", " ", "p"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Add\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x1_", ",", " ", "y1_"}], "}"}], ",", " ", 
