Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"syndromeFilter", "[", 
    RowBox[{"p0_", ",", " ", "record_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"eta", " ", "kappa"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"FoldList", "[", 
      RowBox[{
