     "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"_", ",", " ", "0"}], "]"}], " ", ":=", " ", "O"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EllipticCurve", "[", 
      RowBox[{"a_", ",", " ", "b_", ",", " ", "p_"}], "]"}], 
     "[", "\"\<Mult\>\"", "]"}], "[", 
    RowBox[{"pt_", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"add", " ", "=", " ", 
       RowBox[{
        RowBox[{"EllipticCurve", "[", 
         RowBox[{"a", ",", " ", "b", ",", " ", "p"}], "]"}], 
        "[", "\"\<Add\>\"", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Fold", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"d", " ", "=", " ", 
            RowBox[{"add", "[", 
             RowBox[{"#1", ",", " ", "#1"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"#2", " ", "==", " ", "1"}], ",", " ", 
