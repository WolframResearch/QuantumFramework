Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"codePop", "[", "e_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"cs", " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "gamma"}]}]}], ",", " ", 
       RowBox[{"f", " ", "=", " ", 
        RowBox[{"F", " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "gamma"}]}]}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"Re", "@", 
      RowBox[{"Tr", "[", 
       RowBox[{"codeProj", " ", ".", " ", 
        RowBox[{"evolve", "[", 
         RowBox[{
          RowBox[{"0", " ", 
           RowBox[{"IdentityMatrix", "[", "8", "]"}]}], ",", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"c", " ", "-", " ", 
             RowBox[{"I", " ", "f"}]}], ",", " ", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", "e"}], ")"}], "/", "e"}], "]"}], " ",
              "f"}]}], "]"}], ",", "\n", "       ", 
          RowBox[{
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"#", ",", " ", "#"}], "]"}], " ", "&"}], "@", 
           RowBox[{"ket", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}], ",",
           " ", "15."}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bare", " ", "=", " ", 
   RowBox[{"Re", "@", 
    RowBox[{"Tr", "[", 
     RowBox[{"codeProj", " ", ".", " ", 
      RowBox[{"evolve", "[", 
       RowBox[{
        RowBox[{"0", " ", 
         RowBox[{"IdentityMatrix", "[", "8", "]"}]}], ",", " ", 
        RowBox[{"cs", " ", "/.", " ", 
         RowBox[{"\[Gamma]", " ", "->", " ", "gamma"}]}], ",", "\n", "     ", 
        
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"#", ",", " ", "#"}], "]"}], " ", "&"}], "@", 
         RowBox[{"ket", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}]}], ",", 
        " ", "15."}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.01", ",", " ", "0.03", ",", " ", "0.1", ",", " ", "0.3", ",", " ", 
     "0.6", ",", " ", "1."}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", " ", 
         RowBox[{"codePop", "[", "e", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "etas"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", " ", "bare"}], "}"}], " ", "&"}], " ", "/@", " ", 
      "etas"}]}], "}"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Markovian feedback\>\"", ",", " ", "\"\<no feedback\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<detector efficiency \[Eta]\>\"", ",", 
      " ", "\"\<code-space population at t = 15\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[9]:= ",
 CellID->1140508347,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 " the code space is held exactly. As the efficiency drops, the ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    RowBox[{"1", "-", 
     StyleBox["\[Eta]", "TI"]}], 
    StyleBox["\[Eta]", "TI"]], "\|01d49f", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["i", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " term feeds amplified detector noise back onto the qubits, and at a few \
percent efficiency the feedback leaves the code population below the \
no-feedback line: an inefficient loop is worse than no loop."
}], "Text",
 CellID->496109794,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

