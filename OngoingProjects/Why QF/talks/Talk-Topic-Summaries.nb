          RowBox[{"PowerMod", "[", 
           RowBox[{
            RowBox[{"x2", " ", "-", " ", "x1"}], ",", " ", 
            RowBox[{"-", "1"}], ",", " ", "p"}], "]"}]}], ",", " ", "p"}], 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
