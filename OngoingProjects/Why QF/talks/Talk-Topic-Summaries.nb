Cell["The averaged dynamics needs only the Liouvillian:", "Text",
 CellID->1384978530,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"liouvillian", "[", 
    RowBox[{"H_", ",", " ", "leaks_List", ",", " ", "d_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"id", " ", "=", " ", 
       RowBox[{"IdentityMatrix", "[", "d", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"H", ",", " ", "id"}], "]"}], " ", "-", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"id", ",", " ", 
           RowBox[{"Transpose", "[", "H", "]"}]}], "]"}]}], ")"}]}], " ", "+",
       "\n", "    ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"c", ",", " ", 
             RowBox[{"Conjugate", "[", "c", "]"}]}], "]"}], " ", "-", "\n", 
           "        ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", " ",
                  "c"}], ",", " ", "id"}], "]"}], " ", "+", "\n", 
              "           ", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"id", ",", " ", 
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "c", "]"}], " ", ".", 
                  " ", "c"}], "]"}]}], "]"}]}], ")"}], "/", "2"}]}]}], "]"}], 
        " ", "/@", " ", "leaks"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evolve", "[", 
    RowBox[{"H_", ",", " ", "leaks_", ",", " ", "rho0_", ",", " ", "t_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Length", "[", "rho0", "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"liouvillian", "[", 
           RowBox[{"H", ",", " ", "leaks", ",", " ", "d"}], "]"}], " ", "t"}],
          "]"}], " ", ".", " ", 
        RowBox[{"Flatten", "[", "rho0", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[7]:= ",
 CellID->519689844,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[TextData[{
 "Keep the error rate symbolic, build the feedback operators from the code \
projector, and check the two identities that make the code space invariant, \
for every ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
