               RowBox[{
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "4"}], " ", "gamma", " ", "dt"}], "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{"#1", " ", "-", " ", 
                  RowBox[{"1", "/", "4"}]}], ")"}]}]}], ")"}], " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"c", " ", 
               RowBox[{"signs", " ", ".", " ", "#2"}]}], "]"}]}]}], "}"}], ",",
           " ", 
          RowBox[{"w", "/", 
           RowBox[{"Total", "[", "w", "]"}]}]}], "]"}], " ", "&"}], ",", "\n",
        "    ", "p0", ",", " ", "record"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pFilter", " ", "=", " ", 
   RowBox[{"syndromeFilter", "[", 
