   StyleBox["R", "TI"], "=", "300"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 "."
}], "Text",
 CellID->617350884,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell["Summary", "Subsection",
 CellID->1357963930,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

Cell[TextData[{
 "Can a quantum particle be held together by its own gravity? In the \
Schrodinger-Newton equation the wavefunction moves in the Newtonian potential \
sourced by its own mass density ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Psi]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 ", a mean-field (not quantum-gravity, not collapse) model. Quantum spreading \
pushes out, self-gravity pulls in, and the balance is a stationary soliton."
}], "Text",
 CellID->1626918454,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell["What should catch a physicist's attention:", "Text",
 CellID->675379980,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell[TextData[{
 StyleBox["The scale in one line.",
  FontWeight->"Bold"],
 " Minimizing ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[HBar]", "2"], "/", 
   StyleBox["m", "TI"], 
   SuperscriptBox["\[ScriptL]", "2"], "-", 
   StyleBox["G", "TI"], 
   SuperscriptBox[
    StyleBox["m", "TI"], "2"], "/", "\[ScriptL]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 " gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptL]", "\[FivePointedStar]"], "=", 
   SuperscriptBox["\[HBar]", "2"], "/", 
   StyleBox["G", "TI"], 
   SuperscriptBox[
    StyleBox["m", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 ": astronomically large for an electron, near ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "7"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13db9173-5387-1c16-41f8-093d6632677c"],
 " m for a ",
 Cell[BoxData[
  SuperscriptBox["10", "10"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],
 " amu nanoparticle, which is why this matters for macroscopic-superposition \
experiments."
}], "Item",
 CellID->1331866192,ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell[TextData[{
 StyleBox["Three dimensions to one, then a self-consistent loop.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "=", 
   SqrtBox[
    RowBox[{"4", "\[Pi]"}]], "\[ThinSpace]", 
   StyleBox["r", "TI"], 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 " the problem becomes a radial Schrodinger eigenproblem in a potential that \
the eigenfunction itself sources; Newton's equation (",
 Cell[BoxData["NDSolveValue"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 ") and the Schrodinger eigenproblem (",
 Cell[BoxData["NDEigensystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 " with a shifted Arnoldi solver) on a graded finite-element mesh alternate \
until the energy stops changing."
}], "Item",
 CellID->1391655620,ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

Cell[TextData[{
 StyleBox["The box is removed, not ignored.",
  FontWeight->"Bold"],
 " Because ",
 Cell[BoxData[
  RowBox[{"\[CapitalPhi]", "\[Tilde]", "-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f13035-938c-831a-0d8e-aa7f263eee60"],
 ", imposing ",
 Cell[BoxData[
  RowBox[{"\[CapitalPhi]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["R", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b44e14-0404-e868-3e4c-605eadb6bab2"],
 " shifts the energy by ",
 Cell[BoxData[
  RowBox[{"+", "1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 ". Fitting ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["R", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["E", "TI"], "\[Infinity]"], "+", 
   StyleBox["C", "TI"], "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"],
 " over six boxes reproduces the Moroz-Penrose-Tod value ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "\[Infinity]"], "\[TildeTilde]", "-", "0.163"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],
 " and the predicted coefficient ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "\[TildeTilde]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],
 "; subtracting ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 " collapses every box onto one line."
}], "Item",
 CellID->861714746,ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"],

Cell[TextData[{
 StyleBox["A check the solver never saw.",
  FontWeight->"Bold"],
 " The virial identity ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["T", "TI"], "+", 
   StyleBox["W", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 " forces ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", 
   StyleBox["E", "TI"], "=", "-", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 ". The raw solution misses it by exactly the ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04469009-6b02-dcc3-2c7d-0a530eb4a629"],
 " boundary shift, and removing that shift restores ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],
 " to five digits."
}], "Item",
 CellID->1192942815,ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[TextData[{
 StyleBox["Excited solitons.",
  FontWeight->"Bold"],
 " The first three bound states have zero, one and two radial nodes, all \
sitting in their own ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b61bfc-9cd7-eca9-424d-92a61563b6f3"],
 "-tailed potentials."
}], "Item",
 CellID->556077107,ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"],

Cell["\<\
Example 6.1: the self-consistent soliton and the infinite-box energy\
\>", "Subsection",
 CellID->15883883,ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"],

Cell["The natural length scale first:", "Text",
 CellID->308842859,ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[HBar]", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"m", " ", 
          RowBox[{"l", "^", "2"}]}], ")"}]}], " ", "-", " ", 
       RowBox[{"G", " ", 
        RowBox[{
         RowBox[{"m", "^", "2"}], "/", "l"}]}]}], ",", " ", "l"}], "]"}], " ",
     "==", " ", "0"}], ",", " ", "l"}], "]"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->1108042358,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell["\<\
The radial Newton and Schrodinger operators, and one solver for each half of \
the loop:\
\>", "Text",
 CellID->1009200201,ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"newtonOp", " ", "=", " ", 
   RowBox[{"Laplacian", "[", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "r", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "\[Theta]", ",", " ", "\[Phi]"}], "}"}], ",", 
     " ", "\"\<Spherical\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hamiltonianOp", " ", "=", " ", 
   RowBox[{"SchrodingerPDEComponent", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "[", "r", "]"}], ",", " ", 
       RowBox[{"{", "r", "}"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ReducedPlanckConstant\>\"", " ", "->", " ", "1"}], ",", 
       " ", 
       RowBox[{"\"\<SchrodingerPotential\>\"", " ", "->", " ", 
        RowBox[{"\[CapitalPhi]", "[", "r", "]"}]}]}], "|>"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sortStates", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", "s", "]"}], ",", " ", "Re"}], "]"}], " ", "//",
     " ", "Transpose"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solveNewton", "[", 
    RowBox[{"uFunc_", ",", " ", "mesh_"}], "]"}], " ", ":=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"newtonOp", " ", "==", " ", 
        RowBox[{
         RowBox[{"uFunc", "^", "2"}], "/", 
         RowBox[{"r", "^", "2"}]}]}], ",", "\n", "    ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalPhi]", "[", "r", "]"}], " ", "==", " ", "0"}], ",",
          " ", 
         RowBox[{"r", " ", "==", " ", 
          RowBox[{
           RowBox[{"mesh", "[", "\"\<Bounds\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "]"}]}], "}"}], ",",
      " ", "\[CapitalPhi]", ",", " ", 
     RowBox[{
      RowBox[{"{", "r", "}"}], " ", "\[Element]", " ", "mesh"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solveSchrodinger", "[", 
    RowBox[{"PhiIn_", ",", " ", "mesh_"}], "]"}], " ", ":=", " ", 
   RowBox[{"sortStates", "@", 
    RowBox[{"NDEigensystem", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"hamiltonianOp", " ", "/.", " ", 
         RowBox[{"\[CapitalPhi]", " ", "->", " ", "PhiIn"}]}], ",", " ", 
        RowBox[{"DirichletCondition", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", "[", "r", "]"}], " ", "==", " ", "0"}], ",", " ", 
          "True"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"u", "[", "r", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", "r", "}"}], " ", "\[Element]", " ", "mesh"}], ",", " ", 
      "3", ",", "\n", "   ", 
      RowBox[{"Method", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<Eigensystem\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Arnoldi\>\"", ",", " ", 
            RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "3000"}], ",", 
            " ", 
            RowBox[{"\"\<BasisSize\>\"", " ", "->", " ", "50"}], ",", " ", 
            RowBox[{"\"\<Shift\>\"", " ", "->", " ", 
             RowBox[{"-", "10"}]}]}], "}"}]}], ",", "\n", "     ", 
         RowBox[{"\"\<Interpolation\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<ExtrapolationHandler\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", " ", 
              RowBox[{"\"\<WarningMessage\>\"", " ", "->", " ", "False"}]}], 
             "}"}]}], "}"}]}]}], "}"}]}]}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[40]:= ",
 CellID->752465254,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell["\<\
Iterate from a normalized Gaussian seed until the eigenvalue settles:\
\>", "Text",
 CellID->891183881,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"solveSN", "[", 
    RowBox[{"Rval_", ",", " ", "nEl_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mesh", ",", " ", 
       RowBox[{"s", " ", "=", " ", "3"}], ",", " ", "uk", ",", " ", "phik", ",",
        " ", "ek", ",", " ", 
       RowBox[{"eOld", " ", "=", " ", "Infinity"}], ",", " ", 
       RowBox[{"iter", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"mesh", " ", "=", " ", 
       RowBox[{"ToGradedMesh", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", " ", 
             RowBox[{"{", "Rval", "}"}]}], "}"}], "]"}], ",", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Alignment\>\"", " ", "->", " ", "\"\<Left\>\""}], ",",
             " ", 
            RowBox[{"\"\<ElementCount\>\"", " ", "->", " ", "nEl"}]}], 
           "|>"}]}], "}"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"uk", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"(", 
           RowBox[{"7", "/", "4"}], ")"}]}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"s", "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}], " ", 
           RowBox[{"Pi", "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "4"}], ")"}]}]}], ")"}]}], " ", "r", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"r", "^", "2"}]}], "/", 
          RowBox[{"s", "^", "2"}]}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"phik", " ", "=", " ", 
       RowBox[{"solveNewton", "[", 
        RowBox[{"uk", ",", " ", "mesh"}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ek", ",", " ", "uk"}], "}"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "}"}], " ", "&"}], 
        "@", 
        RowBox[{"solveSchrodinger", "[", 
         RowBox[{"phik", ",", " ", "mesh"}], "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"ek", " ", "-", " ", "eOld"}], "]"}], " ", ">", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}]}], " ", "&&", " ", 
         RowBox[{"iter", " ", "<", " ", "120"}]}], ",", " ", 
        RowBox[{
         RowBox[{"eOld", " ", "=", " ", "ek"}], ";", " ", 
         RowBox[{"phik", " ", "=", " ", 
          RowBox[{"solveNewton", "[", 
           RowBox[{"uk", ",", " ", "mesh"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ek", ",", " ", "uk"}], "}"}], " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "}"}], " ", 
            "&"}], "@", 
           RowBox[{"solveSchrodinger", "[", 
            RowBox[{"phik", ",", " ", "mesh"}], "]"}]}]}], ";", " ", 
         RowBox[{"iter", "++"}]}]}], "]"}], ";", "\n", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<R\>\"", " ", "->", " ", "Rval"}], ",", " ", 
        RowBox[{"\"\<Energy\>\"", " ", "->", " ", "ek"}], ",", " ", 
        RowBox[{"\"\<Iterations\>\"", " ", "->", " ", "iter"}], ",", " ", 
        RowBox[{"\"\<u\>\"", " ", "->", " ", 
         RowBox[{"Head", "[", "uk", "]"}]}], ",", " ", 
        RowBox[{"\"\<Phi\>\"", " ", "->", " ", "phik"}]}], "|>"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"results", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"solveSN", "[", 
      RowBox[{"Rv", ",", " ", "8000"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Rv", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "20", ",", " ", "40", ",", " ", "60", ",", " ", "100", ",", " ", 
         "200", ",", " ", "300"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"fit", " ", "=", " ", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#R", ",", " ", "#Energy"}], "}"}], " ", "&"}], " ", "/@", " ",
      "results"}], ",", " ", 
    RowBox[{"e", " ", "+", " ", 
     RowBox[{"c", "/", "rr"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"e", ",", " ", "c"}], "}"}], ",", " ", "rr"}], "]"}]}]}], "Input",\

 CellLabel->"In[41]:= ",
 CellID->741634648,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[TextData[{
 "The fit returns ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "\[Infinity]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 " at the literature ground-state energy and ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 " at the predicted value one: the whole finite-box error is the missing ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 " tail."
}], "Text",
 CellID->359589406,ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#R", ",", " ", "#Energy"}], "}"}], " ", "&"}], " ", "/@", 
      " ", "results"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#R", ",", " ", 
         RowBox[{"#Energy", " ", "-", " ", 
          RowBox[{"1", "/", "#R"}]}]}], "}"}], " ", "&"}], " ", "/@", " ", 
      "results"}]}], "}"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<E(R)\>\"", ",", " ", "\"\<E(R) - 1/R\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<R\>\"", ",", " ", "\"\<E\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", "Dashed", ",", " ", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"e", " ", "/.", " ", "fit"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->533832725,ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell["\<\
The six boxes take several minutes in total (about seven in one full-kernel \
run of this file).\
\>", "Text",
 CellID->739917449,ExpressionUUID->"710db4a8-d877-0db2-2732-2df5d9025798"],

Cell["Example 6.2: the virial identity as an independent check", "Subsection",
 CellID->473762610,ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"],

Cell[TextData[{
 "Kinetic and potential energy of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", "300"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 " ground state:"
}], "Text",
 CellID->1751712322,ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", " ", "=", " ", 
   RowBox[{"Last", "[", "results", "]"}]}], ";", " ", 
  RowBox[{"u0", " ", "=", " ", 
   RowBox[{"sol", "[", "\"\<u\>\"", "]"}]}], ";", " ", 
  RowBox[{"Phi0", " ", "=", " ", 
   RowBox[{"sol", "[", "\"\<Phi\>\"", "]"}]}], ";", " ", 
  RowBox[{"e0", " ", "=", " ", 
   RowBox[{"sol", "[", "\"\<Energy\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u0", "[", "r", "]"}], ",", " ", "r"}], "]"}], "^", "2"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "300"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"v", " ", "=", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi0", "[", "r", "]"}], " ", 
      RowBox[{
       RowBox[{"u0", "[", "r", "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "300"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"t", " ", "+", " ", "v", " ", "-", " ", "e0"}], ",", " ", 
   RowBox[{"t", "/", "e0"}], ",", " ", 
   RowBox[{"t", "/", 
    RowBox[{"(", 
     RowBox[{"e0", " ", "-", " ", 
      RowBox[{"1", "/", "300"}]}], ")"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], " ", "t"}], " ", "-", " ", "e0"}], ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "300."}]}], "}"}]}], "}"}]}], "Input",
 CellLabel->"In[43]:= ",
 CellID->1390140890,ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "+", 
   StyleBox["V", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 " reproduces the eigenvalue, so the energy bookkeeping is right. The raw \
ratio ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
 " misses the virial value ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 ", and the miss ",
 Cell[BoxData[
  RowBox[{"-", "3", 
   StyleBox["T", "TI"], "-", 
   StyleBox["E", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 " equals the boundary shift ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 "; removing that shift returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], "/", 
   StyleBox["E", "TI"], "=", "-", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 ". A relation the solver never imposed confirms the solution and locates its \
only error in the far-field boundary condition."
}], "Text",
 CellID->1031105928,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell["\<\
7. The Stabilizer Formalism by Computation: Aaronson-Gottesman Tableaux, \
Clifford Circuits and QEC Codes\
\>", "Section",
 CellID->1410588720,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell[TextData[{
 "Source: ",
 Cell["\<\
/Users/mohammadb/Documents/GitHub/mbahram/stabilizer-symbolic/tutorial/\
Stabilizer-Formalism-By-Computation.md\
\>", "InlineCode",ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],
 " (uses QuantumFramework's ",
 Cell[BoxData["PauliStabilizer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 ", loaded from the local checkout)."
}], "Text",
 CellID->1051974278,ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

Cell["Summary", "Subsection",
 CellID->1989924844,ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[TextData[{
 "A chalkboard course on the stabilizer formalism in which every claim is \
computed. A state is named by the Pauli operators that fix it; ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " commuting generators replace ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 " amplitudes; Clifford gates become ",
 Cell[BoxData[
  RowBox[{
   StyleBox["O", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["n", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 " bit rewrites of an Aaronson-Gottesman tableau; and the same object carries \
the reader from one qubit to a thousand, then on to codes, graph states, \
magic and noise."
}], "Text",
 CellID->695529426,ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell["What should catch a physicist's attention:", "Text",
 CellID->767788723,ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

Cell[TextData[{
 StyleBox["Why Paulis, precisely.",
  FontWeight->"Bold"],
 " Every state is fixed by ",
 StyleBox["some", "TI"],
 " operator (the reflection ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"2", 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"]}], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 "), so \"a state is what fixes it\" is empty on its own; the essay isolates \
the four properties of the Pauli group (cheap to name, ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 " spectrum, commute-or-anticommute, closed under Clifford conjugation) that \
make it pay."
}], "Item",
 CellID->494419947,ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"],

Cell[TextData[{
 StyleBox["Schrodinger and Heisenberg meet.",
  FontWeight->"Bold"],
 " The same circuit run by state-vector evolution and by conjugating \
generators gives the same state up to a global phase; a ",
 Cell[BoxData["PauliDecompose"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 " shows ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 " stays one Pauli string, while ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], 
   StyleBox["X", "TI"], 
   SuperscriptBox[
    StyleBox["T", "TI"], "\[Dagger]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], "+", 
    StyleBox["Y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 " shows exactly where the method breaks."
}], "Item",
 CellID->1581507689,ExpressionUUID->"2207e002-80f7-0285-523c-fa6c308250ef"],

Cell[TextData[{
 StyleBox["Stabilizer states are flat.",
  FontWeight->"Bold"],
 " Every stabilizer state is a uniform superposition over an affine subspace \
of ",
 Cell[BoxData[
  SubsuperscriptBox["\|01d53d", "2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 ", its support cut out by the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 "-type checks."
}], "Item",
 CellID->2120100675,ExpressionUUID->"3d27d006-86b8-9131-64dc-ca603332e01b"],

Cell[TextData[{
 StyleBox["Entanglement is a rank.",
  FontWeight->"Bold"],
 " Entropy across a cut is an ",
 Cell[BoxData[
  SubscriptBox["\|01d53d", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e44340b-ef5c-51d5-667b-ae548ae9233f"],
 " rank (Fattal et al.), computed for a 1000-qubit GHZ state in a fraction of \
a second."
}], "Item",
 CellID->950326543,ExpressionUUID->"321034f4-436e-dcec-622f-adbe7618a636"],

Cell[TextData[{
 StyleBox["Measurement without branching.",
  FontWeight->"Bold"],
 " Measurement histories grow as trees (",
 Cell[BoxData["NestTree"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 "); the SymPhase method of Fang and Ying instead carries each random outcome \
as a formal bit, so correlations come out as explicit Boolean relations and \
one symbolic traversal serves any number of shots."
}], "Item",
 CellID->1689126594,ExpressionUUID->"3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],

Cell[TextData[{
 StyleBox["Codes.",
  FontWeight->"Bold"],
 " The five-qubit code's fifteen single-qubit errors map one-to-one onto the \
fifteen nonzero syndromes, which is what \"perfect\" means; Steane's code \
shows the CSS split."
}], "Item",
 CellID->1490757098,ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"],

Cell[TextData[{
 StyleBox["Past the Clifford edge.",
  FontWeight->"Bold"],
 " Stabilizer frames make the stabilizer rank visible (",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["t", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 " for ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],
 " T gates, independent of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ecd9ee-6506-67bb-4193-d0c80cb34d81"],
 "), compute the irrational Born probability of the magic state exactly, \
compress redundant terms, and on diagonal circuits collapse to a rank-one \
phase polynomial whose amplitudes cost one linear solve at any ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6724c974-bdf1-27a5-0edb-e13e3b858d8f"],
 "."
}], "Item",
 CellID->148290444,ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

Cell[TextData[{
 StyleBox["An honest benchmark.",
  FontWeight->"Bold"],
 " Phase-resolved timings against Stim and QuantumClifford.jl, stating where \
QF is 4 to 7 times behind (kernel) and what it offers in exchange (symbolic \
signs, exact arithmetic, one object model)."
}], "Item",
 CellID->1707667820,ExpressionUUID->"53412643-5a68-df00-017e-b82d5f02a26a"],

Cell["\<\
Example 7.1: the perfect code's syndrome table, and a thousand-qubit GHZ state\
\>", "Subsection",
 CellID->933399197,ExpressionUUID->"696f5b1d-d56b-3a26-1f15-5346dc1f890c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/\
QuantumFramework\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"code", " ", "=", " ", 
   RowBox[{"PauliStabilizer", "[", "\"\<5QubitCode\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"Most", "[", 
    RowBox[{"code", "[", "\"\<Stabilizers\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"syndrome", "[", "err_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"code", "[", "err", "]"}], "[", 
          RowBox[{"\"\<Expectation\>\"", ",", " ", "#"}], "]"}], " ", "&"}], 
        " ", "/@", " ", "checks"}], ")"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"errors", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", " ", "->", " ", "q"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}],
           "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"q", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], ",", " ",
      "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{"syndrome", ",", " ", "errors"}], "]"}]}], "Input",
 CellLabel->"In[44]:= ",
 CellID->955179929,ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell["\<\
Each of the fifteen single-qubit errors flips a different pattern of the four \
checks. The patterns are exactly the fifteen nonzero four-bit strings, none \
missing and none repeated:\
\>", "Text",
 CellID->775067320,ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{"syndrome", " ", "/@", " ", "errors"}], "]"}], " ", "===", " ", 
  RowBox[{"Sort", "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->72268088,ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell["\<\
The same object scales without forming a state vector. A 1000-qubit GHZ state \
and its entanglement entropy across one qubit and across half the chain:\
\>", "Text",
 CellID->546416532,ExpressionUUID->"2e44757e-c407-f813-567c-6d3bedb3cb79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ghz", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "1000", "]"}], "[", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "q"}], "}"}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "2", ",", " ", "1000"}], "}"}]}], "]"}], ",", 
      " ", "\"\<H\>\""}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"ghz", "[", 
     RowBox[{"\"\<Entropy\>\"", ",", " ", 
      RowBox[{"{", "1", "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"ghz", "[", 
    RowBox[{"\"\<Entropy\>\"", ",", " ", 
     RowBox[{"Range", "[", "500", "]"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[46]:= ",
 CellID->2117784656,ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell["\<\
One bit either way: GHZ entanglement is a single shared parity, however the \
chain is cut.\
\>", "Text",
 CellID->853117843,ExpressionUUID->"539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],

Cell["\<\
Example 7.2: measurement outcomes as algebra, and the price of magic\
\>", "Subsection",
 CellID->623836386,ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell[TextData[{
 "Copy the parity of two random qubits onto a third, then measure all three \
symbolically. Only two fresh outcome bits appear, because the conserved ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"Z", "Z", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0971a20b-7913-467e-3f0e-445578a62d44"],
 " fixes the third:"
}], "Text",
 CellID->564394165,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parityCheck", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "3", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"smPar", " ", "=", " ", 
   RowBox[{"parityCheck", "[", 
    RowBox[{"\"\<SymbolicMeasure\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"smPar", "[", "\"\<Stabilizers\>\"", "]"}]}], "Input",
 CellLabel->"In[47]:= ",
 CellID->2048244887,ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],

Cell["\<\
Substituting the free bits over all assignments reads off the third outcome \
as their XOR, and a thousand samples drawn by substitution alone never leave \
the even-parity sector:\
\>", "Text",
 CellID->1432457359,ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"readBits", "[", "ps_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "@", 
    RowBox[{"Keys", "@", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"ps", "[", "\"\<Qubits\>\"", "]"}]}], "]"}], ",", "\n", 
         "      ", 
         RowBox[{"Normal", "[", 
          RowBox[{
           RowBox[{"ps", "[", "\"\<State\>\"", "]"}], 
           "[", "\"\<StateVector\>\"", "]"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", " ", "!=", " ", "0"}], " ", "&"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"free", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"smPar", "[", "\"\<Phase\>\"", "]"}], ",", " ", 
      RowBox[{"\[FormalS]", "[", "_", "]"}], ",", " ", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"readBits", "[", 
      RowBox[{"smPar", "[", 
       RowBox[{"\"\<SubstituteOutcomes\>\"", ",", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"free", " ", "->", " ", "#"}], "]"}]}], "]"}], "]"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"Length", "[", "free", "]"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
    RowBox[{"Counts", "[", 
     RowBox[{"readBits", " ", "/@", " ", 
      RowBox[{"smPar", "[", 
       RowBox[{"\"\<SampleOutcomes\>\"", ",", " ", "1000"}], "]"}]}], 
     "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[48]:= ",
 CellID->200346680,ExpressionUUID->"1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],

Cell[TextData[{
 "Cross the Clifford boundary with T gates. Three T gates on a GHZ backbone \
give a stabilizer frame of eight terms whatever the width, while the state \
vector it stands for grows as ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 "; and a single T on ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 " gives a Born probability no stabilizer state can:"
}], "Text",
 CellID->447384324,ExpressionUUID->"62752e4e-571f-d961-120a-c02862aba84b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"magicState", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "n", "]"}], "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"i", " ", "+", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<T\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"\"\<T\>\"", " ", "->", " ", "3"}]}], "}"}]}], "]"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{
        RowBox[{"magicState", "[", "n", "]"}], "[", "\"\<Length\>\"", "]"}], ",",
        " ", 
       RowBox[{"2", "^", "n"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "10", ",", " ", "20"}], "}"}]}], "}"}]}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"PauliStabilizer", "[", "1", "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"\"\<H\>\"", ",", " ", "\"\<T\>\""}], "}"}], "]"}], "[", 
        RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<X\>\""}], "]"}]}], 
      ")"}], "/", "2"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[49]:= ",
 CellID->1438124241,ExpressionUUID->"34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],

Cell[TextData[{
 "The probability ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "+", 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 " comes straight from the two-term frame, never from a state vector: the \
cost of magic is set by the number of T gates, not by the number of qubits."
}], "Text",
 CellID->2000382747,ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],

Cell["8. Dirac Matrices in a Curved Spacetime", "Section",
 CellID->902867877,ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell[TextData[{
 "Source: no talk essay exists. The original is the notebook ",
 Cell["\<\
/Users/mohammadb/Nextcloud/Mads/Quantum/DiracMatrix/gamma-dirac-matrix-v3.nb\
\>", "InlineCode",ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],
 ", read here through its machine conversion ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"/", "Users"}], "/", "mohammadb"}], "/", "Nextcloud"}], "/", 
       "Mads"}], "/", "Quantum"}], "/", "Roadmap"}], " ", "and", " ", 
    RowBox[{"planning", "/", "nb"}]}], "-", 
   RowBox[{
    RowBox[{"converted", "/", "3432"}], 
    RowBox[{"d4a045f86e4f6487314c8e8aed64", ".", "md"}]}]}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 "; the same functions now live in the DiracMatrix paclet, documented in ",
 Cell["\<\
/Users/mohammadb/Nextcloud/Mads/Quantum/DiracMatrix/DiracMatrixPackage/\
DiracMatrix-Documentation.md\
\>", "InlineCode",ExpressionUUID->"64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 ", which the examples load."
}], "Text",
 CellID->1315202099,ExpressionUUID->"67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],

Cell[TextData[{
 "Notes for review: (1) ",
 Cell[BoxData["CliffordBasis"], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 StyleBox[" is wrong on non-flat metrics, and the notebook and documentation \
blame the wrong function.",
  FontWeight->"Bold"],
 " Both say the explicit antisymmetrized sum (",
 Cell[BoxData["CliffordCanonicalBasis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],
 ") drifts at high grade \"due to numerical issues\" while the recursion (",
 Cell[BoxData["CliffordBasis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
 ") is stable. With a moderate non-diagonal Lorentzian metric in machine \
precision, the explicit sum reproduces the antisymmetrized products to \
machine precision while ",
 Cell[BoxData["CliffordBasis"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 " is off by order ten already at grade 3. The cause is the sign in the \
recursion at ",
 Cell["\<\
/Users/mohammadb/Nextcloud/Mads/Quantum/DiracMatrix/DiracMatrixPackage/Kernel/\
DiracMatrix.wl:186\
\>", "InlineCode",ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 ": ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], "^", 
   RowBox[{"(", 
    RowBox[{"j", " ", "-", " ", "1"}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 " should be ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], "^", 
   RowBox[{"(", 
    RowBox[{"k", " ", "-", " ", "j"}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 " with ",
 Cell[BoxData[
  RowBox[{"k", " ", "=", " ", 
   RowBox[{"Length", "[", "is", "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],
 ". With that sign the recursion matches to machine precision. Flat metrics \
hide the bug because every off-diagonal ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Eta]", "TI"], 
   StyleBox[
    RowBox[{"\[Mu]", "i"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c80315-d7de-7125-4ff7-9b5ee26b400f"],
 " vanishes. (2) \"Curved spacetime\" here means the gamma matrices of an \
arbitrary metric at a point, through a vielbein; spin connection and the \
curved-space Dirac operator are not part of the material. (3) Loading with ",
 Cell[BoxData[
  RowBox[{"Needs", "[", "\"\<DiracMatrix\>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdf78a7-59a9-97d9-15e5-7101585dfd23"],
 "\"]",
 Cell[BoxData[
  RowBox[{",", " ", 
   RowBox[{"as", " ", "the", " ", "documentation", " ", "says"}], ",", " ", 
   "emits"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 "Needs::nocont",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{"the", " ", 
    RowBox[{"paclet", "'"}], "s", " ", "primary", " ", "context", " ", 
    "is"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b26917-59e6-8729-3f41-81515f90ea73"],
 Cell[BoxData["WolframQuantumComputation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 "DiracMatrix",
 Cell[BoxData[""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136d7364-bcfb-8461-4113-6b4e348fef4b"],
 "`) even though the functions load."
}], "Text",
 CellID->376763343,ExpressionUUID->"2b78534b-7a52-d624-5918-4b157fe4bd0e"],

Cell["Summary", "Subsection",
 CellID->126027414,ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[TextData[{
 "Gamma matrices satisfying ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    SuperscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Mu]", "TI"]]}], ",", 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Nu]", "TI"]], "}", "=", "2", 
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "\|01d7d9"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 " for any real symmetric metric ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 ", of any signature ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["q", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e386-6ff5-c0ee-09b1-fae009819234"],
 " and any dimension. Flat-space matrices come from the Brauer-Weyl \
(Pauli-Kronecker) construction, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalGamma]", 
    RowBox[{"2", 
     StyleBox["k", "TI"], "-", "1"}]], "=", 
   SuperscriptBox["\|01d7d9", 
    RowBox[{"\[CircleTimes]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["k", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "\[CircleTimes]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "1"], "\[CircleTimes]", 
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], "3", 
    RowBox[{"\[CircleTimes]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["m", "TI"], "-", 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a39a2f-b372-ffce-5c50-1388c604c514"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalGamma]", 
    RowBox[{"2", 
     StyleBox["k", "TI"]}]], "=", 
   SuperscriptBox["\|01d7d9", 
    RowBox[{"\[CircleTimes]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["k", "TI"], "-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "\[CircleTimes]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "2"], "\[CircleTimes]", 
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], "3", 
    RowBox[{"\[CircleTimes]", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["m", "TI"], "-", 
      StyleBox["k", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"],
 "; time-like directions pick up a factor ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],
 "; a general metric is handled by a vielbein, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["T", "TI"]], 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["e", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   SubsuperscriptBox[
    StyleBox["e", "TI"], 
    StyleBox["a", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SuperscriptBox["\[CapitalGamma]", 
    StyleBox["a", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47740231-7fc8-4299-6d0b-a47b7a7d10e3"],
 "."
}], "Text",
 CellID->570920987,ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"],

Cell["What should catch a physicist's attention:", "Text",
 CellID->378517449,ExpressionUUID->"2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],

Cell[TextData[{
 StyleBox["One function, every signature and dimension.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{"GammaMatrices", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5782d92f-a790-094a-7db1-d088d2255b90"],
 " returns ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 " matrices of size ",
 Cell[BoxData[
  SuperscriptBox["2", 
   RowBox[{
    StyleBox["\[LeftFloor]",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["n", "TI"], "/", "2"}], 
    StyleBox["\[RightFloor]",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 " for Euclidean, Minkowski, split ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", ",", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 ", Schwarzschild at a point, an FLRW slice, or a random non-diagonal \
metric."
}], "Item",
 CellID->1671903560,ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell[TextData[{
 StyleBox["The textbook identities as tests, swept over all signatures.",
  FontWeight->"Bold"],
 " Tracelessness, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Nu]", "TI"]], "=", 
   SuperscriptBox["2", 
    RowBox[{
     StyleBox["\[LeftFloor]",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], "/", "2"}], 
     StyleBox["\[RightFloor]",
      SpanMaxSize->1]}]], 
   SuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d0df906-1ebb-1081-5b32-f1609b4e62eb"],
 ", the four-gamma trace, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Nu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "-", 
    StyleBox["n", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Nu]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a891815-8c00-cf41-6ab6-925f25ba95ab"],
 ", the Lorentz-generator commutator, chirality in even dimension: each is \
one ",
 Cell[BoxData["Table"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dbacffa-31b0-43f6-3b59-e6a4404511dc"],
 " over ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[LessEqual]", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196a859c-b643-c1b3-4f69-1cd9c3f79399"],
 " and all ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["q", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 ", flat and curved."
}], "Item",
 CellID->1307059254,ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"],

Cell[TextData[{
 StyleBox["Representations on demand.",
  FontWeight->"Bold"],
 " Brauer-Weyl, Dirac (",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["\[Gamma]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3597ba8d-914b-928f-63ac-33d720ffe0d5"],
 " diagonal) and Weyl/chiral bases by explicit similarity transforms, with \
the odd-dimensional case (no chiral basis) handled."
}], "Item",
 CellID->538512558,ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell[TextData[{
 StyleBox["The graded Clifford basis.",
  FontWeight->"Bold"],
 " All ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 " antisymmetrized products, the operator basis behind Fierz identities, by \
explicit sum and by a grade-raising recursion (see the review note on the \
recursion)."
}], "Item",
 CellID->824717693,ExpressionUUID->"7b649e79-a2e1-7610-291b-1022d6945d7a"],

Cell["\<\
Example 8.1: gamma matrices for Schwarzschild and for a random curved metric\
\>", "Subsection",
 CellID->496527141,ExpressionUUID->"09cb884c-5fc8-b209-3fc8-22165a620153"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Nextcloud/Mads/Quantum/DiracMatrix/\
DiracMatrixPackage\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<DiracMatrix`\>\"", "]"}], ";"}]}], "Input",
 CellLabel->"In[50]:= ",
 CellID->2009363188,ExpressionUUID->"376c6589-bcca-29e8-5d14-7cd3357f7b32"],

Cell[TextData[{
 "The Schwarzschild metric on the equator at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "3", 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667bb688-7420-22c7-0e18-2fd27dd5702d"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"-", "1", "/", "3"}], ",", 
    RowBox[{"3", ",", "9", ",", "9"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72002252-da4c-5210-223f-c41fdff9217a"],
 ". Its gamma matrices obey the Clifford relation exactly:"
}], "Text",
 CellID->55669068,ExpressionUUID->"084561a7-5440-aaee-387b-78015dfaf834"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "/", "3"}], ",", " ", "3", ",", " ", "9", ",", " ",
       "9"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gs", " ", "=", " ", 
   RowBox[{"GammaMatrices", "[", "g", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Outer", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
        RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", "Gs", ",",
       " ", "Gs", ",", " ", "1"}], "]"}], " ", "==", " ", 
    RowBox[{"2", " ", 
     RowBox[{"TensorProduct", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Gs", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[51]:= ",
 CellID->1753574084,ExpressionUUID->"721e71e5-9ca7-ded5-2226-68cf1553a43f"],

Cell["\<\
A random non-diagonal metric of Lorentzian signature, its vielbein, and the \
check that the vielbein rebuilds the metric:\
\>", "Text",
 CellID->2038359728,ExpressionUUID->"0a84e7eb-55e0-1894-3abb-feb563956afe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
  RowBox[{"gr", " ", "=", " ", 
   RowBox[{"RandomCurvedMetric", "[", 
    RowBox[{"1", ",", " ", "3", ",", " ", "1", ",", " ", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sig", ",", " ", "e"}], "}"}], " ", "=", " ", 
   RowBox[{"MetricVielbein", "[", "gr", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Diagonal", "[", "sig", "]"}], ",", " ", 
   RowBox[{"NumericZeroQ", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Transpose", "[", "e", "]"}], " ", ".", " ", "sig", " ", ".", 
      " ", "e"}], " ", "-", " ", "gr"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[52]:= ",
 CellID->1525364821,ExpressionUUID->"3261920b-7b77-02d6-621e-14557e02503c"],

Cell[TextData[{
 "The signature ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"+", ",", "-", ",", "-", ",", "-"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],
 " is read off the metric itself, and the vielbein is exact to numerical \
tolerance."
}], "Text",
 CellID->1535108406,ExpressionUUID->"7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],

Cell["\<\
Example 8.2: the textbook identities, on random curved metrics of every \
signature\
\>", "Subsection",
 CellID->1528788962,ExpressionUUID->"41d92934-9aba-8299-77e6-c17e1f4cd0e3"],

Cell[TextData[{
 "For every dimension ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "=", "2"}], ",", "\[Ellipsis]", ",", "6"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],
 " and every signature ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    RowBox[{
     StyleBox["n", "TI"], "-", 
     StyleBox["p", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 ", draw a random non-diagonal metric and test the Clifford relation, the \
contraction ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Mu]", "TI"]], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 " and the four-gamma trace:"
}], "Text",
 CellID->1505774531,ExpressionUUID->"22235db8-54be-42b7-53d1-54e25d4b109d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "12345", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"eta", " ", "=", " ", 
          RowBox[{"RandomCurvedMetric", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"n", " ", "-", " ", "p"}], ",", " ", "0.5", ",", " ", 
            "1"}], "]"}]}], ",", " ", "G", ",", " ", "A"}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{
        RowBox[{"G", " ", "=", " ", 
         RowBox[{"GammaMatrices", "[", "eta", "]"}]}], ";", " ", 
        RowBox[{"A", " ", "=", " ", 
         RowBox[{"TensorProduct", "[", 
          RowBox[{"eta", ",", " ", "eta"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NumericZeroQ", "[", 
           RowBox[{
            RowBox[{"Outer", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#1", " ", ".", " ", "#2"}], " ", "+", " ", 
                RowBox[{"#2", " ", ".", " ", "#1"}]}], " ", "&"}], ",", " ", 
              "G", ",", " ", "G", ",", " ", "1"}], "]"}], " ", "-", " ", 
            RowBox[{"2", " ", 
             RowBox[{"TensorProduct", "[", 
              RowBox[{"eta", ",", " ", 
               RowBox[{"IdentityMatrix", "[", 
                RowBox[{"2", "^", 
                 RowBox[{"Floor", "[", 
                  RowBox[{"n", "/", "2"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}],
           ",", "\n", "    ", 
          RowBox[{"NumericZeroQ", "[", 
           RowBox[{
            RowBox[{"Total", "@", 
             RowBox[{"MapThread", "[", 
              RowBox[{"Dot", ",", " ", 
               RowBox[{"{", 
                RowBox[{"G", ",", " ", 
                 RowBox[{
                  RowBox[{"Inverse", "[", "eta", "]"}], " ", ".", " ", 
                  "G"}]}], "}"}]}], "]"}]}], " ", "-", " ", 
            RowBox[{"n", " ", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"2", "^", 
               RowBox[{"Floor", "[", 
                RowBox[{"n", "/", "2"}], "]"}]}], "]"}]}]}], "]"}], ",", "\n",
           "    ", 
          RowBox[{"NumericZeroQ", "[", 
           RowBox[{
            RowBox[{"Outer", "[", 
             RowBox[{
              RowBox[{"Tr", "@*", "Dot"}], ",", " ", "G", ",", " ", "G", ",", 
              " ", "G", ",", " ", "G", ",", " ", "1"}], "]"}], " ", "-", "\n",
             "      ", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"Floor", "[", 
               RowBox[{"n", "/", "2"}], "]"}]}], " ", 
             RowBox[{"(", 
              RowBox[{"A", " ", "-", " ", 
               RowBox[{"Transpose", "[", 
                RowBox[{"A", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "3", ",", " ", "2", ",", " ", "4"}], 
                  "}"}]}], "]"}], " ", "+", " ", 
               RowBox[{"Transpose", "[", 
                RowBox[{"A", ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], 
                  "}"}]}], "]"}]}], ")"}]}]}], "]"}]}], "}"}]}]}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], " ", "//", " ", 
   "Flatten"}], " ", "//", " ", 
  RowBox[{"Apply", "[", "And", "]"}]}]}], "Input",
 CellLabel->"In[53]:= ",
 CellID->535490749,ExpressionUUID->"0976d5ae-737d-f257-3f0d-cc080609c0bd"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e711b4-4d78-4d68-419c-88fe640d17b2"],
 ": the identities that every QFT course derives by hand for Minkowski space \
hold, as computed facts, for every signature and every metric in the sweep. \
Representations follow by one call, for example the Weyl basis in Minkowski \
space:"
}], "Text",
 CellID->1238905205,ExpressionUUID->"3fd09d86-aea1-a602-65ef-14e3cb550d68"],

Cell[BoxData[
 RowBox[{"MatrixForm", " ", "/@", " ", 
  RowBox[{"ToWeylBasis", "[", 
   RowBox[{"GammaMatrices", "[", 
    RowBox[{"FlatMetric", "[", 
     RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->2125008310,ExpressionUUID->"2f6c0922-6605-ed68-5513-a08c13b1b7b2"],

Cell["9. Snyder's Lorentz-Covariant Quantum Spacetime", "Section",
 CellID->1684656716,ExpressionUUID->"2caab86a-2af9-b1b1-54a9-32344e8d039b"],

Cell[TextData[{
 "Source: no ",
 Cell[".md", "InlineCode",ExpressionUUID->
  "7f56169e-4783-4dbb-256d-8fd872361781"],
 " exists. The notebook ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"/", "Users"}], "/", "mohammadb"}], "/", "Nextcloud"}], "/", 
       "Mads"}], "/", "Quantum"}], "/", "2"}], "nd", " ", "quantization", " ",
     "and", " ", "non"}], "-", 
   RowBox[{
    RowBox[{"commutative", "/", "NCA"}], " ", 
    RowBox[{"examples", "/", "NCA"}], " ", 
    RowBox[{"talks", "/", 
     RowBox[{"Snyder", "'"}]}], "s", " ", "Lorentz"}], "-", 
   RowBox[{"covariant", " ", "quantum", " ", 
    RowBox[{"spacetime", ".", "nb"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b84d4d6-858d-5842-09bb-cd902c382aa8"],
 " was read through an ",
 Cell["nb-reader", "InlineCode",ExpressionUUID->
  "67558936-e5eb-8680-0d6a-2173939fecea"],
 " conversion; a shorter version (triple-commutator check only) is section \
P17 of ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"/", "Users"}], "/", "mohammadb"}], "/", "Nextcloud"}], "/", 
       "Mads"}], "/", "Quantum"}], "/", "2"}], "nd", " ", "quantization", " ",
     "and", " ", "non"}], "-", 
   RowBox[{
    RowBox[{"commutative", "/", "NCA"}], " ", 
    RowBox[{"examples", "/", "NCA"}], " ", 
    RowBox[{"talks", "/", "Overll"}], " ", "nb", " ", "and", " ", 
    RowBox[{"md", "/", "NCA"}]}], "-", "talks", "-", "4", "-", 
   RowBox[{"17.", "md"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1072dc7c-f7d5-c74e-4001-d6398261ad94"],
 ". The examples use the built-in ",
 Cell[BoxData["NonCommutativeAlgebra"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3462f0a3-098c-f6b3-5c11-e90da83edc99"],
 " and ",
 Cell[BoxData["NonCommutativeExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cac1af-436c-9192-2cc9-d809761ee3f8"],
 " (Wolfram Language 15)."
}], "Text",
 CellID->2057792111,ExpressionUUID->"63be94f2-239e-9b81-1145-0dbc5628e9eb"],

Cell["Summary", "Subsection",
 CellID->408837332,ExpressionUUID->"5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],

Cell[TextData[{
 "Snyder (1947) quantized spacetime without breaking Lorentz symmetry: the \
coordinates stop commuting, and their commutator is a Lorentz generator times \
a fundamental length squared, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Mu]", "TI"]], ",", 
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Nu]", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
 ". The notebook declares this ten-generator algebra once and lets the \
noncommutative-algebra engine do what is error-prone by hand."
}], "Text",
 CellID->1068510841,ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"],

Cell["What should catch a physicist's attention:", "Text",
 CellID->1027032549,ExpressionUUID->"178a6a52-23e4-1142-3d89-8c1c559163a8"],

Cell[TextData[{
 StyleBox["Consistency first.",
  FontWeight->"Bold"],
 " All four families of Jacobi identities vanish, and Lorentz covariance of \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
 " comes out as a theorem: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox[
      RowBox[{"\[Rho]", "\[Sigma]"}], "TI"]], ",", 
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["\[Mu]", "TI"]], ",", 
      SuperscriptBox[
       StyleBox["x", "TI"], 
       StyleBox["\[Nu]", "TI"]]}], 
     StyleBox["]",
      SpanMaxSize->1]}]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719ae17a-c654-ed44-27b9-f927f3e6b7ae"],
 " computed through the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["M", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c8f42b-c628-388a-12f7-ee74f3c28ad0"],
 " relations equals ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox[
      RowBox[{"\[Rho]", "\[Sigma]"}], "TI"]], ",", 
    SuperscriptBox[
     StyleBox["M", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],
 " computed through the Lorentz algebra."
}], "Item",
 CellID->171792661,ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[TextData[{
 StyleBox["Orderings no one does by hand.",
  FontWeight->"Bold"],
 " The quartic word ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "1"], 
   SuperscriptBox[
    StyleBox["x", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 " reduces to the ordered basis with 136 leaves of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["a", "TI"], "2"], 
   StyleBox["x", "TI"], 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 " terms; the cubic Weyl symbol follows the same way."
}], "Item",
 CellID->574949478,ExpressionUUID->"0e7c794a-82c2-56e7-3604-711437773ccd"],

Cell[TextData[{
 StyleBox["The deformed center.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["x", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 " is a Lorentz scalar but not central, and the Lorentz Casimir is not \
central either; the SO(4,1) combination ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], "-", 
   FractionBox[
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], "2"], 
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], 
   SubscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 " commutes with everything (Maggiore's conjecture, checked)."
}], "Item",
 CellID->1664775781,ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],

Cell[TextData[{
 StyleBox["Noncommutativity is orbital angular momentum.",
  FontWeight->"Bold"],
 " With momenta and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["x", "TI"], 
     StyleBox["\[Mu]", "TI"]], ",", 
    SuperscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["\[Nu]", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Eta]", "TI"], 
     StyleBox[
      RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "+", 
    SuperscriptBox[
     StyleBox["a", "TI"], "2"], 
    SuperscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["\[Mu]", "TI"]], 
    SuperscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["\[Nu]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 ", Jacobi closure forces ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["M", "TI"], 
    StyleBox[
     RowBox[{"\[Mu]", "\[Nu]"}], "TI"]], "=", 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Mu]", "TI"]], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["\[Nu]", "TI"]], "-", 
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["\[Nu]", "TI"]], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["\[Mu]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 ": the generator in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["x", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 " is the orbital one already present in phase space."
}], "Item",
 CellID->884697794,ExpressionUUID->"51e4dffc-d38f-5703-079b-d6b9e63a3a69"],

Cell[TextData[{
 StyleBox["Physics in one stroke.",
  FontWeight->"Bold"],
 " The BCH expansion of a product of plane waves gives the deformed momentum \
addition (symmetric for Snyder at this order, non-symmetric already at order ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " for \[Kappa]-Minkowski, run through the same code); the deformed \
uncertainty relation has a minimum ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["min",
     FontSlant->"Plain"]], "=", 
   StyleBox["a", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 "; and the Fermi-LAT GRB 090510 bound translates to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], "<", "1.5", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "27"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],
 " m, about eight decades above the Planck length."
}], "Item",
 CellID->784201795,ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell["\<\
Example 9.1: Snyder's algebra, its consistency, and its Casimir\
\>", "Subsection",
 CellID->1193259712,ExpressionUUID->"156728ce-0023-e03b-431c-c1a8b1d7b301"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eta", "[", 
    RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"m", " ", "+", " ", "1"}], ",", " ", 
      RowBox[{"n", " ", "+", " ", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MGen", "[", 
    RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"m", " ", "==", " ", "n"}], ",", " ", "0", ",", " ", 
     RowBox[{"m", " ", "<", " ", "n"}], ",", " ", 
     RowBox[{"M", "[", 
      RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", "True", ",", " ", 
     RowBox[{"-", 
      RowBox[{"M", "[", 
       RowBox[{"n", ",", " ", "m"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gen", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"x", "[", "m", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"M", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", 
          RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xxRel", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"x", "[", "n", "]"}], ",", " ", 
         RowBox[{"x", "[", "m", "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"a", "^", "2"}], " ", 
        RowBox[{"M", "[", 
         RowBox[{"m", ",", " ", "n"}], "]"}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mxRel", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"m", ",", " ", "n"}], "]"}], ",", " ", 
         RowBox[{"x", "[", "r", "]"}]}], "]"}], " ", "-", " ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"x", "[", "m", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"x", "[", "n", "]"}]}]}], ")"}]}]}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", 
        RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mmRel", " ", "=", " ", 
   RowBox[{"Replace", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "n"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", 
             RowBox[{"m", " ", "+", " ", "1"}], ",", " ", "3"}], "}"}]}], 
          "]"}], ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m_", ",", " ", "n_"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r_", ",", " ", "s_"}], "}"}]}], "}"}], " ", ":>", " ", 
      RowBox[{
       RowBox[{"Commutator", "[", 
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"r", ",", " ", "s"}], "]"}], ",", " ", 
         RowBox[{"M", "[", 
          RowBox[{"m", ",", " ", "n"}], "]"}]}], "]"}], " ", "+", "\n", 
       "     ", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"m", ",", " ", "s"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"n", ",", " ", "s"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "r"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"n", ",", " ", "s"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"eta", "[", 
            RowBox[{"m", ",", " ", "s"}], "]"}], " ", 
           RowBox[{"MGen", "[", 
            RowBox[{"n", ",", " ", "r"}], "]"}]}]}], ")"}]}]}]}], ",", " ", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"alg", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", "gen", "}"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"xxRel", ",", " ", "mxRel", ",", " ", "mmRel"}], "]"}]}], ",",
       " ", 
      RowBox[{"\"\<ScalarVariables\>\"", " ", "->", " ", 
       RowBox[{"{", "a", "}"}]}]}], "|>"}], "]"}]}], ";"}]}], "Input",
