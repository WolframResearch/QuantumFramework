Cell["A cat's interference fringes", "Subsection",
 CellID->354048744,ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{"CatState", "[", "]"}], "[", 
   RowBox[{"2", ",", " ", "0"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 " is the even superposition of the coherent states ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{"\[PlusMinus]", "2"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 ". Tabulate its Wigner function on the phase-space window ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["x", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "6"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 ", ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["p", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 "."
}], "Text",
 CellID->786710823,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wigner", " ", "=", " ", 
   RowBox[{"WignerRepresentation", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CatState", "[", "]"}], "[", 
      RowBox[{"2", ",", " ", "0"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "90"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1859374462,ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell[TextData[{
 "Tabulate its Husimi function, the Wigner function smoothed over a \
vacuum-sized patch, on ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["x", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "6"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 ", ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["p", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "3"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"],
 "."
}], "Text",
 CellID->544914423,ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"husimi", " ", "=", " ", 
   RowBox[{"HusimiQRepresentation", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CatState", "[", "]"}], "[", 
      RowBox[{"2", ",", " ", "0"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "90"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->1088734259,ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell[TextData[{
 "The Wigner function as a surface over ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 "."
}], "Text",
 CellID->476175344,ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"wigner", "[", 
    RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", 
     RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Mesh", " ", "->", " ", "None"}], ",", " ", 
   RowBox[{"PlotPoints", " ", "->", " ", "50"}], ",", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",", 
   " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\"", ",", " ", "None"}], "}"}]}], 
   ",", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", "\"\<Wigner\>\""}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->201272189,ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"],

Cell["The Husimi function on the same axes.", "Text",
 CellID->320292756,ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"husimi", "[", 
    RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"p", ",", " ", 
     RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Mesh", " ", "->", " ", "None"}], ",", " ", 
   RowBox[{"PlotPoints", " ", "->", " ", "50"}], ",", " ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",", 
   " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\"", ",", " ", "None"}], "}"}]}], 
   ",", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", "\"\<Husimi\>\""}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->1146801282,ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell["\<\
The Wigner function has one lobe for each coherent state and fringes between \
them that dip below zero, the signature of the superposition; the Husimi \
function keeps the lobes and smooths the fringes away.\
\>", "Text",
 CellID->41202278,ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1124146653,ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell["6. How far can exact simulation go without a state vector?", "Section",
 CellID->1232284935,ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " a stabilizer state is named by the Pauli operators that fix it, and \
Clifford gates rewrite that list. Start with the five-qubit code: which of \
its four checks does each single-qubit error flip? ",
 Cell[BoxData["errors"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451364b5-819d-fb99-7321-7dff3029c9e3"],
 " lists the fifteen single-qubit Pauli errors, and ",
 Cell[BoxData[
  RowBox[{"syndrome", "[", "e", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " returns the four check outcomes (1 = flipped) for error ",
 Cell[BoxData["e"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 "."
}], "Text",
 CellID->2082395230,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"table", " ", "=", " ", 
   RowBox[{"syndrome", " ", "/@", " ", "errors"}]}], ";"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->2045146513,ExpressionUUID->"48fccab3-b886-a0f7-7883-e3fd3930f2dd"],

Cell["\<\
Draw the table: one column per error, one row per check, blue where the check \
flips.\
\>", "Text",
 CellID->25123057,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[BoxData[
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", "table", "]"}], ",", " ", 
   RowBox[{"Mesh", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"ColorRules", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0", " ", "->", " ", "White"}], ",", " ", 
      RowBox[{"1", " ", "->", " ", 
       RowBox[{"Darker", "[", "Blue", "]"}]}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "4", "]"}], ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<check 1\>\"", ",", " ", "\"\<check 2\>\"", ",", 
             " ", "\"\<check 3\>\"", ",", " ", "\"\<check 4\>\""}], "}"}]}], 
          "}"}], "]"}], ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "15", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "<>", " ", 
              RowBox[{"ToString", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}]}], " ", 
             "&"}], " ", "/@", " ", "errors"}]}], "}"}], "]"}], ",", " ", 
        "None"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "600"}]}], "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->371825621,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

Cell["\<\
Check that the fifteen patterns are exactly the fifteen nonzero four-bit \
strings.\
\>", "Text",
 CellID->1439628390,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", "table", "]"}], " ", "===", " ", 
  RowBox[{"Sort", "@", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->497245720,ExpressionUUID->"0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],

Cell["\<\
The fifteen errors flip fifteen different nonzero patterns, using every \
pattern exactly once: what makes the code \"perfect\".\
\>", "Text",
 CellID->1090726268,ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2124519200,ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"],

Cell["A thousand qubits, exactly", "Subsection",
 CellID->617350884,ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell["\<\
Build a 1000-qubit GHZ state as a stabilizer tableau: a Hadamard on qubit 1, \
then a chain of CNOTs.\
\>", "Text",
 CellID->1357963930,ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ghz", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "1000", "]"}], "[", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", " ", "-", " ", "1"}], ",", " ", "q"}], "}"}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"q", ",", " ", "2", ",", " ", "1000"}], "}"}]}], "]"}], ",", 
      " ", "\"\<H\>\""}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->1626918454,ExpressionUUID->"710db4a8-d877-0db2-2732-2df5d9025798"],

Cell["\<\
The entanglement entropy of qubit 1 with the rest, and the time it takes.\
\>", "Text",
 CellID->675379980,ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{"ghz", "[", 
   RowBox[{"\"\<Entropy\>\"", ",", " ", 
    RowBox[{"{", "1", "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1331866192,ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell["\<\
The entanglement entropy of the first 500 qubits with the other 500.\
\>", "Text",
 CellID->1391655620,ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell[BoxData[
 RowBox[{"ghz", "[", 
  RowBox[{"\"\<Entropy\>\"", ",", " ", 
   RowBox[{"Range", "[", "500", "]"}]}], "]"}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->861714746,ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell["\<\
One bit of entanglement for either cut, computed in a fraction of a second: \
GHZ entanglement is a single shared parity, however the chain is cut.\
\>", "Text",
 CellID->1192942815,ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->556077107,ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell["The price of non-Clifford gates", "Subsection",
 CellID->15883883,ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

Cell[TextData[{
 "Three T gates on a GHZ backbone of growing width: ",
 Cell[BoxData[
  RowBox[{"magicState", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 " is an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 "-qubit GHZ circuit followed by T on qubits 1 to 3, and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " is the number of terms in its stabilizer frame. Compare with the ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 " amplitudes of the state vector."
}], "Text",
 CellID->308842859,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{
          RowBox[{"magicState", "[", "n", "]"}], "[", "\"\<Length\>\"", 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4", ",", " ", "24", ",", " ", "2"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"2", "^", "n"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4", ",", " ", "24", ",", " ", "2"}], "}"}]}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<qubits\>\"", ",", " ", "\"\<terms or amplitudes\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<stabilizer frame terms (3 T gates)\>\"", ",", 
      " ", "\"\<state-vector amplitudes\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->1108042358,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[TextData[{
 "One T gate on ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"+"},
    "Ket"], "=", 
   RowBox[{
    StyleBox["H", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 ": the probability of finding ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "330aabc0-bdd5-22a3-6109-42aa34607089"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " from the stabilizer frame."
}], "Text",
 CellID->1009200201,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"PauliStabilizer", "[", "1", "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"\"\<H\>\"", ",", " ", "\"\<T\>\""}], "}"}], "]"}], "[", 
      RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<X\>\""}], "]"}]}], ")"}], 
   "/", "2"}], "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->752465254,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[TextData[{
 "At a fixed number of T gates the stabilizer frame keeps the same number of \
terms as qubits are added (each term, a tableau, grows only polynomially), \
while the state vector doubles with each qubit; and after ",
 Cell[BoxData[
  RowBox[{
   StyleBox["T", "TI"], 
   StyleBox["H", "TI"], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 " the probability of finding ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 " comes out as the irrational ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "+", 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 ", exactly."
}], "Text",
 CellID->891183881,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->741634648,ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"],

Cell["7. How short can a gate on a superconducting qubit be?", "Section",
 CellID->359589406,ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " a transmon is an oscillator with a small anharmonicity. Keep five levels, \
drive an 8 ns \[Pi] pulse, and add a DRAG correction proportional to the \
pulse's time derivative; everything is one parametrized ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 ". ",
 Cell[BoxData[
  RowBox[{"pulse", "[", 
   RowBox[{"levels", ",", " ", 
    RowBox[{"{", 
     RowBox[{
     "A", ",", " ", "\[Lambda]", ",", " ", "\[Delta]", ",", " ", "\[Tau]"}], 
     "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 " evolves the transmon from ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 " under a pulse of amplitude ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 " (",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 " is a \[Pi] pulse), DRAG coefficient ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 ", detuning ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e44340b-ef5c-51d5-667b-ae548ae9233f"],
 " and length ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"],
 " in ns; ",
 Cell[BoxData[
  RowBox[{"s", "[", "t", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 " is the state at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 "."
}], "Text",
 CellID->533832725,ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"pulse", "[", 
          RowBox[{"5", ",", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "drag", ",", " ", "0", ",", " ", "8"}], 
            "}"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"s", "[", "tt", "]"}], "[", "\"\<ProbabilitiesList\>\"",
               "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", " ", "3"}], "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"tt", ",", " ", "0", ",", " ", "8", ",", " ", "0.1"}], 
             "}"}]}], "]"}]}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "8"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", "\n", "    ", 
         RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<time (ns)\>\"", ",", " ", "\"\<population\>\""}], 
           "}"}]}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"drag", " ", "==", " ", "0"}], ",", 
            " ", "\"\<plain pulse\>\"", ",", 
            " ", "\"\<with DRAG (\[Lambda] = 1)\>\""}], "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<|0\[RightAngleBracket]\>\"", ",", 
            " ", "\"\<|1\[RightAngleBracket]\>\"", ",", 
            " ", "\"\<|2\[RightAngleBracket]\>\""}], "}"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "330"}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"drag", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Spacer", "[", "10", "]"}]}], "]"}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->739917449,ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

Cell[TextData[{
 "The plain pulse visibly pushes population into ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],
 ", outside the qubit; DRAG suppresses that leakage during the pulse."
}], "Text",
 CellID->473762610,ExpressionUUID->"13ecd9ee-6506-67bb-4193-d0c80cb34d81"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1751712322,ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell["Suppressing leakage is not the same as completing the flip", \
"Subsection",
 CellID->1390140890,ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

Cell[TextData[{
 "Scan the DRAG coefficient at 8 ns and track both errors. ",
 Cell[BoxData["finalPopulations"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 " returns the level populations at the end of the pulse: leakage is the \
population above ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 ", transfer error is ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SubscriptBox[
    StyleBox["P", "TI"], 
    TemplateBox[{"1"},
     "Ket"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb02373-2484-618c-364f-bb3d4d3133d6"],
 "."
}], "Text",
 CellID->1031105928,ExpressionUUID->"640353f1-ff8e-e9b3-0c31-4abafa38bb99"],

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", " ", "=", " ", 
          RowBox[{"finalPopulations", "[", 
           RowBox[{"5", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "drag", ",", " ", "0", ",", " ", "8"}], 
             "}"}]}], "]"}]}], "}"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"drag", ",", " ", 
            RowBox[{"Total", "[", 
             RowBox[{"p", "[", 
              RowBox[{"[", 
               RowBox[{"3", " ", ";;"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"drag", ",", " ", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "}"}]}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"drag", ",", " ", "0", ",", " ", "2", ",", " ", "0.1"}], 
       "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<leakage\>\"", ",", " ", "\"\<transfer error\>\""}], "}"}]}],
    ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<DRAG coefficient \[Lambda]\>\"", ",", 
      " ", "\"\<probability\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]], "Input",
 CellLabel->"In[45]:= ",
 CellID->1410588720,ExpressionUUID->"37161f66-4600-a3a8-5d2d-974073baf1f2"],

Cell[TextData[{
 "Leakage is smallest near the weak-drive value ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[TildeTilde]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 ", but the flip is most complete well below it, so amplitude, detuning and \
DRAG must be calibrated together. These runs are closed-system; the \
tutorial's full scan under the Lindblad equation finds that the speed limit \
is then set by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 ", not by leakage."
}], "Text",
 CellID->1051974278,ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1989924844,ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell["8. Why are photon amplitudes expensive to compute?", "Section",
 CellID->695529426,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " the probability of an output pattern is a permanent for bosons, a \
permanent of ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      StyleBox["W", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 " for distinguishable particles, and a determinant for fermions. Compare the \
three on one balanced beam splitter. ",
 Cell[BoxData["bosonProb"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 ", ",
 Cell[BoxData["distProb"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 " and ",
 Cell[BoxData[
  RowBox[{"fermionProb", "[", 
   RowBox[{"W", ",", " ", "s", ",", " ", "t"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 " give the probability of output pattern ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 " from input pattern ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 " through transfer matrix ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 "; ",
 Cell[BoxData["Wbs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 " is the balanced splitter's transfer matrix."
}], "Text",
 CellID->767788723,ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],

Cell[BoxData[
 RowBox[{"BarChart", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Through", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bosonProb", ",", " ", "distProb", ",", " ", "fermionProb"}],
          "}"}], "[", 
        RowBox[{"Wbs", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "out"}], "]"}], 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"out", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], ",",
    "\n", " ", 
   RowBox[{"ChartLabels", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<bosons\>\"", ",", " ", "\"\<classical particles\>\"", ",",
         " ", "\"\<fermions\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<|2,0\[RightAngleBracket]\>\"", ",", 
        " ", "\"\<|1,1\[RightAngleBracket]\>\"", ",", 
        " ", "\"\<|0,2\[RightAngleBracket]\>\""}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", "\"\<probability\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "500"}]}], "]"}]], "Input",
 CellLabel->"In[46]:= ",
 CellID->494419947,ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell["\<\
Bosons always leave together, classical particles split half the time, \
fermions never leave together. Bosons and fermions differ only in the sign of \
the exchange term; distinguishable particles have no exchange term at all.\
\>", "Text",
 CellID->1581507689,ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->2120100675,ExpressionUUID->"38a9ac88-4644-6c0e-6856-45d273f13754"],

Cell["What one amplitude costs", "Subsection",
 CellID->950326543,ExpressionUUID->"64802aa2-b136-451c-0cbf-c30fc0c32c66"],

Cell[TextData[{
 "Time to compute one output amplitude in a random ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 "-mode network, for three ways of loading ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 " photons. ",
 Cell[BoxData[
  RowBox[{"occupations", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],
 " gives the three input patterns, ",
 Cell[BoxData[
  RowBox[{"randomInterferometer", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
 " a fixed random network, and ",
 Cell[BoxData[
  RowBox[{"timeAmplitude", "[", 
   RowBox[{"q", ",", " ", "s"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 " the seconds one amplitude takes from a cleared cache."
}], "Text",
 CellID->1689126594,ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"timings", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"n", ",", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q", " ", "=", " ", 
           RowBox[{"randomInterferometer", "[", "n", "]"}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"timeAmplitude", "[", 
            RowBox[{"q", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"occupations", "[", "n", "]"}]}]}], "]"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Range", "[", 
      RowBox[{"4", ",", " ", "22", ",", " ", "2"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Keys", "[", "timings", "]"}], ",", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"Values", "[", "timings", "]"}], ",", " ", "kind"}], 
         "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"kind", ",", " ", 
       RowBox[{"Keys", "[", 
        RowBox[{"First", "[", "timings", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
   " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Keys", "[", 
     RowBox[{"First", "[", "timings", "]"}], "]"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<photons n\>\"", ",", " ", "\"\<seconds per amplitude\>\""}],
      "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}], "Input",
 CellLabel->"In[47]:= ",
 CellID->1490757098,ExpressionUUID->"7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],

Cell["\<\
One photon per mode and photons in pairs cost the same, and that cost grows \
exponentially with every photon; all photons in one mode stays cheap. \
Computing a probability is not yet sampling: distinguishable photons also \
have permanent probabilities, yet are easy to sample. The hardness argument \
of Aaronson and Arkhipov works where modes far outnumber photons, so that \
almost every output is of the expensive, collision-free kind, and turns that \
cost into sampling hardness through complexity theory.\
\>", "Text",
 CellID->148290444,ExpressionUUID->"41ecc127-3c02-05fa-7793-d881b5b76fc0"],

