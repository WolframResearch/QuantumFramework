 CellTags->"SlideShowHeader",
 CellID->1707667820,ExpressionUUID->"1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],

Cell["What answered each question", "Section",
 CellID->933399197,ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[TextData[{
 StyleBox["Decaying qubit:",
  FontWeight->"Bold"],
 " the master equation solved once with every rate symbolic, and a bound \
proved by ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdf78a7-59a9-97d9-15e5-7101585dfd23"],
 "."
}], "ItemNumbered",
 CellID->955179929,ExpressionUUID->"7a87483f-bfa4-2eb6-2abd-62793a51749c"],

Cell[TextData[{
 StyleBox["Watched qubit:",
  FontWeight->"Bold"],
 " an exact Liouvillian spectrum, with the Zeno freeze read off its \
exceptional point."
}], "ItemNumbered",
 CellID->775067320,ExpressionUUID->"09b26917-59e6-8729-3f41-81515f90ea73"],

Cell[TextData[{
 StyleBox["Continuous error:",
  FontWeight->"Bold"],
 " measurement records as circuit wires, giving an exact symbolic \
correction."
}], "ItemNumbered",
 CellID->72268088,ExpressionUUID->"521ad179-838d-ce9b-0239-c923363994e1"],

Cell[TextData[{
 StyleBox["Watched particle:",
  FontWeight->"Bold"],
 " a Riccati equation solved and proved for all parameters, and a Kalman \
filter built on it that tracks a full wavefunction simulation."
}], "ItemNumbered",
 CellID->546416532,ExpressionUUID->"136d7364-bcfb-8461-4113-6b4e348fef4b"],

Cell[TextData[{
 StyleBox["Beam splitter:",
  FontWeight->"Bold"],
 " photon numbers kept as symbols, so laws hold for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"],
 ", and every network draws itself."
}], "ItemNumbered",
 CellID->2117784656,ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[TextData[{
 StyleBox["Without a state vector:",
  FontWeight->"Bold"],
 " stabilizer algebra, exact at a thousand qubits."
}], "ItemNumbered",
 CellID->853117843,ExpressionUUID->"6879dfe8-0276-0c7b-1806-d6b2b7035741"],

Cell[TextData[{
 StyleBox["Fast gate:",
  FontWeight->"Bold"],
 " one parametrized pulse model, evolved and scanned."
}], "ItemNumbered",
 CellID->623836386,ExpressionUUID->"7cc522fa-6a93-e579-24fa-bba40f27cc43"],

Cell[TextData[{
 StyleBox["Photon amplitudes:",
  FontWeight->"Bold"],
 " permanents and determinants for the three particle statistics, and the \
measured cost of permanent amplitudes."
}], "ItemNumbered",
 CellID->564394165,ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

