Notebook[{
Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["Asking Physics Questions of the Wolfram Language", "Title",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["\<\
Eight questions answered by computation, with QuantumFramework\
\>", "Subtitle",
 CellID->1699946459,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["Mohammad Bahrami, Wolfram Research", "Subsubtitle",
 CellID->1535504786,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1208482393,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["Eight questions", "Section",
 CellID->28909615,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[TextData[{
 "What does a precessing, decaying qubit do, for every rate at once? ",
 StyleBox["The master equation solved symbolically.", "TI"]
}], "ItemNumbered",
 CellID->193832008,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[TextData[{
 "Does watching a qubit speed it up or freeze it? ",
 StyleBox["A Liouvillian spectrum in closed form.", "TI"]
}], "ItemNumbered",
 CellID->684317082,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[TextData[{
 "Can a continuous error be fixed by a discrete correction? ",
 StyleBox["Measurement records as circuit wires.", "TI"]
}], "ItemNumbered",
 CellID->528485616,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[TextData[{
 "Can watching a particle squeeze it below its zero-point motion? ",
 StyleBox["A Riccati equation solved and proved for all parameters.", "TI"]
}], "ItemNumbered",
 CellID->1392207227,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[TextData[{
 "What does a beam splitter do to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " photons, for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 "? ",
 StyleBox["Photon numbers kept as symbols.", "TI"]
}], "ItemNumbered",
 CellID->705466992,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 "How far can exact simulation go without a state vector? ",
 StyleBox["Stabilizer algebra.", "TI"]
}], "ItemNumbered",
 CellID->1350516518,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[TextData[{
 "How short can a gate on a superconducting qubit be? ",
 StyleBox["A five-level pulse model, evolved and scanned.", "TI"]
}], "ItemNumbered",
 CellID->907546795,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[TextData[{
 "Why are photon amplitudes expensive to compute? ",
 StyleBox["Permanents and their cost.", "TI"]
}], "ItemNumbered",
 CellID->814772321,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1054628905,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell["\<\
1. What does a precessing, decaying qubit do, for every rate at once?\
\>", "Section",
 CellID->2043779557,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " solve the Lindblad equation once, with the precession frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 ", the relaxation rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 ", the dephasing rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " and all four entries ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"i", "j"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 " of the initial state left as symbols. In the code ",
 Cell[BoxData["\[Sigma]m"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 " is the lowering operator ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], 
   TemplateBox[{"1"},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],
 " (the jump operator for relaxation) and ",
 Cell[BoxData["\[Rho]0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " is the symbolic initial density matrix with entries ",
 Cell[BoxData[
  RowBox[{"\[Rho]", "[", 
   RowBox[{"i", ",", " ", "j"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 "."
}], "Text",
 CellID->17830494,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[CapitalOmega]", " ", "\[Element]", " ", "Reals"}], " ", "&&", 
     " ", 
     RowBox[{"t", " ", ">=", " ", "0"}]}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"\[Rho]t", " ", "=", " ", 
      RowBox[{"QuantumEvolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]1", "]"}], " ", "\[Sigma]m"}], ",", 
          " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[Gamma]\[Phi]", "]"}], " ", 
           RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], "}"}], ",",
         " ", "\[Rho]0", ",", " ", "t"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"FullSimplify", " ", "/@", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"\[Rho]t", "[", "\"\<Computational\>\"", "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}]}]}], "]"}], " ", "//", 
  " ", "MatrixForm"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1589986527,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[TextData[{
 "The complete relaxation law of a qubit under amplitude damping and pure \
dephasing. Populations relax at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " and never feel ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 "; coherences rotate at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " and decay at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "/", "2", "+", "2", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 "."
}], "Text",
 CellID->943101875,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->67888809,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["The same solution, drawn on the Bloch sphere", "Subsection",
 CellID->1432876021,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[TextData[{
 "Take the Bloch vector of the symbolic solution, set every entry ",
 Cell[BoxData[
  RowBox[{"\[Rho]", "[", 
   RowBox[{"i", ",", " ", "j"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " of the initial state to ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " (the state ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 "), fix ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", "2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 ", and pick three rate pairs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 ": relaxation only, relaxation with dephasing, and fast relaxation."
}], "Text",
 CellID->876231958,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ResourceFunction", "[", "\"\<BlochSpherePlot\>\"", "]"}], "[", 
    "]"}], ",", "\n", " ", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Rho]t", "[", "\"\<BlochVector\>\"", "]"}], " ", "/.", 
           " ", 
           RowBox[{
            RowBox[{"\[Rho]", "[", 
             RowBox[{"_", ",", " ", "_"}], "]"}], " ", "->", " ", 
            RowBox[{"1", "/", "2"}]}]}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[CapitalOmega]", " ", "->", " ", 
             RowBox[{"2", " ", "Pi"}]}], ",", " ", 
            RowBox[{"\[Gamma]1", " ", "->", " ", "#1"}], ",", " ", 
            RowBox[{"\[Gamma]\[Phi]", " ", "->", " ", "#2"}]}], "}"}]}], 
         "]"}], " ", "&"}], " ", "@@@", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.2", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.2", ",", " ", "0.5"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1.5", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "12"}], "}"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", "Thick"}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<relaxation\>\"", ",", 
        " ", "\"\<relaxation + dephasing\>\"", ",", 
        " ", "\"\<fast relaxation\>\""}], "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1020575516,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[TextData[{
 "Every trajectory spirals to the same pole, ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 "; dephasing only pulls the spiral inward faster, toward the axis."
}], "Text",
 CellID->1967685850,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1044562475,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " is a theorem, not a rule of thumb"
}], "Subsection",
 CellID->1653200050,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", "1", "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "1", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], "/", "2", "+", "2", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 " read off the solution, ask ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " whether the bound holds for every admissible rate."
}], "Text",
 CellID->1384978530,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{"ForAll", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[Phi]"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}]}], ",", " ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Gamma]\[Phi]"}]}], ")"}]}], " ", "<=", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->519689844,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["\<\
It holds for all rates, with equality exactly when pure dephasing vanishes.\
\>", "Text",
 CellID->1609367578,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1541450781,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell["2. Does watching a qubit speed it up or freeze it?", "Section",
 CellID->1657269721,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " a qubit Rabi-driven at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 " while ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " is measured at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " has a Liouvillian whose spectrum can be found exactly. In the code ",
 Cell[BoxData[
  RowBox[{"liouvillian", "[", 
   RowBox[{"H", ",", " ", 
    RowBox[{"{", "L", "}"}], ",", " ", "d"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " builds the Lindblad generator for Hamiltonian ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " and jump operators ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " on a ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 "-level system, and ",
 Cell[BoxData["X"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 ", ",
 Cell[BoxData["Z"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 " are Pauli matrices."
}], "Text",
 CellID->1140508347,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell[BoxData[
 RowBox[{"ev", " ", "=", " ", 
  RowBox[{"Eigenvalues", "@", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"liouvillian", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], " ", "X"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", "k", "]"}], " ", "Z"}], "}"}], ",", " ", "2"}], 
      "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"k", " ", ">", " ", "0"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->496109794,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[TextData[{
 "Two of the four rates, ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 ", carry the Rabi oscillation. They meet at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 ", an exceptional point."
}], "Text",
 CellID->108435171,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->829388421,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell["The two rates collide and separate", "Subsection",
 CellID->203008389,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[TextData[{
 "Follow the Rabi pair (",
 Cell[BoxData[
  RowBox[{"ev", "[", 
   RowBox[{"[", 
    RowBox[{"3", " ", ";;", " ", "4"}], "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 ", the last two eigenvalues) in the complex plane as the measurement \
strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " grows from ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " to ",
 Cell[BoxData[
  RowBox[{"3", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 ", in units ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 "."
}], "Text",
 CellID->1090263105,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ReIm", "[", 
       RowBox[{
        RowBox[{"ev", "[", 
         RowBox[{"[", 
          RowBox[{"3", " ", ";;", " ", "4"}], "]"}], "]"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"k", " ", "->", " ", "kk"}]}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"kk", ",", " ", "0", ",", " ", "3", ",", " ", "0.02"}], 
       "}"}]}], "]"}]}], ",", "\n", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Re \[Lambda] / \[CapitalOmega]  (minus the decay rate)\>\"",
       ",", " ", "\"\<Im \[Lambda] / \[CapitalOmega]  (frequency)\>\""}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{"-", "k"}], " ", "-", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"k", "^", "2"}], " ", "-", " ", 
           RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], "]"}], "]"}], ",",
       " ", 
      RowBox[{"TraditionalForm", "[", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{"-", "k"}], " ", "+", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"k", "^", "2"}], " ", "-", " ", 
           RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], "]"}], "]"}]}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", 
      RowBox[{"PointSize", "[", "Large", "]"}], ",", " ", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "]"}]}], "}"}]}], ",", 
   " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1560876240,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[TextData[{
 "Below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 " the pair moves left together, oscillating while decaying faster. At the \
red point the oscillation dies; beyond it one rate runs off to fast decay and \
the other returns toward zero."
}], "Text",
 CellID->176337227,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->807053435,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell["Watching harder freezes the qubit", "Subsection",
 CellID->1633675818,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell[TextData[{
 "Expand the slower rate of the pair, ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "+", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 ", at strong measurement, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[GreaterGreater]", "\[CapitalOmega]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 "."
}], "Text",
 CellID->1828793009,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[BoxData[
 RowBox[{"Normal", "@", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "k"}], " ", "+", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"k", "^", "2"}], " ", "-", " ", 
       RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "Infinity", ",", " ", "1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->1232986364,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[TextData[{
 "Now plot both features of the Rabi pair against ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   StyleBox["k", "TI"], "/", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 ", each as a positive number in units of ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 ": its damped Rabi frequency ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "-", 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 ", which exists only below the exceptional point, and the slowest decay \
rate, which is ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 " below it and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " above it."
}], "Text",
 CellID->762269937,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "@", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"r", "^", "2"}]}], "]"}]}], ",", " ", 
     RowBox[{"r", " ", "-", " ", 
      RowBox[{"Re", "@", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", "-", " ", "1"}], "]"}]}]}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"r", ",", " ", "0", ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "1", "}"}], ",", " ", "None"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<damped Rabi frequency / \[CapitalOmega]\>\"", ",", 
      " ", "\"\<slowest decay rate / \[CapitalOmega]\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<k/\[CapitalOmega]\>\"", ",", 
      " ", "\"\<frequency or rate / \[CapitalOmega]\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->405213039,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[TextData[{
 "Measurement speeds relaxation only up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 "; beyond it the qubit freezes at the rate ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 ", the quantum Zeno effect."
}], "Text",
 CellID->2118931930,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1039057480,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"],

Cell["The same machinery gives the light an atom emits", "Subsection",
 CellID->1411198270,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[TextData[{
 "Now the jump operator is spontaneous decay instead of a ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 " measurement, at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 ", which sets the units of drive and detuning; ",
 Cell[BoxData[
  RowBox[{"mollow", "[", 
   RowBox[{"\[CapitalOmega]", ",", " ", "tones"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 " returns the inelastic spectrum at drive ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 " on a list of detunings. Two-time correlations follow from this Liouvillian \
(quantum regression), so a fluorescence spectrum is one linear solve per \
frequency."
}], "Text",
 CellID->1703453532,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tones", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "9"}], ",", " ", "9", ",", " ", "0.05"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"weak", ",", " ", "strong"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"mollow", "[", 
      RowBox[{"#", ",", " ", "tones"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.6", ",", " ", "6."}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"weak", "/", 
         RowBox[{"Max", "[", "weak", "]"}]}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tones", ",", " ", 
        RowBox[{"strong", "/", 
         RowBox[{"Max", "[", "strong", "]"}]}]}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalOmega] = 0.6\[Gamma]\>\"", ",", 
      " ", "\"\<\[CapitalOmega] = 6\[Gamma]\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<detuning from the drive / \[Gamma]\>\"", ",", 
      " ", "\"\<inelastic spectrum (scaled to peak)\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[8]:= ",
 CellID->1477609488,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[TextData[{
 "A strong drive dresses the atom and splits its single line into three, with \
sidebands at ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 ": the Mollow triplet."
}], "Text",
 CellID->1030824397,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->100031176,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell["3. Can a continuous error be fixed by a discrete correction?", "Section",
 CellID->144223354,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " in QuantumFramework a measurement result is a wire in the circuit. Encode \
one qubit in three, rotate the middle one by an arbitrary angle ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 ", measure two parities onto record wires, and correct with gates controlled \
by those records. The setup file builds this circuit as ",
 Cell[BoxData["qec"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"],
 "."
}], "Text",
 CellID->1443527617,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"qec", "[", "\"\<Diagram\>\"", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "650"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->311511756,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1381425643,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell["The rotation becomes a coin toss", "Subsection",
 CellID->377280352,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

Cell[TextData[{
 "Here ",
 Cell[BoxData["coded"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 " is the output of ",
 Cell[BoxData["qec"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " acting on ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      StyleBox["\[Alpha]", "TI"], 
      TemplateBox[{"0"},
       "Ket"]}], "+", 
     RowBox[{
      StyleBox["\[Beta]", "TI"], 
      TemplateBox[{"1"},
       "Ket"]}]}], ")"}], 
   TemplateBox[{"00"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 ", and ",
 Cell[BoxData["asQEC"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " declares ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], ",", 
   StyleBox["\[Beta]", "TI"], ",", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 " real with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"], "+", 
   SuperscriptBox[
    StyleBox["\[Beta]", "TI"], "2"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 ". Tracing out the three data qubits leaves the joint distribution of the \
two parity records."
}], "Text",
 CellID->1717363484,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData[
 RowBox[{"syndromes", " ", "=", " ", 
  RowBox[{"Assuming", "[", 
   RowBox[{"asQEC", ",", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Diagonal", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{"QuantumPartialTrace", "[", 
          RowBox[{"coded", ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}], 
         "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1781880651,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[TextData[{
 "The four entries are the probabilities of the record pairs 00, 01, 10, 11. \
Plot the first and last against ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 ": both parities even (no error) and both odd (qubit 2 flipped)."
}], "Text",
 CellID->1536527082,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"syndromes", "[", 
     RowBox[{"[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], "]"}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<no error detected\>\"", ",", 
      " ", "\"\<qubit 2 flipped\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]  (qubit 2 rotated by 2\[Theta])\>\"", ",", 
      " ", "\"\<probability\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1621535814,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[TextData[{
 "Only two outcomes ever occur, with probabilities ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 ", independent of ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 "."
}], "Text",
 CellID->1193935837,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->105329933,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell["And the correction is exact", "Subsection",
 CellID->1234416869,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[TextData[{
 "Tracing out the two records leaves the corrected data qubits; compare them \
with the ideal encoded state, ",
 Cell[BoxData["enc"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 " (the encoding circuit alone) applied to the same input."
}], "Text",
 CellID->240380995,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{"asQEC", ",", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{"coded", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", "\n", "   ", 
       RowBox[{"enc", "[", 
        RowBox[{"QuantumTensorProduct", "[", 
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
          RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}], ",",
        " ", "\"\<Fidelity\>\""}], "]"}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1771870337,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

Cell["\<\
Fidelity 1 for every real-amplitude input and every angle. Measurement turns \
a continuous error into a discrete one, which is why quantum error correction \
works at all.\
\>", "Text",
 CellID->305160771,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1896945989,ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell["\<\
4. Can watching a particle squeeze it below its zero-point motion?\
\>", "Section",
 CellID->653417278,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " for a particle in a harmonic trap whose position is measured continuously \
at strength ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 ", the uncertainties of the conditional state obey a Riccati equation. Its \
steady state comes out with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], ",", 
   StyleBox["\[Omega]", "TI"], ",", 
   StyleBox["m", "TI"], ",", "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " symbolic: ",
 Cell[BoxData["SxSS"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ", ",
 Cell[BoxData["SpSS"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 " and ",
 Cell[BoxData["CcSS"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 " are the steady position variance ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox[
    RowBox[{"x", "x"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 ", momentum variance ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox[
    RowBox[{"p", "p"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 " and position-momentum covariance ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox[
    RowBox[{"x", "p"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 "; ",
 Cell[BoxData["asTrap"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " says all four parameters are positive; ",
 Cell[BoxData[
  RowBox[{"sqRatio", "[", "\[Mu]", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " is the closed-form ratio of the steady position variance to the zero-point \
variance ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", "2", 
   StyleBox["m", "TI"], 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
 "."
}], "Text",
 CellID->1067269536,ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SxSS", " ", "SpSS"}], " ", "-", " ", 
      RowBox[{"CcSS", "^", "2"}]}], ",", " ", "asTrap"}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SxSS", "/", 
       RowBox[{"(", 
        RowBox[{"\[HBar]", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m", " ", "\[Omega]"}], ")"}]}], ")"}]}], " ", "==",
       " ", 
      RowBox[{"sqRatio", "[", 
       RowBox[{"2", " ", "\[HBar]", " ", 
        RowBox[{"\[Lambda]", "/", 
         RowBox[{"(", 
          RowBox[{"m", " ", 
           RowBox[{"\[Omega]", "^", "2"}]}], ")"}]}]}], "]"}]}], ",", " ", 
     "asTrap"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->49659130,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[TextData[{
 "The steady state is pure (its covariance determinant ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "x"}], "TI"]], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"p", "p"}], "TI"]], "-", 
   SubsuperscriptBox["\[CapitalSigma]", 
    StyleBox[
     RowBox[{"x", "p"}], "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 " takes the minimum value ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[HBar]", "2"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 "), and its position spread depends only on one number, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 "."
}], "Text",
 CellID->464508221,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1361313038,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell["Squeezed at every measurement strength", "Subsection",
 CellID->1907680634,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[TextData[{
 Cell[BoxData["Resolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " decides whether the position variance is below the zero-point value for \
every ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 "."
}], "Text",
 CellID->483148123,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[BoxData[
 RowBox[{"Resolve", "[", 
  RowBox[{
   RowBox[{"ForAll", "[", 
    RowBox[{"\[Mu]", ",", " ", 
     RowBox[{"\[Mu]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"sqRatio", "[", "\[Mu]", "]"}], " ", "<", " ", "1"}]}], "]"}], ",",
    " ", "Reals"}], "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->1195452142,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[TextData[{
 "The exact ratio against ",
 Cell[BoxData[
  StyleBox["\[Mu]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 ", with its weak-measurement limit ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["\[Mu]", "TI"], "2"], "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 " and strong-measurement limit ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "/", 
    StyleBox["\[Mu]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 " dashed."
}], "Text",
 CellID->1521685512,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"sqRatio", "[", "\[Mu]", "]"}], ",", " ", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{
       RowBox[{"\[Mu]", "^", "2"}], "/", "8"}]}], ",", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "/", "\[Mu]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Mu]", ",", " ", "0", ",", " ", "12"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.1"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", " ", "Dashed", ",", " ", "Dashed"}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<exact\>\"", ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<weak limit  \>\"", ",", " ", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"HoldForm", "[", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{
             RowBox[{"\[Mu]", "^", "2"}], "/", "8"}]}], "]"}], "]"}]}], "}"}],
        "]"}], ",", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<strong limit  \>\"", ",", " ", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"HoldForm", "[", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"2", "/", "\[Mu]"}], "]"}], "]"}], "]"}]}], "}"}], 
       "]"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<measurement strength \[Mu]\>\"", ",", 
      " ", "\"\<position variance / zero-point variance\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->97201263,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[TextData[{
 "Watching always squeezes the position below the zero-point value: slowly \
for weak measurement, as ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{"2", "/", 
    StyleBox["\[Mu]", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6ad260-8ee1-565a-1569-d44a2a943ca0"],
 " for strong."
}], "Text",
 CellID->878831761,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->1048559713,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell["What an imperfect detector costs", "Subsection",
 CellID->300048012,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[TextData[{
 "A detector that catches a fraction ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
 " of the signal weakens the information gain but not the measurement kick. \
In the steady solution this is the substitution ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "\[Rule]", 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["\[Lambda]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b5b884-ef74-61b3-534a-31e18a013399"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "\[Rule]", "\[HBar]", "/", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"],
 ", after which the purity of the Gaussian state is ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", "2", 
   SqrtBox[
    RowBox[{
     SubscriptBox["\[CapitalSigma]", 
      StyleBox[
       RowBox[{"x", "x"}], "TI"]], 
     SubscriptBox["\[CapitalSigma]", 
      StyleBox[
       RowBox[{"p", "p"}], "TI"]], "-", 
     SubsuperscriptBox["\[CapitalSigma]", 
      StyleBox[
       RowBox[{"x", "p"}], "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 "."
}], "Text",
 CellID->1962937852,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sol", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"SxSS", ",", " ", "CcSS", ",", " ", "SpSS"}], "}"}], " ", "/.",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Lambda]", " ", "->", " ", 
         RowBox[{"\[Eta]", " ", "\[Lambda]"}]}], ",", " ", 
        RowBox[{"\[HBar]", " ", "->", " ", 
         RowBox[{"\[HBar]", "/", 
          RowBox[{"Sqrt", "[", "\[Eta]", "]"}]}]}]}], "}"}]}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"\[HBar]", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sol", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", 
           RowBox[{"sol", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"sol", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}], "]"}]}], ")"}]}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[HBar]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}], ",", " ", 
       
       RowBox[{"\[Lambda]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"\[Omega]", " ", ">", " ", "0"}], ",", " ", 
       RowBox[{"m", " ", ">", " ", "0"}]}], "}"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[16]:= ",
 CellID->588230824,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

Cell[TextData[{
 "The steady purity is exactly ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 ", whatever the trap, the mass or the measurement strength."
}], "Text",
 CellID->2099309037,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->512383039,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell["The watched particle, reading by reading", "Subsection",
 CellID->273308241,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[TextData[{
 "The full wavefunction on a 256-point grid, updated by Bayes' rule after \
every noisy position reading and evolved in the trap between readings (",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", 
   StyleBox["\[Omega]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 "). ",
 Cell[BoxData["states"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " holds the wavefunction after every step on the grid ",
 Cell[BoxData["gH"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 ", and ",
 Cell[BoxData[
  RowBox[{"ntH", " ", "dtH"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " is the total time; the plot shows every sixth step for ",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      StyleBox["x", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "<", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 "."
}], "Text",
 CellID->1809098798,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"keep", " ", "=", " ", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{"gH", "[", "\"\<x\>\"", "]"}], ",", " ", 
        RowBox[{"x_", " ", "/;", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], " ", "<", " ", "3"}]}]}], "]"}]}]}],
     "}"}], ",", "\n", " ", 
   RowBox[{"ListDensityPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"states", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{";;", " ", ";;", " ", "6"}], ",", " ", "keep"}], "]"}], 
         "]"}], "]"}], "^", "2"}], "]"}], ",", " ", 
     RowBox[{"DataRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"ntH", " ", "dtH"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "3"}], ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",", 
     " ", 
     RowBox[{"AspectRatio", " ", "->", " ", 
      RowBox[{"1", "/", "2.5"}]}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", " ", "\"\<position x\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"ImageSize", " ", "->", " ", "600"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[17]:= ",
 CellID->156430199,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell["\<\
The packet stays narrow while its center wanders with the readings: \
measurement localizes it and kicks it at the same time.\
\>", "Text",
 CellID->724760089,ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->168408080,ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

Cell["Five numbers do the job of 256 amplitudes", "Subsection",
 CellID->811283638,ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"],

Cell[TextData[{
 "A quantum Kalman filter (two means and three second moments, fed only the \
readings) against the mean of the full wavefunction: ",
 Cell[BoxData["xGrid"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " from the grid, ",
 Cell[BoxData["mFilter"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 " the filter's estimate."
}], "Text",
 CellID->207978548,ExpressionUUID->"10beb8bd-bdb6-ee93-4045-31e73440b4f9"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xGrid", ",", " ", "mFilter"}], "}"}], ",", " ", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"ntH", " ", "dtH"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", " ", "Gray"}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", " ", "Dashed"}], "]"}]}], "}"}]}], ",", "\n", " ", 
   
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<full wavefunction (256 amplitudes)\>\"", ",", 
      " ", "\"\<Kalman filter (5 numbers)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", 
      " ", "\"\<\[LeftAngleBracket]x\[RightAngleBracket]\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "550"}]}], "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->437474228,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell["\<\
The two curves agree up to the finite time step. In a harmonic trap the \
conditional state stays Gaussian, so in continuous time the filter is exact, \
not an approximation.\
\>", "Text",
 CellID->874582697,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->11631581,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[TextData[{
 "5. What does a beam splitter do to ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 " photons, for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 "?"
}], "Section",
 CellID->1933762060,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[TextData[{
 StyleBox["Idea:",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData["QuantumInterferometer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c440104-ea8a-4285-747b-99618f3f10ef"],
 " keeps the photon numbers, angles and squeezing as symbols, and draws \
itself. Start with one beam splitter whose mixing angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c9a615-af45-c085-0ef6-385ecaf192ef"],
 " and phase ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0513e607-0f4c-1e20-3320-f861aaf9650a"],
 " are symbols."
}], "Text",
 CellID->1055776787,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[BoxData[
 RowBox[{"bs", " ", "=", " ", 
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BS\>\"", "[", 
     RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "]"}], "}"}], "]"}]}]], "Input",\

 CellLabel->"In[19]:= ",
 CellID->1859711813,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell["Its diagram: two modes entering one splitter.", "Text",
 CellID->1348896709,ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"bs", "[", "\"\<Diagram\>\"", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->1427211115,ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell[TextData[{
 "The amplitude from ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["n", "TI"], "2"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["n", "TI"], "1"], "+", 
      SubscriptBox[
       StyleBox["n", "TI"], "2"], "-", 
      SubscriptBox[
       StyleBox["t", "TI"], "1"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 ", with the photon numbers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 " also symbols (the splitter conserves the total)."
}], "Text",
 CellID->2099805207,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell[BoxData[
 RowBox[{"bs", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", 
      RowBox[{"n1", " ", "+", " ", "n2", " ", "-", " ", "t1"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1402006442,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[TextData[{
 "It is a Wigner ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 "-function: a beam splitter rotates a spin of size ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["n", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 ", and the photon numbers are its magnetic quantum numbers."
}], "Text",
 CellID->1901179466,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->210724908,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"],

Cell[TextData[{
 "Hong-Ou-Mandel for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"]
}], "Subsection",
 CellID->1992790374,ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 " photons in each port of a balanced splitter, with ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 " photons leaving in mode 1: the amplitude as one formula in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "335d55a2-cf9b-493d-6163-4c0fea2e1807"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 "."
}], "Text",
 CellID->292747604,ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[BoxData[
 RowBox[{"hom", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "4"}], ",", " ", "0"}], "]"}], "}"}], "]"}], "[", 
   RowBox[{"\"\<Amplitude\>\"", ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "n"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "n"}], " ", "-", " ", "k"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->1553818268,ExpressionUUID->"73e8aeff-5b91-f8f4-2197-47b95e25cade"],

Cell[TextData[{
 "Its square gives the output distribution; draw it for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e490f1-5bc8-e939-619b-09bb5e62b803"],
 " to ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 ", one bar for each ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 "."
}], "Text",
 CellID->1870754514,ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"BarChart", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"hom", " ", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n", " ", "->", " ", "m"}], ",", " ", 
              RowBox[{"k", " ", "->", " ", "j"}]}], "}"}]}], "]"}], "^", 
          "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", 
           RowBox[{"2", " ", "m"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"ChartLabels", " ", "->", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", " ", "m"}]}], "]"}]}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "   ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<photons in mode 1\>\"", ",", 
          " ", "\"\<probability\>\""}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<n = \>\"", ",", " ", "m"}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "220"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Spacer", "[", "10", "]"}]}], "]"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1358728755,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[TextData[{
 "Every odd split is exactly zero. This holds for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 ", not only those shown: the amplitude ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["d", "TI"], 
    RowBox[{"0", ",", 
     RowBox[{
      StyleBox["k", "TI"], "-", 
      StyleBox["n", "TI"]}]}], 
    RowBox[{"\[ThinSpace]", 
     StyleBox["n", "TI"]}]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"\[Pi]", "/", "2"}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 " is proportional to the Legendre function ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["n", "TI"], 
    RowBox[{
     StyleBox["k", "TI"], "-", 
     StyleBox["n", "TI"]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 ", which vanishes whenever ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " is odd. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 " is the familiar Hong-Ou-Mandel dip."
}], "Text",
 CellID->935019337,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->642744358,ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell["Four photons need an unbalanced splitter to cancel", "Subsection",
 CellID->1478372881,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[TextData[{
 "The amplitude ",
 Cell[BoxData["fa"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 " for ",
 Cell[BoxData[
  TemplateBox[{"2,2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " to come out as ",
 Cell[BoxData[
  TemplateBox[{"2,2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 " through a splitter of angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 ", checked against ",
 Cell[BoxData[
  RowBox[{"1", "-", "6", 
   StyleBox["R", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["R", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 " with reflectivity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 ", and the reflectivities where it vanishes."
}], "Text",
 CellID->124263719,ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fa", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumInterferometer", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}], "}"}], "]"}], "[", 
      RowBox[{"\"\<Amplitude\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fa", " ", "==", " ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"6", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}], ",", " ", 
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}], ",", " ", 
   RowBox[{"R", " ", "/.", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"6", " ", "R", " ", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "R"}], ")"}]}]}], " ", "==", " ", 
        "0"}], " ", "&&", " ", 
       RowBox[{"0", " ", "<", " ", "R", " ", "<", " ", "1"}]}], ",", " ", "R",
       ",", " ", "Reals"}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[24]:= ",
 CellID->1310926461,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "The return probability against ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 ", with the two zeros marked in red."
}], "Text",
 CellID->1124211690,ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"6", " ", "R", " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "R"}], ")"}]}]}], ")"}], "^", "2"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"R", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<reflectivity R\>\"", ",", 
      " ", "\"\<probability |2,2\[RightAngleBracket] \[Rule] |2,2\
\[RightAngleBracket]\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", 
      RowBox[{"PointSize", "[", "Large", "]"}], ",", " ", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", " ", "-", " ", 
            RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", "6"}], ",", " ", 
         "0"}], "}"}], "]"}], ",", " ", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", " ", "+", " ", 
            RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", "6"}], ",", " ", 
         "0"}], "}"}], "]"}]}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->1335749844,ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell[TextData[{
 "The amplitude is ",
 Cell[BoxData[
  RowBox[{"1", "-", "6", 
   StyleBox["R", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["R", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 ", zero at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"3", "\[PlusMinus]", 
    SqrtBox["3"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 " and not at the balanced point: the cancelling splitter changes with photon \
number."
}], "Text",
 CellID->793802945,ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->631769182,ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell["A sign flip no phase shifter can make", "Subsection",
 CellID->1873681340,ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell[TextData[{
 "The KLM nonlinear sign gate: ",
 Cell[BoxData["nsGate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5add4728-e92e-eff1-0ae3-5f7588d8b5db"],
 " is the three-mode network of a fixed real ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 " unitary from the setup file, drawn here."
}], "Text",
 CellID->1468251080,ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"nsGate", "[", "\"\<Diagram\>\"", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]], "Input",
 CellLabel->"In[26]:= ",
 CellID->1989234463,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[TextData[{
 "The input ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["n", "TI"]}], ",", "1", ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4139b36b-52b1-2977-70c6-2b356744785d"],
 " puts ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494d6e39-7750-b6eb-7f72-806302ea1c31"],
 " signal photons in mode 1 and one helper photon in mode 2; success is \
heralded by finding the helper pattern ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39b01e29-d171-5c92-6f4f-9072e00426f8"],
 " again. The heralded amplitude for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 " to ",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ad582f-66ff-93eb-3c53-5189128be131"],
 ":"
}], "Text",
 CellID->1607696641,ExpressionUUID->"4f7ea056-2d28-85ec-7505-3a1044c2ef36"],

Cell[BoxData[
 RowBox[{"RootReduce", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"nsGate", "[", 
     RowBox[{"\"\<Amplitude\>\"", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "1", ",", " ", "0"}], "}"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"n", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1817342824,ExpressionUUID->"16b00368-b832-202d-3e4f-9b3239c77377"],

Cell[TextData[{
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d00634-a672-f252-2eef-9871d304c0b8"],
 ", ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 " and ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 " signal photons get amplitudes ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], ",", 
   FractionBox["1", "2"], ",", 
   RowBox[{"-", 
    FractionBox["1", "2"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07beae85-a317-6bf9-2d45-47eed6a239c3"],
 ": a sign on ",
 Cell[BoxData[
  TemplateBox[{"2"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " alone, with success probability ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 " for every input. The three-photon amplitude differs, which is where the \
gate stops working."
}], "Text",
 CellID->530774412,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader",
 CellID->599957810,ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"],

Cell["Squeezed light comes in pairs", "Subsection",
 CellID->1899946997,ExpressionUUID->"114d8d02-b276-9c05-4772-256fc700e76f"],

Cell[TextData[{
 "Squeeze mode 1 with parameter ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 " and mode 2 with ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 ", then mix them on a balanced splitter."
}], "Text",
 CellID->1051619128,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell[BoxData[
 RowBox[{"pair", " ", "=", " ", 
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<S\>\"", "[", "r", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", 
       RowBox[{"-", "r"}], "]"}], " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"Pi", "/", "4"}], "]"}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1921351195,ExpressionUUID->"73216bcf-7cf1-61ac-22de-82a9748433f6"],

Cell["The network drawn: two squeezers followed by the splitter.", "Text",
 CellID->1207491739,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"pair", "[", "\"\<Diagram\>\"", "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "220"}]}], "]"}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->216741342,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[TextData[{
 "Starting from vacuum, the probability of ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 " photons in each output mode, for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["j", "TI"], "=", "0"}], ",", 
   RowBox[{"1", ",", "2"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 "."
}], "Text",
 CellID->2096934290,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"pair", "[", 
      RowBox[{"\"\<Probability\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "j"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"r", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->1367217003,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[TextData[{
 "Two checks: the probability of an unequal outcome, ",
 Cell[BoxData[
  TemplateBox[{"2,0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 ", and the pair law ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["r", "TI"], 
   SuperscriptBox[
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"2", 
     StyleBox["j", "TI"]}]], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 " summed over all ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 "."
}], "Text",
 CellID->1372538143,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pair", "[", 
      RowBox[{"\"\<Probability\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "0"}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sech", "[", "r", "]"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Tanh", "[", "r", "]"}], "^", 
         RowBox[{"(", 
          RowBox[{"2", " ", "j"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"r", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->485911656,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[TextData[{
 "Pair probabilities follow ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sech",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["r", "TI"], 
   SuperscriptBox[
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"2", 
     StyleBox["j", "TI"]}]], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 "; unequal outcomes vanish and the pair law sums to one, so the output modes \
always hold equal photon numbers: a two-mode squeezed vacuum."
}], "Text",
 CellID->181917407,ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell["\[NonBreakingSpace]", "SlideShowNavigationBar",
