Notebook[{
Cell["\<\
What Wolfram Language and QuantumFramework Compute Exactly: Worked Examples\
\>", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["\<\
Each example below asks one physics question with the parameters left as \
symbols, and the answer comes back as a formula, not a table of numbers. \
Every cell runs as written on QuantumFramework at commit ed916377.\
\>", "Text",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["Load the framework and its optics context:", "Text",
 CellID->1699946459,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`\>\"", "]"}], ";"}], "\n", 
 RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"",
   "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1535504786,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["\<\
A QAOA Layer on MaxCut: the Exact Optimum of the Energy Landscape\
\>", "Section",
 CellID->1208482393,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[TextData[{
 "One layer of the quantum approximate optimization algorithm prepares ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 ", applies ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Gamma]", "TI"], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["j", "TI"]], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " on every edge and ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox["X", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 " on every vertex, and scores the result by the expected cut ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}],
    LimitsPositioning->False], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["j", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "/", "2"}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 ". How good is the best choice of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Gamma]", "TI"], ",", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 "? A circuit simulator evaluates the landscape at sampled angles and hands \
the result to a numerical optimizer. Here the angles stay symbols, so the \
landscape is a formula and its maximum is a number known exactly."
}], "Text",
 CellID->28909615,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell[TextData[{
 "Build ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["\[Gamma]", "TI"], ",", 
       StyleBox["\[Theta]", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Bra"], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], 
   TemplateBox[{
     RowBox[{
       StyleBox["\[Psi]", "TI"], 
       StyleBox["(", SpanMaxSize -> 1], 
       StyleBox["\[Gamma]", "TI"], ",", 
       StyleBox["\[Theta]", "TI"], 
       StyleBox[")", SpanMaxSize -> 1]}]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " for any graph, straight from its edge list:"
}], "Text",
 CellID->193832008,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qaoa", "[", "graph_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", " ", "=", " ", 
        RowBox[{"List", " ", "@@@", " ", 
         RowBox[{"EdgeList", "[", "graph", "]"}]}]}], ",", " ", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"VertexCount", "[", "graph", "]"}]}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Psi]", " ", "=", " ", 
         RowBox[{
          RowBox[{"QuantumCircuitOperator", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<H\>\"", " ", "->", " ", 
              RowBox[{"Range", "[", "n", "]"}]}], ",", " ", 
             RowBox[{"Splice", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"\"\<R\>\"", "[", 
                   RowBox[{"\[Gamma]", ",", " ", "\"\<ZZ\>\""}], "]"}], " ", "->",
                   " ", "#"}], ")"}], " ", "&"}], " ", "/@", " ", "e"}], 
              "]"}], ",", " ", 
             RowBox[{
              RowBox[{"\"\<RX\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
              RowBox[{"Range", "[", "n", "]"}]}]}], "}"}], "]"}], "[", 
          "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]", "[", "\"\<Dagger\>\"", "]"}], "[", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"QuantumOperator", "[", 
                   RowBox[{"StringRepeat", "[", 
                    RowBox[{"\"\<I\>\"", ",", " ", "n"}], "]"}], "]"}], " ", "-",
                   " ", 
                  RowBox[{"QuantumOperator", "[", 
                   RowBox[{"\"\<ZZ\>\"", ",", " ", "#"}], "]"}]}], ")"}], "/",
                 "2"}], " ", "&"}], " ", "/@", " ", "e"}], "]"}], "[", 
            "\[Psi]", "]"}], "]"}], "[", "\"\<Scalar\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}], " ", "\[Element]",
           " ", "Reals"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"qaoa", "[", 
  RowBox[{"CycleGraph", "[", "3", "]"}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->684317082,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell["\<\
The triangle's landscape is a trigonometric polynomial in the two angles. \
Maximize it exactly:\
\>", "Text",
 CellID->528485616,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[BoxData[
 RowBox[{"Maximize", "[", 
  RowBox[{
   RowBox[{"qaoa", "[", 
    RowBox[{"CycleGraph", "[", "3", "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1392207227,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 "The maximum is ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 ", the classical maximum cut of a triangle (no two-coloring cuts all three \
edges of an odd cycle). In other words, one layer already finds the best cut \
with certainty here, and the optimal angles come back as exact closed forms, \
not as the output of a converged search."
}], "Text",
 CellID->705466992,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[TextData[{
 "The complete graph ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " is harder: its classical maximum cut is ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 " of ",
 Cell[BoxData["6"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " edges. Ask for the one-layer optimum:"
}], "Text",
 CellID->1350516518,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[BoxData[
 RowBox[{"First", " ", "@", " ", 
  RowBox[{"Maximize", "[", 
   RowBox[{
    RowBox[{"qaoa", "[", 
     RowBox[{"CompleteGraph", "[", "4", "]"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", ",", " ", "\[Theta]"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->907546795,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[TextData[{
 "The optimum is a root of a cubic, and it lies below ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],
 ". In other words, the exact landscape certifies that one layer cannot reach \
the true cut of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 "; a sampled optimizer could only report that it had not found a better \
point."
}], "Text",
 CellID->814772321,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[TextData[{
 "Check against the trivial circuit: at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 " the cost layer does nothing, the state is an equal superposition of all \
colorings, and each of the six edges is cut with probability ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 ":"
}], "Text",
 CellID->1054628905,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"qaoa", "[", 
    RowBox[{"CompleteGraph", "[", "4", "]"}], "]"}], " ", "/.", " ", 
   RowBox[{"\[Gamma]", " ", "->", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->2043779557,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 "Two Exchange-Coupled Spins: the Entanglement Entropy Is the Binary Entropy \
of ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"]
}], "Section",
 CellID->17830494,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[TextData[{
 "Two spins coupled by the Heisenberg exchange ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   StyleBox["J", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], 
    StyleBox["X", "TI"], "+", 
    StyleBox["Y", "TI"], 
    StyleBox["Y", "TI"], "+", 
    StyleBox["Z", "TI"], 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " start in the product state ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 ". How entangled are they at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 "? A numerical solver returns the entropy on a time grid for one value of ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 ". Here ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " stay symbols, and the entropy comes back as a function."
}], "Text",
 CellID->1589986527,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[TextData[{
 "Evolve ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 " and take the reduced state of the first spin:"
}], "Text",
 CellID->943101875,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"J", " ", "\[Element]", " ", "Reals"}], " ", "&&", " ", 
    RowBox[{"t", " ", "\[Element]", " ", "Reals"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"heis", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"J", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", "\"\<XX\>\"", "]"}], " ", "+", " ", 
        RowBox[{"QuantumOperator", "[", "\"\<YY\>\"", "]"}], " ", "+", " ", 
        RowBox[{"QuantumOperator", "[", "\"\<ZZ\>\"", "]"}]}], ")"}]}], ",", 
     " ", 
     RowBox[{"QuantumState", "[", "\"\<01\>\"", "]"}], ",", " ", "t"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"heis", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], 
   "]"}], "]"}]}], "Input",
 CellLabel->"In[6]:= ",
 CellID->67888809,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[TextData[{
 "The reduced state is diagonal with populations ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 ". The excitation swaps between the two spins at angular frequency ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 ", the singlet-triplet splitting, because ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " is an equal superposition of the singlet and the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " triplet."
}], "Text",
 CellID->1432876021,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 ":"
}], "Text",
 CellID->876231958,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell[BoxData[
 RowBox[{"sJ", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"heis", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<VonNeumannEntropy\>\"", 
    "]"}], "]"}]}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->1020575516,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[TextData[{
 "This is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["h", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["cos",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
    StyleBox["J", "TI"], 
    StyleBox["t", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"], "-", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 ", rewritten with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["csc",
    FontSlant->"Plain"], "\[ThinSpace]", "4", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "608e87cc-8fce-afdf-10b5-1e962a78f525"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tan",
    FontSlant->"Plain"], "\[ThinSpace]", "2", 
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 ". In other words, the spins become maximally entangled whenever the \
excitation is shared equally and return to a product state whenever it sits \
on one spin."
}], "Text",
 CellID->1967685850,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], 
   StyleBox["t", "TI"], "=", "\[Pi]", "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 " the populations are equal, so the entropy should be exactly one bit:"
}], "Text",
 CellID->1044562475,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[BoxData[
 RowBox[{"sJ", " ", "/.", " ", 
  RowBox[{"t", " ", "->", " ", 
   RowBox[{"\[Pi]", "/", 
    RowBox[{"(", 
     RowBox[{"8", " ", "J"}], ")"}]}]}]}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1653200050,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell[TextData[{
 "Qubit Relaxation for Every Initial State and Both Rates: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " as a Theorem"
}], "Section",
 CellID->1384978530,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[TextData[{
 "A qubit with splitting ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " relaxes at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " (jump operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "-"], "=", 
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"1"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 ") and dephases at rate ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 " (jump operator ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 "). What is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 " for every initial state, and what bound ties the coherence time to the \
relaxation time? A numerical solver integrates one initial state at one pair \
of rates. Here the initial density matrix has four symbolic entries and both \
rates are symbols."
}], "Text",
 CellID->519689844,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[TextData[{
 "Solve the Lindblad equation from ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "0"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["r", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 ":"
}], "Text",
 CellID->1609367578,ExpressionUUID->"4b6e5dad-9702-0c1f-7916-54f722b75765"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}], " ", "&&", " ", 
    RowBox[{"t", " ", ">=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]t", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Omega]", "/", "2"}], " ", 
      RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}], ",", " ", 
        RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], "}"}], " ", "->",
       " ", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[CurlyPhi]"}], "}"}]}], ",", 
     "\n", "   ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"Array", "[", 
       RowBox[{"r", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "]"}], ",", " ", "t"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"\[Rho]m", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{"\[Rho]t", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[9]:= ",
 CellID->1541450781,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[TextData[{
 "The excited population decays at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 " into the ground state, and the coherence precesses at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " while it decays at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "/", "2", "+", "2", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 ". So ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", "1", "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 ", and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " is read from the same matrix that covers every qubit experiment."
}], "Text",
 CellID->1657269721,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[TextData[{
 "Read the coherence decay rate ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SubscriptBox[
    StyleBox["T", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " off the computed off-diagonal entry:"
}], "Text",
 CellID->1140508347,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[BoxData[
 RowBox[{"\[Gamma]T2", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"-", 
    RowBox[{"Re", "[", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"\[Rho]m", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", "t"}], 
      "]"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->496109794,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[TextData[{
 "Ask whether ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " holds for all admissible rates:"
}], "Text",
 CellID->108435171,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{"ForAll", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[CurlyPhi]"}], "}"}], ",", " ", 
    
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}]}], ",", " ", 
    RowBox[{
     RowBox[{"1", "/", "\[Gamma]T2"}], " ", "<=", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->829388421,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["Find where the bound is saturated:", "Text",
 CellID->203008389,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "\[Gamma]T2"}], " ", "==", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}], " ", "&&", " ", 
    RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}]}], ",", " ", 
   "\[Gamma]\[CurlyPhi]"}], "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1090263105,ExpressionUUID->"7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],

Cell[TextData[{
 "The bound is tight only without pure dephasing. In other words, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " is the limit set by energy relaxation alone, and any dephasing pushes ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["T", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " below it."
}], "Text",
 CellID->1560876240,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[TextData[{
 "At long times every initial state should relax to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"0"},
    "Ket"], 
   TemplateBox[{"0"},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 ", carrying its full trace there:"
}], "Text",
 CellID->176337227,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{"\[Rho]m", ",", " ", 
   RowBox[{"t", " ", "->", " ", "Infinity"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->807053435,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[TextData[{
 "Quantum Fisher Information of a Phase: ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 " for Product Probes, ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 " for GHZ"
}], "Section",
 CellID->1633675818,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[TextData[{
 "A phase ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 " is written on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 " qubits by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Phi]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 " on each. The quantum Fisher information ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["Q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 " bounds every estimator through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Var",
    FontSlant->"Plain"], 
   OverscriptBox[
    StyleBox["\[Phi]", "TI"], "^"], "\[GreaterEqual]", "1", "/", 
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 ", and for a pure state it is four times the Fubini-Study metric, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"]], "=", 
   RowBox[{"4", 
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{
        RowBox[{
          SubscriptBox["\[PartialD]", 
           StyleBox["\[Phi]", "TI"]], 
          StyleBox["\[Psi]", "TI"]}], 
        RowBox[{
          SubscriptBox["\[PartialD]", 
           StyleBox["\[Phi]", "TI"]], 
          StyleBox["\[Psi]", "TI"]}]},
       "BraKet"], "-", 
      SuperscriptBox[GridBox[{
         {
          TemplateBox[{
            StyleBox["\[Psi]", "TI"], 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["\[Phi]", "TI"]], 
              StyleBox["\[Psi]", "TI"]}]},
           "BraKet"]}
        },
        GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
        GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], ")"}]}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 ". How does it grow with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 " for a product probe and for a GHZ probe? A numerical tool estimates it by \
finite differences at one value of ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 ". Here ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fd967ef-5008-0b29-75e7-7ec961bd5673"],
 " stays a symbol and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["Q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " comes out exact."
}], "Text",
 CellID->1828793009,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[TextData[{
 "Define ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["F", "TI"], 
   StyleBox["Q", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 " of the phase family generated from a probe state (",
 Cell[BoxData["FubiniStudyMetricTensor"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 " lives in the optimization context), and compare ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{"+"},
    "Ket"], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323a4b1c-b138-a791-63da-6359c0b20dfb"],
 " with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       RowBox[{"0", "\[CenterEllipsis]", "0"}]},
      "Ket"], "+", 
     TemplateBox[{
       RowBox[{"1", "\[CenterEllipsis]", "1"}]},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 " to ",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"],
 ":"
}], "Text",
 CellID->1232986364,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<Wolfram`QuantumFramework`QuantumOptimization`\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qfi", "[", "st_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"4", " ", 
      RowBox[{
       RowBox[{"FubiniStudyMetricTensor", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"QuantumState", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"QuantumCircuitOperator", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\"\<RZ\>\"", "[", "\[CurlyPhi]", "]"}], " ", "->", 
                " ", "k"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"k", ",", " ", 
                 RowBox[{"st", "[", "\"\<Qudits\>\"", "]"}]}], "}"}]}], "]"}],
              "]"}], "[", "st", "]"}], ",", " ", 
           RowBox[{"\"\<Parameters\>\"", " ", "->", " ", 
            RowBox[{"{", "\[CurlyPhi]", "}"}]}]}], "]"}], ",", 
         " ", "\"\<Matrix\>\""}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
     RowBox[{"\[CurlyPhi]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", " ", 
     RowBox[{"qfi", "[", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"StringRepeat", "[", 
        RowBox[{"\"\<+\>\"", ",", " ", "n"}], "]"}], "]"}], "]"}], ",", " ", 
     RowBox[{"qfi", "[", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<GHZ\>\"", "[", "n", "]"}], "]"}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "5"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[14]:= ",
 CellID->762269937,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[TextData[{
 "The product probe gives ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"]], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 ", the standard quantum limit, and the GHZ probe gives ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 ", the Heisenberg limit. Both are free of ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 ", because the generator ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["i", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " commutes with the evolution it generates. In other words, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["F", "TI"], 
    StyleBox["Q", "TI"]], "=", "4", 
   StyleBox["Var",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["1", "2"], 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 ": each qubit of the product state contributes its own unit of variance, \
while the GHZ state puts all its weight on the two extreme eigenvalues ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   StyleBox["n", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 ", so the variance grows as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 "."
}], "Text",
 CellID->405213039,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell["\<\
Cross-check with the variance formula directly, for the four-qubit GHZ state:\
\
\>", "Text",
 CellID->2118931930,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumState", "[", 
         RowBox[{"\"\<GHZ\>\"", "[", "4", "]"}], "]"}], 
        "[", "\"\<StateVector\>\"", "]"}], "]"}]}], ",", " ", 
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Total", " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"1", "/", "2"}], " ", "-", " ", 
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}]}], 
         ")"}]}], "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"4", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
      "v", " ", ".", " ", "g", " ", ".", " ", "g", " ", ".", " ", "v"}], " ", 
      "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v", " ", ".", " ", "g", " ", ".", " ", "v"}], ")"}], "^", 
       "2"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->1039057480,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell[TextData[{
 "Coherent Information of Amplitude Damping: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["h", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["\[Gamma]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   SubscriptBox[
    StyleBox["h", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Gamma]", "p"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 ", Maximized Exactly"
}], "Section",
 CellID->1411198270,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell[TextData[{
 "How much quantum information survives amplitude damping with decay \
probability ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 "? Purify the input ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["p", "TI"]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     TemplateBox[{"0"},
      "Ket"], 
     TemplateBox[{"0"},
      "Bra"]}], "+", 
    RowBox[{
     StyleBox["p", "TI"], 
     TemplateBox[{"1"},
      "Ket"], 
     TemplateBox[{"1"},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " with a reference qubit, send only the system through the channel, and \
compute the coherent information ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["I", "TI"], 
    StyleBox["c", "TI"]], "=", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["B", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"R", "B"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 ". A numerical tool evaluates this at chosen ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["p", "TI"], ",", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 " and scans for the best input. Here both stay symbols."
}], "Text",
 CellID->1703453532,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell["\<\
Purify, apply the channel to the first qubit, and take the two entropies:\
\>", "Text",
 CellID->1477609488,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"out", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumChannel", "[", 
     RowBox[{
      RowBox[{"\"\<AmplitudeDamping\>\"", "[", "g", "]"}], ",", " ", 
      RowBox[{"{", "1", "}"}]}], "]"}], "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", " ", "-", " ", "p"}], ",", " ", "p"}], "}"}], "]"}], 
      "]"}], "[", "\"\<Purify\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ic", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"QuantityMagnitude", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{"out", ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<VonNeumannEntropy\>\"", 
       "]"}], " ", "-", " ", 
      RowBox[{"out", "[", "\"\<VonNeumannEntropy\>\"", "]"}]}], "]"}], ",", 
    "\n", "   ", 
    RowBox[{
     RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "g", " ", "<", " ", "1"}]}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[16]:= ",
 CellID->1030824397,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[TextData[{
 "Check that this is the difference of two binary entropies, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["h", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["\[Gamma]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   SubscriptBox[
    StyleBox["h", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"\[Gamma]", "p"}], "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 ":"
}], "Text",
 CellID->100031176,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"h2", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "x"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"2", ",", " ", "x"}], "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", " ", "-", " ", "x"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ic", " ", "==", " ", 
    RowBox[{
     RowBox[{"h2", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "g"}], ")"}], " ", "p"}], "]"}], " ", "-",
      " ", 
     RowBox[{"h2", "[", 
      RowBox[{"g", " ", "p"}], "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "g", " ", "<", " ", "1"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[17]:= ",
 CellID->144223354,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[TextData[{
 "The output keeps the surviving population ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["\[Gamma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " and the environment receives the leaked population ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Gamma]", "p"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 "; the coherent information is their competition. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " the two are equal and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], 
   StyleBox["c", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " vanishes for every input:"
}], "Text",
 CellID->1443527617,ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ic", " ", "/.", " ", 
    RowBox[{"g", " ", "->", " ", 
     RowBox[{"1", "/", "2"}]}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->311511756,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[TextData[{
 "Maximize over the input at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ":"
}], "Text",
 CellID->1381425643,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Maximize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ic", " ", "/.", " ", 
       RowBox[{"g", " ", "->", " ", 
        RowBox[{"1", "/", "4"}]}]}], ",", " ", 
      RowBox[{"0", " ", "<=", " ", "p", " ", "<=", " ", "1"}]}], "}"}], ",", 
    " ", "p"}], "]"}], "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->377280352,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[TextData[{
 "The best input carries ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", "/", "3"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 " bits at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "4", "/", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 ", not at the maximally mixed ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 ". In other words, the optimal input underweights the excited state, because \
every excitation sent is also the only thing the environment can learn from."
}], "Text",
 CellID->1717363484,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[TextData[{
 "The Data-Processing Inequality Under Named Channels: ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " Finds No Violating Noise Strength"
}], "Section",
 CellID->1781880651,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[TextData[{
 "The quantum relative entropy ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["log",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Rho]", "TI"], "-", 
    SubscriptBox[
     StyleBox["log",
      FontSlant->"Plain"], "2"], "\[ThinSpace]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " measures how well ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 " can be told from ",
 Cell[BoxData[
  StyleBox["\[Sigma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 ", and no channel may raise it: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d4a9", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "\[DoubleVerticalBar]", "\|01d4a9", 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Sigma]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 ". Take two qubit states with non-parallel Bloch vectors, so they do not \
commute. Does the inequality hold for every noise strength ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " of a channel? A numerical tool checks it at sampled ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 ". Here ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362a4e41-4988-041f-5e2a-602b683d6f65"],
 " is a symbol, and ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 " searches the whole interval ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["p", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " for a violation."
}], "Text",
 CellID->1536527082,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[TextData[{
 "Set up the pair and the relative entropy, with the domain of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
 " supplied so the closed form simplifies:"
}], "Text",
 CellID->1621535814,ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qr", ",", " ", "qs"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"\"\<BlochVector\>\"", "[", "#", "]"}], "]"}], " ", "&"}], " ", 
    "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", 
        RowBox[{"3", "/", "5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "/", "5"}], " ", 
         RowBox[{"Sqrt", "[", "3", "]"}]}], ",", " ", "0", ",", " ", 
        RowBox[{"2", "/", "5"}]}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rel", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"QuantityMagnitude", " ", "@", " ", 
      RowBox[{"QuantumDistance", "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "\"\<RelativeEntropy\>\""}], 
       "]"}]}], ",", " ", 
     RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"rel", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumChannel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", "[", "p", "]"}], "]"}], "[", "qr", "]"}],
    ",", " ", 
   RowBox[{
    RowBox[{"QuantumChannel", "[", 
     RowBox[{"\"\<Depolarizing\>\"", "[", "p", "]"}], "]"}], "[", "qs", 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[20]:= ",
 CellID->1193935837,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell[TextData[{
 "After depolarizing noise the relative entropy is an explicit function of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 ", built from logarithms of the shrunken eigenvalues. Ask ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 " for any ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
 " that raises it, under four named channels:"
}], "Text",
 CellID->105329933,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"c", " ", "->", " ", 
    RowBox[{"Reduce", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"rel", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumChannel", "[", 
            RowBox[{"c", "[", "p", "]"}], "]"}], "[", "qr", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"QuantumChannel", "[", 
            RowBox[{"c", "[", "p", "]"}], "]"}], "[", "qs", "]"}]}], "]"}], 
        " ", ">", " ", 
        RowBox[{"rel", "[", 
         RowBox[{"qr", ",", " ", "qs"}], "]"}]}], " ", "&&", " ", 
       RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], ",", " ", "p",
       ",", " ", "Reals"}], "]"}]}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"c", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Depolarizing\>\"", ",", " ", "\"\<PhaseDamping\>\"", ",", 
       " ", "\"\<BitFlip\>\"", ",", " ", "\"\<PhaseFlip\>\""}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1234416869,ExpressionUUID->"6f6ad260-8ee1-565a-1569-d44a2a943ca0"],

Cell[TextData[{
 "Every answer is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "612fd791-c81e-86f2-10d4-cedae9a8ecd8"],
 ": no noise strength in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],
 " makes the processed pair easier to distinguish. In other words, each \
channel is a proof for this pair, not a sample of it."
}], "Text",
 CellID->240380995,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[TextData[{
 "Check that the named distance is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], "\[DoubleVerticalBar]", 
    StyleBox["\[Sigma]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
 " with the arguments in this order, against the matrix-logarithm \
definition:"
}], "Text",
 CellID->1771870337,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"qr", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"qs", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}]}], "}"}], ",",
    "\n", " ", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"a", " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"MatrixLog", "[", "a", "]"}], " ", "-", " ", 
           RowBox[{"MatrixLog", "[", "b", "]"}]}], ")"}]}], "]"}], "/", 
       RowBox[{"Log", "[", "2", "]"}]}], ",", " ", 
      RowBox[{"rel", "[", 
       RowBox[{"qr", ",", " ", "qs"}], "]"}]}], "}"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->305160771,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[TextData[{
 "SU(2) Double Cover from a Controlled Rotation: the Fringe Is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "/", "4"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"]
}], "Section",
 CellID->1896945989,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[TextData[{
 "A rotation by ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " returns every Bloch vector but multiplies the spinor by ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 ", so no measurement on the rotated qubit alone can see it. Put an ancilla \
in superposition, rotate a target by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " only in the ancilla's ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 " branch, and close the interferometer with a second Hadamard. What is the \
probability of finding the ancilla in ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 ", as a function of ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 "? A circuit simulator returns it at each sampled angle. Here ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " is a symbol."
}], "Text",
 CellID->653417278,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell["Build the circuit and read all four outcome probabilities:", "Text",
 CellID->1067269536,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"crx", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Controlled\>\"", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<RX\>\"", "[", "\[Alpha]", "]"}], " ", "->", " ", 
       RowBox[{"{", "2", "}"}]}], ",", " ", 
      RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"probs", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"\[Alpha]", " ", "\[Element]", " ", "Reals"}]}], "]"}], " ", 
    "&"}], " ", "/@", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumCircuitOperator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", "crx", ",", " ", 
        RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}], "]"}], "[", "]"}], 
    "[", "\"\<Probabilities\>\"", "]"}]}]}]}], "Input",
 CellLabel->"In[23]:= ",
 CellID->49659130,ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[TextData[{
 "Add the two outcomes with the ancilla in ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 ":"
}], "Text",
 CellID->464508221,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[BoxData[
 RowBox[{"fringe", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"probs", "[", 
     RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
    RowBox[{"probs", "[", 
     RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1361313038,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[TextData[{
 "The fringe is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], "/", "4"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 ", with period ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " in the rotation angle. In other words, the ancilla reads out ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      RowBox[{
       StyleBox["Re",
        FontSlant->"Plain"], 
       TemplateBox[{"0"},
        "Bra"], 
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["X", "TI"]], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["\[Alpha]", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       TemplateBox[{"0"},
        "Ket"]}]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "/", "2"}], "=", 
   RowBox[{
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["\[Alpha]", "TI"], "/", "2"}], 
        StyleBox[")",
         SpanMaxSize->1]}]}]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "/", "2"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 ", the overlap of the rotated and unrotated branches, and that overlap is a \
spinor amplitude, which needs ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " to return."
}], "Text",
 CellID->1907680634,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 " the target is back where it started, yet the ancilla flips with certainty; \
at ",
 Cell[BoxData[
  RowBox[{"4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 " it does not:"
}], "Text",
 CellID->483148123,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

Cell[BoxData[
 RowBox[{"fringe", " ", "/.", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Alpha]", " ", "->", " ", 
      RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", " ", "->", " ", 
      RowBox[{"4", " ", "\[Pi]"}]}], "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->1195452142,ExpressionUUID->"3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],

Cell["\<\
Rabi and Landau-Zener Propagators: Elementary Functions and \
Parabolic-Cylinder Functions\
\>", "Section",
 CellID->1521685512,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[TextData[{
 "A qubit driven by a field rotating at frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0651775d-2bad-791b-2e6f-6f074e584861"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], "0"], "2"], 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "\[ThinSpace]", 
    StyleBox["X", "TI"], "+", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "\[ThinSpace]", 
    StyleBox["Y", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63b9e3d6-2298-231e-1146-fa9057128e64"],
 ", and a qubit swept through an avoided crossing, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    StyleBox[
     RowBox[{"v", "t"}], "TI"], "2"], 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalDelta]", "2"], 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67c13665-f813-2f11-0dfe-a84ef9a6727b"],
 ", both have Hamiltonians that do not commute with themselves at different \
times. What are their propagators ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c440104-ea8a-4285-747b-99618f3f10ef"],
 "? A numerical solver integrates the time-ordered evolution for one set of \
parameters. Here every parameter stays a symbol."
}], "Text",
 CellID->97201263,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell[TextData[{
 "Compute the rotating-field propagator and its transition probability ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       TemplateBox[{"1"},
        "Bra"], 
       StyleBox["U", "TI"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["t", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       TemplateBox[{"0"},
        "Ket"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0513e607-0f4c-1e20-3320-f861aaf9650a"],
 ":"
}], "Text",
 CellID->878831761,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]0", " ", "\[Element]", " ", "Reals"}], " ", "&&", " ", 
    RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}], " ", "&&", " ", 
    RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"t", " ", "\[Element]", " ", "Reals"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"urab", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Omega]0", "/", "2"}], " ", 
       RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Omega]", " ", "t"}], "]"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Omega]", " ", "t"}], "]"}], " ", 
          RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}]}], ")"}]}]}], ",",
      " ", "None", ",", " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"ComplexExpand", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"urab", "[", "\"\<Matrix\>\"", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}], "^", "2"}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[26]:= ",
 CellID->1048559713,ExpressionUUID->"6833ae6a-6ac5-a2c8-19c0-40340f71f012"],

Cell[TextData[{
 "This is the Rabi formula, with the generalized Rabi frequency ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "+", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["\[Omega]", "TI"], "-", 
       SubscriptBox[
        StyleBox["\[Omega]", "TI"], "0"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 " setting the oscillation and the detuning ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "=", 
   StyleBox["\[Omega]", "TI"], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 " limiting the transfer to ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "+", 
    SuperscriptBox[
     StyleBox["\[Delta]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 "."
}], "Text",
 CellID->300048012,ExpressionUUID->"50b12ff8-e606-85f7-004e-c6a593b0efdd"],

Cell["\<\
Compute the Landau-Zener propagator and list the special functions it is \
built from:\
\>", "Text",
 CellID->1962937852,ExpressionUUID->"640f47a5-4648-c62d-0c35-5e0f73e2ad77"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lz", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", " ", 
         RowBox[{"t", "/", "2"}], " ", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
        
        RowBox[{
         RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
         RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}], ",", " ", 
       "None", ",", " ", "t"}], "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Union", "[", 
  RowBox[{"Cases", "[", 
   RowBox[{"lz", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"h", " ", ":", " ", 
        RowBox[{
        "Hypergeometric1F1", " ", "|", " ", "ParabolicCylinderD", " ", "|", 
         " ", "HermiteH"}]}], ")"}], "[", "___", "]"}], " ", ":>", " ", "h"}],
     ",", " ", "Infinity"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[27]:= ",
 CellID->588230824,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell[TextData[{
 "The propagator is built from parabolic-cylinder functions ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], 
   StyleBox["\[Nu]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 ", the solutions of the Weber equation that the linear sweep turns the \
Schrodinger equation into. Simplified, its first entry is a Kummer function:"
}], "Text",
 CellID->2099309037,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"lz", "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->512383039,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[TextData[{
 "This is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["v", "TI"], 
     SuperscriptBox[
      StyleBox["t", "TI"], "2"], "/", "4"}]], 
   SubscriptBox["\[ThinSpace]", "1"], 
   SubscriptBox[
    StyleBox["F", "TI"], "1"], "\[NegativeThinSpace]", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       StyleBox["i", "TI"], 
       SuperscriptBox["\[CapitalDelta]", "2"]}], 
      RowBox[{"8", 
       StyleBox["v", "TI"]}]], ";", " ", 
     FractionBox["1", "2"], ";", " ", 
     RowBox[{
      FractionBox[
       StyleBox["i", "TI"], "2"], 
      StyleBox["v", "TI"], 
      SuperscriptBox[
       StyleBox["t", "TI"], "2"]}]}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1170384d-2f38-2c50-470f-b2174acd76ba"],
 ": the single ratio ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]", "2"], "/", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 " sets the index, and with it whether the sweep is adiabatic or diabatic. In \
other words, the whole time-resolved crossing, including the oscillations \
around the asymptotic Landau-Zener probability, is in one closed form."
}], "Text",
 CellID->273308241,ExpressionUUID->"54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],

Cell[TextData[{
 "Check that the matrix solves ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 ", at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], "=", "\[CapitalDelta]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0.7"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 ":"
}], "Text",
 CellID->1809098798,ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"lz", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"v", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\[CapitalDelta]", " ", "->", " ", "1"}]}], "}"}]}]}], "}"}], 
   ",", " ", 
   RowBox[{"Chop", "[", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", " ", 
         RowBox[{"D", "[", 
          RowBox[{"m", ",", " ", "t"}], "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"t", "/", "2"}], " ", 
            RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}]}], ")"}], " ", 
         ".", " ", "m"}]}], ")"}], " ", "/.", " ", 
      RowBox[{"t", " ", "->", " ", "0.7"}]}], "]"}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[29]:= ",
 CellID->156430199,ExpressionUUID->"3bfbbd45-edb8-1b0b-6998-352e844d6651"],

Cell["\<\
A Beam Splitter with Symbolic Photon Numbers: the Amplitude Is a Wigner \
D-Function\
\>", "Section",
 CellID->724760089,ExpressionUUID->"045023ab-c37d-b770-2c6f-baf4f6091a5a"],

Cell[TextData[{
 "Send ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["n", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e490f1-5bc8-e939-619b-09bb5e62b803"],
 " photons into the two ports of a beam splitter with mixing angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 " and phase ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 ". What is the amplitude to find ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 " photons at the outputs, for every photon number at once? A Fock-space \
simulator truncates the space and answers one set of photon numbers at a \
time. Here the four photon numbers stay symbols."
}], "Text",
 CellID->168408080,ExpressionUUID->"285985c7-a1c8-13eb-5866-1ca0d07d6131"],

Cell[TextData[{
 "Ask for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], "1"], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["t", "TI"], "2"], GridBox[{
       {
        RowBox[{
         StyleBox["U", "TI"], 
         StyleBox["(",
          SpanMaxSize->1], 
         RowBox[{
          StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
         StyleBox[")",
          SpanMaxSize->1]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     SubscriptBox[
      StyleBox["n", "TI"], "1"]}], ",", 
    SubscriptBox[
     StyleBox["n", "TI"], "2"]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["t", "TI"], "2"], ",", 
   StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 " all symbolic:"
}], "Text",
 CellID->811283638,ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<BS\>\"", "[", 
     RowBox[{"\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], "}"}], "]"}], "[", 
  
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->207978548,ExpressionUUID->"10256af3-3972-af7a-41da-83bdb804f240"],

Cell[TextData[{
 "The answer is a single Wigner D-function times a Kronecker delta that \
conserves the photon number. In other words, a beam splitter is a rotation by \
",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 " of a spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["n", "TI"], "1"], "+", 
    SubscriptBox[
     StyleBox["n", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 ", with the photon-number difference playing the role of ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 ": two modes holding ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 " photons carry the spin-",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " representation of SU(2) (Schwinger's construction), and the beam splitter \
rotates it."
}], "Text",
 CellID->437474228,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

Cell[TextData[{
 "Make the splitter balanced (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CurlyPhi]", "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 "), send ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 " photons into each port, and ask for ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 " photons in the first output:"
}], "Text",
 CellID->874582697,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[BoxData[
 RowBox[{"hom", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "4"}], ",", " ", "0"}], "]"}], "}"}], "]"}], "[", 
   RowBox[{"\"\<Amplitude\>\"", ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "n"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "n"}], " ", "-", " ", "k"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->11631581,ExpressionUUID->"3c8746fc-db76-c487-64bd-5fb9de00aeed"],

Cell[TextData[{
 "This is the Hong-Ou-Mandel effect for any ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 ". At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", 
   StyleBox["k", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 " it is ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["d", "TI"], "00", "1"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[Pi]", "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 ": two single photons never leave through different ports. The same ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 "-function vanishes whenever ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325c8f47-cd85-89da-6263-2720e431db20"],
 " is odd, so with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcea2e-12ab-c026-7183-0388a75f930c"],
 " photons in each input, each output port only ever holds an even number of \
photons."
}], "Text",
 CellID->1933762060,ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell[TextData[{
 "Confirm that every odd-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5add4728-e92e-eff1-0ae3-5f7588d8b5db"],
 " amplitude is zero for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 " to ",
 Cell[BoxData["6"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 ":"
}], "Text",
 CellID->1055776787,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[BoxData[
 RowBox[{"Union", " ", "@", " ", 
  RowBox[{"Flatten", " ", "@", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"hom", ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "6"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "1", ",", " ", 
       RowBox[{
        RowBox[{"2", " ", "n"}], " ", "-", " ", "1"}], ",", " ", "2"}], 
      "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1859711813,ExpressionUUID->"4139b36b-52b1-2977-70c6-2b356744785d"],

Cell["\<\
Photon Loss: a Binomial Law for Symbolic Photon Numbers, and a Hong-Ou-Mandel \
Dip That Survives It\
\>", "Section",
 CellID->1348896709,ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell[TextData[{
 "An attenuator with transmissivity ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39b01e29-d171-5c92-6f4f-9072e00426f8"],
 " lets each photon through with probability ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 ". What is the probability that ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ad582f-66ff-93eb-3c53-5189128be131"],
 " photons leave ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"],
 " survivors, for every ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b00368-b832-202d-3e4f-9b3239c77377"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d00634-a672-f252-2eef-9871d304c0b8"],
 "? And if both outputs of a balanced beam splitter lose light, does the \
Hong-Ou-Mandel zero survive? A density-matrix simulator answers both at one \
value of ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 " and one truncated photon number at a time. Here ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 ", ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07beae85-a317-6bf9-2d45-47eed6a239c3"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " stay symbols."
}], "Text",
 CellID->1427211115,ExpressionUUID->"60049622-f570-0e0e-103b-0f8ffc055554"],

Cell[TextData[{
 "Ask for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], "\[VerticalSeparator]", 
    StyleBox["n", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ea559d-da93-7842-70ea-4cc6df264aa8"],
 " through a pure-loss element with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 " symbolic:"
}], "Text",
 CellID->2099805207,ExpressionUUID->"36ea7e2c-072a-2221-5eea-7076b2df710b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"loss", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Loss\>\"", "[", "\[Eta]", "]"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"loss", "[", 
  RowBox[{"\"\<Probability\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", "n", "}"}], " ", "->", " ", 
    RowBox[{"{", "k", "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[33]:= ",
 CellID->1402006442,ExpressionUUID->"5b23761c-2477-64e8-0ad1-68464d024e32"],

Cell[TextData[{
 "The answer is the binomial law ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["n", "TI"], 
     StyleBox["k", "TI"]},
    "Binomial"], 
   SuperscriptBox[
    StyleBox["\[Eta]", "TI"], 
    StyleBox["k", "TI"]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"1", "-", 
      StyleBox["\[Eta]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    RowBox[{
     StyleBox["n", "TI"], "-", 
     StyleBox["k", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 ": each photon is transmitted or lost independently of the others. The \
surviving photon number of a Fock state is therefore never sharp once ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["\[Eta]", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 "."
}], "Text",
 CellID->1901179466,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[TextData[{
 "Put equal loss ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 " on both outputs of a balanced beam splitter and send one photon into each \
input:"
}], "Text",
 CellID->210724908,ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lossyHOM", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Pi]", "/", "4"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<Loss\>\"", "[", "\[Eta]", "]"}], " ", "->", " ", "1"}], ",",
       " ", 
      RowBox[{
       RowBox[{"\"\<Loss\>\"", "[", "\[Eta]", "]"}], " ", "->", " ", "2"}]}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"lossyHOM", "[", 
  RowBox[{"\"\<Probabilities\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[34]:= ",
 CellID->1992790374,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell[TextData[{
 "The coincidence ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 " stays exactly 0 for every ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 ", and each bunched outcome carries ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Eta]", "TI"], "2"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 ". In other words, loss acts after the interference: the pair always leaves \
together, and loss only decides how many of the two photons reach the \
detectors. That is why equal detector inefficiency lowers the count rate but \
never fills the Hong-Ou-Mandel dip."
}], "Text",
 CellID->292747604,ExpressionUUID->"0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],

Cell[TextData[{
 "Check that the binomial law is normalized for symbolic ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8469dd-bfc7-2a7a-04bb-80873a727940"],
 ":"
}], "Text",
 CellID->1553818268,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"loss", "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", "n", "}"}], " ", "->", " ", 
      RowBox[{"{", "k", "}"}]}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->1870754514,ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

Cell["\<\
Two Squeezers into a Balanced Beam Splitter: a Two-Mode Squeezed Vacuum\
\>", "Section",
 CellID->1358728755,ExpressionUUID->"13db9173-5387-1c16-41f8-093d6632677c"],

Cell[TextData[{
 "Squeeze the vacuum in each of two modes, with complex parameters ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Xi]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Xi]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 ", then mix the modes on a balanced beam splitter. When does one photon \
appear in each output, and what is the full photon-number distribution? \
Fock-space simulators such as Strawberry Fields answer at fixed numerical \
squeezing with a cutoff. Here the squeezing parameters stay symbols."
}], "Text",
 CellID->935019337,ExpressionUUID->"4289b0c6-8043-1b93-72b6-29a031f669f9"],

Cell[TextData[{
 "Ask for the coincidence amplitude ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    RowBox[{"1", GridBox[{
       {
        StyleBox["U", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "0"}], ",", "0"}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 " with ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Xi]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Xi]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 " symbolic:"
}], "Text",
 CellID->642744358,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "\[Xi]1", "]"}], " ", "->", " ", "1"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"\"\<S\>\"", "[", "\[Xi]2", "]"}], " ", "->", " ", "2"}], ",", 
     " ", 
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "4"}], ",", " ", "0"}], "]"}]}], "}"}], "]"}], "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->1478372881,ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

Cell[TextData[{
 "The amplitude is a difference of the two squeezers' pair amplitudes ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], 
     StyleBox["arg",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Xi]", "TI"]}]], 
   StyleBox["tanh",
    FontSlant->"Plain"], "\[ThinSpace]", GridBox[{
     {
      StyleBox["\[Xi]", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
 ". Equal squeezing cancels it exactly: the splitter maps two identical \
squeezed vacua to two identical squeezed vacua, which hold only even photon \
numbers. Opposite squeezing, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Xi]", "TI"], "2"], "=", "-", 
   SubscriptBox[
    StyleBox["\[Xi]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e10bd94-ae42-3b4d-262f-34d1cbf48997"],
 ", makes the two terms add, so the coincidence is largest there."
}], "Text",
 CellID->124263719,ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

Cell[TextData[{
 "Take opposite squeezing ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b734859-75e7-efa6-7901-62030393b58c"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 ", and compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", "0"}], ",", "\[Ellipsis]", ",", "3"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 ":"
}], "Text",
 CellID->1310926461,ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmsv", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", "r", "]"}], " ", "->", " ", "1"}], ",", " ", 
      
      RowBox[{
       RowBox[{"\"\<S\>\"", "[", 
        RowBox[{"-", "r"}], "]"}], " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "4"}], ",", " ", "0"}], "]"}]}], "}"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"tmsv", "[", 
    RowBox[{"\"\<Probability\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "m"}], "}"}]}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"r", " ", ">", " ", "0"}]}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"m", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[37]:= ",
 CellID->1124211690,ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell[TextData[{
 "The two outputs always hold the same photon number, with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["tanh",
     FontSlant->"Plain"], 
    RowBox[{"2", 
     StyleBox["m", "TI"]}]], "\[ThinSpace]", 
   StyleBox["r", "TI"], "/", 
   SuperscriptBox[
    StyleBox["cosh",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5547dfb6-0e84-e145-037c-d6f0ab36b3af"],
 ": the two-mode squeezed vacuum, whose photons are made in pairs. Either \
mode alone is thermal. At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12b61bfc-9cd7-eca9-424d-92a61563b6f3"],
 " only ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451364b5-819d-fb99-7321-7dff3029c9e3"],
 " survives, which is the vacuum. Photon numbers in a squeezed network must \
be integers, so the general ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " is read from this pattern rather than computed."
}], "Text",
 CellID->1335749844,ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[TextData[{
 "Check the pattern against the computed probabilities up to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "089aa42d-ce49-3603-38b9-3e76ebfd9d69"],
 ", and check that it sums to 1 over all ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fccab3-b886-a0f7-7883-e3fd3930f2dd"],
 ":"
}], "Text",
 CellID->793802945,ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"tmsv", "[", 
         RowBox[{"\"\<Probability\>\"", ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", "m"}], "}"}]}], ",", " ", 
          RowBox[{"Assumptions", " ", "->", " ", 
           RowBox[{"r", " ", ">", " ", "0"}]}]}], "]"}], " ", "-", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Tanh", "[", "r", "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"2", " ", "m"}], ")"}]}], "/", 
         RowBox[{
          RowBox[{"Cosh", "[", "r", "]"}], "^", "2"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"r", " ", ">", " ", "0"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Tanh", "[", "r", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"2", " ", "m"}], ")"}]}], "/", 
      RowBox[{
       RowBox[{"Cosh", "[", "r", "]"}], "^", "2"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", "Infinity"}], "}"}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"r", " ", ">", " ", "0"}]}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->631769182,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

Cell["\<\
The Three-Mode Fourier Interferometer: Exact Zeros in the Output\
\>", "Section",
 CellID->1873681340,ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"],

Cell[TextData[{
 "Send one photon into each port of a three-mode Fourier interferometer (a \
tritter). Which output patterns occur, and with what probability? A numerical \
simulator returns the forbidden patterns as numbers near ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"-", "32"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 ", and the reader must decide whether they are zero. Built from the exact \
Fourier matrix, every probability is an exact rational."
}], "Text",
 CellID->1468251080,ExpressionUUID->"3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],

Cell[TextData[{
 "Compute the full output distribution for ",
 Cell[BoxData[
  TemplateBox[{"1,1,1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 ":"
}], "Text",
 CellID->1989234463,ExpressionUUID->"78cf51d6-d7cd-4672-28f5-4893e2782d58"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{"FourierMatrix", "[", "3", "]"}], "]"}], "[", 
  RowBox[{"\"\<Probabilities\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[39]:= ",
 CellID->1607696641,ExpressionUUID->"1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],

Cell[TextData[{
 "Every pattern with two photons in one mode and one in another is exactly 0, \
",
 Cell[BoxData[
  TemplateBox[{"1,1,1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 " survives at ",
 Cell[BoxData[
  RowBox[{"1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 ", and the three fully bunched patterns share the rest at ",
 Cell[BoxData[
  RowBox[{"2", "/", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 " each. In other words, the cyclic symmetry of the Fourier matrix gives \
every history leading to a 2+1 pattern a partner with a cube-root-of-unity \
phase, and the three cancel. This is the suppression law that experiments use \
to certify that photons are indistinguishable."
}], "Text",
 CellID->1817342824,ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

Cell["Check that the distribution is normalized:", "Text",
 CellID->530774412,ExpressionUUID->"2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"FourierMatrix", "[", "3", "]"}], "]"}], "[", 
   RowBox[{"\"\<Probabilities\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->599957810,ExpressionUUID->"669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],

Cell["\<\
Cascaded Beam Splitters: Symbolic Amplitudes with Sums and Path Conditions\
\>", "Section",
 CellID->1899946997,ExpressionUUID->"5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],

Cell[TextData[{
 "Chain beam splitters across three modes, and ask for the amplitude from ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["n", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["n", "TI"], "3"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 " to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], "2"], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], "3"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 " with every photon number symbolic. A single beam splitter gives one Wigner \
D-function. A cascade has to sum over the photon number inside the network \
and to know which output a photon can reach at all. Every Fock-space or \
permanent code needs the photon numbers as integers."
}], "Text",
 CellID->1051619128,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell["Two splitters, on modes 1, 2 and then on modes 2, 3:", "Text",
 CellID->1921351195,ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumInterferometer", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"\[Theta]1", ",", " ", "\[Phi]1"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"\[Theta]2", ",", " ", "\[Phi]2"}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], ",", " ", "3"}], 
   "]"}], "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->1207491739,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"],

Cell[TextData[{
 "The amplitude is a product of two D-functions under one condition, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["t", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64adc082-4122-deff-0c52-d9ec70d4a4c5"],
 ". Photons that start in mode 3 meet mode 1 only through the first splitter, \
which they never reach, so mode 1 can hold at most the ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["n", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e451771-8a55-ceec-267a-8f3b2fe19436"],
 " photons that went through it. The Kronecker delta conserves the total."
}], "Text",
 CellID->216741342,ExpressionUUID->"4670f053-f537-0b3f-6e0f-ea1cfcc25605"],

Cell["\<\
Add a third splitter back on modes 1, 2, so photons can return to mode 1:\
\>", "Text",
 CellID->2096934290,ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mesh", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]1", ",", " ", "\[Phi]1"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]2", ",", " ", "\[Phi]2"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", 
         RowBox[{"\[Theta]3", ",", " ", "\[Phi]3"}], "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}]}], "}"}], ",", " ", "3"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"mesh", "[", 
  RowBox[{"\"\<Amplitude\>\"", ",", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1", ",", " ", "n2", ",", " ", "0"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[42]:= ",
 CellID->1367217003,ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[TextData[{
 "Now the amplitude is an inactive sum over ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 ", the number of photons in mode 1 between the first and the last splitter, \
with the bound ",
 Cell[BoxData[
  RowBox[{
   StyleBox["min",
    FontSlant->"Plain"], "\[ThinSpace]", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["n", "TI"], "1"], "+", 
      SubscriptBox[
       StyleBox["n", "TI"], "2"]}], ",", " ", 
     RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], "1"], "+", 
      SubscriptBox[
       StyleBox["t", "TI"], "2"]}]}], 
    StyleBox[")",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 " set by the photon flow. The sum stays unevaluated so that the formula \
holds for every photon number."
}], "Text",
 CellID->1372538143,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[TextData[{
 "Substitute ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"2,1,0"},
    "Ket"], "\[Rule]", 
   TemplateBox[{"1,1,1"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 ", activate the sum, and compare with the direct query at those numbers:"
}], "Text",
 CellID->485911656,ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Activate", "[", 
    RowBox[{
     RowBox[{"mesh", "[", 
      RowBox[{"\"\<Amplitude\>\"", ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n1", ",", " ", "n2", ",", " ", "0"}], "}"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}]}], "]"}], 
     " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n1", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"n2", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"t1", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"t2", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"t3", " ", "->", " ", "1"}]}], "}"}]}], "]"}], " ", "-", " ", 
   RowBox[{"mesh", "[", 
    RowBox[{"\"\<Amplitude\>\"", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[43]:= ",
 CellID->181917407,ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell["\<\
The Nonlinear Sign Gate: Heralded Output for a Symbolic Input\
\>", "Section",
 CellID->1906087345,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell[TextData[{
 "Linear optics cannot give the two-photon component a sign flip on its own: \
a phase shifter multiplies ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["n", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 " by ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "n", "\[Phi]"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 ", so it changes ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 " as well. Knill, Laflamme and Milburn obtained ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "0"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "1"], 
     TemplateBox[{"1"},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "2"], 
     TemplateBox[{"2"},
      "Ket"]}]}], "\[Function]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "0"], 
     TemplateBox[{"0"},
      "Ket"]}], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "1"], 
     TemplateBox[{"1"},
      "Ket"]}], "-", 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "2"], 
     TemplateBox[{"2"},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 " by adding one auxiliary photon and one vacuum mode, and keeping only the \
runs in which the auxiliary detectors see ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 ". What comes out for an arbitrary input, and how often does it work? Here \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], "0"], ",", 
   SubscriptBox[
    StyleBox["c", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["c", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "440467ae-8db5-79b4-6c3c-7e0824404b9e"],
 " stay symbols."
}], "Text",
 CellID->354048744,ExpressionUUID->"141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],

Cell["\<\
Build the three-mode network from its real transfer matrix (Knill, Laflamme \
and Milburn, Nature 409, 46 (2001)):\
\>", "Text",
 CellID->786710823,ExpressionUUID->"3d27d006-86b8-9131-64dc-ca603332e01b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ns", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"3", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}]}], 
       "}"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "4"}], ")"}]}], ",", " ", 
        RowBox[{"1", "/", "2"}], ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}]}], "}"}], ",",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"3", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "-", " ", "2"}], "]"}], ",",
         " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", "2"}], ",", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], " ", "-", " ", 
         RowBox[{"1", "/", "2"}]}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"RootReduce", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"ns", "[", 
     RowBox[{"\"\<Amplitude\>\"", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "1", ",", " ", "0"}], "}"}]}]}], "]"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[44]:= ",
 CellID->1859374462,ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"],

Cell[TextData[{
 "The heralded amplitudes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", "1", ",", 
    RowBox[{"0", GridBox[{
       {
        StyleBox["U", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     StyleBox["m", "TI"]}], ",", 
    RowBox[{"1", ",", "0"}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"],
 " are ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 ", ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 ": the same size for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", "0"}], ",", 
   RowBox[{"1", ",", "2"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],
 ", with the sign flipped only for two photons."
}], "Text",
 CellID->544914423,ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell[TextData[{
 "Send the symbolic signal with the auxiliary photon and vacuum through the \
network (four Fock levels per mode hold every sector), and keep the signal \
amplitudes where the auxiliary modes read ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13ecd9ee-6506-67bb-4193-d0c80cb34d81"],
 ":"
}], "Text",
 CellID->1088734259,ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nsOut", " ", "=", " ", 
   RowBox[{"ns", "[", 
    RowBox[{"QuantumTensorProduct", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c0", ",", " ", "c1", ",", " ", "c2", ",", " ", "0"}], "}"}],
         ",", " ", "4"}], "]"}], ",", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{"1", ",", " ", "4"}], "]"}], ",", " ", 
      RowBox[{"FockState", "[", 
       RowBox[{"0", ",", " ", "4"}], "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"RootReduce", "[", 
  RowBox[{
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"nsOut", "[", "\"\<StateVector\>\"", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4"}], "}"}]}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", " ", "2", ",", " ", "1"}], "]"}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[45]:= ",
 CellID->476175344,ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"],

Cell[TextData[{
 "The heralded signal is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], "0"], ",", 
    SubscriptBox[
     StyleBox["c", "TI"], "1"], ",", 
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["c", "TI"], "2"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 ". In other words, the gate acts identically on every input, and its success \
probability is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "4"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[GridBox[{
       {
        SubscriptBox[
         StyleBox["c", "TI"], "0"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "+", 
    SuperscriptBox[GridBox[{
       {
        SubscriptBox[
         StyleBox["c", "TI"], "1"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "+", 
    SuperscriptBox[GridBox[{
       {
        SubscriptBox[
         StyleBox["c", "TI"], "2"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 " whatever the input state is. That independence of the input is what lets \
the gate serve as a building block for a controlled-sign gate between photons."
}], "Text",
 CellID->201272189,ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"],

Cell[TextData[{
 "Check that the gate is defined only up to two signal photons: the heralded \
amplitude for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640353f1-ff8e-e9b3-0c31-4abafa38bb99"],
 " is neither ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37161f66-4600-a3a8-5d2d-974073baf1f2"],
 " nor ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 ":"
}], "Text",
 CellID->320292756,ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],

Cell[BoxData[
 RowBox[{"RootReduce", "[", 
  RowBox[{"ns", "[", 
   RowBox[{"\"\<Amplitude\>\"", ",", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "1", ",", " ", "0"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "1", ",", " ", "0"}], "}"}]}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[46]:= ",
 CellID->1146801282,ExpressionUUID->"539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],

Cell["\<\
From Interferometer to Fock-Space Circuit: Symbolic Parameters Carry Over\
\>", "Section",
 CellID->41202278,ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"],

Cell[TextData[{
 "The permanent formulas never build a Fock space. When a computation needs \
one (a mixed input, a partial trace, a QuantumFramework measurement), ",
 Cell[BoxData[
  RowBox[{"qi", "[", 
   RowBox[{"\"\<CircuitOperator\>\"", ",", " ", "d"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0971a20b-7913-467e-3f0e-445578a62d44"],
 " turns the interferometer into a ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09df342d-d743-5809-3fe4-ae76e2f62b53"],
 " on ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 " levels per mode, with the beam-splitter angles still symbolic."
}], "Text",
 CellID->1124146653,ExpressionUUID->"21fdaace-430e-f3f9-5782-43a876b8c1c3"],

Cell[TextData[{
 "Build the Fock-space circuit of a beam splitter with symbolic ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 ", ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 " on three levels per mode:"
}], "Text",
 CellID->1232284935,ExpressionUUID->"41c6bfc6-0792-5005-77fd-36a0b227236f"],

Cell[BoxData[
 RowBox[{"bsCircuit", " ", "=", " ", 
  RowBox[{
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<BS\>\"", "[", 
      RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "]"}], "}"}], "]"}], "[", 
   RowBox[{"\"\<CircuitOperator\>\"", ",", " ", "3"}], "]"}]}]], "Input",
 CellLabel->"In[47]:= ",
 CellID->2082395230,ExpressionUUID->"62752e4e-571f-d961-120a-c02862aba84b"],

Cell[TextData[{
 "Check it against the permanent route: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{"2", ",", 
    RowBox[{"0", GridBox[{
       {
        RowBox[{"\[ThinSpace]", 
         StyleBox["circuit",
          FontSlant->"Plain"], "\[ThinSpace]"}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "1"}], ",", "1"}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
 " minus the interferometer's amplitude for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"1", "}", "\[Rule]", "{", "2"}], ",", 
   RowBox[{"0", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166277e1-e8de-815f-3e12-6eca8968d3a5"],
 ":"
}], "Text",
 CellID->2045146513,ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SuperDagger", "[", 
        RowBox[{"FockState", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", "3"}], "]"}], "]"}],
        " ", "@", " ", 
       RowBox[{"bsCircuit", "[", 
        RowBox[{"FockState", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}], 
        "]"}]}], ")"}], "[", "\"\<Scalar\>\"", "]"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "]"}], "}"}], "]"}], "[", 
     RowBox[{"\"\<Amplitude\>\"", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}]}]}], "]"}]}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], ",", " ", "Reals"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->25123057,ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"],

Cell["\<\
Bosons, Distinguishable Particles and Fermions at One Beam Splitter: \
Permanent, Probability Permanent, Determinant\
\>", "Section",
 CellID->371825621,ExpressionUUID->"15ce0314-20ee-2b64-43f5-9b5e509b764e"],

Cell[TextData[{
 "Send two particles, one into each input of a beam splitter with transfer \
matrix ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a9ac88-4644-6c0e-6856-45d273f13754"],
 ". The coincidence amplitude adds the two histories (both transmitted, both \
reflected). Identical bosons add them with a plus sign, which gives the \
permanent of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64802aa2-b136-451c-0cbf-c30fc0c32c66"],
 "; identical fermions add them with a minus sign, which gives the \
determinant; distinguishable particles add probabilities, which gives the \
permanent of ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      SubscriptBox[
       StyleBox["W", "TI"], 
       StyleBox[
        RowBox[{"j", "k"}], "TI"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 ". All three come out as formulas in ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 " and ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],
 "."
}], "Text",
 CellID->1439628390,ExpressionUUID->"4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Per",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Per",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["W", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 " for a beam splitter with symbolic ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 ", ",
 Cell[BoxData["\[CurlyPhi]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],
 ":"
}], "Text",
 CellID->497245720,ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wbs", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantumInterferometer", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<BS\>\"", "[", 
       RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "]"}], "}"}], "]"}], 
    "[", "\"\<Unitary\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Permanent", "[", "wbs", "]"}], ",", " ", 
     RowBox[{"Det", "[", "wbs", "]"}], ",", " ", 
     RowBox[{"Permanent", "[", 
      RowBox[{
       RowBox[{"Abs", "[", "wbs", "]"}], "^", "2"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], ",", " ", "Reals"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[49]:= ",
 CellID->1090726268,ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"],

Cell[TextData[{
 "The boson coincidence amplitude is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "2", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 ", which vanishes at the balanced splitter (Hong-Ou-Mandel). The fermion \
amplitude is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["W", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b26917-59e6-8729-3f41-81515f90ea73"],
 " for every ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 ": two identical fermions always leave through different ports. \
Distinguishable particles give ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136d7364-bcfb-8461-4113-6b4e348fef4b"],
 ", which never drops below ",
 Cell[BoxData[
  RowBox[{"1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"],
 ". In other words, one sign under exchange separates complete bunching from \
complete antibunching, and the same sign separates the permanent, for which \
no efficient algorithm is known, from the determinant, which Gaussian \
elimination computes in polynomial time."
}], "Text",
 CellID->2124519200,ExpressionUUID->"30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],

Cell[TextData[{
 "Check that the permanent is the amplitude ",
 Cell[BoxData["QuantumInterferometer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 " itself returns for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "1"}], ",", 
   RowBox[{"1", "}", "\[Rule]", "{", "1"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 ":"
}], "Text",
 CellID->617350884,ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Permanent", "[", "wbs", "]"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"QuantumInterferometer", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<BS\>\"", "[", 
        RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "]"}], "}"}], "]"}], "[", 
     RowBox[{"\"\<Amplitude\>\"", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}]}]}], "]"}]}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "\[Phi]"}], "}"}], ",", " ", "Reals"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[50]:= ",
 CellID->1357963930,ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

Cell[TextData[{
 "A Coherent State Under the Oscillator: It Stays Coherent, with the Phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"]
}], "Section",
 CellID->1626918454,ExpressionUUID->"023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], "\[Dagger]"], 
    StyleBox["a", "TI"], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
 ", a coherent state should stay coherent with its label rotating, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["H", "TI"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox["t", "TI"], "/", "2"}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Alpha]", "TI"], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
           StyleBox["i", "TI"], 
           StyleBox["\[Omega]", "TI"], 
           StyleBox["t", "TI"]}]]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47740231-7fc8-4299-6d0b-a47b7a7d10e3"],
 ". Can this be checked for all ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af52337-5e42-c8c3-4a8a-bb715bf49a29"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5782d92f-a790-094a-7db1-d088d2255b90"],
 " at once? QuTiP would propagate one ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 " on a time grid. Here the propagator is computed with ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 " symbolic and applied to the coherent state with symbolic ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],
 ", in QuantumFramework's default truncated Fock space of 16 levels."
}], "Text",
 CellID->675379980,ExpressionUUID->"2d0df906-1ebb-1081-5b32-f1609b4e62eb"],

Cell[TextData[{
 "Compute the propagator ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["H", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 " and read its diagonal:"
}], "Text",
 CellID->1331866192,ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aOp", " ", "=", " ", 
   RowBox[{"AnnihilationOperator", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uosc", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"\[Omega]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"aOp", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "aOp"}], 
        " ", "+", " ", 
        RowBox[{"1", "/", "2"}]}], ")"}]}], ",", " ", "None", ",", " ", "t"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"Diagonal", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"uosc", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[51]:= ",
 CellID->1391655620,ExpressionUUID->"0dbacffa-31b0-43f6-3b59-e6a4404511dc"],

Cell[TextData[{
 "The propagator is diagonal in the photon number, with phases ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["n", "TI"], "+", "1", "/", "2"}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "196a859c-b643-c1b3-4f69-1cd9c3f79399"],
 ". So it multiplies the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 "-th amplitude ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["n", "TI"]], "/", 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50735439-04fd-dee7-0001-4e63ac89a4cd"],
 " by ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"], "/", "2"}]], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["\[Omega]", "TI"], 
       StyleBox["t", "TI"]}]], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["n", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3597ba8d-914b-928f-63ac-33d720ffe0d5"],
 ", which is exactly the coherent state with label ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056fda38-a5bc-2884-3314-dc65cc497aee"],
 " times the vacuum phase."
}], "Text",
 CellID->861714746,ExpressionUUID->"383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],

Cell[TextData[{
 "Compare amplitude by amplitude, using unnormalized coherent states so that \
the comparison includes the phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b649e79-a2e1-7610-291b-1022d6945d7a"],
 " and does not depend on how the truncated state is normalized:"
}], "Text",
 CellID->1192942815,ExpressionUUID->"09cb884c-5fc8-b209-3fc8-22165a620153"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"uosc", " ", "@", " ", 
      RowBox[{"CoherentState", "[", 
       RowBox[{"\"\<Normalized\>\"", " ", "->", " ", "False"}], "]"}]}], 
     ")"}], "[", "\"\<AmplitudesList\>\"", "]"}], " ", "-", "\n", "  ", 
   RowBox[{
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "\[Omega]", " ", 
       RowBox[{"t", "/", "2"}]}], ")"}]}], " ", 
    RowBox[{
     RowBox[{
      RowBox[{"CoherentState", "[", 
       RowBox[{"\"\<Normalized\>\"", " ", "->", " ", "False"}], "]"}], "[", 
      RowBox[{"\[FormalAlpha]", " ", 
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[Omega]", " ", "t"}], ")"}]}]}], "]"}], 
     "[", "\"\<AmplitudesList\>\"", "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->556077107,ExpressionUUID->"376c6589-bcca-29e8-5d14-7cd3357f7b32"],

Cell[TextData[{
 "All 16 amplitudes agree for every ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667bb688-7420-22c7-0e18-2fd27dd5702d"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72002252-da4c-5210-223f-c41fdff9217a"],
 ", ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "084561a7-5440-aaee-387b-78015dfaf834"],
 ". The statement holds at the 16-level cutoff, amplitude by amplitude. \
Because the propagator is diagonal, the truncation does not mix levels, and \
the same identity holds at any cutoff."
}], "Text",
 CellID->15883883,ExpressionUUID->"721e71e5-9ca7-ded5-2226-68cf1553a43f"],

Cell[TextData[{
 "Check with the state comparison ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a84e7eb-55e0-1894-3abb-feb563956afe"],
 " on normalized states, which ignores the global phase and so tests only the \
rotated label:"
}], "Text",
 CellID->308842859,ExpressionUUID->"3261920b-7b77-02d6-621e-14557e02503c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"uosc", " ", "@", " ", 
   RowBox[{"CoherentState", "[", "]"}]}], " ", "==", " ", 
  RowBox[{
   RowBox[{"CoherentState", "[", "]"}], "[", 
   RowBox[{"\[FormalAlpha]", " ", 
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "\[Omega]", " ", "t"}], ")"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[53]:= ",
 CellID->1108042358,ExpressionUUID->"4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],

Cell["\<\
Hong-Ou-Mandel with Partially Distinguishable Photons: the Dip Depth Is the \
Polarization Overlap\
\>", "Section",
 CellID->1009200201,ExpressionUUID->"7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],

Cell[TextData[{
 "Two photons meet at a beam splitter with angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d92934-9aba-8299-77e6-c17e1f4cd0e3"],
 ". The first is horizontally polarized; the second is polarized at angle ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    StyleBox["\[Chi]", "TI"], 
    TemplateBox[{
      StyleBox["H", "TI"]},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], 
    StyleBox["\[Chi]", "TI"], 
    TemplateBox[{
      StyleBox["V", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 ", and the detectors do not resolve polarization. How does the coincidence \
probability depend on ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22235db8-54be-42b7-53d1-54e25d4b109d"],
 "? Treat the polarizations as two extra modes, ordered ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["1", 
    StyleBox["H", "TI"]], ",", 
   SubscriptBox["2", 
    StyleBox["H", "TI"]], ",", 
   SubscriptBox["1", 
    StyleBox["V", "TI"]], ",", 
   SubscriptBox["2", 
    StyleBox["V", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0976d5ae-737d-f257-3f0d-cc080609c0bd"],
 ", with one beam splitter acting on the horizontal pair and an identical one \
on the vertical pair. The input is a superposition of ",
 Cell[BoxData[
  TemplateBox[{"1,1,0,0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13e711b4-4d78-4d68-419c-88fe640d17b2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1,0,0,1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
 ", so each output amplitude is the same superposition of two interferometer \
amplitudes."
}], "Text",
 CellID->752465254,ExpressionUUID->"2f6c0922-6605-ed68-5513-a08c13b1b7b2"],

Cell[TextData[{
 "Sum ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
       StyleBox["A", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1100", "\[Rule]", 
        StyleBox["T", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1], "+", 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["\[Chi]", "TI"], "\[ThinSpace]", 
       StyleBox["A", "TI"], 
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"1001", "\[Rule]", 
        StyleBox["T", "TI"]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2caab86a-2af9-b1b1-54a9-32344e8d039b"],
 " over the four outputs ",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f56169e-4783-4dbb-256d-8fd872361781"],
 " with one photon in each path:"
}], "Text",
 CellID->891183881,ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pol", " ", "=", " ", 
   RowBox[{"QuantumInterferometer", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{
        RowBox[{"\"\<BS\>\"", "[", "\[Theta]", "]"}], " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}]}], "}"}], ",", " ", "4"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"coinc", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "\[Chi]", "]"}], " ", 
          RowBox[{"pol", "[", 
           RowBox[{"\"\<Amplitude\>\"", ",", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], 
              "}"}], " ", "->", " ", "#"}]}], "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Chi]", "]"}], " ", 
          RowBox[{"pol", "[", 
           RowBox[{"\"\<Amplitude\>\"", ",", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], 
              "}"}], " ", "->", " ", "#"}]}], "]"}]}]}], "]"}], "^", "2"}], 
      " ", "&"}], " ", "/@", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"coinc", " ", "==", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "4"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "4"}], " ", "-", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Theta]"}], "]"}], "^", "2"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[Chi]", "]"}], "^", "2"}], "/", "2"}]}]}]}], ",",
    " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "\[Chi]"}], "}"}], ",", " ", "Reals"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[54]:= ",
 CellID->741634648,ExpressionUUID->"67558936-e5eb-8680-0d6a-2173939fecea"],

Cell[TextData[{
 "The coincidence probability is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "-", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["\[Theta]", "TI"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1072dc7c-f7d5-c74e-4001-d6398261ad94"],
 ": the classical value for distinguishable particles, minus an interference \
term weighted by the squared overlap ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3462f0a3-098c-f6b3-5c11-e90da83edc99"],
 " of the two polarization states."
}], "Text",
 CellID->359589406,ExpressionUUID->"04cac1af-436c-9192-2cc9-d809761ee3f8"],

Cell[TextData[{
 "Take the limits: identical photons (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63be94f2-239e-9b81-1145-0dbc5628e9eb"],
 "), orthogonal polarizations (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Chi]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],
 "), and the balanced splitter (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
 "):"
}], "Text",
 CellID->533832725,ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"coinc", " ", "/.", " ", 
      RowBox[{"\[Chi]", " ", "->", " ", "0"}]}], ",", " ", 
     RowBox[{"coinc", " ", "/.", " ", 
      RowBox[{"\[Chi]", " ", "->", " ", 
       RowBox[{"\[Pi]", "/", "2"}]}]}], ",", " ", 
     RowBox[{"coinc", " ", "/.", " ", 
      RowBox[{"\[Theta]", " ", "->", " ", 
       RowBox[{"\[Pi]", "/", "4"}]}]}]}], "}"}], ",", " ", 
   RowBox[{"Element", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "\[Chi]"}], "}"}], ",", " ", "Reals"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[55]:= ",
 CellID->739917449,ExpressionUUID->"178a6a52-23e4-1142-3d89-8c1c559163a8"],

Cell[TextData[{
 "Identical photons give ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "2", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
 ", the Hong-Ou-Mandel result; orthogonal polarizations give ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "4"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719ae17a-c654-ed44-27b9-f927f3e6b7ae"],
 ", the result for distinguishable particles. At the balanced splitter the \
coincidence is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Chi]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c8f42b-c628-388a-12f7-ee74f3c28ad0"],
 ": the depth of the Hong-Ou-Mandel dip measures how indistinguishable the \
photons are."
}], "Text",
 CellID->473762610,ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell["\<\
Entanglement Sudden Death: the Death Time and Its Condition from One Reduce\
\>", "Section",
 CellID->1751712322,ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[TextData[{
 "Two qubits start in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    StyleBox["\[Theta]", "TI"], 
    TemplateBox[{"00"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["sin",
     FontSlant->"Plain"], 
    StyleBox["\[Theta]", "TI"], 
    TemplateBox[{"11"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 ", and each decays on its own from ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 " at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7c794a-82c2-56e7-3604-711437773ccd"],
 ". Every local population decays smoothly, yet the entanglement can vanish \
at a finite time (Yu and Eberly). When, and for which ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 "? A numerical solver answers this on a grid of ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 ". Here ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 " stay symbols, so the answer is a formula together with the range of ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 " where it holds."
}], "Text",
 CellID->1390140890,ExpressionUUID->"30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],

Cell[TextData[{
 "Solve the master equation with jump operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "-"], "=", 
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"1"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 " on each qubit, and no Hamiltonian (in the frame rotating with the qubits \
the free evolution only adds phases, which the entanglement does not see):"
}], "Text",
 CellID->1031105928,ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"t", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", 
     RowBox[{"\[Pi]", "/", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lower", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]pair", " ", "=", " ", 
   RowBox[{"QuantumEvolve", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"0", " ", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], ",", "\n", "    ", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"lower", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
        RowBox[{"QuantumOperator", "[", 
         RowBox[{"lower", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]", ",", " ", "\[Gamma]"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", "0", ",",
         " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}], "]"}], ",", " ", 
     "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"dm", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{"\[Rho]pair", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], 
    "]"}]}], "]"}]}], "Input",
 CellLabel->"In[56]:= ",
 CellID->1410588720,ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell[TextData[{
 "The state stays an X-state: the coherence ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "14"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 " between ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ff5c08-e081-ff27-4e85-56559135c20d"],
 " decays as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c988c4-3ef2-8066-2df6-21aeba84d34c"],
 ", while the decay of ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],
 " fills the one-excitation populations ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "22"], "=", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "33"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 ". For this X-state, where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "23"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
 ", the concurrence is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   RowBox[{"(", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{GridBox[{
          {
           SubscriptBox[
            StyleBox["\[Rho]", "TI"], "14"]}
         },
         GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
         GridBoxSpacings->{"Columns" -> {{0.15}}}], "-", 
        SqrtBox[
         RowBox[{
          SubscriptBox[
           StyleBox["\[Rho]", "TI"], "22"], 
          SubscriptBox[
           StyleBox["\[Rho]", "TI"], "33"]}]]}], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab8b877-e011-189c-2a47-323091a46ae6"],
 "."
}], "Text",
 CellID->1051974278,ExpressionUUID->"35eb0178-2238-e094-63e8-992257b2b2fe"],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{GridBox[{
      {
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "14"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "-", 
    SqrtBox[
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], "22"], 
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], "33"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 ":"
}], "Text",
 CellID->1989924844,ExpressionUUID->"462f64f6-435d-c7dd-6fd5-7db076e9ad27"],

Cell[BoxData[
 RowBox[{"conc", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"dm", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "4"}], "]"}], "]"}], "]"}], " ", "-", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"dm", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], " ", 
        RowBox[{"dm", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", " ", "3"}], "]"}], "]"}]}], "]"}]}], ")"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[57]:= ",
 CellID->695529426,ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"],

Cell["Find when it reaches zero at a positive time:", "Text",
 CellID->767788723,ExpressionUUID->"0fd1c247-21a4-d962-35ee-e4215056a848"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"conc", " ", "==", " ", "0"}], " ", "&&", " ", 
     RowBox[{"t", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", 
      RowBox[{"\[Pi]", "/", "2"}]}]}], ",", " ", "t", ",", " ", "Reals"}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[58]:= ",
 CellID->494419947,ExpressionUUID->"09347675-9fce-c17b-38cc-683f1a789041"],

Cell[TextData[{
 "The entanglement dies at ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["t", "TI"], "*"], "=", 
   FractionBox["1", 
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", 
   FractionBox["1", 
    RowBox[{"1", "-", 
     StyleBox["cot",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c597ed5-00d9-d535-5467-779fb16dbc1f"],
 ", and only when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], ">", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c4d8d6-27c8-a0db-0efb-d1905262f221"],
 ", that is, when the doubly excited ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d3801b6-8b23-0df3-74c7-98f02ed657d9"],
 " carries more weight than ",
 Cell[BoxData[
  TemplateBox[{"00"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"],
 ". In other words, the formula and the condition for it to exist come out of \
the same computation. Below ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35ec423d-cde2-7917-6394-6466eb97487d"],
 " the coherence always wins and the entanglement only fades asymptotically; \
as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "\[Rule]", "\[Pi]", "/", "4"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05e0e9bc-56b1-1bf2-339f-00e6634469d8"],
 " from above, ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["t", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46408f14-a324-388b-6e7f-2751d6d68ad1"],
 " diverges."
}], "Text",
 CellID->1581507689,ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"],

Cell[TextData[{
 "Check against QuantumFramework's own concurrence, which knows nothing of \
the X-state formula: at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "678faed4-2cca-f411-0db4-479e457cdf7b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3cac94-919f-f08d-6ac3-45de202bc2d7"],
 " it should still be positive at ",
 Cell[BoxData[
  RowBox[{"0.9", "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["t", "TI"], "*"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634a1270-2707-566e-1149-943a52b23cb4"],
 " and vanish exactly at ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["t", "TI"], "*"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "571f0194-b08e-3ab4-7d24-98d1c138889e"],
 ":"
}], "Text",
 CellID->2120100675,ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"QuantumEntanglementMonotone", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"dm", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]", " ", "->", " ", 
           RowBox[{"\[Pi]", "/", "3"}]}], ",", " ", 
          RowBox[{"\[Gamma]", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"t", " ", "->", " ", "#"}]}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", "\"\<Concurrence\>\""}], 
     "]"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"Cot", "[", 
          RowBox[{"\[Pi]", "/", "3"}], "]"}]}], ")"}]}], "]"}], " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"9", "/", "10"}], ",", " ", "1"}], "}"}]}], ")"}]}], " ", "//",
   " ", "N"}]], "Input",
 CellLabel->"In[59]:= ",
 CellID->950326543,ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"],

Cell["\<\
A Qutrit Wigner Function Under Depolarizing Noise: the Negativity Dies at an \
Exact Time\
\>", "Section",
 CellID->1689126594,ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"],

Cell[TextData[{
 "A qutrit state can be written as a discrete Wigner function: nine real \
numbers on a ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],
 " phase-space grid that sum to one. Negative entries are what separate it \
from a probability distribution, and their total size, the mana of Veitch et \
al. (2014), is a resource monotone for magic-state quantum computation. Under \
noise the negative entries fill in. At what time, exactly, does the last one \
reach zero? A numerical solver gives ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d34e655-b983-17e8-14cb-f81f38367d32"],
 " on a time grid and the crossing to the grid spacing. Here the rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],
 " and the time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21714cd0-c04e-e57a-570f-659df1f8cc40"],
 " stay symbols."
}], "Text",
 CellID->1490757098,ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell[TextData[{
 "The strange state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"1"},
      "Ket"], "-", 
     TemplateBox[{"2"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],
 " and its Wigner function on the grid:"
}], "Text",
 CellID->148290444,ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"strange", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Normal", "[", 
  RowBox[{"strange", "[", "\"\<PhaseSpace\>\"", "]"}], "]"}]}], "Input",
 CellLabel->"In[60]:= ",
 CellID->1707667820,ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"],

Cell[TextData[{
 "All the negativity sits at the origin of phase space, and ",
 Cell[BoxData[
  RowBox[{"-", "1", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5219761b-8a64-c9ff-0227-68452f169bc5"],
 " is the most negative value a qutrit Wigner function can take (the \
phase-point operators have eigenvalues ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
 ")."
}], "Text",
 CellID->933399197,ExpressionUUID->"7c22b8c2-70f4-0562-25d1-31ac00816c48"],

Cell[TextData[{
 "Take depolarizing noise built from the eight non-identity Weyl operators ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["a", "TI"]], 
   SuperscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["b", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04fec585-b88c-469b-2c85-dcef39392ce1"],
 ", each a jump operator at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aa617d4-4041-969d-2a5d-8e9e71f5fce7"],
 ", and write its Lindblad generator ",
 Cell[BoxData[
  StyleBox["G", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e86e5c8-d785-1389-06bd-fc95e23061d3"],
 " in the Wigner basis. List its distinct entries and its column sums:"
}], "Text",
 CellID->955179929,ExpressionUUID->"3582ea65-851b-2569-63b1-0c4f2caf8fb3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"t", " ", ">=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x3", ",", " ", "z3"}], "}"}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", "#", "]"}], "[", "\"\<Matrix\>\"", 
       "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<X\>\"", "[", "3", "]"}], ",", " ", 
      RowBox[{"\"\<Z\>\"", "[", "3", "]"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"weyl", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{"MatrixPower", "[", 
        RowBox[{"x3", ",", " ", "#1"}], "]"}], " ", ".", " ", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"z3", ",", " ", "#2"}], "]"}]}], "]"}], " ", "&"}], " ", "@@@",
     " ", 
    RowBox[{"Rest", "[", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", "2"}], "]"}], ",", " ", "2"}], "]"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumPhaseSpaceTransform", "[", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<Liouvillian\>\"", "[", 
        RowBox[{"None", ",", " ", "weyl", ",", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"\[Gamma]", "/", "9"}], ",", " ", "8"}], "]"}]}], "]"}], 
       "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Union", "[", 
    RowBox[{"Flatten", "[", "G", "]"}], "]"}], ",", " ", 
   RowBox[{"Total", "[", "G", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[61]:= ",
 CellID->775067320,ExpressionUUID->"5e81d752-d9a7-cf7a-06be-cf1fd8539240"],

Cell[TextData[{
 "The generator is real, its off-diagonal entries are all ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dc17641-57cc-3497-1bff-682b627e9efd"],
 ", and every column sums to zero. In other words, in this representation the \
Lindblad equation is a classical rate equation: each Weyl operator translates \
the phase-space grid, so the noise is a random walk that hops from every \
point to each of the other eight at rate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647a9320-5a37-336f-0c19-0a8a5fc381b5"],
 ", carrying the negative entry along with it."
}], "Text",
 CellID->72268088,ExpressionUUID->"57b40e76-1aa6-da65-7d4b-a0309f50a94f"],

Cell[TextData[{
 "Solve the master equation from the strange state and read the Wigner \
function at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "575b10e3-003a-b957-7d78-89cdb1cc0bbd"],
 ":"
}], "Text",
 CellID->546416532,ExpressionUUID->"7c7345dd-208f-a284-2401-5c87513bf0ee"],

Cell[BoxData[
 RowBox[{"wt", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"0", " ", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], ",", " ", 
       RowBox[{"weyl", " ", "->", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"\[Gamma]", "/", "9"}], ",", " ", "8"}], "]"}]}], ",", " ", 
       "strange", ",", " ", "t"}], "]"}], "[", "\"\<PhaseSpace\>\"", "]"}], 
    "]"}], "]"}]}]], "Input",
 CellLabel->"In[62]:= ",
 CellID->2117784656,ExpressionUUID->"0121a537-2575-8479-30de-3d714c01ef43"],

Cell[TextData[{
 "The origin entry relaxes as ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "9"], "-", 
   FractionBox["4", "9"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 " toward the uniform value ",
 Cell[BoxData[
  FractionBox["1", "9"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739af998-c5c1-31b3-21b9-f0c5ec758399"],
 ", while the other eight decay toward it from above. Find when the origin \
entry reaches zero:"
}], "Text",
 CellID->853117843,ExpressionUUID->"003becda-d908-4451-31d8-0587d8bd2ebb"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"wt", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "==", " ", "0"}], " ",
     "&&", " ", 
    RowBox[{"t", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}], ",", " ", "t", ",", " ", 
   "Reals"}], "]"}]], "Input",
 CellLabel->"In[63]:= ",
 CellID->623836386,ExpressionUUID->"7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],

Cell[TextData[{
 "The negativity dies at ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["t", "TI"], "*"], "=", "2", 
   StyleBox["ln",
    FontSlant->"Plain"], "\[ThinSpace]", "2", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 ", the moment the surviving fraction ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 " of the strange state falls to ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 ". From then on all nine entries are nonnegative, the Wigner function is a \
probability distribution, and the mana is zero."
}], "Text",
 CellID->564394165,ExpressionUUID->"0b3ec616-de69-0141-3ac5-d853db1c53ab"],

Cell["\<\
Check the long-time limit, the maximally mixed state, whose Wigner function \
is uniform:\
\>", "Text",
 CellID->2048244887,ExpressionUUID->"7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{"wt", ",", " ", 
   RowBox[{"t", " ", "->", " ", "Infinity"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[64]:= ",
 CellID->1432457359,ExpressionUUID->"0aaecb0d-dff0-cd78-3a55-e356d98a9442"],

Cell[TextData[{
 "The Amplitude-Damping Master Equation: It Is the Kraus Channel at ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"]
}], "Section",
 CellID->200346680,ExpressionUUID->"07179650-9fbb-2bc1-2d2c-081a1a4e792b"],

Cell[TextData[{
 "A qubit decays from ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b0854-5043-0b63-6268-a21e61f65649"],
 " at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],
 ". Integrating its master equation for a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],
 " gives a linear map on density matrices. Is that map the textbook \
amplitude-damping channel, with Kraus operators ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", 
    SqrtBox[
     RowBox[{"1", "-", 
      StyleBox["\[Lambda]", "TI"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70e98525-204e-6ba4-2096-1c8f51fb398e"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Lambda]", "TI"]], 
   TemplateBox[{"0"},
    "Ket"], 
   TemplateBox[{"1"},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 ", and at which damping parameter ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],
 "? A numerical tool compares the two on sample states and times. Here the \
initial state is a general qubit density matrix with symbolic population ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],
 " and coherence ",
 Cell[BoxData[
  StyleBox["c", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 ", and ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 " are symbols."
}], "Text",
 CellID->447384324,ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell[TextData[{
 "Solve the master equation with jump operator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "-"], "=", 
   RowBox[{
    TemplateBox[{"0"},
     "Ket"], 
    TemplateBox[{"1"},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e766a94-5ec6-6187-160d-83de5b7333ed"],
 " from the general state ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eead67c-41e5-1519-56e9-c82677907c63"],
 ":"
}], "Text",
 CellID->1438124241,ExpressionUUID->"23a655ec-dad2-e192-515e-4cc9df64b3f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"t", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<=", " ", "p", " ", "<=", " ", "1"}], " ", "&&", " ", 
    RowBox[{"t1", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"t2", " ", ">=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]m", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]0", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "c"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Conjugate", "[", "c", "]"}], ",", " ", 
        RowBox[{"1", " ", "-", " ", "p"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"me", " ", "=", " ", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"QuantumEvolve", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"0", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"{", "\[Sigma]m", "}"}], " ", "->", " ", 
       RowBox[{"{", "\[Gamma]", "}"}]}], ",", " ", "\[Rho]0", ",", " ", "t"}],
      "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}]}], "Input",
 CellLabel->"In[65]:= ",
 CellID->2000382747,ExpressionUUID->"62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],

Cell[TextData[{
 "The excited population decays at ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 " and the coherence at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 ". Compare with QuantumFramework's named amplitude-damping channel at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57533ce7-69d6-be0e-7d60-b5c108600554"],
 " acting on the same symbolic state:"
}], "Text",
 CellID->902867877,ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"me", " ", "==", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuantumChannel", "[", 
       RowBox[{"\"\<AmplitudeDamping\>\"", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"E", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[Gamma]"}], " ", "t"}], ")"}]}]}], "]"}], "]"}], "[",
       "\[Rho]0", "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[66]:= ",
 CellID->1315202099,ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell[TextData[{
 "In other words, the master equation integrated for time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 " is the Kraus channel at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", "1", "-", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 ", for every initial state and every rate."
}], "Text",
 CellID->376763343,ExpressionUUID->"5561d787-26b0-8d0a-031e-cee1534ad450"],

Cell[TextData[{
 "Since evolution for ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea91e8-e80e-a1ed-35e9-08b589b8f337"],
 " followed by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37725419-c8bf-c4cd-5d02-4e42e94bae17"],
 " is evolution for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["t", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eee5857-8f9d-bf63-1696-52112a290249"],
 ", composing two such channels must give the channel at the summed time. \
Check the composition as channel objects:"
}], "Text",
 CellID->126027414,ExpressionUUID->"2635f536-2fc9-ab3c-4fca-ed704a7df606"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ad", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"QuantumChannel", "[", 
    RowBox[{"\"\<AmplitudeDamping\>\"", "[", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "\[Gamma]"}], " ", "s"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ad", "[", "t1", "]"}], " ", "@", " ", 
        RowBox[{"ad", "[", "t2", "]"}]}], ")"}], "[", "\[Rho]0", "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", "==", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ad", "[", 
       RowBox[{"t1", " ", "+", " ", "t2"}], "]"}], "[", "\[Rho]0", "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[67]:= ",
 CellID->570920987,ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"],

Cell[TextData[{
 "Two Atoms Decaying Into a Shared Field: Rates ",
 Cell[BoxData[
  RowBox[{"1", "\[PlusMinus]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 " and an Exactly Dark Singlet"
}], "Section",
 CellID->378517449,ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"],

Cell[TextData[{
 "Two two-level atoms close together radiate into the same field, so their \
decay is correlated: the Lindblad equation carries a rate matrix ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "(", GridBox[{
     {"1", 
      StyleBox["r", "TI"]},
     {
      StyleBox["r", "TI"], "1"}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ba8138a-66ce-478c-2957-8ad4137b2dd6"],
 " with correlation ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["r", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],
 " (the Kossakowski form). How fast do the singlet and triplet decay, and for \
which ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd66644-13e4-6fa7-15ee-782ea591358d"],
 " does a state stop decaying? QuTiP takes a list of collapse operators, so \
the rate matrix must first be diagonalized by hand, and ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00abf1cf-696b-3507-30a8-e8a9081f9c6d"],
 " is a number in each run. Here ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d898fe-d35a-9eef-31e7-11bbe6ece435"],
 " stays a symbol, and time is in units of ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03dda600-4b0b-c3af-31e2-386a6ebf91f5"],
 "."
}], "Text",
 CellID->1671903560,ExpressionUUID->"4de38b79-ee67-8bee-7b90-23228b13d934"],

Cell["\<\
Build the Liouvillian with the full rate matrix and ask for its spectrum:\
\>", "Text",
 CellID->1307059254,ExpressionUUID->"347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"0", " ", "<=", " ", "r", " ", "<=", " ", "1"}], " ", "&&", " ", 
    RowBox[{"t", " ", ">=", " ", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"L1", ",", " ", "L2"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pair", " ", "=", " ", 
   RowBox[{"QuantumOperator", "[", 
    RowBox[{"\"\<Liouvillian\>\"", "[", 
     RowBox[{
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"0", " ", 
        RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"L1", ",", " ", "L2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "r"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Eigenvalues", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"pair", "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[68]:= ",
 CellID->538512558,ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],

Cell[TextData[{
 "The spectrum contains the two collective decay rates ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 " and ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c340229-13f4-0181-15cb-a473a58153eb"],
 ", the eigenvalues of the rate matrix: the environment couples to the \
antisymmetric and symmetric combinations of the two atoms, not to each atom. \
At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25dfa134-0866-9bb5-53e4-397ea910e99f"],
 " several eigenvalues reach zero, so the set of stationary states grows."
}], "Text",
 CellID->824717693,ExpressionUUID->"425139cc-45a5-cefb-726e-b0966c5194c1"],

Cell[TextData[{
 "Solve the master equation for the singlet ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"01"},
      "Ket"], "-", 
     TemplateBox[{"10"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d922994-f334-45bb-7ba1-c0d186c12f81"],
 " and the triplet ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"01"},
      "Ket"], "+", 
     TemplateBox[{"10"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c25578-1780-b25e-2ef2-4d22a23a00a4"],
 ", and read the mean number of excitations:"
}], "Text",
 CellID->496527141,ExpressionUUID->"5f70617e-b140-9f95-0500-793bc0fae5ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"excitation", "[", "\[Psi]_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumEvolve", "[", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"0", " ", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"L1", ",", " ", "L2"}], "}"}], " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "r"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "1"}], "}"}]}], "}"}]}], ",", " ", 
          "\[Psi]", ",", " ", "t"}], "]"}], "[", "\"\<DensityMatrix\>\"", 
        "]"}], "]"}], " ", ".", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "2"}], "}"}], 
       "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"excitation", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", 
        RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], ",", " ", 
    RowBox[{"QuantumState", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], "}"}]}]}], "Input",
 CellLabel->"In[69]:= ",
 CellID->2009363188,ExpressionUUID->"79d0371a-30a6-04e5-2fef-af4441536ecf"],

Cell[TextData[{
 "The singlet decays at the subradiant rate ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d950d76-dd18-2b24-2baa-a533d4ad760e"],
 " and the triplet at the superradiant rate ",
 Cell[BoxData[
  RowBox[{"1", "+", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7234a9f4-3232-6781-23cb-40be47c74deb"],
 ": the same two atoms in the same environment, distinguished only by a \
relative sign. In other words, the two emission amplitudes interfere \
destructively in the singlet and constructively in the triplet."
}], "Text",
 CellID->55669068,ExpressionUUID->"42668d78-f434-72a4-721d-2525fdc1408e"],

Cell[TextData[{
 "For which ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7cc198-0ad8-2426-3403-d8c2af528f0c"],
 " is the singlet an exact stationary state, ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalL]", 
   StyleBox["[",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], 
    StyleBox["S", "TI"]], 
   StyleBox["]",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69698b1d-3dc2-3628-1f16-2347b4749d72"],
 "?"
}], "Text",
 CellID->1753574084,ExpressionUUID->"701e1eb7-eeba-61c8-2025-97f08b4f3312"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"singlet", " ", "=", " ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"pair", "[", "\"\<Matrix\>\"", "]"}], "]"}], " ", ".", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{"singlet", "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], 
       "]"}]}], " ", "==", " ", "0"}], "]"}], ",", " ", "r"}], 
  "]"}]}], "Input",
 CellLabel->"In[70]:= ",
 CellID->2038359728,ExpressionUUID->"0e322415-281a-3695-37c1-be5f49ac9cff"],

Cell[TextData[{
 "Only at perfect correlation: there the singlet is a decoherence-free state, \
frozen for all time, which is the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 " end of its decay rate ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e8a6a96-06b4-6465-0689-83d0b3414f4f"],
 "."
}], "Text",
 CellID->1525364821,ExpressionUUID->"55951090-ef25-ccfd-03aa-89dd8ad196c7"],

Cell["\<\
A Coherent Error on the Three-Qubit Code: Measurement Records Undo It for \
Every Angle\
\>", "Section",
 CellID->1535108406,ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell[TextData[{
 "Encode ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["a", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["b", "TI"], 
    TemplateBox[{"1"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5930221d-821b-4026-08cf-c44737ae130c"],
 " as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["a", "TI"], 
    TemplateBox[{"000"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["b", "TI"], 
    TemplateBox[{"111"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ba63e9-5df8-c241-1e5a-7ab3547290ab"],
 ", hit the middle qubit with a coherent rotation ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox["X", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "319e51f9-a9ce-1d21-67a6-48a2c87b640b"],
 " (not a Pauli error), measure the parities ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4962c-805e-a216-4e8b-087631e8f17c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313d5a7b-7caf-7acc-60c3-5c25755a4816"],
 ", and correct with ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da78195-91be-94f0-5b5c-18df2048feda"],
 " gates conditioned on the outcomes. The textbook argument (Nielsen and \
Chuang, \[Section]10.2) says the syndrome measurement turns the rotation into \
either no error or an ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["X", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 " error, with weights ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7d0c35-7157-44bf-6502-a67f00e22e85"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
 ". A simulator with mid-circuit measurement samples one outcome per shot and \
estimates the fidelity. QuantumFramework keeps each measurement outcome as a \
pointer qubit, so the correction is an ordinary controlled gate and the whole \
cycle is one symbolic state, with ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064e3005-d89e-7c03-2e75-aa6ed92b4769"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76c2caed-aea0-13a2-1ef1-e3b6cb556188"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260c3025-1fa9-9acd-4e33-a98f9a5de817"],
 " left as symbols."
}], "Text",
 CellID->1528788962,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell[TextData[{
 "A parity measurement given as the two projectors ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2982aea8-af87-65d7-5fb1-47f5ca324f3d"],
 ", which learns the parity and leaves superpositions inside each parity \
sector intact:"
}], "Text",
 CellID->1505774531,ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zz", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"syndrome", "[", 
    RowBox[{"i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumMeasurementOperator", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "4", "]"}], " ", "+", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "4", "]"}], " ", "-", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[71]:= ",
 CellID->535490749,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[TextData[{
 "The circuit: encode, rotate, record the two parities on pointer wires ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f1a39a-81e0-db80-538e-3ac4379aa9ea"],
 ", then apply ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["X", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35466be2-b7a8-26dc-637d-82cfc2428c26"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["X", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bdea72-0ba3-5f4c-0842-0c3cae562596"],
 " or ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["X", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8cef58-e908-949c-16b3-070588a2fee6"],
 " controlled on the record patterns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
