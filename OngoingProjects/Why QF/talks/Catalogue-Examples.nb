 ":"
}], "Text",
 CellID->1238905205,ExpressionUUID->"2161c865-0900-0907-571e-e24fa8b5586d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qec", " ", "=", " ", 
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{
        RowBox[{"\"\<RX\>\"", "[", 
         RowBox[{"2", " ", "\[Theta]"}], "]"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
      RowBox[{"syndrome", "[", 
       RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
      RowBox[{"syndrome", "[", 
       RowBox[{"2", ",", " ", "3"}], "]"}], ",", "\n", "    ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<C\>\"", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<X\>\"", ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"-", "1"}], "}"}]}], "]"}], "]"}], ",", "\n", "    ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<C\>\"", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<X\>\"", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], ",", " ", 
         RowBox[{"{", "}"}]}], "]"}], "]"}], ",", "\n", "    ", 
      RowBox[{"QuantumOperator", "[", 
       RowBox[{"\"\<C\>\"", "[", 
        RowBox[{
         RowBox[{"QuantumOperator", "[", 
          RowBox[{"\"\<X\>\"", ",", " ", 
           RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"-", "1"}], "}"}], ",", " ", 
         RowBox[{"{", "0", "}"}]}], "]"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"outCode", " ", "=", " ", 
   RowBox[{"qec", "[", 
    RowBox[{"QuantumTensorProduct", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], ",", " ", 
      RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[72]:= ",
 CellID->2125008310,ExpressionUUID->"3cadbe4b-a339-c651-6452-3014d6cdacbb"],

Cell[TextData[{
 "Compare the output, wires ordered ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "-", "1"}], ",", 
   RowBox[{"0", ",", "1", ",", "2"}], ",", 
   RowBox[{"3", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31169419-f57b-983b-672d-0e42fc0feb01"],
 ", with the product of the record state ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["cos",
     FontSlant->"Plain"], 
    StyleBox["\[Theta]", "TI"], 
    TemplateBox[{"00"},
     "Ket"]}], "-", 
   RowBox[{
    StyleBox["i", "TI"], 
    StyleBox["sin",
     FontSlant->"Plain"], 
    StyleBox["\[Theta]", "TI"], 
    TemplateBox[{"11"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40aa99e8-53bd-499c-70a9-10b266481be6"],
 " and the codeword:"
}], "Text",
 CellID->1684656716,ExpressionUUID->"5d165407-aaf3-867b-0b2e-4e60ce87ed41"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Normal", "[", 
   RowBox[{"outCode", "[", "\"\<StateVector\>\"", "]"}], "]"}], " ", "==", 
  " ", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"QuantumTensorProduct", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", "0", 
         ",", " ", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}], "]"}], ",", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{
        RowBox[{"a", " ", 
         RowBox[{"UnitVector", "[", 
          RowBox[{"8", ",", " ", "1"}], "]"}]}], " ", "+", " ", 
        RowBox[{"b", " ", 
         RowBox[{"UnitVector", "[", 
          RowBox[{"8", ",", " ", "8"}], "]"}]}]}], "]"}]}], "]"}], 
    "[", "\"\<StateVector\>\"", "]"}], "]"}]}]], "Input",
 CellLabel->"In[73]:= ",
 CellID->2057792111,ExpressionUUID->"75cb8946-a0dc-0da7-23c8-2123d169578d"],

Cell[TextData[{
 "The output factorizes exactly. In other words, the syndrome measurement has \
digitized the rotation into \"no error\" and \"",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["X", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63688a50-35e7-99e6-1117-2c1a4393ebcc"],
 "\" with weights ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12187c95-2034-8b29-4238-75df51c6d673"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"],
 ", the record-controlled gates have fixed both branches, and the whole error \
now lives in the record qubits. The code qubits are back in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["a", "TI"], 
    TemplateBox[{"000"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["b", "TI"], 
    TemplateBox[{"111"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],
 " for every ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "656925a1-dac3-d209-1316-bc0adf77a153"],
 ", with no classical communication step anywhere."
}], "Text",
 CellID->408837332,ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"],

Cell["\<\
Check that the code qubits alone, tracing out the records, are in the pure \
codeword:\
\>", "Text",
 CellID->1068510841,ExpressionUUID->"29829495-262a-abaa-5fb1-0ddf53dcf9f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"code", " ", "=", " ", 
   RowBox[{
    RowBox[{"a", " ", 
     RowBox[{"UnitVector", "[", 
      RowBox[{"8", ",", " ", "1"}], "]"}]}], " ", "+", " ", 
    RowBox[{"b", " ", 
     RowBox[{"UnitVector", "[", 
      RowBox[{"8", ",", " ", "8"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumPartialTrace", "[", 
      RowBox[{"outCode", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], " ", "==", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", " ", "code", ",", " ", 
     RowBox[{"Conjugate", "[", "code", "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[74]:= ",
 CellID->1027032549,ExpressionUUID->"136212ad-a4c2-b9f3-4111-8bf6cd740bd9"],

Cell["\<\
Two Qubits Have No Bound Entanglement: an Identity and One Resolve\
\>", "Section",
 CellID->171792661,ExpressionUUID->"67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],

Cell[TextData[{
 "A bound-entangled state is entangled, yet its partial transpose is still \
positive, so no local protocol can distill a Bell pair from it. Can a \
two-qubit state be bound entangled? Sampling random states with a numerical \
package finds none, but a sample is evidence, not a proof. Here the statement \
is proved for every two-qubit density matrix, written with all 16 of its real \
Pauli coefficients left as symbols. The tool is Wootters' concurrence ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "1"], "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "2"], "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "3"], "-", 
     SubscriptBox[
      StyleBox["\[Lambda]", "TI"], "4"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "1"], "\[GreaterEqual]", "\[Ellipsis]", "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "4"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],
 " are the square roots of the eigenvalues of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", 
   StyleBox["\[Rho]", "TI"], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2673b224-f5d9-a24c-4e00-2b81fc6df096"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "~"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["y", "TI"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "*"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["y", "TI"]], "\[CircleTimes]", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["y", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27388ee6-22a7-f122-4ec7-27c05753c008"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],
 " exactly on separable states."
}], "Text",
 CellID->574949478,ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell[TextData[{
 "Build ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox[
     RowBox[{"i", "j"}], "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["i", "TI"]], "\[CircleTimes]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7641b941-63e8-8619-1e7e-312b1582ed63"],
 ", its partial transpose on the second qubit (transpose every ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],
 " block), and ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],
 ". The ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["k", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473593be-64fb-e664-6eca-0af80c8fcd4e"],
 " are the eigenvalues of ",
 Cell[BoxData[
  StyleBox["R", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79a8e286-b760-8808-2f57-fbe3c21adb52"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Sum]",
    FontSize->1.15 Inherited], 
   SubsuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"], "2"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["R", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Sum]",
    FontSize->1.15 Inherited], 
   SubsuperscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"], "4"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["R", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Product]",
    FontSize->1.15 Inherited], 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], 
    StyleBox["k", "TI"]], "=", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36bb0aa4-099e-3511-5e58-a30ea8289c7b"],
 ". Test ",
 Cell[BoxData[
  RowBox[{"16", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["B", "TI"]]], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["Tr",
       FontSlant->"Plain"], 
      StyleBox["R", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"], "-", "2", "\[ThinSpace]", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   SuperscriptBox[
    StyleBox["R", "TI"], "2"], "+", "8", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fab4322-7f5b-c123-15a9-5a8c7aef9009"],
 " in all 16 coefficients:"
}], "Text",
 CellID->1664775781,ExpressionUUID->"559c0528-76f1-864e-03a3-9d720285ec94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"paulis", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
        "KroneckerProduct", ",", " ", "#", ",", " ", "#", ",", " ", "1"}], 
        "]"}], " ", "&"}], "[", 
      RowBox[{"PauliMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "2", ",", " ", "3"}], "}"}], 
       "]"}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]2q", " ", "=", " ", 
   RowBox[{
    RowBox[{"Array", "[", 
     RowBox[{"c", ",", " ", "16"}], "]"}], " ", ".", " ", "paulis"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]2qTB", " ", "=", " ", 
   RowBox[{"ArrayFlatten", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"Transpose", ",", " ", 
      RowBox[{"Partition", "[", 
       RowBox[{"\[Rho]2q", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", " ", "=", " ", 
   RowBox[{"\[Rho]2q", " ", ".", " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "2", "]"}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], " ", ".", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Array", "[", 
       RowBox[{"c", ",", " ", "16"}], "]"}], " ", ".", " ", 
      RowBox[{"Conjugate", "[", "paulis", "]"}]}], ")"}], " ", ".", " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "2", "]"}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"16", " ", 
    RowBox[{"Det", "[", "\[Rho]2qTB", "]"}]}], " ", "-", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Tr", "[", "R", "]"}], "^", "2"}], " ", "-", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Tr", "[", 
       RowBox[{"R", " ", ".", " ", "R"}], "]"}]}], " ", "+", " ", 
     RowBox[{"8", " ", 
      RowBox[{"Det", "[", "\[Rho]2q", "]"}]}]}], ")"}]}], "]"}]}], "Input",
 CellLabel->"In[75]:= ",
 CellID->884697794,ExpressionUUID->"4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],

Cell[TextData[{
 "The right side is a symmetric polynomial in the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], 
   StyleBox["k", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b834648-1855-f17e-29b1-581299e1c044"],
 ". Check that it equals ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Product]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["k", "TI"]], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aa15cf4-f328-f435-1a5f-55b186c2df1f"],
 ":"
}], "Text",
 CellID->784201795,ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Lambda]", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{"l", ",", " ", "4"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "\[Lambda]"}], " ", "-", " ", 
        RowBox[{"Total", "[", "\[Lambda]", "]"}]}], ")"}]}], " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"\[Lambda]", "^", "2"}], "]"}], "^", "2"}], " ", "-", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Total", "[", 
         RowBox[{"\[Lambda]", "^", "4"}], "]"}]}], " ", "+", " ", 
       RowBox[{"8", " ", 
        RowBox[{"Times", " ", "@@", " ", "\[Lambda]"}]}]}], ")"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[76]:= ",
 CellID->1193259712,ExpressionUUID->"33c53063-afff-c489-61fa-aa4cc98baed3"],

Cell[TextData[{
 "So ",
 Cell[BoxData[
  RowBox[{"16", 
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["B", "TI"]]], "=", 
   UnderscriptBox["\[Product]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["k", "TI"]], "-", 
    UnderscriptBox["\[Sum]", 
     StyleBox["j", "TI"],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08d8bcb3-70a4-55b3-38e7-35fd01513f99"],
 " for every two-qubit state. In other words, the sign of the partial \
transpose's determinant is a statement about the same four numbers that make \
up the concurrence, and the square roots have dropped out."
}], "Text",
 CellID->1084903799,ExpressionUUID->"20e38226-5aed-155d-5090-1b805e987fa7"],

Cell[TextData[{
 "A positive partial transpose makes that determinant nonnegative. Ask \
whether, for every ordered quadruple ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "1"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "2"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "3"], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["\[Lambda]", "TI"], "4"], "\[GreaterEqual]", "0"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160727ef-d1b8-0069-3e3c-bec8e04d52b3"],
 " with a nonnegative product, the concurrence is clipped to zero:"
}], "Text",
 CellID->964492758,ExpressionUUID->"261df1b1-b81e-57af-4e22-e8fb39ab3df5"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Lambda]", " ", "=", " ", 
     RowBox[{"Array", "[", 
      RowBox[{"l", ",", " ", "4"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Resolve", "[", 
    RowBox[{
     RowBox[{"ForAll", "[", 
      RowBox[{"\[Lambda]", ",", " ", 
       RowBox[{
        RowBox[{"GreaterEqual", " ", "@@", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"\[Lambda]", ",", " ", "0"}], "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Times", " ", "@@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "\[Lambda]"}], " ", "-", " ", 
            RowBox[{"Total", "[", "\[Lambda]", "]"}]}], ")"}]}], " ", ">=", 
         " ", "0"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", "\[Lambda]", "]"}], " ", "-", " ", 
         RowBox[{"Total", "[", 
          RowBox[{"Rest", "[", "\[Lambda]", "]"}], "]"}]}], " ", "<=", " ", 
        "0"}]}], "]"}], ",", " ", "Reals"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[77]:= ",
 CellID->242210635,ExpressionUUID->"00ba9d2f-c328-50fc-3059-1488f6dd22c6"],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02964792-f196-8b6e-32ae-5edf8020d9b4"],
 ": a positive partial transpose forces ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166d4e5f-4333-9385-3e13-601976c7e1ef"],
 ", which is separability. A two-qubit state is either entangled with a \
negative partial transpose or separable, so there is nothing left to be \
bound. For ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c99ee20-d785-d362-44a6-078de231be48"],
 " and ",
 Cell[BoxData[
  RowBox[{"3", "\[Times]", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60858f89-56d8-6615-10ba-26d3636d4d7f"],
 " systems a positive partial transpose no longer implies separability, and \
bound entangled states exist (Horodecki)."
}], "Text",
 CellID->360816480,ExpressionUUID->"2e45545e-c429-efe4-567b-4e1bedddb5ce"],

Cell[TextData[{
 "Cross-check on a Bell state, where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", ",", "0", ",", "0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24564246-a2b2-7a9b-4c6e-6423d74748e1"],
 " makes the product ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "273d1382-afb1-09c0-4ec2-8aefca445b2a"],
 ":"
}], "Text",
 CellID->1505759259,ExpressionUUID->"39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],

Cell[BoxData[
 RowBox[{"16", " ", 
  RowBox[{"Det", "[", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumPartialTranspose", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", "\"\<PhiPlus\>\"", "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", "]"}], 
    "]"}], "]"}]}]], "Input",
 CellLabel->"In[78]:= ",
 CellID->1384053022,ExpressionUUID->"46be6341-4be3-06d9-6e46-7b2b6d966c23"],

Cell["\<\
Robertson-Schr\[ODoubleDot]dinger for Every Qubit State and Every Pair of \
Observables: the Slack Factorizes\
\>", "Section",
 CellID->1395659232,ExpressionUUID->"352b8971-1d3f-d4c9-6328-213b94cbbe13"],

Cell[TextData[{
 "For two observables ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "227c7e4b-1c68-aac8-5204-70159502f812"],
 ", ",
 Cell[BoxData[
  StyleBox["B", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd9b5a9-dbed-51da-14e6-2cf2dd982320"],
 " on a state ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4becebe3-5bfe-fac0-7993-02cd5d88c82a"],
 ", the Robertson-Schr\[ODoubleDot]dinger relation says ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["A", "TI"], "2"], 
   SubsuperscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["B", "TI"], "2"], "\[GreaterEqual]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       RowBox[{"{", 
        StyleBox["A", "TI"]}], ",", 
       RowBox[{
        StyleBox["B", "TI"], "}"}]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1], "-", 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["A", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["B", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], ")"}], "2"], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", 
        StyleBox["i", "TI"]}]], 
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["[",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["A", "TI"], ",", 
        StyleBox["B", "TI"]}], 
       StyleBox["]",
        SpanMaxSize->1]}], 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], ")"}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "312d182f-c6c7-5e1e-60d2-9188f3722564"],
 ". For a qubit, every observable is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], "0"], 
   StyleBox["I", "TI"], "+", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1449d45f-8382-90b9-3c76-ce193634e283"],
 " and the ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["a", "TI"], "0"], 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444f09dd-766a-dba7-6c74-a087031ca98d"],
 " part drops out of both sides, so the general case is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["A", "TI"], "=", 
   OverscriptBox[
    StyleBox["a", "TI"], "\[RightVector]"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e9b65a-67eb-1624-2f96-2804119e7d0e"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], "=", 
   OverscriptBox[
    StyleBox["b", "TI"], "\[RightVector]"], "\[CenterDot]", 
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],
 " on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3de1d4-e864-19c9-04c2-f89189116b13"],
 ": nine real symbols. A numerical check draws random states and observables; \
here the inequality is decided for all of them at once."
}], "Text",
 CellID->874592789,ExpressionUUID->"1adc8861-0296-99d3-4ae3-224bb720eb39"],

Cell["Compute the slack, left side minus right side:", "Text",
 CellID->1596157938,ExpressionUUID->"47f3727e-1788-b883-6d81-7438a2220ae9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"slackRS", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]q", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"r1", ",", " ", "r2", ",", " ", "r3"}], "}"}], " ", ".", 
            " ", 
            RowBox[{"PauliMatrix", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], 
          ")"}], "/", "2"}]}], ",", " ", 
       RowBox[{"A", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a1", ",", " ", "a2", ",", " ", "a3"}], "}"}], " ", ".", 
         " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}], ",",
        " ", 
       RowBox[{"B", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"b1", ",", " ", "b2", ",", " ", "b3"}], "}"}], " ", ".", 
         " ", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}]}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ev", " ", "=", " ", 
         RowBox[{
          RowBox[{"Tr", "[", 
           RowBox[{"#", " ", ".", " ", "\[Rho]q"}], "]"}], " ", "&"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Expand", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ev", "[", 
             RowBox[{"A", " ", ".", " ", "A"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"ev", "[", "A", "]"}], "^", "2"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ev", "[", 
             RowBox[{"B", " ", ".", " ", "B"}], "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"ev", "[", "B", "]"}], "^", "2"}]}], ")"}]}], " ", "-", 
         " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ev", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"A", " ", ".", " ", "B"}], " ", "+", " ", 
                RowBox[{"B", " ", ".", " ", "A"}]}], ")"}], "/", "2"}], "]"}],
             " ", "-", " ", 
            RowBox[{
             RowBox[{"ev", "[", "A", "]"}], " ", 
             RowBox[{"ev", "[", "B", "]"}]}]}], ")"}], "^", "2"}], " ", "-", 
         " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ev", "[", 
             RowBox[{
              RowBox[{"A", " ", ".", " ", "B"}], " ", "-", " ", 
              RowBox[{"B", " ", ".", " ", "A"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "I"}], ")"}]}], ")"}], "^", "2"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Factor", "[", "slackRS", "]"}]}], "Input",
 CellLabel->"In[79]:= ",
 CellID->1496122589,ExpressionUUID->"02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],

Cell[TextData[{
 "The slack is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       RowBox[{
        OverscriptBox[
         StyleBox["a", "TI"], "\[RightVector]"], "\[Times]", 
        OverscriptBox[
         StyleBox["b", "TI"], "\[RightVector]"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[GridBox[{
       {
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc1833e-1ead-5711-24fe-1b789b583a7b"],
 ": how far the two observables are from commuting, times how mixed the state \
is. It vanishes for a pure state or a commuting pair, and only then."
}], "Text",
 CellID->1956327387,ExpressionUUID->"3cb4236e-91b2-9328-644b-bb482044fe72"],

Cell[TextData[{
 "Ask ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631da35c-735e-7e3b-1122-3b0606eb4501"],
 " for any physical Bloch vector and any two observables that violate the \
relation, working on the expanded polynomial in all nine variables:"
}], "Text",
 CellID->1131177628,ExpressionUUID->"44b7daea-ed84-b50e-6c4c-d3b784361c54"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"slackRS", " ", "<", " ", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"r1", "^", "2"}], " ", "+", " ", 
      RowBox[{"r2", "^", "2"}], " ", "+", " ", 
      RowBox[{"r3", "^", "2"}]}], " ", "<=", " ", "1"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "r1", ",", " ", "r2", ",", " ", "r3", ",", " ", "a1", ",", " ", "a2", ",",
      " ", "a3", ",", " ", "b1", ",", " ", "b2", ",", " ", "b3"}], "}"}], ",",
    " ", "Reals"}], "]"}]], "Input",
 CellLabel->"In[80]:= ",
 CellID->611195905,ExpressionUUID->"39f2334d-24de-3dcb-6f81-ab174d688711"],

Cell[TextData[{
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ec600b7-0050-8550-46fd-99f1b1eaefba"],
 ": no violation exists anywhere in the nine-dimensional space. In other \
words, the relation is a theorem about the polynomial, decided by quantifier \
elimination, not a sampled observation."
}], "Text",
 CellID->1202919897,ExpressionUUID->"33bfe66e-cd59-d601-6144-f84be4edbd6b"],

Cell[TextData[{
 "Cross-check that every pure state (",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a3ee8c1-8740-e1ad-1bc5-01ab32fab3f7"],
 ") saturates the relation:"
}], "Text",
 CellID->1334651244,ExpressionUUID->"33885b0f-111a-0c54-6188-5369a0af56be"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"slackRS", " ", "/.", " ", 
   RowBox[{"r3", " ", "->", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"r1", "^", "2"}], " ", "-", " ", 
      RowBox[{"r2", "^", "2"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[81]:= ",
 CellID->185339758,ExpressionUUID->"5c9080a8-67dd-9047-04af-19f21269e2ad"],

Cell["\<\
Discriminating Two Qubit States: Reduce Finds the Helstrom Bound Over Every \
Measurement\
\>", "Section",
 CellID->1677030473,ExpressionUUID->"2abc9d06-0494-496b-5a43-1560ad211bb1"],

Cell[TextData[{
 "One of two known states arrives, ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e301a0-76bb-1057-7190-980a034e62bd"],
 " with prior ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ae06f2b-7109-3ba5-4a9f-877500bd898f"],
 " or ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0856a555-3f58-6085-386d-3d1fbaed32ef"],
 " with prior ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71eecbe3-9be0-9ba6-2795-e2cd1d9ae98c"],
 ", and one measurement must say which. The measurement is a pair of effects ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "1"], "+", 
   SubscriptBox[
    StyleBox["E", "TI"], "2"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59070895-187c-42ea-0f3c-a1df99091030"],
 ", ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   SubscriptBox[
    StyleBox["E", "TI"], "2"], "\[LessEqual]", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "189fe470-6cd8-7cf4-48a4-fe3a056d46de"],
 ", and the error is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["err",
     FontSlant->"Plain"]], "=", 
   StyleBox["p", "TI"], "\[ThinSpace]", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "1"], 
    SubscriptBox[
     StyleBox["E", "TI"], "2"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Rho]", "TI"], "2"], 
    SubscriptBox[
     StyleBox["E", "TI"], "1"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"\[CapitalLambda]", 
    SubscriptBox[
     StyleBox["E", "TI"], "2"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04ed2843-d86c-272a-2c92-c22cd91e8a70"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CapitalLambda]", "=", 
   StyleBox["p", "TI"], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], "-", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d9e217-b7c7-416b-20e6-0450c27213b1"],
 ". What is the smallest error over all measurements? A numerical approach \
solves a semidefinite program for one pair of states. Here the minimum over \
every effect is derived, with the spectrum of ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29221b72-bc55-8ef4-58d1-933c35e1d4de"],
 " left symbolic."
}], "Text",
 CellID->134345938,ExpressionUUID->"41172bde-c012-830e-772c-c29bf1a4ee54"],

Cell[TextData[{
 "The set of effects does not change under a unitary, so work in the \
eigenbasis of ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3dd84232-0c35-660d-6bf8-647ca5c04d57"],
 ", ",
 Cell[BoxData[
  RowBox[{"\[CapitalLambda]", "=", 
   StyleBox["diag",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["l", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["l", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5558c8fc-3d33-9e90-0367-e1a6b4c7e4fa"],
 ", and take the most general effect ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "2"], "=", "(", GridBox[{
     {
      StyleBox["a", "TI"], 
      RowBox[{
       StyleBox["b", "TI"], "+", 
       StyleBox["i", "TI"], 
       StyleBox["c", "TI"]}]},
     {
      RowBox[{
       StyleBox["b", "TI"], "-", 
       StyleBox["i", "TI"], 
       StyleBox["c", "TI"]}], 
      StyleBox["e", "TI"]}
    }], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53291d47-a111-bd44-02d6-9520d0a507ae"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "2"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14460f59-6b0f-818e-3c7d-a7030ebbd3d4"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["I", "TI"], "-", 
   SubscriptBox[
    StyleBox["E", "TI"], "2"], "\[GreaterEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afe19ed-5a5e-331e-1a85-90b75fe89e64"],
 ". Ask for every ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "142f588d-e120-bc70-3dd5-51d690da075a"],
 " that bounds ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"\[CapitalLambda]", 
    SubscriptBox[
     StyleBox["E", "TI"], "2"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "029948d8-232c-2201-32a7-618256d9716b"],
 " from below for all such effects:"
}], "Text",
 CellID->350820043,ExpressionUUID->"4b1b5b6f-b43d-594b-7939-53493dc82b91"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{"ForAll", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b", ",", " ", "c", ",", " ", "e"}], "}"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"0", " ", "<=", " ", "a", " ", "<=", " ", "1"}], " ", "&&", " ", 
      RowBox[{"0", " ", "<=", " ", "e", " ", "<=", " ", "1"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"a", " ", "e"}], " ", ">=", " ", 
       RowBox[{
        RowBox[{"b", "^", "2"}], " ", "+", " ", 
        RowBox[{"c", "^", "2"}]}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", "a"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", "e"}], ")"}]}], " ", ">=", " ", 
       RowBox[{
        RowBox[{"b", "^", "2"}], " ", "+", " ", 
        RowBox[{"c", "^", "2"}]}]}]}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"l1", ",", " ", "l2"}], "}"}], "]"}], " ", ".", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", " ", 
            RowBox[{"b", " ", "+", " ", 
             RowBox[{"I", " ", "c"}]}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"b", " ", "-", " ", 
             RowBox[{"I", " ", "c"}]}], ",", " ", "e"}], "}"}]}], "}"}]}], 
       "]"}], " ", ">=", " ", "k"}]}], "]"}], ",", " ", "k", ",", " ", 
   "Reals"}], "]"}]], "Input",
 CellLabel->"In[82]:= ",
 CellID->456450236,ExpressionUUID->"32f703b9-71e1-95eb-628c-9ae30795ff31"],

Cell[TextData[{
 "The best bound is the sum of the negative eigenvalues of ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c860bbc-8d1f-f590-34bd-a2e624abdffa"],
 ", reached by the projector onto its negative eigenspace. With ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], "\[CapitalLambda]", "=", "2", 
   StyleBox["p", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1bab88a0-6539-d521-49a8-210a0ccdbc0b"],
 " that sum is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["p", "TI"], "-", "1", "-", "\[DoubleVerticalBar]", 
    "\[CapitalLambda]", 
    SubscriptBox["\[DoubleVerticalBar]", "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74b37722-3fdc-1a4f-1c41-6e8cba696895"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["err",
     FontSlant->"Plain"]], "\[GreaterEqual]", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", "\[DoubleVerticalBar]", "\[CapitalLambda]", 
    SubscriptBox["\[DoubleVerticalBar]", "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31781dc2-1028-33d4-6707-94aca1c2813e"],
 " for every measurement, with equality for that projector: the Helstrom \
bound, derived rather than quoted. When both eigenvalues are positive the \
best effect is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], "2"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2148b02c-d62e-5336-5777-2989e3db3e1c"],
 ": always guess ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "183293a6-0d60-7813-49c1-0a00a4154b79"],
 ", because the prior outweighs anything a measurement could reveal (and \
symmetrically for two negative eigenvalues)."
}], "Text",
 CellID->1767337052,ExpressionUUID->"61e1f3c1-eae0-3799-179e-eaaa8e9a9de3"],

Cell[TextData[{
 "Cross-check against QuantumFramework at equal priors, ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bddc2d-650e-8031-5042-d6770cb8d31b"],
 " against a pure state ",
 Cell[BoxData[
  SuperscriptBox["60", "\[SmallCircle]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a437910-f355-55ba-2a71-715d86e03f80"],
 " away on the Bloch sphere: the minimum error ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49429438-4a3e-974e-7f71-0e626fc8fd94"],
 " plus the sum of the negative eigenvalues of ",
 Cell[BoxData["\[CapitalLambda]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07e2168c-1726-1a27-2d91-8fd6a2d3690d"],
 " should equal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["D", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3540c51c-f580-c338-637f-dd59fc3aae02"],
 ", with ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "684f0173-fe99-1571-1874-993cfb2c7c5b"],
 " the trace distance computed by ",
 Cell[BoxData["QuantumDistance"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],
 ":"
}], "Text",
 CellID->1422053341,ExpressionUUID->"607492e2-157b-ba0c-100b-0bcc9c0f0956"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"qa", " ", "=", " ", 
      RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}]}], ",", " ", 
     RowBox[{"qb", " ", "=", " ", 
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<BlochVector\>\"", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Pi]", "/", "3"}], "]"}], ",", " ", "0", ",", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Pi]", "/", "3"}], "]"}]}], "}"}], "]"}], "]"}]}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", "+", " ", 
      RowBox[{"Total", "[", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"qa", "[", "\"\<DensityMatrix\>\"", "]"}], " ", "-", 
              " ", 
              RowBox[{"qb", "[", "\"\<DensityMatrix\>\"", "]"}]}], ")"}], "/",
             "2"}], "]"}], "]"}], ",", " ", "Negative"}], "]"}], "]"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"QuantumDistance", "[", 
         RowBox[{"qa", ",", " ", "qb", ",", " ", "\"\<Trace\>\""}], "]"}]}], 
       ")"}], "/", "2"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[83]:= ",
 CellID->603286833,ExpressionUUID->"7781757c-388d-abb9-1dbf-6d26b939f983"],

Cell["\<\
A Continuously Measured Trapped Particle: Squeezing, Purity and the \
Efficiency Threshold in Closed Form\
\>", "Section",
 CellID->1349832744,ExpressionUUID->"566e7348-207a-dc95-7e16-6b12510ca6ff"],

Cell[TextData[{
 "Watch the position of a particle in a harmonic trap continuously, with \
measurement rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39672ae7-82f4-b353-6f1c-c3c1368601b9"],
 " and detector efficiency ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c48aba4-6f27-6a39-3477-420e0ad23903"],
 ". Does the conditional state become narrower in position than the ground \
state, and for which measurement strengths? A trajectory simulation answers \
this at one set of numbers. Here the trap and the detector stay symbols. \
Because the Hamiltonian is quadratic, a Gaussian conditional state stays \
Gaussian, and its three covariances ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f62374d-f3df-131c-5511-af16866a7e66"],
 ", ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "455ea632-3d4d-f0d3-7365-387cb4f9c239"],
 ", ",
 Cell[BoxData[
  SubscriptBox["\[CapitalSigma]", 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f0fb95c-030e-c889-4534-3106b6b89ad3"],
 " obey a deterministic Riccati equation; the detector efficiency scales the \
information gain by ",
 Cell[BoxData[
  StyleBox["\[Eta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16268eae-a572-7912-3fdd-270bcc074878"],
 " while the back-action keeps the full rate ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346a0e1a-2221-987e-5c69-a04457d5eb44"],
 "."
}], "Text",
 CellID->16034565,ExpressionUUID->"366be24c-537a-43bb-5e68-0416660f1181"],

Cell[TextData[{
 "Find the steady state of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalSigma]", "."], 
    StyleBox["x", "TI"]], "=", "2", 
   StyleBox["C", "TI"], "/", 
   StyleBox["m", "TI"], "-", "4", 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["\[Lambda]", "TI"], 
   SubsuperscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "501b1457-1a1d-907b-0038-8e119fa9e341"],
 ", ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["C", "TI"], "."], "=", 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["p", "TI"]], "/", 
   StyleBox["m", "TI"], "-", 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]], "-", "4", 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["\[Lambda]", "TI"], 
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]], 
   StyleBox["C", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "291c68e0-f532-6cdd-5f23-81cdfcc73627"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalSigma]", "."], 
    StyleBox["p", "TI"]], "=", "-", "2", 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   StyleBox["C", "TI"], "+", 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox["\[HBar]", "2"], "-", "4", 
   StyleBox["\[Eta]", "TI"], 
   StyleBox["\[Lambda]", "TI"], 
   SuperscriptBox[
    StyleBox["C", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c29c458-c353-7b98-05d6-de05f6e649e2"],
 ", keeping the one root that ",
 Cell[BoxData["Resolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1a2d6a-d2ad-c32a-1639-c537e759ae70"],
 " proves has ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["x", "TI"]], ",", 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     StyleBox["p", "TI"]], ">", "0"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb5612b-2266-f0f1-164b-79755710c2db"],
 " for every positive ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["\[Lambda]", "TI"], ",", 
   StyleBox["\[Omega]", "TI"], ",", "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4b4965-e043-b514-4549-614e91f71c7e"],
 " and ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf36e21-2d79-2b6f-0980-878b440c79b5"],
 ":"
}], "Text",
 CellID->344152329,ExpressionUUID->"6fe9f85b-1ce6-27f0-1596-f20594908dda"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"riccati\[Eta]", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"cxp", "/", "m"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", 
       RowBox[{"vx", "^", "2"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"vp", "/", "m"}], " ", "-", " ", 
      RowBox[{"m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "vx"}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", "vx", " ", "cxp"}]}],
      ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "m", " ", 
       RowBox[{"\[Omega]", "^", "2"}], " ", "cxp"}], " ", "+", " ", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"\[HBar]", "^", "2"}]}], " ", "-", " ", 
      RowBox[{"4", " ", "\[Eta]", " ", "\[Lambda]", " ", 
       RowBox[{"cxp", "^", "2"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vxS", ",", " ", "cxpS", ",", " ", "vpS"}], "}"}], " ", "=", " ", 
   
   RowBox[{"SelectFirst", "[", 
    RowBox[{
     RowBox[{"SolveValues", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"riccati\[Eta]", " ", "==", " ", "0"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"vx", ",", " ", "cxp", ",", " ", "vp"}], "}"}]}], "]"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"Resolve", "[", 
       RowBox[{
        RowBox[{"ForAll", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "m", ",", " ", "\[Lambda]", ",", " ", "\[Omega]", ",", " ", 
            "\[HBar]", ",", " ", "\[Eta]"}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}], ",",
           "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "|", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], ")"}], " ", "\[Element]", 
            " ", "Reals"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", ">", " ", "0"}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], " ", ">", " ", "0"}]}]}], "]"}], 
        ",", " ", "Reals"}], "]"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", "vxS"}], "Input",
 CellLabel->"In[84]:= ",
 CellID->622383932,ExpressionUUID->"3eadea9f-7d43-757d-6652-03d974f65c47"],

Cell[TextData[{
 "The purity of a Gaussian state is ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", "(", 
   RowBox[{"2", 
    SqrtBox[
     RowBox[{
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["x", "TI"]], 
      SubscriptBox["\[CapitalSigma]", 
       StyleBox["p", "TI"]], "-", 
      SuperscriptBox[
       StyleBox["C", "TI"], "2"]}]]}], ")"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68be2dd2-eea3-f2cb-1845-c49f8b57c011"],
 ":"
}], "Text",
 CellID->2102744249,ExpressionUUID->"1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"\[HBar]", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"vxS", " ", "vpS"}], " ", "-", " ", 
        RowBox[{"cxpS", "^", "2"}]}], "]"}]}], ")"}]}], ",", " ", 
   RowBox[{
    RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Lambda]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[85]:= ",
 CellID->565659401,ExpressionUUID->"6afb4307-9f81-9d1b-1a99-5b611a35e461"],

Cell[TextData[{
 "The purity is ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e902be9-4fb4-3e90-56af-c2b36a4684fa"],
 ", whatever the trap, the mass or the measurement rate. In other words, the \
light that escapes detection still kicks the particle, and the only trace it \
leaves on the steady state is this one number."
}], "Text",
 CellID->561487989,ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell[TextData[{
 "Write the steady position variance in units of the zero-point variance ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", "2", 
   StyleBox["m", "TI"], 
   StyleBox["\[Omega]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43090fa7-5002-8b65-7136-a60161b4d64f"],
 ", with the dimensionless strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "=", "2", "\[HBar]", 
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["m", "TI"], 
   SuperscriptBox[
    StyleBox["\[Omega]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],
 ":"
}], "Text",
 CellID->2021628840,ExpressionUUID->"4ac87485-b214-a6e0-7ac8-6deec7a60cca"],

Cell[BoxData[
 RowBox[{"ratio", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"vxS", "/", 
      RowBox[{"(", 
       RowBox[{"\[HBar]", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "m", " ", "\[Omega]"}], ")"}]}], ")"}]}], " ", "/.",
      " ", 
     RowBox[{"\[Lambda]", " ", "->", " ", 
      RowBox[{"\[Mu]", " ", "m", " ", 
       RowBox[{
        RowBox[{"\[Omega]", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "\[HBar]"}], ")"}]}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Mu]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Omega]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[HBar]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[86]:= ",
 CellID->41425461,ExpressionUUID->"56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],

Cell["\<\
Ask for every efficiency and strength at which the conditional state is \
narrower than the ground state:\
\>", "Text",
 CellID->1208764476,ExpressionUUID->"2e41722a-1026-02f0-567f-7474a1d350da"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ratio", " ", "<", " ", "1"}], " ", "&&", " ", 
    RowBox[{"\[Mu]", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Eta]", ",", " ", "\[Mu]"}], "}"}], ",", " ", "Reals"}], 
  "]"}]], "Input",
 CellLabel->"In[87]:= ",
 CellID->1584634344,ExpressionUUID->"6aacec8a-85e6-bbaa-1a53-05d4339009f0"],

Cell[TextData[{
 "A perfect detector squeezes the position below the zero-point at every \
strength ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c51a735-fee5-6802-446e-3f7efa903b68"],
 ", however gently it watches. An imperfect one does so only above the \
threshold ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Mu]", "TI"], "*"], "=", "2", 
   SqrtBox[
    RowBox[{"1", "-", 
     StyleBox["\[Eta]", "TI"]}]], "/", 
   SuperscriptBox[
    StyleBox["\[Eta]", "TI"], 
    RowBox[{"3", "/", "2"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e54a15d-ecde-9aa9-066b-39068568e8f3"],
 ", which falls to zero as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27fb6428-ecec-27d4-4d99-7e75849e8d3e"],
 " and diverges as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51f5ca74-88a2-9d2c-078a-ec3e2954e476"],
 ": as long as some light is caught, watching hard enough always beats the \
vacuum."
}], "Text",
 CellID->35679398,ExpressionUUID->"1154648e-ef0b-aa2b-476c-7deb8abff971"],

Cell[TextData[{
 "Cross-check the weak-measurement limit. As ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Mu]", "TI"], "\[Rule]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c057904-8649-af2b-743b-716e33fdf271"],
 " the information gain and the back-action heating vanish together, so the \
state should settle to a thermal state of purity ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],
 ", whose position variance is the zero-point variance divided by its \
purity:"
}], "Text",
 CellID->1113372800,ExpressionUUID->"340e6ec8-e38f-b030-5c35-8795963b031a"],

Cell[BoxData[
 RowBox[{"Asymptotic", "[", 
  RowBox[{"ratio", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Mu]", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"\[Mu]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "\[Eta]", " ", "<=", " ", "1"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[88]:= ",
 CellID->969867355,ExpressionUUID->"64bff79f-1679-3ebc-0c44-eed9a30d8486"],

Cell[TextData[{
 "The variance tends to ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    StyleBox["\[Eta]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "126dc52b-3dd5-bd31-4212-dd75b461041b"],
 " times the zero-point variance, as for a thermal state of purity ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["\[Eta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28023c0b-10a3-7000-5831-b655a156436a"],
 ", and at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f1b960d-0301-b7cd-7538-0857b6b51d17"],
 " the squeezing starts as ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["\[Mu]", "TI"], "2"], "/", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268b8fe7-2cf2-fa64-4e88-26c14484c94e"],
 "."
}], "Text",
 CellID->1210037699,ExpressionUUID->"41763b34-5a53-ec31-770d-b37e5fe7b71b"],

Cell["\<\
A Monitored Qubit Stays in the Bloch Ball: Ito's Lemma and One Reduce\
\>", "Section",
 CellID->1239892393,ExpressionUUID->"5d61c4f4-c0fb-847a-0b1e-ddb1f08fef40"],

Cell[TextData[{
 "A qubit (a transmon read out by homodyne detection of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72fe9a0c-0c49-239f-2285-1c56a5fc71e5"],
 ") follows a stochastic Bloch equation: relaxation ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14bcbead-0cb8-f132-3c43-37f7a532c018"],
 ", pure dephasing ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a015340-38cc-91ca-7a3f-4b2ab97ee310"],
 ", measurement dephasing ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox["d", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44807b7f-366d-41a7-6cb0-73394318138d"],
 ", a Rabi drive ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56b5d630-2397-dc8b-7e4a-c87a5623a6d1"],
 ", and a measurement record that kicks the state through an informative rate \
",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"C", "I"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "066e8396-42fa-b64f-2e15-1ad0768c1c95"],
 " and a phase back-action rate ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    RowBox[{"B", "A"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fee4e15-659c-ade9-3596-605f0c2ef733"],
 ". The state is physical only while ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", GridBox[{
     {
      OverscriptBox[
       StyleBox["r", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "\[LessEqual]", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f99faa1-7599-adaa-15a6-f30b7c2df7f0"],
 ". Does every trajectory stay in the ball, for every detector efficiency ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"C", "I"}], "TI"]], "+", 
    SubscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"B", "A"}], "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c80f068-193e-1d5a-14bf-ea3298cb67a0"],
 " and every choice of rates? A simulation checks one set of rates and a \
finite ensemble. Here Ito's lemma produces the equation for ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77601adb-bf25-4789-1d1f-93853ad02dd3"],
 ", and ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48b830c7-d270-6a57-7847-a9a0e70538bd"],
 " decides its sign on the sphere."
}], "Text",
 CellID->1498748757,ExpressionUUID->"62f1d7f5-6807-0c72-128e-cebf09b25758"],

Cell[TextData[{
 "Define the Ito process with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2af966-75ba-f15e-4629-f1407c4cc3a4"],
 " as its output; converting it to standard form applies Ito's lemma and adds \
",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcb302b-9e92-9019-25c8-aa751b24e363"],
 " as a fourth state with its own drift and noise:"
}], "Text",
 CellID->1701544389,ExpressionUUID->"361ba0ac-b25b-03c3-5e38-3909c7ee5129"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"blochSDE", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
             "\[Gamma]\[CurlyPhi]", " ", "+", " ", "\[CapitalGamma]d"}], 
            ")"}]}], " ", 
          RowBox[{"x", "[", "t", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
              "\[Gamma]\[CurlyPhi]", " ", "+", " ", "\[CapitalGamma]d"}], 
             ")"}]}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"z", "[", "t", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[Gamma]1", " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"z", "[", "t", "]"}]}], ")"}]}], " ", "+", " ", 
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"y", "[", "t", "]"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"x", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"y", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}]}], " ", 
            RowBox[{"y", "[", "t", "]"}], " ", 
            RowBox[{"z", "[", "t", "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"Sqrt", "[", "\[CapitalGamma]BA", "]"}], " ", 
            RowBox[{"x", "[", "t", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", "\[CapitalGamma]CI", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], ")"}]}], "}"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"z", "[", "t", "]"}], "^", "2"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "}"}], ",", 
     " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r2Drift", ",", " ", "r2Noise"}], "}"}], " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"std", " ", "=", " ", 
       RowBox[{"ItoProcess", "[", "blochSDE", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"std", "[", "\"\<Drift\>\"", "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"std", "[", "\"\<Diffusion\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"onSphere", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"zs", "^", "2"}]}], "]"}], " ", 
       RowBox[{"Cos", "[", "\[CurlyPhi]s", "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"y", "[", "t", "]"}], " ", "->", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"zs", "^", "2"}]}], "]"}], " ", 
       RowBox[{"Sin", "[", "\[CurlyPhi]s", "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"z", "[", "t", "]"}], " ", "->", " ", "zs"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"noiseOnSphere", ",", " ", "driftOnSphere"}], "}"}], " ", "=", " ", 
  RowBox[{"Factor", "[", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r2Noise", ",", " ", "r2Drift"}], "}"}], " ", "/.", " ", 
     "onSphere"}], "]"}], "]"}]}]}], "Input",
 CellLabel->"In[89]:= ",
 CellID->1682415361,ExpressionUUID->"36c5768f-9366-0c29-5efb-6fe926135773"],

Cell[TextData[{
 "The noise on ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["r", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcd6d4-594a-1482-7183-cf9e58ff7ee8"],
 " vanishes on the sphere, so a measurement kick only slides the state along \
it. The drift is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "[", 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "+", 
     StyleBox["z", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"C", "I"}], "TI"]], "+", 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"B", "A"}], "TI"]], "-", "2", 
     SubscriptBox["\[CapitalGamma]", 
      StyleBox["d", "TI"]], "-", "2", 
     SubscriptBox[
      StyleBox["\[Gamma]", "TI"], 
      StyleBox["\[Phi]", "TI"]]}], 
    StyleBox[")",
     SpanMaxSize->1], "-", 
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"1", "-", 
     StyleBox["z", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4719bc21-ede2-73f0-6d26-358a8b9741da"],
 ", with no dependence on the drive or the azimuth."
}], "Text",
 CellID->1697357464,ExpressionUUID->"71a147e0-ad25-39c0-275f-5ecdc4d18b2a"],

Cell[TextData[{
 "Ask whether any point of the sphere, any efficiency ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d94734f-f5fd-5b1e-3bac-6b2883882664"],
 " and any nonnegative rates make that drift point outward:"
}], "Text",
 CellID->1540797058,ExpressionUUID->"4a66d044-93ea-cfa5-7a1d-ca2e259c958f"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"driftOnSphere", " ", "/.", " ", 
       RowBox[{"\[CapitalGamma]BA", " ", "->", " ", 
        RowBox[{
         RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]d"}], " ", "-", " ",
          "\[CapitalGamma]CI"}]}]}], ")"}], " ", ">", " ", "0"}], " ", "&&", 
    " ", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "<=", " ", "zs", " ", "<=", " ", "1"}], " ", "&&",
     " ", 
    RowBox[{"0", " ", "<=", " ", "\[Eta]", " ", "<=", " ", "1"}], " ", "&&", 
    "\n", "   ", 
    RowBox[{"\[CapitalGamma]CI", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]d"}], " ", "-", " ", 
      "\[CapitalGamma]CI"}], " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[CapitalGamma]d", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]1", " ", ">=", " ", "0"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "zs", ",", " ", "\[Eta]", ",", " ", "\[CapitalGamma]CI", ",", " ", 
     "\[CapitalGamma]d", ",", " ", "\[Gamma]\[CurlyPhi]", ",", " ", 
     "\[Gamma]1"}], "}"}], ",", " ", "Reals"}], "]"}]], "Input",
 CellLabel->"In[90]:= ",
 CellID->768596373,ExpressionUUID->"08e3a6ae-198b-2f89-3890-3f08983e75d3"],

Cell[TextData[{
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ff9e3d-196e-b566-2d84-106798181c4c"],
 ". On the sphere the noise is tangent and the drift points inward or along \
it, so the exact flow never leaves the ball. In other words, positivity of \
the conditional density matrix is a property of the equation, not of a \
particular run."
}], "Text",
 CellID->1985169054,ExpressionUUID->"7611561e-6aa4-cbf1-1e2f-48580f5699db"],

Cell[TextData[{
 "Cross-check that the bound is sharp: drop ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d91ad73-9dce-768e-1bae-453d147b5cd4"],
 " and ask for which efficiencies some point of the sphere has an outward \
drift:"
}], "Text",
 CellID->770675313,ExpressionUUID->"6bff65fb-5d0a-196c-1985-7ca554bf6bb6"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Exists", "[", 
     RowBox[{"zs", ",", " ", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "<", " ", "zs", " ", "<", " ", "1"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"driftOnSphere", " ", "/.", " ", 
         RowBox[{"\[CapitalGamma]BA", " ", "->", " ", 
          RowBox[{
           RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]d"}], " ", "-", 
           " ", "\[CapitalGamma]CI"}]}]}], ")"}], " ", ">", " ", "0"}]}], 
     "]"}], " ", "&&", " ", 
    RowBox[{"\[CapitalGamma]d", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]\[CurlyPhi]", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[Gamma]1", " ", ">=", " ", "0"}]}], ",", " ", "\[Eta]", ",", 
   " ", "Reals"}], "]"}]], "Input",
 CellLabel->"In[91]:= ",
 CellID->846554368,ExpressionUUID->"5e58ca76-8595-5ac4-0667-ec302c20282e"],

Cell[TextData[{
 "An outward drift appears exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TI"], ">", "1", "+", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "/", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox["d", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a91809-3406-7705-3856-9253bdb35a6f"],
 ": the record would carry more information than the measurement dephasing \
pays for, and the equation no longer describes a density matrix."
}], "Text",
 CellID->1952818843,ExpressionUUID->"47ee4125-d524-d464-6d96-588edcd6bf4e"],

Cell["\<\
The Collapse Master Equation in Spherical Coordinates: Ito's Lemma Shows That \
Measurement Purifies\
\>", "Section",
 CellID->599175116,ExpressionUUID->"1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],

Cell[TextData[{
 "A qubit with Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 " is measured continuously along ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230fc3bf-d3e5-5aa5-5134-daf8e590288f"],
 " at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c6e076f-8b93-3c10-3415-9f492e27877a"],
 ". Its state obeys the Ito stochastic master equation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["\[Rho]", "TI"], "=", "(", 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["z", "TI"]], 
     StyleBox["\[Rho]", "TI"], 
     SubscriptBox[
      StyleBox["\[Sigma]", "TI"], 
      StyleBox["z", "TI"]], "-", 
     StyleBox["\[Rho]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], ")", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "+", 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], "(", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"], "+", 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], "-", "2", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["\[Rho]", "TI"]}], ")", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29094997-c9cb-f733-5f37-60d0e87fda19"],
 ". What does the length ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],
 " of the Bloch vector do along one run? Changing variables in an Ito \
equation is not the ordinary chain rule: Ito's lemma adds a term from the \
second derivatives and the noise. A trajectory solver such as QuTiP's ",
 Cell[BoxData["smesolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],
 " only samples runs. Here ",
 Cell[BoxData["ItoProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5640583a-c911-1fe8-7e70-5267e8a46532"],
 " holds the equation as an object, and its ",
 Cell[BoxData["\"\<Derivative\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6944803a-8297-e066-1f7b-1a643723b34c"],
 " property applies Ito's lemma to any function of the state."
}], "Text",
 CellID->1234886004,ExpressionUUID->"7e9e495e-a796-7cd0-26a6-611bd223463a"],

Cell[TextData[{
 "Write the master equation as an Ito process for the Bloch vector ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"], ",", 
    StyleBox["z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534f7e63-03c8-ee33-0175-704db662b519"],
 ", reading the drift and the noise off ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b07ad27-9e6a-154b-693c-44811b1f7f91"],
 ":"
}], "Text",
 CellID->1955603644,ExpressionUUID->"1c7a415c-3e53-b7cb-441a-5906bbe71d11"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]s", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "k", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"\[Rho]b", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", ".", " ", 
       "\[Sigma]s"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bl", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"m", " ", ".", " ", "s"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "\[Sigma]s"}], "}"}]}], "]"}], "]"}]}], ";", 
  " ", 
  RowBox[{"hx", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]", "/", "2"}], " ", 
    RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ";", " ", 
  RowBox[{"sz", " ", "=", " ", 
   RowBox[{"PauliMatrix", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{"sme", " ", "=", " ", 
  RowBox[{"ItoProcess", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"bl", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"hx", " ", ".", " ", "\[Rho]b"}], " ", "-", " ", 
           RowBox[{"\[Rho]b", " ", ".", " ", "hx"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sz", " ", ".", " ", "\[Rho]b", " ", ".", " ", "sz"}], " ",
            "-", " ", "\[Rho]b"}], ")"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"List", " ", "/@", " ", 
       RowBox[{"bl", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sz", " ", ".", " ", "\[Rho]b"}], " ", "+", " ", 
           RowBox[{"\[Rho]b", " ", ".", " ", "sz"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"sz", " ", ".", " ", "\[Rho]b"}], " ", "+", " ", 
              RowBox[{"\[Rho]b", " ", ".", " ", "sz"}]}], "]"}], " ", 
            "\[Rho]b"}]}], ")"}]}], "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "}"}], ",", 
    " ", "t"}], "]"}]}]}], "Input",
 CellLabel->"In[92]:= ",
 CellID->529524776,ExpressionUUID->"417aec05-2fbb-8238-7719-066f4a4fd102"],

Cell[TextData[{
 "The drift holds the measurement dephasing ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4705486f-1ac0-4964-6d3b-62499f75184e"],
 " of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3af5a034-7641-6879-6a8a-3a7e03f43b43"],
 " and ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68379bed-79e9-22be-19cc-12b77f9c7084"],
 " and the rotation by ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],
 " about ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "258251be-7c16-7495-53b2-48f875a35eff"],
 ". The noise vanishes at the poles ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c1f832-722b-ca69-63fe-f27c07df98b3"],
 ", the eigenstates of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6a50da-eb07-3910-296a-49878eb3887a"],
 "."
}], "Text",
 CellID->186212144,ExpressionUUID->"23591dbb-79d4-ec10-5166-94e57866b77a"],

Cell[TextData[{
 "Apply Ito's lemma to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["x", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["y", "TI"], "2"], "+", 
     SuperscriptBox[
      StyleBox["z", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114fd905-c79d-9420-4774-d16ef229ff0a"],
 " and write the result in spherical coordinates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["r", "TI"], ",", 
    StyleBox["\[Theta]", "TI"], ",", "\[CurlyPhi]"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0047a90f-9cb0-808d-307c-4169154ad2d7"],
 ":"
}], "Text",
 CellID->284725946,ExpressionUUID->"42e32fd7-26e6-6b71-7290-c6915293365b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"toSph", " ", "=", " ", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", " ", 
       RowBox[{"y", "[", "t", "]"}], ",", " ", 
       RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", "->", " ", 
     RowBox[{"r", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], ",", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"dr", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"sme", "[", 
      RowBox[{"\"\<Derivative\>\"", ",", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"y", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"z", "[", "t", "]"}], "^", "2"}]}], "]"}]}], "]"}], " ", "/.",
      " ", "toSph"}], ",", " ", 
    RowBox[{
     RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "\[Pi]"}], " ", "&&",
      " ", 
     RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]}]}], "Input",
 CellLabel->"In[93]:= ",
 CellID->1006536905,ExpressionUUID->"4a2652ed-88d4-efb2-7bde-4bb72966b598"],

Cell[TextData[{
 "Both the drift and the noise of ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0962d9db-7466-8598-3f11-d0857d10efe2"],
 " carry the factor ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b3d557b-19e1-b503-0ac3-4d259f951c69"],
 ". At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "529c5c95-0588-d8f1-02a4-55dfac22aadb"],
 " both vanish, so a pure state stays pure on every run; for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18bedc4a-f6ca-97e0-4845-d617837cfdca"],
 " the drift ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "/", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f18273e-5cf5-00f5-0527-bf78548052df"],
 " is positive, so a mixed state purifies. The Hamiltonian drops out, since a \
rotation does not change the length. In other words, the purification is the \
Ito term at work: the ordinary chain rule alone gives ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["r", "TI"], 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1890d11b-851d-d227-48af-c9452ca9a10d"],
 ", the shrinking of the averaged Lindblad state, and the second-derivative \
term of the noise reverses its sign."
}], "Text",
 CellID->207506748,ExpressionUUID->"5b8be800-baff-aedd-0988-026a3e8bf427"],

Cell[TextData[{
 "Check against Ito's product rule, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "2", 
   StyleBox["r", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["r", "TI"], "+", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"d", "r"}], "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "224fae0e-4768-b263-5274-406872020149"],
 ", applied to the drift and noise of ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d32ba1d-71ed-60b8-64c1-3c4707983282"],
 " just found:"
}], "Text",
 CellID->1146295856,ExpressionUUID->"3ccd4f42-4869-4b08-64f3-672c691c1652"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"sme", "[", 
        RowBox[{"\"\<Derivative\>\"", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"z", "[", "t", "]"}], "^", "2"}]}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "/.", " ", "toSph"}],
      ")"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"2", " ", "r", " ", 
      RowBox[{"dr", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"dr", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], "^", 
      "2"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "\[Theta]", " ", "<", " ", "\[Pi]"}], " ", "&&",
     " ", 
    RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[94]:= ",
 CellID->438365529,ExpressionUUID->"0cf63df4-f608-7ba6-348d-b4b183bd498c"],

Cell[TextData[{
 "Get all three spherical equations from the same call, then sample one run \
that starts mixed at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", "0.5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60948258-d69f-7f2c-10ab-2405e32a4276"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Gamma]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf5c13c-8c81-f0bf-098a-d9662535c285"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", "0.3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27ebc314-3813-af61-4de8-db5eb9a7f24b"],
 ", and plot ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cd495b-92f8-de82-0ff3-61052772a4e8"],
 ":"
}], "Text",
 CellID->174000849,ExpressionUUID->"1597811c-d04f-58d0-43ac-1959e1fa2a3a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sph", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sme", "[", 
       RowBox[{"\"\<Derivative\>\"", ",", " ", 
        RowBox[{"ToSphericalCoordinates", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], ",", " ", 
           RowBox[{"y", "[", "t", "]"}], ",", " ", 
           RowBox[{"z", "[", "t", "]"}]}], "}"}], "]"}]}], "]"}], " ", "/.", 
      " ", "toSph"}], ",", " ", 
     RowBox[{
      RowBox[{"r", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", ">", " ", "0"}], " ", "&&",
       " ", 
      RowBox[{"\[Gamma]", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"RandomFunction", "[", 
     RowBox[{
      RowBox[{"ItoProcess", "[", 
       RowBox[{
        RowBox[{"sph", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Omega]", " ", "->", " ", "0.3"}], ",", " ", 
           RowBox[{"\[Gamma]", " ", "->", " ", "1"}]}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "\[Theta]", ",", " ", "\[CurlyPhi]"}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.5", ",", " ", 
            RowBox[{"\[Pi]", "/", "3"}], ",", " ", "0"}], "}"}]}], "}"}], ",",
         " ", "t"}], "]"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "4", ",", " ", "0.001"}], "}"}]}], "]"}], "[", 
    RowBox[{"\"\<PathComponent\>\"", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Gamma] t\>\"", ",", " ", "\"\<r\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[95]:= ",
 CellID->766726627,ExpressionUUID->"0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"],

Cell[TextData[{
 "The radius climbs to the surface of the Bloch ball within a few ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e10fbdd-fcac-b923-462f-f286f55e0809"],
 " and stays there, while the angles keep moving under the drive and the \
record."
}], "Text",
 CellID->1506609767,ExpressionUUID->"68c26b95-e958-d351-18f1-82de88d2a1bb"],

Cell["\<\
A Hamiltonian with White Noise: Converting Stratonovich to Ito Produces the \
Dephasing Drift\
\>", "Section",
 CellID->281363281,ExpressionUUID->"56b7d10b-4c3b-5ee0-7e4c-c95565ce24ca"],

Cell[TextData[{
 "A qubit has the random Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   FractionBox[
    StyleBox["\[Omega]", "TI"], "2"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]], "+", 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], "\[ThinSpace]", 
   StyleBox["\[Xi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ed67f4-ffa0-5cce-7093-7eb1fa552614"],
 ", with ",
 Cell[BoxData[
  StyleBox["\[Xi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dc0df98-8a2c-0889-7bff-d6c22fd95ad3"],
 " white noise. Because white noise is the limit of smooth noise, the \
equation of motion is a Stratonovich equation, and each run is unitary. The \
average over runs, however, is read off the Ito form, whose drift contains an \
extra term ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "\[CenterDot]", "\[Del]"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["b", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2226f602-e60c-c55a-53dd-e86f93beafa0"],
 " from the noise ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ed808ee-885a-0ea1-76e7-a1c829ef548b"],
 ". Here the conversion is done on the symbolic equation."
}], "Text",
 CellID->1615544595,ExpressionUUID->"1627cdbb-2852-50d0-3fdc-e4e549e7223a"],

Cell[TextData[{
 "Write the noise-free drift ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], "0"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801141d-c5dc-e96b-183e-8e46ec6ebbb1"],
 " and the Stratonovich noise ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   SqrtBox[
    StyleBox["\[Gamma]", "TI"]], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fb5e010-3b47-28f4-554a-fa5abef27ade"],
 " in Bloch coordinates:"
}], "Text",
 CellID->1805673747,ExpressionUUID->"69461d9a-9714-a717-1f7d-94c422a60a7d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pauli", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "k", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"blochOf", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"m", " ", ".", " ", "s"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "pauli"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]v", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], " ", ".", " ", 
       "pauli"}]}], ")"}], "/", "2"}]}], ";", " ", 
  RowBox[{"ham", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]", "/", "2"}], " ", 
    RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"drift0", ",", " ", "noiseB"}], "}"}], " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"blochOf", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ham", " ", ".", " ", "\[Rho]v"}], " ", "-", " ", 
        RowBox[{"\[Rho]v", " ", ".", " ", "ham"}]}], ")"}]}], "]"}], ",", " ", 
    RowBox[{"blochOf", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"Sqrt", "[", "\[Gamma]", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "\[Rho]v"}], 
        " ", "-", " ", 
        RowBox[{"\[Rho]v", " ", ".", " ", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}]}], "]"}]}], 
   "}"}]}]}], "Input",
 CellLabel->"In[96]:= ",
 CellID->1547520620,ExpressionUUID->"1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"],

Cell[TextData[{
 "The drift has no ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17254721-59fc-dba5-3edb-5e8b5f8ea98f"],
 " in it, and the noise only rotates the Bloch vector about ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],
 ", so each run keeps its length."
}], "Text",
 CellID->858350929,ExpressionUUID->"133f88c9-4e43-c7a8-42c4-21936bf7adf2"],

Cell["\<\
Convert the Stratonovich process to Ito form and read its drift:\
\>", "Text",
 CellID->2138894257,ExpressionUUID->"525bf512-066b-f79b-0278-ed5cb31fdde1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ito", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{"StratonovichProcess", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"drift0", ",", " ", 
        RowBox[{"List", " ", "/@", " ", "noiseB"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x0", ",", " ", "y0", ",", " ", "z0"}], "}"}]}], "}"}], ",", 
      " ", "t"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ito", "[", "\"\<Drift\>\"", "]"}]}], "Input",
 CellLabel->"In[97]:= ",
 CellID->1941039383,ExpressionUUID->"7020b0a8-e1ec-de26-21df-29f5979ea50c"],

Cell[TextData[{
 "The conversion adds ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["x", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4e56ea-c348-0e14-1576-4fb7f6fd557e"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["y", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c7820da-3afe-8c15-5407-b984be88d77f"],
 ": dephasing at rate ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "491026a6-dd30-329c-7f2f-bf03d4ca80e6"],
 " in the plane perpendicular to the noise axis. In other words, every single \
run is a pure rotation, yet the runs rotate by different random angles about ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"],
 ", and the Ito drift records how their average shrinks."
}], "Text",
 CellID->1670620029,ExpressionUUID->"295a1104-8f0a-9295-5f79-896e2abce0ff"],

Cell[TextData[{
 "Check that this drift is the Bloch form of the Lindblad equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["H", "TI"], "0"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e49fcf-314b-942d-5c9b-16a940ffff77"],
 ":"
}], "Text",
 CellID->588214459,ExpressionUUID->"28081ee1-9923-6846-5837-97cb18d63aac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"blochOf", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ham", " ", ".", " ", "\[Rho]v"}], " ", "-", " ", 
       RowBox[{"\[Rho]v", " ", ".", " ", "ham"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"\[Gamma]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", "\[Rho]v", " ",
         ".", " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "-", " ", "\[Rho]v"}], 
      ")"}]}]}], "]"}], " ", "==", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"ito", "[", "\"\<Drift\>\"", "]"}], " ", "/.", " ", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", " ", 
        RowBox[{"y", "[", "t", "]"}], ",", " ", 
        RowBox[{"z", "[", "t", "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], 
   ")"}]}]], "Input",
 CellLabel->"In[98]:= ",
 CellID->1759496502,ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"],

Cell["\<\
A Laser with a Diffusing Phase: the Exact Mean Field and the Non-Stationary \
Two-Time Correlation\
\>", "Section",
 CellID->1641757231,ExpressionUUID->"4f8fdcfc-c987-8804-75b4-d5b9e833db6e"],

Cell[TextData[{
 "The field of a laser is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "+", 
    SubscriptBox[
     StyleBox["\[Phi]", "TI"], 
     StyleBox["t", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bb02784-750c-cc73-794f-beee7cbe9759"],
 ", and its phase diffuses, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["\[Phi]", "TI"], "=", 
   SqrtBox[
    RowBox[{"2", 
     StyleBox["\[Kappa]", "TI"]}]], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6368bf1a-89ab-f709-1117-3744285fda53"],
 ". What are the average field and the correlation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["t", "TI"], "+", 
     StyleBox["\[Tau]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18aa8291-c565-6e81-48a9-1bdaec1034eb"],
 "? Averaging sampled traces gives these up to sampling error at chosen ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fb37437-3ad9-e813-3541-6e71bf6dbb79"],
 ". Here the field is a ",
 Cell[BoxData["TransformedProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c235d7-86a4-1a63-5ff1-ac9133516949"],
 " of a Wiener process, and its moments come out exactly with ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c4bd199-468e-1df0-2448-c8c3733b67da"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5faac466-18c1-c293-05a9-de40997590f9"],
 ", ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b2a52a2-44e1-aebb-392a-4b0c6c95f481"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146756d1-ea39-ec02-3c1d-4f9a8fcdb768"],
 " as symbols."
}], "Text",
 CellID->896279625,ExpressionUUID->"1a7ee52b-d767-0389-4a05-fd74e21251d3"],

Cell[TextData[{
 "Build the field process and take its mean, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419fd7e1-c297-cbe2-77a4-cecaf72399c8"],
 ":"
}], "Text",
 CellID->1264190945,ExpressionUUID->"7a33ac2f-4fb5-380e-2bc0-45896a418b54"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"field", " ", "=", " ", 
   RowBox[{"TransformedProcess", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"\[Omega]", " ", "t"}], " ", "+", " ", 
       RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], ",", " ", 
     RowBox[{"\[Phi]", " ", "\[Distributed]", " ", 
      RowBox[{"WienerProcess", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "\[Kappa]"}], "]"}]}], "]"}]}], ",", " ", "t"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Mean", "[", 
  RowBox[{"field", "[", "t", "]"}], "]"}]}], "Input",
 CellLabel->"In[99]:= ",
 CellID->1806910998,ExpressionUUID->"3b56b9eb-04f6-5b17-696d-30b5ac83267d"],

Cell[TextData[{
 "The mean field oscillates at ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],
 " and decays as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Kappa]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db41629-8d3d-b9f9-2b4b-887324c90bc3"],
 ", although no trace ever loses amplitude. The decay is pure dephasing among \
runs: their phases spread with variance ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Kappa]", "TI"], 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f51d24b-32fb-3155-656e-d415468f83bf"],
 " and the average cancels."
}], "Text",
 CellID->962064851,ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell[TextData[{
 "Compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    StyleBox["E", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["t", "TI"], "+", 
     StyleBox["\[Tau]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aa19f46-928a-afd4-3a5e-1720273cf53e"],
 " for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31860dcc-84f8-941b-67bd-a4962d72ff61"],
 " as the covariance function plus the product of the means:"
}], "Text",
 CellID->1660212291,ExpressionUUID->"08371d00-4cf7-24ac-39cc-956a64838ef6"],

Cell[BoxData[
 RowBox[{"twoTime", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{"CovarianceFunction", "[", 
       RowBox[{"field", ",", " ", "t", ",", " ", 
        RowBox[{"t", " ", "+", " ", "\[Tau]"}]}], "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"field", "[", "t", "]"}], "]"}], " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"field", "[", 
         RowBox[{"t", " ", "+", " ", "\[Tau]"}], "]"}], "]"}]}]}], "]"}], ",",
     " ", 
    RowBox[{
     RowBox[{"t", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Tau]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[100]:= ",
 CellID->1553450743,ExpressionUUID->"6e555e8f-0ad0-492d-166b-57e9af651877"],

Cell[TextData[{
 "The correlation is ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], 
     StyleBox["\[Tau]", "TI"]}]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["\[Tau]", "TI"], "+", 
   FractionBox["1", "2"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["\[Kappa]", "TI"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"4", 
      StyleBox["t", "TI"], "+", 
      StyleBox["\[Tau]", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["t", "TI"], "+", 
    StyleBox["\[Tau]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],
 ". The first term depends only on the lag. The second depends on ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c065349-950a-8738-043e-4b131cbcea02"],
 " itself, because every run starts from the same phase: it carries the sum \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], 
    StyleBox["t", "TI"]], "+", 
   SubscriptBox[
    StyleBox["\[Phi]", "TI"], 
    RowBox[{
     StyleBox["t", "TI"], "+", 
     StyleBox["\[Tau]", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ff276a9-5e86-52e3-7582-6ff35b3320c9"],
 ", whose variance ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["\[Kappa]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"4", 
    StyleBox["t", "TI"], "+", 
    StyleBox["\[Tau]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b6e2ad-c501-b7fc-4c4d-fbf6ecb51dc6"],
 " grows with ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230cad6b-7900-e120-5133-453578bab00a"],
 ". In other words, the field is not stationary until it has forgotten its \
initial phase, on the time scale ",
 Cell[BoxData[
  RowBox[{"1", "/", "4", 
   StyleBox["\[Kappa]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "086f7f71-a7b7-bd3e-3815-773ad2430404"],
 "."
}], "Text",
 CellID->376345483,ExpressionUUID->"0cdf8892-1d3f-31f6-34e4-21dc94cb83dc"],

Cell["Check that at long times only the stationary term survives:", "Text",
 CellID->1917523023,ExpressionUUID->"7e0217c2-6a7a-d359-2631-8eac0f0ca1a3"],

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{"twoTime", ",", " ", 
   RowBox[{"t", " ", "->", " ", "\[Infinity]"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{
     RowBox[{"\[Kappa]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Tau]", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[101]:= ",
 CellID->225924774,ExpressionUUID->"4104c6da-03d7-a765-773b-df84b6630a4f"],

Cell["\<\
Gaussian Kraus Operators of a Weak Measurement: the Commutator of Two Kicks \
and an Exact Purity Law\
\>", "Section",
 CellID->1508526016,ExpressionUUID->"731f4b84-5335-8b87-2125-62ee66c1d9ed"],

Cell[TextData[{
 "A detector that reads a Pauli observable ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315717aa-70ab-e706-676c-8ef4015fca6c"],
 " over a short window, with noise variance ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c1b1617-f81f-7a45-2438-8850f9aa48af"],
 ", returns a reading ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["I", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70b05f1a-470c-9c9d-2040-574472bee6e7"],
 " and updates the state by the Kraus operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["I", "TI"], "_"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{
     OverscriptBox[
      StyleBox["I", "TI"], "_"], 
     StyleBox["A", "TI"], "/", "2", 
     StyleBox["D", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a8c5b06-7c6a-07f5-7ab4-5360751f6ddf"],
 ", followed by normalization (Korotkov's quantum Bayesian update). With two \
detectors on ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fa3f928-0446-c8dd-7550-f172adf09a27"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3727240c-f62b-7b8f-5edc-be6983de49d5"],
 ", does the order of the two updates matter, and what happens to the purity? \
A trajectory simulation answers one reading at a time. Here the readings stay \
symbols."
}], "Text",
 CellID->1653333794,ExpressionUUID->"50637aef-2122-41f7-0011-73c950d713dd"],

Cell[TextData[{
 "Compute the commutator of a ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63773809-2d44-01f7-110c-b25344f153dd"],
 " update with reading ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ede8b7e-b317-5b7c-26e5-233bc6a22646"],
 " and a ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75c8f24b-f46e-7672-23f7-f414fd1b5d58"],
 " update with reading ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d149507-d3df-875e-5b2b-0d60e66beda4"],
 ":"
}], "Text",
 CellID->2117504204,ExpressionUUID->"772d62ae-4bf9-dab0-1ed3-7b086d8da89a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kraus", "[", 
    RowBox[{"ib_", ",", " ", "A_"}], "]"}], " ", ":=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"ib", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "var"}], ")"}]}], " ", "A"}], "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"kraus", "[", 
      RowBox[{"a", ",", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}], " ", ".", " ", 
     RowBox[{"kraus", "[", 
      RowBox[{"b", ",", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"kraus", "[", 
      RowBox[{"b", ",", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}], " ", ".", " ", 
     RowBox[{"kraus", "[", 
      RowBox[{"a", ",", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}], " ", "\[Element]", " ", "Reals"}], 
    " ", "&&", " ", 
    RowBox[{"var", " ", ">", " ", "0"}]}]}], "]"}]}], "Input",
 CellLabel->"In[102]:= ",
 CellID->201091240,ExpressionUUID->"7a8c9a4d-0caa-515e-2ab3-1c17a55f23a4"],

Cell[TextData[{
 "The commutator is ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["i", "TI"], 
   StyleBox["sinh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "/", "2", 
    StyleBox["D", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["sinh",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["b", "TI"], "/", "2", 
    StyleBox["D", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a4c6a75-6554-e0e6-1a73-8c3f0ce6b2cc"],
 " for every pair of readings. It inherits ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], ",", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["x", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "2", 
   StyleBox["i", "TI"], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["y", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c3108e-8c9d-f317-5ff0-89e82529de7d"],
 " from the observables, and it is first order in each reading, so the two \
orders agree only as the window shrinks."
}], "Text",
 CellID->667003370,ExpressionUUID->"5b90d741-2df1-4c37-09af-cf2b4b84171d"],

Cell[TextData[{
 "Take one full step, a half ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a353f88-1ea4-a3d5-0bca-b6d29b56f13f"],
 " update on either side of an update along an axis at angle ",
 Cell[BoxData["\[CurlyTheta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c3a5085-d835-7232-65da-49eed9c04118"],
 " in the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f71b61d-3801-a1b0-550e-2847b9b5f39a"],
 "-plane, and compute its determinant:"
}], "Text",
 CellID->526043023,ExpressionUUID->"3c7c9f19-7bfc-9bea-6403-17437d8ee930"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mStep", " ", "=", " ", 
   RowBox[{
    RowBox[{"kraus", "[", 
     RowBox[{
      RowBox[{"a", "/", "2"}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}], " ", ".", " ", 
    RowBox[{"kraus", "[", 
     RowBox[{"b", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Cos", "[", "\[CurlyTheta]", "]"}], " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Sin", "[", "\[CurlyTheta]", "]"}], " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}]}]}], "]"}], " ", ".", " ", 
    RowBox[{"kraus", "[", 
     RowBox[{
      RowBox[{"a", "/", "2"}], ",", " ", 
      RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Det", "[", "mStep", "]"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b", ",", " ", "\[CurlyTheta]"}], "}"}], " ", "\[Element]",
      " ", "Reals"}], " ", "&&", " ", 
    RowBox[{"var", " ", ">", " ", "0"}]}]}], "]"}]}], "Input",
 CellLabel->"In[103]:= ",
 CellID->1120596176,ExpressionUUID->"4bcd3c0f-0044-41be-79f2-b669b1f11384"],

Cell[TextData[{
 "Each factor is the exponential of a traceless matrix, so the step is \
unimodular for every reading and every angle. Since the determinant is \
multiplicative and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["det",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Rho]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250574e2-7568-dee6-533b-6dcc7c02a4cc"],
 ", the normalized update gives ",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["r", "TI"], 
    RowBox[{"\[Prime]", "2"}]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["Tr",
       FontSlant->"Plain"], "\[ThinSpace]", 
      StyleBox["M", "TI"], 
      StyleBox["\[Rho]", "TI"], 
      StyleBox["M", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "570dea5b-028b-2dc3-7d32-0c05b73e7729"],
 " exactly. In other words, a pure state stays pure (as it must under any \
single Kraus operator), and for a mixed state each step divides the mixedness \
",
 Cell[BoxData[
  RowBox[{"1", "-", 
   SuperscriptBox[
    StyleBox["r", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "559114f0-95cd-3728-03ae-8dba1c799a72"],
 " by the square of the weight ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["M", "TI"], 
   StyleBox["\[Rho]", "TI"], 
   StyleBox["M", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499d2cc9-9173-f7c8-7fa2-c5932007dd12"],
 " of the reading, whatever the readings and the axis."
}], "Text",
 CellID->64105026,ExpressionUUID->"1b3687b6-15a3-de20-4acd-1ef09c57a50a"],

Cell[TextData[{
 "Check that the readings form a POVM: weighted by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["w", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["I", "TI"], "_"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "\|01d4a9", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    StyleBox["D", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", "1", "/", "2", 
     StyleBox["D", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073f26db-34e5-c8c2-2ec4-bf85bc919a28"],
 ", the operators ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     OverscriptBox[
      StyleBox["I", "TI"], "_"], 
     StyleBox[")",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27056d96-6b3e-545a-4d3a-84d00ecb3ea0"],
 " integrate to the identity:"
}], "Text",
 CellID->1373525465,ExpressionUUID->"031df9cf-6b45-d275-3122-f0a90ef1a15f"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"Sqrt", "[", "var", "]"}]}], "]"}], ",", " ", "ib"}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "1"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "var"}], ")"}]}], "]"}], " ", 
    RowBox[{
     RowBox[{"kraus", "[", 
      RowBox[{"ib", ",", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}], " ", ".", " ", 
     RowBox[{"kraus", "[", 
      RowBox[{"ib", ",", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ib", ",", " ", 
     RowBox[{"-", "\[Infinity]"}], ",", " ", "\[Infinity]"}], "}"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"var", " ", ">", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[104]:= ",
 CellID->1964307623,ExpressionUUID->"79902eb9-9fc4-d4aa-2faf-c7e31a76bef0"],

Cell["\<\
The Quantum Kalman-Bucy Filter as an ItoProcess: Purity Is a Noiseless \
Attractor\
\>", "Section",
 CellID->39040159,ExpressionUUID->"6e90dac8-e749-9c1a-16af-d39592fde760"],

Cell[TextData[{
 "A free particle of mass ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f026f1c-d8c2-1814-5531-8759d9776b7e"],
 " is watched continuously in position at strength ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c65fa9b-46f3-ebf0-041a-f3c57287b9da"],
 ". A Gaussian conditional state stays Gaussian, so five numbers describe it: \
the means ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["x", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["p", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583cd303-9cb1-03ae-09c3-cb6d154451f4"],
 " and the covariances ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]], ",", 
   StyleBox["C", "TI"], ",", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18f1bad1-a8d9-f26a-488e-339ac96dc0b0"],
 ". Only the means feel the noise; the covariances follow a Riccati equation \
(the quantum Kalman-Bucy filter). The purity of a Gaussian state is ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    SqrtBox[
     RowBox[{
      SubscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["x", "TI"]], 
      SubscriptBox[
       StyleBox["V", "TI"], 
       StyleBox["p", "TI"]], "-", 
      SuperscriptBox[
       StyleBox["C", "TI"], "2"]}]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cd8e50a-7117-62ea-14e7-fd5400a23030"],
 ". Does a run keep it? A general-purpose integrator of the wavefunction \
equation drifts in norm and must renormalize at every step. Here the filter \
is an ",
 Cell[BoxData["ItoProcess"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9c4f1f-9707-8ca1-29a4-675922b3d68b"],
 ", and Ito's lemma answers for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["p", "TI"]], "-", 
   SuperscriptBox[
    StyleBox["C", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0839f778-d15e-09ff-39c6-ef25e0eb5bc5"],
 " with every parameter symbolic."
}], "Text",
 CellID->1242473813,ExpressionUUID->"7962e333-0c57-77b8-2f11-fb7da5e25d82"],

Cell[TextData[{
 "Define the filter and apply Ito's lemma to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], "=", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["p", "TI"]], "-", 
   SuperscriptBox[
    StyleBox["C", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],
 ":"
}], "Text",
 CellID->290269587,ExpressionUUID->"7517e465-645e-477c-232c-fe4f0deb2a46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kb", " ", "=", " ", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mp", "/", "mass"}], ",", " ", "0", ",", " ", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"cv", "/", "mass"}]}], " ", "-", " ", 
          RowBox[{"4", " ", "\[Lambda]", " ", 
           RowBox[{"vx", "^", "2"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"vp", "/", "mass"}], " ", "-", " ", 
          RowBox[{"4", " ", "\[Lambda]", " ", "vx", " ", "cv"}]}], ",", " ", 
         RowBox[{
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"\[HBar]", "^", "2"}]}], " ", "-", " ", 
          RowBox[{"4", " ", "\[Lambda]", " ", 
           RowBox[{"cv", "^", "2"}]}]}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "\[Lambda]", "]"}], " ", "vx"}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "\[Lambda]", "]"}], " ", "cv"}], "}"}], ",", 
         " ", 
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{"{", "0", "}"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "mx", ",", " ", "mp", ",", " ", "vx", ",", " ", "cv", ",", " ", 
         "vp"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", " ", "0", ",", " ", "vx0", ",", " ", "0", ",", " ", "vp0"}],
         "}"}]}], "}"}], ",", " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Factor", "[", 
  RowBox[{"kb", "[", 
   RowBox[{"\"\<Derivative\>\"", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"vx", "[", "t", "]"}], " ", 
      RowBox[{"vp", "[", "t", "]"}]}], " ", "-", " ", 
     RowBox[{
      RowBox[{"cv", "[", "t", "]"}], "^", "2"}]}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[105]:= ",
 CellID->471335900,ExpressionUUID->"560e68d9-da1a-2272-7e35-8182dfaf7158"],

Cell[TextData[{
 "The noise term of ",
 Cell[BoxData[
  StyleBox["P", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46aa8ea3-37c3-4040-6ea9-270d427612aa"],
 " is zero and its drift is ",
 Cell[BoxData[
  RowBox[{"-", "4", 
   StyleBox["\[Lambda]", "TI"], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["P", "TI"], "-", 
    SuperscriptBox["\[HBar]", "2"], "/", "4"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6acb7fb5-f6da-6094-1ac9-76fe836f32fe"],
 ". The record never touches the purity, and the pure value ",
 Cell[BoxData[
  RowBox[{
   StyleBox["P", "TI"], "=", 
   SuperscriptBox["\[HBar]", "2"], "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5ec95d-e220-f105-2a65-e10697dac06f"],
 " is a fixed point. Because ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]], ">", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05590d03-2064-1772-3366-a56d51117a58"],
 ", it attracts: a mixed Gaussian purifies at the rate ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["\[Lambda]", "TI"], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],
 ", the same on every run, and numerical error in ",
 Cell[BoxData[
  StyleBox["P", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef0eca9-2ea7-fc5e-268f-05f34b53c6a4"],
 " is damped rather than accumulated."
}], "Text",
 CellID->1843091513,ExpressionUUID->"53b0040e-15e9-970f-014f-9e68a39dfa55"],

Cell[TextData[{
 "Check with one sampled run that starts mixed (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]], "=", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["p", "TI"]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49c5479d-c9fe-ab26-7ffb-5ec6ef88f60c"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["C", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b5640c-4acf-57ea-214b-7e566f7a3d30"],
 ", with ",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", 
   StyleBox["m", "TI"], "=", 
   StyleBox["\[Lambda]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12e31b8a-6cd9-3185-4290-92d4056d83ef"],
 ") and read ",
 Cell[BoxData[
  StyleBox["P", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8dfb5f-95aa-8549-44b2-f3191c5cef93"],
 " at the end, with no renormalization step:"
}], "Text",
 CellID->1978684664,ExpressionUUID->"77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"Last", "[", 
      RowBox[{
       RowBox[{"RandomFunction", "[", 
        RowBox[{
         RowBox[{"kb", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mass", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"\[Lambda]", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"\[HBar]", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"vx0", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"vp0", " ", "->", " ", "1"}]}], "}"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "6", ",", " ", "0.01"}], "}"}]}], "]"}], 
       "[", "\"\<Values\>\"", "]"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", "3", "]"}], "]"}], " ", 
     RowBox[{"v", "[", 
      RowBox[{"[", "5", "]"}], "]"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", "4", "]"}], "]"}], "^", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[106]:= ",
 CellID->2064137570,ExpressionUUID->"122b6086-f39f-774a-4229-79e3862a5d90"],

Cell["\<\
A Gaussian Pulse on a Qubit: the Propagator Is a Rotation by the Pulse Area\
\>", "Section",
 CellID->1265784226,ExpressionUUID->"562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],

Cell[TextData[{
 "Drive a qubit on resonance with a Gaussian envelope, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox["1", "2"], 
   SubscriptBox["\[CapitalOmega]", "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["t", "TI"], "-", 
        SubscriptBox[
         StyleBox["t", "TI"], "0"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"], "/", "2", 
     SuperscriptBox[
      StyleBox["\[Tau]", "TI"], "2"]}]], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a176158-c8f1-b5ca-1a2d-7905e8851f10"],
 ". Which gate has it made by time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59294b9d-2c6b-0af3-08d7-62c7451e58d9"],
 "? A numerical integrator returns one ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c93342e-976f-2690-74a0-ad88221b8cfa"],
 " matrix for each choice of ",
 Cell[BoxData[
  SubscriptBox["\[CapitalOmega]", "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["t", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "386c40c3-2c7c-2bd7-6814-59ad4509793d"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Tau]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a5d185-6c33-4099-685a-c8ef05c612e3"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705b2160-d6f6-9bc7-2078-b94de280e92d"],
 ". Here the unknown is the whole propagator, a ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad5a48d-d13d-ee7b-6aea-3dd6e0c9b541"],
 " matrix function, and the equation ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", "-", 
   StyleBox["i", "TI"], 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e286ad4-f19d-13f8-67d7-8391802861c2"],
 " is solved once with every parameter symbolic."
}], "Text",
 CellID->872599864,ExpressionUUID->"40ae3c14-0aab-252d-7055-b65eaf5f8c77"],

Cell[TextData[{
 "Solve ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", "-", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SubscriptBox["\[CapitalOmega]", "0"], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{
        StyleBox["t", "TI"], "-", 
        SubscriptBox[
         StyleBox["t", "TI"], "0"]}], 
       StyleBox[")",
        SpanMaxSize->1]}], "2"], "/", "2", 
     SuperscriptBox[
      StyleBox["\[Tau]", "TI"], "2"]}]], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]], 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3710829e-7f3a-eae8-5d2f-1bd87accb832"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", "\|01d7d9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514f46f4-7214-5441-0775-5fbe07a13eab"],
 ", declaring ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a8341fe-fd5d-b2cd-0ab1-58bbf4e90017"],
 " a ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf942e0-12f7-a17b-7487-5bcaa683f041"],
 " matrix:"
}], "Text",
 CellID->2056057710,ExpressionUUID->"4db09b50-0334-b760-7b4f-131ab6c61a4a"],

Cell[BoxData[
 RowBox[{"upulse", " ", "=", " ", 
  RowBox[{"DSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"u", "'"}], "[", "t", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"I", "/", "2"}], ")"}]}], " ", "\[CapitalOmega]0", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"t", " ", "-", " ", "t0"}], ")"}], "^", "2"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"\[Tau]", "^", "2"}]}], ")"}]}], "]"}], " ", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "1", "]"}], " ", ".", " ", 
         RowBox[{"u", "[", "t", "]"}]}]}]}], ",", " ", 
      RowBox[{
       RowBox[{"u", "[", "0", "]"}], " ", "==", " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"u", "[", "t", "]"}], " ", "\[Element]", " ", 
     RowBox[{"Matrices", "[", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]}], ",", " ", "t"}], 
   "]"}]}]], "Input",
 CellLabel->"In[107]:= ",
 CellID->1360523735,ExpressionUUID->"7cb56032-9c81-172f-244b-7a7c15347a75"],

Cell["\<\
The entries are exponentials of error functions. The error function appears \
because it is the running integral of the Gaussian, which suggests that the \
envelope enters only through the area swept out so far.\
\>", "Text",
 CellID->676766013,ExpressionUUID->"55f15dca-bfed-9606-038f-54943999fd6c"],

Cell[TextData[{
 "Compute that area, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], "\[CapitalOmega]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["s", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["s", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5589ad74-704a-26e9-03b6-453e01fc8c33"],
 ":"
}], "Text",
 CellID->1428640414,ExpressionUUID->"37fda5d4-10fa-7e26-5d82-3c9ea08f450c"],

Cell[BoxData[
 RowBox[{"area", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"\[CapitalOmega]0", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"s", " ", "-", " ", "t0"}], ")"}], "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"\[Tau]", "^", "2"}]}], ")"}]}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", "0", ",", " ", "t"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"\[Tau]", " ", ">", " ", "0"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[108]:= ",
 CellID->1143649234,ExpressionUUID->"6cc64ef1-7b65-373d-14fe-67bb7e119a07"],

Cell[TextData[{
 "Test whether the solved propagator is exactly the rotation ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["t", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["x", "TI"]], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542582fc-1c6f-cfd5-7dda-1ba6951b953f"],
 ":"
}], "Text",
 CellID->1571962290,ExpressionUUID->"7ad84463-32de-d6a2-2af8-5e4d4768bc88"],

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"upulse", " ", "==", " ", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"area", "/", "2"}], " ", 
      RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], ",", " ", 
   RowBox[{"\[Tau]", " ", ">", " ", "0"}]}], "]"}]], "Input",
 CellLabel->"In[109]:= ",
 CellID->2091585593,ExpressionUUID->"3261459d-f728-27c9-621f-5cc682c28d13"],

Cell[TextData[{
 "The shape of the pulse has washed out: only its area survives, so a \
Gaussian and a square pulse of equal area make the same gate. In other words, \
this is the area theorem, and it holds because ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "331c7f17-1677-2611-6124-7751a3038d7b"],
 " points along ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cbe893-f079-1a7f-3cc8-01dc810c6945"],
 " at every instant, so the Hamiltonians at different times commute and the \
time-ordered exponential becomes an ordinary one. Add a detuning term ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],
 " and that commutation fails, and the shape matters again."
}], "Text",
 CellID->30157833,ExpressionUUID->"355f53e5-dafb-cebc-6365-4acede8f9486"],

Cell[TextData[{
 "Compare with a numerical integration at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", "0"], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492c649c-8337-646c-78d4-7dc636c24eb6"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["t", "TI"], "0"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "=", "1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c54ceec-a669-4ede-046b-e7c9d31c1424"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336f4c4f-cb14-5955-6115-6628eea12bbf"],
 ":"
}], "Text",
 CellID->1715653387,ExpressionUUID->"192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"upulse", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalOmega]0", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"t0", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\[Tau]", " ", "->", " ", 
         RowBox[{"1", "/", "4"}]}], ",", " ", 
        RowBox[{"t", " ", "->", " ", "2"}]}], "}"}]}], ")"}], " ", "-", " ", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"v", "'"}], "[", "s", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"I", "/", "2"}], ")"}]}], " ", "3", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"s", " ", "-", " ", "1"}], ")"}], "^", "2"}]}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "/", "4"}], ")"}], "^", "2"}]}], ")"}]}], "]"}], 
          " ", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "1", "]"}], " ", ".", " ", 
           RowBox[{"v", "[", "s", "]"}]}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"v", "[", "0", "]"}], " ", "==", " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"v", "[", "2", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[110]:= ",
 CellID->1904268993,ExpressionUUID->"2580083d-358c-3435-53bf-a267bc3e9f1f"],

Cell["The difference sits at the integrator's tolerance.", "Text",
 CellID->1610510011,ExpressionUUID->"477fde83-a5ae-c17e-6d04-d7eccc589044"],

Cell["\<\
Ehrenfest and Mandelstam-Tamm for Any H(t): Identities Without Solving for \
the State\
\>", "Section",
 CellID->1363210520,ExpressionUUID->"0782fdeb-454d-5eca-2db1-f4b56cf82410"],

Cell[TextData[{
 "For a qubit with a completely arbitrary Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["h", "TI"], "0"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "\|01d7d9", "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["x", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]], "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["y", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["y", "TI"]], "+", 
   SubscriptBox[
    StyleBox["h", "TI"], 
    StyleBox["z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a01936-08b2-60cf-1f5f-9170a9473215"],
 ", does ",
 Cell[BoxData[
  RowBox[{
   FractionBox[
    StyleBox["d", "TI"], 
    StyleBox[
     RowBox[{"d", "t"}], "TI"]], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     RowBox[{
      StyleBox["H", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["t", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}], ",", 
     StyleBox["A", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],
 " hold, and does the state move through Hilbert space at speed ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0b44c7-b7b3-5c45-1409-5da0c24626af"],
 "? A simulator can only check these on one trajectory for one chosen drive. \
Here the four drive functions stay undetermined, the state is never solved \
for, and the Schr\[ODoubleDot]dinger equation enters only as a rule for the \
time derivatives (",
 Cell[BoxData[
  RowBox[{"\[HBar]", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dba914e-52ed-e087-7b59-09286699b2ed"],
 ")."
}], "Text",
 CellID->751311520,ExpressionUUID->"497e5609-e734-e246-7f06-485292c6b0ac"],

Cell[TextData[{
 "Write the ket as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "1"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c79fc2-e932-c645-38fc-16af88c4acaf"],
 " and the bra as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], "1"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["b", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["t", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2184153d-b162-7859-57bb-8d66c0174aa3"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"], "."], "=", 
   RowBox[{
    RowBox[{"-", 
     StyleBox["i", "TI"]}], 
    StyleBox["H", "TI"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], "."], "=", 
   RowBox[{
    StyleBox["i", "TI"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    StyleBox["H", "TI"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "554ef748-00c8-cf17-0375-ef12b162927d"],
 ". Then differentiate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],
 " for an arbitrary constant matrix ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee2421b-c68a-4a96-2692-6444f33f18fc"],
 " and subtract ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["H", "TI"], ",", 
     StyleBox["A", "TI"]}], 
    StyleBox["]",
     SpanMaxSize->1]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79971006-243c-6fe2-2fac-8a604dc935c8"],
 ":"
}], "Text",
 CellID->1811324800,ExpressionUUID->"61109047-93e0-1377-172f-0a2125957e5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hE", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"h0", "[", "t", "]"}], " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"hx", "[", "t", "]"}], " ", 
     RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"hy", "[", "t", "]"}], " ", 
     RowBox[{"PauliMatrix", "[", "2", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"hz", "[", "t", "]"}], " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ket", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c1", "[", "t", "]"}], ",", " ", 
     RowBox[{"c2", "[", "t", "]"}]}], "}"}]}], ";", " ", 
  RowBox[{"bra", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"b1", "[", "t", "]"}], ",", " ", 
     RowBox[{"b2", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"schr", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"ket", ",", " ", "t"}], "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"hE", " ", ".", " ", "ket"}]}]}], "]"}], ",", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"bra", ",", " ", "t"}], "]"}], " ", "->", " ", 
       RowBox[{"I", " ", 
        RowBox[{"bra", " ", ".", " ", "hE"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"obsA", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"a", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"bra", " ", ".", " ", "obsA", " ", ".", " ", "ket"}], ",", " ",
        "t"}], "]"}], " ", "/.", " ", "schr"}], ")"}], " ", "-", " ", 
   RowBox[{"I", " ", 
    RowBox[{"bra", " ", ".", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"hE", " ", ".", " ", "obsA"}], " ", "-", " ", 
       RowBox[{"obsA", " ", ".", " ", "hE"}]}], ")"}], " ", ".", " ", 
     "ket"}]}]}], "]"}]}], "Input",
 CellLabel->"In[111]:= ",
 CellID->1255352889,ExpressionUUID->"341c784b-10c0-0bab-5c24-7215a17559f1"],

Cell["\<\
The residual is zero for every drive and every observable. In other words, \
Ehrenfest's theorem is a consequence of the equation of motion alone, not of \
any particular solution, so it holds even for drives whose propagator has no \
closed form.\
\>", "Text",
 CellID->1056550259,ExpressionUUID->"4125a490-d89a-105a-70da-3dddd92f62a0"],

Cell[TextData[{
 "Now the Fubini-Study speed squared, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "."], 
     OverscriptBox[
      StyleBox["\[Psi]", "TI"], "."]},
    "BraKet"], "-", 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["\[Psi]", "TI"], 
         OverscriptBox[
          StyleBox["\[Psi]", "TI"], "."]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b67f461-4283-7871-391c-ee4b77364b5b"],
 ", against the energy variance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["H", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "-", 
   SuperscriptBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["H", "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79999c45-ea42-0b46-2fa6-162e8ff759ac"],
 ":"
}], "Text",
 CellID->1554899303,ExpressionUUID->"5fae9c0a-8a55-fd6e-0555-16542fe1c7b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"speed2", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"bra", ",", " ", "t"}], "]"}], " ", ".", " ", 
       RowBox[{"D", "[", 
        RowBox[{"ket", ",", " ", "t"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"bra", " ", ".", " ", 
         RowBox[{"D", "[", 
          RowBox[{"ket", ",", " ", "t"}], "]"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"bra", ",", " ", "t"}], "]"}], " ", ".", " ", "ket"}], 
        ")"}]}]}], ")"}], " ", "/.", " ", "schr"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"speed2", " ", "-", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     "bra", " ", ".", " ", "hE", " ", ".", " ", "hE", " ", ".", " ", "ket"}], 
     " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"bra", " ", ".", " ", "hE", " ", ".", " ", "ket"}], ")"}], "^",
       "2"}]}], ")"}]}], "]"}]}], "Input",
 CellLabel->"In[112]:= ",
 CellID->1285549060,ExpressionUUID->"1ae1fb24-4e58-6c4d-4a9e-f28e6bed3697"],

Cell[TextData[{
 "The state moves through projective Hilbert space at exactly ",
 Cell[BoxData[
  RowBox[{"\[CapitalDelta]", 
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4afb14-05e6-4298-3a49-f35eb39310e2"],
 " at every instant (Anandan and Aharonov). The Mandelstam-Tamm bound follows \
as geometry: the distance between start and end, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arccos",
    FontSlant->"Plain"], GridBox[{
     {
      TemplateBox[{
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], "0"], 
        SubscriptBox[
         StyleBox["\[Psi]", "TI"], 
         StyleBox["t", "TI"]]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a681de3-120d-8f0a-4a17-94cda7b9d250"],
 ", cannot exceed the length of the path, ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", 
    StyleBox["t", "TI"]], "\[CapitalDelta]", 
   StyleBox["E", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   SuperscriptBox[
    StyleBox["t", "TI"], "\[Prime]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fe8910c-2477-6bad-2597-09564d0239f7"],
 "."
}], "Text",
 CellID->1616846310,ExpressionUUID->"4724aa69-80a2-605c-6edb-4c33315732a6"],

Cell[TextData[{
 "The identity part ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["h", "TI"], "0"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db6e0a3-5ee4-0113-2b4d-f90d5a915079"],
 " only adds a global phase, so it must not move the state. On normalized \
states the variance does not depend on it:"
}], "Text",
 CellID->1706199142,ExpressionUUID->"64959d98-6722-362c-0caa-14c212d49d76"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
      "bra", " ", ".", " ", "hE", " ", ".", " ", "hE", " ", ".", " ", "ket"}],
       " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"bra", " ", ".", " ", "hE", " ", ".", " ", "ket"}], ")"}], "^",
        "2"}]}], ",", " ", 
     RowBox[{"h0", "[", "t", "]"}]}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"bra", " ", ".", " ", "ket"}], " ", "==", " ", "1"}]}], 
  "]"}]], "Input",
 CellLabel->"In[113]:= ",
 CellID->848974671,ExpressionUUID->"5f8c04ec-8c47-4bdf-05b3-9db625f21925"],

Cell["\<\
The Jaynes-Cummings Propagator: Exact for Every Photon Number n\
\>", "Section",
 CellID->1375299215,ExpressionUUID->"023e8ab0-46e5-584b-33c5-23fa72902a91"],

Cell[TextData[{
 "A two-level atom couples to one cavity mode, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", "\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["z", "TI"]], "/", "2", "+", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "+"], 
    StyleBox["a", "TI"], "+", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "-"], 
    SuperscriptBox[
     StyleBox["a", "TI"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a0eac86-50d0-15df-0a35-45e061657f25"],
 " in the frame rotating at the cavity frequency. The interaction only \
exchanges one excitation between the atom and the field, so ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58394c25-48c8-3ecd-09c7-658f69628417"],
 " couples to ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["n", "TI"], "+", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1424a2b0-695c-dfcb-3ddb-3bfa08eea511"],
 " and nothing else. What is the propagator for every photon number? A \
Fock-space solver truncates the field at some cutoff and answers for each ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05101942-3b9c-ad10-332f-912cbe2ef47a"],
 " below it. Here ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35394d45-77a0-03f4-5cc7-652f025551de"],
 ", ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f9454e1-244e-40e6-65ac-4dcb4dfb12cc"],
 ", ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "530b93a6-4244-79d7-0108-0a0077f14b3d"],
 " and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c785ed8-c9e5-405c-7418-5785ef9012a6"],
 " stay symbols."
}], "Text",
 CellID->1656178105,ExpressionUUID->"0a66b72e-8103-1d0f-3a1d-2e8830b66455"],

Cell[TextData[{
 "Exponentiate the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6206b938-b2f8-72db-123d-3165c68d4021"],
 " block on ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["e", "TI"], ",", 
        StyleBox["n", "TI"]}]},
     "Ket"], ",", 
    TemplateBox[{
      RowBox[{
        StyleBox["g", "TI"], ",", 
        StyleBox["n", "TI"], "+", "1"}]},
     "Ket"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a01a055-721a-3362-2a3e-3a1f07ac9e48"],
 ", whose off-diagonal element is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["e", "TI"], ",", 
    RowBox[{
     StyleBox["n", "TI"], GridBox[{
       {
        RowBox[{
         SubscriptBox[
          StyleBox["\[Sigma]", "TI"], "+"], 
         StyleBox["a", "TI"]}]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     StyleBox["g", "TI"]}], ",", 
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["g", "TI"], 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425e231b-d90e-d650-7265-bb44d8b8bcba"],
 ":"
}], "Text",
 CellID->2128368636,ExpressionUUID->"6f4b19d7-d2e6-1d55-1548-9090e69367bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"jc", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "/", "2"}], ",", " ", 
       RowBox[{"g", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"n", " ", "+", " ", "1"}], "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"n", " ", "+", " ", "1"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"-", "\[CapitalDelta]"}], "/", "2"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ujc", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "t", " ", "jc"}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"g", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"n", " ", ">=", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[CapitalDelta]", " ", "\[Element]", " ", "Reals"}]}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[114]:= ",
 CellID->471452856,ExpressionUUID->"266a3a12-a29b-0b72-4e69-bc5fd72e5658"],

Cell[TextData[{
 "The propagator rotates at the generalized Rabi frequency ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["n", "TI"]], "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalDelta]", "2"], "+", "4", 
     SuperscriptBox[
      StyleBox["g", "TI"], "2"], 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], "+", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b97aeb9-f3a3-063a-49ac-47e286566d00"],
 ". The probability that an atom starting in ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "670ec096-5157-8cf5-0d35-d9d060e3d6df"],
 " has emitted its photon is ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      SubscriptBox[
       StyleBox["U", "TI"], "21"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a46f8a5-a076-b8c1-7a7d-f10ed1000a2b"],
 ":"
}], "Text",
 CellID->1993504316,ExpressionUUID->"7b9d6462-a0fd-67c7-29a3-7e4fd0884d2d"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"ujc", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}], "^", "2"}], ",", 
   " ", 
   RowBox[{
    RowBox[{"g", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"n", " ", ">=", " ", "0"}], " ", "&&", " ", 
    RowBox[{"t", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"\[CapitalDelta]", " ", "\[Element]", " ", "Reals"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[115]:= ",
 CellID->1944276818,ExpressionUUID->"5c567373-a618-e547-046e-6b3cd392cfad"],

Cell[TextData[{
 "On resonance the atom empties completely, at a frequency that grows as ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5028993e-6f44-360e-01d7-11780af69d54"],
 "; detuned, it never empties, with a ceiling set by ",
 Cell[BoxData[
  RowBox[{"4", 
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SubsuperscriptBox["\[CapitalOmega]", 
    StyleBox["n", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05297336-3344-a7f5-2cd7-6b7046f60ddf"],
 ". The ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75fa11b5-921a-0030-2399-88ff27af531a"],
 " under the square root is spontaneous emission: even at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d27580a-3980-0923-54dd-5254b8355809"],
 " the vacuum makes the atom oscillate."
}], "Text",
 CellID->524220529,ExpressionUUID->"077289f0-6175-2cad-2d01-20ba100076f7"],

Cell["\<\
The dressed states split by the difference of the block's eigenvalues; on \
resonance:\
\>", "Text",
 CellID->950216136,ExpressionUUID->"133b68ba-8b92-4fbc-42d8-81e42e271586"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Differences", "[", 
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"jc", " ", "/.", " ", 
      RowBox[{"\[CapitalDelta]", " ", "->", " ", "0"}]}], "]"}], "]"}], ",", 
   " ", 
   RowBox[{
    RowBox[{"g", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"n", " ", ">=", " ", "0"}]}]}], "]"}]], "Input",
 CellLabel->"In[116]:= ",
 CellID->338647958,ExpressionUUID->"6db49e4d-4459-39d0-1b4b-10176ded8b3a"],

Cell[TextData[{
 "The splitting is ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["g", "TI"], 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e45bb6-31a6-d4bb-379c-52f04050be81"],
 ": the vacuum Rabi splitting at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "638a875f-059e-01af-1189-1f19ac2b53f5"],
 ", and in general a splitting that grows as the square root of the photon \
number, which is the graininess of the field that a classical drive does not \
have."
}], "Text",
 CellID->961910044,ExpressionUUID->"3b1c9c05-9360-5fc6-6923-166f2615252c"],

Cell[TextData[{
 "Check against the full QuantumFramework Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "+"], 
    StyleBox["a", "TI"], "+", 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], "-"], 
    SuperscriptBox[
     StyleBox["a", "TI"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8f8704-dbc1-ad9f-5bb4-1f61de75f7e5"],
 " with the field truncated at 6 levels: its propagator, restricted to ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{
      RowBox[{
        StyleBox["e", "TI"], ",", "2"}]},
     "Ket"], ",", 
    TemplateBox[{
      RowBox[{
        StyleBox["g", "TI"], ",", "3"}]},
     "Ket"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bacb1bf-0091-7884-2953-28f9b1244aee"],
 ", should be the block at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e949b39-c960-dcff-16ab-1362e81aa6c5"],
 ":"
}], "Text",
 CellID->1465513701,ExpressionUUID->"52d3365b-85bc-1911-02e0-a8052c49687b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hq", " ", "=", " ", 
   RowBox[{"g", " ", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}]}], "]"}], " ", "@", " ", 
     RowBox[{"AnnihilationOperator", "[", 
      RowBox[{"6", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ufull", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "t", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"hq", " ", "+", " ", 
         RowBox[{"hq", "[", "\"\<Dagger\>\"", "]"}]}], ")"}], 
       "[", "\"\<Matrix\>\"", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ufull", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "10"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "10"}], "}"}]}], "]"}], "]"}], " ", "==", " ", 
    
    RowBox[{"(", 
     RowBox[{"ujc", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalDelta]", " ", "->", " ", "0"}], ",", " ", 
        RowBox[{"n", " ", "->", " ", "2"}]}], "}"}]}], ")"}]}], ",", " ", 
   RowBox[{"g", " ", ">", " ", "0"}]}], "]"}]}], "Input",
 CellLabel->"In[117]:= ",
 CellID->1779278278,ExpressionUUID->"058c1579-2127-d4ed-33b3-8d2350d3be37"],

Cell["\<\
Syndrome Populations of a Repetition Code: the Closed Equation from a General \
\[Rho]\
\>", "Section",
 CellID->332869652,ExpressionUUID->"4f55ae27-0b76-e8ec-756a-4781ae00ba36"],

Cell[TextData[{
 "Three qubits carry the bit-flip code, with stabilizers ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62fbf51e-f93c-ccd0-1298-ed5bf8ce963a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "011d018b-0453-500f-3722-98d5ade62355"],
 ", and each qubit flips at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b868176-6936-78c0-49bd-193008c34a2a"],
 ". The four syndrome sectors have populations ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox["\[CapitalPi]", 
     StyleBox["j", "TI"]], 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "317554d9-f61a-a01f-670b-4d8283acf365"],
 ". Do these four numbers obey a closed equation of their own, and what is \
it? A simulator would integrate the master equation for some initial states \
and fit the populations. Here the question is put to a completely general ",
 Cell[BoxData[
  RowBox[{"8", "\[Times]", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "581509a3-40d5-fdc4-082a-a00d7161c72e"],
 " matrix ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27a46d13-c303-51d0-4d5b-855cf6b6233a"],
 " with 64 free entries, and the answer is solved for rather than proposed."
}], "Text",
 CellID->870462011,ExpressionUUID->"17c64253-a2be-52b9-3dfe-641cd74b2083"],

Cell[TextData[{
 "Set up the stabilizers, the four sector projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalPi]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SubscriptBox[
       StyleBox["s", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["s", "TI"], "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "1"], 
    SubscriptBox[
     StyleBox["Z", "TI"], "1"], 
    SubscriptBox[
     StyleBox["Z", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SubscriptBox[
     StyleBox["s", "TI"], "2"], 
    SubscriptBox[
     StyleBox["Z", "TI"], "2"], 
    SubscriptBox[
     StyleBox["Z", "TI"], "3"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a34ce21-af18-53d3-0bcb-e78acaad2139"],
 " and a general ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1308debe-b866-1363-4137-d7f839137e49"],
 ", and read off the rank of each projector:"
}], "Text",
 CellID->770594293,ExpressionUUID->"339fc10a-19b9-5d82-61a4-d954984c27e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"id2", ",", " ", "sx", ",", " ", "sz"}], "}"}], " ", "=", " ", 
   RowBox[{"PauliMatrix", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1", ",", " ", "3"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"op", "[", 
    RowBox[{"o_", ",", " ", "q_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"id2", ",", " ", "id2", ",", " ", "id2"}], "}"}], ",", " ", 
      RowBox[{"q", " ", "->", " ", "o"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stabs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"op", "[", 
       RowBox[{"sz", ",", " ", "1"}], "]"}], " ", ".", " ", 
      RowBox[{"op", "[", 
       RowBox[{"sz", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"op", "[", 
       RowBox[{"sz", ",", " ", "2"}], "]"}], " ", ".", " ", 
      RowBox[{"op", "[", 
       RowBox[{"sz", ",", " ", "3"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"proj", "[", 
    RowBox[{"{", 
     RowBox[{"s1_", ",", " ", "s2_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
       RowBox[{"s1", " ", 
        RowBox[{"stabs", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], " ", ".", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "8", "]"}], " ", "+", " ", 
       RowBox[{"s2", " ", 
        RowBox[{"stabs", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "/", "4"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sectors", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{"rho", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"r", ",", " ", 
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{"proj", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
  "sectors"}]}], "Input",
 CellLabel->"In[118]:= ",
 CellID->416617480,ExpressionUUID->"442b12f5-789a-53e1-6c28-8bbf792f21cb"],

Cell[TextData[{
 "For each sector, take the trace of ",
 Cell[BoxData[
  SubscriptBox["\[CapitalPi]", 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39387274-e40a-435c-68d8-74318dbf11a6"],
 " against the bit-flip dissipator ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["k", "TI"],
    LimitsPositioning->False], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["k", "TI"]], 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     StyleBox["X", "TI"], 
     StyleBox["k", "TI"]], "-", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70ecc98e-c53f-f68b-2093-e0ebeccbdcd1"],
 ", and ask ",
 Cell[BoxData["SolveAlways"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53e7ddcf-0b8d-05e4-019c-d4a9ae386fce"],
 " for coefficients ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["c", "TI"], 
   StyleBox["s", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a830965-7851-22cf-4ab0-a14f79e47015"],
 " that make it equal to ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["s", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["s", "TI"]], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["s", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47763c58-6b8c-f19b-6d0d-b6020e3ec3e1"],
 " for every one of the 64 entries of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2411395d-4500-dc0b-4c2e-b1076cbaa751"],
 ":"
}], "Text",
 CellID->468951994,ExpressionUUID->"51798d79-74e7-e8a1-0706-25237c93ba8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"inPops", "[", "tr_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"c", " ", "/@", " ", "sectors"}], ")"}], " ", ".", " ", 
     RowBox[{"(", 
      RowBox[{"p", " ", "/@", " ", "sectors"}], ")"}]}], " ", "/.", " ", 
    RowBox[{"First", "[", 
     RowBox[{"SolveAlways", "[", 
      RowBox[{
       RowBox[{"tr", " ", "==", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c", " ", "/@", " ", "sectors"}], ")"}], " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"proj", "[", "#", "]"}], " ", ".", " ", "rho"}], "]"}], 
            " ", "&"}], " ", "/@", " ", "sectors"}], ")"}]}]}], ",", " ", 
       RowBox[{"Flatten", "[", "rho", "]"}]}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"drift", " ", "=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"inPops", "[", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"proj", "[", "#", "]"}], " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"op", "[", 
               RowBox[{"sx", ",", " ", "k"}], "]"}], " ", ".", " ", "rho", 
              " ", ".", " ", 
              RowBox[{"op", "[", 
               RowBox[{"sx", ",", " ", "k"}], "]"}]}], " ", "-", " ", "rho"}],
             ")"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], "]"}]}], " ", "&"}], 
    ")"}], " ", "/@", " ", "sectors"}]}]}], "Input",
 CellLabel->"In[119]:= ",
 CellID->1802328397,ExpressionUUID->"0e7478e0-34bc-b2ae-360c-71cabd4e00f4"],

Cell[TextData[{
 "A solution exists, and that existence is the closure: 64 numbers go in, and \
the answer depends on only four combinations of them. Each sector gains \
weight at rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa139-5ae3-ed74-4004-39635e97b45e"],
 " from each of the other three and loses it at ",
 Cell[BoxData[
  RowBox[{"3", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0084d900-0120-94d6-30bb-d16ab0dafe3c"],
 ", because each single flip carries a sector onto exactly one other."
}], "Text",
 CellID->328865975,ExpressionUUID->"45e3bdb3-b7b8-8152-7390-34fcc232d3b8"],

Cell[TextData[{
 "Add back ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["\[Gamma]", "TI"], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["j", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e5e1e6c-8075-0eb3-0665-903631005499"],
 " to each entry:"
}], "Text",
 CellID->1270006433,ExpressionUUID->"3b122816-0897-a47c-6921-c250a9230f46"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"drift", " ", "+", " ", 
   RowBox[{"4", " ", "\[Gamma]", " ", 
    RowBox[{"(", 
     RowBox[{"p", " ", "/@", " ", "sectors"}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[120]:= ",
 CellID->34003199,ExpressionUUID->"12228eb7-81d1-9f6b-43d1-27f13065e5b1"],

Cell[TextData[{
 "Every entry is ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c4e3d89-d3d8-0dbe-3475-b4d2e66d5784"],
 " times the total population, so with ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["s", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["s", "TI"]], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44dcab5a-698d-607d-6ce3-430408383347"],
 " the equation is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p", "TI"], "."], 
    StyleBox["j", "TI"]], "=", 
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", "4", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268a9802-0d7f-2bfd-4e89-126ca40a79c7"],
 ": every sector relaxes to ",
 Cell[BoxData[
  RowBox[{"1", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79bc5755-bb31-5780-2f44-4f1f3ec43dea"],
 " at rate ",
 Cell[BoxData[
  RowBox[{"4", 
   StyleBox["\[Gamma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ff00406-ec89-251c-358f-9e63853d8c66"],
 "."
}], "Text",
 CellID->1596250240,ExpressionUUID->"7d6791a5-5599-4f2a-2b1c-080f5c2c1270"],

Cell[TextData[{
 "The closure is a property of the dynamics, not of the method. Add a \
Hamiltonian term that does not commute with the stabilizers, ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["X", "TI"], "1"], ",", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7441be-5925-9c2b-240c-58f858d1e771"],
 ", and ask the same question:"
}], "Text",
 CellID->1572158672,ExpressionUUID->"5ff4eb8a-8686-c1c6-058b-02d43330932c"],

Cell[BoxData[
 RowBox[{"SolveAlways", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"proj", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"op", "[", 
            RowBox[{"sx", ",", " ", "1"}], "]"}], " ", ".", " ", "rho"}], " ",
           "-", " ", 
          RowBox[{"rho", " ", ".", " ", 
           RowBox[{"op", "[", 
            RowBox[{"sx", ",", " ", "1"}], "]"}]}]}], ")"}]}], ")"}]}], "]"}],
     " ", "==", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"c", " ", "/@", " ", "sectors"}], ")"}], " ", ".", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"proj", "[", "#", "]"}], " ", ".", " ", "rho"}], "]"}], " ",
         "&"}], " ", "/@", " ", "sectors"}], ")"}]}]}], ",", " ", 
   RowBox[{"Flatten", "[", "rho", "]"}]}], "]"}]], "Input",
 CellLabel->"In[121]:= ",
 CellID->1137775047,ExpressionUUID->"049abcb6-c083-4b47-2cb9-35f3f13619ad"],

Cell["\<\
No coefficients exist: the populations now couple to coherences between \
sectors, and four numbers are no longer enough.\
\>", "Text",
 CellID->573363004,ExpressionUUID->"00908b6d-9173-71f0-30af-2337200643da"],

Cell["\<\
Continuous Position Measurement: the Conditional Variances Carry No Noise\
\>", "Section",
 CellID->1565937439,ExpressionUUID->"0c438d61-2567-fb5f-3470-254b4c13c9a5"],

Cell[TextData[{
 "A free particle is watched continuously, so its conditional state obeys a \
stochastic equation in which an observable ",
 Cell[BoxData[
  StyleBox["O", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3129044e-2557-7c3e-60d6-9e284ce24704"],
 " picks up a noise term ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["\[Lambda]", "TI"]], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{"{", 
     StyleBox["x", "TI"], "-", 
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     StyleBox["x", "TI"], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], ",", 
    RowBox[{
     StyleBox["O", "TI"], "}"}]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["W", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "185e1b20-c9fe-9997-4865-928def88ebfd"],
 ". The means ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79986dc0-6b5a-b4b1-2fa7-84aa0eec1e9b"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["p", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66994d41-411f-db5d-0ea7-652b70aba9a7"],
 " wander randomly. Do the variances ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba5d17e-cdbf-5380-095a-c93be44a21ea"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4459b86e-fafc-12f5-6c66-324bfe8960df"],
 " and the covariance ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bcb2561-df35-3b41-39c8-bd4adac189ab"],
 " wander too? A trajectory simulation would answer by sampling many runs. \
Here the canonical commutator is handed to the kernel's non-commutative \
algebra, a Gaussian state supplies the moments, and the noise coefficients \
are computed exactly."
}], "Text",
 CellID->1825661031,ExpressionUUID->"2cdc7c52-f996-171f-54e4-761ff8237a65"],

Cell[TextData[{
 "Declare the algebra generated by ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a04a347-6624-93dc-1a3b-3b2113d6e126"],
 " and ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa3b0bf-db30-02a1-4550-29f8dec5508b"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], 
   StyleBox["x", "TI"], "=", 
   StyleBox["x", "TI"], 
   StyleBox["p", "TI"], "-", 
   StyleBox["i", "TI"], "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11dd9886-a103-697c-47e2-11e3d0b63846"],
 "; ",
 Cell[BoxData["NonCommutativeExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d16072b-4094-e7d7-0b2d-9f757126cd3d"],
 " then writes every product with ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e71c00a-9fc6-07cd-160e-da541a736d17"],
 " to the left of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59da3beb-dbdf-0123-0ff9-b2b4de6a5009"],
 ":"
}], "Text",
 CellID->1952919625,ExpressionUUID->"28f3c6b4-96e3-425b-5880-dffe229610a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xpAlg", " ", "=", " ", 
   RowBox[{"NonCommutativeAlgebra", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Generators\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"xo", ",", " ", "po"}], "}"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CommutationRelations\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"po", " ", "**", " ", "xo"}], " ", "-", " ", 
         RowBox[{"xo", " ", "**", " ", "po"}], " ", "+", " ", 
         RowBox[{"I", " ", "\[HBar]"}]}], "}"}]}]}], "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{"NonCommutativeExpand", "[", 
  RowBox[{
   RowBox[{"po", " ", "**", " ", "po", " ", "**", " ", "xo"}], ",", " ", 
   "xpAlg"}], "]"}]}], "Input",
 CellLabel->"In[122]:= ",
 CellID->162062935,ExpressionUUID->"50dcf632-b06e-d3ec-00e3-e87fc118a136"],

Cell[TextData[{
 "For a Gaussian state with means ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0192d3b7-44a5-149f-37a1-caf16d507ee5"],
 ", variances ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]], ",", 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["p", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0300f609-8c78-c232-313f-e85325f29118"],
 " and symmetric covariance ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366efd8d-b3b0-5f87-5e15-f4d6c64525ed"],
 ", the ordered generating function is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"\[Alpha]", "x"}], "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox[
      RowBox[{"\[Beta]", "p"}], "TI"]]}], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   StyleBox["exp",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["\[Alpha]", "TI"], 
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["x", "TI"]], "+", 
   StyleBox["\[Beta]", "TI"], 
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["p", "TI"]], "+", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Alpha]", "TI"], "2"], 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["x", "TI"]], "+", "2", 
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["C", "TI"], "+", 
    SuperscriptBox[
     StyleBox["\[Beta]", "TI"], "2"], 
    SubscriptBox[
     StyleBox["V", "TI"], 
     StyleBox["p", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   FractionBox[
    RowBox[{
     StyleBox["i", "TI"], "\[HBar]"}], "2"], 
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["\[Beta]", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3db21443-28a2-09d2-6b41-8e2d49575b38"],
 ", so each ordered monomial ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["a", "TI"]], 
   SuperscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["b", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bbb6266-506e-8b43-5958-84406118d9a9"],
 " has expectation ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[PartialD]", 
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["a", "TI"]], 
   SubsuperscriptBox["\[PartialD]", 
    StyleBox["\[Beta]", "TI"], 
    StyleBox["b", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e86e78b-e825-43de-16bd-fed489d01124"],
 " of it at zero. Build that expectation and test it on ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"x", "p"}], "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00acb0de-f92e-37b6-3053-299bf8d89d9c"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox[
    RowBox[{"p", "x"}], "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688c2685-a509-dc5c-18b3-bfeeccbda6a6"],
 ":"
}], "Text",
 CellID->1483832353,ExpressionUUID->"2ceaa2e1-4528-9e89-54e9-3bcb6cc2e4d3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gauss", " ", "=", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "mx"}], " ", "+", " ", 
     RowBox[{"\[Beta]", " ", "mp"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Alpha]", "^", "2"}], " ", "Vx"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Alpha]", " ", "\[Beta]", " ", "Cc"}], " ", "+", 
        " ", 
        RowBox[{
         RowBox[{"\[Beta]", "^", "2"}], " ", "Vp"}]}], ")"}], "/", "2"}], " ",
      "+", " ", 
     RowBox[{"I", " ", "\[HBar]", " ", "\[Alpha]", " ", 
      RowBox[{"\[Beta]", "/", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mean", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{
        RowBox[{"NonCommutativeExpand", "[", 
         RowBox[{"o", ",", " ", "xpAlg"}], "]"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"GeneralizedPower", "[", 
            RowBox[{
            "NonCommutativeMultiply", ",", " ", "g_", ",", " ", "k_"}], "]"}],
            " ", ":>", " ", 
           RowBox[{"g", "^", "k"}]}], ",", " ", 
          RowBox[{"NonCommutativeMultiply", " ", "->", " ", "Times"}]}], 
         "}"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#2", " ", 
           RowBox[{"D", "[", 
            RowBox[{"gauss", ",", " ", 
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", " ", 
               RowBox[{"#1", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\[Beta]", ",", " ", 
               RowBox[{"#1", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], " ", "/.",
           " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Alpha]", " ", "->", " ", "0"}], ",", " ", 
            RowBox[{"\[Beta]", " ", "->", " ", "0"}]}], "}"}]}], ")"}], " ", 
        "&"}], " ", "@@@", " ", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{"q", ",", " ", 
         RowBox[{"{", 
          RowBox[{"xo", ",", " ", "po"}], "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"mean", "[", 
    RowBox[{"xo", " ", "**", " ", "po"}], "]"}], ",", " ", 
   RowBox[{"mean", "[", 
    RowBox[{"po", " ", "**", " ", "xo"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[123]:= ",
 CellID->421271511,ExpressionUUID->"1303f7c9-9cc9-b37e-4130-ee93157d1e44"],

Cell[TextData[{
 "The two orderings differ by exactly ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], "\[HBar]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec53290-e027-d466-56fa-abdd91d3bf4c"],
 ", the commutator, while their average is the classical covariance."
}], "Text",
 CellID->971430162,ExpressionUUID->"18ec055d-da13-7d9a-4893-9d06dfa647e0"],

Cell[TextData[{
 "Now the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"d", "W"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210c0b92-bdf5-0dca-5733-a2dc3b805710"],
 " coefficient of each second moment, with the It\[OHat] correction for the \
products of means: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a8ae1a-48d1-1e8c-3857-4044696464d6"],
 " takes the noise of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["x", "TI"], "2"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a42a6f1-18c8-51d7-0a71-3fbb997d233d"],
 " minus ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "151d482b-bd7d-21e9-4323-627534087333"],
 " times the noise of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5613a8b7-1620-2919-7e20-41f1a3d57863"],
 ", and likewise for ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae8fe52-8d2a-0d13-0a97-f01c24df5479"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a61ac-db6f-0823-69ba-7809de1a5b09"],
 ":"
}], "Text",
 CellID->411794565,ExpressionUUID->"1ebbb135-9363-cdcb-4658-297f26179711"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"noise", "[", "o_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", "\[Lambda]", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"mean", "[", 
       RowBox[{
        RowBox[{"xo", " ", "**", " ", "o"}], " ", "+", " ", 
        RowBox[{"o", " ", "**", " ", "xo"}]}], "]"}], " ", "-", " ", 
      RowBox[{"2", " ", "mx", " ", 
       RowBox[{"mean", "[", "o", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"noise", "[", 
      RowBox[{"xo", " ", "**", " ", "xo"}], "]"}], " ", "-", " ", 
     RowBox[{"2", " ", "mx", " ", 
      RowBox[{"noise", "[", "xo", "]"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"noise", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"xo", " ", "**", " ", "po"}], " ", "+", " ", 
         RowBox[{"po", " ", "**", " ", "xo"}]}], ")"}], "/", "2"}], "]"}], 
     " ", "-", " ", 
     RowBox[{"mx", " ", 
      RowBox[{"noise", "[", "po", "]"}]}], " ", "-", " ", 
     RowBox[{"mp", " ", 
      RowBox[{"noise", "[", "xo", "]"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"noise", "[", 
      RowBox[{"po", " ", "**", " ", "po"}], "]"}], " ", "-", " ", 
     RowBox[{"2", " ", "mp", " ", 
      RowBox[{"noise", "[", "po", "]"}]}]}]}], "}"}], "]"}]}], "Input",
 CellLabel->"In[124]:= ",
 CellID->211393631,ExpressionUUID->"3fac2774-ed95-ff32-6553-bf318421c218"],

Cell[TextData[{
 "All three noise coefficients vanish. In other words, every run puts the \
wave packet in a different place, but all runs give it the same width at the \
same time: the conditional variances obey ordinary differential equations. \
The noise in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0bfcd9-47ee-c5d1-2608-f5837198af3b"],
 " is proportional to the third cumulant of ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bce04d4-edb5-1ec8-29f5-9d9184406412"],
 ", and a Gaussian state has none. The same holds for ",
 Cell[BoxData[
  StyleBox["C", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04eac529-5321-5efa-2ce9-dd7366d424c0"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], 
   StyleBox["p", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "121d8e7a-a943-ef24-4222-2027c8f7b20e"],
 ": every combination that enters the noise is symmetrically ordered, so the \
commutator drops out and only the third cumulants, all zero, remain."
}], "Text",
 CellID->485898233,ExpressionUUID->"3f53e49d-d2a9-b4ee-6560-fdc6e75d1e34"],

Cell[TextData[{
 "A Gaussian's third moment has no content beyond its first two, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["x", "TI"], "3"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", 
   SubsuperscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["x", "TI"], "3"], "+", "3", 
   SubscriptBox[
    StyleBox["\[Mu]", "TI"], 
    StyleBox["x", "TI"]], 
   SubscriptBox[
    StyleBox["V", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "672c7908-ff3c-85a7-0ed4-7155faceef8d"],
 ":"
}], "Text",
 CellID->300459616,ExpressionUUID->"4f36945c-6fe2-68e0-76cd-0e0609973aca"],

Cell[BoxData[
 RowBox[{"mean", "[", 
  RowBox[{"xo", " ", "**", " ", "xo", " ", "**", " ", "xo"}], "]"}]], "Input",\

 CellLabel->"In[125]:= ",
 CellID->1400905077,ExpressionUUID->"250c2a2d-8da6-5f9d-5333-cc77245325e7"],

Cell["\<\
Symmetry Proofs at Symbolic Dimension: Tensor Identities with No Components\
\>", "Section",
 CellID->900992407,ExpressionUUID->"67928f76-a8f6-4c39-0da1-2733c8831703"],

Cell[TextData[{
 "An antisymmetric tensor contracted with a symmetric one gives zero; the \
Ricci tensor is symmetric; the curl of a gradient vanishes. Each follows from \
index symmetries alone. A numerical library can check them only on one random \
instance in one fixed dimension. Here the tensors are declared by their \
symmetries in dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f8d9e4d-778e-395a-15b2-101702388ba0"],
 ", never given entries, and ",
 Cell[BoxData["TensorReduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4897ab63-07fe-7036-78ac-434db18b431c"],
 " brings each expression to a canonical form."
}], "Text",
 CellID->1909490419,ExpressionUUID->"3afe1774-f6b9-1a20-6a85-8f31834c690a"],

Cell[TextData[{
 "Contract an antisymmetric ",
 Cell[BoxData[
  StyleBox["A", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cb96547-3d6c-b437-3447-7d21b41e1f1d"],
 " with a symmetric ",
 Cell[BoxData[
  StyleBox["S", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2231aed9-983c-87b7-53ce-478319ceed9d"],
 ", ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox[
     RowBox[{"i", "j"}], "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], 
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d324fdb-2677-e56b-74c2-66855303cfb1"],
 ", in dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5da8286f-a7a3-9cec-0b57-c248d257e636"],
 ":"
}], "Text",
 CellID->809304935,ExpressionUUID->"7d602230-5f26-2f06-2b1f-c47a5ad3726c"],

Cell[BoxData[
 RowBox[{"TensorReduce", "[", 
  RowBox[{
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"TensorProduct", "[", 
      RowBox[{"aT", ",", " ", "sT"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"aT", " ", "\[Element]", " ", 
       RowBox[{"Arrays", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"d", ",", " ", "d"}], "}"}], ",", " ", "Reals", ",", " ", 
         RowBox[{"Antisymmetric", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"sT", " ", "\[Element]", " ", 
       RowBox[{"Arrays", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"d", ",", " ", "d"}], "}"}], ",", " ", "Reals", ",", " ", 
         RowBox[{"Symmetric", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}]}], "}"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[126]:= ",
 CellID->1060035609,ExpressionUUID->"77db54cc-ee9f-ec5f-1df9-4da98b2bb6a5"],

Cell[TextData[{
 "Declare the Riemann tensor by its three single-term symmetries \
(antisymmetry in each pair, symmetry under pair exchange) and a symmetric \
metric, form the Ricci tensor ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"b", "d"}], "TI"]], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["g", "TI"], 
    StyleBox[
     RowBox[{"a", "c"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a072e47-9a01-f132-1a3c-c0211fb5c018"],
 ", and compare it with its transpose:"
}], "Text",
 CellID->960351252,ExpressionUUID->"03b41a97-fa59-5a01-314b-93d0ffec296b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"riemSym", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "]"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], "}"}], "]"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", " ", 
       "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"asmR", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d", ",", " ", "d", ",", " ", "d"}], "}"}], ",",
         " ", "Reals", ",", " ", "riemSym"}], "]"}]}], ",", " ", 
     RowBox[{"gT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d"}], "}"}], ",", " ", "Reals", ",", " ", 
        RowBox[{"Symmetric", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ricci", " ", "=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"TensorProduct", "[", 
      RowBox[{"rT", ",", " ", "gT"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"TensorReduce", "[", 
   RowBox[{"ricci", ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", "asmR"}]}], "]"}], " ", "===", " ", 
  RowBox[{"TensorReduce", "[", 
   RowBox[{
    RowBox[{"TensorTranspose", "[", 
     RowBox[{"ricci", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", "asmR"}]}], "]"}]}]}], "Input",
 CellLabel->"In[127]:= ",
 CellID->1269096941,ExpressionUUID->"425dab48-397f-3702-7262-4312b80b9a68"],

Cell["\<\
The Ricci tensor is symmetric in every dimension, which is what lets it sit \
on the left of Einstein's equations next to the symmetric stress tensor.\
\>", "Text",
 CellID->2008479665,ExpressionUUID->"0b03a0e0-ac2b-54e8-3930-39cdc5de3e32"],

Cell[TextData[{
 "Contract the Levi-Civita tensor with the Hessian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]], "=", 
   SubscriptBox["\[PartialD]", 
    StyleBox["j", "TI"]], 
   SubscriptBox["\[PartialD]", 
    StyleBox["k", "TI"]], 
   StyleBox["f", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23998a05-7963-184f-51a6-2c6f78166a95"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"\[Del]", "\[Times]", "\[Del]", 
      StyleBox["f", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    StyleBox["i", "TI"]], "=", 
   SubscriptBox["\[Epsilon]", 
    StyleBox[
     RowBox[{"i", "j", "k"}], "TI"]], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox[
     RowBox[{"j", "k"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "422628af-426c-374e-73dd-c109771e9d94"],
 ":"
}], "Text",
 CellID->29625565,ExpressionUUID->"26e7e4d8-634d-0d10-4e9c-fd8216f8547a"],

Cell[BoxData[
 RowBox[{"TensorReduce", "[", 
  RowBox[{
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"TensorProduct", "[", 
      RowBox[{"epsT", ",", " ", "hT"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"epsT", " ", "\[Element]", " ", 
       RowBox[{"Arrays", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
         "Reals", ",", " ", 
         RowBox[{"Antisymmetric", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]}], 
        "]"}]}], ",", " ", 
      RowBox[{"hT", " ", "\[Element]", " ", 
       RowBox[{"Arrays", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "3"}], "}"}], ",", " ", "Reals", ",", " ", 
         RowBox[{"Symmetric", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}]}], "}"}]}]}],
   "]"}]], "Input",
 CellLabel->"In[128]:= ",
 CellID->9883570,ExpressionUUID->"027e254c-1480-02c1-3205-bd169d35502b"],

Cell["\<\
The result is a zero vector of length 3, not the scalar 0: the canonical form \
keeps the shape, so it can sit inside a larger expression.\
\>", "Text",
 CellID->940978275,ExpressionUUID->"6456a901-44b8-c553-0c6d-416b6d32afb9"],

Cell[TextData[{
 "The canonicalizer does not answer 0 indiscriminately. Contract an \
antisymmetric tensor with itself, ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox[
     RowBox[{"i", "j"}], "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], 
   SubscriptBox[
    StyleBox["A", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de3bc1f-ff0d-b0a4-0b90-3658fab9028e"],
 ", which is a sum of squares:"
}], "Text",
 CellID->173258875,ExpressionUUID->"05b0da98-ac84-313a-334f-d3c5c5368000"],

Cell[BoxData[
 RowBox[{"TensorReduce", "[", 
  RowBox[{
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"TensorProduct", "[", 
      RowBox[{"aT", ",", " ", "aT"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"aT", " ", "\[Element]", " ", 
      RowBox[{"Arrays", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "d"}], "}"}], ",", " ", "Reals", ",", " ", 
        RowBox[{"Antisymmetric", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[129]:= ",
 CellID->792860948,ExpressionUUID->"1895dfb3-965d-1c83-48aa-d6fd23e866e9"],

Cell["\<\
The Riemann Identities Derived from the Young Projector, First Bianchi \
Included\
\>", "Section",
 CellID->124530881,ExpressionUUID->"2deed3b4-be8d-db40-5b95-cafe3b39a9aa"],

Cell[TextData[{
 "The Riemann tensor has three single-term symmetries and one identity of a \
different kind, the first Bianchi identity ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], "+", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "c", "d", "b"}], "TI"]], "+", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "d", "b", "c"}], "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78e6b17c-c991-15ef-289d-2939e8247f35"],
 ", which sets a sum of three permuted copies to zero. ",
 Cell[BoxData["TensorReduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24acbe62-bdf4-ffe2-4c53-304c3b86c5c8"],
 " works only with symmetries of the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["R", "TI"], "=", "\[PlusMinus]", 
   SuperscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["\[Sigma]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38f0085c-4734-4722-688f-a20672c12a08"],
 ", so it cannot reach Bianchi from the declared pair symmetries:"
}], "Text",
 CellID->1312473818,ExpressionUUID->"6b9216eb-8f9f-eb69-19a1-8fb52a2bb9b3"],

Cell[BoxData[
 RowBox[{"TensorReduce", "[", 
  RowBox[{
   RowBox[{"rB", " ", "+", " ", 
    RowBox[{"TensorTranspose", "[", 
     RowBox[{"rB", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "2"}], "}"}]}], 
     "]"}], " ", "+", " ", 
    RowBox[{"TensorTranspose", "[", 
     RowBox[{"rB", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], "}"}]}], 
     "]"}]}], ",", " ", 
   RowBox[{"Assumptions", " ", "->", " ", 
    RowBox[{"rB", " ", "\[Element]", " ", 
     RowBox[{"Arrays", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "d", ",", " ", "d", ",", " ", "d"}], "}"}], ",",
        " ", "Reals", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cycles", "[", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "]"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cycles", "[", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"3", ",", " ", "4"}], "}"}], "}"}], "]"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cycles", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", " ", 
           "1"}], "}"}]}], "}"}]}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[130]:= ",
 CellID->1627779716,ExpressionUUID->"59f120da-5631-2eb2-0f8e-b98463c47498"],

Cell[TextData[{
 "Can all four identities instead be found, without listing them, from the \
one fact that the Riemann tensor lives in the ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fa7ad17-3a9c-8e6e-055c-4551bf2ed4b4"],
 " irreducible representation of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c844eb4-1a55-00c1-54bc-67fe9fe0522b"],
 "? Project a random integer tensor onto that representation with the \
TensorNetworks Young projector, and collect its 24 slot-permuted copies:"
}], "Text",
 CellID->294107029,ExpressionUUID->"6cf619f4-16c8-91d6-148d-90bea362e33c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"riem", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{
     RowBox[{"RandomInteger", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "9"}], ",", " ", "9"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"perms4", " ", "=", " ", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", "4", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"copies", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"riem", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
    " ", "perms4"}]}], ";"}], "\n", 
 RowBox[{"MatrixRank", "[", "copies", "]"}]}], "Input",
 CellLabel->"In[131]:= ",
 CellID->736271930,ExpressionUUID->"66b1d308-016b-0c10-0e4e-cb52b01e577a"],

Cell[TextData[{
 "The 24 copies span only a 2-dimensional space, the dimension of the ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0764fd02-d65e-847f-2d1b-f56fe3e8ef45"],
 " representation, so they obey 22 independent linear relations. Every \
element ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["\[Sigma]", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["\[Sigma]", "TI"]], 
   StyleBox["\[Sigma]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c98820f-8b6f-75b8-34a7-24692e1a5f82"],
 " of the group algebra that annihilates the tensor is an identity of the \
Riemann tensor. Search the three-term sums over permutations that fix slot \
1:"
}], "Text",
 CellID->406066173,ExpressionUUID->"6abb7d62-34cd-b03b-1a59-754cbd790301"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{"Subsets", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"perms4", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "_", ",", " ", "_", ",", " ", "_"}], "}"}]}],
         "]"}], "]"}], ",", " ", 
      RowBox[{"{", "3", "}"}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"copies", "[", 
        RowBox[{"[", "#", "]"}], "]"}], "]"}], " ", "==", " ", 
      RowBox[{"0", " ", 
       RowBox[{"Range", "[", "256", "]"}]}]}], " ", "&"}]}], "]"}], " ", "/.",
   " ", 
  RowBox[{"i_Integer", " ", ":>", " ", 
   RowBox[{"perms4", "[", 
    RowBox[{"[", "i", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[132]:= ",
 CellID->783505316,ExpressionUUID->"2d7b53f1-7ae1-3c16-5b19-4abb7e95877c"],

Cell[TextData[{
 "The first relation found is the cyclic sum over slots 2, 3, 4: the first \
Bianchi identity, produced by the projector and not supplied. The second is \
the same identity after the antisymmetry in the last pair. A search over \
two-term sums ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["a", "TI"]], "\[PlusMinus]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["b", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "342ac02e-94b9-9375-5c29-d9881d4dfe5f"],
 " returns the pair antisymmetries and the pair exchange in the same way."
}], "Text",
 CellID->1838581182,ExpressionUUID->"7e47f25d-3ed8-a4c4-267c-f407bb520e2e"],

Cell[TextData[{
 "Count the components: the image of the ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420d2e93-75d1-66df-7232-c7dd7c644c25"],
 " projector on all ",
 Cell[BoxData[
  SuperscriptBox["4", "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb3603b-0e30-9ef6-3641-7a65abcae4dc"],
 " tensors should have the textbook dimension of the Riemann tensor in four \
dimensions, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], "2"], "-", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "12", "=", "20"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da293aa-5e01-ac71-3b51-0af45bb5f75b"],
 ", one less than the 21 that the pair symmetries alone allow:"
}], "Text",
 CellID->1015299810,ExpressionUUID->"32c08ae5-f3ed-cbfa-62ff-23ce859999c0"],

Cell[BoxData[
 RowBox[{"MatrixRank", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"YoungProject", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}],
         "]"}], ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], "]"}], 
     "]"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"IdentityMatrix", "[", "256", "]"}]}], "]"}]], "Input",
 CellLabel->"In[133]:= ",
 CellID->320909480,ExpressionUUID->"1cfb14f9-38ed-478b-4498-8da3b8982dd1"],

Cell["\<\
Spectrum Estimation from n Copies: Schur-Sampling Probabilities in Closed Form\
\>", "Section",
 CellID->1950243504,ExpressionUUID->"683f5ed1-9434-8a9e-19c5-579b1dc6d8e4"],

Cell[TextData[{
 "Given ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07cd5cb3-9399-0155-2df3-55fd262c53bf"],
 " copies of an unknown qubit state ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9e6b1d-931e-a284-75a5-834726a8f0ee"],
 ", measure which irreducible representation of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7129e602-6ec3-689c-20d6-f86c0b763ae6"],
 " (which Young diagram ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24548d70-e349-6090-4c6b-253d96fc32fa"],
 ") the joint state lies in. The outcome probability is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Pr",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Lambda]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["\[Lambda]", "TI"]], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"\[CircleTimes]", 
      StyleBox["n", "TI"]}]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24053d10-b77f-7f73-4c3a-b55dc20a4259"],
 ", and Keyl and Werner showed that ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "/", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16592835-d9b8-94b1-3e66-c27ed832fe9b"],
 " concentrates on the spectrum of ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141ca810-4c49-bb60-3c23-425a65fd064a"],
 ". What are these probabilities for an arbitrary mixed state? A numerical \
code would evaluate them for one ",
 Cell[BoxData[
  StyleBox["\[Rho]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68e9730c-176f-ed31-1897-6b56a21bb41b"],
 " at a time. Here the Bloch vector stays symbolic."
}], "Text",
 CellID->1158471628,ExpressionUUID->"045a1c11-48b2-feff-2c79-965b6944c4c5"],

Cell[TextData[{
 "Build the orthogonal projector onto each ",
 Cell[BoxData[
  StyleBox["\[Lambda]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5000470d-6ead-2730-0030-5f570b598a1a"],
 "-block of four qubits from the Young projectors of its standard tableaux, \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["\[Lambda]", "TI"]], "=", 
   StyleBox["M", "TI"], 
   SuperscriptBox[
    StyleBox["M", "TI"], "+"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b36215d-7c1e-6467-0acd-b90775ab4f4d"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], "=", 
   UnderscriptBox["\[Sum]", 
    StyleBox["T", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "648fe92d-3764-e6d2-0cb4-01774216cc38"],
 ", and check that the three blocks are Hermitian, idempotent and complete:"
}], "Text",
 CellID->600867794,ExpressionUUID->"51ab5adf-11d7-a41b-07a9-5399a0630f61"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"basis4", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"#", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2", ",", " ", "2"}], "}"}]}], 
      "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"IdentityMatrix", "[", "16", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"isoProj", "[", "\[Lambda]_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tabs", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"YoungTableau", "[", 
            RowBox[{"TakeList", "[", 
             RowBox[{"#", ",", " ", "\[Lambda]"}], "]"}], "]"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"Permutations", "[", 
           RowBox[{"Range", "[", "4", "]"}], "]"}]}], ",", " ", 
         "StandardTableauQ"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"ket", ",", " ", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"YoungProject", "[", 
                  RowBox[{"ket", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
                 " ", "tabs"}], "]"}], "]"}]}], "]"}], " ", "/@", " ", 
           "basis4"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"m", " ", ".", " ", 
        RowBox[{"PseudoInverse", "[", "m", "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"shapes", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "4", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{"projs", " ", "=", " ", 
   RowBox[{"isoProj", " ", "/@", " ", "shapes"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Tr", " ", "/@", " ", "projs"}], ",", " ", 
   RowBox[{
    RowBox[{"Total", "[", "projs", "]"}], " ", "==", " ", 
    RowBox[{"IdentityMatrix", "[", "16", "]"}]}], ",", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", " ", ".", " ", "#"}], " ", "==", " ", "#"}], " ", "&&", 
        " ", 
        RowBox[{"#", " ", "==", " ", 
         RowBox[{"ConjugateTranspose", "[", "#", "]"}]}]}], " ", "&"}], " ", "/@",
       " ", "projs"}], ")"}]}]}], "}"}]}], "Input",
 CellLabel->"In[134]:= ",
 CellID->570648126,ExpressionUUID->"6ea1ee02-7e80-589f-165e-006c7b352ae5"],

Cell[TextData[{
 "The block dimensions are ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["J", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "481e4aee-9cf5-9d73-7826-63c81481e459"],
 " times the multiplicity of total spin ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3565e36d-8dcc-1be9-631a-fb3724796933"],
 ": the shape ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Lambda]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "235d73f5-0285-a3fd-5163-6abfb731f1c7"],
 " is total spin ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "1"], "-", 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a726cbd-ee36-06ea-5a01-85e68bc36c30"],
 "."
}], "Text",
 CellID->1943045306,ExpressionUUID->"545cfe61-129d-c9b2-7c63-f04ba7299b98"],

Cell[TextData[{
 "Take ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\|01d7d9", "+", 
    OverscriptBox[
     StyleBox["b", "TI"], "\[RightVector]"], "\[CenterDot]", 
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "\[RightVector]"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a738979-6fd1-4d91-5a00-21230a6417fb"],
 " with a symbolic Bloch vector, and compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Pr",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Lambda]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["\[Lambda]", "TI"]], 
    SuperscriptBox[
     StyleBox["\[Rho]", "TI"], 
     RowBox[{"\[CircleTimes]", "4"}]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cda659f-caad-1800-44fa-7cd8ef586b6a"],
 ":"
}], "Text",
 CellID->1695469705,ExpressionUUID->"6bd8f04d-1eeb-cc47-19e7-ea179a9f96ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]q", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], " ", "+", " ", 
      RowBox[{"bx", " ", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
      RowBox[{"by", " ", 
       RowBox[{"PauliMatrix", "[", "2", "]"}]}], " ", "+", " ", 
      RowBox[{"bz", " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{"schur", " ", "=", " ", 
  RowBox[{"Factor", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"#", " ", ".", " ", 
       RowBox[{"KroneckerProduct", " ", "@@", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"\[Rho]q", ",", " ", "4"}], "]"}]}]}], "]"}], " ", "&"}], 
    " ", "/@", " ", "projs"}], "]"}]}]}], "Input",
 CellLabel->"In[135]:= ",
 CellID->808446663,ExpressionUUID->"4131a38c-3cb1-61e0-70ce-3ad6b54433ca"],

Cell[TextData[{
 "The probabilities depend on ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["b", "TI"], "\[RightVector]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66dd1d78-a26e-793a-0ee2-9525d71b4800"],
 " only through ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      OverscriptBox[
       StyleBox["b", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497210fc-93c1-a1bc-7f01-89a62675f386"],
 ", that is, only on the eigenvalues ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "\[PlusMinus]", GridBox[{
      {
       OverscriptBox[
        StyleBox["b", "TI"], "\[RightVector]"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d97aad1-2ffc-78e2-5bac-439b49894ac8"],
 ": the Young diagram carries the spectrum and nothing about the eigenbasis. \
A pure state (",
 Cell[BoxData[
  RowBox[{GridBox[{
     {
      OverscriptBox[
       StyleBox["b", "TI"], "\[RightVector]"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45812a49-00f9-159c-73be-cc13b08c7fe6"],
 ") puts all its weight on the symmetric diagram ",
 Cell[BoxData[
  RowBox[{"{", "4", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e72335e-d71b-483f-5601-ab1be2ae1b05"],
 ", so the measurement says nothing beyond \"pure\"; it is the mixedness that \
spreads weight onto ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "3"}], ",", 
   RowBox[{"1", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00379a47-1bf1-fdbf-31cc-1c219d85c785"],
 " and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", "2"}], ",", 
   RowBox[{"2", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c466c6-94fb-625d-4ffc-7fa01c8e30a7"],
 ". The maximally mixed state gives the block dimensions divided by 16."
}], "Text",
 CellID->843355028,ExpressionUUID->"20cc8908-a147-10ca-50f3-2155d0f26210"],

Cell[TextData[{
 "Compare with the closed form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Pr",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Lambda]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["f", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13bcd130-62a3-8c70-4143-c97a1757d75a"],
 ", with ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["\[Lambda]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6565394a-c196-6bdd-131a-b117f0233927"],
 " the dimension of the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654f987a-f98e-d016-1374-1227f838a37c"],
 " representation and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["\[Lambda]", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox[
      RowBox[{"a", "b"}], "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SubscriptBox[
     StyleBox["\[Lambda]", "TI"], "2"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     StyleBox["a", "TI"], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], "1"], "-", 
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], "2"], "+", "1"}]], "-", 
    SuperscriptBox[
     StyleBox["b", "TI"], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], "1"], "-", 
      SubscriptBox[
       StyleBox["\[Lambda]", "TI"], "2"], "+", "1"}]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], "-", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631c7298-8e73-d34d-1124-6bc22b07a197"],
 " the Schur polynomial of the eigenvalues:"
}], "Text",
 CellID->2123001010,ExpressionUUID->"2e9b4f74-ee28-5e2b-56b9-67318bdd2571"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "rb"}], ")"}], "/", "2"}]}], ",", " ", 
     RowBox[{"b", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "rb"}], ")"}], "/", "2"}]}]}], "}"}], ",",
    " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"schur", " ", "/.", " ", 
       RowBox[{"bz", " ", "->", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"rb", "^", "2"}], " ", "-", " ", 
          RowBox[{"bx", "^", "2"}], " ", "-", " ", 
          RowBox[{"by", "^", "2"}]}], "]"}]}]}], ")"}], " ", "-", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"TableauDimension", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"{", "##", "}"}], ",", " ", "0"}], "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"a", " ", "b"}], ")"}], "^", "#2"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", "^", 
             RowBox[{"(", 
              RowBox[{"#1", " ", "-", " ", "#2", " ", "+", " ", "1"}], 
              ")"}]}], " ", "-", " ", 
            RowBox[{"b", "^", 
             RowBox[{"(", 
              RowBox[{"#1", " ", "-", " ", "#2", " ", "+", " ", "1"}], 
              ")"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"a", " ", "-", " ", "b"}], ")"}]}]}], " ", "&"}], " ", "@@@",
        " ", 
       RowBox[{"PadRight", "[", "shapes", "]"}]}], ")"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[136]:= ",
 CellID->1415208481,ExpressionUUID->"7ff84a3f-8ea3-8415-2598-6c792b57ef7f"],

Cell["\<\
A Stabilizer Measurement Kept Symbolic: Random Outcomes as Bits, Determined \
Outcomes as Functions of Them\
\>", "Section",
 CellID->80082845,ExpressionUUID->"4d7fc3a7-f4ac-747e-7b04-da00fd595f44"],

Cell[TextData[{
 "Prepare two qubits in ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b0a0ef4-2602-73b0-1909-a7be53b7419a"],
 " and copy their parity onto a third with two CNOTs, then measure all three \
in the ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7324c1ff-ae1d-8266-22db-d8b8cba9d14c"],
 " basis. Two outcomes are fair coins; the third is fixed by them. A \
stabilizer simulator such as Stim samples shots, and the dependence shows up \
only as a pattern in the samples. Here the measurement is not sampled at all: \
each random outcome becomes a formal bit, and each determined outcome is \
stored as a function of those bits."
}], "Text",
 CellID->730828669,ExpressionUUID->"0a19e89c-6899-3c78-3a26-01c6092d8742"],

Cell["Prepare the state and read its stabilizer generators:", "Text",
 CellID->20229285,ExpressionUUID->"39663cc9-297d-9b4a-6f1d-b5934809e990"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parity", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliStabilizer", "[", "3", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<H\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"parity", "[", "\"\<Stabilizers\>\"", "]"}]}], "Input",
 CellLabel->"In[137]:= ",
 CellID->865532999,ExpressionUUID->"7331868a-f3de-6799-22ce-1fd7866b4de3"],

Cell[TextData[{
 "The generator ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e54b5d3-3a50-bfef-566b-2c9dbfea0535"],
 " stabilizes the state, so the three ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "290d3a44-5bc8-0dba-5f32-bc2e5e7d5780"],
 " outcomes cannot be independent."
}], "Text",
 CellID->1719354248,ExpressionUUID->"24441621-d1c3-83e7-4c7b-8f8ae077d1cd"],

Cell["\<\
Measure all three qubits symbolically, and read the generators and the stored \
outcomes:\
\>", "Text",
 CellID->803807756,ExpressionUUID->"40c04446-bf75-68d5-70f0-5e203a003a3f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ms", " ", "=", " ", 
   RowBox[{"parity", "[", 
    RowBox[{"\"\<SymbolicMeasure\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ms", "[", "\"\<Stabilizers\>\"", "]"}], ",", " ", 
   RowBox[{"ms", "[", "\"\<Outcomes\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[138]:= ",
 CellID->601042471,ExpressionUUID->"337e031d-61ac-97b3-6105-9b47105efd99"],

Cell[TextData[{
 "Only two formal bits ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["s", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c1a2f33-e4c4-62b1-1439-c77c8d71309b"],
 " are allocated, one per genuinely random qubit, and each enters a generator \
as the sign ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{"-", "1"}], 
     StyleBox[")",
      SpanMaxSize->1]}], 
    SubscriptBox[
     StyleBox["s", "TI"], 
     StyleBox["k", "TI"]]], "=", "1", "-", "2", 
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["k", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "617ac38b-bfe7-c8e3-1719-dad539939ac9"],
 ". The third outcome is not a new coin: it is stored as a Boolean expression \
in ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0820ecb4-5495-9c54-39df-05fe5d21e6be"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e80e7d7-2c44-8e80-06bf-fe9145f6d4ea"],
 ". In other words, the measured state is still one object, and the \
correlation the conserved ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f5fcf3-bda8-2342-4e8a-f5bd345d71a8"],
 " forces is held as a formula."
}], "Text",
 CellID->2038927162,ExpressionUUID->"15b39007-6d36-072c-4340-0a6104c36a76"],

Cell[TextData[{
 "Tabulate the stored third outcome over the four values of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["s", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24baaecf-7f93-f980-4c59-47a97a27cbea"],
 ":"
}], "Text",
 CellID->1188205371,ExpressionUUID->"76f70144-dc0f-2312-1e8c-9921d5bb8e78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bits", " ", "=", " ", 
   RowBox[{"Union", " ", "@", " ", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"ms", "[", "\"\<Phase\>\"", "]"}], ",", " ", 
      RowBox[{"\[FormalS]", "[", "_", "]"}], ",", " ", "Infinity"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"Flatten", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b", ",", " ", 
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"Values", "[", 
          RowBox[{"ms", "[", "\"\<Outcomes\>\"", "]"}], "]"}], "]"}], " ", "/.",
         " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"bits", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}]}], "]"}]}]}], "}"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
   "1"}], "]"}]}], "Input",
 CellLabel->"In[139]:= ",
 CellID->1003860385,ExpressionUUID->"1fe7a9e0-94ce-d707-459c-40ca1d78ba6d"],

Cell[TextData[{
 "The third bit is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], "1"], "\[CirclePlus]", 
   SubscriptBox[
    StyleBox["s", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d41bad8-5432-fbcd-6b7e-33825dc4c917"],
 " in every row, the syndrome of the simplest parity check."
}], "Text",
 CellID->952137231,ExpressionUUID->"0dba7410-c818-dfcb-3b5a-6e5de992a511"],

Cell["\<\
Cross-check with Stim on the same circuit: in every one of 1000 sampled shots \
the third bit equals the XOR of the first two:\
\>", "Text",
 CellID->1052272830,ExpressionUUID->"30c9b337-f958-fd8c-60f6-2b70f8d2c7d6"],

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{"\"\<Python\>\"", ",", 
   " ", "\"\<import stim\\nc = stim.Circuit('H 0 1\\\\nCX 0 2 1 2\\\\nM 0 1 \
2')\\ns = c.compile_sampler().sample(1000)\\nbool(((s[:, 0] ^ s[:, 1]) == \
s[:, 2]).all())\>\""}], "]"}]], "Input",
 CellLabel->"In[140]:= ",
 CellID->775731387,ExpressionUUID->"7ef4fbe9-42ce-bb3a-268b-f2b377780600"],

Cell["\<\
A Repetition Code under a QuantumFramework Channel: the Logical Error Rate Is \
a Polynomial\
\>", "Section",
 CellID->975612517,ExpressionUUID->"6b93c9b6-6d32-b3d4-19a0-e0f004c4013e"],

Cell[TextData[{
 "Encode one bit in three, let each physical qubit flip with probability ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b94e11-c6dd-a6bf-2847-605af3690c85"],
 ", and decode by majority vote. What is the probability that the logical bit \
is wrong, as a function of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b080b4d-7396-a957-4937-a3170620fbbd"],
 "? A Monte Carlo decoder estimates it at a list of ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "343c9421-c983-3b23-5dc3-0d8ae8378609"],
 " values. The QEC layer under development beside QuantumFramework (QECCore, \
not yet in the paclet) returns it as a polynomial, with the noise given as a \
QuantumFramework channel."
}], "Text",
 CellID->105335494,ExpressionUUID->"205770a9-e847-de3f-506d-69f289f3a505"],

Cell["Load the QEC layer from its source folder:", "Text",
 CellID->1276006902,ExpressionUUID->"78b78126-006e-7c03-284c-1880b11b4769"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Get", "[", \
"\"\</Users/mohammadb/Documents/GitHub/QuantumFramework/OngoingProjects/QEC/\
QECCore/QECCore.wl\>\"", "]"}], ";"}], "\n", 
 RowBox[{"MemberQ", "[", 
  RowBox[{"$ContextPath", ",", " ", "\"\<Wolfram`QuantumFramework`QEC`\>\""}],
   "]"}]}], "Input",
 CellLabel->"In[141]:= ",
 CellID->429330924,ExpressionUUID->"5e949e5e-c771-e653-06ab-101bf205ccb9"],

Cell[TextData[{
 "Ask for the logical error rate of the three-qubit repetition code under ",
 Cell[BoxData[
  RowBox[{"QuantumChannel", "[", 
   RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "359bcca5-e220-9ec0-63b8-e50e97dae42a"],
 ":"
}], "Text",
 CellID->699653744,ExpressionUUID->"3d973432-f49b-24e6-6bac-ae7ffd2f8ecc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rate", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"QECLogicalErrorRate", "[", 
     RowBox[{
      RowBox[{"QECCode", "[", 
       RowBox[{"\"\<Repetition\>\"", ",", " ", "n"}], "]"}], ",", " ", 
      RowBox[{"QuantumChannel", "[", 
       RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"rate", "[", "3", "]"}]}], "Input",
 CellLabel->"In[142]:= ",
 CellID->2118070064,ExpressionUUID->"2740d0b2-6fee-93c4-4d7f-c9fc0998e12e"],

Cell[TextData[{
 "The rate is ",
 Cell[BoxData[
  RowBox[{"3", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], "-", "2", 
   SuperscriptBox[
    StyleBox["p", "TI"], "3"], "=", "3", 
   SuperscriptBox[
    StyleBox["p", "TI"], "2"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   SuperscriptBox[
    StyleBox["p", "TI"], "3"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28899a3f-5003-79db-58b6-1c7961b64b21"],
 ": the decoder fails exactly when two or three qubits flip. The linear term \
is absent, so for small ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "091a51ee-65fb-201c-3f3a-48c8138e7366"],
 " the code beats a bare qubit."
}], "Text",
 CellID->1744932242,ExpressionUUID->"60c488fa-b38d-2f14-10fb-21a7c638727e"],

Cell["Find where the five-qubit code beats the three-qubit code:", "Text",
 CellID->551334296,ExpressionUUID->"3dab8a61-8541-a5e8-6ba8-2c4b2cf50f32"],

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rate", "[", "5", "]"}], " ", "<", " ", 
     RowBox[{"rate", "[", "3", "]"}]}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], ",", " ", "p"}], 
  "]"}]], "Input",
 CellLabel->"In[143]:= ",
 CellID->682025647,ExpressionUUID->"6cd9d50f-b32b-5aae-14e6-cd68c6de28f4"],

Cell[TextData[{
 "Below ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", "1", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25697345-b0fc-afe2-5317-6b2ec08ef5c8"],
 " the longer code is better; above it, worse. In other words, the threshold \
of the repetition code under bit flips is exactly one half, the crossing of \
two polynomials rather than of two sampled curves."
}], "Text",
 CellID->1646424406,ExpressionUUID->"7b535da6-b53b-b46b-2961-54003ccf1eb1"],

Cell[TextData[{
 "Cross-check from QuantumFramework primitives alone: apply the bit-flip \
channel to each qubit of ",
 Cell[BoxData[
  TemplateBox[{"000"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44232014-649d-d43d-6dd0-ba5e0d29bf07"],
 " and add the probabilities of the outcomes with two or more ones:"
}], "Text",
 CellID->2053055694,ExpressionUUID->"7586ae08-7861-bb88-23bd-4052791509d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"noisy", " ", "=", " ", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"QuantumChannel", "[", 
        RowBox[{
         RowBox[{"\"\<BitFlip\>\"", "[", "p", "]"}], ",", " ", 
         RowBox[{"{", "#2", "}"}]}], "]"}], "[", "#1", "]"}], " ", "&"}], ",",
      " ", 
     RowBox[{"QuantumState", "[", "\"\<000\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"noisy", "[", "\"\<ProbabilitiesList\>\"", "]"}], ",", " ", 
       RowBox[{"Total", " ", "/@", " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}], ",",
        " ", 
       RowBox[{"2", " ", "|", " ", "3"}]}], "]"}], "]"}], " ", "==", " ", 
    RowBox[{"rate", "[", "3", "]"}]}], ",", " ", 
   RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], "]"}]}], "Input",
 CellLabel->"In[144]:= ",
 CellID->2132198261,ExpressionUUID->"54e345b1-bc57-c084-7c91-5cfb35e392ee"],

Cell["\<\
A Drive Pulse as an Expression: a DRAG Sweep by Substitution and a Program \
Edited by Pattern\
\>", "Section",
 CellID->1954495564,ExpressionUUID->"5c2b12ae-6045-71e4-0428-8b0811f043ce"],

Cell[TextData[{
 "A transmon is driven by a microwave pulse, and DRAG adds a second \
quadrature proportional to the time derivative of the first, with a \
coefficient ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "180e6a9a-5611-2942-4835-83c463a47ba8"],
 " found by sweeping it. In a numeric pulse SDK the pulse is an array of \
samples and the sweep is a loop that regenerates the array. With QUALink the \
pulse stays an expression in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dd95d70-b540-f840-1be7-553a3cfacaaa"],
 " until the compiler samples it, each sweep value is one substitution into \
that expression, and the compiled program is itself an expression that the \
ordinary pattern tools query and edit. Nothing below touches a device."
}], "Text",
 CellID->1504758964,ExpressionUUID->"29eb0418-0bd1-ce19-5fe8-9e42ae659563"],

Cell["\<\
Load QUALink (TransmonLab, its optional physics backend, goes on the path \
too):\
\>", "Text",
 CellID->885403737,ExpressionUUID->"2fcc496e-9c46-13ea-55f4-614815f36130"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PacletDirectoryLoad", "[", 
   RowBox[{"{", 
    RowBox[{"\"\</Users/mohammadb/Documents/GitHub/mbahram/TransmonLab/\
TransmonLab\>\"", ",", 
     " ", "\"\</Users/mohammadb/Documents/GitHub/mbahram/QUALink/QUALink\>\""}\
], "}"}], "]"}], ";"}], "\n", 
 RowBox[{"Needs", "[", "\"\<WolframQuantumComputation`QUALink`\>\"", 
  "]"}]}], "Input",
 CellLabel->"In[145]:= ",
 CellID->299015440,ExpressionUUID->"191acd8d-6e98-c427-4f39-e4d70b12af0d"],

Cell[TextData[{
 "Write the in-phase envelope as a Gaussian and the quadrature as ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2305a976-3107-1e82-513a-413040b264e8"],
 " times its derivative:"
}], "Text",
 CellID->59570862,ExpressionUUID->"7db30b64-26ac-b1af-2b40-a34e535e03f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"envelope", " ", "=", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", " ", "-", " ", "20"}], ")"}], "^", "2"}]}], "/", "50"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"drag", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"envelope", ",", " ", 
    RowBox[{
     RowBox[{"-", "\[Beta]"}], " ", 
     RowBox[{"D", "[", 
      RowBox[{"envelope", ",", " ", "t"}], "]"}]}]}], "}"}]}]}], "Input",
 CellLabel->"In[146]:= ",
 CellID->1364978316,ExpressionUUID->"7eeaae22-94f7-017f-26e9-478c1c825045"],

Cell[TextData[{
 "Compile a program that sweeps ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09646c1c-8840-439e-3f1b-864629f511e4"],
 " over three values, and ask its intermediate representation where the drive \
is played:"
}], "Text",
 CellID->565097818,ExpressionUUID->"63ab22ce-56be-71a3-11a8-bba8634b4389"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dragProg", " ", "=", " ", 
   RowBox[{"QUAProgram", "[", 
    RowBox[{
     RowBox[{"\"\<Qubit\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"5.105*^9", ",", " ", "drag", ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "40"}], "}"}]}], "}"}]}], ",", 
     " ", 
     RowBox[{"\"\<Resonator\>\"", " ", "->", " ", "6.012*^9"}], ",", " ", 
     RowBox[{"\"\<\[Beta]\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "1"}], "}"}]}], ",", " ", 
     RowBox[{"\"\<Averages\>\"", " ", "->", " ", "100"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"dragProg", "[", "\"\<IR\>\"", "]"}], ",", " ", 
   RowBox[{"KeyValuePattern", "[", 
    RowBox[{"\"\<Head\>\"", " ", "->", " ", "\"\<SwitchPlay\>\""}], "]"}], ",",
    " ", "Infinity"}], "]"}]}], "Input",
 CellLabel->"In[147]:= ",
 CellID->1520041768,ExpressionUUID->"1cf7fb29-0d40-1e28-448c-f373a4f56572"],

Cell[TextData[{
 "The compiler found ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d412947-9e62-7904-5b7e-c1211b17486e"],
 " free in the envelope, substituted each value into the expression, sampled \
one pulse per value, and turned the sweep into a single switch over those \
pulses inside the program. The program is an association, so the question \
\"where is the drive played\" is one ",
 Cell[BoxData["Cases"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd69df2-7b02-a961-15ed-14bc7eb4f84b"],
 " call rather than a search through generated text."
}], "Text",
 CellID->862412655,ExpressionUUID->"768fd558-59bf-0a63-1eb4-cd02584a5949"],

Cell[TextData[{
 "Check that the samples are the expression we wrote: at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26b5396e-c871-0359-4e4a-b14be90451a3"],
 " the ratio of quadrature to in-phase samples must be ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["t", "TI"], "-", "20"}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "25"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f77ebf2-aec9-563c-450c-02bfcb7c3d06"],
 " on the 1 ns grid:"
}], "Text",
 CellID->426217663,ExpressionUUID->"5317ee41-6066-3577-012c-002b11109c5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wf", " ", "=", " ", 
   RowBox[{"dragProg", "[", "\"\<Waveforms\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"wf", "[", "\"\<qubit_drive_wf_3_q\>\"", "]"}], "/", 
      RowBox[{"wf", "[", "\"\<qubit_drive_wf_3\>\"", "]"}]}], " ", "-", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"t", " ", "-", " ", "20"}], ")"}], "/", "25"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "39"}], "}"}]}], "]"}]}], "]"}],
    "]"}], " ", "<", " ", 
  RowBox[{"10", "^", 
   RowBox[{"-", "12"}]}]}]}], "Input",
 CellLabel->"In[148]:= ",
 CellID->128954499,ExpressionUUID->"0454080f-5b74-5a26-2c6b-a2695e01290c"],

Cell[TextData[{
 "Once the sweep has picked ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "200c839f-1e44-fe5c-5033-1ad99bf6c4a6"],
 ", pin the program to that pulse by rewriting the switch into a single play \
with ",
 Cell[BoxData["MapAt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "573cfa27-29ff-38cf-7ec3-f3814f8b8a15"],
 ":"
}], "Text",
 CellID->731716873,ExpressionUUID->"7bb83578-78e8-07f4-2947-ad22789d6dde"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pinned", " ", "=", " ", 
   RowBox[{"MapAt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Head\>\"", " ", "->", " ", "\"\<Play\>\""}], ",", " ", 
        RowBox[{"\"\<Pulse\>\"", " ", "->", " ", 
         RowBox[{"Last", "[", "#Pulses", "]"}]}], ",", " ", 
        RowBox[{"\"\<Element\>\"", " ", "->", " ", "#Element"}], ",", " ", 
        RowBox[{"\"\<AmpExpr\>\"", " ", "->", " ", "None"}], ",", " ", 
        RowBox[{"\"\<DurationExpr\>\"", " ", "->", " ", "None"}], ",", " ", 
        RowBox[{"\"\<Chirp\>\"", " ", "->", " ", "None"}]}], "|>"}], " ", 
      "&"}], ",", "\n", "   ", 
     RowBox[{"dragProg", "[", "\"\<IR\>\"", "]"}], ",", " ", 
     RowBox[{"Position", "[", 
      RowBox[{
       RowBox[{"dragProg", "[", "\"\<IR\>\"", "]"}], ",", " ", 
       RowBox[{"KeyValuePattern", "[", 
        RowBox[{"\"\<Head\>\"", " ", "->", " ", "\"\<SwitchPlay\>\""}], 
        "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Cases", "[", 
  RowBox[{"pinned", ",", " ", 
   RowBox[{"KeyValuePattern", "[", 
    RowBox[{"\"\<Head\>\"", " ", "->", " ", 
     RowBox[{"\"\<Play\>\"", " ", "|", " ", "\"\<SwitchPlay\>\""}]}], "]"}], ",",
    " ", "Infinity"}], "]"}]}], "Input",
 CellLabel->"In[149]:= ",
 CellID->263464368,ExpressionUUID->"48fc1f1f-3652-ba13-7883-975943e40979"],

Cell[TextData[{
 "Every point of the loop now plays the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Beta]", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3cf3ec-7071-038e-3bc3-eab6010451d4"],
 " pulse, the readout and the averaging loop are untouched, and the original \
program is unchanged, since ",
 Cell[BoxData["MapAt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44b6a437-3794-76b8-6c4d-3e7142215c82"],
 " returns a new expression."
}], "Text",
 CellID->519276129,ExpressionUUID->"3e37a26f-afb3-2e6c-67cc-4448ca4674b6"],

Cell["\<\
The CZ Gate from Two Transmons: the {11, 02} Block Derived from the Duffing \
Hamiltonian\
\>", "Section",
 CellID->1441306302,ExpressionUUID->"576120e7-4357-336c-7d1e-b9c176e381b6"],

Cell[TextData[{
 "A flux-tunable transmon pair makes its CZ gate by bringing ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "375ed7c0-a5a4-d638-5d65-ceadcc56bd02"],
 " into resonance with the non-computational state ",
 Cell[BoxData[
  TemplateBox[{"02"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1106a12f-2723-9187-473d-388952d7e3ed"],
 ". Why only ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df9f048-7a44-7b96-3b86-ea127ff149fc"],
 ", and how long must the flux be held? Take two three-level Duffing \
oscillators with frequencies ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Omega]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11feb189-ad07-7b90-4785-28d2c4b249fa"],
 ", anharmonicities ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Alpha]", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74f078bc-d989-92d9-1c80-71f9d83de023"],
 " and an exchange coupling ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "587682b0-1dd8-f3c6-080d-1bfa9452c12c"],
 ", all symbols, and let the algebra reduce the nine-level problem to the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "252e0451-1a36-40ed-4cd5-9e1b9fc31237"],
 " block that is the gate. A numerical tool diagonalizes the nine-level \
matrix at chosen parameter values; here the block comes out with its \
parameters intact."
}], "Text",
 CellID->370920483,ExpressionUUID->"6b506e1e-f100-9568-196f-805b80baffb2"],

Cell[TextData[{
 "Build the pair Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["j", "TI"],
    LimitsPositioning->False], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], 
     StyleBox["j", "TI"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], 
     StyleBox["j", "TI"]], "+", 
    FractionBox[
     SubscriptBox[
      StyleBox["\[Alpha]", "TI"], 
      StyleBox["j", "TI"]], "2"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["n", "TI"], "^"], 
     StyleBox["j", "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["n", "TI"], "^"], 
      StyleBox["j", "TI"]], "-", "1"}], 
    StyleBox[")",
     SpanMaxSize->1]}], "]", "+", 
   StyleBox["g", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "1", "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "2"], "+", 
    SubsuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "2", "\[Dagger]"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "1"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45e6cda3-0332-8806-739d-e40db6c4db6c"],
 " on three levels per transmon:"
}], "Text",
 CellID->1675734937,ExpressionUUID->"10a6fcee-2410-cb5f-405d-f5c84daa99a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ",", " ", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b1", ",", " ", "b2"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"b", ",", " ", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], ",", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", " ", "b"}], "]"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"duffing", "[", 
    RowBox[{"bj_", ",", " ", "\[Omega]_", ",", " ", "\[Alpha]_"}], "]"}], " ",
    ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nj", " ", "=", " ", 
       RowBox[{
        RowBox[{"Transpose", "[", "bj", "]"}], " ", ".", " ", "bj"}]}], "}"}],
      ",", " ", 
     RowBox[{
      RowBox[{"\[Omega]", " ", "nj"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"\[Alpha]", "/", "2"}], " ", 
       RowBox[{"nj", " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{"nj", " ", "-", " ", 
          RowBox[{"IdentityMatrix", "[", "9", "]"}]}], ")"}]}]}]}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"hPair", " ", "=", " ", 
   RowBox[{
    RowBox[{"duffing", "[", 
     RowBox[{"b1", ",", " ", "\[Omega]1", ",", " ", "\[Alpha]1"}], "]"}], " ",
     "+", " ", 
    RowBox[{"duffing", "[", 
     RowBox[{"b2", ",", " ", "\[Omega]2", ",", " ", "\[Alpha]2"}], "]"}], " ",
     "+", " ", 
    RowBox[{"g", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "b1", "]"}], " ", ".", " ", "b2"}], " ", "+",
        " ", 
       RowBox[{
        RowBox[{"Transpose", "[", "b2", "]"}], " ", ".", " ", "b1"}]}], 
      ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nTot", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "b1", "]"}], " ", ".", " ", "b1"}], " ", "+",
       " ", 
      RowBox[{
       RowBox[{"Transpose", "[", "b2", "]"}], " ", ".", " ", "b2"}]}]}], 
    "}"}], ",", " ", 
   RowBox[{
    RowBox[{"hPair", " ", ".", " ", "nTot"}], " ", "==", " ", 
    RowBox[{"nTot", " ", ".", " ", "hPair"}]}]}], "]"}]}], "Input",
 CellLabel->"In[150]:= ",
 CellID->1811399761,ExpressionUUID->"20b3c3fd-ce47-45e5-5040-daa6ebf22fcf"],

Cell[TextData[{
 "The total excitation number commutes with the Hamiltonian, so the \
two-excitation states ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"11"},
    "Ket"], ",", 
   TemplateBox[{"02"},
    "Ket"], ",", 
   TemplateBox[{"20"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd5773b-5215-a52c-3beb-6f6567a10c76"],
 " evolve only among themselves. The flux pulse tunes ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7da02f1b-35d4-9174-2b5f-c745bc66e05e"],
 " to ",
 Cell[BoxData[
  TemplateBox[{"02"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1be4ea81-18b8-2b05-499b-03eb994d766f"],
 " and leaves ",
 Cell[BoxData[
  TemplateBox[{"20"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bec375e-30ea-24bd-5993-af18409c8e87"],
 " detuned, so the gate lives in a two-state block."
}], "Text",
 CellID->417262126,ExpressionUUID->"7dcf5242-c9ff-a686-2bf5-542fef8b0cec"],

Cell[TextData[{
 "Extract the block on ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    TemplateBox[{"11"},
     "Ket"], ",", 
    TemplateBox[{"02"},
     "Ket"]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52da685f-2498-05f2-02f9-82194d2d6fd8"],
 ", with energies measured from ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["E", "TI"], "02"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12aa8adb-4d50-9545-42a9-238564eaffaf"],
 ":"
}], "Text",
 CellID->1077936938,ExpressionUUID->"6bddd79b-6823-400d-19e2-cec509d61357"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pos", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"FromDigits", "[", 
       RowBox[{"#", ",", " ", "3"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"blk", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"hPair", "[", 
     RowBox[{"[", 
      RowBox[{"pos", ",", " ", "pos"}], "]"}], "]"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"hPair", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"pos", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"pos", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}]}]}], "Input",
 CellLabel->"In[151]:= ",
 CellID->181325614,ExpressionUUID->"0292d5cf-fba4-5fb5-32a1-cca8fe51259f"],

Cell[TextData[{
 "The diagonal is the detuning ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "1"], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], "-", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315a5c02-c518-37e9-677a-566fec929d33"],
 ", and the coupling is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "601c6277-b8fa-6d82-1023-8431388f37e8"],
 ", not ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056e5c3e-0591-d839-3316-5678ac25ab03"],
 ": lowering transmon 1 and raising transmon 2 from one to two quanta picks \
up ",
 Cell[BoxData[
  SqrtBox["2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7362f573-955d-4629-2111-ed3d1ce82d73"],
 " from ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["b", "TI"], "^"], "\[Dagger]"], 
    TemplateBox[{"1"},
     "Ket"]}], "=", 
   RowBox[{
    SqrtBox["2"], 
    TemplateBox[{"2"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d4a449b-9aea-2b01-4b4a-5dc51e9f766b"],
 ". In other words, ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "693f6746-f6ea-213d-18c5-7f23829f7007"],
 " has a resonant partner in the second excited level, while the \
one-excitation states ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"01"},
    "Ket"], ",", 
   TemplateBox[{"10"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bbc0e4-f422-75b6-0858-d9c1fdd75f9c"],
 " are coupled by ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "512ebd8c-9517-4b4e-00d5-34d61ca21994"],
 " but detuned by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Alpha]", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38255ff6-675c-bc9f-69db-56b012ee06e5"],
 ", so they only shift by order ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], "2"], "/", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0868aa04-f8be-0db7-3817-4c61f94b579d"],
 ". The two-level block neglects that shift; that asymmetry is what makes the \
phase conditional."
}], "Text",
 CellID->2020910698,ExpressionUUID->"0889c062-717f-f29f-38b6-da4c000bc0e5"],

Cell[TextData[{
 "Flux-tune to the crossing (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "2"], "+", 
   SubscriptBox[
    StyleBox["\[Alpha]", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f19c016-97c3-092d-0526-da5022765877"],
 ") and evolve for a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c809b18-7d36-d224-44bf-134274c0a10e"],
 ":"
}], "Text",
 CellID->661155756,ExpressionUUID->"7167cc0d-03c8-d238-271c-e657b662a102"],

Cell[BoxData[
 RowBox[{"cz", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{"blk", " ", "/.", " ", 
       RowBox[{"\[Omega]1", " ", "->", " ", 
        RowBox[{"\[Omega]2", " ", "+", " ", "\[Alpha]2"}]}]}], ")"}], " ", 
     "t"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[152]:= ",
 CellID->1040242161,ExpressionUUID->"324c55d1-ee3a-374b-6274-4c9a8bcc9d91"],

Cell[TextData[{
 "At resonance the block is ",
 Cell[BoxData[
  RowBox[{
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["g", "TI"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4495e7b4-eb19-1195-6caa-fef18eac63ff"],
 ", so the population swaps ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"11"},
    "Ket"], "\[Rule]", 
   RowBox[{
    TemplateBox[{"02"},
     "Ket"], "\[Rule]", 
    TemplateBox[{"11"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "561855fc-8d4a-f767-7e38-4ca624fcda4d"],
 " at the rate ",
 Cell[BoxData[
  RowBox[{
   SqrtBox["2"], "\[ThinSpace]", 
   StyleBox["g", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc16cd1-dd21-1c76-14fe-859ad4d4675c"],
 ". After one full swap, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "\[Pi]", "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SqrtBox["2"], "\[ThinSpace]", 
    StyleBox["g", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30881872-2ed2-344c-60b7-923c4b649e96"],
 ", the amplitude to remain in ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a6bc82-b4ed-9511-2e5d-35ec3c99fc7b"],
 " is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", "\[Pi]", "=", "-", "1"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15240c0a-58c5-65f1-3cdb-a65459704fdb"],
 " for every ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6874cd6b-f967-cd5b-180b-e534f81397a1"],
 ": the ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16aea7ca-f02c-8fa8-3e55-3e9781ded5f2"],
 " rotation sign of a spinor, which within this block only ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68bcb404-3168-9397-1843-2e6e4002e1fd"],
 " acquires."
}], "Text",
 CellID->758481243,ExpressionUUID->"3074fef3-0190-9aee-600b-f7bdb02ae834"],

Cell[TextData[{
 "Check the ",
 Cell[BoxData[
  TemplateBox[{"11"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5132409c-0c71-a3d8-00c2-59c6a505f122"],
 " sign against QuantumFramework's CZ gate, with the three other diagonal \
entries set to 1 as the two-level block assumes:"
}], "Text",
 CellID->607101385,ExpressionUUID->"65312e6e-5674-5434-0cce-c04863013f1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiagonalMatrix", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", 
     RowBox[{
      RowBox[{"cz", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "/.", " ", 
      RowBox[{"t", " ", "->", " ", 
       RowBox[{"\[Pi]", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", "2", "]"}], " ", "g"}], ")"}]}]}]}]}], "}"}], 
   "]"}], " ", "==", " ", 
  RowBox[{"Normal", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<CZ\>\"", "]"}], "[", "\"\<Matrix\>\"",
     "]"}], "]"}]}]], "Input",
 CellLabel->"In[153]:= ",
 CellID->718676885,ExpressionUUID->"0235daed-fad3-6b5f-33ca-d3b6ff6639a5"],

Cell[TextData[{
 "The Quantum Zeno Effect: an Exceptional Point of the Liouvillian at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c9f7e12-83c1-89ed-64a5-705c3675db37"]
}], "Section",
 CellID->1099629263,ExpressionUUID->"505aa7d0-1afc-86f2-0079-3e9a9e8eecd8"],

Cell[TextData[{
 "A qubit driven at Rabi frequency ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5143f96d-83a3-6ed2-0770-f13736563438"],
 " is measured continuously along ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Sigma]", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0ac860-85ff-08e4-2609-e24a338a5ace"],
 " at strength ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c4a7891-0723-3e0d-544a-71dbb2d78557"],
 ", which on average adds the dephasing ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], 
    StyleBox["\[Rho]", "TI"], 
    SubscriptBox[
     StyleBox["\[Sigma]", "TI"], 
     StyleBox["z", "TI"]], "-", 
    StyleBox["\[Rho]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "567bfdcc-56c6-5358-7e18-f496637321a2"],
 ". Weak watching only damps the Rabi oscillation; strong watching freezes \
the qubit (the quantum Zeno effect). Where does one regime turn into the \
other? A numerical tool computes the spectrum at sampled ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b371d01-a041-5dbe-3acc-956ad1f42784"],
 " and sees the crossover as a kink in a plot. Here ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09dcd030-ee58-59fb-3fe3-ca7d8bed2bc1"],
 " and ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3eb66b53-0a81-4482-664d-831daf342ee8"],
 " stay symbols."
}], "Text",
 CellID->2120979663,ExpressionUUID->"4513a2b6-5679-71cc-7320-3bf0630c4316"],

Cell["Build the Liouvillian and ask for its eigenvalues:", "Text",
 CellID->123468129,ExpressionUUID->"0a5000e8-62c3-6dca-3a6f-99b217763710"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zeno", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"\"\<Liouvillian\>\"", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
         RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}], "}"}], ",", " ", 
        
        RowBox[{"{", "k", "}"}]}], "]"}], "]"}], "[", "\"\<Matrix\>\"", "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"Eigenvalues", "[", "zeno", "]"}]}], "Input",
 CellLabel->"In[154]:= ",
 CellID->513893082,ExpressionUUID->"72376a19-67f8-2d8a-23cc-8c43118d77d0"],

Cell[TextData[{
 "The eigenvalue ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6261e651-652e-b57b-121e-f81b0cd81c41"],
 " is the steady state and ",
 Cell[BoxData[
  RowBox[{"-", "2", 
   StyleBox["k", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02289828-dcb6-ed3d-33d7-1275d540b407"],
 " is the decay of the coherence that the drive does not touch. The other \
two, ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["k", "TI"], "\[PlusMinus]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["k", "TI"], "2"], "-", 
     SuperscriptBox["\[CapitalOmega]", "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e4925e4-2eb0-6ad8-2676-bcce4b453822"],
 ", carry the physics: for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f48fd62-d18c-e56b-6577-f54fe03ecfb1"],
 " they are complex, a Rabi oscillation that the measurement damps; for ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09732abd-5fe3-4802-3f00-c3e759961b68"],
 " they are real, two overdamped rates. They meet at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ab4141e-cc6c-4672-1a4b-8e5be5192d58"],
 "."
}], "Text",
 CellID->1710240506,ExpressionUUID->"0f1d8418-8fb4-2aea-3522-1e422a417830"],

Cell[TextData[{
 "Count independent eigenvectors at the meeting point and, for comparison, at \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "2", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b1b0b32-6c87-d322-2938-a37c0533be08"],
 ":"
}], "Text",
 CellID->1971880122,ExpressionUUID->"0b382293-4179-aaf9-3ac7-bbdd700df8c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MatrixRank", "[", 
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"zeno", " ", "/.", " ", 
      RowBox[{"k", " ", "->", " ", "#"}]}], "]"}], "]"}], " ", "&"}], " ", "/@",
   " ", 
  RowBox[{"{", 
   RowBox[{"\[CapitalOmega]", ",", " ", 
    RowBox[{"2", " ", "\[CapitalOmega]"}]}], "}"}]}]], "Input",
 CellLabel->"In[155]:= ",
 CellID->482876923,ExpressionUUID->"2e8da17c-ff26-3788-56b2-3939fad09dd2"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "\[CapitalOmega]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3669af04-3982-74bb-5e16-476eb8375e81"],
 " the two eigenvectors merge as well as the eigenvalues, so the Liouvillian \
cannot be diagonalized there. In other words, the crossover is an exceptional \
point, not a mere degeneracy."
}], "Text",
 CellID->257955902,ExpressionUUID->"28fe05af-1890-3d45-5885-9c09992a87af"],

Cell["\<\
Expand the slower of the two real rates for strong measurement:\
\>", "Text",
 CellID->1595709984,ExpressionUUID->"01001107-76e3-9dfc-373f-89610297e7c6"],

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "k"}], " ", "+", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"k", "^", "2"}], " ", "-", " ", 
      RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "Infinity", ",", " ", "1"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[156]:= ",
 CellID->1806165637,ExpressionUUID->"524d5b64-939d-9e2e-0273-534e2629e574"],

Cell[TextData[{
 "The slowest relaxation rate falls as ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bbb36c0-925a-ccd2-6958-afaa27ec9638"],
 ": past the exceptional point, measuring harder makes the qubit move more \
slowly, which is the Zeno effect."
}], "Text",
 CellID->1730622717,ExpressionUUID->"1a695b16-67b9-69b9-4a17-5350124c3b83"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (July 2, 2026)",
