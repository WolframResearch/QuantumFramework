Cell[TextData[{
 "A ",
 Cell[BoxData["PauliStabilizer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fee4e15-659c-ade9-3596-605f0c2ef733"],
 " returns, the state held as the three cluster generators that fix it. Now \
expand that tableau back into an exact state, that is, solve ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["i", "TI"]], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "=", 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f99faa1-7599-adaa-15a6-f30b7c2df7f0"],
 " for the unique joint ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c80f068-193e-1d5a-14bf-ea3298cb67a0"],
 " eigenstate of the three generators:"
}], "Text",ExpressionUUID->"77601adb-bf25-4789-1d1f-93853ad02dd3"],

