Cell["\<\
Read Bob's Bloch vector, the partial trace discarding Alice's two qubits and \
the two records, the four wires before Bob's:\
\>", "Text",ExpressionUUID->"27c3fefb-2ee6-8038-4df0-f7a54a90d302"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"QuantumPartialTrace", "[", 
     RowBox[{"out", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
     "]"}], "[", "\"\<BlochVector\>\"", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Phi]", " ", "\[Element]", " ", "Reals"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"60d4995f-bb7f-b80c-10eb-11193e0b0b56"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
   RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994895358483079*^9},
 CellLabel->"Out[99]=",ExpressionUUID->"9e486413-8cd5-4048-b01b-a58c447b6429"]
}, Open  ]],

Cell[TextData[{
 "Bob's Bloch vector returns as the same ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["(",
      FontSize->1.2 Inherited], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 ", identically in ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5561d787-26b0-8d0a-031e-cee1534ad450"],
 ": every pure state teleports exactly, the recovered state equals the input, \
with the classical channel carried as record wires inside the object rather \
than eliminated."
}], "Text",ExpressionUUID->"0fea91e8-e80e-a1ed-35e9-08b589b8f337"]
}, Closed]],

Cell[CellGroupData[{

Cell["A coherent error, digitized and corrected", "Subsection",ExpressionUUID->"37725419-c8bf-c4cd-5d02-4e42e94bae17"],

Cell[TextData[{
 "The three-qubit repetition code encodes ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    TemplateBox[{"0"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    TemplateBox[{"1"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eee5857-8f9d-bf63-1696-52112a290249"],
 " as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    TemplateBox[{"000"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    TemplateBox[{"111"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2635f536-2fc9-ab3c-4fca-ed704a7df606"],
 " and protects it against bit flips. The subtlety is that real errors are \
not discrete flips; here the error is a coherent rotation ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3760e9-4a32-92b2-4acd-79b36fc4e098"],
 " on the middle qubit, between no error (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 ") and a full flip (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cf5d11-52cc-ddbb-47f5-555b677ea781"],
 "). The founding theorem of error correction states that measuring the \
syndrome digitizes this continuous error into those two discrete cases, shown \
here symbolically."
}], "Text",ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell[TextData[{
 "First the syndrome measurement. The parity ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Z", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],
 " must be measured without learning anything else about the state: a \
degenerate projective measurement with two rank-two projectors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "\[PlusMinus]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "\[PlusMinus]", 
    StyleBox["Z", "TI"], "\[CircleTimes]", 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd66644-13e4-6fa7-15ee-782ea591358d"],
 ", which is precisely what ",
 Cell[BoxData["QuantumMeasurementOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00abf1cf-696b-3507-30a8-e8a9081f9c6d"],
 " accepts as a list of projectors. First the single-qubit identity:"
}], "Text",ExpressionUUID->"03d898fe-d35a-9eef-31e7-11bbe6ece435"],

Cell[BoxData[
 RowBox[{
  RowBox[{"id2", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell[TextData[{
 "The two-qubit parity operator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Z", "TI"], "\[CircleTimes]", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de38b79-ee67-8bee-7b90-23228b13d934"],
 ":"
}], "Text",ExpressionUUID->"347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],

Cell[BoxData[
 RowBox[{
  RowBox[{"zz", " ", "=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], ",", " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],

Cell[TextData[{
 "The syndrome measurement on a pair of qubits, the two rank-two projectors \
",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], "\[PlusMinus]"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["I", "TI"], "\[PlusMinus]", 
    StyleBox["Z", "TI"], "\[CircleTimes]", 
    StyleBox["Z", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 ":"
}], "Text",ExpressionUUID->"6c340229-13f4-0181-15cb-a473a58153eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"syn", "[", 
    RowBox[{"q1_", ",", " ", "q2_"}], "]"}], " ", ":=", " ", 
   RowBox[{"QuantumMeasurementOperator", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"id2", ",", " ", "id2"}], "]"}], " ", "+", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"QuantumOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"id2", ",", " ", "id2"}], "]"}], " ", "-", " ", "zz"}], 
           ")"}], "/", "2"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q1", ",", " ", "q2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"25dfa134-0866-9bb5-53e4-397ea910e99f"],

Cell[TextData[{
 "Then the full code: encode, inflict the coherent error, measure both \
parities, and decode each of the four syndrome patterns into its correction. \
The decoder is three feedforward gates with mixed polarities, ",
 Cell[BoxData[
  RowBox[{"\"\<C\>\"", "[", 
   RowBox[{"\"\<X\>\"", ",", " ", "ones", ",", " ", "zeros"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425139cc-45a5-cefb-726e-b0966c5194c1"],
 " conditions an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d922994-f334-45bb-7ba1-c0d186c12f81"],
 " on some records reading ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c25578-1780-b25e-2ef2-4d22a23a00a4"],
 " and others reading ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f70617e-b140-9f95-0500-793bc0fae5ff"],
 ". First the encoder:"
}], "Text",ExpressionUUID->"79d0371a-30a6-04e5-2fef-af4441536ecf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"enc", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<CNOT\>\"", " ", ",", " ", 
      RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}]}], "}"}], ",", "\n", "   ", 
    RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Encode\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"7d950d76-dd18-2b24-2baa-a533d4ad760e"],

