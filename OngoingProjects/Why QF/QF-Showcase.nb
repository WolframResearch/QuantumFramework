       LineBox[{{1., -0.625}, {1., -0.2109375}}], 
       {RGBColor[0.537254, 0.537254, 0.537254], AbsoluteThickness[1], Opacity[
        0.3], CapForm[None], LineBox[{{1., 0}, {1.375, 0}}]}}, 
      {EdgeForm[{RGBColor[0.537254, 0.537254, 0.537254], Opacity[0.3]}], 
