Cell[CellGroupData[{

Cell[TextData[{
 "Operator calculus: recover ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c7820da-3afe-8c15-5407-b984be88d77f"],
 " from a target ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "491026a6-dd30-329c-7f2f-bf03d4ca80e6"]
}], "Subsection",ExpressionUUID->"78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"],

Cell[TextData[{
 "Claim 1 solved Hamiltonians forward into their propagators; the inverse is \
pure operator calculus. Choose a unitary trajectory ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "295a1104-8f0a-9295-5f79-896e2abce0ff"],
 ", and the Hamiltonian that drives it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], " ", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e49fcf-314b-942d-5c9b-16a940ffff77"],
 ", the basis of counterdiabatic driving and shortcuts to adiabaticity. \
Compose the target ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28081ee1-9923-6846-5837-97cb18d63aac"],
 " from named gates:"
}], "Text",ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"],

