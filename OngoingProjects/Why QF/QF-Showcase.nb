  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}], "-", 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " returns identically zero in the symbolic ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0971a20b-7913-467e-3f0e-445578a62d44"],
 " (the truncation-edge amplitude excluded): the defining equation, verified \
for the whole family of coherent states at once."
}], "Text",ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[TextData[{
 "The property that earns these states the name \"most classical states of \
light\" is dynamical: under the oscillator Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   StyleBox["\[Omega]", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    FractionBox["1", "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],
 " a coherent state remains a coherent state, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["H", "TI"], 
      StyleBox["t", "TI"]}]], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      StyleBox["i", "TI"], 
      StyleBox["\[Omega]", "TI"], 
      StyleBox["t", "TI"], "/", "2"}]], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Alpha]", "TI"], 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
           StyleBox["i", "TI"], 
           StyleBox["\[Omega]", "TI"], 
           StyleBox["t", "TI"]}]]}]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
 ", its label ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"],
 " rotating about the origin of phase space at frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
 ", like a classical oscillator amplitude, up to the overall phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41c6bfc6-0792-5005-77fd-36a0b227236f"],
 ". Compute the oscillator propagator with ",
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62752e4e-571f-d961-120a-c02862aba84b"],
 ", symbolically:"
}], "Text",ExpressionUUID->"34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"uosc", " ", "=", " ", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{
    RowBox[{"\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"aOp", "[", "\"\<Dagger\>\"", "]"}], " ", "@", " ", "aOp"}], 
       " ", "+", " ", 
       RowBox[{"1", "/", "2"}]}], ")"}]}], ",", " ", "None", ",", " ", "t"}], 
   "]"}]}]], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"166277e1-e8de-815f-3e12-6eca8968d3a5"],

