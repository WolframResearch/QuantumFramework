Cell[TextData[{
 "Now ",
 Cell[BoxData[
  RowBox[{"op", "[", 
   RowBox[{"g", ",", " ", "t"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 " is the Landau-Zener propagator at adiabaticity ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc1606-c22d-409d-5f43-8863f7d812e7"],
 " and time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 ", evaluated numerically on demand."
}], "Text",ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[TextData[{
 "The survival is the probability of staying in the diabatic ground state ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 " across the sweep. Propagate ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 " from well before the crossing at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "-", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " to time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["t", "TI"], ",", 
    RowBox[{"-", "10"}]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["op",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["g", "TI"], ",", 
    StyleBox["t", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], " ", 
   StyleBox["op",
    FontSlant->"Plain"], 
   SuperscriptBox[
    RowBox[{
     StyleBox["[",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["g", "TI"], ",", 
      RowBox[{"-", "10"}]}], 
     StyleBox["]",
      SpanMaxSize->1]}], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 ", and read off ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      TemplateBox[{"0", 
        RowBox[{
          StyleBox["\[Psi]", "TI"], 
          StyleBox["(", SpanMaxSize -> 1], 
          StyleBox["t", "TI"], 
          StyleBox[")", SpanMaxSize -> 1]}]},
       "BraKet"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 ":"
}], "Text",ExpressionUUID->"585a51e6-774f-2dd2-087a-48c002fa7738"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "survival", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"survival", "[", 
    RowBox[{"g_", ",", " ", "t_"}], "]"}], " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"op", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"-", "10"}]}], "]"}], "[", "\"\<Dagger\>\"", "]"}], "[", 
        "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], 
           "[", "\"\<Dagger\>\"", "]"}], "@", 
          RowBox[{
           RowBox[{"op", "[", 
            RowBox[{"g", ",", " ", "t"}], "]"}], "[", "c", "]"}]}], ")"}], 
        "[", "\"\<Scalar\>\"", "]"}], "]"}], "^", "2"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"survival", "[", 
   RowBox[{"g", ",", " ", "t"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 " is now a closed-form function of adiabaticity and time, assembled entirely \
by composing QF objects, without a differential solver."
}], "Text",ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[TextData[{
 "Take three regimes: a fast (diabatic) sweep, an intermediate one, and a \
slow (adiabatic) sweep, set by the single ratio ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]", "2"], "/", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 ":"
}], "Text",ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratios", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", " ", "0.6", ",", " ", "1.6"}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[TextData[{
 "Plot the survival across the crossing for each, with the asymptotic \
Landau-Zener formula ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", "\[Pi]", 
    SuperscriptBox["\[CapitalDelta]", "2"], "/", "2", 
    StyleBox["v", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 " drawn as dashed lines:"
}], "Text",ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"survival", "[", 
       RowBox[{"g", ",", " ", "t"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "ratios"}], "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], ",", "\n", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time  t  (avoided crossing at t = 0)\>\"", ",", "\n", 
      "        ", "\"\<Survival  |\[LeftAngleBracket]0|\[Psi](t)\
\[RightAngleBracket]|^2\>\""}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalDelta]\.b2/v = 0.1  (diabatic)\>\"", ",", 
        " ", "\"\<0.6  (intermediate)\>\"", ",", "\n", 
        "    ", "\"\<1.6  (adiabatic)\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.78", ",", " ", "0.6"}], "}"}]}], "]"}]}], ",", "\n", "    ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Gray", ",", " ", "Dashed", ",", " ", 
      RowBox[{"Sequence", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "10"}], ",", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "Pi"}], " ", 
                 RowBox[{"#", "/", "2"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"10", ",", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "Pi"}], " ", 
                 RowBox[{"#", "/", "2"}]}], "]"}]}], "}"}]}], "}"}], "]"}], 
          " ", "&"}], " ", "/@", " ", "ratios"}], ")"}]}]}], "}"}]}], ",", 
   "\n", "    ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0", "}"}], ",", " ", "None"}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[25]:=",ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

