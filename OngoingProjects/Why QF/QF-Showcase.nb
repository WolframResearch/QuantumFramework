                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"2.`", ",", "2.`"}], "]"}]}], ")"}]}], "+", 
                    SqrtBox[
                    RowBox[{
                    RowBox[{"4.`", " ", 
                    SuperscriptBox["2.718281828459045`", 
                    RowBox[{"t", " ", "\[Gamma]1"}]], " ", 
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"1.`", ",", "2.`"}], "]"}], " ", 
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"2.`", ",", "1.`"}], "]"}]}], "+", 
                    RowBox[{"4.`", " ", 
                    SuperscriptBox["2.718281828459045`", 
                    RowBox[{"4.`", " ", "t", " ", "\[Gamma]\[Phi]"}]], " ", 
                    SuperscriptBox[
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"2.`", ",", "2.`"}], "]"}], "2"]}], "-", 
                    RowBox[{"4.`", " ", 
                    SuperscriptBox["2.718281828459045`", 
                    RowBox[{"t", " ", 
                    RowBox[{"(", 
                    RowBox[{"\[Gamma]1", "+", 
                    RowBox[{"4.`", " ", "\[Gamma]\[Phi]"}]}], ")"}]}]], " ", 
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"2.`", ",", "2.`"}], "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"1.`", ",", "1.`"}], "]"}], "+", 
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"2.`", ",", "2.`"}], "]"}]}], ")"}]}], "+", 
                    RowBox[{
                    SuperscriptBox["2.718281828459045`", 
                    RowBox[{"2.`", " ", "t", " ", 
                    RowBox[{"(", 
                    RowBox[{"\[Gamma]1", "+", 
                    RowBox[{"2.`", " ", "\[Gamma]\[Phi]"}]}], ")"}]}]], " ", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"1.`", ",", "1.`"}], "]"}], "+", 
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"2.`", ",", "2.`"}], "]"}]}], ")"}], "2"]}]}]]}], 
                    ")"}]}]}], ")"}]}], 
                    RowBox[{
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"1.`", ",", "1.`"}], "]"}], "+", 
                    RowBox[{"\[Rho]", "[", 
                    RowBox[{"2.`", ",", "2.`"}], "]"}]}]], "\"b\"", "bits", 
                    "\"Bits\""}, "Quantity", SyntaxForm -> Mod], 
                  "SummaryItem"]}], 
               RowBox[{
                 TagBox["\"Dimensions: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  TemplateBox[{
                    RowBox[{"{", "}"}], "\"\[RightArrow]\"", 
