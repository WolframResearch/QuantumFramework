Cell["\<\
Read it at two representative points, the origin and half a fringe away in \
momentum:\
\>", "Text",ExpressionUUID->"5782d92f-a790-094a-7db1-d088d2255b90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"wigner", "[", 
    RowBox[{"0", ",", " ", "0"}], "]"}], ",", " ", 
   RowBox[{"wigner", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"1", "/", "2"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"05d48452-325d-a277-33eb-1e1c47e9f15d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.3182373522252574`", ",", 
   RowBox[{"-", "0.23563771177327064`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9948953558751373`*^9},
 CellLabel->"Out[69]=",ExpressionUUID->"95c08cc5-e4dd-4eda-816f-27960318e158"]
}, Open  ]],

Cell[TextData[{
 "The first value is positive, the second negative. The first is the \
important one: at the midpoint between the two coherent components, where a \
classical mixture of them would place almost no weight, the Wigner function \
instead has its strongest feature, an interference peak that reaches the \
ceiling ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 " that no Wigner function can exceed. The even cat is a parity eigenstate, \
so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["W", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "0"}], 
   StyleBox[")",
    SpanMaxSize->1], "=", "1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 " exactly (here up to the Fock truncation), not merely close to it; the \
neighboring fringe is firmly negative."
}], "Text",ExpressionUUID->"5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],

Cell[TextData[{
 "The Wigner function is one of a family of phase-space quasi-probabilities, \
and its smoothed counterpart removes the negativity. The Husimi-",
 Cell[BoxData[
  StyleBox["Q", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d0df906-1ebb-1081-5b32-f1609b4e62eb"],
 " function ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["Q", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    FractionBox["1", "\[Pi]"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Bra"], 
    StyleBox["\[Rho]", "TI"], 
    TemplateBox[{
      StyleBox["\[Alpha]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519a4e0d-3467-bfb9-07ba-6057bd130583"],
 ", with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], "+", 
    StyleBox["i", "TI"], 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a891815-8c00-cf41-6ab6-925f25ba95ab"],
 ", is the Wigner function convolved with a coherent-state Gaussian; that \
smoothing makes it non-negative everywhere, at the cost of removing the \
nonclassicality the Wigner reveals. Build it over the same window, slightly \
taller in ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dbacffa-31b0-43f6-3b59-e6a4404511dc"],
 " since the Husimi is wider:"
}], "Text",ExpressionUUID->"196a859c-b643-c1b3-4f69-1cd9c3f79399"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"husimi", " ", "=", " ", 
  RowBox[{"HusimiQRepresentation", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"CatState", "[", "]"}], "[", 
     RowBox[{"2", ",", " ", "0"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "90"}]}], "]"}]}]], "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],

