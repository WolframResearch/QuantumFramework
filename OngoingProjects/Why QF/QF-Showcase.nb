         Sin[Rational[1, 2] Conjugate[$CellContext`t]]), 
       Complex[0, 1] (
        E^(Complex[0, Rational[1, 2]] Conjugate[$CellContext`t]^2) 
         Cos[Rational[1, 2] Conjugate[$CellContext`t]] (
          Complex[0, Rational[-1, 2]] 
