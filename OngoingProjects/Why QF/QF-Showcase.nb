Cell[TextData[{
 "The eight bars return with magnitudes tracing an interference comb, a clean \
null at ",
 Cell[BoxData[
  TemplateBox[{"100"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9c4f1f-9707-8ca1-29a4-675922b3d68b"],
 ", and the surviving bars tinted by a wheel of distinct phase colors keyed \
by the legend: the QFT's phase ramp made visible alongside the magnitudes, \
the full complex state in one figure."
}], "Text",ExpressionUUID->"0839f778-d15e-09ff-39c6-ef25e0eb5bc5"]
}, Closed]],

Cell[CellGroupData[{

Cell["A measurement draws its statistics", "Subsection",ExpressionUUID->"7962e333-0c57-77b8-2f11-fb7da5e25d82"],

Cell[TextData[{
 "A ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],
 " object charts its own outcome distribution, the Born probabilities ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["x", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         StyleBox["x", "TI"], 
         StyleBox["\[Psi]", "TI"]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7517e465-645e-477c-232c-fe4f0deb2a46"],
 ". Run the Bernstein-Vazirani circuit for a hidden string ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "=", "1011"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560e68d9-da1a-2272-7e35-8182dfaf7158"],
 ", a single oracle query that encodes ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46aa8ea3-37c3-4040-6ea9-270d427612aa"],
 " in the interference pattern, and let it draw the statistics of its own \
final measurement:"
}], "Text",ExpressionUUID->"6acb7fb5-f6da-6094-1ac9-76fe836f32fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", "\n", "   ", 
    RowBox[{"\"\<BernsteinVazirani\>\"", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}], 
     "]"}], "]"}], "[", "]"}], "[", 
  RowBox[{"\"\<ProbabilitiesPlot\>\"", ",", " ", "\n", " ", 
   RowBox[{"\"\<LabelsAngle\>\"", " ", "->", " ", 
    RowBox[{"90", " ", "Degree"}]}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"7a5ec95d-e220-f105-2a65-e10697dac06f"],

