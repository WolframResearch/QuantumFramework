Cell[TextData[{
 "Simulate ",
 Cell[BoxData["2000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e8dec7-14b1-519a-7c97-d7a19d4423e0"],
 " measurement shots in each of the three Pauli bases (seeded for \
reproducibility):"
}], "Text",ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data", " ", "=", " ", 
   RowBox[{"QuantumMeasurementSimulation", "[", 
    RowBox[{"true", ",", " ", 
     RowBox[{"QuantumMeasurementOperator", " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<X\>\"", ",", " ", "\"\<Y\>\"", ",", " ", "\"\<Z\>\""}], 
       "}"}]}], ",", " ", "2000"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"6dbbd446-5835-e39a-1b58-ce2059c1b1e0"],

Cell["Look at the raw counts:", "Text",ExpressionUUID->"6d34e655-b983-17e8-14cb-f81f38367d32"],

