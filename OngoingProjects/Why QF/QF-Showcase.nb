Cell["Assemble the zero-field-splitting Hamiltonian from them:", "Text",ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hzfs", " ", "=", " ", 
  RowBox[{
   RowBox[{"2", " ", "\[FormalD]", " ", 
    RowBox[{"jz", "^", "2"}]}], " ", "+", " ", 
   RowBox[{"\[FormalE]", " ", 
