Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Omega]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Omega]0", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[CapitalOmega]", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"t", " ", "\[Element]", " ", "Reals"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{"Abs", "[", "amp", "]"}], "^", "2"}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{
      FractionBox["1", "2"], " ", "t", " ", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["\[CapitalOmega]", "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]", "-", "\[Omega]0"}], ")"}], "2"]}]]}], "]"}], 
    "2"]}], 
  RowBox[{
   SuperscriptBox["\[CapitalOmega]", "2"], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"\[Omega]", "-", "\[Omega]0"}], ")"}], "2"]}]]], "Output",
 CellChangeTimes->{3.994895266411086*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"5db2e3e8-0039-4f77-8f2a-69d419496023"]
}, Open  ]],

Cell[TextData[{
 "The result is the textbook Rabi formula, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["P", "TI"], 
    RowBox[{"0", "\[Rule]", "1"}]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    SuperscriptBox["\[CapitalOmega]", "2"], 
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Delta]", "TI"], "2"]}]], " ", 
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox[
    StyleBox["t", "TI"], "2"], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Delta]", "TI"], "2"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f449897-1a0e-51e7-357b-11d19fbb23cd"],
 ". On resonance (",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Omega]", "TI"], "=", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 ") this is ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"\[CapitalOmega]", 
    StyleBox["t", "TI"], "/", "2"}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 ": complete Rabi flopping between ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"1"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 ". The oscillation rate ",
 Cell[BoxData[
  SqrtBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "+", 
    SuperscriptBox[
     StyleBox["\[Delta]", "TI"], "2"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 " is the generalized Rabi frequency, the dressed-state gap in the rotating \
frame, here recovered as a closed-form function of the drive detuning and \
strength."
}], "Text",ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"]
}, Closed]],

Cell[CellGroupData[{

Cell["When the closed form needs special functions: Landau-Zener", \
"Subsection",ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"],

Cell[TextData[{
 "The rotating-field propagator was elementary, but symbolic evolution is not \
limited to elementary functions. Sweep the energy bias linearly through an \
avoided crossing at rate ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " with a constant gap ",
 Cell[BoxData["\[CapitalDelta]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 ": the Landau-Zener model ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    StyleBox[
     RowBox[{"v", "t"}], "TI"], "2"], " ", 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalDelta]", "2"], " ", 
   StyleBox["X", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 ", which asks whether a system swept through a level crossing stays in its \
energy branch or crosses the gap. It is again time-dependent and \
non-commuting:"
}], "Text",ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hlz", " ", "=", " ", 
  RowBox[{
   RowBox[{"v", " ", 
    RowBox[{"t", "/", "2"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", "/", "2"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}]}]}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

