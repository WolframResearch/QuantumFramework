  "Out[148]=",ExpressionUUID->"3e376be5-bb1e-4242-bb53-832b545f0998"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133f88c9-4e43-c7a8-42c4-21936bf7adf2"],
 ": ",
