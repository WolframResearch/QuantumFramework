           Cos[Rational[1, 2] $CellContext`t] + 
          Rational[-1, 2] E^(Complex[0, Rational[-1, 2]] $CellContext`t^2) 
           Sin[Rational[1, 2] $CellContext`t]) + 
        Complex[0, 1] 
         E^(Complex[0, Rational[1, 2]] Conjugate[$CellContext`t]^2) (
          Complex[0, Rational[-1, 2]] 
           E^(Complex[0, Rational[-1, 2]] $CellContext`t^2) 
           Cos[Rational[1, 2] $CellContext`t] - 
          E^(Complex[0, Rational[-1, 2]] $CellContext`t^2) $CellContext`t 
          Sin[Rational[1, 2] $CellContext`t]) 
         Sin[Rational[1, 2] Conjugate[$CellContext`t]]), 
       Complex[0, 1] (
        E^(Complex[0, Rational[-1, 2]] Conjugate[$CellContext`t]^2) 
         Cos[Rational[1, 2] Conjugate[$CellContext`t]] (
