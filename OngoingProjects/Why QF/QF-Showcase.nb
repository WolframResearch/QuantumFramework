Cell[TextData[{
 "The operator is fully symbolic, and its matrix is displayed in the basis \
the algebra carried with it, the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 " eigenbasis: the couplings remain symbols, and the coordinates remain \
attached to the object."
}], "Text",ExpressionUUID->"30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],

Cell[TextData[{
 "A Hamiltonian is simplest in its energy eigenbasis, and the operator \
provides its own eigenvectors. Build a basis from them and read ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 " there:"
}], "Text",ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"QuantumOperator", "[", 
      RowBox[{"hzfs", ",", " ", 
       RowBox[{"QuantumBasis", "[", 
        RowBox[{"hzfs", "[", "\"\<Eigenvectors\>\"", "]"}], "]"}]}], "]"}], 
     "[", "\"\<Matrix\>\"", "]"}], " ", "//", " ", "Normal"}], " ", "//", " ",
    "FullSimplify"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.994895559906424*^9, 3.994895561635454*^9}},
 CellLabel->
  "In[167]:=",ExpressionUUID->"138e1639-4d05-8b97-41b5-886364b1d9fd"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "0", "0"},
     {"0", 
      RowBox[{
       RowBox[{"2", " ", "\[FormalD]"}], "-", "\[FormalE]"}], "0"},
     {"0", "0", 
      RowBox[{
       RowBox[{"2", " ", "\[FormalD]"}], "+", "\[FormalE]"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.994895356818231*^9, 3.994895561939782*^9},
 CellLabel->
  "Out[167]//MatrixForm=",ExpressionUUID->"25c6f299-fea7-45eb-82fe-\
0895833fa370"]
}, Open  ]],

Cell[TextData[{
 "The matrix returns exactly as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["diag",
      FontSlant->"Plain"], 
     StyleBox["(",
      FontSize->1.2 Inherited], "0"}], ",", " ", 
    RowBox[{
     RowBox[{"2", 
      StyleBox["d", "TI"]}], "-", 
     StyleBox["e", "TI"]}], ",", " ", 
    RowBox[{
     RowBox[{"2", 
      StyleBox["d", "TI"]}], "+", 
     StyleBox["e", "TI"]}]}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 ": the zero-field-split spectrum in closed form, symbols intact. Building a \
basis from an object's own eigenvectors works in any dimension, and the spin-",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 " operators are provided natively for every ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ff5c08-e081-ff27-4e85-56559135c20d"],
 "."
}], "Text",ExpressionUUID->"07c988c4-3ef2-8066-2df6-21aeba84d34c"],

Cell[TextData[{
 "Dimension need not be a power of two either. A particle hopping on an ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],
 "-site ring lives in an ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 "-dimensional Hilbert space, here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
 ", with the tight-binding Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   RowBox[{"-", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{
       StyleBox["j", "TI"], "=", "1"}], 
      StyleBox["N", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      StyleBox["(",
       FontSize->1.2 Inherited], 
      RowBox[{
       RowBox[{
        TemplateBox[{
          StyleBox["j", "TI"]},
         "Ket"], 
        TemplateBox[{
          RowBox[{
            StyleBox["j", "TI"], "+", "1"}]},
         "Bra"]}], "+", 
       RowBox[{
        TemplateBox[{
          RowBox[{
            StyleBox["j", "TI"], "+", "1"}]},
         "Ket"], 
        TemplateBox[{
          StyleBox["j", "TI"]},
         "Bra"]}]}], 
      StyleBox[")",
       FontSize->1.2 Inherited]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab8b877-e011-189c-2a47-323091a46ae6"],
 ", site ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35eb0178-2238-e094-63e8-992257b2b2fe"],
 " identified with site ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0da6433d-a7a4-ba24-3b5e-5b66d256090e"],
 ". Fix the ring size:"
}], "Text",ExpressionUUID->"462f64f6-435d-c7dd-6fd5-7db076e9ad27"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", " ", "=", " ", "5"}], ";"}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"4b06bf63-5f43-ed7c-793d-374d5af7b446"],

Cell[TextData[{
 "Build the hopping matrix, ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd1c247-21a4-d962-35ee-e4215056a848"],
 " for every pair of neighboring sites:"
}], "Text",ExpressionUUID->"09347675-9fce-c17b-38cc-683f1a789041"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ring", " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Boole", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"i", " ", "-", " ", "j"}], ",", " ", "n"}], "]"}], " ", "==",
          " ", "1"}], " ", "||", " ", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"j", " ", "-", " ", "i"}], ",", " ", "n"}], "]"}], " ", "==",
          " ", "1"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "n"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

Cell["Look at it in the site basis:", "Text",ExpressionUUID->"66c4d8d6-27c8-a0db-0efb-d1905262f221"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ring", " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"4d3801b6-8b23-0df3-74c7-98f02ed657d9"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      RowBox[{"-", "1"}], "0", "0", 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"-", "1"}], "0", 
      RowBox[{"-", "1"}], "0", "0"},
     {"0", 
      RowBox[{"-", "1"}], "0", 
      RowBox[{"-", "1"}], "0"},
     {"0", "0", 
      RowBox[{"-", "1"}], "0", 
      RowBox[{"-", "1"}]},
     {
      RowBox[{"-", "1"}], "0", "0", 
      RowBox[{"-", "1"}], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
