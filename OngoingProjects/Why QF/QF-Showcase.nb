Cell[BoxData[
 RowBox[{"Values", "[", "data", "]"}]], "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"5c435daa-0d1c-c5df-0471-54f4a4aeaf25"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1605", ",", "395"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1620", ",", "380"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1504", ",", "496"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994895357542921*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"bfbf36d7-43ca-4454-b8b3-5b28aa081122"]
}, Open  ]],

Cell["\<\
Three pairs of counts return, one per basis: multinomially sampled tallies \
scattered around the Born-rule proportions, different on every fresh sample, \
and all a real experiment ever sees.\
\>", "Text",ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"],

Cell["\<\
Now pass the counts to the estimator, which performs linear inversion \
followed by maximum-likelihood:\
\>", "Text",ExpressionUUID->"74ff421b-073b-c6d4-1c85-6445b2cfac3e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"est", " ", "=", " ", 
  RowBox[{"QuantumStateEstimate", "[", "data", "]"}]}]], "Input",
 CellLabel->"In[91]:=",ExpressionUUID->"3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"],

