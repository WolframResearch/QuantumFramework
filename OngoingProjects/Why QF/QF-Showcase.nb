Cell["\<\
The Husimi is close to zero there, in contrast to the Wigner's sharp peak: \
the Gaussian average has cancelled the oscillating fringes. Plot the two \
surfaces side by side:\
\>", "Text",ExpressionUUID->"056fda38-a5bc-2884-3314-dc65cc497aee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\n", "   ", 
   RowBox[{
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"wigner", "[", 
       RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
      RowBox[{"Mesh", " ", "->", " ", "None"}], ",", "\n", "     ", 
      RowBox[{"PlotPoints", " ", "->", " ", "50"}], ",", " ", 
      RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",", 
      "\n", "     ", 
      RowBox[{"AxesLabel", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", " ", "\"\<p\>\"", ",", " ", "\"\<W\>\""}], 
        "}"}]}], ",", " ", 
      RowBox[{"PlotLabel", " ", "->", " ", "\"\<Wigner W(x,p)\>\""}], ",", 
      " ", 
      RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}], ",", "\n", 
    "   ", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"husimi", "[", 
       RowBox[{"x", ",", " ", "p"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", 
        RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
