Cell[TextData[{
 "Solve the master equation for a qubit with level splitting ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 ", energy relaxation at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 " (jump operator ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"]], " ", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "-"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 "), and pure dephasing at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], 
   StyleBox["\[Phi]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 " (jump operator ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], 
     StyleBox["\[Phi]", "TI"]]], " ", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67f13035-938c-831a-0d8e-aa7f263eee60"],
 "):"
}], "Text",ExpressionUUID->"16b44e14-0404-e868-3e4c-605eadb6bab2"],

