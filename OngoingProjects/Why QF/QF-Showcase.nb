Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{
        RowBox[{"-", "2"}], " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "J", " ", "t"}], "]"}], "2"], " ", 
        RowBox[{"Log", "[", 
          SuperscriptBox[
           RowBox[{"Cos", "[", 
             RowBox[{"2", " ", "J", " ", "t"}], "]"}], "2"], "]"}]}], "+", 
      RowBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{"Cos", "[", 
              RowBox[{"4", " ", "J", " ", "t"}], "]"}]}], ")"}], " ", 
        RowBox[{"Log", "[", 
          SuperscriptBox[
           RowBox[{"Sin", "[", 
             RowBox[{"2", " ", "J", " ", "t"}], "]"}], "2"], "]"}]}]}], 
    RowBox[{"Log", "[", "4", "]"}]], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{3.994895347887991*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"f00e55e7-be8a-4d0b-bc3a-007e2924d9b8"]
}, Open  ]],

Cell[TextData[{
 "QF returns the entire curve as a formula in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 " and ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 ": the binary entropy of the two oscillating populations, zero whenever the \
state is a product, a full bit at the Bell points, periodic with the exchange \
oscillation. Because it is a formula, it can be differentiated, expanded, or \
solved in closed form, and the same approach extends to larger symbolic spin \
chains."
}], "Text",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "Plot it (at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 "):"
}], "Text",ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"s", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{"J", " ", "->", " ", "1"}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time  J t\>\"", ",", 
      " ", "\"\<entanglement entropy  S(t)  [bits]\>\""}], "}"}]}], ",", " ", 
   
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

