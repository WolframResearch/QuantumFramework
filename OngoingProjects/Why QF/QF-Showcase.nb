Cell["No qubit index was written by hand.", "Text",ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[TextData[{
 "The cost landscape is the expectation ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 ", and here QF uses a feature worth stating explicitly: a ",
 Cell[BoxData["QuantumCircuitOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 " can hold states as elements. Composing the prep circuit (the ket), the \
operator ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["H", "TI"], 
   StyleBox["C", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 ", and the prep circuit's ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Dagger\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af863a9-1098-c609-1a98-7af3a112ad53"],
 " (the bra) builds ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 " as a single object:"
}], "Text",ExpressionUUID->"2b0fb60e-2211-365f-5934-286857a59ca5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"meanvalue", " ", "=", " ", 
  RowBox[{"(", 
   RowBox[{"oneLayer", " ", "/*", " ", "hcost", " ", "/*", " ", 
    RowBox[{"oneLayer", "[", "\"\<Dagger\>\"", "]"}]}], ")"}]}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"201a2509-bdd9-2fa1-5039-bd53346c758b"],

