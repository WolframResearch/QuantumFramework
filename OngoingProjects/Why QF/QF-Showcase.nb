Cell[TextData[{
 "The diagram lays out the whole code on five wires: the labeled ",
 Cell[BoxData["Encode"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "701e1eb7-eeba-61c8-2025-97f08b4f3312"],
 " block spreading the data qubit across the three code qubits, the ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["\[Theta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e322415-281a-3695-37c1-be5f49ac9cff"],
 " error on qubit ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 ", the two parity measurements placing their syndromes on record wires ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e8a6a96-06b4-6465-0689-83d0b3414f4f"],
 " and ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55951090-ef25-ccfd-03aa-89dd8ad196c7"],
 ", and the three corrections acting from those records, each an ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a2ca13-da2c-324e-0151-ec5cdfde8094"],
 " controlled on one record and anti-controlled on the other. Run it on a \
fully symbolic data qubit:"
}], "Text",ExpressionUUID->"5930221d-821b-4026-08cf-c44737ae130c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"coded", " ", "=", " ", 
  RowBox[{"qec", "[", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{
     RowBox[{"QuantumState", "[", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
     RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"76ba63e9-5df8-c241-1e5a-7ab3547290ab"],

