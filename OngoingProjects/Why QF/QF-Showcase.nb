       Dynamic[Typeset`open$$], ImageSize -> Automatic]},
     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  Wolfram`QuantumFramework`QuantumState[
  SparseArray[
   Automatic, {32}, 0, {
    1, {{0, 4}, {{1}, {8}, {25}, {32}}}, {$CellContext`\[Alpha] 
      Cos[$CellContext`\[Theta]], $CellContext`\[Beta] 
