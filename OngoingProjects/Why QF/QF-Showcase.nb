Cell[TextData[{
 "The diagram is an ordinary gate-model circuit: a Hadamard on every wire, \
then controlled-",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2148b02c-d62e-5336-5777-2989e3db3e1c"],
 " gates down the chain ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "183293a6-0d60-7813-49c1-0a00a4154b79"],
 "-",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61e1f3c1-eae0-3799-179e-eaaa8e9a9de3"],
 "-",
 Cell[BoxData["3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20bddc2d-650e-8031-5042-d6770cb8d31b"],
 "-",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a437910-f355-55ba-2a71-715d86e03f80"],
 "-",
 Cell[BoxData["5"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49429438-4a3e-974e-7f71-0e626fc8fd94"],
 ". Nothing about it is stabilizer-specific yet; the engine is a choice made \
at application time."
}], "Text",ExpressionUUID->"07e2168c-1726-1a27-2d91-8fd6a2d3690d"],

Cell["Apply it with the stabilizer engine instead of the default:", "Text",ExpressionUUID->"3540c51c-f580-c338-637f-dd59fc3aae02"],

