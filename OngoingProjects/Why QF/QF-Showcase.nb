Cell["\<\
The object carries both amplitudes as symbols. Read them back as a plain \
vector:\
\>", "Text",ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", "[", "\"\<StateVector\>\"", "]"}], " ", "//", " ", 
  "Normal"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Cos", "[", "\[Alpha]", "]"}], ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "\[Beta]"}]], " ", 
    RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.994895262490746*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"a34392e1-8bf8-4943-a135-4993aecb0846"]
}, Open  ]],

Cell[TextData[{
 "The amplitudes return exactly as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}], ",", " ", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      StyleBox[
       RowBox[{"i", "\[Beta]"}], "TI"]], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Alpha]", "TI"]}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 ", symbols intact."
}], "Text",ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[TextData[{
 "The same object reports its exact Bloch geometry, the expectation triple ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["r", "TI"], "\[RightVector]"], "=", 
    StyleBox["(",
     FontSize->1.2 Inherited], 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["X", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["Y", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], ",", 
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    StyleBox["Z", "TI"], "\[VeryThinSpace]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1], 
    StyleBox[")",
     FontSize->1.2 Inherited]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " that places the qubit on the unit sphere (",
 Cell[BoxData["ComplexExpand"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " treats ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 " as real):"
}], "Text",ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"psi", "[", "\"\<BlochVector\>\"", "]"}], " ", "//", " ", 
   "ComplexExpand"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", "\[Beta]", "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", "\[Alpha]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", "\[Alpha]"}], "]"}], " ", 
    RowBox[{"Sin", "[", "\[Beta]", "]"}]}], ",", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", " ", "\[Alpha]"}], "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9948952625230703`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"3c2ad633-2331-4066-9ffa-a88a2ab59ef4"]
}, Open  ]],

Cell[TextData[{
 "The Bloch vector returns exactly as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["(",
      FontSize->1.2 Inherited], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "2", 
     StyleBox["\[Alpha]", "TI"], " ", 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", "2", 
     StyleBox["\[Alpha]", "TI"], " ", 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Beta]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", "2", 
     StyleBox["\[Alpha]", "TI"]}]}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 ": the full geometry as functions of ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 ", without committing to numbers."
}], "Text",ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"]
}, Closed]],

Cell[CellGroupData[{

Cell["A time-dependent symbolic Hamiltonian", "Subsection",ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[TextData[{
 "Hamiltonians need not be static. The following is a spin-",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " in a magnetic field that rotates in the ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"x", "y"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 "-plane at frequency ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 ", on top of a static ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 "-field, the standard model of magnetic resonance and of a driven qubit:"
}], "Text",ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    SubscriptBox[
     StyleBox["\[Omega]", "TI"], "0"], "2"], " ", 
   StyleBox["Z", "TI"], "+", 
   FractionBox["\[CapitalOmega]", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["t", "TI"], " ", 
   StyleBox["X", "TI"], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["t", "TI"], " ", 
   StyleBox["Y", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[TextData[{
 "It is explicitly time-dependent, built as a function ",
 Cell[BoxData[
  RowBox[{"h", "[", "t", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 " whose operator carries the time ",
 Cell[BoxData["t"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66b4bee0-d247-b105-0e4b-37cde7f3006f"],
 ":"
}], "Text",ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "h", "]"}], "\n", 
 RowBox[{
  RowBox[{"h", "[", "t_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]0", "/", "2"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], " ", "+", "\n", 
   "   ", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Omega]", " ", "t"}], "]"}], " ", 
       RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"\[Omega]", " ", "t"}], "]"}], " ", 
       RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}]}], 
     ")"}]}]}]}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[TextData[{
 "Because the field direction rotates, ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " does not commute with itself at different times, so the propagator is not \
simply ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Integral]",
     FontSize->1.15 Inherited], 
    StyleBox["H", "TI"], " ", 
    StyleBox["d", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 "; it requires genuine time-ordering. Check the non-commutativity directly, \
applying ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " to the two operator objects ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["t", "TI"], "1"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["t", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 ":"
}], "Text",ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Commutator", "[", 
     RowBox[{
      RowBox[{"h", "[", "t1", "]"}], ",", " ", 
      RowBox[{"h", "[", "t2", "]"}]}], "]"}], "[", "\"\<Matrix\>\"", "]"}], 
   " ", "//", " ", "Normal"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[CapitalOmega]", "2"], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"t1", "-", "t2"}], ")"}], " ", "\[Omega]"}], "]"}]}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "t1", " ", "\[Omega]"}]]}], "+", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "t2", " ", "\[Omega]"}]]}], 
       ")"}], " ", "\[CapitalOmega]", " ", "\[Omega]0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "t1", " ", "\[Omega]"}]], "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "t2", " ", "\[Omega]"}]]}], ")"}], " ",
       "\[CapitalOmega]", " ", "\[Omega]0"}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[CapitalOmega]", "2"], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"t1", "-", "t2"}], ")"}], " ", "\[Omega]"}], "]"}]}]}], 
    "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994895262834709*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"4bbda5f2-1cf1-437e-92d4-d808630c27d3"]
}, Open  ]],

Cell[TextData[{
 "The commutator is nonzero, with diagonal ",
 Cell[BoxData[
  RowBox[{"\[MinusPlus]", 
   FractionBox[
    StyleBox["i", "TI"], "2"], 
   SuperscriptBox["\[CapitalOmega]", "2"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["[",
    FontSize->1.2 Inherited], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["t", "TI"], "1"], "-", 
    SubscriptBox[
     StyleBox["t", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["\[Omega]", "TI"], 
   StyleBox["]",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 ": the evolution genuinely requires time-ordering and does not reduce to a \
static problem."
}], "Text",ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"]
}, Closed]],

Cell[CellGroupData[{

Cell["Its propagator, in closed form", "Subsection",ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[TextData[{
 Cell[BoxData["QuantumEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " is QF's single entry point for time evolution: it propagates a state \
forward or returns the propagator itself, under closed-system (Schrodinger) \
or open-system (Lindblad) dynamics, numerically or, when the inputs carry \
symbols, in closed form. Given the Hamiltonian ",
 Cell[BoxData[
  RowBox[{"h", "[", "t", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 ", ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " in place of an initial state, and the time variable ",
 Cell[BoxData["t"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 ", it returns the propagator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " solving ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], " ", 
   SubscriptBox["\[PartialD]", 
    StyleBox["t", "TI"]], 
   StyleBox["U", "TI"], "=", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 ". (Verified here: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], " ", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Prime]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " exactly.)"
}], "Text",ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"urot", " ", "=", " ", 
  RowBox[{"QuantumEvolve", "[", 
   RowBox[{
    RowBox[{"h", "[", "t", "]"}], ",", " ", "None", ",", " ", "t"}], 
   "]"}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

