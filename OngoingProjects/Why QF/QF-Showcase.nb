          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
          BaselinePosition -> {1, 1}]}, 
       Dynamic[Typeset`open$$], ImageSize -> Automatic]},
     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  Wolfram`QuantumFramework`QuantumState[
  SparseArray[
   Automatic, {2, 2}, 0, {
    1, {{0, 2, 4}, {{1}, {2}, {1}, {2}}}, {
     E^(-$CellContext`t $CellContext`\[Gamma]1) (
       E^($CellContext`t $CellContext`\[Gamma]1) $CellContext`\[Rho][
         1, 1] - $CellContext`\[Rho][2, 2] + 
       E^($CellContext`t $CellContext`\[Gamma]1) $CellContext`\[Rho][2, 2]), 
      E^(Rational[-1, 2] $CellContext`t $CellContext`\[Gamma]1 - 
        2 $CellContext`t $CellContext`\[Gamma]\[Phi] + 
        Complex[0, -1] $CellContext`t $CellContext`\[CapitalOmega]) \
$CellContext`\[Rho][1, 2], 
      E^(Rational[-1, 2] $CellContext`t $CellContext`\[Gamma]1 - 
        2 $CellContext`t $CellContext`\[Gamma]\[Phi] + 
        Complex[0, 
           1] $CellContext`t $CellContext`\[CapitalOmega]) \
$CellContext`\[Rho][2, 1], 
      E^(-$CellContext`t $CellContext`\[Gamma]1) $CellContext`\[Rho][2, 2]}}], 
   Wolfram`QuantumFramework`QuantumBasis[<|
    "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
          
          Wolfram`QuantumFramework`QuditName[\[FormalCapitalI], "Dual" -> 
