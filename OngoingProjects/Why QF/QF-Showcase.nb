Cell[TextData[{
 "It returns the textbook ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["(",
      FontSize->1.2 Inherited], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 ". Now run the protocol:"
}], "Text",ExpressionUUID->"75dfb56b-bb47-a02b-23e4-2d353ef3f371"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"out", " ", "=", " ", 
  RowBox[{"tele", "[", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{"psi", ",", " ", 
     RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

