Cell[TextData[{
 "A five-gate Clifford circuit returns, interleaved Hadamards and \
controlled-NOTs, and applying it to ",
 Cell[BoxData[
  TemplateBox[{"000"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08e3a6ae-198b-2f89-3890-3f08983e75d3"],
 " reproduces the state vector exactly (verified). Circuit to tableau, \
tableau to state, tableau back to circuit: three representations of one \
object, each available where it is cheapest, with symbols, structure, or \
scale deciding which engine runs."
}], "Text",ExpressionUUID->"07ff9e3d-196e-b566-2d84-106798181c4c"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Claim 5: A quantum object is an ordinary Wolfram Language expression\
\>", "Section",ExpressionUUID->"7611561e-6aa4-cbf1-1e2f-48580f5699db"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " this is what underlies everything above, the reason Claim 1's algebra is \
symbolic and Claim 4's three engines share one model: a QF object is a \
symbolic expression like any other in the language, so the kernel's own \
functions operate on the object and return another object. ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d91ad73-9dce-768e-1bae-453d147b5cd4"],
 " exponentiates a generator into a propagator, ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bff65fb-5d0a-196c-1985-7ca554bf6bb6"],
 " differentiates a parametrized gate into another operator, ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e58ca76-8595-5ac4-0667-ec302c20282e"],
 " and ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a91809-3406-7705-3856-9253bdb35a6f"],
 " build a Hamiltonian from named Paulis, and the closed-form scalars these \
objects yield pass into solvers like ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47ee4125-d524-d464-6d96-588edcd6bf4e"],
 " and ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a0bea5a-c3ff-c671-4a08-0c07f58bad5b"],
 ". Nothing is converted, extracted, or exported first: the same ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d2ec88d-5e53-28f6-54d5-e1d75be67adc"],
 ", ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230fc3bf-d3e5-5aa5-5134-daf8e590288f"],
 ", ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c6e076f-8b93-3c10-3415-9f492e27877a"],
 " one would call on a number-matrix act unchanged on a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29094997-c9cb-f733-5f37-60d0e87fda19"],
 " and return a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "284fc6fb-b6ce-6422-5874-dfa4c37b4f08"],
 ". The overload set is real but finite, ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cad16aa-0a89-b805-3452-8ff4af3d0b6f"],
 " (and ",
 Cell[BoxData["MatrixExp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5640583a-c911-1fe8-7e70-5267e8a46532"],
 "), ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6944803a-8297-e066-1f7b-1a643723b34c"],
 ", ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9e495e-a796-7cd0-26a6-611bd223463a"],
 ", ",
 Cell[BoxData["Times"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "534f7e63-03c8-ee33-0175-704db662b519"],
 ", ",
 Cell[BoxData["Power"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b07ad27-9e6a-154b-693c-44811b1f7f91"],
 ", ",
 Cell[BoxData["Tr"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c7a415c-3e53-b7cb-441a-5906bbe71d11"],
 ", ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "417aec05-2fbb-8238-7719-066f4a4fd102"],
 " and the analytic functions act on operators; for ",
 Cell[BoxData["Eigenvalues"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4705486f-1ac0-4964-6d3b-62499f75184e"],
 " or ",
 Cell[BoxData["Det"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3af5a034-7641-6879-6a8a-3a7e03f43b43"],
 " one still reaches through ",
 Cell[BoxData[
  RowBox[{"obj", "[", "\"\<Matrix\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68379bed-79e9-22be-19cc-12b77f9c7084"],
 "."
}], "Text",ExpressionUUID->"460eb9f9-c41e-8ef4-6e35-30a2eda8d4de"],

Cell[CellGroupData[{

Cell["Superposition by native arithmetic", "Subsection",ExpressionUUID->"258251be-7c16-7495-53b2-48f875a35eff"],

Cell["\<\
Write a state as a sum of kets scaled by amplitudes, and check it against the \
named one:\
\>", "Text",ExpressionUUID->"35c1f832-722b-ca69-63fe-f27c07df98b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], " ", "+", " ", 
     RowBox[{"QuantumState", "[", "\"\<1\>\"", "]"}]}], ")"}], "/", 
   RowBox[{"Sqrt", "[", "2", "]"}]}], " ", "==", " ", 
  RowBox[{"QuantumState", "[", "\"\<+\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[143]:=",ExpressionUUID->"7b6a50da-eb07-3910-296a-49878eb3887a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994895374965989*^9},
 CellLabel->
  "Out[143]=",ExpressionUUID->"f7588a18-0dd7-4d9c-bd73-3a3935480f43"]
}, Open  ]],

Cell[TextData[{
 "The comparison returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23591dbb-79d4-ec10-5166-94e57866b77a"],
 ": ",
 Cell[BoxData["Plus"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114fd905-c79d-9420-4774-d16ef229ff0a"],
 " and the scalar division act on the state objects, assembling ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"0"},
      "Ket"], "+", 
     TemplateBox[{"1"},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0047a90f-9cb0-808d-307c-4169154ad2d7"],
 " as a genuine ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42e32fd7-26e6-6b71-7290-c6915293365b"],
 ", and QF's overloaded ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a2652ed-88d4-efb2-7bde-4bb72966b598"],
 " confirms it is ",
 Cell[BoxData[
  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0962d9db-7466-8598-3f11-d0857d10efe2"],
 ". No amplitudes were extracted by hand, and the same arithmetic extends to \
the more substantial overloads below."
}], "Text",ExpressionUUID->"5b3d557b-19e1-b503-0ac3-4d259f951c69"]
}, Closed]],

Cell[CellGroupData[{

Cell["The exponential map: a generator becomes a propagator", "Subsection",ExpressionUUID->"529c5c95-0588-d8f1-02a4-55dfac22aadb"],

Cell[TextData[{
 "The propagator of a Hamiltonian ",
 Cell[BoxData[
  StyleBox["H", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18bedc4a-f6ca-97e0-4845-d617837cfdca"],
 " is the matrix exponential ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["H", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f18273e-5cf5-00f5-0527-bf78548052df"],
 ". Write it directly, with the kernel's ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1890d11b-851d-d227-48af-c9452ca9a10d"],
 " acting on the generator object:"
}], "Text",ExpressionUUID->"5b8be800-baff-aedd-0988-026a3e8bf427"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"uexp", " ", "=", " ", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "t"}], ")"}], " ", 
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}]}], "]"}]}]], "Input",
