       RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}], "}"}], ",", 
    " ", "\[Rho]0", ",", " ", "t"}], "]"}]}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],

