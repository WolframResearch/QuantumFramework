Cell["Read the control field off each axis:", "Text",ExpressionUUID->"7c4bd199-468e-1df0-2448-c8c3733b67da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", 
  " ", 
  RowBox[{"hdrive", "[", "\"\<PauliDecompose\>\"", "]"}]}]], "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"5faac466-18c1-c293-05a9-de40997590f9"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"X\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Cos", "[", 
      SuperscriptBox["t", "2"], "]"}], "2"]}], ",", 
   RowBox[{"\<\"Y\"\>", "\[Rule]", 
    FractionBox[
     RowBox[{"Sin", "[", 
      SuperscriptBox["t", "2"], "]"}], "2"]}], ",", 
   RowBox[{"\<\"Z\"\>", "\[Rule]", "t"}], ",", 
   RowBox[{"\<\"I\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}]], "Output",\

 CellChangeTimes->{3.994895375349427*^9},
 CellLabel->
  "Out[151]=",ExpressionUUID->"1ee062b5-7550-4d6b-aa80-4ca7f7489e20"]
}, Open  ]],

Cell[TextData[{
 "The controls return axis by axis as the drive ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["t", "TI"], " ", 
   StyleBox["Z", "TI"], "+", 
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], " ", 
   StyleBox["X", "TI"], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], " ", 
   StyleBox["Y", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b2a52a2-44e1-aebb-392a-4b0c6c95f481"],
 ", with a vanishing identity component, traceless as a control should be. ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "146756d1-ea39-ec02-3c1d-4f9a8fcdb768"],
 " operated on the ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a7ee52b-d767-0389-4a05-fd74e21251d3"],
 " and returned a ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "419fd7e1-c297-cbe2-77a4-cecaf72399c8"],
 " (not a bare matrix), and composition ",
 Cell[BoxData["@"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a33ac2f-4fb5-380e-2bc0-45896a418b54"],
 ", ",
 Cell[BoxData["Dagger"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b56b9eb-04f6-5b17-696d-30b5ac83267d"],
 ", and the Pauli decomposition all act on the same object; the defining \
identity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], " ", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], "=", 
   StyleBox["H", "TI"], " ", 
   StyleBox["U", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e9dc2e4-4753-bfbd-16a2-dbce72e70587"],
 " holds identically. The textbook inverse-design formula runs on the \
operator itself, with no differential solver involved."
}], "Text",ExpressionUUID->"7db41629-8d3d-b9f9-2b4b-887324c90bc3"]
}, Closed]],

Cell[CellGroupData[{

Cell["Calculus on states too", "Subsection",ExpressionUUID->"3f51d24b-32fb-3155-656e-d415468f83bf"],

Cell["\<\
The derivative overload is not operator-only. Take a state whose amplitudes \
are functions of time. Build it:\
\>", "Text",ExpressionUUID->"32e9efb5-7328-71d0-6296-06ff06dd433a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}], "]"}]}]], "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"0aa19f46-928a-afd4-3a5e-1720273cf53e"],

Cell[BoxData[
 InterpretationBox[
