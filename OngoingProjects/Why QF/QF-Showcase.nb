Cell[TextData[{
 "The ordering on the chart, antibunched below ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 ", coherent at ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 ", bunched above, is the photon-statistics signature that distinguishes \
these light sources where a single intensity measurement cannot."
}], "Text",ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"]
}, Closed]],

Cell[CellGroupData[{

Cell["Phase-space quasi-probabilities: Wigner and Husimi", "Subsection",ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"],

Cell[TextData[{
 "The Wigner function is the phase-space quasi-probability ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["p", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]}], "=", 
   RowBox[{
    FractionBox["1", "\[Pi]"], 
    RowBox[{
     StyleBox["\[Integral]",
      FontSize->1.15 Inherited], 
     RowBox[{
      TemplateBox[{
        RowBox[{
          StyleBox["x", "TI"], "-", 
          StyleBox["y", "TI"]}]},
       "Bra"], 
      StyleBox["\[Rho]", "TI"], 
      TemplateBox[{
        RowBox[{
          StyleBox["x", "TI"], "+", 
          StyleBox["y", "TI"]}]},
       "Ket"], 
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{"2", 
        StyleBox["i", "TI"], 
        StyleBox["p", "TI"], 
        StyleBox["y", "TI"]}]], 
      StyleBox["d", "TI"], 
      StyleBox["y", "TI"]}]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66ca9132-7812-8248-0ec9-097c79a4d092"],
 ". It integrates to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],
 " like a probability density but, unlike one, can take negative values, and \
that negativity is a signature of nonclassicality with no classical analogue. \
A clear example is the Schrodinger cat state, the even superposition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["\[Alpha]", "TI"]},
      "Ket"], "+", 
     TemplateBox[{
       RowBox[{"-", 
         StyleBox["\[Alpha]", "TI"]}]},
      "Ket"]}], ")"}], "/", "\|01d4a9"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
 " of two coherent states of opposite phase, here with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47740231-7fc8-4299-6d0b-a47b7a7d10e3"],
 ". Build its Wigner function on a phase-space window:"
}], "Text",ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"wigner", " ", "=", " ", 
  RowBox[{"WignerRepresentation", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"CatState", "[", "]"}], "[", 
     RowBox[{"2", ",", " ", "0"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "6"}], ",", " ", "6"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "90"}]}], "]"}]}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],

