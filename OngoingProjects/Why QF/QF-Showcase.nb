Cell[BoxData[
 RowBox[{"sicQubit1", " ", "=", " ", 
  RowBox[{"QuantumMeasurementOperator", "[", 
   RowBox[{"\"\<TetrahedronSICPOVM\>\"", ",", " ", 
    RowBox[{"{", "1", "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

