Cell[TextData[{
 "A purely Clifford circuit that would otherwise carry a ",
 Cell[BoxData[
  SuperscriptBox["2", "5"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e32c5a8-aee9-5273-17c1-dcf5ca9c2159"],
 " amplitude vector returns instead a ",
 Cell[BoxData["PauliStabilizer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "607492e2-157b-ba0c-100b-0bcc9c0f0956"],
 ": the state stored as its symmetry group, not as its amplitudes."
}], "Text",ExpressionUUID->"7781757c-388d-abb9-1dbf-6d26b939f983"],

Cell["Read the generators of that group:", "Text",ExpressionUUID->"566e7348-207a-dc95-7e16-6b12510ca6ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"stab5", "[", "\"\<PauliForm\>\"", "]"}]], "Input",
 CellLabel->
  "In[130]:=",ExpressionUUID->"39672ae7-82f4-b353-6f1c-c3c1368601b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"XZIII\"\>", ",", "\<\"ZXZII\"\>", ",", "\<\"IZXZI\"\>", 
   ",", "\<\"IIZXZ\"\>", ",", "\<\"IIIZX\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.994895373537039*^9},
 CellLabel->
  "Out[130]=",ExpressionUUID->"5044a8e8-6e4f-46fe-b80c-11d69e991696"]
}, Open  ]],

Cell[TextData[{
 "Five Pauli strings that determine the state completely. They are exactly \
the cluster-state generators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], 
    StyleBox["v", "TI"]], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["v", "TI"]], 
   UnderscriptBox["\[Product]", 
    RowBox[{
     StyleBox["w", "TI"], "\[Tilde]", 
     StyleBox["v", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["w", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c48aba4-6f27-6a39-3477-420e0ad23903"],
 " along the chain, the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f62374d-f3df-131c-5511-af16866a7e66"],
 " on each site flanked by ",
 Cell[BoxData[
  StyleBox["Z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "455ea632-3d4d-f0d3-7365-387cb4f9c239"],
 " on its neighbors."
}], "Text",ExpressionUUID->"1f0fb95c-030e-c889-4534-3106b6b89ad3"],

Cell["\<\
Pauli expectations are closed-form algebra on the generators, with no state \
vector anywhere:\
\>", "Text",ExpressionUUID->"16268eae-a572-7912-3fdd-270bcc074878"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<XZIII\>\"", " ", "->", " ", 
    RowBox[{"stab5", "[", 
     RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<XZIII\>\""}], "]"}]}], ",",
    " ", 
   RowBox[{"\"\<IZXZI\>\"", " ", "->", " ", 
    RowBox[{"stab5", "[", 
     RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<IZXZI\>\""}], "]"}]}], ",",
    " ", 
   RowBox[{"\"\<XXIII\>\"", " ", "->", " ", 
    RowBox[{"stab5", "[", 
     RowBox[{"\"\<Expectation\>\"", ",", " ", "\"\<XXIII\>\""}], "]"}]}]}], 
  "|>"}]], "Input",
 CellLabel->
  "In[131]:=",ExpressionUUID->"346a0e1a-2221-987e-5c69-a04457d5eb44"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"XZIII\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"IZXZI\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"XXIII\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.99489537354882*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"5ecd96b0-ad9a-4639-aba3-b4dfa0fd94d5"]
}, Open  ]],

Cell[TextData[{
 "The two generators ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366be24c-537a-43bb-5e68-0416660f1181"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "3"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "501b1457-1a1d-907b-0038-8e119fa9e341"],
 " return deterministically ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "291c68e0-f532-6cdd-5f23-81cdfcc73627"],
 ", while ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"X", "X"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c29c458-c353-7b98-05d6-de05f6e649e2"],
 " on the first two sites, which anticommutes with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], "1"], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], "1"], 
   SubscriptBox[
    StyleBox["Z", "TI"], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1a2d6a-d2ad-c32a-1639-c537e759ae70"],
 ", is exactly unbiased, all read off by ",
 Cell[BoxData[
  SubscriptBox["\|01d53d", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eb5612b-2266-f0f1-164b-79755710c2db"],
 " phase tracking."
}], "Text",ExpressionUUID->"1f4b4965-e043-b514-4549-614e91f71c7e"],

Cell[TextData[{
 "The advantage of the representation is scale. Apply twenty thousand random \
Clifford gates to a thousand qubits, a state whose amplitude vector would \
need ",
 Cell[BoxData[
  SuperscriptBox["2", "1000"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf36e21-2d79-2b6f-0980-878b440c79b5"],
 " entries. The qubit count:"
}], "Text",ExpressionUUID->"6fe9f85b-1ce6-27f0-1596-f20594908dda"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", " ", "=", " ", "1000"}], ";"}]], "Input",
 CellLabel->
  "In[132]:=",ExpressionUUID->"3eadea9f-7d43-757d-6652-03d974f65c47"],

Cell["\<\
Build the random gate stream, twenty thousand Hadamard, CNOT, and phase gates \
(seeded for reproducibility):\
\>", "Text",ExpressionUUID->"68be2dd2-eea3-f2cb-1845-c49f8b57c011"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gates", " ", "=", " ", 
   RowBox[{"Flatten", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<H\>\"", " ", "->", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "n"}], "}"}], "]"}]}], ",", " ", 
        RowBox[{"\"\<CNOT\>\"", " ", "->", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", " ", "2"}], "]"}]}], ",", 
        " ", 
        RowBox[{"\"\<S\>\"", " ", "->", " ", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "n"}], "}"}], "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", "6666", "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[133]:=",ExpressionUUID->"1279eb8d-ef8a-5dbb-4206-02d68a3f2781"],

Cell[TextData[{
 "Apply them to the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6afb4307-9f81-9d1b-1a99-5b611a35e461"],
 "-qubit stabilizer state and time the evolution:"
}], "Text",ExpressionUUID->"2e902be9-4fb4-3e90-56af-c2b36a4684fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"First", " ", "@", " ", 
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{
    RowBox[{"big", " ", "=", " ", 
     RowBox[{
      RowBox[{"PauliStabilizer", "[", "n", "]"}], "[", 
      RowBox[{"\"\<ApplyCircuit\>\"", ",", " ", "gates"}], "]"}]}], ";"}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[135]:=",ExpressionUUID->"46e8ad28-93a4-355d-6e97-457226569fa7"],

Cell[BoxData["0.063167`"], "Output",
 CellChangeTimes->{3.994895373631241*^9},
 CellLabel->
  "Out[135]=",ExpressionUUID->"484805f9-832f-4135-b886-fb66c8374d90"]
}, Open  ]],

Cell[TextData[{
 "The whole gate stream folds in a fraction of a second: ",
 Cell[BoxData["ApplyCircuit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43090fa7-5002-8b65-7136-a60161b4d64f"],
 " runs the tableau updates through one compiled kernel whose per-gate cost \
is flat in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6689b0-bbf9-a698-3b1d-20fa3d8d0ce2"],
 " and independent of the ",
 Cell[BoxData[
  SuperscriptBox["2", 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac87485-b214-a6e0-7ac8-6deec7a60cca"],
 " that never gets built. The cross-engine comparison is boundary-dependent \
rather than a single ratio: a dedicated C++ tableau (Stim) is roughly ",
 Cell[BoxData[
  RowBox[{"4", "\[Times]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e1d4b5-6b25-2976-7e9e-cdff0ed0785c"],
 " faster at the engine core and ",
 Cell[BoxData["11"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e41722a-1026-02f0-567f-7474a1d350da"],
 "-",
 Cell[BoxData[
  RowBox[{"16", "\[Times]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aacec8a-85e6-bbaa-1a53-05d4339009f0"],
 " faster end to end, while a Python-driven gate-by-gate pipeline around that \
same C++ engine is about ",
 Cell[BoxData[
  RowBox[{"27", "\[Times]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c51a735-fee5-6802-446e-3f7efa903b68"],
 " slower than this one compiled call (measurements in the companion ",
 Cell["QF-Stabilizer-vs-Packages.md", "InlineCode",ExpressionUUID->
  "5e54a15d-ecde-9aa9-066b-39068568e8f3"],
 "). The bipartite entanglement entropy across the half-chain cut is then a \
closed form, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["A", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["rank",
     FontSlant->"Plain"], 
    SubscriptBox["\|01d53d", "2"]], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox[
     RowBox[{
     "generators", "\[NonBreakingSpace]", "restricted", "\[NonBreakingSpace]",
       "to", "\[NonBreakingSpace]"}],
     FontSlant->"Plain"], 
    StyleBox["A", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", GridBox[{
     {
      StyleBox["A", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27fb6428-ecec-27d4-4d99-7e75849e8d3e"],
 ", exact at any qubit count:"
}], "Text",ExpressionUUID->"51f5ca74-88a2-9d2c-078a-ec3e2954e476"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"big", "[", 
  RowBox[{"\"\<Entropy\>\"", ",", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"n", "/", "2"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"1154648e-ef0b-aa2b-476c-7deb8abff971"],

Cell[BoxData["496"], "Output",
 CellChangeTimes->{3.994895374446724*^9},
 CellLabel->
  "Out[136]=",ExpressionUUID->"038ef858-37b2-4dba-bc92-b18edb099172"]
}, Open  ]],

Cell[TextData[{
 "The entropy returns just below its half-chain maximum: the random circuit \
has driven the chain to near-maximal, Page-like entanglement, and whatever \
gate sequence the sampler draws, the value is an exact integer from an ",
 Cell[BoxData[
  SubscriptBox["\|01d53d", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c057904-8649-af2b-743b-716e33fdf271"],
 " rank, not an estimate. The boundary of the formalism is handled directly \
as well: a non-Clifford gate (",
 Cell[BoxData[
  StyleBox["T", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2baf9433-2e90-ebaf-5954-0e7d4b2ab9f5"],
 ", or a general phase) steps outside the stabilizer group, and QF returns a ",
 Cell[BoxData["StabilizerFrame"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "340e6ec8-e38f-b030-5c35-8795963b031a"],
 ", a superposition of stabilizer states, rather than a wrong answer."
}], "Text",ExpressionUUID->"64bff79f-1679-3ebc-0c44-eed9a30d8486"]
}, Closed]],

Cell[CellGroupData[{

Cell["The representations convert exactly", "Subsection",ExpressionUUID->"126dc52b-3dd5-bd31-4212-dd75b461041b"],

Cell[TextData[{
 "The engines are not separate; one object model means the representations \
interconvert. Start from an ordinary three-qubit linear cluster circuit, a \
Hadamard on every wire followed by two nearest-neighbor ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"C", "Z"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28023c0b-10a3-7000-5831-b655a156436a"],
 " bonds:"
}], "Text",ExpressionUUID->"4f1b960d-0301-b7cd-7538-0857b6b51d17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cluster3", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<H\>\"", " ", "->", " ", 
      RowBox[{"Range", "[", "3", "]"}]}], ",", " ", "\"\<CZ\>\"", ",", " ", 
     RowBox[{"\"\<CZ\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"268b8fe7-2cf2-fa64-4e88-26c14484c94e"],

