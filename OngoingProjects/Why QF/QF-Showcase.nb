Cell[TextData[{
 "The same state spreads into a three-term superposition over the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
 " levels: one ket in its own basis, a sum in the other. The named operator \
",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["J", "TI"], 
   StyleBox["x", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719ae17a-c654-ed44-27b9-f927f3e6b7ae"],
 " is itself stored in its own eigenbasis, so the expectation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"]], 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], "=", 
   RowBox[{
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Bra"], 
    SubscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"]], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c8f42b-c628-388a-12f7-ee74f3c28ad0"],
 " involves three declared bases at once; compute it from both \
representations of the state:"
}], "Text",ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<JX basis\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"mx", "[", "\"\<Dagger\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<JX\>\"", "[", "1", "]"}], "]"}], "[", "mx", "]"}], "]"}],
      "[", "\"\<Scalar\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Computational basis\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"mxZ", "[", "\"\<Dagger\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"QuantumOperator", "[", 
        RowBox[{"\"\<JX\>\"", "[", "1", "]"}], "]"}], "[", "mxZ", "]"}], 
      "]"}], "[", "\"\<Scalar\>\"", "]"}]}]}], "|>"}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"JX basis\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Computational basis\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.994895356506246*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"6e17eddd-69dc-48d6-bde9-6dbbeec7522d"]
}, Open  ]],

Cell[TextData[{
 "Both entries return as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["x", "TI"]], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
 ": the state in either coordinate system, the operator in a third, and QF \
reconciled them all; the invariant survives every change of coordinates."
}], "Text",ExpressionUUID->"7aafc905-908a-67da-2a54-e16f213f4d20"]
}, Closed]],

Cell[CellGroupData[{

Cell["Any finite dimension: a spin-1 qutrit and a five-site ring", \
"Subsection",ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"],

Cell[TextData[{
 "The same spin-1 system supports genuine three-level dynamics, not just a \
change of basis, and the representation extends to any dimension. Its \
zero-field-splitting Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", "2", 
   StyleBox["d", "TI"], " ", 
   SubsuperscriptBox[
    StyleBox["J", "TI"], 
    StyleBox["z", "TI"], "2"], "+", 
   StyleBox["e", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["x", "TI"], "2"], "-", 
    SubsuperscriptBox[
     StyleBox["J", "TI"], 
     StyleBox["y", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7c794a-82c2-56e7-3604-711437773ccd"],
 ", the model of an NV-center defect, is built from QF's native spin-1 \
operators with both couplings left symbolic. First the three spin-1 operators:"
}], "Text",ExpressionUUID->"30f601cf-5001-fb68-608d-98a961b5c9b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"jx", ",", " ", "jy", ",", " ", "jz"}], "}"}], " ", "=", " ", 
  RowBox[{"QuantumOperator", " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<JX\>\"", "[", "1", "]"}], ",", " ", 
     RowBox[{"\"\<JY\>\"", "[", "1", "]"}], ",", " ", 
     RowBox[{"\"\<JZ\>\"", "[", "1", "]"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"04bc0f0b-f02f-243d-2c43-a75481db8f07"],

