Cell["Read its density matrix in the computational basis:", "Text",ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FullSimplify", " ", "/@", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{
     RowBox[{"\[Rho]t", "[", "\"\<Computational\>\"", "]"}], 
     "[", "\"\<DensityMatrix\>\"", "]"}], "]"}]}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"1", ",", "1"}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "t"}], " ", "\[Gamma]1"}]]}], ")"}], " ", 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"2", ",", "2"}], "]"}]}]}], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], " ", "t", " ", 
         RowBox[{"(", 
          RowBox[{"\[Gamma]1", "+", 
           RowBox[{"4", " ", "\[Gamma]\[Phi]"}], "+", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[CapitalOmega]"}]}], 
          ")"}]}]], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}]},
     {
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], " ", "t", " ", 
         RowBox[{"(", 
          RowBox[{"\[Gamma]1", "+", 
           RowBox[{"4", " ", "\[Gamma]\[Phi]"}], "-", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[CapitalOmega]"}]}], 
          ")"}]}]], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}], 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "t"}], " ", "\[Gamma]1"}]], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.99489535035366*^9},
 CellLabel->
  "Out[51]//MatrixForm=",ExpressionUUID->"1bef6faa-6e1c-477e-937e-\
8a004d093cdd"]
}, Open  ]],

Cell["\<\
The matrix returns exactly as the complete relaxation law for an arbitrary \
qubit:\
\>", "Text",ExpressionUUID->"013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   StyleBox["\[Rho]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "(", GridBox[{
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "11"], "+", "(", 
       RowBox[{"1", "-", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
          SubscriptBox[
           StyleBox["\[Gamma]", "TI"], "1"], 
          StyleBox["t", "TI"]}]]}], ")", 
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "22"]}], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "12"], " ", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", "(", 
         RowBox[{
          FractionBox[
           SubscriptBox[
            StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", "2", 
          SubscriptBox[
           StyleBox["\[Gamma]", "TI"], 
           StyleBox["\[Phi]", "TI"]], "+", 
          StyleBox["i", "TI"], "\[CapitalOmega]"}], ")", 
         StyleBox["t", "TI"]}]]}]},
     {
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "21"], " ", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", "(", 
         RowBox[{
          FractionBox[
           SubscriptBox[
            StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", "2", 
          SubscriptBox[
           StyleBox["\[Gamma]", "TI"], 
           StyleBox["\[Phi]", "TI"]], "-", 
          StyleBox["i", "TI"], "\[CapitalOmega]"}], ")", 
         StyleBox["t", "TI"]}]]}], 
      RowBox[{
       SubscriptBox[
        StyleBox["\[Rho]", "TI"], "22"], " ", 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
         SubscriptBox[
          StyleBox["\[Gamma]", "TI"], "1"], 
         StyleBox["t", "TI"]}]]}]}
    }], ")"}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"],

Cell[TextData[{
 "The excited population decays at ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Gamma]", "TI"], "1"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 ", the lost population moves to the ground state, and the coherence \
precesses at ",
 Cell[BoxData["\[CapitalOmega]"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 " while decaying at ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", "2"], "=", 
   FractionBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"], "2"], "+", "2", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b97f64-b973-0c8a-5047-774e380656d0"],
 ": every experiment on every qubit, in one matrix. With ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "1"], "=", "1", "/", 
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04469009-6b02-dcc3-2c7d-0a530eb4a629"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "=", "1", "/", 
   SubscriptBox["\[CapitalGamma]", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],
 " read from the exponents, the textbook bound between the two times is a \
theorem about this solution:"
}], "Text",ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{"ForAll", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Gamma]1", ",", " ", "\[Gamma]\[Phi]"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"\[Gamma]1", " ", ">", " ", "0"}], " ", "&&", " ", 
     RowBox[{"\[Gamma]\[Phi]", " ", ">=", " ", "0"}]}], ",", " ", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Gamma]\[Phi]"}]}], ")"}]}], " ", "<=", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994895350494841*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"e704bb1f-ac08-41dd-8fd4-71e37ef335d9"]
}, Open  ]],

Cell[TextData[{
 "The reduction returns ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "451364b5-819d-fb99-7321-7dff3029c9e3"],
 ": ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["T", "TI"], "2"], "\[LessEqual]", "2", 
   SubscriptBox[
    StyleBox["T", "TI"], "1"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13b49e24-0fb7-4441-414b-178eaa422eab"],
 " holds for every admissible rate pair, obtained from the computation rather \
than quoted from a textbook, and reducing the corresponding equality for the \
dephasing rate, ",
 Cell[BoxData[
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]1", "/", "2"}], " ", "+", " ", 
        RowBox[{"2", " ", "\[Gamma]\[Phi]"}]}], ")"}]}], " ", "==", " ", 
     RowBox[{"2", "/", "\[Gamma]1"}]}], ",", " ", "\[Gamma]\[Phi]"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],
 ", returns ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], 
    StyleBox["\[Phi]", "TI"]], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "089aa42d-ce49-3603-38b9-3e76ebfd9d69"],
 " (for ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Gamma]", "TI"], "1"], "\[NotEqual]", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fccab3-b886-a0f7-7883-e3fd3930f2dd"],
 "): the factor of two is saturated exactly when dephasing vanishes."
}], "Text",ExpressionUUID->"0cdaad60-2181-5e26-34f9-454a5034250c"]
}, Closed]],

Cell[CellGroupData[{

Cell["A generalized measurement: a POVM", "Subsection",ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

Cell[TextData[{
 "Real detectors are not always projective. A POVM is a set of positive \
effects ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00dd9d4d-f7ec-565f-30e2-151681993ca5"],
 " summing to the identity, ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["i", "TI"],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 ", with outcome probabilities given by the Born rule ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], " ", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 "; one is built from a list of effects with ",
 Cell[BoxData[
  RowBox[{"QuantumMeasurementOperator", "[", 
   RowBox[{"{", 
    RowBox[{"E1", ",", " ", "E2", ",", " ", "..."}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "333832e2-8bec-4128-62c7-abcc2d991072"],
 ". A ",
 StyleBox["symmetric informationally complete", "TI"],
 " POVM is the maximally symmetric case: ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["d", "TI"], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78cf51d6-d7cd-4672-28f5-4893e2782d58"],
 " rank-one effects ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["E", "TI"], 
    StyleBox["i", "TI"]], "=", 
   RowBox[{
    FractionBox["1", 
     StyleBox["d", "TI"]], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Ket"], 
    TemplateBox[{
      SubscriptBox[
       StyleBox["\[Psi]", "TI"], 
       StyleBox["i", "TI"]]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],
 " with equal pairwise overlaps ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[GridBox[{
      {
       TemplateBox[{
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["\[Psi]", "TI"], 
          StyleBox["j", "TI"]]},
        "BraKet"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "=", 
   FractionBox["1", 
    RowBox[{
     StyleBox["d", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "710db4a8-d877-0db2-2732-2df5d9025798"],
 ", four outcomes on a two-level system, pointing along the vertices of a \
tetrahedron in the Bloch ball. Measure a generic Bloch qubit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Psi]", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Theta]", "TI"], ",", 
    StyleBox["\[Phi]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 ", applying the Born rule symbolically to all four effects. Build the \
state:"
}], "Text",ExpressionUUID->"06ea8612-dd18-b4f0-2ee9-185fd4921eda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"0b02f270-2101-5c3d-3931-f43a50b42707"],

