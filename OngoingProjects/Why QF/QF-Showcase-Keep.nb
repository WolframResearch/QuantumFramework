Cell["Read its coupling map back:", "Text",ExpressionUUID->"5f8c04ec-8c47-4bdf-05b3-9db625f21925"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"target", "[", "\"\<CouplingMap\>\"", "]"}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"023e8ab0-46e5-584b-33c5-23fa72902a91"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.997991256584861*^9, 3.9979918498912363`*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"441b9471-76d8-4e72-8bba-8ed927fa727a"]
}, Open  ]],

Cell[TextData[{
 "Pass the target to ",
 Cell[BoxData["QuantumQASM"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a0eac86-50d0-15df-0a35-45e061657f25"],
 " as an option, and the circuit is transpiled to that backend's native gates \
and connectivity:"
}], "Text",ExpressionUUID->"58394c25-48c8-3ecd-09c7-658f69628417"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumQASM", "[", 
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "]"}], ",", " ", 
   RowBox[{"\"\<Target\>\"", " ", "->", " ", "target"}]}], "]"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"1424a2b0-695c-dfcb-3ddb-3bfa08eea511"],

Cell[BoxData["\<\"OPENQASM 3.0;\\ninclude \\\"stdgates.inc\\\";\\nrz(7*pi/8) \
$0;\\nrz(-pi/2) $1;\\nsx $1;\\nrz(-2.677945044588988) $1;\\nrz(-pi/2) \
$2;\\ncx $1, $2;\\nx $1;\\nrz(pi/4) $2;\\ncx $1, $2;\\nrz(2.819842099193151) \
$1;\\ncx $0, $1;\\nrz(-pi/8) $1;\\ncx $0, $1;\\nrz(5*pi/8) $1;\\nrz(-pi/4) \
$2;\\nsx $2;\\nrz(-pi/2) $2;\\ncx $1, $2;\\nsx $1;\\nrz(pi) $1;\\nrz(pi/2) \
$2;\\nsx $2;\\nrz(pi/2) $2;\\ncx $1, $2;\\nsx $1;\\nrz(pi/2) $1;\\nrz(pi/2) \
$2;\\nsx $2;\\nrz(pi/2) $2;\\ncx $1, $2;\\ncx $0, $1;\\nrz(-pi/4) $1;\\ncx \
$0, $1;\\nsx $0;\\nrz(pi/2) $0;\\nrz(pi/4) $1;\\n\"\>"], "Output",
 CellChangeTimes->{3.99799125658996*^9, 3.997991853510148*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"cdce9f35-1b9c-4f36-8e8d-8a68968dab40"]
}, Open  ]],

Cell[TextData[{
 "The QFT comes back rewritten for the device: its controlled-phase rotations \
decomposed into the native ",
 Cell[BoxData["rz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05101942-3b9c-ad10-332f-912cbe2ef47a"],
 "/",
 Cell[BoxData["sx"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35394d45-77a0-03f4-5cc7-652f025551de"],
 "/",
 Cell[BoxData["x"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f9454e1-244e-40e6-65ac-4dcb4dfb12cc"],
 " set, the entangling steps as ",
 Cell[BoxData["cx"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "530b93a6-4244-79d7-0108-0a0077f14b3d"],
 " on physical qubits, every two-qubit gate routed along an edge the coupling \
map allows. Transpiling a Fourier transform, with its all-to-all controlled \
phases, is a realistic instance of this task, where both decomposition and \
routing are non-trivial."
}], "Text",ExpressionUUID->"4c785ed8-c9e5-405c-7418-5785ef9012a6"]
}, Closed]],

Cell[CellGroupData[{

Cell["Submit to a real IBM QPU, and compare to the exact result", "Subsection",ExpressionUUID->"0a66b72e-8103-1d0f-3a1d-2e8830b66455"],

Cell[TextData[{
 "An IBM account connects through ",
 Cell[BoxData[
  RowBox[{"ServiceConnect", "[", "\"\<IBMQuantumPlatform\>\"", "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6206b938-b2f8-72db-123d-3165c68d4021"],
 ", after which ",
 Cell[BoxData["IBMJobSubmit"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a01a055-721a-3362-2a3e-3a1f07ac9e48"],
 " sends a circuit to the hardware asynchronously and returns an ",
 Cell[BoxData["IBMJob"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425e231b-d90e-d650-7265-bb44d8b8bcba"],
 " handle. Create an API key and copy your instance's cloud resource name \
(CRN) from your IBM Quantum Platform account, then connect, the placeholder \
",
 Cell[BoxData["\"\<xxx\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4b19d7-d2e6-1d55-1548-9090e69367bf"],
 " values standing in for your own:"
}], "Text",ExpressionUUID->"266a3a12-a29b-0b72-4e69-bc5fd72e5658"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"api", " ", "=", " ", "\"\<XXX\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LocalSymbol", "[", "\"\<ibm_crn\>\"", "]"}], " ", "=", 
   " ", "\"\<XXX\>\""}], ";"}], "\n", 
 RowBox[{"ServiceConnect", "[", 
  RowBox[{"\"\<IBMQuantumPlatform\>\"", ",", " ", "\"\<New\>\"", ",", " ", 
   RowBox[{"Authentication", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<apikey\>\"", " ", "->", " ", "api"}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.997991535678523*^9, 3.997991539205846*^9}, 
   3.997991578926886*^9, {3.9979917112186823`*^9, 3.997991714352543*^9}, {
   3.9979917596197166`*^9, 
   3.997991765935013*^9}},ExpressionUUID->"1b97aeb9-f3a3-063a-49ac-\
47e286566d00"],

