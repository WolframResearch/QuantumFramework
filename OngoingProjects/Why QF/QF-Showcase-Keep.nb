    DynamicModuleValues:>{}], "]"}],
  Wolfram`QuantumFramework`QuantumState[
  SparseArray[
   Automatic, {2}, 0, {
    1, {{0, 2}, {{1}, {2}}}, {
     Cos[Rational[1, 2] $CellContext`\[Theta]], Sin[
      Rational[1, 2] $CellContext`\[Theta]]}}], 
   Wolfram`QuantumFramework`QuantumBasis[<|
    "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
          
