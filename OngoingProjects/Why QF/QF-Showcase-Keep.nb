}], "Text",ExpressionUUID->"79bc5755-bb31-5780-2f44-4f1f3ec43dea"],

Cell[TextData[{
 StyleBox["Setup.",
  FontWeight->"Bold"],
 " Evaluate once before the cells; this installs the development builds of \
the QuantumFramework and TensorNetworks paclets and loads them:"
}], "Text",ExpressionUUID->"0ff00406-ec89-251c-358f-9e63853d8c66"],

