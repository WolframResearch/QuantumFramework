Cell[TextData[{
 "The ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"\[MinusPlus]", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 " factors are the rotating-frame phases, and ",
 Cell[BoxData[
  StyleBox["cos",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " and ",
 Cell[BoxData[
  StyleBox["sin",
   FontSlant->"Plain"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 " of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["R", "TI"]], 
   StyleBox["t", "TI"], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " are the dressed-state oscillations. The quantity of physical interest is \
the transition probability ",
 Cell[BoxData[
  SuperscriptBox[GridBox[{
     {
      RowBox[{
       TemplateBox[{"1"},
        "Bra"], 
       StyleBox["U", "TI"], 
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        StyleBox["t", "TI"], 
        StyleBox[")",
         SpanMaxSize->1]}], 
       TemplateBox[{"0"},
        "Ket"]}]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 ". Take the lower-left matrix entry, the ",
 Cell[BoxData[
  RowBox[{"0", "\[Rule]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 " amplitude:"
}], "Text",ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

