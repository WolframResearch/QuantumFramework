           1, {{0, 5}, {{1}, {2}, {3}, {4}, {5}}}, {
            5^Rational[-1, 2], (-1)^Rational[4, 5] 
             5^Rational[-1, 2], -(-1)^Rational[3, 5] 
             5^Rational[-1, 2], (-1)^Rational[2, 5] 
             5^Rational[-1, 2], -(-1)^Rational[1, 5] 5^Rational[-1, 2]}}], {
           Wolfram`QuantumFramework`QuditName[
            Subscript["\[ScriptX]", 
             Interpretation[4, -(-1)^Rational[3, 5]]], "Dual" -> False], 1} -> 
         SparseArray[
          Automatic, {5}, 0, {
           1, {{0, 5}, {{1}, {2}, {3}, {4}, {5}}}, {
            5^Rational[-1, 2], (-1)^Rational[2, 5] 
             5^Rational[-1, 2], (-1)^Rational[4, 5] 
             5^Rational[-1, 2], -(-1)^Rational[1, 5] 
             5^Rational[-1, 2], -(-1)^Rational[3, 5] 5^Rational[-1, 2]}}]|>], 
      "Picture" -> "Schrodinger", "Label" -> "X", 
      "ParameterSpec" -> {}|>]], {{1}, {1}}],
