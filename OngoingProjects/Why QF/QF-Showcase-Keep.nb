Cell[TextData[{
 "The output is a ",
 Cell[BoxData["Graphics3D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499d2cc9-9173-f7c8-7fa2-c5932007dd12"],
 " of the sphere with the state's arrow at polar angle ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", "/", "5"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3687b6-15a3-de20-4acd-1ef09c57a50a"],
 " and azimuth ",
 Cell[BoxData[
  RowBox[{"\[Pi]", "/", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073f26db-34e5-c8c2-2ec4-bf85bc919a28"],
 ": the geometry of the state, drawn by the state."
}], "Text",ExpressionUUID->"27056d96-6b3e-545a-4d3a-84d00ecb3ea0"]
}, Closed]],

Cell[CellGroupData[{

Cell["Amplitudes that keep their phases", "Subsection",ExpressionUUID->"031df9cf-6b45-d275-3122-f0a90ef1a15f"],

Cell[TextData[{
 "A bar chart of probabilities discards the phases; ",
 Cell[BoxData["AmplitudesChart"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79902eb9-9fc4-d4aa-2faf-c7e31a76bef0"],
 " draws the complex amplitudes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["x", "TI"]], "=", 
   TemplateBox[{
     StyleBox["x", "TI"], 
     StyleBox["\[Psi]", "TI"]},
    "BraKet"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e90dac8-e749-9c1a-16af-d39592fde760"],
 " themselves, heights for the magnitudes ",
 Cell[BoxData[GridBox[{
    {
     SubscriptBox[
      StyleBox["\[Psi]", "TI"], 
      StyleBox["x", "TI"]]}
   },
   GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
   GridBoxSpacings->{"Columns" -> {{0.15}}}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f026f1c-d8c2-1814-5531-8759d9776b7e"],
 " and colors for the phases ",
 Cell[BoxData[
  RowBox[{
   StyleBox["arg",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Psi]", "TI"], 
    StyleBox["x", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c65fa9b-46f3-ebf0-041a-f3c57287b9da"],
 ". Apply a quantum Fourier transform to the two-term superposition ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox["2"]], 
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{"000"},
      "Ket"], "+", 
     TemplateBox[{"101"},
      "Ket"]}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583cd303-9cb1-03ae-09c3-cb6d154451f4"],
 ", which the transform spreads into a phase-rich pattern across all eight \
basis states:"
}], "Text",ExpressionUUID->"18f1bad1-a8d9-f26a-488e-339ac96dc0b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumCircuitOperator", "[", 
    RowBox[{"\"\<Fourier\>\"", "[", "3", "]"}], "]"}], "[", "\n", "  ", 
   RowBox[{"QuantumState", "[", 
    RowBox[{"Normalize", "[", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", 
       " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}], "]"}], "]"}], "]"}], "[", 
  RowBox[{"\"\<AmplitudesChart\>\"", ",", " ", "\n", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "3"}]}], ",", " ", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"6cd8e50a-7117-62ea-14e7-fd5400a23030"],

