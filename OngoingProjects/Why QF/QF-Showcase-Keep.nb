         Rational[1, 4] (Rational[5, 8] + Rational[-1, 8] 5^Rational[1, 2])^
            Rational[1, 2] (1 + 5^Rational[1, 2]) 
           E^(Complex[0, Rational[-1, 3]] Pi) + 
          Rational[1, 4] (Rational[5, 8] + Rational[-1, 8] 5^Rational[1, 2])^
