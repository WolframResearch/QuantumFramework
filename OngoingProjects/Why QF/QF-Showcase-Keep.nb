Cell[TextData[{
 "Then check the coherent-state identity it implies, with ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34baef30-7963-b757-5c59-077a78171dbd"],
 ", and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ce0314-20ee-2b64-43f5-9b5e509b764e"],
 " all symbols:"
}], "Text",ExpressionUUID->"38a9ac88-4644-6c0e-6856-45d273f13754"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"uosc", " ", "@", " ", 
   RowBox[{"CoherentState", "[", "]"}]}], " ", "==", " ", 
  RowBox[{
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[Omega]", " ", 
      RowBox[{"t", "/", "2"}]}], ")"}]}], " ", 
   RowBox[{
    RowBox[{"CoherentState", "[", "]"}], "[", 
    RowBox[{"\[FormalAlpha]", " ", 
     RowBox[{"E", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "\[Omega]", " ", "t"}], ")"}]}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"64802aa2-b136-451c-0cbf-c30fc0c32c66"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994895354336384*^9, 3.9979912547455473`*^9, 
  3.9979920048144093`*^9, 3.999165936703154*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"1b678132-a3c7-47f0-b3ae-5d5ecf981a65"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
 ", with ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "233ecb8e-17f3-8d32-52c5-e2e8a187d418"],
 ", ",
 Cell[BoxData[
  StyleBox["\[Omega]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"],
 ", and ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
 " all symbols: one evolution determines the dynamics of every coherent state \
at every frequency, an exact statement about the family rather than a \
simulation of one member. (QF's state ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "598f41e5-f1df-a461-0fb5-58ce806b0f4b"],
 " compares up to global phase, so this fixes the label ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "\[Rule]", 
   StyleBox["\[Alpha]", "TI"], " ", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], 
     StyleBox["\[Omega]", "TI"], 
     StyleBox["t", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0f0df5-2071-c96f-4634-a4bf51059bb5"],
 "; the vacuum phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Omega]", "TI"], 
    StyleBox["t", "TI"], "/", "2"}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 " is exact but lies in the global phase that ",
 Cell[BoxData["=="], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 " ignores, and appears only in an amplitude-level comparison.)"
}], "Text",ExpressionUUID->"1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],

Cell[TextData[{
 "What distinguishes this most-classical light from other states is photon \
statistics. The second-order coherence at zero delay, ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["g", "TI"], 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], "2", 
     StyleBox[")",
      SpanMaxSize->1]}]], 
   StyleBox["(",
    SpanMaxSize->1], "0", 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   FractionBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"], 
      SuperscriptBox[
       StyleBox["a", "TI"], "\[Dagger]"], 
      StyleBox["a", "TI"], " ", 
      StyleBox["a", "TI"]}], "\[VeryThinSpace]", 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      RowBox[{
       SuperscriptBox[
        StyleBox["a", "TI"], "\[Dagger]"], 
       StyleBox["a", "TI"]}], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"]], "=", 
   FractionBox[
    RowBox[{
     StyleBox["\[LeftAngleBracket]",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["n", "TI"], 
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       StyleBox["n", "TI"], "-", "1"}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1]}], 
    SuperscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["n", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], "2"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c80315-d7de-7125-4ff7-9b5ee26b400f"],
 ", is the normalized probability of detecting two photons at once; it \
classifies light by photon statistics: antibunched (",
 Cell[BoxData[
  RowBox[{"<", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdf78a7-59a9-97d9-15e5-7101585dfd23"],
 ", nonclassical), coherent (",
 Cell[BoxData[
  RowBox[{"=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 "), and bunched thermal (",
 Cell[BoxData[
  RowBox[{">", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b26917-59e6-8729-3f41-81515f90ea73"],
 ")."
}], "Text",ExpressionUUID->"521ad179-838d-ce9b-0239-c923363994e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g2s", " ", "=", " ", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Fock\>\"", " ", "->", " ", 
     RowBox[{"G2Coherence", "[", 
      RowBox[{"FockState", "[", "1", "]"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<Coherent\>\"", " ", "->", " ", 
     RowBox[{"G2Coherence", "[", 
      RowBox[{
       RowBox[{"CoherentState", "[", "20", "]"}], "[", 
       RowBox[{"1.5", "+", 
        RowBox[{"\[ImaginaryI]", " ", "2"}]}], "]"}], "]"}]}], ",", "\n", 
    "  ", 
    RowBox[{"\"\<Thermal\>\"", " ", "->", " ", 
     RowBox[{"G2Coherence", "[", 
      RowBox[{"ThermalState", "[", 
       RowBox[{"1.0", ",", " ", "20"}], "]"}], "]"}]}]}], "|>"}]}]], "Input",
