Cell["Read its Bloch vector:", "Text",ExpressionUUID->"23a655ec-dad2-e192-515e-4cc9df64b3f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"psi", "[", "\"\<BlochVector\>\"", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Phi]", " ", "\[Element]", " ", "Reals"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
   RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994895358230912*^9, 3.997991255303987*^9, 
  3.997991999063965*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"d17294b2-5789-44cc-b0c6-2d57f3cb7c6d"]
}, Open  ]],

Cell[TextData[{
 "It returns the textbook ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     StyleBox["(",
      FontSize->1.2 Inherited], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"], 
     StyleBox["sin",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Phi]", "TI"]}], ",", " ", 
    RowBox[{
     StyleBox["cos",
      FontSlant->"Plain"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 ". Now run the protocol:"
}], "Text",ExpressionUUID->"75dfb56b-bb47-a02b-23e4-2d353ef3f371"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"out", " ", "=", " ", 
  RowBox[{"tele", "[", 
   RowBox[{"QuantumTensorProduct", "[", 
    RowBox[{"psi", ",", " ", 
     RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"57533ce7-69d6-be0e-7d60-b5c108600554"],

