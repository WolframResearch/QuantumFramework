Cell["\<\
Read the joint distribution of the two syndrome records, the diagonal of \
their reduced density matrix (the records sit on the first two of the five \
wires, the data on the last three):\
\>", "Text",ExpressionUUID->"319e51f9-a9ce-1d21-67a6-48a2c87b640b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Alpha]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", "+", " ", 
       RowBox[{"\[Beta]", "^", "2"}]}], " ", "==", " ", "1"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Diagonal", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"QuantumPartialTrace", "[", 
         RowBox[{"coded", ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}], 
        "[", "\"\<DensityMatrix\>\"", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"26f4962c-805e-a216-4e8b-087631e8f17c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], ",", "0", ",", "0", ",", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "}"}]], "Output",
 CellChangeTimes->{3.994895359543227*^9, 3.997991255385948*^9, 
  3.997992000438347*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"ae59d54e-d266-4af1-91d7-953bd5be300f"]
}, Open  ]],

Cell[TextData[{
 "The four syndrome weights return as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     SuperscriptBox[
      StyleBox["cos",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}], ",", " ", "0", ",", " ", "0", ",", " ", 
    RowBox[{
     SuperscriptBox[
      StyleBox["sin",
       FontSlant->"Plain"], "2"], "\[ThinSpace]", 
     StyleBox["\[Theta]", "TI"]}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313d5a7b-7caf-7acc-60c3-5c25755a4816"],
 ": the continuous rotation has been digitized. The code never sees a partial \
error; it sees \"no error\" with probability ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["cos",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2da78195-91be-94f0-5b5c-18df2048feda"],
 " or \"qubit ",
 Cell[BoxData["2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 " flipped\" with probability ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7d0c35-7157-44bf-6502-a67f00e22e85"],
 ", and the weights are independent of ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Beta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064e3005-d89e-7c03-2e75-aa6ed92b4769"],
 ", which is what \"measuring the syndrome without learning the state\" means."
}], "Text",ExpressionUUID->"76c2caed-aea0-13a2-1ef1-e3b6cb556188"],

Cell[TextData[{
 "The feedforward gates then act inside each branch. The claim to check: the \
corrected state matches the ideal codeword ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Alpha]", "TI"], 
    TemplateBox[{"000"},
     "Ket"]}], "+", 
   RowBox[{
    StyleBox["\[Beta]", "TI"], 
    TemplateBox[{"111"},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260c3025-1fa9-9acd-4e33-a98f9a5de817"],
 " at fidelity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["F", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b1e6c2c-0452-4134-7925-8676ade7101e"],
 ", for every input and every error angle. Compute ",
 Cell[BoxData[
  StyleBox["F", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2982aea8-af87-65d7-5fb1-47f5ca324f3d"],
 " symbolically:"
}], "Text",ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Alpha]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{"\[Beta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]", "^", "2"}], " ", "+", " ", 
       RowBox[{"\[Beta]", "^", "2"}]}], " ", "==", " ", "1"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"QuantumSimilarity", "[", 
      RowBox[{
       RowBox[{"QuantumPartialTrace", "[", 
        RowBox[{"coded", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], ",", "\n", "    ", 
       RowBox[{"enc", "[", 
        RowBox[{"QuantumTensorProduct", "[", 
         RowBox[{
          RowBox[{"QuantumState", "[", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
          RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], "]"}], ",",
        " ", "\"\<Fidelity\>\""}], "]"}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.994895359674239*^9, 3.997991255390918*^9, 
  3.997992000571417*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"960e553d-0298-40a9-bd76-46cd0c0231f1"]
}, Open  ]],

Cell[TextData[{
 "The fidelity returns as exactly ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],
 ", for every input ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Alpha]", "TI"], ",", 
    StyleBox["\[Beta]", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f1a39a-81e0-db80-538e-3ac4379aa9ea"],
 " and every error angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35466be2-b7a8-26dc-637d-82cfc2428c26"],
 ": not a high number for one sampled case, but the digitization-of-errors \
theorem itself, obtained from the computation. (The cell fixes real \
amplitudes so the symbolic fidelity closes cleanly; the result is in fact \
independent of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], ",", 
   StyleBox["\[Beta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bdea72-0ba3-5f4c-0842-0c3cae562596"],
 " and remains ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8cef58-e908-949c-16b3-070588a2fee6"],
 " for complex amplitudes as well.)"
}], "Text",ExpressionUUID->"0abc4047-6c7b-4886-3a44-5a21050e1aec"]
}, Closed]],

Cell[CellGroupData[{

Cell["Run the measurement backwards", "Subsection",ExpressionUUID->"24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],

Cell[TextData[{
 "Because no branch was discarded, the measurement is a reversible \
interaction, and reversible in the laboratory, not only on paper. That a \
partial measurement can be undone while its record stays coherent, before it \
irreversibly decoheres, is an experimental fact: the probabilistic reversal, \
or 'uncollapsing', of a weak measurement has been demonstrated on a \
superconducting phase qubit (Katz et al., ",
 StyleBox["Phys. Rev. Lett.", "TI"],
 ", 2008), returning the qubit to its pre-measurement state on a heralded \
subset of runs. The cell below is the deterministic idealization of that \
result: the exact left inverse ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["V", "TI"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],
 " of a projective measurement's dilation, which undoes the interaction with \
certainty rather than on a selected outcome. QF provides the underlying \
dilation as ",
 Cell[BoxData[
  RowBox[{"m", "[", "\"\<SuperOperator\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2161c865-0900-0907-571e-e24fa8b5586d"],
 ": the isometry ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 " that carries out the measurement by appending the pointer qudit, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["V", "TI"], 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     RowBox[{
      StyleBox["(",
       FontSize->1.2 Inherited], 
      RowBox[{
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["k", "TI"]], 
       TemplateBox[{
         StyleBox["\[Psi]", "TI"]},
        "Ket"]}], 
      StyleBox[")",
       FontSize->1.2 Inherited]}], "\[CircleTimes]", 
     TemplateBox[{
       StyleBox["k", "TI"]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31169419-f57b-983b-672d-0e42fc0feb01"],
 ", mapping the qubit's two-dimensional space into the ",
 Cell[BoxData[
  RowBox[{"2", "\[Times]", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40aa99e8-53bd-499c-70a9-10b266481be6"],
 " system-and-pointer space. Because ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d165407-aaf3-867b-0b2e-4e60ce87ed41"],
 " is an isometry it satisfies ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["V", "TI"], "\[Dagger]"], 
   StyleBox["V", "TI"], "=", 
   StyleBox["I", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75cb8946-a0dc-0da7-23c8-2123d169578d"],
 ", so it has a left inverse ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["V", "TI"], "\[Dagger]"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63688a50-35e7-99e6-1117-2c1a4393ebcc"],
 " that removes the pointer and undoes the measurement. Define that inverse \
as a labeled operator and apply the two in sequence, measure then un-measure. \
Build the input state:"
}], "Text",ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

