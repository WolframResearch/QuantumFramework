      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "}"}], "]"}], ",", " ", 
     RowBox[{"QuantumState", "[", "\"\<00\>\"", "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"76ba63e9-5df8-c241-1e5a-7ab3547290ab"],

