Cell[TextData[{
 "The diagonal returns exactly the tight-binding dispersion ",
 Cell[BoxData[
  RowBox[{
   StyleBox["E", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["k", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", "2", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", "\[Pi]", 
    StyleBox["k", "TI"], "/", 
    StyleBox["N", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46408f14-a324-388b-6e7f-2751d6d68ad1"],
 " at the five Bloch momenta, and the off-diagonal terms vanish: a five-level \
system, diagonalized by a named basis the same way a qubit would be."
}], "Text",ExpressionUUID->"40213c85-9219-7c2b-71de-b5ef27ac4771"]
}, Open  ]],

Cell[CellGroupData[{

Cell["State estimation: tomography from measured counts", "Subsection",ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"],

Cell[TextData[{
 "Tomography is the inverse of measurement: recover an unknown state from the \
statistics of measurements in several bases, and it is part of the same \
object model. The three qubit Pauli bases ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], ",", 
   StyleBox["Y", "TI"], ",", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b3cac94-919f-f08d-6ac3-45de202bc2d7"],
 " are mutually unbiased and together informationally complete: their outcome \
frequencies estimate the three expectations that pin down the density matrix \
through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Rho]", "TI"], "=", 
   FractionBox["1", "2"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["I", "TI"], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["X", "TI"], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Y", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Y", "TI"], "+", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], "\[VeryThinSpace]", 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1], 
   StyleBox["Z", "TI"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "634a1270-2707-566e-1149-943a52b23cb4"],
 ". QF performs the entire procedure. First, pick an unknown state to \
reconstruct:"
}], "Text",ExpressionUUID->"571f0194-b08e-3ab4-7d24-98d1c138889e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"true", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"N", " ", "@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"Pi", "/", "6"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"Pi", "/", "6"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{"Pi", "/", "4"}]}], "]"}]}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"79764466-e076-5945-2f0e-5e4391032baf"],

