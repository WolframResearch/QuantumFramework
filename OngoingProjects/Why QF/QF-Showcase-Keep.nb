           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 1} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[0, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{1}}}, {1}}], {
           Wolfram`QuantumFramework`QuditName[1, "Dual" -> False], 2} -> 
         SparseArray[Automatic, {2}, 0, {1, {{0, 1}, {{2}}}, {1}}]|>], 
      "Picture" -> "Schrodinger", 
      "Label" -> $CellContext`J (Superscript["X", 
          CircleTimes[2]] + Superscript["Y", 
          CircleTimes[2]] + Superscript["Z", 
          CircleTimes[2]]), "ParameterSpec" -> {{$CellContext`t, 0, 1}}|>]]], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.9948953475364113`*^9, 3.997991254210726*^9, 
  3.9979920914025507`*^9},
 CellLabel->
  "Out[184]//TraditionalForm=",ExpressionUUID->"19667740-9d1a-43dc-a21f-\
4a016909c684"]
}, Open  ]],

Cell[TextData[{
 "The evolved ket displays in closed form: the excitation oscillates \
coherently between ",
 Cell[BoxData[
  TemplateBox[{"01"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"10"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 " at angular frequency ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["J", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 ", within an overall phase ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   StyleBox[
    RowBox[{"i", "J", "t"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 ". Now read off the entanglement entropy of one qubit as a function of time, \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["S", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", "-", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    FontSize->1.2 Inherited], 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], 
   SubscriptBox[
    StyleBox["log",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], 
   StyleBox["]",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Rho]", "TI"], "1"], "=", 
   RowBox[{
    SubscriptBox[
     StyleBox["Tr",
      FontSlant->"Plain"], "2"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Ket"], 
    TemplateBox[{
      RowBox[{
        StyleBox["\[Psi]", "TI"], 
        StyleBox["(", SpanMaxSize -> 1], 
        StyleBox["t", "TI"], 
        StyleBox[")", SpanMaxSize -> 1]}]},
     "Bra"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 ", the standard measure of how entangled the two spins have become and a \
derived, nonlinear quantity:"
}], "Text",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"s", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"QuantumPartialTrace", "[", 
      RowBox[{"psit", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<VonNeumannEntropy\>\"", 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"t", " ", ">", "0"}], "&&", 
     RowBox[{"J", " ", "\[Element]", " ", "Reals"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.997992125625887*^9, 3.997992128180505*^9}},
 CellLabel->
  "In[189]:=",ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{"Log", "[", 
        RowBox[{"4", " ", 
          SuperscriptBox[
           RowBox[{"Csc", "[", 
             RowBox[{"4", " ", "J", " ", "t"}], "]"}], "2"]}], "]"}], "+", 
      RowBox[{
        RowBox[{"Cos", "[", 
          RowBox[{"4", " ", "J", " ", "t"}], "]"}], " ", 
        RowBox[{"Log", "[", 
          SuperscriptBox[
           RowBox[{"Tan", "[", 
             RowBox[{"2", " ", "J", " ", "t"}], "]"}], "2"], "]"}]}]}], 
    RowBox[{"Log", "[", "4", "]"}]], "\"b\"", "bits", "\"Bits\""},
  "Quantity"]], "Output",
 CellChangeTimes->{3.994895347887991*^9, 3.997991254220503*^9, 
  3.997992094930798*^9, 3.997992131063435*^9},
 CellLabel->
  "Out[189]=",ExpressionUUID->"a524189d-a731-4a11-b355-232d411e0e62"]
}, Open  ]],

Cell[TextData[{
 "QF returns the entire curve as a formula in ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a140e-d97a-4136-69b9-8e6bd80f101c"],
 " and ",
 Cell[BoxData[
  StyleBox["J", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 ": the binary entropy of the two oscillating populations, zero whenever the \
state is a product, a full bit at the Bell points, periodic with the exchange \
oscillation. Because it is a formula, it can be differentiated, expanded, or \
solved in closed form, and the same approach extends to larger symbolic spin \
chains."
}], "Text",ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "Plot it (at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["J", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 "):"
}], "Text",ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"s", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{"J", " ", "->", " ", "1"}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "Pi"}], "}"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<time  J t\>\"", ",", 
      " ", "\"\<entanglement entropy  S(t)  [bits]\>\""}], "}"}]}], ",", " ", 
   
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "1.05"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

