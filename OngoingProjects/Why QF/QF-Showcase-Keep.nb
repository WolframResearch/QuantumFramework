Cell[TextData[{
 "Form the energy ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Bra"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["X", "TI"], "+", 
     StyleBox["Z", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{
     StyleBox["\[Psi]", "TI"]},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0217c2-6a7a-d359-2631-8eac0f0ca1a3"],
 ":"
}], "Text",ExpressionUUID->"4104c6da-03d7-a765-773b-df84b6630a4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"energy", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"psi", "[", "\"\<StateVector\>\"", "]"}], "]"}], " ", ".", " ", 
     
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], " ", "+", " ", 
          RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}], ")"}], "[", 
        "psi", "]"}], ")"}], "[", "\"\<StateVector\>\"", "]"}]}], ",", " ", 
    RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{3.994895730802669*^9},
 CellLabel->"In[48]:=",ExpressionUUID->"731f4b84-5335-8b87-2125-62ee66c1d9ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
  RowBox[{"Sin", "[", "\[Theta]", "]"}]}]], "Output",
 CellChangeTimes->{3.994895731541832*^9, 3.997991256365299*^9, 
  3.99799187254506*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"656d98f8-aa3e-40ae-aece-9cb810cec78b"]
}, Open  ]],

Cell[TextData[{
 "Pass it to ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "315717aa-70ab-e706-676c-8ef4015fca6c"],
 ":"
}], "Text",ExpressionUUID->"7c1b1617-f81f-7a45-2438-8850f9aa48af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"\[Theta]", " ", "\[Element]", " ", "Reals"}], ",", " ", 
   RowBox[{
    RowBox[{"Maximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"energy", ",", " ", 
        RowBox[{"0", " ", "<=", " ", "\[Theta]", " ", "<=", " ", 
         RowBox[{"2", " ", "Pi"}]}]}], "}"}], ",", " ", "\[Theta]"}], "]"}], 
    " ", "//", " ", "FullSimplify"}]}], "]"}]], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"70b05f1a-470c-9c9d-2040-574472bee6e7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SqrtBox["2"], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", "\[Rule]", 
     FractionBox["\[Pi]", "4"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994895375710693*^9, 3.997991256383254*^9, 
  3.997991872605549*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"cfe71d46-5256-4555-8b8b-2801d0fc05c5"]
}, Open  ]],

Cell[TextData[{
 "The energy is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a8c5b06-7c6a-07f5-7ab4-5360751f6ddf"],
 ", and ",
 Cell[BoxData["Maximize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fa3f928-0446-c8dd-7550-f172adf09a27"],
 " returns ",
 Cell[BoxData[
  SqrtBox["2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3727240c-f62b-7b8f-5edc-be6983de49d5"],
 " at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", "\[Pi]", "/", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50637aef-2122-41f7-0011-73c950d713dd"],
 ": the exact extremal value, recognizable as the operator norm of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "+", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63773809-2d44-01f7-110c-b25344f153dd"],
 ", a complete variational eigenvalue calculation done by composing objects \
with native arithmetic and optimization. The same approach certifies a \
physical threshold. The Werner state's realignment criterion, a quantity \
positive exactly when it witnesses entanglement, is a symbolic function of \
the mixing ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ede8b7e-b317-5b7c-26e5-233bc6a22646"],
 ":"
}], "Text",ExpressionUUID->"75c8f24b-f46e-7672-23f7-f414fd1b5d58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"crit", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"QuantumEntanglementMonotone", "[", 
     RowBox[{
      RowBox[{"QuantumState", "[", 
       RowBox[{"\"\<Werner\>\"", "[", 
        RowBox[{"p", ",", " ", "2"}], "]"}], "]"}], ",", 
      " ", "\"\<Realignment\>\""}], "]"}], ",", " ", 
    RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.994895738684944*^9, 3.994895739741537*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"2d149507-d3df-875e-5b2b-0d60e66beda4"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    RowBox[{"Abs", "[", 
     RowBox[{"3", "-", 
      RowBox[{"4", " ", "p"}]}], "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.994895740367182*^9, 3.997991256390421*^9, 
  3.997991872636095*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"2ff90d8f-bf80-4468-a4aa-2f383b1525c5"]
}, Open  ]],

Cell["Turn the criterion into the exact entanglement threshold:", "Text",ExpressionUUID->"772d62ae-4bf9-dab0-1ed3-7b086d8da89a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"crit", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"0", " ", "<", " ", "p", " ", "<", " ", "1"}]}], ",", " ", "p"}], 
  "]"}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"7a8c9a4d-0caa-515e-2ab3-1c17a55f23a4"],

Cell[BoxData[
 RowBox[{"0", "<", "p", "<", 
  FractionBox["1", "2"]}]], "Output",
 CellChangeTimes->{3.994895375738675*^9, 3.9979912564389*^9, 
  3.997991872640896*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"fbdcb825-8c5f-49ba-b527-b06c7f2c392d"]
}, Open  ]],

Cell[TextData[{
 "The criterion is ",
 Cell[BoxData[
  FractionBox[
   RowBox[{GridBox[{
      {
       RowBox[{"3", "-", "4", 
        StyleBox["p", "TI"]}]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "-", "1"}], "2"]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a4c6a75-6554-e0e6-1a73-8c3f0ce6b2cc"],
 ", and ",
 Cell[BoxData["Reduce"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29c3108e-8c9d-f317-5ff0-89e82529de7d"],
 " turns it into the exact threshold: the Werner state is entangled precisely \
for ",
 Cell[BoxData[
  RowBox[{"0", "<", 
   StyleBox["p", "TI"], "<", 
   FractionBox["1", "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b90d741-2df1-4c37-09af-cf2b4b84171d"],
 ", a physical fact certified by passing a QF-derived expression to a native \
solver."
}], "Text",ExpressionUUID->"5a353f88-1ea4-a3d5-0bca-b6d29b56f13f"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Claim 6: Every object draws itself", "Section",ExpressionUUID->"3c3a5085-d835-7232-65da-49eed9c04118"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " Claim 5 let the kernel's functions read an object; here the object draws \
itself. Visualization is property dispatch, not a separate plotting library: \
each object provides plot properties that render through the Wolfram Language \
graphics system and forward its options, so a publication figure is one call \
on the object it depicts. The set of views is wide. States draw as Bloch \
vectors, amplitude and probability charts, and qudit pie and sector wheels; \
measurements as outcome histograms; stabilizer states as their binary \
symplectic tableau; circuits as gate diagrams, tensor-network graphs, and \
multiway and causal views. Adiabatic evolutions add spectrum, gap, and \
coupling plots (in the ",
 Cell[BoxData["QuantumOptimization"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f71b61d-3801-a1b0-550e-2847b9b5f39a"],
 " sub-package), the underlying ",
 Cell[BoxData["TensorNetwork"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c7c9f19-7bfc-9bea-6403-17437d8ee930"],
 " renders as a hypergraph through the TensorNetworks paclet, and the \
phase-space objects of Claim 2 plot as Wigner surfaces. Below, one example \
per object kind."
}], "Text",ExpressionUUID->"4bcd3c0f-0044-41be-79f2-b669b1f11384"],

Cell[CellGroupData[{

Cell["A state on the Bloch sphere", "Subsection",ExpressionUUID->"250574e2-7568-dee6-533b-6dcc7c02a4cc"],

Cell["A single qubit draws its own Bloch vector:", "Text",ExpressionUUID->"570dea5b-028b-2dc3-7d32-0c05b73e7729"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", "/", "5"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", "/", "5"}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"Pi", "/", "3"}]}], "]"}]}]}], "}"}], "]"}], 
  "[", "\"\<BlochPlot\>\"", "]"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"559114f0-95cd-3728-03ae-8dba1c799a72"],

