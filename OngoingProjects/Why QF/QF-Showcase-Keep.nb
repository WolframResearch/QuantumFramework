Cell["Read its label and its Pauli decomposition:", "Text",ExpressionUUID->"2226f602-e60c-c55a-53dd-e86f93beafa0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"hab", "[", "\"\<Label\>\"", "]"}], ",", " ", 
   RowBox[{"hab", "[", "\"\<PauliDecompose\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"4ed808ee-885a-0ea1-76e7-a1c829ef548b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"\<\"X\"\>", " ", "a"}], "+", 
    RowBox[{"\<\"Z\"\>", " ", "b"}]}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"X\"\>", "\[Rule]", "a"}], ",", 
     RowBox[{"\<\"Z\"\>", "\[Rule]", "b"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9948953750976133`*^9, 3.997991256289089*^9, 
  3.997991871921192*^9},
 CellLabel->"Out[40]=",ExpressionUUID->"9f211f13-d055-4ab0-ac75-1446f4a8e653"]
}, Open  ]],

Cell[TextData[{
 "The operator carries the label ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], " ", 
   StyleBox["X", "TI"], "+", 
   StyleBox["b", "TI"], " ", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1627cdbb-2852-50d0-3fdc-e4e549e7223a"],
 ", and ",
 Cell[BoxData[
  RowBox[{"hab", "[", "\"\<PauliDecompose\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801141d-c5dc-e96b-183e-8e46ec6ebbb1"],
 " returns ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"X", " ", "->", " ", "a"}], ",", " ", 
    RowBox[{"Z", " ", "->", " ", "b"}]}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fb5e010-3b47-28f4-554a-fa5abef27ade"],
 ": a round-trip through the algebra, coefficients in by arithmetic and back \
out by decomposition, on a symbolic operator rather than a numeric lookup \
table. The algebra goes beyond arithmetic. The kernel's ",
 Cell[BoxData["Commutator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69461d9a-9714-a717-1f7d-94c422a60a7d"],
 " gives the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], 
   StyleBox["u", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], "2", 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b3cd9b2-b2f5-0832-4ac3-d0ffc6805b18"],
 " relation as an operator identity:"
}], "Text",ExpressionUUID->"17254721-59fc-dba5-3edb-5e8b5f8ea98f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Commutator", "[", 
   RowBox[{
    RowBox[{"QuantumOperator", "[", "\"\<X\>\"", "]"}], ",", " ", 
    RowBox[{"QuantumOperator", "[", "\"\<Y\>\"", "]"}]}], "]"}], " ", "==", 
  " ", 
  RowBox[{"2", " ", "I", " ", 
   RowBox[{"QuantumOperator", "[", "\"\<Z\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"52d6b4d2-7b23-95d3-02ed-2d9c7ed7ff39"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.994895375171864*^9, 3.997991256298724*^9, 
  3.997991872009488*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"b21eba66-a437-47a7-be64-24aadbb61b9d"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133f88c9-4e43-c7a8-42c4-21936bf7adf2"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["X", "TI"], ",", 
    StyleBox["Y", "TI"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "2", 
   StyleBox["i", "TI"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "525bf512-066b-f79b-0278-ed5cb31fdde1"],
 ", computed on the operators and verified against ",
 Cell[BoxData[
  RowBox[{"2", 
   StyleBox["i", "TI"], 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7020b0a8-e1ec-de26-21df-29f5979ea50c"],
 "."
}], "Text",ExpressionUUID->"6f4e56ea-c348-0e14-1576-4fb7f6fd557e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Operator calculus: recover ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c7820da-3afe-8c15-5407-b984be88d77f"],
 " from a target ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "491026a6-dd30-329c-7f2f-bf03d4ca80e6"]
}], "Subsection",ExpressionUUID->"78f9e5c0-5bc5-e73b-2886-fcaa5e71ca01"],

Cell[TextData[{
 "Claim 1 solved Hamiltonians forward into their propagators; the inverse is \
pure operator calculus. Choose a unitary trajectory ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "295a1104-8f0a-9295-5f79-896e2abce0ff"],
 ", and the Hamiltonian that drives it is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["i", "TI"], " ", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34e49fcf-314b-942d-5c9b-16a940ffff77"],
 ", the basis of counterdiabatic driving and shortcuts to adiabaticity. \
Compose the target ",
 Cell[BoxData[
  RowBox[{
   StyleBox["U", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Z", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["t", "TI"], "2"], 
   StyleBox[")",
    SpanMaxSize->1], " ", 
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["X", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["t", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28081ee1-9923-6846-5837-97cb18d63aac"],
 " from named gates:"
}], "Text",ExpressionUUID->"35d104ab-d16d-b332-63ee-9df4e0191e18"],

