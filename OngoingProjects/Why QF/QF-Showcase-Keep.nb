Cell[TextData[{
 "The ket returns as ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    SqrtBox["8"]], 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["x", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], "1"], 
       SubscriptBox[
        StyleBox["x", "TI"], "2"], "+", 
       SubscriptBox[
        StyleBox["x", "TI"], "2"], 
       SubscriptBox[
        StyleBox["x", "TI"], "3"]}]], 
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], 
         SubscriptBox[
          StyleBox["x", "TI"], "2"], 
         SubscriptBox[
          StyleBox["x", "TI"], "3"]}]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62f1d7f5-6807-0c72-128e-cebf09b25758"],
 ": a uniform superposition over all eight bitstrings whose sign is fixed by \
the two cluster bonds, negative exactly on ",
 Cell[BoxData["011"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e2af966-75ba-f15e-4629-f1407c4cc3a4"],
 " and ",
 Cell[BoxData["110"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcb302b-9e92-9019-25c8-aa751b24e363"],
 ", the tableau expanded into exact amplitudes. The agreement with the \
default engine is not approximate; check it with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "361ba0ac-b25b-03c3-5e38-3909c7ee5129"],
 ", the language's structural identity:"
}], "Text",ExpressionUUID->"36c5768f-9366-0c29-5efb-6fe926135773"],

