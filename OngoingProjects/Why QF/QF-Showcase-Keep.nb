Cell["Read its label and its matrix (trig-simplified):", "Text",ExpressionUUID->"3d32ba1d-71ed-60b8-64c1-3c4707983282"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"uexp", "[", "\"\<Label\>\"", "]"}], ",", " ", "\n", " ", 
   RowBox[{"MatrixForm", "@", 
    RowBox[{"FullSimplify", " ", "@", " ", 
     RowBox[{"ExpToTrig", " ", "@", " ", 
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{"uexp", "[", "\"\<Matrix\>\"", "]"}]}]}]}]}]}], "}"}]], "Input",\

 CellLabel->"In[38]:=",ExpressionUUID->"3ccd4f42-4869-4b08-64f3-672c691c1652"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\<\"X\"\>", " ", "t"}]], ",", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"Cos", "[", "t", "]"}], 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"Sin", "[", "t", "]"}]}]},
       {
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], 
        RowBox[{"Cos", "[", "t", "]"}]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}], "}"}]], "Output",
 CellChangeTimes->{3.994895375020773*^9, 3.997991256274954*^9, 
  3.997991871832324*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"b417c6b2-2336-4c24-9f08-2f58db4ad0e9"]
}, Open  ]],

Cell[TextData[{
 "The result is a new ",
 Cell[BoxData["QuantumOperator"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cf63df4-f608-7ba6-348d-b4b183bd498c"],
 " whose label reads ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["X", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60948258-d69f-7f2c-10ab-2405e32a4276"],
 " and whose matrix is the ",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bf5c13c-8c81-f0bf-098a-d9662535c285"],
 "-rotation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"], " ", 
   StyleBox["I", "TI"], "-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"], " ", 
   StyleBox["X", "TI"], "=", 
   StyleBox["(",
    FontSize->1.2 Inherited], GridBox[{
     {
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}]},
     {
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}], 
      RowBox[{
       StyleBox["cos",
        FontSlant->"Plain"], "\[ThinSpace]", 
       StyleBox["t", "TI"]}]}
    }], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27ebc314-3813-af61-4de8-db5eb9a7f24b"],
 ". ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59cd495b-92f8-de82-0ff3-61052772a4e8"],
 " performed a genuine matrix exponential on the operator, mixing the two \
levels through the off-diagonal ",
 Cell[BoxData[
  RowBox[{"-", 
   StyleBox["i", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["t", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1597811c-d04f-58d0-43ac-1959e1fa2a3a"],
 " rather than exponentiating entries one by one, and the generator was never \
reduced to a number-matrix first. (",
 Cell[BoxData[
  RowBox[{"MatrixExp", "[", "...", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d69ae9d-d0a3-a5e3-3b16-47c6e1570fc9"],
 " returns the identical operator.)"
}], "Text",ExpressionUUID->"1e10fbdd-fcac-b923-462f-f286f55e0809"]
}, Closed]],

