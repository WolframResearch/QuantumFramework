Cell[CellGroupData[{

Cell["Claim 2: One object model spans all of quantum theory", "Section",ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"],

Cell[TextData[{
 StyleBox["Key feature:",
  FontWeight->"Bold"],
 " Claim 1 developed the symbolic dynamics of one object in depth; this claim \
shows the breadth of the object model. QF provides whole categories of object \
beyond unitary gates: open systems, generalized measurements, \
continuous-variable optics, phase space, and state estimation. Two properties \
hold throughout the model: every object carries its basis, and every object \
is defined in any finite dimension, qutrits and ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 "-level systems as readily as qubits. The subject here is scope, the range \
of quantum theory that QF represents as objects one computes with directly."
}], "Text",ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell[CellGroupData[{

Cell["An open-system object: a quantum channel", "Subsection",ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[TextData[{
 "A noise process is its own object, a ",
 Cell[BoxData["QuantumChannel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b416c07-c3d3-bf4f-097e-8660f6670595"],
 ", not a gate. Take a generic pure qubit on the Bloch sphere, polar angle ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5add4728-e92e-eff1-0ae3-5f7588d8b5db"],
 " and azimuth ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 ", and confirm it is pure through the purity ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   SuperscriptBox[
    StyleBox["\[Rho]", "TI"], "2"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 ", which equals ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d3ffb2e-09a8-fc78-24c4-f288a842c742"],
 " exactly for a pure state and drops below ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4139b36b-52b1-2977-70c6-2b356744785d"],
 " for a mixed one. Build the state:"
}], "Text",ExpressionUUID->"494d6e39-7750-b6eb-7f72-806302ea1c31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"psi", " ", "=", " ", 
  RowBox[{"QuantumState", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", "\[Phi]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}]}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"39b01e29-d171-5c92-6f4f-9072e00426f8"],

