  TemplateBox[{
    SubsuperscriptBox[
     StyleBox["J", "TI"], "1", 
     StyleBox["x", "TI"]]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04cac1af-436c-9192-2cc9-d809761ee3f8"],
