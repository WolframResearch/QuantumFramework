Cell[TextData[{
 "The peak iteration count from the exact rotation angle, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   StyleBox["round",
    FontSlant->"Plain"], "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   FractionBox["\[Pi]", 
    RowBox[{"4", 
     StyleBox["\[Theta]", "TI"]}]], "-", 
   FractionBox["1", "2"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Theta]", "TI"], "=", 
   StyleBox["arcsin",
    FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   SqrtBox[
    RowBox[{"1", "/", 
     StyleBox["N", "TI"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d3de1d4-e864-19c9-04c2-f89189116b13"],
 " (which is ",
 Cell[BoxData["12"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1adc8861-0296-99d3-4ae3-224bb720eb39"],
 " here, where the coarser ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftFloor]",
    SpanMaxSize->1], 
   RowBox[{
    FractionBox["\[Pi]", "4"], 
    SqrtBox[
     StyleBox["N", "TI"]]}], 
   StyleBox["\[RightFloor]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47f3727e-1788-b883-6d81-7438a2220ae9"],
 " agrees):"
}], "Text",ExpressionUUID->"02bfa0ec-e0fe-2fa7-3244-39c9908b758d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kopt", " ", "=", " ", 
   RowBox[{"Round", "[", 
    RowBox[{
     RowBox[{"Pi", "/", 
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"ArcSin", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "/", 
           RowBox[{"2", "^", "n"}]}], "]"}], "]"}]}], ")"}]}], " ", "-", " ", 
     
     RowBox[{"1", "/", "2"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"7cc1833e-1ead-5711-24fe-1b789b583a7b"],

Cell[TextData[{
 "The full search: a Hadamard layer, then ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cb4236e-91b2-9328-644b-bb482044fe72"],
 " stacked iterations:"
}], "Text",ExpressionUUID->"631da35c-735e-7e3b-1122-3b0606eb4501"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"grover", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "n", "]"}]}], "]"}], ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"step", ",", " ", "kopt"}], "]"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"44b7daea-ed84-b50e-6c4c-d3b784361c54"],

