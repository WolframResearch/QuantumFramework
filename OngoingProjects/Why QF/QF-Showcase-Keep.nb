Cell[TextData[{
 "Differentiate it as an operator with the kernel's ",
 Cell[BoxData["D"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bb02784-750c-cc73-794f-beee7cbe9759"],
 " and close it with the operator's own ",
 Cell[BoxData["Dagger"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6368bf1a-89ab-f709-1117-3744285fda53"],
 ", forming ",
 Cell[BoxData[
  RowBox[{
   StyleBox["H", "TI"], "=", 
   StyleBox["i", "TI"], " ", 
   OverscriptBox[
    StyleBox["U", "TI"], "."], " ", 
   SuperscriptBox[
    StyleBox["U", "TI"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18aa8291-c565-6e81-48a9-1bdaec1034eb"],
 ":"
}], "Text",ExpressionUUID->"0fb37437-3ad9-e813-3541-6e71bf6dbb79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hdrive", " ", "=", " ", 
