       Dynamic[Typeset`open$$], ImageSize -> Automatic]},
     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  Wolfram`QuantumFramework`QuantumState[
  SparseArray[
   Automatic, {2, 2}, 0, {
    1, {{0, 2, 4}, {{1}, {2}, {1}, {2}}}, {
     Cos[Rational[1, 2] $CellContext`\[Theta]] 
       Cos[Rational[1, 2] Conjugate[$CellContext`\[Theta]]] + 
      E^(Complex[0, 1] $CellContext`\[Phi] + 
         Complex[0, -1] Conjugate[$CellContext`\[Phi]]) $CellContext`\[Gamma]^
        Rational[1, 2] Conjugate[$CellContext`\[Gamma]^Rational[1, 2]] 
       Sin[Rational[1, 2] $CellContext`\[Theta]] 
       Sin[Rational[1, 2] Conjugate[$CellContext`\[Theta]]], 
      E^(Complex[0, -1] Conjugate[$CellContext`\[Phi]]) 
      Conjugate[(1 - $CellContext`\[Gamma])^Rational[1, 2]] 
      Cos[Rational[1, 2] $CellContext`\[Theta]] 
      Sin[Rational[1, 2] Conjugate[$CellContext`\[Theta]]], 
      E^(Complex[0, 1] $CellContext`\[Phi]) (1 - $CellContext`\[Gamma])^
       Rational[1, 2] Cos[Rational[1, 2] Conjugate[$CellContext`\[Theta]]] 
      Sin[Rational[1, 2] $CellContext`\[Theta]], 
      E^(Complex[0, 1] $CellContext`\[Phi] + 
        Complex[0, -1] Conjugate[$CellContext`\[Phi]]) (
        1 - $CellContext`\[Gamma])^Rational[1, 2] 
      Conjugate[(1 - $CellContext`\[Gamma])^Rational[1, 2]] 
      Sin[Rational[1, 2] $CellContext`\[Theta]] 
      Sin[Rational[1, 2] Conjugate[$CellContext`\[Theta]]]}}], 
   Wolfram`QuantumFramework`QuantumBasis[<|
    "Input" -> Wolfram`QuantumFramework`QuditBasis[<|{
          
