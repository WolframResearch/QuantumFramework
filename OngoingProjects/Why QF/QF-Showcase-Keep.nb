  TemplateBox[{"+"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25b5b884-ef74-61b3-534a-31e18a013399"],
 ", an equal superposition over all cuts:"
}], "Text",ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

