   SqrtBox[
    SubscriptBox[
     StyleBox["\[Gamma]", "TI"], "1"]], " ", 
   SubscriptBox[
    StyleBox["\[Sigma]", "TI"], "-"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
