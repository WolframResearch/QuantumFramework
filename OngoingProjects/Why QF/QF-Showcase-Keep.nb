     Line3DBox[{{0, 1, 0}, {0, -1, 0}}], Line3DBox[{{0, 0, 1}, {0, 0, -1}}], 
     Line3DBox[{{1, 0, 0}, {-1, 0, 0}}], Text3DBox[
      TemplateBox[{"0"},
       "Ket"], {0, 0, 1.3}], Text3DBox[
      TemplateBox[{"1"},
       "Ket"], {0, 0, -1.3}], Text3DBox[
      TemplateBox[{"\"R\""},
       "Ket"], {0, 1.3, 0}], Text3DBox[
      TemplateBox[{"\"L\""},
       "Ket"], {0, -1.3, 0}], Text3DBox[
      TemplateBox[{"\"+\""},
       "Ket"], {1.3, 0, 0}], Text3DBox[
      TemplateBox[{"\"-\""},
       "Ket"], {-1.3, 0, 0}], 
     {RGBColor[1, 0, 0], Arrowheads[0.05], 
