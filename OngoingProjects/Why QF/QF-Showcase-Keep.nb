Cell[TextData[{
 "The display is the sign column beside a ten-by-ten binary grid, dividers \
separating the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],
 " bits from the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122b6086-f39f-774a-4229-79e3862a5d90"],
 " bits and the destabilizer rows from the stabilizer rows; the stabilizer \
rows are the five ring generators ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["K", "TI"], 
    StyleBox["v", "TI"]], "=", 
   SubscriptBox[
    StyleBox["X", "TI"], 
    StyleBox["v", "TI"]], 
   UnderscriptBox["\[Product]", 
    RowBox[{
     StyleBox["w", "TI"], "\[Tilde]", 
     StyleBox["v", "TI"]}],
    LimitsPositioning->False], 
   SubscriptBox[
    StyleBox["Z", "TI"], 
    StyleBox["w", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],
 ", so the ",
 Cell[BoxData[
  StyleBox["z", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a176158-c8f1-b5ca-1a2d-7905e8851f10"],
 " block is literally the adjacency matrix of the cycle while the ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59294b9d-2c6b-0af3-08d7-62c7451e58d9"],
 " block is the identity. This view is the algebra itself: the entanglement \
geometry of the ring is drawn in the binary pattern, and a Clifford gate acts \
by rewriting a few columns of this grid."
}], "Text",ExpressionUUID->"4c93342e-976f-2690-74a0-ad88221b8cfa"]
}, Closed]],

Cell[CellGroupData[{

Cell["The circuit, and the network behind it", "Subsection",ExpressionUUID->"0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],

Cell["\<\
A circuit draws itself as a gate diagram. Take quantum phase estimation, the \
subroutine inside Shor's factoring and the HHL linear solver, on three \
counting qubits:\
\>", "Text",ExpressionUUID->"386c40c3-2c7c-2bd7-6814-59ad4509793d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"qpe", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{"\"\<PhaseEstimation\>\"", "[", "3", "]"}], "]"}]}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"38a5d185-6c33-4099-685a-c8ef05c612e3"],

