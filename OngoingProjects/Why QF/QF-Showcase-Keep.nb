Cell[TextData[{
 "Apply the Born rule ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["\[Rho]", "TI"], " ", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     StyleBox["i", "TI"]]}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
 " to all four effects at once:"
}], "Text",ExpressionUUID->"66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"probs", " ", "=", " ", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"psi", "[", "\"\<DensityMatrix\>\"", "]"}], " ", ".", " ", 
         RowBox[{"Normal", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
      " ", 
      RowBox[{"sic", "[", "\"\<POVMElements\>\"", "]"}]}], "]"}], "]"}], "//",
    "Chop"}]}]], "Input",
 CellChangeTimes->{{3.999165510371315*^9, 3.99916551121248*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "4"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "-", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "-", 
      RowBox[{
       SqrtBox["2"], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Phi]", "]"}], "+", 
         RowBox[{
          SqrtBox["3"], " ", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "-", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "-", 
      RowBox[{
       SqrtBox["2"], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
      RowBox[{
       SqrtBox["6"], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "-", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
      RowBox[{"2", " ", 
       SqrtBox["2"], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], "}"}]], "Output",\

 CellChangeTimes->{
  3.994895351161661*^9, 3.997991254672068*^9, 3.997992004203554*^9, {
   3.999165502595538*^9, 3.999165511623139*^9}, 3.999165656960485*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"75f66e43-5d8b-4d3f-b415-41d69ba14a92"]
}, Open  ]],

Cell[TextData[{
 "The four probabilities return exactly as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], "=", 
   FractionBox["1", "4"], 
   StyleBox["(",
    FontSize->1.2 Inherited], "1", "+", 
   OverscriptBox[
    StyleBox["r", "TI"], "^"], "\[CenterDot]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["n", "TI"], "^"], 
    StyleBox["i", "TI"]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],
 ", the first reading ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"1", "+", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["\[Theta]", "TI"]}], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
 " and the others ",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", "12"], 
   StyleBox["(",
    FontSize->1.2 Inherited], "3", "-", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], "+", 
   SqrtBox["2"], " ", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"], " ", 
   StyleBox["(",
    SpanMaxSize->1], "\[Ellipsis]", 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 " along the remaining tetrahedron directions ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["i", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64adc082-4122-deff-0c52-d9ec70d4a4c5"],
 ", with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["r", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e451771-8a55-ceec-267a-8f3b2fe19436"],
 " the state's Bloch vector; they sum to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " identically (verified). Pin the state to the north pole and the general \
formulas collapse to numbers:"
}], "Text",ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"probs", " ", "/.", " ", 
  RowBox[{"\[Theta]", " ", "->", " ", "0"}]}]], "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "2"], ",", 
   FractionBox["1", "6"], ",", 
   FractionBox["1", "6"], ",", 
   FractionBox["1", "6"]}], "}"}]], "Output",
 CellChangeTimes->{3.9948953511685543`*^9, 3.997991254682082*^9, 
  3.99799200422007*^9},
 CellLabel->
  "Out[113]=",ExpressionUUID->"00f27ff2-aa3a-42a1-9ecf-2d424b5f60f0"]
}, Open  ]],

Cell[TextData[{
 "The distribution collapses to simple rationals: ",
 Cell[BoxData[
  TemplateBox[{"0"},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " assigns probability one half to the tetrahedron vertex nearest the pole \
and one sixth to each of the other three. Because the SIC is informationally \
complete, these four probabilities are not merely statistics of the state; \
they determine the state: ",
 Cell[BoxData[
  StyleBox["\[Theta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 " and ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 " can be recovered from them, which is what makes SIC measurements a natural \
basis for tomography."
}], "Text",ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell["\<\
The SIC is not only a symbolic Born-rule calculation; it is a measurement \
that drops directly into a circuit, alongside the gates, on any chosen wire. \
Place the tetrahedron SIC as a measurement on the first qubit:\
\>", "Text",ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

