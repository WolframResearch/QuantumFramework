Cell[TextData[{
 "The sum collapses to the zero vector: the object satisfies the harmonic \
identity ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     SuperscriptBox[
      StyleBox["\[Psi]", "TI"], "\[DoublePrime]"]},
    "Ket"], "=", 
   RowBox[{"-", 
    TemplateBox[{
      StyleBox["\[Psi]", "TI"]},
     "Ket"]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e555e8f-0ad0-492d-166b-57e9af651877"],
 " through WL's own calculus, the second derivative taken on the ",
 Cell[BoxData["QuantumState"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348b0551-d20e-4e96-5c88-9d1ae7bb14fc"],
 " directly."
}], "Text",ExpressionUUID->"5c065349-950a-8738-043e-4b131cbcea02"]
}, Closed]],

Cell[CellGroupData[{

Cell["The scalars flow into solvers", "Subsection",ExpressionUUID->"4ff276a9-5e86-52e3-7582-6ff35b3320c9"],

Cell[TextData[{
 "When a QF object yields a symbolic scalar, the language's solvers take \
over. The expectation of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["X", "TI"], "+", 
   StyleBox["Z", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24b6e2ad-c501-b7fc-4c4d-fbf6ecb51dc6"],
 " in the trial state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["Y", "TI"]], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}], 
   TemplateBox[{"0"},
    "Ket"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230cad6b-7900-e120-5133-453578bab00a"],
 " is a closed form. Build the trial state:"
}], "Text",ExpressionUUID->"086f7f71-a7b7-bd3e-3815-773ad2430404"],

