Cell["Read the reconstructed density matrix:", "Text",ExpressionUUID->"7d5c93fe-a057-3a16-2b63-0abbd1e3897c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"est", "[", "\"\<MaximumLikelihoodState\>\"", "]"}], 
    "[", "\"\<DensityMatrix\>\"", "]"}], " ", "//", " ", "Normal"}], " ", "//",
   " ", "Chop"}]], "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.7514422909036321`", ",", 
     RowBox[{"0.301830527771225`", "\[VeryThinSpace]", "-", 
      RowBox[{"0.3093139292862141`", " ", "\[ImaginaryI]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"0.301830527771225`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.3093139292862141`", " ", "\[ImaginaryI]"}]}], ",", 
     "0.24855770909636793`"}], "}"}]}], "}"}]], "Output",
