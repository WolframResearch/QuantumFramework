Cell[TextData[{
 "The result is a ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e45bb6-31a6-d4bb-379c-52f04050be81"],
 " with probabilities ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "638a875f-059e-01af-1189-1f19ac2b53f5"],
 " at ",
 Cell[BoxData["000"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1c9c05-9360-5fc6-6923-166f2615252c"],
 " and ",
 Cell[BoxData[
  FractionBox["1", "2"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8f8704-dbc1-ad9f-5bb4-1f61de75f7e5"],
 " at ",
 Cell[BoxData["111"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bacb1bf-0091-7884-2953-28f9b1244aee"],
 ". Once the job completes, the hardware outcome comes back as the same kind \
of ",
 Cell[BoxData["QuantumMeasurement"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e949b39-c960-dcff-16ab-1362e81aa6c5"],
 " object, decoded into the same qubit order:"
}], "Text",ExpressionUUID->"52d3365b-85bc-1911-02e0-a8052c49687b"],

