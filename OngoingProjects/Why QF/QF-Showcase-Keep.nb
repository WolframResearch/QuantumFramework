Cell[TextData[{
 "The dashed lines are the textbook asymptotic value; the solid curves are \
the exact survival from the special-function propagator. Each drops through \
the crossing at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
 " and then oscillates about its asymptote with a slowly decaying envelope, \
the Landau-Zener-St\[UDoubleDot]ckelberg oscillations carried by the \
parabolic cylinder functions, which the asymptotic formula does not show. The \
asymptotic result is the long-time average of the exact answer, and the \
single ratio ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[CapitalDelta]", "2"], "/", 
   StyleBox["v", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " orders the whole family: a fast (diabatic) sweep barely dips and stays in \
its branch, a slow (adiabatic) sweep transfers almost completely. The closed \
form gives the entire time-resolved crossing, oscillations included, where \
the asymptotic formula gives only the final number."
}], "Text",ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A parametric circuit: QAOA, built entirely from a graph", "Subsection",ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[TextData[{
 "QAOA is the canonical parametric circuit for optimization: one layer \
alternates a cost unitary ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Gamma]", "TI"], 
    SubscriptBox[
     StyleBox["H", "TI"], 
     StyleBox["C", "TI"]]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 " with a mixer ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["i", "TI"], 
    StyleBox["\[Theta]", "TI"], 
    StyleBox["B", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 ", and the two angles are tuned to maximize a classical objective. The \
objective here is MaxCut: color the vertices of a graph with two colors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["s", "TI"], 
    StyleBox["i", "TI"]], "=", "\[PlusMinus]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 " so that as many edges as possible join different colors, ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox[
    StyleBox["max",
     FontSlant->"Plain"], 
    RowBox[{
     StyleBox["s", "TI"], " ", "\[Element]", " ", "{", "\[PlusMinus]", "1", 
     SuperscriptBox["}", 
      StyleBox["n", "TI"]]}],
    LimitsPositioning->False], "\[ThinSpace]", 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1], "\[Element]", 
     StyleBox["E", "TI"]}],
    LimitsPositioning->False], 
   FractionBox[
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["s", "TI"], 
      StyleBox["j", "TI"]]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362a4e41-4988-041f-5e2a-602b683d6f65"],
 ". Everything below is derived from the problem graph, so nothing is \
hardcoded. Take the complete graph on four vertices, ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["K", "TI"], "4"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 ", a frustrated instance in which not all six edges can be cut:"
}], "Text",ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"graph", " ", "=", " ", 
  RowBox[{"CompleteGraph", "[", "4", "]"}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4}, {Null, 
       SparseArray[
       Automatic, {4, 4}, 0, {
        1, {{0, 3, 6, 9, 12}, {{2}, {3}, {4}, {1}, {3}, {4}, {1}, {2}, {4}, {
          1}, {2}, {3}}}, Pattern}]}, {GraphLayout -> "StarEmbedding"}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{0., 0.}, {
       0.8660254037844389, -0.5000000000000012}, {1.8369701987210297`*^-16, 
       1.}, {-0.8660254037844386, -0.49999999999999917`}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[0.], 
         ArrowBox[{{1, 2}, {1, 3}, {1, 4}, {2, 3}, {2, 4}, {3, 4}}, 
          0.020399597244776413`]}, 
        {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         DiskBox[1, 0.020399597244776413], DiskBox[2, 0.020399597244776413], 
         DiskBox[3, 0.020399597244776413], 
         DiskBox[4, 0.020399597244776413]}}]],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None,
  ImageSize->{209.2109375, Automatic}]], "Output",
 CellChangeTimes->{3.9948953157657146`*^9, 3.997991253500729*^9, 
  3.997992058664329*^9, 3.999164516707432*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"8e314740-32bf-42c1-90bd-aacf0b563499"]
}, Open  ]],

Cell["\<\
Read off the classical optimum, its best two-coloring of the vertices:\
\>", "Text",ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindMaximumCut", "[", "graph", "]"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.994895315827132*^9, 3.997991253716831*^9, 
  3.997992058726141*^9, 3.999164525244233*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"9504a5cc-944e-4e52-bbf0-9f1ace393d49"]
}, Open  ]],

Cell[TextData[{
 "The classical answer is a cut of ",
 Cell[BoxData["4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 " of the ",
 Cell[BoxData["6"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 " edges, splitting the four vertices into two pairs. Record the vertex count \
for reuse:"
}], "Text",ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"n", " ", "=", " ", 
  RowBox[{"VertexCount", "[", "graph", "]"}]}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[BoxData["4"], "Output",
 CellChangeTimes->{3.994895315831574*^9, 3.997991253721222*^9, 
  3.997992058730321*^9, 3.99916455440212*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"6dd6e1ba-aa13-4f7b-b7b1-df10678f8e1c"]
}, Open  ]],

Cell[TextData[{
 "The MaxCut cost Hamiltonian ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["H", "TI"], 
    StyleBox["C", "TI"]], "=", 
   UnderscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}],
    LimitsPositioning->False], 
   FractionBox[
    RowBox[{"1", "-", 
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["Z", "TI"], 
      StyleBox["j", "TI"]]}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
 " is assembled straight from the edge list, one ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "-", 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["Z", "TI"], 
     StyleBox["j", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6ad260-8ee1-565a-1569-d44a2a943ca0"],
 " term per edge, and carries a label that will name its block in the diagram \
below:"
}], "Text",ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hcost", " ", "=", " ", 
  RowBox[{"QuantumOperator", "[", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"id", " ", "=", " ", 
         RowBox[{
          RowBox[{"QuantumOperator", "[", 
           RowBox[{"StringJoin", "[", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"\"\<I\>\"", ",", " ", "n"}], "]"}], "]"}], "]"}], "/", 
          "2"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"id", " ", "-", " ", 
           RowBox[{"QuantumOperator", "[", 
            RowBox[{
             RowBox[{"\"\<ZZ\>\"", "/", "2"}], ",", " ", "#"}], "]"}]}], " ", 
          "&"}], ")"}], " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"List", " ", "@@@", " ", 
          RowBox[{"EdgeList", "[", "graph", "]"}]}], ")"}]}]}], "]"}], "]"}], 
