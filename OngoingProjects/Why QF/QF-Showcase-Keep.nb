Cell[TextData[{
 "The matrix returns exactly as the lab-frame Rabi propagator, written here \
with the detuning ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Delta]", "TI"], "\[Congruent]", 
   StyleBox["\[Omega]", "TI"], "-", 
   SubscriptBox[
    StyleBox["\[Omega]", "TI"], "0"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " and the generalized Rabi frequency ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["R", "TI"]], "\[Congruent]", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[CapitalOmega]", "2"], "+", 
     SuperscriptBox[
      StyleBox["\[Delta]", "TI"], "2"]}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 ":"
}], "Text",ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

