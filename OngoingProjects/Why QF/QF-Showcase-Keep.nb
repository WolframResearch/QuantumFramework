Cell["\<\
Because the contraction stayed exact, the probability comes back as an exact \
rational, a ratio of large integers. Read it as a decimal:\
\>", "Text",ExpressionUUID->"1ae06f2b-7109-3ba5-4a9f-877500bd898f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"%", " ", "//", " ", "N"}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"0856a555-3f58-6085-386d-3d1fbaed32ef"],

Cell[BoxData["0.9999470421032737`"], "Output",
 CellChangeTimes->{3.994895370349855*^9, 3.997991255859625*^9, 
  3.997991994277608*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"099a0ac0-0d7c-4101-8c82-9291857a8c21"]
}, Open  ]],

Cell[TextData[{
 "The success probability is very close to ",
 Cell[BoxData["1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71eecbe3-9be0-9ba6-2795-e2cd1d9ae98c"],
 ", at the analytic Grover peak ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["sin",
     FontSlant->"Plain"], "2"], "\[ThinSpace]", "\[NegativeThinSpace]", 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"2", 
    StyleBox["k", "TI"], "+", "1"}], 
   StyleBox[")",
    SpanMaxSize->1], 
   StyleBox["arcsin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   SqrtBox[
    RowBox[{"1", "/", 
     StyleBox["N", "TI"]}]], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59070895-187c-42ea-0f3c-a1df99091030"],
 " that the iteration count ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "12"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "189fe470-6cd8-7cf4-48a4-fe3a056d46de"],
 " is chosen to reach; the most probable bitstring is the marked input \
itself, ",
 Cell[BoxData[
  RowBox[{"200", "=", "11001000"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04ed2843-d86c-272a-2c92-c22cd91e8a70"],
 " (verified). A search of a few hundred gates, contracted in one steered \
pass."
}], "Text",ExpressionUUID->"70d9e217-b7c7-416b-20e6-0450c27213b1"],

Cell["\<\
The contraction plan is itself an inspectable object. Extract the circuit's \
tensor network:\
\>", "Text",ExpressionUUID->"29221b72-bc55-8ef4-58d1-933c35e1d4de"],

