   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Gamma]\>\"", ",", " ", "\"\<\[Theta]\>\"", ",", 
      " ", "\"\<cost\>\""}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"ColorFunction", " ", "->", " ", "\"\<TemperatureMap\>\""}], ",", 
   "\n", "  ", 
   RowBox[{"PlotPoints", " ", "->", " ", "50"}]}], "]"}]], "Input",
 CellLabel->
  "In[180]:=",ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

