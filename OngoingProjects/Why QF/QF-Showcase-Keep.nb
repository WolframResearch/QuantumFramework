Cell[BoxData[
 RowBox[{"stateprep", " ", "=", " ", 
  RowBox[{"QuantumCircuitOperator", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"StringJoin", "[", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"\"\<0\>\"", ",", " ", "n"}], "]"}], "]"}], ",", " ", 
      RowBox[{"\"\<H\>\"", " ", "->", " ", 
       RowBox[{"Range", "[", "n", "]"}]}]}], "}"}], ",", " ", 
    RowBox[{"\"\<Label\>\"", " ", "->", " ", "\"\<Prep\>\""}]}], 
   "]"}]}]], "Input",
