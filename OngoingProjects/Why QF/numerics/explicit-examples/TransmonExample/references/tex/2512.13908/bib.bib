@article{chamberland_very_2020,
	title = {Very low overhead fault-tolerant magic state preparation using redundant ancilla encoding and flag qubits},
	volume = {6},
	copyright = {2020 The Author(s)},
	issn = {2056-6387},
	url = {https://www.nature.com/articles/s41534-020-00319-5},
	doi = {10.1038/s41534-020-00319-5},
	abstract = {Fault-tolerant quantum computing promises significant computational speedup over classical computing for a variety of important problems. One of the biggest challenges for realizing fault-tolerant quantum computing is preparing magic states with sufficiently low error rates. Magic state distillation is one of the most efficient schemes for preparing high-quality magic states. However, since magic state distillation circuits are not fault-tolerant, all the operations in the distillation circuits must be encoded in a large distance error-correcting code, resulting in a significant resource overhead. Here, we propose a fault-tolerant scheme for directly preparing high-quality magic states, which makes magic state distillation unnecessary. In particular, we introduce a concept that we call redundant ancilla encoding. The latter combined with flag qubits allows for circuits to both measure stabilizer generators of some code, while also being able to measure global operators to fault-tolerantly prepare magic states, all using nearest neighbor interactions. We apply such schemes to a planar architecture of the triangular color code family and demonstrate that our scheme requires at least an order of magnitude fewer qubits and space–time overhead compared to the most competitive magic state distillation schemes. Since our scheme requires only nearest-neighbor interactions in a planar architecture, it is suitable for various quantum computing platforms currently under development.},
	number = {1},
	urldate = {2025-10-27},
	journal = {npj Quantum Information},
	author = {Chamberland, Christopher and Noh, Kyungjoo},
	month = oct,
	year = {2020},
	keywords = {Information theory and computation, Quantum information},
	pages = {91},
	file = {Full Text PDF:/Users/emmarosenfeld/Zotero/storage/LSPUD2M4/Chamberland and Noh - 2020 - Very low overhead fault-tolerant magic state prepa.pdf:application/pdf},
}

@misc{lee_efficient_2025,
	title = {Efficient benchmarking of logical magic state},
	url = {http://arxiv.org/abs/2505.09687},
	doi = {10.48550/arXiv.2505.09687},
	abstract = {High-fidelity logical magic states are a critical resource for fault-tolerant quantum computation, enabling non-Clifford logical operations through state injection. However, benchmarking these states presents significant challenges: one must estimate the infidelity \${\textbackslash}epsilon\$ with multiplicative precision, while many quantum error-correcting codes only permit Clifford operations to be implemented fault-tolerantly. Consequently, conventional state tomography requires \${\textbackslash}sim1/{\textbackslash}epsilon{\textasciicircum}2\$ samples, making benchmarking impractical for high-fidelity states. In this work, we show that any benchmarking scheme measuring one copy of the magic state per round necessarily requires \${\textbackslash}Omega(1/{\textbackslash}epsilon{\textasciicircum}2)\$ samples for single-qubit magic states. We then propose two approaches to overcome this limitation: (i) Bell measurements on two copies of the twirled state and (ii) single-copy schemes leveraging twirled multi-qubit magic states. Both benchmarking schemes utilize measurements with stabilizer states orthogonal to the ideal magic state and we show that \$O(1/{\textbackslash}epsilon)\$ sample complexity is achieved, which we prove to be optimal. Finally, we demonstrate the robustness of our protocols through numerical simulations under realistic noise models, confirming that their advantage persists even at moderate error rates currently achievable in state-of-the-art experiments.},
	urldate = {2025-11-06},
	author = {Lee, Su-un and Yuan, Ming and Chen, Senrui and Tsubouchi, Kento and Jiang, Liang},
	month = may,
	year = {2025},
	note = {arXiv:2505.09687 [quant-ph]},
	keywords = {Quantum Physics},
	file = {Full Text PDF:/Users/emmarosenfeld/Zotero/storage/PA3VW352/Lee et al. - 2025 - Efficient benchmarking of logical magic state.pdf:application/pdf;Snapshot:/Users/emmarosenfeld/Zotero/storage/HLFWSW9Z/2505.html:text/html},
}

