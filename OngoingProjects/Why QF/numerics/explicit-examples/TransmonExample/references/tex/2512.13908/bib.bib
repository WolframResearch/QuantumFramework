@misc{chen_efficient_2025,
	title = {Efficient {Magic} {State} {Cultivation} on {RP}$^2$},
	url = {http://arxiv.org/abs/2503.18657},
	doi = {10.48550/arXiv.2503.18657},
	abstract = {Preparing high-fidelity logical magic states is crucial for fault-tolerant quantum computation. Among prior attempts to reduce the substantial cost of magic state preparation, magic state cultivation (MSC), a recently proposed protocol for preparing \${\textbackslash}mathrm\{T\}\$ states without magic state distillation, achieves state-of-the-art efficiency. Inspired by this work, we propose a new MSC procedure that would produce a logical \${\textbackslash}mathrm\{T\}\$ state on a rotated surface code at a further reduced cost. For our MSC protocol, we define a new code family, the \${\textbackslash}mathbb \{RP\}{\textasciicircum}2\$ code, by putting the rotated surface code on \${\textbackslash}mathbb\{RP\}{\textasciicircum}2\$ (a two-dimensional manifold), as well as two self-dual CSS codes named SRP-3 and SRP-5 respectively. Small \${\textbackslash}mathbb\{RP\}{\textasciicircum}2\$ codes are used to hold logical information and checked by syndrome extraction (SE) circuits. We design fast morphing circuits that enable switching between a distance 3 (5) \${\textbackslash}mathbb\{RP\}{\textasciicircum}2\$ code and an SRP-3 (SRP-5) code on which we can efficiently check the correctness of the logical state. To preserve the high accuracy of the cultivated logical \${\textbackslash}mathrm\{T\}\$ state, we design an efficient and easy-to-decode expansion stage that grows a small \${\textbackslash}mathbb\{RP\}{\textasciicircum}2\$ code to a large rotated surface code in one round. Our MSC protocol utilizes non-local connectivity, available on both neutral atom array and ion trap platforms. According to our Monte Carlo sampling results, our MSC protocol requires about an order of magnitude smaller space-time volume to reach a target logical error rate around \$10{\textasciicircum}\{-9\}\$ compared to the original MSC protocol.},
	urldate = {2025-12-05},
	author = {Chen, Zi-Han and Chen, Ming-Cheng and Lu, Chao-Yang and Pan, Jian-Wei},
	month = mar,
	year = {2025},
	note = {arXiv:2503.18657 [quant-ph]},
	keywords = {Quantum Physics},
	annote = {Comment: 15 pages, 14 figures},
	file = {Full Text PDF:/Users/emmarosenfeld/Zotero/storage/8DIEQZV8/Chen et al. - 2025 - Efficient Magic State Cultivation on \$mathbb RP ^.pdf:application/pdf;Snapshot:/Users/emmarosenfeld/Zotero/storage/3FEFR8R4/2503.html:text/html},
}

@misc{beni_tesseract_2025,
	title = {Tesseract: {A} {Search}-{Based} {Decoder} for {Quantum} {Error} {Correction}},
	shorttitle = {Tesseract},
	url = {http://arxiv.org/abs/2503.10988},
	doi = {10.48550/arXiv.2503.10988},
	abstract = {Tesseract is a Most-Likely Error decoder designed for low-density-parity-check quantum error-correcting codes. Tesseract conducts a search through a graph on the set of all subsets of errors to find the lowest cost subset of errors consistent with the input syndrome. Although this graph is exponentially large, the search can be made efficient in practice for random errors using \$A{\textasciicircum}*\$ search technique along with a few pruning heuristics. We show through benchmark circuits for surface, color, and bivariate-bicycle codes that Tesseract is significantly faster than integer programming-based decoders while retaining comparable accuracy at moderate physical error rates. We also find that Tesseract can decode transversal CNOT protocols for surface codes on neutral atom quantum computers. Finally, we compare surface code and bivariate bicycle code circuits, finding that the [[144,12,12]] bivariate bicycle code is \$14{\textbackslash}times\$ to \$19{\textbackslash}times\$ more efficient than surface codes using our most-likely error decoding, whereas using correlated matching and BP+OSD decoders would have implied only a \$10{\textbackslash}times\$ improvement. Assuming instead that long-range couplers are \$10{\textbackslash}times\$ noisier, the improvement drops to around \$4{\textbackslash}times\$ using Tesseract or \$2{\textbackslash}times\$ using correlated matching and BP+OSD.},
	urldate = {2025-12-05},
	author = {Beni, Laleh Aghababaie and Higgott, Oscar and Shutty, Noah},
	month = aug,
	year = {2025},
	note = {arXiv:2503.10988 [quant-ph]},
	keywords = {Quantum Physics},
	annote = {Comment: 13 pages, 8 figures},
	file = {Full Text PDF:/Users/emmarosenfeld/Zotero/storage/JLRYBHGW/Beni et al. - 2025 - Tesseract A Search-Based Decoder for Quantum Erro.pdf:application/pdf;Snapshot:/Users/emmarosenfeld/Zotero/storage/YKSMZBIF/2503.html:text/html},
}

