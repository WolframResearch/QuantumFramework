Cell[TextData[{
 "Have you noticed the pattern? A record that ends during the collapse cannot \
determine the distribution at all: during the collapse the cosines are too \
nearly dependent. At half the revival time the recovery is still rough; by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "=", "8"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bd8f04d-1eeb-cc47-19e7-ea179a9f96ad"],
 " the whole distribution is recovered accurately, and the recovery keeps \
improving toward the revival. These records are free of noise, so the only \
limit is the conditioning of the cosine matrix against the accuracy of the \
time integration. A measured record carries shot noise, and then the natural \
scale is the frequency spacing: near ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", 
   OverscriptBox[
    StyleBox["n", "TI"], "_"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4131a38c-3cb1-61e0-70ce-3ad6b54433ca"],
 " neighbouring Rabi frequencies differ by about ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   SqrtBox[
    OverscriptBox[
     StyleBox["n", "TI"], "_"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66dd1d78-a26e-793a-0ee2-9525d71b4800"],
 ", and resolving them by their phase difference takes a record of length \
about ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", 
   SqrtBox[
    OverscriptBox[
     StyleBox["n", "TI"], "_"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497210fc-93c1-a1bc-7f01-89a62675f386"],
 ", the revival time."
}], "Text",
 CellID->1090726268,ExpressionUUID->"2d97aad1-2ffc-78e2-5bac-439b49894ac8"],

Cell[TextData[{
 "With loss, the diagonal blocks still evolve linearly and on their own, so \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45812a49-00f9-159c-73be-cc13b08c7fe6"],
 " is still a linear function of the initial ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e72335e-d71b-483f-5601-ab1be2ae1b05"],
 ", and with ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00379a47-1bf1-fdbf-31cc-1c219d85c785"],
 " known the same inversion applies. I demonstrate the inversion only for the \
lossless record; for the lossy records the statement rests on this linearity \
and on knowing ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19c466c6-94fb-625d-4ffc-7fa01c8e30a7"],
 "."
}], "Text",
 CellID->2124519200,ExpressionUUID->"20cc8908-a147-10ca-50f3-2155d0f26210"],

Cell["Where the blindness ends: an atom with its own phase", "Section",
 CellID->617350884,ExpressionUUID->"13bcd130-62a3-8c70-4143-c97a1757d75a"],

Cell[TextData[{
 "The symmetry argument used one more assumption: the atom starts in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6565394a-c196-6bdd-131a-b117f0233927"],
 ". Suppose instead it starts in a superposition ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], "+", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
        StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
      TemplateBox[{
        StyleBox["g", "TI"]},
       "Ket"]}]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "654f987a-f98e-d016-1374-1227f838a37c"],
 ". The diagonal block with ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "631c7298-8e73-d34d-1124-6bc22b07a197"],
 " excitations then contains ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["N", "TI"], "-", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e9b4f74-ee28-5e2b-56b9-67318bdd2571"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["N", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ff84a3f-8ea3-8415-2598-6c792b57ef7f"],
 " together, and the coherence between them, ",
 Cell[BoxData[
  RowBox[{"\[Proportional]", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    RowBox[{
     StyleBox["N", "TI"], "-", "1"}]], 
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["N", "TI"], "*"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d7fc3a7-f4ac-747e-7b04-da00fd595f44"],
 ", involves the field's coherence between neighbouring photon numbers. \
Within that block ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["h", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b0a0ef4-2602-73b0-1909-a7be53b7419a"],
 " acts as ",
 Cell[BoxData[
  SqrtBox[
   StyleBox["N", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7324c1ff-ae1d-8266-22db-d8b8cba9d14c"],
 " times a Pauli-",
 Cell[BoxData[
  StyleBox["X", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a19e89c-6899-3c78-3a26-01c6092d8742"],
 " matrix, which rotates the populations into the imaginary part of the \
coherence. So the record picks up the field phase only through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Im",
    FontSlant->"Plain"], 
   StyleBox["(",
    FontSize->1.2 Inherited], 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["i", "TI"], "\[CurlyPhi]"}]], 
   SubscriptBox[
    StyleBox["c", "TI"], 
    RowBox[{
     StyleBox["N", "TI"], "-", "1"}]], 
   SubsuperscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["N", "TI"], "*"], 
   StyleBox[")",
    FontSize->1.2 Inherited]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39663cc9-297d-9b4a-6f1d-b5934809e990"],
 ". That requires a relative phase between the atomic dipole and the field."
}], "Text",
 CellID->1357963930,ExpressionUUID->"7331868a-f3de-6799-22ce-1fd7866b4de3"],

Cell["\<\
Define a function that evolves an atomic state next to the coherent and the \
phase-randomized fields in the lossless cavity and returns the largest \
difference between their records:\
\>", "Text",
 CellID->1626918454,ExpressionUUID->"2e54b5d3-3a50-bfef-566b-2c9dbfea0535"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atomRecordGap", "[", "atom_", "]"}], " ", ":=", " ", 
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Subtract", " ", "@@", " ", 
     RowBox[{"Map", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"field", ",", " ", 
         RowBox[{"With", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"evolution", " ", "=", " ", 
             RowBox[{"QuantumEvolve", "[", 
              RowBox[{"h", ",", " ", 
               RowBox[{
                RowBox[{"{", "a", "}"}], " ", "->", " ", 
                RowBox[{"{", "0.", "}"}]}], ",", " ", 
               RowBox[{"QuantumTensorProduct", "[", 
                RowBox[{
                 RowBox[{"QuantumState", "[", "atom", "]"}], ",", " ", 
                 "field"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"tau", ",", " ", "0.", ",", " ", "16."}], "}"}], ",", 
               " ", 
               RowBox[{"AccuracyGoal", " ", "->", " ", "9"}], ",", " ", 
               RowBox[{"PrecisionGoal", " ", "->", " ", "9"}]}], "]"}]}], 
            "}"}], ",", "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", " ", "@", " ", 
              RowBox[{"Tr", "[", 
               RowBox[{
                RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
                RowBox[{
                 RowBox[{"QuantumPartialTrace", "[", 
                  RowBox[{
                   RowBox[{"evolution", "[", "#", "]"}], ",", " ", 
                   RowBox[{"{", "2", "}"}]}], "]"}], 
                 "[", "\"\<DensityMatrix\>\"", "]"}]}], "]"}]}], " ", "&"}], 
            " ", "/@", " ", "times"}]}], "\n", "    ", "]"}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"coherent", ",", " ", "dephased"}], "}"}]}], "\n", "]"}]}], 
    "]"}], "]"}]}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->675379980,ExpressionUUID->"290d3a44-5bc8-0dba-5f32-bc2e5e7d5780"],

Cell[TextData[{
 "Compare an atom in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], "+", 
     TemplateBox[{
       StyleBox["g", "TI"]},
      "Ket"]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24441621-d1c3-83e7-4c7b-8f8ae077d1cd"],
 ", QF's ",
 Cell[BoxData["\"\<+\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40c04446-bf75-68d5-70f0-5e203a003a3f"],
 ", with one in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     TemplateBox[{
       StyleBox["e", "TI"]},
      "Ket"], "+", 
     RowBox[{
      StyleBox["i", "TI"], 
      TemplateBox[{
        StyleBox["g", "TI"]},
       "Ket"]}]}], ")"}], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337e031d-61ac-97b3-6105-9b47105efd99"],
 ", QF's ",
 Cell[BoxData["\"\<R\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c1a2f33-e4c4-62b1-1439-c77c8d71309b"],
 ":"
}], "Text",
 CellID->1331866192,ExpressionUUID->"617ac38b-bfe7-c8e3-1719-dad539939ac9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<+\>\"", ",", " ", "\"\<R\>\""}], "}"}], ",", " ", 
   RowBox[{"atomRecordGap", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<+\>\"", ",", " ", "\"\<R\>\""}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[50]:= ",
 CellID->605731326,ExpressionUUID->"0820ecb4-5495-9c54-39df-05fe5d21e6be"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"+\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"R\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}]], "Output",\

 CellLabel->"Out[50]= ",
 CellID->1274588674,ExpressionUUID->"5e80e7d7-2c44-8e80-06bf-fe9145f6d4ea"]
}, Open  ]],

Cell[TextData[{
 "As one can see, a superposition alone is not enough. With a real ",
 Cell[BoxData[
  StyleBox["\[Alpha]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f5fcf3-bda8-2342-4e8a-f5bd345d71a8"],
 ", the atom in ",
 Cell[BoxData["\"\<+\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15b39007-6d36-072c-4340-0a6104c36a76"],
 " has no relative phase to the field and its record is still blind; the atom \
in ",
 Cell[BoxData["\"\<R\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24baaecf-7f93-f980-4c59-47a97a27cbea"],
 " is a quarter turn out of phase with the field, and its record tells the \
two fields apart. The population record becomes sensitive to the field's \
coherences only when the atom brings a phase reference of its own. A \
classical drive would also break the blindness, because it does not conserve ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["N", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76f70144-dc0f-2312-1e8c-9921d5bb8e78"],
 ". The counter-rotating terms beyond the rotating-wave approximation change ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fe7a9e0-94ce-d707-459c-40ca1d78ba6d"],
 " by two, so they conserve only its parity; they would let the record see \
coherences between photon numbers of equal parity."
}], "Text",
 CellID->861714746,ExpressionUUID->"3d41bad8-5432-fbcd-6b7e-33825dc4c917"],

Cell["Checking the numerical resolution", "Section",
 CellID->1192942815,ExpressionUUID->"0dba7410-c818-dfcb-3b5a-6e5de992a511"],

Cell["\<\
Check trace conservation over every evolved joint state; the largest \
deviation of the trace from one is:\
\>", "Text",
 CellID->556077107,ExpressionUUID->"30c9b337-f958-fd8c-60f6-2b70f8d2c7d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<Norm\>\"", "]"}], " ", "&"}], ",", " ", 
      "jointStates", ",", " ", 
      RowBox[{"{", "3", "}"}]}], "]"}], " ", "-", " ", "1"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[51]:= ",
 CellID->1590294859,ExpressionUUID->"7ef4fbe9-42ce-bb3a-268b-f2b377780600"],

Cell[BoxData[
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"-", "1"}], "+", "jointStates"}], "]"}]], "Output",
 CellLabel->"Out[51]= ",
 CellID->225985609,ExpressionUUID->"6b93c9b6-6d32-b3d4-19a0-e0f004c4013e"]
}, Open  ]],

Cell[TextData[{
 "Refine the phase-space grid: radii up to ",
 Cell[BoxData["8"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78b94e11-c6dd-a6bf-2847-605af3690c85"],
 ", twice the radial points and twice the angles. The largest change in the \
lossless negative volumes of both fields is:"
}], "Text",
 CellID->308842859,ExpressionUUID->"1b080b4d-7396-a957-4937-a3170620fbbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"negativeVolume", "[", 
       RowBox[{"wignerGrid", "[", 
        RowBox[{"8.", ",", " ", "700", ",", " ", "512"}], "]"}], "]"}], ",", 
      " ", 
      RowBox[{"fieldMatrices", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}], " ", "-", " ", 
    RowBox[{"negativity", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[52]:= ",
 CellID->330935476,ExpressionUUID->"343c9421-c983-3b23-5dc3-0d8ae8378609"],

