Cell[TextData[{
 "Choose five loss rates, from a lossless cavity to a photon lifetime ",
 Cell[BoxData[
  RowBox[{
   StyleBox["g", "TI"], "/", 
   StyleBox["\[Kappa]", "TI"], "=", "5"}]], "InlineFormula",
