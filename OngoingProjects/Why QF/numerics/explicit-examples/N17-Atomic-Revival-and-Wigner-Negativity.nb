Cell[TextData[{
 "In short, the record carries the photon-number distribution ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261459d-f728-27c9-621f-5cc682c28d13"],
 " of the field and nothing of its photon-number coherences."
}], "Text",
 CellID->1195452142,ExpressionUUID->"331c7f17-1677-2611-6124-7751a3038d7b"],

Cell["\<\
The Wigner function in angular harmonics: what the record misses\
\>", "Section",
 CellID->1521685512,ExpressionUUID->"14cbe893-f079-1a7f-3cc8-01dc810c6945"],

Cell[TextData[{
 "Use dimensionless quadratures ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["x", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "+", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   SqrtBox["2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],
 " and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["p", "TI"], "^"], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["a", "TI"], "^"], "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], 
    SqrtBox["2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "355f53e5-dafb-cebc-6365-4acede8f9486"],
 ", normalize the Wigner function by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Integral]",
    FontSize->1.15 Inherited], 
   StyleBox["W", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492c649c-8337-646c-78d4-7dc636c24eb6"],
 ", so that vacuum has ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["W", "TI"], "0"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["p", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SuperscriptBox[
       StyleBox["x", "TI"], "2"], "+", 
      SuperscriptBox[
       StyleBox["p", "TI"], "2"]}], 
     StyleBox[")",
      SpanMaxSize->1]}]], "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],
 ", and switch to polar coordinates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["x", "TI"], "=", 
   StyleBox["r", "TI"], 
   StyleBox["cos",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c54ceec-a669-4ede-046b-e7c9d31c1424"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["p", "TI"], "=", 
   StyleBox["r", "TI"], 
   StyleBox["sin",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["\[Theta]", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336f4c4f-cb14-5955-6115-6628eea12bbf"],
 ". Writing ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "^"], 
    StyleBox["f", "TI"]], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["m", "TI"], ",", 
      StyleBox["n", "TI"]}],
     LimitsPositioning->False], 
    RowBox[{
     SubscriptBox[
      StyleBox["\[Rho]", "TI"], 
      StyleBox[
       RowBox[{"m", "n"}], "TI"]], 
     TemplateBox[{
       StyleBox["m", "TI"]},
      "Ket"], 
     TemplateBox[{
       StyleBox["n", "TI"]},
      "Bra"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],
 " and using the Wigner function of each ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     StyleBox["m", "TI"]},
    "Ket"], 
   TemplateBox[{
     StyleBox["n", "TI"]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2580083d-358c-3435-53bf-a267bc3e9f1f"],
 ", the Wigner function separates into angular harmonics:"
}], "Text",
 CellID->97201263,ExpressionUUID->"477fde83-a5ae-c17e-6d04-d7eccc589044"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["W", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["r", "TI"], ",", 
     StyleBox["\[Theta]", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["k", "TI"], "\[GreaterEqual]", "0"}],
     LimitsPositioning->False], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    StyleBox["Re",
     FontSlant->"Plain"], "\[NegativeThinSpace]", "[", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       StyleBox["i", "TI"], 
       StyleBox["k", "TI"], 
       StyleBox["\[Theta]", "TI"]}]], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["k", "TI"]], 
     StyleBox["(",
      SpanMaxSize->1], 
     StyleBox["r", "TI"], 
     StyleBox[")",
      SpanMaxSize->1]}], "]"}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["W", "TI"], 
      StyleBox["k", "TI"]], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["r", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["n", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Rho]", "TI"], 
       RowBox[{
        RowBox[{
         StyleBox["n", "TI"], "+", 
         StyleBox["k", "TI"]}], ",", 
        StyleBox["n", "TI"]}]], "\[ThinSpace]", 
      SubscriptBox[
       StyleBox["R", "TI"], 
       StyleBox[
        RowBox[{"n", "k"}], "TI"]], 
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       StyleBox["r", "TI"], 
       StyleBox[")",
        SpanMaxSize->1]}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], "0"], "=", "1"}], ",", " ", 
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     RowBox[{
      StyleBox["k", "TI"], "\[GreaterEqual]", "1"}]], "=", "2"}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->878831761,ExpressionUUID->"0782fdeb-454d-5eca-2db1-f4b56cf82410"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"n", "k"}], "TI"]], 
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["r", "TI"], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    FractionBox[
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        SpanMaxSize->1], 
       RowBox[{"-", "1"}], 
       StyleBox[")",
        SpanMaxSize->1]}], 
      StyleBox["n", "TI"]], "\[Pi]"], 
    SqrtBox[
     FractionBox[
      RowBox[{
       StyleBox["n", "TI"], "!"}], 
      RowBox[{
       RowBox[{
        StyleBox["(",
         SpanMaxSize->1], 
        RowBox[{
         StyleBox["n", "TI"], "+", 
         StyleBox["k", "TI"]}], 
        StyleBox[")",
         SpanMaxSize->1]}], "!"}]]], "\[ThinSpace]", 
    SuperscriptBox[
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      RowBox[{
       SqrtBox["2"], "\[ThinSpace]", 
       StyleBox["r", "TI"]}], 
      StyleBox[")",
       SpanMaxSize->1]}], 
     StyleBox["k", "TI"]], "\[ThinSpace]", 
    SubsuperscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["n", "TI"], 
     RowBox[{
      StyleBox["(",
       SpanMaxSize->1], 
      StyleBox["k", "TI"], 
      StyleBox[")",
       SpanMaxSize->1]}]], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["r", "TI"], "2"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{"-", 
      SuperscriptBox[
       StyleBox["r", "TI"], "2"]}]]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1048559713,ExpressionUUID->"69a01936-08b2-60cf-1f5f-9170a9473215"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  SubsuperscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["n", "TI"], 
   RowBox[{
    StyleBox["(",
     SpanMaxSize->1], 
    StyleBox["k", "TI"], 
    StyleBox[")",
     SpanMaxSize->1]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],
 " the generalized Laguerre polynomial and ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    RowBox[{
     StyleBox["(",
      SpanMaxSize->1], 
     RowBox[{
      SqrtBox["2"], "\[ThinSpace]", 
      StyleBox["r", "TI"]}], 
     StyleBox[")",
      SpanMaxSize->1]}], "0"], "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0b44c7-b7b3-5c45-1409-5da0c24626af"],
 ", including at the origin. In words: the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dba914e-52ed-e087-7b59-09286699b2ed"],
 "-th harmonic, the part of ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497e5609-e734-e246-7f06-485292c6b0ac"],
 " that winds ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c79fc2-e932-c645-38fc-16af88c4acaf"],
 " times around the origin, is built only from the coherences ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   RowBox[{
    RowBox[{
     StyleBox["n", "TI"], "+", 
     StyleBox["k", "TI"]}], ",", 
    StyleBox["n", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2184153d-b162-7859-57bb-8d66c0174aa3"],
 " between photon numbers that differ by ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],
 ". The populations build ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["W", "TI"], "0"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["r", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "554ef748-00c8-cf17-0375-ef12b162927d"],
 " alone, which is rotationally symmetric. Averaging ",
 Cell[BoxData[
  StyleBox["W", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],
 " over the angle keeps exactly ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["W", "TI"], "0"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee2421b-c68a-4a96-2692-6444f33f18fc"],
 ", and averaging the field over its phase does the same thing: the Wigner \
function of the phase-randomized field is the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79971006-243c-6fe2-2fac-8a604dc935c8"],
 " harmonic of the original one."
}], "Text",
 CellID->300048012,ExpressionUUID->"61109047-93e0-1377-172f-0a2125957e5d"],

Cell[TextData[{
 "Define the radial functions ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["R", "TI"], 
   StyleBox[
    RowBox[{"n", "k"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c784b-10c0-0bab-5c24-7215a17559f1"],
 " at a list of radii, grouped by ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4125a490-d89a-105a-70da-3dddd92f62a0"],
 ":"
}], "Text",
 CellID->1962937852,ExpressionUUID->"0b67f461-4283-7871-391c-ee4b77364b5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"radialFunctions", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{"Table", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "n"}], " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"n", "!"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", " ", "+", " ", "k"}], ")"}], "!"}]}], "]"}], " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"k", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], " ", "r"}], ")"}], "^", "k"}]}], 
       "]"}], " ", 
      RowBox[{"LaguerreL", "[", 
       RowBox[{"n", ",", " ", "k", ",", " ", 
        RowBox[{"2", " ", 
         RowBox[{"r", "^", "2"}]}]}], "]"}], " ", 
