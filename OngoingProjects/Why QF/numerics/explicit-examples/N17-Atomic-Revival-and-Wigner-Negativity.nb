Cell[TextData[{
 "Plot all four on one color scale. A Wigner function never exceeds ",
 Cell[BoxData[
  RowBox[{"1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77db54cc-ee9f-ec5f-1df9-4da98b2bb6a5"],
 " in magnitude, so the scale is ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", "1", "/", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a072e47-9a01-f132-1a3c-c0211fb5c018"],
 "; blue is negative and red positive:"
}], "Text",
 CellID->1906087345,ExpressionUUID->"03b41a97-fa59-5a01-314b-93d0ffec296b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"MapThread", "[", "\n", "        ", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w", ",", " ", "label"}], "}"}], ",", " ", 
       RowBox[{"ListDensityPlot", "[", "\n", "            ", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{"Append", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"w", "[", "\"\<Grid\>\"", "]"}], ",", " ", 
               RowBox[{"w", "[", "\"\<ValuesOnGrid\>\"", "]"}]}], "}"}], ",", 
             " ", "2"}], "]"}], ",", " ", "1"}], "]"}], ",", "\n", 
         "            ", 
         RowBox[{"ColorFunction", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Blend", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "StandardBlue", ",", " ", "White", ",", " ", "StandardRed"}], 
               "}"}], ",", " ", 
              RowBox[{"Rescale", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "1"}], "/", "Pi"}], ",", " ", 
                  RowBox[{"1", "/", "Pi"}]}], "}"}]}], "]"}]}], "]"}], " ", 
            "&"}], ")"}]}], ",", " ", 
         RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", "\n",
          "            ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "Pi"}], ",", " ", 
            RowBox[{"1", "/", "Pi"}]}], "}"}]}], ",", " ", 
         RowBox[{"PlotLegends", " ", "->", " ", 
          RowBox[{"BarLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Blend", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                   "StandardBlue", ",", " ", "White", ",", " ", 
                    "StandardRed"}], "}"}], ",", " ", 
                  RowBox[{"Rescale", "[", 
                   RowBox[{"#", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "Pi"}], ",", " ", 
                    RowBox[{"1", "/", "Pi"}]}], "}"}]}], "]"}]}], "]"}], " ", 
                "&"}], ")"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "1"}], "/", "Pi"}], ",", " ", 
                RowBox[{"1", "/", "Pi"}]}], "}"}]}], "}"}], ",", " ", 
            RowBox[{"LegendLabel", " ", "->", " ", "\"\<W\>\""}]}], "]"}]}], ",",
          "\n", "            ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
