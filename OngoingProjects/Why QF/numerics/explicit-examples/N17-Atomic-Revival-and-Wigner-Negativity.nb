 CellLabel->"In[3]:= ",
 CellID->1589986527,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[TextData[{
 "A coherent state has amplitudes ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SuperscriptBox[
    StyleBox["e", "TI"], 
    RowBox[{"-", 
     SuperscriptBox[GridBox[{
        {
         StyleBox["\[Alpha]", "TI"]}
       },
       GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
       GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"], "/", "2"}]], 
   SuperscriptBox[
    StyleBox["\[Alpha]", "TI"], 
    StyleBox["n", "TI"]], "/", 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 " and mean photon number ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "=", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["\[Alpha]", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ". Set ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Alpha]", "TI"], "=", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["n", "TI"], "_"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 ", and retain 24 Fock levels; a larger cutoff will check this choice at the \
end:"
}], "Text",
 CellID->943101875,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[CellGroupData[{

