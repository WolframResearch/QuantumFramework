Cell[TextData[{
 "Photon loss is not conserving: it removes one excitation. We couple the \
cavity to a memoryless (Markov) vacuum bath and neglect atomic decay and \
dephasing. Write ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["A", "TI"], "^"], "=", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["I", "TI"], "^"], 
    StyleBox["a", "TI"]], "\[CircleTimes]", 
   OverscriptBox[
    StyleBox["a", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " and"
}], "Text",
 CellID->176337227,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], 
      OverscriptBox[
       StyleBox["\[Rho]", "TI"], "^"]}], 
     StyleBox[
      RowBox[{"d", "\[Tau]"}], "TI"]], "=", "-", 
    StyleBox["i", "TI"], 
    StyleBox["[",
     SpanMaxSize->1], 
    RowBox[{
     OverscriptBox[
      StyleBox["h", "TI"], "^"], ",", 
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "^"]}], 
    StyleBox["]",
     SpanMaxSize->1], "+", 
    StyleBox["r", "TI"], "\[ThinSpace]", "\|01d49f", 
    StyleBox["[",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["A", "TI"], "^"], 
    StyleBox["]",
     SpanMaxSize->1], 
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "^"]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"\|01d49f", 
      StyleBox["[",
       SpanMaxSize->1], 
      OverscriptBox[
       StyleBox["A", "TI"], "^"], 
      StyleBox["]",
       SpanMaxSize->1]}], 
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "^"]}], "=", 
    RowBox[{
     RowBox[{
      OverscriptBox[
       StyleBox["A", "TI"], "^"], 
      OverscriptBox[
       StyleBox["\[Rho]", "TI"], "^"], 
      SuperscriptBox[
       OverscriptBox[
        StyleBox["A", "TI"], "^"], "\[Dagger]"]}], "-", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         OverscriptBox[
          StyleBox["A", "TI"], "^"], "\[Dagger]"], 
        OverscriptBox[
         StyleBox["A", "TI"], "^"], 
        OverscriptBox[
         StyleBox["\[Rho]", "TI"], "^"], "+", 
        OverscriptBox[
         StyleBox["\[Rho]", "TI"], "^"], 
        SuperscriptBox[
         OverscriptBox[
          StyleBox["A", "TI"], "^"], "\[Dagger]"], 
        OverscriptBox[
         StyleBox["A", "TI"], "^"]}], ")"}]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    StyleBox["r", "TI"], "=", 
    RowBox[{
     StyleBox["\[Kappa]", "TI"], "/", 
     RowBox[{
      StyleBox["g", "TI"], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->807053435,ExpressionUUID->"5e187950-8ca2-2ab2-0638-711a25577898"],

Cell[TextData[{
 "This is the zero-temperature loss equation in ",
 ButtonBox["Meunier et al., Eq. (26)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/quant-ph/0603191"], None}],
 "; their loss rate ",
 Cell[BoxData[
  StyleBox["\[Gamma]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " is our ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 ", while their coupling is twice our ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 ". Here ",
 Cell[BoxData[
  StyleBox["\[Kappa]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43821c38-6720-b4f9-71b1-966212da1ec3"],
 " is the photon-number decay rate: without the atom, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1], 
   OverscriptBox[
    StyleBox["n", "TI"], "^"], 
   StyleBox["\[RightAngleBracket]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 " decays as ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["e", "TI"], 
   RowBox[{"-", 
    StyleBox["\[Kappa]", "TI"], 
    StyleBox["t", "TI"]}]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 "."
}], "Text",
 CellID->1633675818,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[TextData[{
 "The jump ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["A", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 " lowers ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 " by exactly one, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["N", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["A", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "=", "-", 
   OverscriptBox[
    StyleBox["A", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 ". Verify it; the largest matrix element of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{
    OverscriptBox[
     StyleBox["N", "TI"], "^"], ",", 
    OverscriptBox[
     StyleBox["A", "TI"], "^"]}], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   OverscriptBox[
    StyleBox["A", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 " is:"
}], "Text",
 CellID->1828793009,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"excitations", "[", "a", "]"}], " ", "-", " ", 
      RowBox[{"a", "[", "excitations", "]"}], " ", "+", " ", "a"}], ")"}], 
    "[", "\"\<Matrix\>\"", "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1491197753,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[BoxData[
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a", "-", 
     RowBox[{"a", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["a", "\[Dagger]"], "[", "a", "]"}], "+", 
