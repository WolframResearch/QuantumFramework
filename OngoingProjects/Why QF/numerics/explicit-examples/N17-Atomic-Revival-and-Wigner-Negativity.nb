Cell[BoxData[
 RowBox[{
  RowBox[{"wignerAt", "[", 
   RowBox[{"rho_", ",", " ", "points_"}], "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"Norm", " ", "/@", " ", "points"}]}], ",", " ", 
      RowBox[{"theta", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Arg", "[", 
          RowBox[{"#1", " ", "+", " ", 
           RowBox[{"I", " ", "#2"}]}], "]"}], " ", "&"}], " ", "@@@", " ", 
        "points"}]}]}], "}"}], ",", "\n", "    ", 
    RowBox[{"Re", "[", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"angularModes", "[", 
        RowBox[{"rho", ",", " ", 
         RowBox[{"radialFunctions", "[", "r", "]"}]}], "]"}], " ", 
       RowBox[{"harmonicWeights", "[", "theta", "]"}]}], "]"}], "]"}]}], "\n",
    "]"}]}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->724760089,ExpressionUUID->"023e8ab0-46e5-584b-33c5-23fa72902a91"],

