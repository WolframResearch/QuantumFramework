Cell["\<\
As expected, the two agree to machine precision: the harmonic sum is the same \
Wigner function, organized by angular winding.\
\>", "Text",
 CellID->874582697,ExpressionUUID->"2d27580a-3980-0923-54dd-5254b8355809"],

Cell["The negative volume", "Text",
 CellID->11631581,ExpressionUUID->"077289f0-6175-2cad-2d01-20ba100076f7"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   SubscriptBox["\|01d4a9", 
    StyleBox["W", "TI"]], "=", 
   StyleBox["\[Integral]",
    FontSize->1.4 Inherited], 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"-", 
     StyleBox["W", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["x", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["p", "TI"], "=", 
   SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], "2", "\[Pi]", 
   StyleBox["r", "TI"], "\[ThinSpace]", 
   StyleBox["d", "TI"], 
   StyleBox["r", "TI"], "\[ThinSpace]", 
   StyleBox["\[LeftAngleBracket]",
    SpanMaxSize->1,
    FontSize->1.2 Inherited], 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"-", 
     StyleBox["W", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1], 
   SubscriptBox[
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1,
     FontSize->1.2 Inherited], 
    StyleBox["\[Theta]", "TI"]]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1933762060,ExpressionUUID->"133b68ba-8b92-4fbc-42d8-81e42e271586"],

Cell[TextData[{
 "is half the negativity indicator ",
 Cell[BoxData[
  StyleBox["\[Delta]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6db49e4d-4459-39d0-1b4b-10176ded8b3a"],
 " of ",
 ButtonBox["Kenfack and \:017byczkowski, Eq. (2.2)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/html/quant-ph/0406015"], None}],
 "; here ",
 Cell[BoxData[
  SubscriptBox[
   RowBox[{
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1], "\[CenterDot]", 
    StyleBox["\[RightAngleBracket]",
     SpanMaxSize->1]}], 
   StyleBox["\[Theta]", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e45bb6-31a6-d4bb-379c-52f04050be81"],
 " is the average over the angle. It vanishes for a nonnegative Wigner \
function. That does not imply a classical state: squeezed Gaussian states, \
for example, also have nonnegative Wigner functions."
}], "Text",
 CellID->1055776787,ExpressionUUID->"638a875f-059e-01af-1189-1f19ac2b53f5"],

Cell[TextData[{
 "Integrating on a polar grid suits the harmonic form. The radial functions \
are computed once, and each density matrix then costs one matrix product. Use \
the midpoint rule in ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1c9c05-9360-5fc6-6923-166f2615252c"],
 " and equally spaced angles; the angular sum is exact for every harmonic the \
truncated field can carry. Build the grid with its radial weights ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]", 
   StyleBox["r", "TI"], "\[ThinSpace]", "\[CapitalDelta]", 
   StyleBox["r", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8f8704-dbc1-ad9f-5bb4-1f61de75f7e5"],
 ":"
}], "Text",
 CellID->1859711813,ExpressionUUID->"7bacb1bf-0091-7884-2953-28f9b1244aee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wignerGrid", "[", 
   RowBox[{"radius_", ",", " ", "radialPoints_", ",", " ", "angularPoints_"}],
    "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", "\n", "        ", 
     RowBox[{
      RowBox[{"radii", " ", "=", " ", 
       RowBox[{
        RowBox[{"radius", "/", "radialPoints"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Range", "[", "radialPoints", "]"}], " ", "-", " ", 
          RowBox[{"1", "/", "2"}]}], ")"}]}]}], ",", "\n", "        ", 
      RowBox[{"angles", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{"2", " ", "Pi", " ", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", " ", 
            RowBox[{"angularPoints", " ", "-", " ", "1"}]}], "]"}], "/", 
          "angularPoints"}]}], "]"}]}]}], "\n", "    ", "}"}], ",", "\n", 
    "    ", 
    RowBox[{"<|", "\n", "        ", 
     RowBox[{
      RowBox[{"\"\<RadialWeights\>\"", " ", "->", " ", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"radius", "/", "radialPoints"}], " ", "radii"}]}], ",", "\n", 
      "        ", 
      RowBox[{"\"\<Radial\>\"", " ", "->", " ", 
       RowBox[{"radialFunctions", "[", "radii", "]"}]}], ",", "\n", 
      "        ", 
      RowBox[{"\"\<Harmonics\>\"", " ", "->", " ", 
       RowBox[{"Developer`ToPackedArray", "[", 
        RowBox[{
         RowBox[{"harmonicWeights", "[", "angles", "]"}], ",", " ", 
         "Complex"}], "]"}]}]}], "\n", "    ", "|>"}]}], "\n", 
   "]"}]}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->1348896709,ExpressionUUID->"6e949b39-c960-dcff-16ab-1362e81aa6c5"],

Cell[TextData[{
