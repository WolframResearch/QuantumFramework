Cell[TextData[{
 "Raise the Fock cutoff from 24 to 28 and recompute the coherent field at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Kappa]", "TI"], "/", 
   StyleBox["g", "TI"], "=", "0.05"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "359bcca5-e220-9ec0-63b8-e50e97dae42a"],
 ". Every ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d973432-f49b-24e6-6bac-ae7ffd2f8ecc"],
 "-dependent object is rebuilt inside the ",
 Cell[BoxData["Block"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2740d0b2-6fee-93c4-4d7f-c9fc0998e12e"],
 ":"
}], "Text",
 CellID->1009200201,ExpressionUUID->"28899a3f-5003-79db-58b6-1c7961b64b21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cutoffNegativity", " ", "=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", "28"}], "}"}], ",", "\n", "    ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"field", " ", "=", " ", 
          RowBox[{
           RowBox[{"CoherentState", "[", "d", "]"}], "[", "alpha", "]"}]}], ",",
          " ", 
         RowBox[{"loss", " ", "=", " ", 
          RowBox[{"QuantumTensorProduct", "[", 
           RowBox[{
            RowBox[{"QuantumOperator", "[", "\"\<I\>\"", "]"}], ",", " ", 
            RowBox[{"AnnihilationOperator", "[", "d", "]"}]}], "]"}]}]}], 
        "}"}], ",", "\n", "        ", 
       RowBox[{"With", "[", "\n", "            ", 
        RowBox[{
         RowBox[{"{", "\n", "                ", 
          RowBox[{
           RowBox[{"evolution", " ", "=", " ", 
            RowBox[{"QuantumEvolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sigmaMinus", "[", 
                RowBox[{"SuperDagger", "[", "loss", "]"}], "]"}], " ", "+", 
               " ", 
               RowBox[{
                RowBox[{"SuperDagger", "[", "sigmaMinus", "]"}], "[", "loss", 
                "]"}]}], ",", " ", 
              RowBox[{
               RowBox[{"{", "loss", "}"}], " ", "->", " ", 
               RowBox[{"{", ".05", "}"}]}], ",", " ", 
              RowBox[{"QuantumTensorProduct", "[", 
               RowBox[{
                RowBox[{"QuantumState", "[", "\"\<0\>\"", "]"}], ",", " ", 
                "field"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"tau", ",", " ", "0.", ",", " ", "16."}], "}"}], ",", 
              " ", 
              RowBox[{"AccuracyGoal", " ", "->", " ", "9"}], ",", " ", 
              RowBox[{"PrecisionGoal", " ", "->", " ", "9"}]}], "]"}]}], ",", 
           "\n", "                ", 
           RowBox[{"cutoffGrid", " ", "=", " ", 
            RowBox[{"wignerGrid", "[", 
             RowBox[{"7.", ",", " ", "350", ",", " ", "256"}], "]"}]}]}], 
          "\n", "            ", "}"}], ",", "\n", "            ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"negativeVolume", "[", "cutoffGrid", "]"}], "[", 
            RowBox[{"Normal", " ", "@", " ", 
             RowBox[{
              RowBox[{"QuantumPartialTrace", "[", 
               RowBox[{
                RowBox[{"evolution", "[", "#", "]"}], ",", " ", 
                RowBox[{"{", "1", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"",
               "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", "times"}]}], "\n", 
        "        ", "]"}]}], "\n", "    ", "]"}]}], "\n", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[53]:= ",
 CellID->752465254,ExpressionUUID->"091a51ee-65fb-201c-3f3a-48c8138e7366"],

Cell["The largest change in the negative volume is:", "Text",
 CellID->891183881,ExpressionUUID->"60c488fa-b38d-2f14-10fb-21a7c638727e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"cutoffNegativity", " ", "-", " ", 
    RowBox[{"negativity", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", "3"}], "]"}], "]"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->136309391,ExpressionUUID->"3dab8a61-8541-a5e8-6ba8-2c4b2cf50f32"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Part", "::", "partd"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Part", " ", "specification", " "}], 
  TagBox[
   RowBox[{"negativity", "\[LeftDoubleBracket]", 
    RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}],
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"is", " ", "longer", " ", "than", " ", "depth", " ", "of", " ", 
    RowBox[{"object", "."}]}]}]}]], "Message", "MSG",
 CellID->2018652156,ExpressionUUID->"6cd9d50f-b32b-5aae-14e6-cd68c6de28f4"],

Cell[BoxData[
 RowBox[{"Abs", "[", 
  RowBox[{"times", "-", 
   RowBox[{"negativity", "\[LeftDoubleBracket]", 
    RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}]}], "]"}]], "Output",
 CellLabel->"Out[54]= ",
 CellID->2096959614,ExpressionUUID->"25697345-b0fc-afe2-5317-6b2ec08ef5c8"]
}, Open  ]],

Cell["\<\
These are sensitivity checks at the stated settings, not rigorous bounds on \
the Wigner function over the whole plane. They are small compared with the \
differences between the two fields that the argument rests on.\
\>", "Text",
 CellID->359589406,ExpressionUUID->"7b535da6-b53b-b46b-2961-54003ccf1eb1"],

Cell["The answer", "Section",
 CellID->533832725,ExpressionUUID->"44232014-649d-d43d-6dd0-ba5e0d29bf07"],

Cell[TextData[{
 "The population record of an atom that starts in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7586ae08-7861-bb88-23bd-4052791509d2"],
 " is blind to everything about the cavity field except its photon-number \
distribution, because the coupling conserves the excitation number and photon \
loss only lowers it. A record that extends past the collapse determines that \
distribution. The phase-averaged field is then a real preparation with the \
same record, and convexity makes its negative volume a lower bound for every \
field with the same distribution. So the record guarantees exactly the \
negative volume of the phase-averaged field, the part of the negativity that \
the populations produce on their own. The rest, carried by coherences between \
photon numbers, is invisible to it. That rest is most of the negativity near \
half the revival time, where the field is close to a superposition of two \
coherent states, and an increasing share of it as photon loss grows."
}], "Text",
 CellID->739917449,ExpressionUUID->"54e345b1-bc57-c084-7c91-5cfb35e392ee"],

