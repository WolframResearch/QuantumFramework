Cell[TextData[{
 "The top row shows the branch picture directly. Near ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["r", "TI"]], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6456a901-44b8-c553-0c6d-416b6d32afb9"],
 " the coherent field has two lobes above and below the origin with fringes \
between them. Near ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Tau]", "TI"], 
   StyleBox["r", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de3bc1f-ff0d-b0a4-0b90-3658fab9028e"],
 " the lobes have merged on the side opposite to where the field started. The \
bottom row shows the same fields averaged over the angle: rings, whose \
negative ones come from the photon-number distribution alone. Those rings are \
all the record can vouch for."
}], "Text",
 CellID->1859374462,ExpressionUUID->"05b0da98-ac84-313a-334f-d3c5c5368000"],

Cell["\<\
Loss shrinks both curves, but not equally. Compute, for each loss rate, the \
fraction of the time-integrated negative volume that the record guarantees:\
\>", "Text",
 CellID->544914423,ExpressionUUID->"1895dfb3-965d-1c83-48aa-d6fd23e866e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{"losses", ",", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Total", " ", "/@", " ", 
      RowBox[{"negativity", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"Total", " ", "/@", " ", 
      RowBox[{"negativity", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[44]:= ",
 CellID->574286850,ExpressionUUID->"2deed3b4-be8d-db40-5b95-cafe3b39a9aa"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Part", "::", "partd"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Part", " ", "specification", " "}], 
  TagBox[
   RowBox[{
   "fieldMatrices", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"is", " ", "longer", " ", "than", " ", "depth", " ", "of", " ", 
    RowBox[{"object", "."}]}]}]}]], "Message", "MSG",
 CellID->2084383110,ExpressionUUID->"78e6b17c-c991-15ef-289d-2939e8247f35"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Part", "::", "partw"}], "MessageName"], 
