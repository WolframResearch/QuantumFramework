Cell[TextData[{
 "How long must the record be? Repeat the inversion with records that stop at \
",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Tau]", "TI"], "=", "4"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24548d70-e349-6090-4c6b-253d96fc32fa"],
 ", at half the large-",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24053d10-b77f-7f73-4c3a-b55dc20a4259"],
 " revival time ",
 Cell[BoxData[
  RowBox[{"2", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16592835-d9b8-94b1-3e66-c27ed832fe9b"],
 ", and at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["\[Tau]", "TI"], "=", "8"}], ",", 
   RowBox[{"12", ",", "16"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141ca810-4c49-bb60-3c23-425a65fd064a"],
 "; the largest error in each recovered distribution is:"
}], "Text",
 CellID->1439628390,ExpressionUUID->"68e9730c-176f-ed31-1897-6b56a21bb41b"],

