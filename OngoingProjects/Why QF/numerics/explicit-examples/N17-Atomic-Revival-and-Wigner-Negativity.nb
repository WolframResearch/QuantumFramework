         "]"}]}], ")"}], "[", "a", "]"}]}], ")"}], "[", "\<\"Matrix\"\>", 
   "]"}], "]"}]], "Output",
 CellLabel->"Out[12]= ",
 CellID->518839321,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"]
}, Open  ]],

Cell[TextData[{
 "Now split the joint density matrix into blocks ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"], 
   StyleBox[
    RowBox[{"N", "M"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 ", the part that maps excitation number ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " to excitation number ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 ". The commutator with ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["h", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 " and the terms with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    OverscriptBox[
     StyleBox["A", "TI"], "^"], "\[Dagger]"], 
   OverscriptBox[
    StyleBox["A", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323a4b1c-b138-a791-63da-6359c0b20dfb"],
 ", which both conserve ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 ", keep every block where it is, and ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox[
    StyleBox["A", "TI"], "^"], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["A", "TI"], "^"], "\[Dagger]"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 " moves block ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["N", "TI"], ",", 
    StyleBox["M", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"],
 " to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    RowBox[{
     StyleBox["N", "TI"], "-", "1"}], ",", 
    RowBox[{
     StyleBox["M", "TI"], "-", "1"}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6815cd54-0cd7-196f-182a-e51ea5626bb5"],
 ". So the diagonal blocks ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"], 
   StyleBox[
    RowBox[{"N", "N"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519775d4-d545-25f2-07ad-6c91dcf18fd8"],
 " evolve among themselves, never fed by the off-diagonal ones. The \
observable ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Sigma]", "TI"], "^"], 
    StyleBox["z", "TI"]], "\[CircleTimes]", 
   SubscriptBox[
    OverscriptBox[
     StyleBox["I", "TI"], "^"], 
    StyleBox["f", "TI"]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 " is diagonal in ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 ", so ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 " reads only those diagonal blocks."
}], "Text",
 CellID->762269937,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[TextData[{
 "In other words: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 StyleBox[" depends only on the diagonal blocks of the initial joint state.",
  FontWeight->"Bold"],
 " With the atom starting in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 ", the diagonal block with ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 " excitations is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    RowBox[{
     StyleBox["N", "TI"], "-", "1"}]], 
   TemplateBox[{
     RowBox[{
       StyleBox["e", "TI"], ",", 
       StyleBox["N", "TI"], "-", "1"}]},
    "Ket"], 
   TemplateBox[{
     RowBox[{
       StyleBox["e", "TI"], ",", 
       StyleBox["N", "TI"], "-", "1"}]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["n", "TI"]], "=", 
   SuperscriptBox[GridBox[{
      {
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["n", "TI"]]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], "2"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78287f93-0f12-7c52-2828-76ddaaa746b8"],
 " is the photon-number distribution. Everything else about the field, its \
phase and every coherence between different photon numbers, sits in the \
off-diagonal blocks, which the record never sees. The truncated ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["a", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
 " still lowers ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 " by exactly one, so this holds exactly in the truncated model, not only in \
the limit ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "\[Rule]", "\[Infinity]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 "."
}], "Text",
 CellID->405213039,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[TextData[{
 "The assumption that the atom starts in ",
 Cell[BoxData[
  TemplateBox[{
    StyleBox["e", "TI"]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " matters; we return to it in the last section."
}], "Text",
 CellID->2118931930,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

Cell["Two field preparations, one atomic record", "Section",
 CellID->1039057480,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell[TextData[{
 "The symmetry argument predicts that any two fields with the same ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 " produce the same record. The simplest partner of a coherent state is a ",
 StyleBox["phase-randomized coherent state",
  FontWeight->"Bold"],
 ": a coherent state whose phase is unknown and uniformly distributed, as for \
a laser with no phase reference. Averaging ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["\[Phi]", "TI"]}]]}]},
    "Ket"], 
   TemplateBox[{
     RowBox[{
       StyleBox["\[Alpha]", "TI"], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["\[Phi]", "TI"]}]]}]},
    "Bra"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc1606-c22d-409d-5f43-8863f7d812e7"],
 " over ",
 Cell[BoxData[
  StyleBox["\[Phi]", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 " removes every coherence ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Rho]", "TI"], 
   StyleBox[
    RowBox[{"m", "n"}], "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "\[NotEqual]", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 " and keeps the Poisson weights:"
}], "Text",
 CellID->1411198270,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "^"], 
     StyleBox["rand",
      FontSlant->"Plain"]], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      StyleBox["n", "TI"],
      LimitsPositioning->False], 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]], 
      TemplateBox[{
        StyleBox["n", "TI"]},
       "Ket"], 
      TemplateBox[{
        StyleBox["n", "TI"]},
       "Bra"]}]}]}], ",", 
   "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace]\
\[NonBreakingSpace]", 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["n", "TI"]], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["e", "TI"], 
      RowBox[{"-", 
       OverscriptBox[
        StyleBox["n", "TI"], "_"]}]], 
     RowBox[{
      FractionBox[
       OverscriptBox[
        OverscriptBox[
         StyleBox["n", "TI"], "_"], 
        StyleBox["n", "TI"]], 
       RowBox[{
        StyleBox["n", "TI"], "!"}]], "."}]}]}]}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1703453532,ExpressionUUID->"51fce014-dca1-0630-0783-fa51d5546d1a"],

