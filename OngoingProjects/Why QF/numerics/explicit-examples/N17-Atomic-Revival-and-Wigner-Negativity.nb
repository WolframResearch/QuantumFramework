Cell[TextData[{
 "For operators, QF's ",
 Cell[BoxData[
  RowBox[{"f", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " means the composition ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"f", "g"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 "; QF aligns the addressed subsystems and carries the untouched subsystem \
through. Form the dimensionless interaction ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["h", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 "; ",
 Cell[BoxData["SuperDagger"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " takes the adjoint:"
}], "Text",
 CellID->1384978530,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h", " ", "=", " ", 
  RowBox[{
   RowBox[{"sigmaMinus", "[", 
    RowBox[{"SuperDagger", "[", "a", "]"}], "]"}], " ", "+", " ", 
   RowBox[{
    RowBox[{"SuperDagger", "[", "sigmaMinus", "]"}], "[", "a", 
    "]"}]}]}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->1407158826,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

