Cell["\<\
The collapse, the revival, and the way loss erodes the revival are all \
identical. An experimenter holding this record cannot tell which field was in \
the cavity.\
\>", "Text",
 CellID->49659130,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[TextData[{
 "The fields themselves differ. For the unconditional cavity state ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "^"], 
    StyleBox["f", "TI"]], "=", 
   SubscriptBox[
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["a", "TI"]], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 ", discard subsystem 1 and keep the density matrices:"
}], "Text",
 CellID->464508221,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fieldMatrices", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{
        RowBox[{"QuantumPartialTrace", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
        "]"}]}], " ", "&"}], ",", " ", "jointStates", ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->1361313038,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[TextData[{
 "Recall that a field element ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{
      StyleBox["n", "TI"]},
     "Bra"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "^"], 
     StyleBox["f", "TI"]], 
    TemplateBox[{
      StyleBox["m", "TI"]},
     "Ket"]}], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["s", "TI"],
     LimitsPositioning->False], 
    RowBox[{
     TemplateBox[{
       RowBox[{
         StyleBox["s", "TI"], ",", 
         StyleBox["n", "TI"]}]},
      "Bra"], 
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "^"], 
     TemplateBox[{
       RowBox[{
         StyleBox["s", "TI"], ",", 
         StyleBox["m", "TI"]}]},
      "Ket"]}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[NotEqual]", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 " comes from blocks with different ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 ". So the phase-randomized field at every later time should be exactly the \
Fock-diagonal part of the coherent field. Verify it; the largest difference \
over all loss rates and times is:"
}], "Text",
 CellID->1907680634,ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"fieldMatrices", "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"DiagonalMatrix", " ", "@*", " ", "Diagonal"}], ",", " ", 
      RowBox[{"fieldMatrices", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->1100849853,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

