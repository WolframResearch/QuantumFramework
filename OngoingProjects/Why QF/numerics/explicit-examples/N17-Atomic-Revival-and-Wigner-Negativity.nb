 CellID->17830494,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Wolfram`QuantumFramework`SecondQuantization`\>\"",
