  RowBox[{":", " "}], 
  RowBox[{"Object", " "}], 
  TagBox[
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       FractionBox["1", "\[Pi]"], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "n"], " ", 
        SqrtBox[
         FractionBox[
          RowBox[{"n", "!"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "k"}], ")"}], "!"}]]], " ", 
