Cell[TextData[{
 "Evolve both preparations at every loss rate. QF takes the generator, the \
jump operator with its rate, and the initial state directly; the rate \
multiplies the dissipator, so it is equivalent to a jump ",
 Cell[BoxData[
  RowBox[{
   SqrtBox[
    StyleBox["r", "TI"]], "\[ThinSpace]", 
   OverscriptBox[
    StyleBox["A", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 ":"
}], "Text",
 CellID->1717363484,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trajectories", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"QuantumEvolve", "[", 
      RowBox[{"h", ",", " ", 
       RowBox[{
        RowBox[{"{", "a", "}"}], " ", "->", " ", 
        RowBox[{"{", "r", "}"}]}], ",", " ", "input", ",", " ", 
       RowBox[{"{", 
        RowBox[{"tau", ",", " ", "0.", ",", " ", "16."}], "}"}], ",", " ", 
       RowBox[{"AccuracyGoal", " ", "->", " ", "9"}], ",", " ", 
       RowBox[{"PrecisionGoal", " ", "->", " ", "9"}]}], "]"}], ",", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"input", ",", " ", "inputs"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "losses"}], "}"}]}], "\n", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->1781880651,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[TextData[{
 "The large-",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["n", "TI"], "_"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 " estimate of the first revival is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["\[Tau]", "TI"], 
    StyleBox["r", "TI"]], "\[TildeEqual]", "2", "\[Pi]", 
   SqrtBox[
    OverscriptBox[
     StyleBox["n", "TI"], "_"]], "=", "4", "\[Pi]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 ", so the window ",
 Cell[BoxData[
  RowBox[{"0", "\[LessEqual]", 
   StyleBox["\[Tau]", "TI"], "\[LessEqual]", "16"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 " contains the collapse and the first revival. Sample it every ",
 Cell[BoxData["0.1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362a4e41-4988-041f-5e2a-602b683d6f65"],
 ":"
}], "Text",
 CellID->1536527082,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData[
 RowBox[{
  RowBox[{"times", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", "160"}], "]"}], "/", "10"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->1621535814,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell["Evaluate every trajectory on that time grid:", "Text",
 CellID->1193935837,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"jointStates", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"evolution", ",", " ", 
       RowBox[{"evolution", " ", "/@", " ", "times"}]}], "]"}], ",", " ", 
     "trajectories", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->105329933,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[TextData[{
 "The atomic state is ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["\[Rho]", "TI"], "^"], 
    StyleBox["a", "TI"]], "=", 
   SubscriptBox[
    StyleBox["Tr",
     FontSlant->"Plain"], 
    StyleBox["f", "TI"]], 
   OverscriptBox[
    StyleBox["\[Rho]", "TI"], "^"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 "; in QF the listed subsystem is the one discarded, so trace out subsystem \
2. With the excited-first labels, ",
 Cell[BoxData[
  SubscriptBox[
   OverscriptBox[
    StyleBox["\[Sigma]", "TI"], "^"], 
   StyleBox["z", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 " is ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", "3", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 ". Compute ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], "=", 
   StyleBox["Tr",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Rho]", "TI"], "^"], 
     StyleBox["a", "TI"]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], 
     StyleBox["z", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 " for every preparation, loss rate and time:"
}], "Text",
 CellID->1234416869,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"inversion", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Re", " ", "@", " ", 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "3", "]"}], " ", ".", " ", 
         RowBox[{
          RowBox[{"QuantumPartialTrace", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}], "[", "\"\<DensityMatrix\>\"", 
          "]"}]}], "]"}]}], " ", "&"}], ",", " ", "jointStates", ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->240380995,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

