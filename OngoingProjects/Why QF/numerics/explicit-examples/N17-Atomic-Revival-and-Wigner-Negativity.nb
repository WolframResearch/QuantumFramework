  RowBox[{
   RowBox[{"AssociationThread", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"tmax", ",", " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rows", " ", "=", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"times", ",", " ", 
               RowBox[{"t_", " ", "/;", " ", 
                RowBox[{"t", " ", "<=", " ", "tmax"}]}]}], "]"}], "]"}]}], 
           "}"}], ",", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"LeastSquares", "[", 
              RowBox[{
               RowBox[{"design", "[", 
                RowBox[{"[", "rows", "]"}], "]"}], ",", " ", 
               RowBox[{"inversion", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1", ",", " ", "rows"}], "]"}], 
                "]"}]}], "]"}], " ", "-", " ", "photonProbabilities"}], "]"}],
            "]"}]}], "]"}]}], "]"}], " ", "/@", " ", "#"}]}], "]"}], " ", 
   "&"}], "[", 
  RowBox[{"{", 
   RowBox[{"4.", ",", " ", 
    RowBox[{"N", "[", 
     RowBox[{"2", " ", "Pi"}], "]"}], ",", " ", "8.", ",", " ", "12.", ",", 
    " ", "16."}], "}"}], "]"}]], "Input",
 CellLabel->"In[48]:= ",
 CellID->1555199373,ExpressionUUID->"045a1c11-48b2-feff-2c79-965b6944c4c5"],

