  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6ad260-8ee1-565a-1569-d44a2a943ca0"],
 " is:"
}], "Text",
 CellID->1771870337,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

