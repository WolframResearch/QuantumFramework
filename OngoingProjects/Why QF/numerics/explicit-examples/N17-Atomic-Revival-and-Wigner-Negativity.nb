  RowBox[{"Part", " "}], 
  TagBox["2",
   HoldCompleteForm], 
  RowBox[{" ", "of", " "}], 
  TagBox[
   RowBox[{"Total", "[", "fieldMatrices", "]"}],
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"does", " ", "not", " ", 
    RowBox[{"exist", "."}]}]}]}]], "Message", "MSG",
 CellID->312632837,ExpressionUUID->"24acbe62-bdf4-ffe2-4c53-304c3b86c5c8"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Part", "::", "partd"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Part", " ", "specification", " "}], 
  TagBox[
   RowBox[{
   "fieldMatrices", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"is", " ", "longer", " ", "than", " ", "depth", " ", "of", " ", 
    RowBox[{"object", "."}]}]}]}]], "Message", "MSG",
 CellID->174470345,ExpressionUUID->"38f0085c-4734-4722-688f-a20672c12a08"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"losses", "\[Rule]", 
   FractionBox[
    RowBox[{
     RowBox[{"Total", "[", "fieldMatrices", "]"}], "\[LeftDoubleBracket]", 
     "2", "\[RightDoubleBracket]"}], "fieldMatrices"]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[44]= ",
 CellID->950211691,ExpressionUUID->"6b9216eb-8f9f-eb69-19a1-8fb52a2bb9b3"]
}, Open  ]],

Cell["\<\
As one can see, the guaranteed share falls as loss grows: the negativity that \
survives photon loss is mostly carried by coherences, and the Fock-diagonal \
part disappears sooner. Why the populations lose their negativity faster is a \
question this essay leaves open.\
\>", "Text",
 CellID->476175344,ExpressionUUID->"59f120da-5631-2eb2-0f8e-b98463c47498"],

Cell["Does the record determine the photon-number distribution?", "Section",
 CellID->201272189,ExpressionUUID->"5fa7ad17-3a9c-8e6e-055c-4551bf2ed4b4"],

Cell[TextData[{
 "The bound above needs ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c844eb4-1a55-00c1-54bc-67fe9fe0522b"],
 ", and the experimenter is given ",
 Cell[BoxData[
  RowBox[{
   StyleBox["z", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["\[Tau]", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cf619f4-16c8-91d6-148d-90bea362e33c"],
 ". For zero loss each excitation pair evolves on its own. Starting from the \
excited atom,"
}], "Text",
 CellID->320292756,ExpressionUUID->"66b1d308-016b-0c10-0e4e-cb52b01e577a"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{"|", "\[CapitalPsi]", 
    RowBox[{"(", "\[Tau]", ")"}], "\[RightAngleBracket]", "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["n", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["n", "TI"]], 
    RowBox[{"[", 
     RowBox[{"cos", 
      RowBox[{"(", 
       RowBox[{
        SqrtBox[
         RowBox[{
          StyleBox["n", "TI"], "+", "1"}]], " ", "\[Tau]"}], ")"}], "|", 
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}], "\[RightAngleBracket]"}], "-", 
    StyleBox["i", "TI"], "sin", 
    RowBox[{"(", 
     RowBox[{
      SqrtBox[
       RowBox[{
        StyleBox["n", "TI"], "+", "1"}]], " ", "\[Tau]"}], ")"}], "|", 
    StyleBox["g", "TI"], ",", 
    StyleBox["n", "TI"], "+", "1", "\[RightAngleBracket]", "]", 
    RowBox[{",", "    "}], 
    SubscriptBox[
     StyleBox["z", "TI"], "0"], 
    RowBox[{"(", "\[Tau]", ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["n", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["n", "TI"]], "cos", 
    RowBox[{"(", 
     RowBox[{"2", 
      SqrtBox[
       RowBox[{
        StyleBox["n", "TI"], "+", "1"}]], " ", "\[Tau]"}], ")"}], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1146801282,ExpressionUUID->"0764fd02-d65e-847f-2d1b-f56fe3e8ef45"],

Cell[TextData[{
 "So the record is a linear function of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c98820f-8b6f-75b8-34a7-24692e1a5f82"],
 ", a sum of cosines whose frequencies ",
 Cell[BoxData[
  RowBox[{"2", 
   SqrtBox[
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}]]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6abb7d62-34cd-b03b-1a59-754cbd790301"],
 " are all different. Build the matrix of those cosines on the sampled \
times:"
}], "Text",
 CellID->41202278,ExpressionUUID->"2d7b53f1-7ae1-3c16-5b19-4abb7e95877c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"design", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"n", " ", "+", " ", "1"}], "]"}], " ", "t"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "times"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "0", ",", " ", 
       RowBox[{"d", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[45]:= ",
 CellID->1124146653,ExpressionUUID->"342ac02e-94b9-9375-5c29-d9881d4dfe5f"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Table", "::", "iterb"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Iterator", " "}], 
  TagBox[
   RowBox[{"{", 
    RowBox[{"t", ",", "times"}], "}"}],
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"does", " ", "not", " ", "have", " ", "appropriate", " ", 
    RowBox[{"bounds", "."}]}]}]}]], "Message", "MSG",
 CellID->1232284935,ExpressionUUID->"7e47f25d-3ed8-a4c4-267c-f407bb520e2e"],

Cell["\<\
Check the closed form against the lossless QF record; the largest difference \
is:\
\>", "Text",
 CellID->2082395230,ExpressionUUID->"420d2e93-75d1-66df-7232-c7dd7c644c25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"inversion", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
    RowBox[{"design", " ", ".", " ", "photonProbabilities"}]}], "]"}], 
  "]"}]], "Input",
