Cell["\<\
Build QF's Wigner representation of the lossless coherent and \
phase-randomized fields at those times:\
\>", "Text",
 CellID->216741342,ExpressionUUID->"3afe1774-f6b9-1a20-6a85-8f31834c690a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"snapshots", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"WignerRepresentation", "[", 
      RowBox[{
       RowBox[{"QuantumState", "[", 
        RowBox[{
         RowBox[{"fieldMatrices", "[", 
          RowBox[{"[", 
           RowBox[{"input", ",", " ", "1", ",", " ", "j"}], "]"}], "]"}], ",",
          " ", "d"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "5."}], ",", " ", "5."}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "5."}], ",", " ", "5."}], "}"}], ",", " ", 
       RowBox[{"\"\<GridSize\>\"", " ", "->", " ", "121"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"input", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "snapshotIndices"}], "}"}]}], "\n", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[42]:= ",
 CellID->2096934290,ExpressionUUID->"0cb96547-3d6c-b437-3447-7d21b41e1f1d"],

