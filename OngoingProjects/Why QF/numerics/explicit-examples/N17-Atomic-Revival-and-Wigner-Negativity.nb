}, Open  ]],

Cell["Build QF's normalized truncated coherent state:", "Text",
 CellID->1432876021,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"coherent", " ", "=", " ", 
