       RowBox[{"2", " ", "Pi"}], ",", " ", 
       RowBox[{"4", " ", "Pi"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->449288241,ExpressionUUID->"6f8d9e4d-778e-395a-15b2-101702388ba0"],

