Cell["\<\
The interaction only trades an atomic excitation for a photon. So the total \
number of excitations,\
\>", "Text",
 CellID->1140508347,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    OverscriptBox[
     StyleBox["N", "TI"], "^"], "=", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "+"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["\[Sigma]", "TI"], "^"], "-"], "\[CircleTimes]", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["I", "TI"], "^"], 
     StyleBox["f", "TI"]], "+", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["I", "TI"], "^"], 
     StyleBox["a", "TI"]], "\[CircleTimes]", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["a", "TI"], "^"], "\[Dagger]"], 
    OverscriptBox[
     StyleBox["a", "TI"], "^"]}], ","}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->496109794,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[TextData[{
 "is conserved. In other words, ",
 Cell[BoxData[
  OverscriptBox[
   StyleBox["h", "TI"], "^"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " never connects ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["e", "TI"], ",", 
      StyleBox["n", "TI"]}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " to anything except ",
 Cell[BoxData[
  TemplateBox[{
    RowBox[{
      StyleBox["g", "TI"], ",", 
      StyleBox["n", "TI"], "+", "1"}]},
   "Ket"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 ", and both carry ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "=", 
   StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " excitations."
}], "Text",
 CellID->108435171,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

