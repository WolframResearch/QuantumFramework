Cell[TextData[{
 "Define the negative volume: clip the negative part with ",
 Cell[BoxData["Ramp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0084d900-0120-94d6-30bb-d16ab0dafe3c"],
 ", then average over the angle:"
}], "Text",
 CellID->935019337,ExpressionUUID->"45e3bdb3-b7b8-8152-7390-34fcc232d3b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"negativeVolume", "[", "grid_", "]"}], "[", "rho_", "]"}], " ", ":=",
   " ", 
  RowBox[{
   RowBox[{"grid", "[", "\"\<RadialWeights\>\"", "]"}], " ", ".", " ", 
   RowBox[{"(", 
    RowBox[{"Mean", " ", "/@", " ", 
     RowBox[{"Ramp", "[", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"wigner", "[", "grid", "]"}], "[", "rho", "]"}]}], "]"}]}], 
    ")"}]}]}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->642744358,ExpressionUUID->"5e5e1e6c-8075-0eb3-0665-903631005499"],

Cell["\<\
Define the negative volume of the phase-averaged field. It differs from the \
line above only in the order of the two operations: average over the angle \
first, then clip:\
\>", "Text",
 CellID->1478372881,ExpressionUUID->"3b122816-0897-a47c-6921-c250a9230f46"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"phaseAveragedNegativeVolume", "[", "grid_", "]"}], "[", "rho_", 
   "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"grid", "[", "\"\<RadialWeights\>\"", "]"}], " ", ".", " ", 
   RowBox[{"Ramp", "[", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"Mean", " ", "/@", " ", 
       RowBox[{
        RowBox[{"wigner", "[", "grid", "]"}], "[", "rho", "]"}]}], ")"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->124263719,ExpressionUUID->"12228eb7-81d1-9f6b-43d1-27f13065e5b1"],

Cell[TextData[{
 "That difference in order is the whole bound. The function ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u", "TI"], "\[Function]", 
   StyleBox["max",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"0", ",", 
    RowBox[{"-", 
     StyleBox["u", "TI"]}]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c4e3d89-d3d8-0dbe-3475-b4d2e66d5784"],
 " is convex, so the clipped average can never exceed the average of the \
clipped values:"
}], "Text",
 CellID->1310926461,ExpressionUUID->"44dcab5a-698d-607d-6ce3-430408383347"],

Cell[BoxData[
 PaneBox[
  RowBox[{
   RowBox[{
    StyleBox["max",
     FontSlant->"Plain"], "\[ThinSpace]", "\[NegativeThinSpace]", 
    StyleBox["(",
     FontSize->1.2 Inherited], "0"}], ",", 
   RowBox[{"-", 
    SubscriptBox[
     RowBox[{
      StyleBox["\[LeftAngleBracket]",
       SpanMaxSize->1], 
      StyleBox["W", "TI"], "\[VeryThinSpace]", 
      StyleBox["\[RightAngleBracket]",
       SpanMaxSize->1]}], 
     StyleBox["\[Theta]", "TI"]], 
    StyleBox[")",
     FontSize->1.2 Inherited], "\[LessEqual]", 
    StyleBox["\[LeftAngleBracket]",
     SpanMaxSize->1,
     FontSize->1.2 Inherited], 
    StyleBox["max",
     FontSlant->"Plain"], "\[ThinSpace]", 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{"0", ",", 
     RowBox[{"-", 
      StyleBox["W", "TI"]}]}], 
    StyleBox[")",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["\[RightAngleBracket]",
      SpanMaxSize->1,
      FontSize->1.2 Inherited], 
     StyleBox["\[Theta]", "TI"]], "\[NonBreakingSpace]\[NonBreakingSpace]", "\[DoubleLongRightArrow]",
     "\[NonBreakingSpace]\[NonBreakingSpace]", 
    SubscriptBox["\|01d4a9", 
     StyleBox["W", "TI"]], 
    StyleBox["[",
     SpanMaxSize->1], 
    SubscriptBox[
     StyleBox["W", "TI"], "0"], 
    StyleBox["]",
     SpanMaxSize->1], "\[LessEqual]", 
    SubscriptBox["\|01d4a9", 
     StyleBox["W", "TI"]], 
    StyleBox["[",
     SpanMaxSize->1], 
    StyleBox["W", "TI"], 
    StyleBox["]",
     SpanMaxSize->1]}], "."}],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellID->1124211690,ExpressionUUID->"268a9802-0d7f-2bfd-4e89-126ca40a79c7"],

Cell[TextData[{
 "In other words, averaging over the phase can cancel negative regions \
against positive ones but can never create negativity. So ",
 StyleBox["every field with the photon-number distribution ",
  FontWeight->"Bold"],
 Cell[BoxData[
  SubscriptBox[
   StyleBox["p", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",
  FontSize->0.9 Inherited,
  FontWeight->"Bold",ExpressionUUID->"79bc5755-bb31-5780-2f44-4f1f3ec43dea"],
 StyleBox[" has at least the negative volume of the phase-averaged field",
  FontWeight->"Bold"],
 ", and the phase-randomized preparation reaches that value exactly."
}], "Text",
 CellID->1335749844,ExpressionUUID->"0ff00406-ec89-251c-358f-9e63853d8c66"],

Cell["The guaranteed negativity against the true negativity", "Section",
 CellID->793802945,ExpressionUUID->"7d6791a5-5599-4f2a-2b1c-080f5c2c1270"],

Cell["\<\
Compute the negative volume of both fields at every loss rate and time:\
\>", "Text",
 CellID->631769182,ExpressionUUID->"7c7441be-5925-9c2b-240c-58f858d1e771"],

Cell[BoxData[
 RowBox[{
  RowBox[{"negativity", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"negativeVolume", "[", "grid", "]"}], ",", " ", "fieldMatrices", 
     ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->1873681340,ExpressionUUID->"5ff4eb8a-8686-c1c6-058b-02d43330932c"],

Cell["\<\
Confirm that the phase-randomized field's negative volume is the \
phase-averaged negative volume of the coherent field; the largest difference \
is:\
\>", "Text",
 CellID->1468251080,ExpressionUUID->"049abcb6-c083-4b47-2cb9-35f3f13619ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"negativity", "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
