@article{debievre2023,
  title = {Relating Incompatibility, Noncommutativity, Uncertainty, and {{Kirkwood}}\textendash{{Dirac}} Nonclassicality},
  author = {De Bi{\`e}vre, S.},
  year = {2023},
  month = feb,
  journal = {Journal of Mathematical Physics},
  volume = {64},
  number = {2},
  pages = {022202},
  publisher = {{American Institute of Physics}},
  issn = {0022-2488},
  doi = {10.1063/5.0110267},
  abstract = {We provide an in-depth study of the recently introduced notion of completely incompatible observables and its links to the support uncertainty and to the Kirkwood\textendash Dirac nonclassicality of pure quantum states. The latter notion has recently been proved central to a number of issues in quantum information theory and quantum metrology. In this last context, it was shown that a quantum advantage requires the use of Kirkwood\textendash Dirac nonclassical states. We establish sharp bounds of very general validity that imply that the support uncertainty is an efficient Kirkwood\textendash Dirac nonclassicality witness. When adapted to completely incompatible observables that are close to mutually unbiased ones, this bound allows us to fully characterize the Kirkwood\textendash Dirac classical pure states as the eigenvectors of the two observables. We show furthermore that complete incompatibility implies several weaker notions of incompatibility, among which features a strong form of noncommutativity.}
}

