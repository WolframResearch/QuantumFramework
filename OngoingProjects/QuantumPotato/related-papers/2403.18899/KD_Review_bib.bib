  year = {2009},
  volume = {11},
  pages = {033011},
  number = {3},
  abstract = {We implemented a joint weak measurement of the trajectories of two
	photons in a photonic version of Hardy's experiment. The joint weak
	measurement has been performed via an entangled meter state in polarization
	degrees of freedom of the two photons. Unlike Hardy's original argument
	in which the contradiction is inferred by retrodiction, our experiment
